1
00:00:14,900 --> 00:00:17,574
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ

2
00:00:26,131 --> 00:00:27,201
اللَّهِ وَبَرَكَاتُهُ،

3
00:00:26,666 --> 00:00:27,201
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

4
00:00:26,666 --> 00:00:27,201
رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ،

5
00:00:26,666 --> 00:00:27,201
رَبِّ الْعَرْشِ الْعَظِيمِ،

6
00:00:28,805 --> 00:00:30,410
وَأَشْهَدُ أَنْ لَا

7
00:00:33,619 --> 00:00:34,688
إِلَهَ إِلَّا

8
00:00:48,076 --> 00:00:49,150
اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

9
00:00:48,613 --> 00:00:49,150
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

10
00:00:56,669 --> 00:00:58,280
صَلَّى اللَّهُ عَلَيْهِ

11
00:01:06,872 --> 00:01:09,020
وَعَلَى آلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا مَزِيدًا،

12
00:01:08,483 --> 00:01:09,020
أَمَّا بَعْدُ: فَهَذَا الْمَجْلِسُ الثَّانِي فِي شَرْحِ الْكِتَابِ الثَّالِثِ مِنْ

13
00:01:08,483 --> 00:01:09,020
بَرْنَامَجِ الْيَوْمِ الْوَاحِدِ التَّاسِعِ،

14
00:01:08,483 --> 00:01:09,020
وَالْكِتَابُ الْمَقْرُوءُ هُوَ [الرِّسَالَةُ التَّبُوكِيَّةُ] لِلْعَلَّامَةِ [أَبِي عَبْدِ

15
00:01:14,964 --> 00:01:16,045
اللَّهِ بْنِ الْقَيِّمِ] رَحِمَهُ اللَّهُ،

16
00:01:15,505 --> 00:01:18,749
وَقَدِ انْتَهَى بِنَا الْبَيَانُ إِلَى قَوْلِهِ: فَصْلٌ: وَأَمَّا الْهِجْرَةُ إِلَى

17
00:01:18,208 --> 00:01:19,290
الرَّسُولِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.

18
00:01:18,749 --> 00:01:19,290
نَعَمْ، أَحْسَنَ اللَّهُ إِلَيْكُمْ.

19
00:01:18,749 --> 00:01:19,290
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: فَصْلٌ: وَأَمَّا الْهِجْرَةُ إِلَى الرَّسُولِ،

20
00:01:18,749 --> 00:01:21,994
فَمَعْلَمٌ لَمْ يَبْقَ مِنْهُ سِوَى رَسْمِهِ،

21
00:01:21,994 --> 00:01:25,238
وَمَنْهَجٌ لَمْ تُفْرَقْ مِنْهُ بُنَيَّاتُ الطَّرِيقِ

22
00:01:25,238 --> 00:01:26,320
سِوَى اسْمِهِ،

23
00:01:26,320 --> 00:01:30,194
وَمَحَجَّةٌ سَفَتْ عَلَيْهَا السَّوَافِي فَطَمَسَتْ رُسُومَهَا،

24
00:01:30,194 --> 00:01:34,069
وَأَغَارَتْ عَلَيْهَا الْأَعَادِي فَغَوَّرَتْ مَنَاهِلَهَا وَعُيُونَهَا،

25
00:01:34,069 --> 00:01:36,651
فَسَالِكُهَا غَرِيبٌ بَيْنَ الْعِبَادِ،

26
00:01:36,651 --> 00:01:39,880
فَرِيدٌ بَيْنَ كُلِّ حَيٍّ وَنَادٍ،

27
00:01:39,880 --> 00:01:41,910
بَعِيدٌ عَلَى قُرْبِ الْمَكَانِ،

28
00:01:41,910 --> 00:01:43,940
وَحِيدٌ عَلَى كَثْرَةِ الْجِيرَانِ،

29
00:01:43,940 --> 00:01:46,410
مُسْتَوْحِشٌ مِمَّا بِهِ يَسْتَأْنِسُونَ،

30
00:01:46,410 --> 00:01:48,880
مُسْتَأْنِسٌ مِمَّا بِهِ يَسْتَوْحِشُونَ،

31
00:01:48,880 --> 00:01:51,029
مُقِيمٌ إِذَا ظَعَنُوا،

32
00:01:50,312 --> 00:01:53,177
ظَاعِنٌ إِذَا قَطَنُوا،

33
00:01:53,177 --> 00:01:56,043
مُنْفَرِدٌ فِي طَرِيقِ طَلَبِهِ،

34
00:01:56,043 --> 00:01:58,907
لَا يَقَرُّ قَرَارُهُ حَتَّى

35
00:01:58,907 --> 00:02:00,340
يَظْفَرَ بِأَرَبِهِ،

36
00:02:00,340 --> 00:02:02,440
فَهُوَ الْكَائِنُ مَعَهُمْ بِجَسَدِهِ،

37
00:02:02,440 --> 00:02:04,015
الْبَائِنُ مِنْهُمْ بِمَقْصِدِهِ،

38
00:02:04,015 --> 00:02:07,165
نَامَتْ فِي طَلَبِ الْهُدَى أَعْيُنُهُمْ وَمَا

39
00:02:07,165 --> 00:02:08,740
لَيْلُ مَطِيِّهِ بِنَائِمِ،

40
00:02:08,740 --> 00:02:11,979
وَقَعَدُوا عَنِ الْهِجْرَةِ النَّبَوِيَّةِ وَهُوَ

41
00:02:11,979 --> 00:02:14,570
فِي طَلَبِهَا مُشَمِّرٌ قَائِمٌ،

42
00:02:14,570 --> 00:02:16,513
يَعِيبُونَهُ بِمُخَالَفَةِ آرَائِهِمْ،

43
00:02:16,513 --> 00:02:20,400
وَيَزْرُونَ عَلَيْهِ إِزْرَاءً عَلَى أَجْهَالَاتِهِمْ وَأَهْوَائِهِمْ،

44
00:02:20,400 --> 00:02:23,285
قَدْ رَجَمُوا فِيهِ الظُّنُونَ،

45
00:02:23,285 --> 00:02:25,449
وَأَذْكَوْا عَلَيْهِ الْعُيُونَ،

46
00:02:25,449 --> 00:02:28,335
وَتَرَبَّصُوا بِهِ رَيْبَ الْمَنُونِ،

47
00:02:28,335 --> 00:02:31,220
﴿فَتَرَبَّصُوا إِنَّا مَعَكُمْ مُتَرَبِّصُونَ﴾،

48
00:02:31,220 --> 00:02:34,240
﴿قَالَ رَبِّ احْكُمْ بِالْحَقِّ وَرَبُّنَا

49
00:02:34,240 --> 00:02:37,260
الرَّحْمَنُ الْمُسْتَعَانُ عَلَى مَا تَصِفُونَ﴾.

50
00:02:37,260 --> 00:02:39,815
نَحْنُ وَإِيَّاكُمْ نَمُوتُ،

51
00:02:39,815 --> 00:02:43,040
وَلَا أَفْلَحَ عِنْدَ الْحِسَابِ مَنْ نَدِمَا.

52
00:02:43,040 --> 00:02:46,992
وَالْمَقْصُودُ أَنَّ هَذِهِ الْهِجْرَةَ النَّبَوِيَّةَ شَأْنُهَا شَدِيدٌ،

53
00:02:46,992 --> 00:02:50,380
وَطَرِيقُهَا عَلَى غَيْرِ الْمُشْتَاقِ وَعِيرٌ بَعِيدٌ،

54
00:02:50,380 --> 00:02:53,740
بَعِيدٌ عَلَى كَسْلَانَ أَوْ ذِي مَلَالَةٍ،

55
00:02:53,740 --> 00:02:56,540
وَأَمَّا عَلَى الْمُشْتَاقِ فَهُوَ قَرِيبٌ،

56
00:02:56,540 --> 00:02:59,588
وَلَعَمْرُ اللَّهِ مَا هِيَ إِلَّا نُورٌ

57
00:02:59,588 --> 00:03:01,620
يَتَلأْلأُ وَلَكِنْ أَنْتَ ظَلَامُهُ،

58
00:03:01,620 --> 00:03:04,890
وَبَدْرٌ أَضَاءَ مَشَارِقَ الْأَرْضِ وَمَغَارِبَهَا وَلَكِنْ

59
00:03:04,890 --> 00:03:06,525
أَنْتَ غَيْمُهُ وَقَتَامُهُ،

60
00:03:06,525 --> 00:03:09,867
وَمَنْهَلٌ عَذْبٌ صَافٍ وَلَكِنْ أَنْتَ كَدَرُهُ،

61
00:03:09,298 --> 00:03:12,713
وَمُبْتَدَأٌ لَهُ خَبَرٌ عَظِيمٌ وَلَكِنْ

62
00:03:12,713 --> 00:03:14,420
لَيْسَ عِنْدَكَ خَبَرُهُ،

63
00:03:14,420 --> 00:03:18,433
فَاسْمَعِ الْآنَ شَأْنَ هَذِهِ الْهِجْرَةِ وَالدَّلَالَةَ عَلَيْهَا،

64
00:03:18,433 --> 00:03:21,873
وَحَاسِبْ نَفْسَكَ بَيْنَكَ وَبَيْنَ اللَّهِ: هَلْ

65
00:03:21,873 --> 00:03:24,167
أَنْتَ مِنَ الْمُهَاجِرِينَ لَهَا،

66
00:03:24,167 --> 00:03:26,460
أَوْ مِنَ الْمُهَاجِرِينَ إِلَيْهَا؟

67
00:03:26,460 --> 00:03:29,551
فَحَدُّ هَذِهِ الْهِجْرَةِ: سَفَرُ الْفِكْرِ فِي كُلِّ

68
00:03:29,551 --> 00:03:31,318
مَسْأَلَةٍ مِنْ مَسَائِلِ الْإِيمَانِ،

69
00:03:31,318 --> 00:03:33,084
وَنَازِلَةٍ مِنْ نَوَازِلِ الْقُلُوبِ،

70
00:03:33,084 --> 00:03:34,850
وَحَادِثَةٍ مِنْ حَوَادِثِ الْأَحْكَامِ،

71
00:03:34,850 --> 00:03:37,982
إِلَى مَعْدِنِ الْهُدَى وَمَنْبَعِ النُّورِ الْمُتَلَقَّى مِنْ

72
00:03:37,982 --> 00:03:41,352
فَمِ الصَّادِقِ الْمَصْدُوقِ الَّذِي ﴿لَا يَنْطِقُ عَنِ الْهَوَى *

73
00:03:41,352 --> 00:03:43,760
إِنْ هُوَ إِلَّا وَحْيٌ يُوحَى﴾،

74
00:03:43,760 --> 00:03:46,930
فَكُلُّ مَسْأَلَةٍ طَلَعَتْ عَلَيْهَا شَمْسُ رِسَالَتِهِ،

75
00:03:46,930 --> 00:03:50,100
وَإِلَّا فَاقْذِفْ بِهَا فِي بِحَارِ الظُّلُمَاتِ،

76
00:03:50,100 --> 00:03:53,270
وَكُلُّ شَاهِدٍ عَدَّلَهُ هَذَا الْمُزَكِّي الصَّادِقُ،

77
00:03:53,270 --> 00:03:56,440
وَإِلَّا فَعُدَّهُ مِنْ أَهْلِ الرَّيْبِ وَالتُّهَمَاتِ.

78
00:03:56,440 --> 00:03:59,927
فَهَذَا هُوَ حَدُّ هَذِهِ الْهِجْرَةِ،

79
00:03:59,927 --> 00:04:04,111
فَمَا لِلْمُقِيمِ فِي مَدِينَةِ طَبْعِهِ وَعَوَائِدِهِ،

80
00:04:04,111 --> 00:04:06,900
الْقَاطِنِ فِي دَارِ مَرْبَاهُ وَمَوْلِدِهِ،

81
00:04:08,233 --> 00:04:11,785
الْقَائِلِ: [إِنَّا عَلَى طَرِيقَةِ آبَائِنَا سَالِكُونَ،

82
00:04:11,785 --> 00:04:13,515
وَإِنَّا بِحَبْلِهِمْ مُسْتَمْسِكُونَ،

83
00:04:13,515 --> 00:04:15,823
وَإِنَّا عَلَى آثَارِهِمْ مُقْتَدُونَ]،

84
00:04:15,823 --> 00:04:19,862
وَمَعَالِمُ هَذِهِ الْهِجْرَةِ قَدْ أَلْقَى كُلَّهُ عَلَيْهِمْ،

85
00:04:19,862 --> 00:04:23,900
وَاسْتَنَدَ فِي مَعْرِفَةِ طَرِيقِ نَجَاتِهِ وَفَلَاحِهِ إِلَيْهِمْ،

86
00:04:23,900 --> 00:04:27,100
مُعْتَذِرًا بِأَنَّ رَأْيَهُمْ لَهُ خَيْرٌ مِنْ

87
00:04:27,100 --> 00:04:28,167
رَأْيِهِ لِنَفْسِهِ،

88
00:04:28,167 --> 00:04:31,900
وَأَنَّ ظُنُونَهُمْ وَآرَاءَهُمْ أَوْثَقُ مِنْ ظَنِّهِ وَحَدْسِهِ،

89
00:04:31,900 --> 00:04:35,082
وَلَوْ فَتَّشْتَ عَنْ مَصْدَرِ هَذِهِ الْكَلِمَةِ لَوَجَدْتَهَا

90
00:04:35,082 --> 00:04:36,445
صَادِرَةً عَنِ الْإِخْلَادِ

91
00:04:51,007 --> 00:04:52,221
إِلَى الْأَرْضِ،

92
00:04:51,614 --> 00:04:52,221
وَعَلَى أَرْضِ الْبَطَالَةِ مُتَوَلِّدَةً بَيْنَ بَعْلِ الْكَسَلِ وَزَوْجَتِهِ الْمَلَالَةِ.

93
00:04:51,614 --> 00:04:52,829
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: لَمَّا فَرَغَ الْمُصَنِّفُ رَحِمَهُ

94
00:04:55,864 --> 00:04:57,079
اللَّهُ تَعَالَى

95
00:05:01,700 --> 00:05:03,100
مِنْ بَيَانِ النَّوْعِ الْأَوَّلِ مِنْ هِجْرَةِ الْقُلُوبِ وَهُوَ هِجْرَتُهَا

96
00:05:07,460 --> 00:05:09,020
إِلَى اللَّهِ،

97
00:05:09,020 --> 00:05:10,580
شَرَعَ يُبَيِّنُ حَقِيقَةَ الْهِجْرَةِ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ

98
00:05:10,580 --> 00:05:11,620
وَسَلَّمَ، مُسْتَفْتِحًا بَيَانَهُ بِالتَّوَجُّعِ وَالتَّفَجُّعِ مِنَ الْحَالِ الَّتِي آلَ إِلَيْهَا

99
00:05:11,100 --> 00:05:11,620
الْخَلْقُ، حَتَّى أَضْحَتِ الْهِجْرَةُ إِلَى رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ

100
00:05:11,100 --> 00:05:14,740
وَسَلَّمَ بِالْقُلُوبِ مَعْلَمًا لَمْ يَبْقَ مِنْهُ سِوَى رَسْمِهِ،

101
00:05:14,740 --> 00:05:17,860
وَمَنْهَجًا لَمْ تَتْرُكْ مِنْهُ بُنَيَّاتُ الطَّرِيقِ

102
00:05:17,860 --> 00:05:18,900
سِوَى اسْمِهِ،

103
00:05:18,900 --> 00:05:22,150
وَمَحَجَّةً -أَيْ طَرِيقًا- سَفَتْ عَلَيْهَا

104
00:05:22,150 --> 00:05:25,400
السَّوَافِي -أَيِ الرِّيَاحُ- فَطَمَسَتْ رُسُومَهَا،

105
00:05:25,400 --> 00:05:28,650
وَأَغَارَتْ عَلَيْهَا الْأَعَادِي فَغَوَّرَتْ مَنَاهِلَهَا

106
00:05:28,650 --> 00:05:31,900
وَعُيُونَهَا -أَيْ بَعَثَتْهَا فِي الْأَرْضِ-

107
00:05:31,900 --> 00:05:35,233
فَحَالُ سَالِكِهَا غَرِيبٌ بَيْنَ الْعِبَادِ،

108
00:05:35,233 --> 00:05:35,900
فَرِيدٌ،

109
00:06:01,400 --> 00:06:02,082
بَعِيدٌ عَلَى قُرْبِ الْمَكَانِ،

110
00:06:01,900 --> 00:06:02,082
وَحِيدٌ عَلَى كَثْرَةِ الْجِيرَانِ،

111
00:06:01,900 --> 00:06:02,082
مُسْتَوْحِشٌ مِمَّا بِهِ يَسْتَأْنِسُونَ،

112
00:06:08,300 --> 00:06:10,700
إِلَى آخِرِ مَا ذَكَرَ رَحِمَهُ اللَّهُ تَعَالَى مِنْ حَالِهِ وَحَالِهِمْ،

113
00:06:10,100 --> 00:06:10,700
حَتَّى أَنْهَاهُ

114
00:06:29,233 --> 00:06:29,900
ذَلِكَ

