225
00:20:59,265 --> 00:20:59,656
وَعَنْ هَاتَيْنِ الْهِجْرَتَيْنِ يُسْأَلُ كُلُّ عَبْدٍ يَوْمَ الْقِيَامَةِ وَفِي الْبَرْزَخِ

226
00:20:59,265 --> 00:21:02,000
وَيُطَالَبُ بِهِمَا فِي الدُّنْيَا،

227
00:21:01,609 --> 00:21:02,000
فَهُوَ مُطَالَبٌ بِهِمَا فِي الدُّورِ الثَّلَاثَةِ: دَارِ الدُّنْيَا،

228
00:21:01,609 --> 00:21:02,000
وَدَارِ الْبَرْزَخِ،

229
00:21:01,609 --> 00:21:02,000
وَدَارِ الْقَرَارِ.

230
00:21:01,609 --> 00:21:02,000
قَالَ [قَتَادَةُ]: [كَلِمَتَانِ يُسْأَلُ عَنْهُمَا الْأَوَّلُونَ وَالْآخِرُونَ: مَاذَا كُنْتُمْ تَعْبُدُونَ؟

231
00:21:01,609 --> 00:21:02,000
وَمَاذَا أَجَبْتُمُ الْمُرْسَلِينَ؟].

232
00:21:01,609 --> 00:21:02,000
وَهَاتَانِ الْكَلِمَتَانِ هُمَا مَضْمُونُ الشَّهَادَتَيْنِ،

233
00:21:01,609 --> 00:21:02,000
وَقَدْ قَالَ تَعَالَى: ﴿فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّى يُحَكِّمُوكَ فِيمَا

234
00:21:01,609 --> 00:21:02,000
شَجَرَ بَيْنَهُمْ

235
00:21:16,420 --> 00:21:17,486
ثُمَّ لَا يَجِدُوا

236
00:21:30,086 --> 00:21:30,924
فِي أَنْفُسِهِمْ حَرَجًا مِمَّا قَضَيْتَ وَيُسَلِّمُوا تَسْلِيمًا﴾.

237
00:21:30,505 --> 00:21:30,924
فَأَقْسَمَ سُبْحَانَهُ بِأَجَلِّ مُقْسَمٍ بِهِ وَهُوَ نَفْسُهُ عَزَّ وَجَلَّ عَلَى

238
00:21:30,505 --> 00:21:30,924
أَنَّهُمْ لَا يَثْبُتُ

239
00:21:42,700 --> 00:21:43,700
لَهُمُ الْإِيمَانُ وَلَا يَكُونُونَ

240
00:21:48,200 --> 00:21:49,200
مِنْ أَهْلِهِ حَتَّى يُحَكِّمُوا رَسُولَهُ

241
00:21:51,700 --> 00:21:52,700
فِي جَمِيعِ مَوَارِدِ النِّزَاعِ،

242
00:21:52,200 --> 00:21:52,700
وَهُوَ كُلُّ

243
00:22:03,123 --> 00:22:04,046
مَا شَجَرَ بَيْنَهُمْ

244
00:22:18,117 --> 00:22:19,283
مِنْ مَسَائِلِ النِّزَاعِ

245
00:22:41,629 --> 00:22:42,486
فِي جَمِيعِ أَبْوَابِ الدِّينِ؛ فَإِنَّ لَفْظَةَ [مَا]

246
00:22:48,057 --> 00:22:48,914
مِنْ صِيَغِ الْعُمُومِ فَإِنَّهَا مَوْصُولَةٌ تَقْتَضِي نَفْيَ الْإِيمَانِ

247
00:22:57,867 --> 00:23:01,024
إِذَا لَمْ يُوجَدْ تَحْكِيمُهُ فِي جَمِيعِ مَا شَجَرَ بَيْنَهُمْ،

248
00:23:00,612 --> 00:23:01,024
وَلَمْ يَقْتَصِرْ عَلَى هَذَا حَتَّى ضَمَّ إِلَيْهِ شَرْحَ صُدُورِهِمْ بِحُكْمِهِ

249
00:23:00,612 --> 00:23:01,024
حَيْثُ

250
00:23:20,200 --> 00:23:21,200
لَا يَجِدُوا

251
00:23:40,867 --> 00:23:41,933
فِي أَنْفُسِهِمْ حَرَجًا -وَهُوَ الضِّيقُ وَالْحَصَرُ مِنْ حُكْمِهِ- بَلْ يَتَلَقَّوْا

252
00:23:41,400 --> 00:23:41,933
حُكْمَهُ بِالِانْشِرَاحِ وَيُقَابِلُوهُ بِالْقَبُولِ،

253
00:23:41,400 --> 00:23:41,933
لَا أَنَّهُمْ يَأْخُذُونَهُ عَلَى إِغْمَاضٍ وَيَشْرَبُونَهُ عَلَى أَقْذَاءٍ؛ فَإِنَّ هَذَا

254
00:23:41,400 --> 00:23:41,933
مُنَافٍ لِلْإِيمَانِ،

255
00:23:41,400 --> 00:23:41,933
بَلْ لَا بُدَّ أَنْ يَكُونَ أَخْذُهُمْ بِقَبُولٍ وَرِضًا وَانْشِرَاحِ صَدْرٍ.

256
00:23:41,400 --> 00:23:41,933
وَمَتَى أَرَادَ الْعَبْدُ أَنْ يَعْلَمَ مَنْزِلَتَهُ مِنْ هَذَا فَلْيَنْظُرْ فِي

257
00:23:41,400 --> 00:23:41,933
حَالِهِ وَلْيُطَالِعْ قَلْبَهُ عِنْدَ وُرُودِ حُكْمِهِ عَلَى خِلَافِ هَوَاهُ وَغَرَضِهِ،

258
00:23:41,400 --> 00:23:41,933
أَوْ عَلَى خِلَافِ مَا قَلَّدَ بِهِ أَسْلَافَهُ،

259
00:23:41,400 --> 00:23:41,933
مِثْلَ الْمَسَائِلِ الْكِبَارِ وَمَا دُونَهَا،

260
00:23:41,400 --> 00:23:41,933
﴿بَلِ الْإِنْسَانُ عَلَى نَفْسِهِ بَصِيرَةٌ * وَلَوْ أَلْقَى مَعَاذِيرَهُ﴾.

261
00:23:41,400 --> 00:23:45,133
فَسُبْحَانَ اللَّهِ!

262
00:23:45,133 --> 00:23:45,667
كَمْ مِنْ حَزَازَةٍ فِي قُلُوبِ كَثِيرٍ مِنَ النَّاسِ مِنْ كَثِيرٍ

263
00:23:45,133 --> 00:23:45,667
مِنَ النُّصُوصِ وَبِوَدِّهِمْ أَنْ لَوْ

264
00:23:57,700 --> 00:23:58,700
لَمْ تَرِدْ،

265
00:23:58,200 --> 00:23:58,700
وَكَمْ

266
00:24:09,667 --> 00:24:10,600
مِنْ حَرَارَةٍ

267
00:24:18,700 --> 00:24:19,700
فِي أَكْبَادِهِمْ مِنْهَا،

268
00:24:19,200 --> 00:24:19,700
وَكَمْ

269
00:24:23,354 --> 00:24:26,431
مِنْ شَجَنٍ فِي حُلُوقِهِمْ مِنْ مَوْرِدِهَا،

270
00:24:26,046 --> 00:24:26,431
سَتَبْدُو لَهُمْ تِلْكَ السَّرَائِرُ بِالَّذِي يَسُوءُ وَيُخْزِي يَوْمَ تُبْلَى السَّرَائِرُ.

271
00:24:26,046 --> 00:24:26,431
ثُمَّ لَمْ يَقْتَصِرْ سُبْحَانَهُ

272
00:24:39,867 --> 00:24:40,533
عَلَى ذَلِكَ حَتَّى ضَمَّ إِلَيْهِ قَوْلَهُ: ﴿وَيُسَلِّمُوا تَسْلِيمًا﴾،

273
00:24:40,200 --> 00:24:40,533
فَذَكَرَ الْفِعْلَ مُؤَكِّدًا لَهُ بِمَصْدَرِهِ الْقَائِمِ

274
00:24:56,200 --> 00:24:56,700
مَقَامَ

275
00:25:17,411 --> 00:25:29,057
ذِكْرِهِ مَرَّتَيْنِ،

276
00:25:29,057 --> 00:25:32,486
وَهُوَ الْخُضُوعُ لَهُ وَالِانْقِيَادُ لِمَا حَكَمَ

277
00:25:32,486 --> 00:25:34,200
بِهِ طَوْعًا وَرِضًا وَتَسْلِيمًا،

278
00:25:34,771 --> 00:25:35,914
لَا قَهْرًا وَمُصَابَرَةً كَمَا يُسَلِّمُ الْمَقْهُورُ لِمَنْ قَهَرَهُ كَرْهًا،

279
00:25:53,200 --> 00:25:54,200
بَلْ تَسْلِيمُ عَبْدٍ مُحِبٍّ مُطِيعٍ لِمَوْلَاهُ وَسَيِّدِهِ الَّذِي هُوَ أَعَزُّ

280
00:25:53,867 --> 00:25:54,200
عِنْدَهُ

281
00:26:18,200 --> 00:26:19,200
مِنْ نَفْسِهِ،

282
00:26:18,700 --> 00:26:20,200
وَيَعْلَمُ أَنَّ مَصَالِحَهُ فِي حُكْمِهِ،

283
00:26:19,700 --> 00:26:20,200
وَأَنَّهُ أَعْلَمُ بِمَصَالِحِهِ مِنْهَا وَأَقْدَرُ عَلَى تَحْصِيلِهَا؛ فَمَتَى

284
00:26:24,354 --> 00:26:27,325
عَلِمَ الْعَبْدُ هَذَا مِنَ

285
00:26:27,325 --> 00:26:27,888
الرَّسُولِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ اسْتَسْلَمَ لَهُ وَسَلَّمَ إِلَيْهِ،

286
00:26:27,325 --> 00:26:29,013
وَانْقَادَتْ كُلُّ ذَرَّةٍ مِنْ قَلْبِهِ إِلَيْهِ،

287
00:26:28,450 --> 00:26:29,013
وَرَأَى أَنَّهُ

288
00:26:31,825 --> 00:26:32,950
لَا سَعَادَةَ لَهُ إِلَّا بِهَذَا التَّسْلِيمِ وَالِانْقِيَادِ.

289
00:26:32,388 --> 00:26:32,950
وَلَيْسَ هَذَا مِمَّا يَحْصُلُ مَعْنَاهُ بِالْعِبَارَةِ،

290
00:26:32,388 --> 00:26:32,950
بَلْ هُوَ أَمْرٌ يَجِدُهُ

291
00:26:52,000 --> 00:26:53,200
فِي قَلْبِهِ وَيَسْتَقِرُّ

292
00:27:04,937 --> 00:27:06,095
فِي سُوَيْدَائِهِ -يَعْنِي

293
00:27:19,515 --> 00:27:21,033
فِي جَوْفِهِ- وَالسُّوَيْدَاءُ تَصْغِيرُ سَوَادِي الْقَلْبِ أَيْ جَوْفِهِ وَدَاخِلَتِهِ،

294
00:27:20,274 --> 00:27:21,033
وَالْعِبَارَةُ تَعْجِزُ صَاحِبَهَا عَنِ الْحَقَائِقِ الْقَلْبِيَّةِ.

295
00:27:20,274 --> 00:27:21,033
فَهَذَا أَمْرٌ نَوَّهَ بِهِ [ابْنُ الْقَيِّمِ] رَحِمَهُ اللَّهُ تَعَالَى

296
00:27:31,670 --> 00:27:32,737
فِي عِدَّةِ كُتُبٍ؛ فَإِنَّ اللِّسَانَ يَعْجِزُ

297
00:27:55,451 --> 00:27:56,499
عَنِ الْبَيَانِ عَمَّا يَجِدُهُ الْمَرْءُ

298
00:28:20,186 --> 00:28:21,329
مِنَ التَّوَقُّفِ

299
00:28:23,900 --> 00:28:24,900
فِي قَلْبِهِ.

300
00:28:24,400 --> 00:28:24,900
ثُمَّ بَيَّنَ رَحِمَهُ اللَّهُ تَعَالَى

301
00:28:40,025 --> 00:28:43,217
أَنَّهُ لَمَّا فَرَغَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ تَعَالَى

302
00:28:47,168 --> 00:28:48,046
مِنْ بَيَانِ مَعْنَى الْهِجْرَةِ إِلَى اللَّهِ وَرَسُولِهِ صَلَّى اللَّهُ عَلَيْهِ

303
00:28:47,607 --> 00:28:48,046
وَسَلَّمَ بِالْقُلُوبِ،

304
00:28:47,607 --> 00:28:48,046
بَيَّنَ أَنَّ هَذِهِ الْهِجْرَةَ فَرْضٌ عَلَى كُلِّ مُسْلِمٍ،

305
00:28:47,607 --> 00:28:48,046
وَهِيَ مُقْتَضَى شَهَادَةِ أَنَّ مُحَمَّدًا

306
00:29:10,857 --> 00:29:11,900
رَسُولُ اللَّهِ،

307
00:29:11,378 --> 00:29:11,900
كَمَا

308
00:29:18,445 --> 00:29:19,536
أَنَّ الْهِجْرَةَ الْأُولَى مُقْتَضَى شَهَادَةِ

309
00:29:22,264 --> 00:29:22,809
أَنْ

310
00:29:35,400 --> 00:29:36,400
لَا إِلَهَ

311
00:29:47,500 --> 00:29:59,329
إِلَّا اللَّهُ.

312
00:29:59,329 --> 00:30:02,300
فَحَاصِلُ مَعْنَى

313
00:30:02,300 --> 00:30:02,900
هَاتَيْنِ الْهِجْرَتَيْنِ أَنَّ هِجْرَةَ قَلْبِ الْعَبْدِ إِلَى

314
00:30:07,233 --> 00:30:08,567
اللَّهِ تَكُونُ بِالْعِبَادَةِ،

315
00:30:07,900 --> 00:30:08,567
وَهِجْرَةَ قَلْبِ الْعَبْدِ إِلَى الرَّسُولِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ تَكُونُ

316
00:30:07,900 --> 00:30:08,567
بِالِاتِّبَاعِ، وَهَذَانِ الْمَعْنَيَانِ هُمَا الْمَذْكُورَانِ

317
00:30:17,400 --> 00:30:18,567
فِي الشَّهَادَتَيْنِ.

318
00:30:17,983 --> 00:30:18,567
وَعَنْ هَاتَيْنِ الْهِجْرَتَيْنِ يُسْأَلُ الْعَبْدُ

319
00:30:30,400 --> 00:30:31,400
فِي الْبَرْزَخِ وَيُطَالَبُ بِهِمَا

320
00:30:38,543 --> 00:30:39,829
فِي الدُّنْيَا،

321
00:30:39,186 --> 00:30:39,829
فَهُوَ مُطَالَبٌ بِهِمَا

322
00:30:58,567 --> 00:30:59,900
فِي الدُّورِ الثَّلَاثَةِ: دَارِ الدُّنْيَا،

323
00:30:59,233 --> 00:30:59,900
وَدَارِ الْبَرْزَخِ،

324
00:30:59,233 --> 00:30:59,900
وَدَارِ الْقَرَارِ.

325
00:30:59,233 --> 00:30:59,900
قَالَ [قَتَادَةُ بْنُ دِعَامَةَ]: [كَلِمَتَانِ يُسْأَلُ عَنْهُمَا الْأَوَّلُونَ وَالْآخِرُونَ: مَاذَا

326
00:30:59,233 --> 00:30:59,900
كُنْتُمْ تَعْبُدُونَ؟

327
00:30:59,233 --> 00:30:59,900
وَمَاذَا أَجَبْتُمُ الْمُرْسَلِينَ؟].

328
00:30:59,233 --> 00:31:16,900
فَالسُّؤَالُ الْأَوَّلُ يَتَعَلَّقُ بِهِجْرَةِ الْقَلْبِ إِلَى اللَّهِ،

329
00:31:16,900 --> 00:31:17,400
وَالسُّؤَالُ الثَّانِي يَتَعَلَّقُ بِهِجْرَةِ الْقَلْبِ إِلَى رَسُولِ

330
00:31:39,567 --> 00:31:40,678
اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.

331
00:31:40,122 --> 00:31:41,789
وَهَاتَانِ الْهِجْرَتَانِ مِنْ عُيُونِ الْعِلْمِ وَجَوَامِعِهِ الَّتِي يَنْبَغِي أَنْ يَسْتَفْرِغَ

332
00:31:41,233 --> 00:31:41,789
الْمَرْءُ وُسْعَهُ

333
00:31:56,233 --> 00:31:57,900
فِي تَفَهُّمِ تَعَلُّقَاتِهِمَا وَدَوَامِ الدَّوَرَانِ مَعَ مَسَائِلِهِمَا،

334
00:31:57,067 --> 00:31:57,900
وَلِلْمُصَنِّفِ خَاصَّةً كَلَامٌ مَبْثُوثٌ

335
00:32:08,253 --> 00:32:09,194
فِي جُمْلَةٍ

336
00:32:23,030 --> 00:32:24,248
مِنْ كُتُبِهِ يَحْسُنُ قَرْنُ بَعْضِهِ بِبَعْضٍ؛ ذَكَرَ طَرَفًا مِنْهُ

337
00:32:37,718 --> 00:32:38,809
فِي كِتَابِ [مَدَارِجِ السَّالِكِينَ]،

338
00:32:38,264 --> 00:32:38,809
وَطَرَفًا آخَرَ فِي [طَرِيقِ الْهِجْرَتَيْنِ]،

339
00:32:38,264 --> 00:32:38,809
