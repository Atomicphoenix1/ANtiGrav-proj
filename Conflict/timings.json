      "id": "b27e6f25-dd0b-4053-8410-b84733dbab18",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Loop through all incoming items\nfor (const item of $input.all()) {\n  const rawSchedule = item.json[\"المواعيد\"];\n  \n  if (rawSchedule) {\n    // 1. Split by comma\n    // 2. Trim whitespace from each item\n    // 3. Filter out any empty strings\n    item.json.split_appointments = rawSchedule.split(',')\n      .map(s => s.trim())\n      .filter(s => s.length > 0);\n  } else {\n    item.json.split_appointments = [];\n  }\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        -272
      ],
      "id": "727058a7-5dbf-463f-af32-58882b69a88f",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "// 1. Define the Master Translation Map\nconst idMap = {\n  \"طول اليوم\": \"X\",\n  \"6ص-7ص\": \"T1\",\n  \"7ص-8ص\": \"T2\",\n  \"8ص-9ص\": \"T3\",\n  \"جميع ما سبق\": \"S1\",\n  \"9ص-10ص\": \"T4\",\n  \"10ص-11ص\": \"T5\",\n  \"11ص-12م\": \"T6\",\n  \"جميع ما سبق 2\": \"S2\",\n  \"12م-الظهر\": \"T7\",\n  \"1:30م : 2م\": \"T8\",\n  \"2م-3م\": \"T9\",\n  \"جميع ما سبق 3\": \"S3\",\n  \"3م-4م\": \"T10\",\n  \"4م-العصر\": \"T11\",\n  \"5م-6م\": \"T12\",\n  \"جميع ما سبق 4\": \"S4\",\n  \"6م-7م\": \"T13\",\n  \"7م- المغرب\": \"T14\",\n  \"8م- العشاء\": \"T15\",\n  \"جميع ما سبق 5\": \"S5\",\n  \"9:30م- 10م\": \"T16\",\n  \"10م-11م\": \"T17\",\n  \"11م-12م\": \"T18\",\n  \"جميع ما سبق 6\": \"S6\"\n};\n\n// 2. Process every item coming from Google Sheets\nfor (const item of $input.all()) {\n  const rawText = item.json[\"المواعيد\"] || \"\";\n  \n  // Split the string by comma and clean whitespace\n  const selections = rawText.split(',').map(s => s.trim());\n  \n  // Map the Arabic text to the IDs. If not found, keep original text\n  item.json.appointment_ids = selections.map(choice => {\n    return idMap[choice] || choice; \n  });\n}\n\nreturn $input.all();"
      },
