    {
      "parameters": {
        "jsCode": "// Loop through every row (item) coming from the previous node\nfor (const item of $input.all()) {\n  \n  // Use 'item' instead of '$input.first()' to target every row\n  delete item.json[\"هل عندك تعليق على معاد؟\"];\n  delete item.json[\"row_number\"];\n\n  \n}\n\nreturn $input.all();"
      },
