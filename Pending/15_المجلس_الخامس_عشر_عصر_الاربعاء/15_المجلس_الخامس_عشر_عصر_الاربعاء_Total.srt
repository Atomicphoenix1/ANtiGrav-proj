1
00:00:43,280 --> 00:00:43,724
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ:

2
00:00:49,744 --> 00:00:51,158
اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

3
00:00:50,451 --> 00:00:51,158
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

4
00:00:50,451 --> 00:00:51,158
صَلَّى

5
00:01:20,325 --> 00:01:21,450
اللَّهُ عَلَيْهِ

6
00:01:45,815 --> 00:01:47,074
وَسَلَّمَ بُكْرَةً وَأَصِيلًا،

7
00:01:50,220 --> 00:01:53,520
وَعَلَى آلِهِ وَصَحْبِهِ وَمَنِ اتَّخَذَهُ إِمَامًا وَدَلِيلًا.

8
00:01:52,695 --> 00:01:53,520
أَمَّا بَعْدُ،

9
00:01:52,695 --> 00:01:53,520
فَهَذَا الْمَجْلِسُ الْخَامِسَ عَشَرَ

10
00:02:03,132 --> 00:02:04,246
فِي شَرْحِ الْكِتَابِ الْأَوَّلِ

11
00:02:14,009 --> 00:02:15,723
مِنْ بَرْنَامَجِ الْكِتَابِ الْوَاحِدِ،

12
00:02:14,866 --> 00:02:15,723
وَهُوَ كِتَابُ [فَتْحِ الْمَجِيدِ فِي شَرْحِ كِتَابِ التَّوْحِيدِ] لِلْعَلَّامَةِ عَبْدِ

13
00:02:14,866 --> 00:02:15,723
الرَّحْمَنِ

14
00:02:27,393 --> 00:02:29,143
بْنِ حَسَنِ بْنِ مُحَمَّدِ بْنِ عَبْدِ الْوَهَّابِ التَّمِيمِيِّ رَحِمَهُ اللَّهُ،

15
00:02:29,143 --> 00:02:29,580
وَقَدِ انْتَهَى بِنَا الْبَيَانُ إِلَى مَا أَوْرَدَهُ إِمَامُ الدَّعْوَةِ رَحِمَهُ

16
00:02:32,794 --> 00:02:33,509
اللَّهُ تَعَالَى فِي بَابِ تَفْسِيرِ التَّوْحِيدِ وَشَهَادَةِ أَنْ لَا إِلَهَ

17
00:02:33,151 --> 00:02:33,866
إِلَّا اللَّهُ؛

18
00:02:37,494 --> 00:02:37,980
أَنَّهُ

19
00:02:57,580 --> 00:02:58,853
قَالَ: وَقَوْلُهُ

20
00:03:05,913 --> 00:03:07,330
تَعَالَى: ﴿اتَّخَذُوا أَحْبَارَهُمْ وَرُهْبَانَهُمْ أَرْبَابًا

21
00:03:25,497 --> 00:03:27,580
مِنْ دُونِ اللَّهِ﴾ بِسْمِ

22
00:03:32,080 --> 00:03:33,047
اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

23
00:03:32,580 --> 00:03:33,047
الْحَمْدُ

24
00:03:43,151 --> 00:03:44,580
لِلَّهِ رَبِّ الْعَالَمِينَ،

25
00:03:43,866 --> 00:03:44,580
وَصَلَّى

26
00:03:53,018 --> 00:03:54,125
اللَّهُ وَسَلَّمَ وَبَارَكَ

27
00:04:20,294 --> 00:04:21,866
عَلَى عَبْدِهِ

28
00:04:25,794 --> 00:04:27,247
وَرَسُولِهِ نَبِيِّنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

29
00:04:26,580 --> 00:04:27,247
اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا وَلِجَمِيعِ الْمُسْلِمِينَ.

30
00:04:26,580 --> 00:04:27,247
يَقُولُ

31
00:04:51,024 --> 00:04:52,802
الشَّيْخُ عَبْدُ الرَّحْمَنِ بْنُ حَسَنٍ رَحِمَهُ اللَّهُ

32
00:04:54,136 --> 00:04:54,580
تَعَالَى

33
00:05:01,866 --> 00:05:05,080
فِي كِتَابِهِ [فَتْحِ الْمَجِيدِ]: قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ

34
00:05:05,080 --> 00:05:07,651
تَعَالَى: وَقَوْلُهُ تَعَالَى: ﴿اتَّخَذُوا أَحْبَارَهُمْ وَرُهْبَانَهُمْ أَرْبَابًا مِنْ دُونِ اللَّهِ﴾

35
00:05:07,651 --> 00:05:08,294
الْآيَةَ، الْأَحْبَارُ هُمُ الْعُلَمَاءُ،

36
00:05:07,651 --> 00:05:08,294
وَالرُّهْبَانُ هُمُ الْعُبَّادُ،

37
00:05:07,651 --> 00:05:08,294
وَهَذِهِ الْآيَةُ قَدْ فَسَّرَهَا رَسُولُ

38
00:05:12,853 --> 00:05:13,944
اللَّهِ صَلَّى

39
00:05:17,762 --> 00:05:21,035
اللَّهُ عَلَيْهِ وَسَلَّمَ لِعَدِيِّ بْنِ حَاتِمٍ رَضِيَ اللَّهُ عَنْهُ،

40
00:05:20,489 --> 00:05:21,035
وَذَلِكَ

41
00:05:35,639 --> 00:05:36,698
أَنَّهُ لَمَّا جَاءَ مُسْلِمًا دَخَلَ عَلَى رَسُولِ

42
00:05:40,933 --> 00:05:41,462
اللَّهِ

43
00:06:02,580 --> 00:06:04,398
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَقَرَأَ

44
00:06:13,997 --> 00:06:14,913
عَلَيْهِ هَذِهِ الْآيَةَ،

45
00:06:14,455 --> 00:06:14,913
قَالَ: فَقُلْتُ: إِنَّهُمْ لَمْ يَعْبُدُوهُمْ،

46
00:06:14,455 --> 00:06:14,913
فَقَالَ: [بَلَى،

47
00:06:14,455 --> 00:06:14,913
إِنَّهُمْ حَرَّمُوا عَلَيْهِمُ الْحَلَالَ وَحَلَّلُوا لَهُمُ الْحَرَامَ فَاتَّبَعُوهُمْ،

48
00:06:14,455 --> 00:06:14,913
فَذَلِكَ عِبَادَتُهُمْ إِيَّاهُمْ] رَوَاهُ أَحْمَدُ وَالتِّرْمِذِيُّ وَحَسَّنَهُ،

49
00:06:14,455 --> 00:06:14,913
وَعَبْدُ بْنُ حُمَيْدٍ وَابْنُ أَبِي حَاتِمٍ وَالطَّبَرَانِيُّ

50
00:06:17,663 --> 00:06:18,580
مِنْ طُرُقٍ.

51
00:06:18,122 --> 00:06:20,888
قَالَ [السُّدِّيُّ] رَحِمَهُ اللَّهُ: اسْتَنْصَحُوا الرِّجَالَ وَنَبَذُوا كِتَابَ

52
00:06:35,109 --> 00:06:36,151
اللَّهِ وَرَاءَ ظُهُورِهِمْ،

53
00:06:47,580 --> 00:06:48,380
وَلِهَذَا قَالَ تَعَالَى: ﴿وَمَا أُمِرُوا إِلَّا لِيَعْبُدُوا إِلَهًا وَاحِدًا

54
00:06:50,780 --> 00:06:51,580
لَا إِلَهَ إِلَّا هُوَ سُبْحَانَهُ عَمَّا يُشْرِكُونَ﴾ فَإِنَّ الْحَلَالَ

55
00:07:07,462 --> 00:07:15,406
مَا أَحَلَّهُ اللَّهُ،

56
00:07:15,406 --> 00:07:16,015
وَالْحَرَامَ

57
00:07:28,860 --> 00:07:30,140
مَا حَرَّمَهُ اللَّهُ،

58
00:07:29,500 --> 00:07:30,140
وَالدِّينَ

59
00:07:48,959 --> 00:07:49,787
مَا شَرَعَهُ اللَّهُ تَعَالَى،

60
00:07:49,373 --> 00:07:49,787
فَظَهَرَ بِهَذَا

61
00:07:58,510 --> 00:08:01,440
أَنَّ الْآيَةَ تَدُلُّكَ عَلَى أَنَّ مَنْ أَطَاعَ غَيْرَ اللَّهِ وَرَسُولِهِ،

62
00:08:00,952 --> 00:08:01,440
وَأَعْرَضَ عَنِ الْأَخْذِ بِالْكِتَابِ وَالسُّنَّةِ

63
00:08:09,743 --> 00:08:10,720
فِي تَحْلِيلِ

64
00:08:14,627 --> 00:08:31,826
مَا حَرَّمَ اللَّهُ،

65
00:08:31,826 --> 00:08:33,611
أَوْ تَحْرِيمِ مَا أَحَلَّ اللَّهُ،

66
00:08:33,611 --> 00:08:34,057
وَأَطَاعَهُ

67
00:08:51,011 --> 00:09:03,330
فِي مَعْصِيَةِ اللَّهِ وَاتَّبَعَهُ فِيمَا لَمْ يَأْذَنْ بِهِ اللَّهُ،

68
00:09:03,330 --> 00:09:03,955
فَقَدِ اتَّخَذَهُ رَبًّا وَمَعْبُودًا،

69
00:09:03,330 --> 00:09:03,955
وَجَعَلَهُ لِلَّهِ شَرِيكًا،

70
00:09:03,330 --> 00:09:06,455
وَذَلِكَ يُنَافِي التَّوْحِيدَ الَّذِي هُوَ دِينُ الْإِسْلَامِ الَّذِي دَلَّتْ عَلَيْهِ

71
00:09:05,830 --> 00:09:06,455
كَلِمَةُ الْإِخْلَاصِ [لَا إِلَهَ إِلَّا اللَّهُ]،

72
00:09:05,830 --> 00:09:06,455
فَإِنَّ الْإِلَهَ هُوَ الْمَعْبُودُ،

73
00:09:05,830 --> 00:09:06,455
وَقَدْ سَمَّى اللَّهُ تَعَالَى طَاعَتَهُمْ عِبَادَةً لَهُمْ وَسَمَّاهُمْ أَرْبَابًا.

74
00:09:05,830 --> 00:09:06,455
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: -

75
00:09:09,580 --> 00:09:12,857
جَانَبَ هَذِهِ

76
00:09:12,857 --> 00:09:16,134
الْجُمْلَةَ مِنْ

77
00:09:16,134 --> 00:09:19,411
جِهَتَيْنِ: - أَحَدُهُمَا:

78
00:09:21,049 --> 00:09:24,326
آحَادُ مُفْرَدَاتِهَا.

79
00:09:22,688 --> 00:09:25,965
- وَالْآخَرُ:

80
00:09:27,603 --> 00:09:30,880
نَظْمُ سِيَاقِهَا.

81
00:09:30,880 --> 00:09:34,056
فَأَمَّا الْجِهَةُ الْأُولَى وَهِيَ

82
00:09:34,056 --> 00:09:35,645
آحَادُ مُفْرَدَاتِهَا،

83
00:09:35,645 --> 00:09:38,821
فَقَوْلُهُ فِي صَفْحَةِ الْخَامِسَةِ

84
00:09:38,821 --> 00:09:42,792
وَالْخَمْسِينَ بَعْدَ الْمِائَتَيْنِ: [مِنْ طُرُقٍ]،

85
00:09:42,792 --> 00:09:45,174
أَيْ مِنْ أَسَانِيدَ،

86
00:09:45,174 --> 00:09:48,351
فَالطَّرِيقُ عِنْدَ الْمُحَدِّثِينَ الْإِسْنَادُ،

87
00:09:48,351 --> 00:09:51,527
وَذَكَرْتُ لَكُمْ فِيمَا سَلَفَ

88
00:09:51,527 --> 00:09:54,704
أَرْبَعَةَ أَلْفَاظٍ تَدُورُ عِنْدَ

89
00:09:54,704 --> 00:09:57,880
الْمُحَدِّثِينَ هِيَ بِمَعْنًى وَاحِدٍ: -

90
00:09:57,880 --> 00:09:59,880
أَحَدُهَا: [السَّنَدُ].

91
00:09:58,880 --> 00:09:59,880
-

92
00:10:00,880 --> 00:10:05,880
وَثَانِيهَا: [الْإِسْنَادُ].

93
00:10:03,380 --> 00:10:05,880
-

94
00:10:05,880 --> 00:10:12,520
وَثَالِثُهَا: [الطَّرِيقُ].

95
00:10:09,200 --> 00:10:12,520
-

96
00:10:12,520 --> 00:10:19,520
وَرَابِعُهَا: [الْوَجْهُ].

97
00:10:19,520 --> 00:10:22,520
فَهَذِهِ الْأَلْفَاظُ كُلُّهَا

98
00:10:22,520 --> 00:10:24,520
بِمَعْنًى وَاحِدٍ،

99
00:10:24,520 --> 00:10:27,520
وَالْأَصْلُ عِنْدَ ذِكْرِ

100
00:10:27,520 --> 00:10:30,520
تَعَدُّدِهَا وُقُوعُهُ كَذَلِكَ،

101
00:10:30,520 --> 00:10:33,853
فَإِذَا قِيلَ فِي حَدِيثٍ مَا:

102
00:10:33,853 --> 00:10:37,187
يَرْوِيهِ [الْبُخَارِيُّ] وَ[مُسْلِمٌ] رَوَيَاهُ

103
00:10:37,187 --> 00:10:40,520
مِنْ طُرُقٍ عَنْ أَبِي هُرَيْرَةَ،

104
00:10:40,520 --> 00:10:43,793
فَشَرْطُهُ أَنْ يَكُونَ عِنْدَهُمَا مَرْوِيًّا مِنْ

105
00:10:43,793 --> 00:10:46,520
حَدِيثِ جَمَاعَةٍ مِنْ أَصْحَابِهِ عَنْهُ،

106
00:10:46,520 --> 00:10:48,520
كَعَبْدِ الرَّحْمَنِ الْأَعْرَجِ،

107
00:10:48,520 --> 00:10:50,520
وَسَعِيدِ بْنِ الْمُسَيِّبِ،

108
00:10:50,520 --> 00:10:52,520
وَمُحَمَّدِ بْنِ سِيرِينَ،

109
00:10:52,520 --> 00:10:55,520
وَغَيْرِهِمْ مِنْ أَصْحَابِهِ،

110
00:10:55,520 --> 00:10:58,720
فَإِنْ كَانَتْ تِلْكَ الطُّرُقُ

111
00:10:58,720 --> 00:11:01,920
الْمُتَفَرِّعَةُ فِي أَعْلَاهَا تَجْتَمِعُ

112
00:11:01,920 --> 00:11:04,520
فِي شَيْءٍ فِي

113
00:11:04,520 --> 00:11:07,742
أَدْنَاهَا قِيلَ: أَخْرَجُوهُ مِنْ طَرِيقِ

114
00:11:07,742 --> 00:11:10,520
فُلَانٍ عَنْ فُلَانٍ عَنْ فُلَانٍ

115
00:11:10,520 --> 00:11:12,520
كَهَذَا الْحَدِيثِ،

116
00:11:12,520 --> 00:11:15,520
فَهَذَا الْحَدِيثُ أَخْرَجَهُ هَؤُلَاءِ مِنْ

117
00:11:15,520 --> 00:11:18,520
حَدِيثِ عَبْدِ السَّلَامِ بْنِ حَرْبٍ،

118
00:11:18,520 --> 00:11:20,520
عَنْ غُطَيْفِ بْنِ أَعْيَنَ،

119
00:11:20,520 --> 00:11:22,520
عَنْ مُصْعَبِ بْنِ سَعْدٍ،

120
00:11:22,520 --> 00:11:24,520
عَنْ عَدِيِّ بْنِ حَاتِمٍ،

121
00:11:24,520 --> 00:11:27,949
فَمَدَارُهُ عِنْدَهُمْ عَلَى

122
00:11:27,949 --> 00:11:32,520
عَبْدِ السَّلَامِ بْنِ حَرْبٍ،

123
00:11:32,520 --> 00:11:35,793
فَلَمْ يُحْسَنْ حِينَئِذٍ إِطْلَاقُ

124
00:11:35,793 --> 00:11:39,065
الْقَوْلِ [مِنْ طُرُقٍ] الْوَاقِعِ

125
00:11:39,065 --> 00:11:41,520
فِي كَلَامِ الْمُصَنِّفِ،

126
00:11:41,520 --> 00:11:44,429
وَذَكَرْتُ لَكُمْ فِيمَا سَلَفَ

127
00:11:44,429 --> 00:11:47,338
أَنَّ جَمَاعَةً مِمَّنْ تَقَدَّمَ

128
00:11:47,338 --> 00:11:49,520
يُطْلِقُونَ هَذَا الْقَوْلَ،

129
00:11:49,520 --> 00:11:52,853
ثُمَّ إِذَا كُشِفَ عَنْ تِلْكَ

130
00:11:52,853 --> 00:11:56,187
الطُّرُقِ الْمُعَبَّرِ عَنْهَا بِالْجَمْعِ وُجِدَتْ

131
00:11:56,187 --> 00:11:57,520
طَرِيقًا وَاحِدَةً،

132
00:11:57,520 --> 00:12:00,949
كَقَوْلِ [النَّوَوِيِّ] فِي غَيْرِ مَوْضِعٍ مِنْ

133
00:12:00,949 --> 00:12:04,145
[أَذْكَارِهِ]: رَوَاهُ فُلَانٌ وَفُلَانٌ

134
00:12:04,145 --> 00:12:08,520
بِأَسَانِيدَ جَيِّدَةٍ أَوْ بِأَسَانِيدَ صَحِيحَةٍ،

135
