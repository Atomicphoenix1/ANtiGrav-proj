235
00:30:40,083 --> 00:30:41,050
مَا خَالَفَ فِيهِ بَعْضُ الْمُتَأَخِّرِينَ مِنْ أَشْيَاخِنَا.

236
00:30:40,567 --> 00:30:41,050
وَالَّذِينَ قَالُوا بِإِضَافَتِهِ إِضَافَةَ مَخْلُوقٍ اخْتَلَفُوا فِي تَعْيِينِهِ

237
00:30:53,617 --> 00:30:54,583
عَلَى أَقْوَالٍ مُتَعَدِّدَةٍ سَبَقَ ذِكْرُهَا

238
00:31:17,962 --> 00:31:18,827
فِي غَيْرِ هَذَا الْمَقَامِ؛

239
00:31:40,300 --> 00:31:41,300
فَهِيَ إِضَافَةُ مَخْلُوقٍ إِلَى

240
00:31:49,800 --> 00:31:50,800
اللَّهِ تَشْرِيفًا لَهُ.

241
00:31:50,300 --> 00:31:50,800
- قَوْلُهُ: هَلْ طَلَبُ الرُّقْيَةِ لِغَيْرِهِ دَاخِلٌ

242
00:31:54,300 --> 00:31:55,300
فِي قَوْلِهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: [وَلَا يَسْتَرْقُونَ] كَمَنْ يَطْلُبُ

243
00:31:54,800 --> 00:31:55,300
مِنْ رَجُلٍ رُقْيَةً لِابْنِهِ؟

244
00:31:54,800 --> 00:31:56,300
أَيْ أَنَّهُ لَا يَطْلُبُهَا لِنَفْسِهِ لَكِنْ يَطْلُبُهَا لِغَيْرِهِ؟

245
00:31:55,800 --> 00:31:56,300
فَذَكَرْتُ

246
00:32:03,612 --> 00:32:04,821
أَنَّ هَذِهِ الْمَسْأَلَةَ مِنَ الْمَسْائِلِ الَّتِي عَرَضْتُهَا عَلَى جَمَاعَةٍ مِنْ

247
00:32:04,217 --> 00:32:04,821
أَشْيَاخِي فَاخْتَلَفُوا فِيهَا عَلَى قَوْلَيْنِ: أَحَدُهُمَا: أَنَّهُ يَدْخُلُ

248
00:32:20,529 --> 00:32:21,737
فِي جُمْلَةِ

249
00:32:26,571 --> 00:32:27,779
ذَلِكَ فَيَكُونُ مَمْنُوعًا مِنْهُ.

250
00:32:27,175 --> 00:32:27,779
وَالْآخَرُ: أَنَّهُ

251
00:32:31,265 --> 00:32:32,196
لَا يَدْخُلُ فِي جُمْلَةِ ذَلِكَ فَيَكُونُ غَيْرَ مَمْنُوعٍ مِنْهُ.

252
00:32:31,731 --> 00:32:32,196
وَالَّذِي ظَهَرَ لِي هُوَ الْجَمْعُ بَيْنَ الْقَوْلَيْنِ بِأَنْ يُقَالُ: إِنَّهُ

253
00:32:31,731 --> 00:32:32,196
إِنْ طَلَبَهُ لِحَظٍّ مِنْهُ كَانَ دَاخِلًا فِي قَوْلِهِ: [وَلَا يَسْتَرْقُونَ]،

254
00:32:31,731 --> 00:32:33,592
وَإِنْ طَلَبَهُ لِحَظِّ نَفْسِهِ فَإِنَّهُ لَا يَكُونُ دَاخِلًا فِي قَوْلِهِ:

255
00:32:33,127 --> 00:32:33,592
[وَلَا يَسْتَرْقُونَ].

256
00:32:33,127 --> 00:32:33,592
وَبَيَانُ هَذِهِ الْمَسْأَلَةِ: لَوْ قُدِّرَ أَنَّ رَجُلًا

257
00:32:54,535 --> 00:32:55,472
لَهُ صَدِيقٌ يُحِبُّهُ وَأَخٌ

258
00:32:59,245 --> 00:32:59,717
فِي

259
00:33:02,650 --> 00:33:03,447
اللَّهِ مَرِضَ مَرَضًا شَدِيدًا،

260
00:33:03,049 --> 00:33:04,641
فَابْتَغَى أَنْ يَلْتَمِسَ

261
00:33:18,040 --> 00:33:19,329
لَهُ رَاقِيًا،

262
00:33:18,684 --> 00:33:19,329
فَإِنْ كَانَ قَصْدُهُ

263
00:33:35,585 --> 00:33:36,588
مِنِ الْتِمَاسِ الرَّاقِي حَظَّهُ هُوَ

264
00:33:40,101 --> 00:33:42,108
مِنْ ذَلِكَ الْآخَرِ بِبَقَاءِ حَيَاتِهِ وَدَوَامِ مَوَدَّتِهِ وَالِانْتِفَاعِ بِصُحْبَتِهِ فَهُوَ

265
00:33:41,606 --> 00:33:43,614
دَاخِلٌ لِوُجُودِ الْتِفَاتِ قَلْبِيٍّ إِلَى

266
00:33:55,318 --> 00:33:56,534
هَذَا الْحَظِّ،

267
00:33:55,926 --> 00:33:56,534
وَإِنْ لَمْ يَكُنْ

268
00:33:58,966 --> 00:34:00,790
فِي قَلْبِهِ الْتِفَاتٌ إِلَى هَذَا الْمَعْنَى وَكَانَ مُرَادُهُ هُوَ نَفْعَ

269
00:34:00,182 --> 00:34:00,790
أَخِيهِ بِرَدِّ صِحَّتِهِ إِلَيْهِ وَإِعَانَتِهِ

270
00:34:05,326 --> 00:34:06,578
عَلَى دَفْعِ الضُّرِّ عَنْهُ لِيَتَمَكَّنَ

271
00:34:26,496 --> 00:34:27,450
مِنْ أَدَاءِ الْفَرَائِضِ الَّتِي أَمَرَهُ

272
00:34:41,275 --> 00:35:07,779
اللَّهُ عَزَّ وَجَلَّ بِهَا لَمْ يَكُنْ دَاخِلًا فِي هَذَا.

273
00:35:07,261 --> 00:35:08,297
- قَوْلُهُ: قَالَ

274
00:35:17,465 --> 00:35:18,610
فِي قَوْلِهِ [وَلَا يَكْتَوُونَ]،

275
00:35:18,037 --> 00:35:18,610
قَالَ الشَّيْخُ: [وَتَلَذُّذًا بِالْبَلَاءِ]،

276
00:35:18,037 --> 00:35:18,610
هَلْ يَتَلَذَّذُ الْمُؤْمِنُ بِالْبَلَاءِ؟

277
00:35:39,195 --> 00:35:39,697
هَذَا

278
00:35:48,117 --> 00:35:49,090
الَّذِي ذَكَرَهُ الشَّيْخُ رَحِمَهُ اللَّهُ تَعَالَى عَنِ [الشَّارِحِ]

279
00:36:01,325 --> 00:36:02,247
فِي قَوْلِهِ: [وَتَلَذُّذًا بِالْبَلَاءِ] عِنْدَ

280
00:36:11,933 --> 00:36:12,856
[وَلَا يَكْتَوُونَ] يَعْنِي مِمَّا يَرْجِعُ إِلَى تَلَقِّي الْقَدَرِ الْمُؤْلِمِ؛ فَهُوَ

281
00:36:12,394 --> 00:36:12,856
لَمْ يَطْلُبِ التَّلَذُّذَ بِالْبَلَاءِ ابْتِدَاءً،

282
00:36:12,394 --> 00:36:13,317
لَكِنْ لَمَّا وَقَعَ الْقَدَرُ الْمُؤْلِمُ عَلَيْهِ

283
00:36:23,464 --> 00:36:24,386
كَانَ مِمَّا يُخَفِّفُهُ عَنْ نَفْسِهِ وُجُودُ التَّلَذُّذِ بِالْبَلَاءِ مِنْهُ بِأَنْ

284
00:36:23,925 --> 00:36:24,386
يَسْتَحْضِرَ الْأَجْرَ الَّذِي رَتَّبَهُ

285
00:36:36,986 --> 00:36:38,004
اللَّهُ سُبْحَانَهُ وَتَعَالَى لَهُ عَلَى الصَّبْرِ،

286
00:36:37,495 --> 00:36:38,004
وَهُوَ أَقَلُّ مَرَاتِبِ تَلَقِّي الْقَدَرِ؛ فَإِنَّ تَلَقِّي الْقَدَرِ الْمُؤْلِمِ لَهُ

287
00:36:37,495 --> 00:36:38,004
ثَلَاثُ مَرَاتِبَ: - الْمَرْتَبَةُ الْأُولَى: تَلَقِّيهِ بِالصَّبْرِ،

288
00:36:37,495 --> 00:36:38,004
وَحَقِيقَتُهُ حَبْسُ النَّفْسِ عَنِ الْجَزَعِ،

289
00:36:37,495 --> 00:36:38,004
وَاللِّسَانِ عَنِ التَّسَخُّطِ،

290
00:36:37,495 --> 00:36:38,004
وَالْجَوَارِحِ عَمَّا حَرَّمَ اللَّهُ،

291
00:36:37,495 --> 00:36:38,004
وَهَذِهِ الْحَقِيقَةُ خَاصَّةٌ بِالصَّبْرِ الْمُتَعَلِّقِ بِهَذَا الْمَقَامِ لَا بِالنَّظَرِ إِلَى

292
00:36:37,495 --> 00:36:39,531
الْحَقِيقَةِ الْكَامِلَةِ لِلصَّبْرِ كَمَا سَبَقَ بَيَانُهُ فِي غَيْرِ هَذَا الْمَقَامِ.

293
00:36:39,022 --> 00:36:39,531
- الْمَرْتَبَةُ الثَّانِيَةُ: تَلَقِّيهِ بِالرِّضَا،

294
00:36:39,022 --> 00:36:39,531
بِأَنْ لَا يَبْقَى

295
00:36:43,094 --> 00:36:44,111
فِي نَفْسِ

296
00:36:50,219 --> 00:36:51,236
مَنْ وَقَعَ عَلَيْهِ الْقَدَرُ مُجَاذَبَةٌ لِلْقَدَرِ وَمَرَارَةٌ،

297
00:36:50,727 --> 00:36:51,236
فَالْمَرَارَةُ الَّتِي تَعْتَرِيهِ حَالَ الصَّبْرِ تَزُولُ حَالَ الرِّضَا،

298
00:36:50,727 --> 00:36:51,236
فَيَكُونُ مُسَلِّمًا لِأَمْرِ اللَّهِ عَزَّ وَجَلَّ.

299
00:36:50,727 --> 00:36:51,236
- الْمَرْتَبَةُ الثَّالِثَةُ: تَلَقِّيهِ بِالشُّكْرِ،

300
00:36:50,727 --> 00:36:51,236
وَهُوَ الزَّائِدُ عَنِ الرِّضَا وَمِنَ الْمَرْتَبَتَيْنِ السَّابِقَتَيْنِ بِخُلُوِّ النَّفْسِ

301
00:36:56,240 --> 00:36:57,350
مِنَ الْمَرَارَةِ وَالْمُنَازَعَةِ مَعَ شُهُودِ النِّعْمَةِ الْكَامِلَةِ

302
00:37:03,682 --> 00:37:04,587
مِنَ اللَّهِ عَزَّ وَجَلَّ إِذْ أَجْرَى عَلَيْهِ هَذَا الْبَلَاءَ.

303
00:37:04,135 --> 00:37:04,587
وَإِذَا أَرَدْتَ أَنْ تَقْرَأَ خَبَرًا عَظِيمًا بِشُكْرِ اللَّهِ عَلَى تَلَقِّي

304
00:37:04,135 --> 00:37:04,587
الْبَلَاءِ، فَاقْرَأْ

305
00:37:29,372 --> 00:37:32,468
مَا ذَكَرَهُ [ابْنُ حِبَّانَ] فِي كِتَابِ [الثِّقَاتِ]

306
00:37:33,501 --> 00:37:34,533
فِي تَرْجَمَةِ [أَبِي قِلَابَةَ عَبْدِ اللَّهِ بْنِ زَيْدٍ الْجَرْمِيِّ] رَحِمَهُ

307
00:37:34,017 --> 00:37:34,533
اللَّهُ تَعَالَى؛ فَإِنَّ رَجُلًا

308
00:37:57,123 --> 00:37:57,706
مِنْ

309
00:38:23,587 --> 00:38:24,603
أَهْلِ الشَّامِ حَدَّثَ أَنَّهُ كَانَ سَائِرًا لِلْغَزَاةِ فَمَرَّ بِالْعَرِيشِ فَسَمِعَ

310
00:38:24,095 --> 00:38:24,603
صَوْتًا يَحْمَدُ

311
00:38:36,296 --> 00:38:37,313
اللَّهَ وَيَشْكُرُهُ بِكَلَامٍ أَعْجَبَهُ،

312
00:38:36,804 --> 00:38:37,313
فَذَهَبَ نَحْوَ الصَّوْتِ إِلَى الْخَيْمَةِ،

313
00:38:36,804 --> 00:38:37,313
فَلَمَّا دَخَلَهَا سَلَّمَ فَرَأَى رَجُلًا هُوَ [عَبْدُ

314
00:38:42,905 --> 00:38:43,922
اللَّهِ بْنُ زَيْدٍ] فَاتَّقَطَعَتْ يَدَاهُ وَرِجْلَاهُ وَكَفَّ بَصَرَهُ وَيَقُولُ مَعَ

315
00:38:43,413 --> 00:38:43,922
ذَلِكَ: [الْحَمْدُ

316
00:38:54,888 --> 00:38:57,592
لِلَّهِ الَّذِي أَنْعَمَ عَلَيَّ]،

317
00:38:57,592 --> 00:38:57,978
وَيَشْكُرُ اللَّهَ عَزَّ وَجَلَّ شُكْرًا كَثِيرًا،

318
00:38:57,592 --> 00:38:57,978
ذَكَرَهُ فِي تَرْجَمَتِهِ،

319
00:38:57,592 --> 00:38:57,978
ثُمَّ صَارَ لَهُ مَعَهُ قِصَّةٌ طَوِيلَةٌ تَحْسُنُ مُرَاجَعَتُهَا.

320
00:38:57,592 --> 00:38:57,978
فَيَكُونُ قَوْلُهُ: [تَلَذُّذًا بِالْبَلَاءِ] يَعْنِي بَعْدَ وُقُوعِهِ لَا طَلَبًا لِحُصُولِهِ.

321
00:38:57,592 --> 00:38:57,978
- يَقُولُ هَذَا السَّائِلُ: هَلْ مَجَالِسُ تَعْلِيمِ التَّوْحِيدِ مِنْ أَعْظَمِ

322
00:38:57,592 --> 00:38:57,978
الْمَجَالِسِ الَّتِي يُحَارِبُهَا الشَّيْطَانُ؟

323
00:38:57,592 --> 00:38:57,978
إِي وَاللَّهِ؛ لِأَنَّ اللَّهَ قَالَ عَنْهُ: ﴿فَبِمَا أَغْوَيْتَنِي لَأَقْعُدَنَّ لَهُمْ

324
00:38:57,592 --> 00:38:57,978
صِرَاطَكَ الْمُسْتَقِيمَ﴾،

325
00:38:57,592 --> 00:38:57,978
وَأَصْلُ الصِّرَاطِ هُوَ تَوْحِيدُ اللَّهِ سُبْحَانَهُ وَتَعَالَى،

326
00:38:57,592 --> 00:38:57,978
فَمَجَالِسُ التَّوْحِيدِ يَحُولُ الشَّيْطَانُ بَيْنَ النَّاسِ وَبَيْنَهَا،

327
00:38:57,592 --> 00:38:57,978
وَتَخْرُجُ مِنَ الْمَقَالَاتِ مَا تُزَهِّدُ فِيهَا،

328
00:38:57,592 --> 00:38:57,978
كَمَا قَالَ [إِمَامُ الدَّعْوَةِ] فِي كِتَابِ [كَشْفِ الشُّبُهَاتِ]: [وَأَمَّا قَوْلُهُمُ

329
00:38:57,592 --> 00:38:57,978
التَّوْحِيدُ فَهِمْنَاهُ،

330
00:38:57,592 --> 00:38:57,978
فَمِنْ أَعْظَمِ الْجَهْلِ وَمَكَايِدِ الشَّيْطَانِ]،

331
00:38:57,592 --> 00:38:57,978
فَالشَّيْطَانُ يَصُدُّ النَّاسَ عَنْ مَجَالِسِ التَّوْحِيدِ سَوَاءً الْمُعَلِّمِينَ أَمِ الْمُتَعَلِّمِينَ؛

332
00:38:57,592 --> 00:38:57,978
فَهُوَ قَاعِدٌ لَهُمْ فِي مَنْعِهِمْ وَدَفْعِهِمْ عَنْ هَذَا الْخَيْرِ.

333
00:38:57,592 --> 00:38:57,978
وَإِذَا عَقَلَ الْإِنْسَانُ هَذَا الْأَمْرَ عَرَفَ أَنَّ الْقِيَامَ بِذَلِكَ تَعْلِيمًا،

334
00:38:57,592 --> 00:38:57,978
وَالْجُلُوسَ فِيهِ تَعَلُّمًا مِنْ أَعْظَمِ الْجِهَادِ،

335
00:38:57,592 --> 00:38:57,978
وَأَنَّ الْمَرْءَ يَنْبَغِي أَنْ يُجَاهِدَ فِي ذَلِكَ بِحَمْلِ نَفْسِهِ عَلَى

336
00:38:57,592 --> 00:38:57,978
التَّعْلِيمِ وَالتَّعَلُّمِ،

337
00:38:57,592 --> 00:38:57,978
وَالصَّبْرِ وَالْمُجَاهَدَةِ وَالْمُكَابَدَةِ،

338
00:38:57,592 --> 00:38:57,978
وَطَرْدِ النُّعَاسِ عَنْهُ،

339
00:38:57,592 --> 00:38:57,978
وَإِمْضَاءِ أَوْقَاتٍ طَوِيلَةٍ فِي تَفَهُّمِهِ وَمُرَاجَعَةِ مَسَائِلِهِ وَتَحَفُّظِهَا وَالْعَمَلِ بِهَا؛

340
00:38:57,592 --> 00:38:57,978
فَهُوَ مِنْ أَعْظَمِ مَا يَكِيدُ الشَّيْطَانُ لِلنَّاسِ بِخَلْقٍ فِي طَلَبِ

341
00:38:57,592 --> 00:38:57,978
إِزَالَتِهِ. - يَقُولُ هَذَا الْأَخُ: ذَكَرْتُمْ أَنَّ الْإِيمَانَ هُوَ التَّصْدِيقُ

342
00:38:57,592 --> 00:38:57,978
الْجَازِمُ تَعَبُّدًا لِلَّهِ بِالشَّرْعِ الْمُنَزَّلِ عَلَى مَقَامِ الْمُشَاهَدَةِ وَالْمُرَاقَبَةِ فِي

343
00:38:57,592 --> 00:38:57,978
عَدَمِ ذِكْرِ الْعَمَلِ فِي عَدِّ الْإِيمَانِ؟

344
00:38:57,592 --> 00:38:57,978
نَقُولُ: إِنَّ هَذَا الَّذِي ذَكَرْنَا قُلْنَا فِيهِ هُوَ: التَّصْدِيقُ الْجَازِمُ

345
00:38:57,592 --> 00:38:57,978
بِاللَّهِ بَاطِنًا وَظَاهِرًا،

346
00:38:57,592 --> 00:38:57,978
تَعَبُّدًا لَهُ بِالشَّرْعِ الْمُنَزَّلِ عَلَى مَقَامِ الْمُشَاهَدَةِ وَالْمُرَاقَبَةِ؛ فَيَكُونُ الْعَمَلُ

347
00:38:57,592 --> 00:38:57,978
مَذْكُورًا فِي قَوْلِنَا: [بَاطِنًا وَظَاهِرًا]،

348
00:38:57,592 --> 00:38:57,978
وَلَا فِيهِ شَيْءٌ آخَرُ،

349
00:38:57,592 --> 00:38:59,137
[تَعَبُّدًا]، قَوْلُنَا [تَعَبُّدًا بِالشَّرْعِ الْمُنَزَّلِ عَلَى مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ

350
00:38:58,751 --> 00:38:59,137
وَسَلَّمَ]. - هَذَا يَقُولُ: أَشْكَلَ عَلَيَّ كَلَامُ الشَّيْخِ [ابْنِ عُثَيْمِينَ]

351
00:38:58,751 --> 00:38:59,137
رَحِمَهُ اللَّهُ فِي تَفْسِيرِ الْحَدِيثِ: [لَمْ يَعْمَلْ خَيْرًا قَطُّ]،

352
00:38:58,751 --> 00:38:59,137
كَيْفَ يَكُونُ مَعْذُورًا وَيَكُونُ فِي النَّارِ؟

353
00:38:58,751 --> 00:38:59,137
ذَكَرْنَا أَنَّ التَّعْذِيبَ حِينَئِذٍ فِي النَّارِ هُوَ فِي مُقَابِلِ عِبَارَةِ

354
00:38:58,751 --> 00:38:59,137
مَا قُلْنَا فِي التَّفْسِيرِ فِي مُقَابِلِ (التَّفْرِيطِ).

355
00:38:58,751 --> 00:38:59,137
- يَقُولُ: مَنْ مُحَقِّقُ كِتَابِ [قُرَّةِ عَيْنِ الْمُوَحِّدِينَ] الَّتِي بَيْنَ

356
00:38:58,751 --> 00:38:59,137
يَدَيْكُمْ؟ وَالدَّارُ النَّاشِرَةُ؟

357
00:38:58,751 --> 00:38:59,137
الْمُحَقِّقُ لَا أَذْكُرُهُ الْآنَ،

358
00:38:58,751 --> 00:38:59,137
لَكِنَّ الدَّارَ النَّاشِرَةَ هِيَ [دَارُ التَّوْحِيدِ]؛ لِذَلِكَ كُنَّا نُحِيلُ عَلَيْهَا

359
00:38:58,751 --> 00:38:59,137
فِي الصَّفَحَاتِ،

360
00:38:58,751 --> 00:38:59,137
فَيَنْبَغِي أَنْ تَكُونَ عِنْدَ طَالِبِ الْعِلْمِ لِأَنَّهَا طَبْعَةٌ عَلَى عِدَّةِ

361
00:38:58,751 --> 00:38:59,137
نُسْخَاتٍ خَطِّيَّةٍ،

362
00:38:58,751 --> 00:38:59,137
وَإِنْ كَانَ مُحَقِّقُهَا لَمْ يُقَوِّمْ كَثِيرًا مِنْ سِيَاقِ الْمَتْنِ فِيهَا،

363
00:38:58,751 --> 00:38:59,137
مِنْ سِيَاقِ الْكَلَامِ فِيهَا.

364
00:38:58,751 --> 00:38:59,137
- يَقُولُ: هَذَا قَدْ قَرَّرْتُمْ أَنَّ الَّذِينَ أَخْلَصُوا الْعِبَادَةَ لِلَّهِ

365
00:38:58,751 --> 00:38:59,137
وَحْدَهُ وَلَمْ يُشْرِكُوا بِهِ شَيْئًا هُمُ الْآمِنُونَ فِي الدُّنْيَا وَالْآخِرَةِ،

366
00:38:58,751 --> 00:38:59,137
الْإِشْكَالُ أَنَّ بَعْضَ الْأَنْبِيَاءِ قَدْ عُذِّبُوا وَقُتِلُوا وَلَمْ يَحْصُلْ لَهُمُ

367
00:38:58,751 --> 00:38:59,137
الْأَمْنُ فِي الدُّنْيَا وَهُمْ أَعْلَى النَّاسِ تَحْقِيقًا لِالتَّوْحِيدِ؟

368
00:38:58,751 --> 00:38:59,137
الَّذِي ذَكَرْنَاهُ هُوَ فِي كَلَامِ جَمَاعَةٍ مِنَ السَّلَفِ وَاخْتَارَهُ جَمَاعَةٌ

369
00:38:58,751 --> 00:38:59,137
مِنَ الْأَئِمَّةِ كَـ [أَبِي الْعَبَّاسِ ابْنِ تَيْمِيَّةَ]،

370
00:38:58,751 --> 00:38:59,137
وَمَا ذَكَرَهُ السَّائِلُ لَا يُشْكِلُ عَلَى ذَلِكَ؛ لِأَنَّهُ لَيْسَ الْأَمَانُ

371
00:38:58,751 --> 00:38:59,137
هُوَ عَدَمَ الْعَذَابِ وَالْقَتْلِ،

372
00:38:58,751 --> 00:38:59,137
بَلِ الْأَمَانُ هُوَ سُكُونُ الْقَلْبِ وَطُمَأْنِينَتُهُ؛ فَحَقِيقَةُ وُجُودِ الْأَمَانِ أَنْ

373
00:38:58,751 --> 00:38:59,137
يَكُونَ الْقَلْبُ سَاكِنًا مُطْمَئِنًّا،

374
00:38:58,751 --> 00:38:59,137
وَالْعَذَابُ وَالْقَتْلُ يَكُونُ عَلَى الْجَسَدِ الظَّاهِرِ،

375
00:38:58,751 --> 00:38:59,137
وَلِهَذَا ذَكَرْتُ لَكُمْ أَنَّهُ لَيْسَ الْمَطْلُوبُ مِنَ الْأَمْنِ مُجَرَّدَ حِفْظِ

376
00:38:58,751 --> 00:38:59,137
الدِّمَاءِ وَالْأَمْوَالِ،

377
00:38:58,751 --> 00:38:59,137
بَلِ الْمَقْصُودُ الْأَعْظَمُ هُوَ طُمَأْنِينَةُ الْقُلُوبِ،

378
00:38:58,751 --> 00:38:59,137
وَالْعَبْدُ إِذَا لَمْ يَطْمَئِنَّ قَلْبُهُ لَمْ يَكُنْ لَهُ أَمْنٌ،

379
00:38:58,751 --> 00:38:59,137
وَهَذَا ظَاهِرٌ فِي كَثِيرٍ مِنَ الْبِلَادِ الَّتِي فِيهَا النَّارُ وَالْحَدِيدُ

380
00:38:58,751 --> 00:38:59,137
وَلَكِنَّ قُلُوبَ أَهْلِهَا مُعَذَّبَةٌ،

381
00:38:58,751 --> 00:38:59,137
وَسَبَقَ أَنْ ذَكَرْتُ لَكُمْ مَا قَالَهُ [أَبُو الْعَبَّاسِ ابْنُ تَيْمِيَّةَ]

382
00:38:58,751 --> 00:38:59,137
فِي كَلَامٍ لَهُ قَالَ فِيهِ: [أَشَدُّ الْعَذَابِ عَذَابُ الْقَلْبِ].

383
00:38:58,751 --> 00:38:59,137
هِيَ أَسْئِلَةٌ جَيِّدَةٌ لَكِنَّهَا -يَعْنِي- لَيْسَ هَذَا الْمَقَامَ أَنْ نُجِيبَ

384
00:38:58,751 --> 00:38:59,137
عَلَى كُلِّ سُؤَالٍ،

385
00:38:58,751 --> 00:38:59,137
قُلْنَا الْأَسْئِلَةُ التَّعَلُّقُ بِالدَّرْسِ.

386
00:38:58,751 --> 00:38:59,137
- يَقُولُ: هَلْ تَعْرِيفُ الْأَمَانِ الَّذِي ذَكَرْتَهُ مِنْ قَوْلِكَ أَمْ

387
00:38:58,751 --> 00:38:59,137
لِغَيْرِكَ؟ فَإِنْ كَانَ لِغَيْرِكَ مَنْ هُوَ لِلْفَائِدَةِ لَا غَيْرَ؟

388
00:38:58,751 --> 00:38:59,137
أَنَا أُحْسِنُ الظَّنَّ بِكَ أَنَّكَ لَمْ تَسْأَلْ إِلَّا لِلْفَائِدَةِ،

389
00:38:58,751 --> 00:38:59,137
وَهَذَا الْحَدُّ الَّذِي ذَكَرْتُهُ هُوَ شَيْءٌ جَمَعْتُهُ مَعَ الْأَيَّامِ وَاللَّيَالِي؛

390
00:38:58,751 --> 00:38:59,137
لِأَنَّ تَعْرِيفَ الْأَمَانِ إِنَّمَا يَذْكُرُهُ أَهْلُ السُّنَّةِ بِبَيَانِ أَرْكَانِهِ الْمُتَعَلِّقَةِ

391
00:38:58,751 --> 00:38:59,137
بِهِ فِي قَوْلِهِمْ: [اعْتِقَادٌ وَقَوْلٌ وَعَمَلٌ]،

392
00:38:58,751 --> 00:38:59,137
وَهَذَا إِنَّمَا هُوَ بَيَانٌ لِلْأَرْكَانِ الَّتِي يَدُورُ عَلَيْهَا لَا بَيَانًا

393
00:38:58,751 --> 00:38:59,137
لِحَقِيقَتِهِ الَّتِي يَكُونُ بِهَا مُعَبِّرًا عَنِ الدِّينِ كُلِّهِ،

394
00:38:58,751 --> 00:38:59,137
فَهَذَا الَّذِي ذَكَرْنَاهُ هُوَ مِنْ نَتَائِجِ الْأَفْكَارِ مَعَ الْأَيَّامِ وَاللَّيَالِي

395
00:38:58,751 --> 00:38:59,137
فَخُذْهَا فَائِدَةً.

396
00:38:58,751 --> 00:38:59,137
- قُلْ ذَكَرَ الشَّارِحُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

397
00:38:58,751 --> 00:38:59,137
دَعَا لِـ [أَنَسٍ] بِقَوْلِهِ: [اللَّهُمَّ أَكْثِرْ مَالَهُ وَوَلَدَهُ وَبَارِكْ لَهُ

398
00:38:58,751 --> 00:38:59,137
فِيهِ]، فَهَلِ الْأَفْضَلُ أَنْ يَدْعُوَ الْعَبْدُ لِنَفْسِهِ بِهَذَا أَمْ بِأَنْ

399
00:38:58,751 --> 00:38:59,137
يَجْعَلَ اللَّهُ رِزْقَهُ قُوتًا؟

400
00:38:58,751 --> 00:38:59,137
الْأَكْمَلُ أَنْ يَدْعُوَ الْعَبْدُ مِمَّا جَاءَ فِي الْكِتَابِ وَالسُّنَّةِ،

401
00:38:58,751 --> 00:38:59,137
فَكُلُّ ذَلِكَ وَارِدٌ فِي الْكِتَابِ وَالسُّنَّةِ،

402
00:38:58,751 --> 00:38:59,137
وَقَدْرُ ذَلِكَ رَاجِعٌ إِلَى اللَّهِ سُبْحَانَهُ وَتَعَالَى،

403
00:38:58,751 --> 00:38:59,137
فَمَا دَعَا بِهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فَادْعُ بِهِ،

404
00:38:58,751 --> 00:38:59,137
وَمَا قَدَّرَ اللَّهُ لَكَ وَقَسَمَهُ رَجُلٌ رَجُلٌ فَارْضَ بِهِ.

405
00:38:58,751 --> 00:38:59,137
- وَفِيهِ رِسَالَةٌ قَالُوا: حَفِظَكُمُ اللَّهُ،

406
00:38:58,751 --> 00:38:59,137
إِنَّ دَوْلَتَكُمُ الرَّشِيدِ سَلَفِيَّةٌ عِلْمًا أَنَّهَا تَابِعَةٌ لِلدَّوْلَةِ الْعُثْمَانِيَّةِ وَكَانَتْ

407
00:38:58,751 --> 00:38:59,137
عَلَى بِدَعٍ وَشِرْكٍ؟

408
00:38:58,751 --> 00:38:59,137
مَنْ قَالَ لَكَ إِنَّهَا تَابِعَةٌ لِلدَّوْلَةِ الْعُثْمَانِيَّةِ؟

409
00:38:58,751 --> 00:38:59,137
مَنْ قَالَ لَكَ؟

410
00:38:58,751 --> 00:38:59,137
ثُمَّ قَوْلُكَ طَبَعُوا كِتَابَ [ابْنِ جَرِيرٍ] وَالْمَعْلُومَةُ الَّتِي طَبَعَهَا الْمِصْرِيُّونَ

411
00:38:58,751 --> 00:38:59,137
وَأَخَذُوا النُّسْخَةَ مِنْ أَحَدِ أُمَرَاءِ [الرَّشِيدِ] هُمْ طَبَعُوهَا بِمَالِ أَمِيرِ

412
00:38:58,751 --> 00:38:59,137
حَائِلٍ، فَهُوَ الَّذِي دَفَعَ الْمَالَ فِي طِبَاعَةِ هَذَا الْكِتَابِ،

413
00:38:58,751 --> 00:38:59,137
وَجَمَعَ نُسَخَهُ وَأَلَّفَ نُسْخَةً كَامِلَةً وَطَبَعَهُ،

414
00:38:58,751 --> 00:38:59,137
وَوُجُودُ شَيْءٍ مِنَ الْمُخَالَفَاتِ فِي دَوْلَةِ [آلِ رَشِيدٍ] لَا يَعْنِي

415
00:38:58,751 --> 00:38:59,137
أَنَّهَا لَا تَكُونُ دَوْلَةً سَلَفِيَّةً كَوُجُودِ الْمُخَالَفَاتِ فِي دَوْلَةِ غَيْرِهِمْ،

416
00:38:58,751 --> 00:38:59,137
وَلَيْسَ الْمَقْصُودُ الْعَصَبِيَّةُ لِأَحَدٍ دُونَ أَحَدٍ،

417
00:38:58,751 --> 00:38:59,137
نَحْنُ كُنَّا نُقَرِّرُ أَنَّ مَنْ يَزْعُمُ أَنَّ التَّوْحِيدَ فِي هَذِهِ

418
00:38:58,751 --> 00:38:59,137
الْبِلَادِ إِنَّمَا هُوَ دِينُ دَوْلَةِ [آلِ سُعُودٍ] هَذَا كَذِبٌ وَبُهْتَانٌ،

419
00:38:58,751 --> 00:38:59,137
وَالتَّوْحِيدُ فِي أَهْلِ هَذِهِ الْبِلَادِ فِي عِدَّةِ دُوَلٍ مُخْتَلِفَةٍ فِي

420
00:38:58,751 --> 00:38:59,137
جِهَاتٍ مُتَعَدِّدَةٍ كَالْأَحْسَاءِ وَحَائِلٍ وَأَبْهَا وَغَيْرِهَا.

421
00:38:58,751 --> 00:38:59,137
- يَقُولُ هَذَا الْأَخُ: ذَكَرَ [ابْنُ الْقَيِّمِ] رَحِمَهُ اللَّهُ عَنْ

422
00:38:58,751 --> 00:38:59,137
تَوْحِيدِ الْحُبِّ لِلَّهِ،

423
00:38:58,751 --> 00:38:59,137
فَكَيْفَ الْجَمْعُ بَيْنَ تَوْحِيدِ الْمَحَبَّةِ لِلَّهِ وَمَحَبَّتِهِ لِلْأَهْلِ وَالْوَالِدِ وَالْوَالِدَيْنِ؟

424
00:38:58,751 --> 00:38:59,137
مَحَبَّةُ الْأَهْلِ وَالْوَالِدِ وَالْوَالِدَيْنِ هِيَ مَحَبَّةٌ طَبَعِيَّةٌ،

425
00:38:58,751 --> 00:38:59,137
وَالْمَحَبَّةُ الطَبَعِيَّةُ أَصْلُهَا الْإِبَاحَةُ،

426
00:38:58,751 --> 00:38:59,137
وَمِنْهَا قَدْرٌ يَزِيدُ شَرْعًا بِاعْتِبَارِ الْأَمْرِ بِهِ كَمَحَبَّةِ الْوَالِدَيْنِ فَإِنَّهُ

427
00:38:58,751 --> 00:38:59,137
مَأْمُورٌ بِهَا،

428
00:38:58,751 --> 00:38:59,137
وَتَكُونُ هَذِهِ الْمَحَبَّةُ شَرْعِيَّةً مَا لَمْ تُنَازِعْ مَحَبَّةَ اللَّهِ سُبْحَانَهُ

429
00:38:58,751 --> 00:38:59,137
وَتَعَالَى، كَأَنْ يُقَدِّمَ مَا يَدْعُوهُ إِلَيْهِ وَلَدُهُ أَوْ وَالِدُهُ أَوْ

430
00:38:58,751 --> 00:38:59,137
أَهْلُهُ عَلَى أَمْرِ اللَّهِ سُبْحَانَهُ وَتَعَالَى فَإِنَّهُ حِينَئِذٍ يَكُونُ نَاقِصَ

431
00:38:58,751 --> 00:38:59,137
الْمَحَبَّةِ لِلَّهِ عَزَّ وَجَلَّ.

432
00:38:58,751 --> 00:38:59,137
- يَقُولُ فِي السُّؤَالِ الثَّانِي: كَيْفَ سَبِيلُ التَّحْقِيقِ إِلَى تَحْقِيقِ

433
00:38:58,751 --> 00:38:59,137
الدَّرَجَةِ النَّافِلَةِ مِنْ دَرَجَةِ التَّوْحِيدِ؟

434
00:38:58,751 --> 00:38:59,137
التَّحْقِيقُ هُوَ الِازْدِيَادُ مِنْ عِبَادَةِ اللَّهِ سُبْحَانَهُ وَتَعَالَى،

435
00:38:58,751 --> 00:38:59,137
إِذَا اسْتَكْثَرَ الْعَبْدُ مِنْ عِبَادَةِ اللَّهِ عَزَّ وَجَلَّ وَمَحَّضَ تَوْحِيدَهُ

436
00:38:58,751 --> 00:38:59,137
لِلَّهِ عَزَّ وَجَلَّ فَإِنَّهُ يَمْتَلِئُ قَلْبُهُ بِالتَّوْحِيدِ وَتَنْجَذِبُ رُوحُهُ إِلَيْهِ.

437
00:38:58,751 --> 00:38:59,137
وَفِي الْحَدِيثِ الْقُدْسِيِّ عِنْدَ [الْبُخَارِيِّ] رَحِمَهُ اللَّهُ تَعَالَى مِنْ حَدِيثِ

438
00:38:58,751 --> 00:38:59,137
[سُلَيْمَانَ بْنِ بِلَالٍ عَنْ طَلْحَةَ بْنِ يَسَارٍ عَنْ أَبِي هُرَيْرَةَ]

439
00:38:58,751 --> 00:38:59,137
رَضِيَ اللَّهُ عَنْهُ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ

440
00:38:58,751 --> 00:38:59,137
فِيمَا يَرْوِيهِ عَنْ رَبِّهِ تَبَارَكَ وَتَعَالَى: [وَمَا تَقَرَّبَ إِلَيَّ عَبْدِي

441
00:38:58,751 --> 00:38:59,137
بِشَيْءٍ أَحَبَّ إِلَيَّ مِمَّا افْتَرَضْتُهُ عَلَيْهِ،

442
00:38:58,751 --> 00:38:59,137
وَمَا يَزَالُ عَبْدِي يَتَقَرَّبُ إِلَيَّ بِالنَّوَافِلِ حَتَّى أُحِبَّهُ]،

443
00:38:58,751 --> 00:38:59,137
فَالْإِمْعَانُ فِي الْعِبَادَةِ وَالْإِقْبَالُ عَلَى اللَّهِ سُبْحَانَهُ وَتَعَالَى يَبْلُغُ الْعَبْدُ

444
00:38:58,751 --> 00:38:59,137
هَذِهِ الدَّرَجَةَ،

445
00:38:58,751 --> 00:38:59,137
بَلَّغَنَا اللَّهُ وَإِيَّاكُمْ كُلَّ خَيْرٍ.

446
00:38:58,751 --> 00:38:59,137
- يَقُولُ: مَا مَعْنَى قَوْلِ [شَيْخِ الْإِسْلَامِ]: [أَشَدُّ الْعَذَابِ عَذَابُ

447
00:38:58,751 --> 00:38:59,137
قَلْبٍ]؟ يَعْنِي أَشَدُّ مَا يُوجَدُ مِنَ الْأَلَمِ هُوَ مَا يَعْتَرِي

448
00:38:58,751 --> 00:38:59,137
الْقَلْبَ مِنَ الْغُصَّةِ وَالضِّيقِ،

449
00:38:58,751 --> 00:38:59,137
فَإِنَّ الْعَبْدَ إِذَا ذَاقَ هَذِهِ الْغُصَصَ فِي قَلْبِهِ لَمْ يَطْمَئِنَّ

450
00:38:58,751 --> 00:38:59,137
فُؤَادُهُ وَلَمْ تَسْكُنْ رُوحُهُ وَكَانَ مُضْطَرِبًا قَلِقًا مُشَوَّشًا،

451
00:38:58,751 --> 00:38:59,137
فَهَذَا مَعْنَى قَوْلِهِ: [أَشَدُّ الْعَذَابِ عَذَابُ الْقَلْبِ]،

452
00:38:58,751 --> 00:38:59,137
قَالَ اللَّهُ تَعَالَى: ﴿وَمَنْ يُرِدْ أَنْ يُضِلَّهُ يَجْعَلْ صَدْرَهُ ضَيِّقًا

453
00:38:58,751 --> 00:38:59,137
حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِي السَّمَاءِ﴾.

454
00:38:58,751 --> 00:38:59,137
- يَقُولُ: مَا رَأْيُكُمْ فِي تَعْرِيفِ الشِّرْكِ بِأَنَّهُ [تَسْوِيَةُ غَيْرِ

455
00:38:58,751 --> 00:38:59,137
اللَّهِ بِاللَّهِ فِي شَيْءٍ مِنْ خَصَائِصِ اللَّهِ]؟

456
00:38:58,751 --> 00:38:59,137
ذَكَرْنَا أَنَّ هَذَا الْحَدَّ عَلَيْهِ إِيرَادَانِ: - أَحَدُهُمَا: فِي إِطْلَاقِ

457
00:38:58,751 --> 00:38:59,137
(التَّسْوِيَةِ)؛ لِأَنَّ التَّسْوِيَةَ تُوهِمُ التَّسْوِيَةَ فِيمَا يُجْعَلُ مِنْهُ الْفِعْلُ بِأَنْ

458
00:38:58,751 --> 00:38:59,137
يَكُونَ الْقَدْرُ نَفْسُهُ مَجْعُولًا لِلَّهِ وَغَيْرِهِ وَهَذَا غَيْرُ مُرَادٍ،

459
00:38:58,751 --> 00:38:59,137
وَإِنَّمَا تَكُونُ التَّسْوِيَةُ بِجَعْلِ شَيْءٍ لِلَّهِ وَشَيْءٍ لِغَيْرِهِ وَإِنْ تَبَايَنَ

460
00:38:58,751 --> 00:38:59,137
الْقَدْرُ، لِذَلِكَ لَمَّا ذُكِرَ فِي الْقُرْآنِ الْكَرِيمِ ذُكِرَ مُتَعَلِّقًا بِالْفَاعِلِ،

461
00:38:58,751 --> 00:38:59,137
فَقَالَ اللَّهُ: ﴿إِذْ نُسَوِّيكُمْ بِرَبِّ الْعَالَمِينَ﴾،

462
00:38:58,751 --> 00:38:59,137
فَجَعَلَ مُتَعَلِّقَهُ الْمَفْعُولَ الَّذِي يُجْعَلُ لَهُ لَا مُتَعَلِّقَهُ نَفْسَ الْفِعْلِ،

463
00:38:58,751 --> 00:38:59,137
وَحَدُّ الشِّرْكِ يُعْرَفُ بِالنَّظَرِ إِلَى كَوْنِهِ فِعْلًا.

464
00:38:58,751 --> 00:38:59,137
- وَالْآخَرُ: فِي قَوْلِهِ: [فِي شَيْءٍ مِنْ خَصَائِصِ اللَّهِ]؛ فَإِنَّ

465
00:38:58,751 --> 00:38:59,137
خَصَائِصَ اللَّهِ سُبْحَانَهُ وَتَعَالَى مِنْهَا مَا يَكُونُ لِلْمَخْلُوقِ كَأَسْمَائِهِ الْحُسْنَى،

466
00:38:58,751 --> 00:38:59,137
فَإِنَّ مِنْ أَسْمَاءِ اللَّهِ الْحُسْنَى مَا يُسَمَّى بِهِ اللَّهُ وَيُسَمَّى

467
00:38:58,751 --> 00:38:59,137
بِهِ الْمَخْلُوقُ،

468
00:38:58,751 --> 00:38:59,137
قَالَ اللَّهُ تَعَالَى فِي ذِكْرِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

469
00:38:58,751 --> 00:38:59,137
فِي آخِرِ [التَّوْبَةِ]: ﴿بِالْمُؤْمِنِينَ رَءُوفٌ رَحِيمٌ﴾،

470
00:38:58,751 --> 00:38:59,137
فَجَعَلَ اسْمَ الرَّحِيمِ لَهُ وَجَعَلَهُ لِأَحَدٍ مِنْ خَلْقِهِ،

471
00:38:58,751 --> 00:38:59,137
إِلَّا أَنَّ لِلَّهِ مِنْهُ مَا يَلِيقُ بِكَمَالِهِ،

472
00:38:58,751 --> 00:38:59,137
وَلِلْمَخْلُوقِ مِنْهُ مَا يُنَاسِبُ حَالَهُ،

473
00:38:58,751 --> 00:38:59,137
فَالْأَكْمَلُ مَا ذَكَرْنَاهُ مِنْ بَيَانِ حَدِّ الشِّرْكِ أَنَّهُ: [جَعْلُ شَيْءٍ

474
00:38:58,751 --> 00:38:59,137
مِنْ حَقِّ اللَّهِ لِغَيْرِهِ].

475
00:38:58,751 --> 00:38:59,137
- يَقُولُ: إِذَا وَرَدَ لَفْظُ الْإِسْلَامِ أَوِ الْإِيمَانِ فِي الْقُرْآنِ

476
00:38:58,751 --> 00:38:59,137
وَالسُّنَّةِ فَعَلَى مَا نَحْمِلُهُ مِنَ الْمَعَانِي الْمَذْكُورَةِ فِيهِمَا؟

477
00:38:58,751 --> 00:38:59,137
نَحْمِلُهُ عَلَى الْمَعْنَى الْمُطْلَقِ فِي دَلَالَتِهِ عَلَى الدِّينِ كُلِّهِ،

478
00:38:58,751 --> 00:38:59,137
وَهُوَ الَّذِي ذَكَرْنَاهُ فِي كُلِّهِ،

479
00:38:58,751 --> 00:38:59,137
وَهَذَا مَعْنَى قَوْلِ أَهْلِ الْعِلْمِ: [الْإِسْلَامُ وَالْإِيمَانُ إِذَا افْتَرَقَا انْدَرَجَا]،

480
00:38:58,751 --> 00:38:59,137
دَلَّ كُلُّ وَاحِدٍ مِنْهُمْ عَلَى الْآخَرِ،

481
00:38:58,751 --> 00:38:59,137
فَيَدُلُّ الْإِسْلَامُ عَلَى الْإِيمَانِ وَالْإِيمَانُ عَلَى الْإِسْلَامِ،

482
00:38:58,751 --> 00:38:59,137
وَدَلَالَةُ كُلِّ وَاحِدٍ مِنْهُمَا عَلَى الْآخَرِ مِنْ كُلِّ وَجْهٍ يَكُونُ

483
00:38:58,751 --> 00:38:59,137
بِأَنْ يَقَعَ مَوْقِعَ الْبَيَانِ لِلدِّينِ كُلِّهِ،

484
00:38:58,751 --> 00:38:59,137
فَالْإِسْلَامُ يَكُونُ اسْمًا لِلدِّينِ كُلِّهِ،

485
00:38:58,751 --> 00:38:59,137
وَالْإِيمَانُ يَكُونُ اسْمًا لِلدِّينِ كُلِّهِ عَلَى مَا ذَكَرْنَاهُ.

486
00:38:58,751 --> 00:38:59,137
فَـ (الْإِيمَانُ) يَكُونُ اسْمًا لِلدِّينِ كُلِّهِ بِأَنْ يُقَالُ هُوَ: [التَّصْدِيقُ

487
00:38:58,751 --> 00:38:59,137
الْجَازِمُ بِاللَّهِ بَاطِنًا وَظَاهِرًا تَعَبُّدًا لَهُ بِالشَّرْعِ الْمُنَزَّلِ عَلَى مُحَمَّدٍ

488
00:38:58,751 --> 00:38:59,137
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى مَقَامِ الْمُشَاهَدَةِ أَوِ الْمُرَاقِبِ].

489
00:38:58,751 --> 00:38:59,137
وَ (الْإِسْلَامُ) يَصِيرُ اسْمًا لِلدِّينِ كُلِّهِ بِقَوْلِنَا هُوَ: [اسْتِسْلَامٌ لِلَّهِ

490
00:38:58,751 --> 00:38:59,137
بَاطِنًا وَظَاهِرًا تَعَبُّدًا لَهُ بِالشَّرْعِ الْمُنَزَّلِ عَلَى مُحَمَّدٍ عَلَى مَقَامِ

491
00:38:58,751 --> 00:38:59,137
الْمُشَاهَدَةِ وَالْمُرَاقَبَةِ].

492
00:38:58,751 --> 00:38:59,137
- يَقُولُ: مَا تَوْجِيهُ مَا جَاءَ فِي [الدُّرَرِ السَّنِيَّةِ] فِي

493
00:38:58,751 --> 00:38:59,137
الْمُجَلَّدِ التَّاسِعِ أَنَّ جِهَادَ أَهْلِ حَائِلٍ وَقِتَالَهُمْ مِنْ أَعْظَمِ الْجِهَادِ،

494
00:38:58,751 --> 00:38:59,137
وَذَكَرَ هُنَاكَ عَنْ بَعْضِ أَئِمَّةِ الدَّعْوَةِ تَكْفِيرَهُمْ مَعَ مَا ذَكَرُوهُ

495
00:38:58,751 --> 00:38:59,137
أَيْضًا مِنْ كُفْرِ أَهْلِ الرِّيَاضِ وَوُجُوبِ جِهَادِهِمْ مَثَلًا؟

496
00:38:58,751 --> 00:38:59,137
فَأَنْتَ لَا تَأْتِي إِلَى أَحْوَالٍ مُعَيَّنَةٍ تَقْتَنِفُهَا ظُرُوفٌ خَاصَّةٌ وَتُرِيدُ

497
00:38:58,751 --> 00:38:59,137
أَنْ تَجْعَلَهَا أُصُولًا،

498
00:38:58,751 --> 00:38:59,137
هَذِهِ أَحْوَالٌ تُحِيطُ بِهَا فَهِيَ قَضَايَا أَعْيَانٍ بِمَسَائِلَ مُعَيَّنَةٍ،

499
00:38:58,751 --> 00:38:59,137
وَلِذَلِكَ الَّذِي لَا يَعْقِلُهَا يَقُولُ هَذَا الْكِتَابُ يَنْضَحُ بِالْكُفْرِ!

500
00:38:58,751 --> 00:38:59,137
فَكَانَ مَاذَا؟

501
00:38:58,751 --> 00:38:59,137
الْقُرْآنُ يَنْضَحُ بِالْكُفْرِ!

502
00:38:58,751 --> 00:38:59,137
اللَّهُ عَزَّ وَجَلَّ كَفَّرَ الْكَافِرِينَ،

503
00:38:58,751 --> 00:38:59,137
فَحَكَمَ عَلَى الْمُنَافِقِينَ بِالْكُفْرِ فِي إِيقَاعِهِ لَا يُذَمُّ عَالِمٌ عَلَى

504
00:38:58,751 --> 00:38:59,137
ذَلِكَ، وَإِنَّمَا يُذَمُّ إِذَا نَفَّى غَيْرَ مَقَامِهِ،

505
00:38:58,751 --> 00:38:59,137
هَذَا هُوَ ذَلِكَ الَّذِي يُذَمُّ،

506
00:38:58,751 --> 00:38:59,137
أَمَّا إِنْ كَانَ الْمُكَفَّرُ مُسْتَحِقًّا لِلتَّكْفِيرِ فَهَذَا سَائِغٌ،

507
00:38:58,751 --> 00:38:59,137
وَفَرْقٌ بَيْنَ التَّكْفِيرِ بِحَقٍّ وَبَيْنَ التَّكْفِيرِ بِبَاطِلٍ؛ فَالْمَطْلُوبُ شَرْعًا التَّكْفِيرُ

508
00:38:58,751 --> 00:38:59,137
بِحَقٍّ، وَالْمَرْهُوبُ مِنْهُ شَرْعًا هُوَ التَّكْفِيرُ بِبَاطِلٍ.

509
00:38:58,751 --> 00:38:59,137
فَهَذِهِ قَضَايَا أَعْيَانٍ كَالْمُفْرَدِ فِيمَا جَاءَ فِي كُفْرِ أَهْلِ الرِّيَاضِ

510
00:38:58,751 --> 00:38:59,137
وَالْعَارِضِ وَقِتَالِهِمْ وَغَيْرِ ذَلِكَ مِمَّا فِي تَارِيخِ [ابْنِ غَنَّامٍ] وَغَيْرِهِ،

511
00:38:58,751 --> 00:38:59,137
وَالْإِنْسَانُ لَا يَكُونُ إِقْلِيمِيًّا،

512
00:38:58,751 --> 00:38:59,137
لَا يَتَعَصَّبُ الْعَصَبِيَّةَ إِلَّا لِدِينِ اللَّهِ عَزَّ وَجَلَّ،

513
00:38:58,751 --> 00:38:59,137
الْعَصَبِيَّةَ لِلَّهِ وَرَسُولِهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

514
00:38:58,751 --> 00:38:59,137
الْعَصَبِيَّةَ لِالتَّوْحِيدِ وَالْحَمِيَّةَ لِلدِّينِ دُونَ مُلَاحَظَةِ شَيْءٍ دُونَ شَيْءٍ،

515
00:38:58,751 --> 00:38:59,137
وَالْمُوَحِّدُ مَعَ اللَّهِ عَزَّ وَجَلَّ لَيْسَ مَعَ الْخَلْقِ،

516
00:38:58,751 --> 00:38:59,137
يَجْرِي مَعَ حُكْمِ اللَّهِ سُبْحَانَهُ وَتَعَالَى،

517
00:38:58,751 --> 00:38:59,137
وَيَعْرِفُ لِكُلِّ أَحَدٍ حَقَّتَهُ مِمَّا جَعَلَهُ اللَّهُ عَزَّ وَجَلَّ لَهُ،

518
00:38:58,751 --> 00:38:59,137
وَفِي كُلِّ زَمَانٍ دَوْلَتُهُ وَرِجَالُهُ،

519
00:38:58,751 --> 00:38:59,137
وَقَدِ انْتَظَمَ أَمْرُ الْوِلَايَةِ فِي هَذِهِ الْبِلَادِ عَلَى حُكْمِ [آلِ

520
00:38:58,751 --> 00:38:59,137
سُعُودٍ]، نَسْأَلُ اللَّهَ عَزَّ وَجَلَّ أَنْ يُلْهِمَ رُسُلَهُمْ وَأَنْ يَهْدِيَهُمْ

521
00:38:58,751 --> 00:38:59,137
إِلَى مَحَابِّ اللَّهِ وَمَرْضِيِّهِ وَأَنْ يُجَنِّبَهُمُ الْبِطَانَةَ السَّيِّئَةَ.

522
00:38:58,751 --> 00:38:59,137
- يَقُولُ: قَدْ يُوَاجِهُ أَحَدُنَا بَعْضَ النَّاسِ يُشْرِكُونَ بِاللَّهِ مِثْلَ

523
00:38:58,751 --> 00:38:59,137
غُلَاةِ الصُّوفِيَّةِ،

524
00:38:58,751 --> 00:38:59,137
فَمَا أَفْضَلُ طَرِيقَةٍ لَهُ أَنْ يَسْلُكَهَا مَعَهُمْ؟

525
00:38:58,751 --> 00:38:59,137
أَفْضَلُ طَرِيقَةٍ أَنْ يَدْعُوَهُمْ إِلَى التَّوْحِيدِ،

526
00:38:58,751 --> 00:38:59,137
أَفْضَلُ طَرِيقَةٍ الْوَاجِبُ عَلَيْهِ أَنْ يَدْعُوَهُمْ إِلَى تَوْحِيدِ اللَّهِ سُبْحَانَهُ

527
00:38:58,751 --> 00:38:59,137
وَتَعَالَى، وَأَنْ يُبَيِّنَ لَهُمْ بُطْلَانَ مَا هُمْ عَلَيْهِ وَيَسْتَكْثِرَ مِنَ

528
00:38:58,751 --> 00:38:59,137
الْأَدِلَّةِ الَّتِي يُورِدُهَا عَلَيْهِ،

529
00:38:58,751 --> 00:38:59,137
ثُمَّ يَذْكُرُ لَهُمْ مِنْ عُلَمَاءِ ذَلِكَ الْبَلَدِ مَنْ دَعَا إِلَى

530
00:38:58,751 --> 00:38:59,137
تَوْحِيدِ اللَّهِ وَهَدَمَ أَرْكَانَ الشِّرْكِ،

531
00:38:58,751 --> 00:38:59,137
وَفِي كُلِّ بَلَدٍ مِنْ بِلَادِ الْمُسْلِمِينَ بِحَمْدِ اللَّهِ عُلَمَاءُ صَنَّفُوا

532
00:38:58,751 --> 00:38:59,137
فِي نُصْرَةِ التَّوْحِيدِ وَفِي رَدِّ الشِّرْكِ.

533
00:38:58,751 --> 00:38:59,137
- يَقُولُ هَذَا: كَثُرَتْ وَظَهَرَتْ شَوَاهِدُ شِعْرِيَّةٌ نَافِعَةٌ فِي هَذَا

534
00:38:58,751 --> 00:38:59,137
الْكِتَابِ، فَلِمَاذَا لَا تُفْضِلُهَا مُصَنَّفَةً فِي كِتَابٍ لِحِفْظِهَا وَانْتِفَاعٍ بِهَا؟

535
00:38:58,751 --> 00:38:59,137
عَلَى يَدَيْكَ اجْمَعْهَا أَجْزَاكَ اللَّهُ خَيْرًا وَانْفَعْ بِهَا إِخْوَانَكَ وَانْفَعْنَا

536
00:38:58,751 --> 00:38:59,137
أَيْضًا بِهَا.

537
00:38:58,751 --> 00:38:59,137
هَذَا آخِرُ الْإِجَابَاتِ عَلَى الْأَسْئِلَةِ الْوَارِدَةِ مِمَّا يَتَعَلَّقُ بِأَبْوَابِ التَّوْحِيدِ

538
00:38:58,751 --> 00:38:59,137
الْوَارِدَةِ فِي [فَتْحِ الْمَجِيدِ]،

539
00:38:58,751 --> 00:38:59,137
وَسَنُتِمُّهُ إِنْ شَاءَ اللَّهُ تَعَالَى فِي مَقَامٍ آخَرَ طَبْعًا لِمَا

540
00:38:58,751 --> 00:38:59,137
تَقْتَضِيهِ الْحَالُ مِنْ رِعَايَةِ هَذَا الْبَرْنَاَمَجِ الْمُفْرَدِ وَهُوَ (بَرْنَاَمَجُ الْكِتَابِ

541
00:38:58,751 --> 00:38:59,137
الْوَاحِدِ). وَنُنَوِّهُ فِي آخِرِ الْأَمْرِ إِلَى مَا بَقِيَ مِنَ الْبَرَامِجِ

542
00:38:58,751 --> 00:38:59,137
فِي هَذِهِ الْإِجَازَةِ الصَّيْفِيَّةِ فِيمَا يُسْتَقْدَمُ قَبْلَ رَمَضَانَ: - فَسَيَكُونُ

543
00:38:58,751 --> 00:38:59,137
عِنْدَنَا إِنْ شَاءَ اللَّهُ تَعَالَى بِالنِّسْبَةِ لِي فِي الْأُسْبُوعِ الْقَادِمِ

544
00:38:58,751 --> 00:38:59,137
بَرْنَاَمَجُ [أَسَاسِ الْعِلْمِ]،

545
00:38:58,751 --> 00:38:59,137
وَفِيهِ تَدْرِيسُ سَبْعَةِ مُتُونٍ فِي جَامِعِ الْمَلِكِ سُعُودٍ بِجُدَّةَ،

546
00:38:58,751 --> 00:38:59,137
كَكِتَابِ [ثَلَاثَةِ الْأُصُولِ] وَ [التَّوْحِيدِ] وَ [الْوَاسِطِيَّةِ] وَ [الْأَرْبَعِينَ النَّوَوِيَّةِ]

547
00:38:58,751 --> 00:38:59,137
وَ [الْمُبْتَدَى فِي الْفِقْهِ] وَ [الْبَيِّنَةِ فِي الْحِذْقِ فِي اقْتِبَاسِ

548
00:38:58,751 --> 00:38:59,137
الْعِلْمِ] وَ [فَضْلِ الْإِسْلَامِ] لِإِمَامِ الدَّعْوَةِ رَحِمَهُ اللَّهُ تَعَالَى.

549
00:38:58,751 --> 00:38:59,137
- وَفِي الْأُسْبُوعِ نَفْسِهِ يَكُونُ فِي هَذَا الْمَسْجِدِ بَرْنَاَمَجٌ اسْمُهُ

550
00:38:58,751 --> 00:38:59,137
[مَثَانِي الْعِلْمِ]،

551
00:38:58,751 --> 00:38:59,137
يُدَرِّسُ فِيهِ جَمَاعَةٌ مِنَ الْمَشَايِخِ جُمْلَةً مِنَ الْمُتُونِ،

552
00:38:58,751 --> 00:38:59,137
وَهَذَا الْبَرْنَاَمَجُ مُؤَلَّفٌ مِنْ مَرْحَلَتَيْنِ تُؤْخَذُ فِي سَنَتَيْنِ؛ فَفِي الْمَرْحَلَةِ

553
00:38:58,751 --> 00:38:59,137
الْأُولَى يَأْخُذُ الْمُتَلَقِّي جُمْلَةً مِنَ الْمُتُونِ،

554
00:38:58,751 --> 00:38:59,137
وَفِي السَّنَةِ الْقَادِمَةِ يَأْخُذُ مَرْحَلَةً أُخْرَى،

555
00:38:58,751 --> 00:38:59,137
فَإِذَا انْقَضَتِ السَّنَتَانِ أُعِيدَ أَيْضًا فِي سَنَتَيْنِ،

556
00:38:58,751 --> 00:38:59,137
ثُمَّ إِذَا انْقَضَتْ أُعِيدَ فِي سَنَتَيْنِ،

557
00:38:58,751 --> 00:38:59,137
فَيَبْقَى مَا بَقِينَا وَمَا بَقِيَ إِنْ شَاءَ اللَّهُ تَعَالَى.

558
00:38:58,751 --> 00:38:59,137
الْإِخْوَانُ يُدَرِّسُونَ فِيهِ لِلْحَاجَةِ الشَّدِيدَةِ إِلَى مِثْلِ هَذَا الْأَمْرِ فِي

559
00:38:58,751 --> 00:38:59,137
هِدَايَةِ النَّاسِ إِلَى مَعَانِي الْمُتُونِ الْمُسْتَعْمَلَةِ فِي الْعِلْمِ.

560
00:38:58,751 --> 00:38:59,137
- وَبَعْدَهُ إِنْ شَاءَ اللَّهُ تَعَالَى فِي الْأُسْبُوعِ الَّذِي يَلِيهِ

561
00:38:58,751 --> 00:38:59,137
نَبْدَأُ يَوْمَ الْجُمُعَةِ بَعْدَ الْعَصْرِ بِبَرْنَاَمَجِ [سَرْدِ الْمُطَوَّلَاتِ الْأَوَّلِ]،

562
00:38:58,751 --> 00:38:59,137
وَالْكِتَابُ الْمَقْرُوءُ فِيهِ هُوَ [الدُّرَرُ السَّنِيَّةُ]،

563
00:38:58,751 --> 00:38:59,137
وَالْإِخْوَانُ يَقُولُونَ: [كَيْفَ الطَّرِيقَةُ؟]،

564
00:38:58,751 --> 00:38:59,137
وَأَنَا أَقُولُ فِي جَوَابِهَا إِنِّي أُبَيِّنُ بِالْعَمَلِ مَا لَا أُبَيِّنُ

565
00:38:58,751 --> 00:38:59,137
بِالْقَوْلِ؛ فَالَّذِي يَحْضُرُ وَيَدْرُسُ وَيَقْرَأُ مَعَنَا سَيَرَى الطَّرِيقَةَ،

566
00:38:58,751 --> 00:38:59,137
وَالَّذِي لَا يَسْتَطِيعُ أَنْ يَحْضُرَ فَهُوَ مَعْذُورٌ وَلَا نُوجِبُ عَلَيْهِ

567
00:38:58,751 --> 00:38:59,137
الْحُضُورَ، وَإِنَّمَا نُرِيدُ بِالْإِقْرَاءِ وَالْجَلْسِ فِي هَذِهِ الْمَجَالِسِ هُوَ النَّفْعَ

568
00:38:58,751 --> 00:38:59,137
وَالِانْتِفَاعَ، وَقَدْ لَا يَحْصُلُ لِإِنْسَانٍ أَنْ يَقْرَأَ الْكِتَابَ وَحْدَهُ حَتَّى

569
00:38:58,751 --> 00:38:59,137
لَوْ كَانَ قِرَاءَةً مُجَرَّدَةً كَمَا يَتَوَهَّمُ،

570
00:38:58,751 --> 00:38:59,137
فَإِنَّ الْإِنْسَانَ رُبَّمَا تَبْقَى عَلَيْهِ مُدَّةً طَوِيلَةً لَا يَقْرَأُ هَذَا

571
00:38:58,751 --> 00:38:59,137
الْكِتَابَ فَيُعِينُهُ ذَلِكَ عَلَى قِرَاءَةِ هَذَا الْكِتَابِ.

572
00:38:58,751 --> 00:38:59,137
- وَيَكُونُ بَعْدَ ذَلِكَ إِنْ شَاءَ اللَّهُ تَعَالَى دَرْسٌ فِي

573
00:38:58,751 --> 00:38:59,137
شَرْحِ كِتَابِ [الصِّيَامِ وَالزَّكَاةِ] مِنْ [نُورِ الْبَصَائِرِ وَالْأَلْبَابِ] فِي مَدِينَةِ

574
00:38:58,751 --> 00:38:59,137
الدَّمَّامِ فِي جَامِعِ [الْوَابِلِ].

575
00:38:58,751 --> 00:38:59,137
- وَقَبْلَ ذَلِكَ يَكُونُ شَرْحُ كِتَابِ [الصِّيَامِ] مِنَ الْكِتَابِ الْمَذْكُورِ

576
00:38:58,751 --> 00:38:59,137
فِي جَامِعٍ فِي شَمَالِ الرِّيَاضِ فِي يَوْمِ الْجُمُعَةِ التَّاسِعَ عَشَرَ

577
00:38:58,751 --> 00:38:59,137
مِنْ شَعْبَانَ.

578
00:38:58,751 --> 00:38:59,137
- ثُمَّ فِي الْأُسْبُوعِ الَّذِي بَعْدَهُ يَكُونُ بَرْنَاَمَجُ [الدَّرْسِ الْوَاحِدِ

579
00:38:58,751 --> 00:38:59,137
- الْقِسْمِ الثَّانِي]،

580
00:38:58,751 --> 00:38:59,137
وَيُدَرِّسُ فِيهِ جُمْلَةٌ مِنَ الْمَشَايِخِ،

581
00:38:58,751 --> 00:38:59,137
وَيُدَرَّسُ فِيهِ فِي وَقْتَيْنِ مِنْهُ فِي الْفَجْرِ فِي يَوْمَيْنِ مِنْهُ.

582
00:38:58,751 --> 00:38:59,137
- ثُمَّ فِي يَوْمِ خَمْسَةٍ وَعِشْرِينَ الْخَمِيسِ دَرْسٌ فِي جَامِعِ

583
00:38:58,751 --> 00:38:59,137
[الْوَابِلِ] فِي الشَّرْقِيَّةِ فِي شَرْحِ كِتَابِ [الصِّيَامِ وَالزَّكَاةِ] مِنْ كِتَابِ

584
00:38:58,751 --> 00:38:59,137
[نُورِ الْبَصَائِرِ وَالْأَلْبَابِ]؛ فَنَشْرَحُ فِي الرِّيَاضِ فَقَطْ كِتَابَ [الصِّيَامِ]،

585
00:38:58,751 --> 00:38:59,137
وَأَمَّا فِي الشَّرْقِيَّةِ لِأَنَّنَا بَدَأْنَا التَّمَامَ مِنْ أَوَّلِهِ فَوَصَلْنَا إِلَى

586
00:38:58,751 --> 00:38:59,137
مَا يُنَاسِبُ،

587
00:38:58,751 --> 00:38:59,137
بَقِيَ عَلَيْنَا فِي الصَّلَاةِ شَيْءٌ فَنُوَاصِلُ فِي شَرْحِ الزَّكَاةِ وَالصِّيَامِ

588
00:38:58,751 --> 00:38:59,137
لِأَنَّهَا أَرْسَقُ بِحَالِ النَّاسِ.

589
00:38:58,751 --> 00:38:59,137
- ثُمَّ يَكُونُ فِي الرِّيَاضِ بَعْدَ ذَلِكَ دَرْسٌ -أَظُنُّهُ أَظُنُّ

590
00:38:58,751 --> 00:38:59,137
دَرْسَ الرِّيَاضِ- يَوْمَ خَمْسَةٍ وَعِشْرِينَ وَدَرْسَ الشَّرْقِيَّةِ يَوْمَ سِتَّةٍ وَعِشْرِينَ،

591
00:38:58,751 --> 00:38:59,137
دَرْسُ الرِّيَاضِ خَمْسَةٌ وَعِشْرِينَ [مُسْنَدُ الصِّيَامِ] فِي هَذَا الْمَسْجِدِ،

592
00:38:58,751 --> 00:38:59,137
وَدَرْسُ الشَّرْقِيَّةِ يَوْمَ سِتَّةٍ وَعِشْرِينَ الْجُمُعَةِ يَكُونُ فِي كِتَابَيِ [الزَّكَاةِ

593
00:38:58,751 --> 00:38:59,137
وَالصِّيَامِ] مِنْ كِتَابِ [نُورِ الْبَصَائِرِ وَالْأَلْبَابِ].

594
00:38:58,751 --> 00:38:59,137
هَذَا آخِرُ مَا يَقْتَضِيهِ الْبَيَانُ،

595
00:38:58,751 --> 00:38:59,137
وَأَرْجُو أَنْ تَكُونَ هَذِهِ الْمَجَالِسُ حَامِلَةً لَكُمْ عَلَى الْعِنَايَةِ بِتَوْحِيدِ

596
00:38:58,751 --> 00:38:59,137
اللَّهِ سُبْحَانَهُ وَتَعَالَى تَعَلُّمًا وَتَعْلِيمًا لِلْخَلْقِ وَدَعْوَةً إِلَى اللَّهِ سُبْحَانَهُ

597
00:38:58,751 --> 00:38:59,137
وَتَعَالَى، وَرَأَيْتُمْ فِي مَوَاقِعَ مِنَ الْكَلَامِ مَا فِي الْقُرْآنِ الْكَرِيمِ

598
00:38:58,751 --> 00:38:59,137
مِنْ عَجَائِبِ الْبَيَانِ عَنْ هَذَا الْأَمْرِ الْعَظِيمِ،

599
00:38:58,751 --> 00:38:59,137
وَمَا وَعَاهُ أَهْلُ الْعِلْمِ مِنْ مَقَامٍ كَرِيمٍ لَهُ فَكَرَّرُوا مَرَّةً

600
00:38:58,751 --> 00:38:59,137
بَعْدَ مَرَّةٍ هَذِهِ الْمَعَانِيَ إِيغَالًا فِي بَيَانِهَا وَإِمْعَانًا فِي نَصْبِ

601
00:38:58,751 --> 00:38:59,137
الْأَجِلَّةِ عَلَيْهَا.

602
00:38:58,751 --> 00:38:59,137
وَهَذَا الْكِتَابُ كِتَابٌ عَظِيمٌ هَدَى اللَّهُ عَزَّ وَجَلَّ بِهِ كَثِيرًا

603
00:38:58,751 --> 00:38:59,137
مِنَ الْخَلْقِ،

604
00:38:58,751 --> 00:38:59,137
فَفِيهِ بَرَكَةٌ عَظِيمَةٌ فِي الِانْتِفَاعِ بِتَوْحِيدِ اللَّهِ سُبْحَانَهُ وَتَعَالَى،

605
00:38:58,751 --> 00:38:59,137
نَسْأَلُ اللَّهَ عَزَّ وَجَلَّ أَنْ يَجْعَلَهُ حُجَّةً لَنَا وَلَكُمْ،

606
00:38:58,751 --> 00:38:59,137
وَأَنْ لَا يَجْعَلَهُ حُجَّةً عَلَيْنَا وَعَلَيْكُمْ،

607
00:38:58,751 --> 00:38:59,137
وَأَنْ يُحْيِيَنَا عَلَى الْإِسْلَامِ وَالسُّنَّةِ،

608
00:38:58,751 --> 00:38:59,137
وَأَنْ يُمِيتَنَا عَلَى الْإِسْلَامِ وَالسُّنَّةِ.

609
00:38:58,751 --> 00:38:59,137
وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

610
00:38:58,751 --> 00:38:59,910
صَلَّى اللَّهُ وَسَلَّمَ عَلَى عَبْدِهِ وَرَسُولِهِ مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ أَجْمَعِينَ.
