1
00:00:00,560 --> 00:00:01,164
قَالَ الشَّارِحُ هَدَاهُ

2
00:00:17,440 --> 00:00:18,580
اللَّهُ: بُكْرَةً وَأَصِيلًا،

3
00:00:18,010 --> 00:00:18,580
وَعَلَى آلِهِ وَصَحْبِهِ وَمَنِ اتَّخَذَهُ إِمَامًا وَخَلِيلًا،

4
00:00:18,010 --> 00:00:18,580
أَمَّا بَعْدُ: فَإِنَّ حُسْنَ التَّعْلِيمِ لَا يَمْنَعُ مَرْءًا عَقَدَ رَأْيًا

5
00:00:18,010 --> 00:00:18,580
أَنْ يَنْقُضَهُ،

6
00:00:18,010 --> 00:00:18,580
وَقَدِ اقْتَضَى هَذَا أَنِّي

7
00:00:28,152 --> 00:00:29,190
لَمَّا رَأَيْتُ [الْمُصَنِّفَ] رَحِمَهُ

8
00:00:44,298 --> 00:00:47,604
اللَّهُ تَعَالَى خَتَمَ الْبَابَ السَّابِقَ بِقَوْلِهِ: [وَشَرْحُ هَذِهِ التَّرْجَمَةِ مَا

9
00:00:47,604 --> 00:00:48,840
بَعْدَهَا مِنَ الْأَبْوَابِ]،

10
00:00:48,840 --> 00:00:49,403
وَكُنْتُ أُعْمِلُ خَتْمَ هَذِهِ الْمَجَالِسِ غَدًا الْفَجْرَ اسْتِبْقَاءً لِمَا بَقِيَ

11
00:00:51,090 --> 00:00:52,215
مِنْ قُوَّتِي الْحَلْقِ فِيمَا يَأْتِي

12
00:01:00,273 --> 00:01:02,455
مِنْ بَرَامِجِ الْأُسْبُوعِ الْقَادِمِ فِي جُدَّةَ؛ لِأَنَّهُ

13
00:01:10,833 --> 00:01:12,019
كَانَ قَدِ اعْتَرَانِي شَيْءٌ

14
00:01:25,140 --> 00:01:26,340
مِنْ عَارِضٍ بِسَبَبِ الْغُبَارِ الشَّدِيدِ،

15
00:01:25,740 --> 00:01:26,340
فَجَاهَدْنَا فِي بَقَايَا

16
00:01:42,923 --> 00:01:44,090
الدَّرْسِ حَتَّى وَصَلْنَا إِلَى

17
00:01:51,740 --> 00:01:52,798
هَذَا الْقَدْرِ بِحَمْدِ اللَّهِ،

18
00:01:52,340 --> 00:01:52,798
وَانْتَهَى إِلَى قَوْلِهِ: [وَشَرْحُ

19
00:02:00,590 --> 00:02:01,507
هَذِهِ التَّرْجَمَةِ مَا بَعْدَهَا

20
00:02:03,818 --> 00:02:04,775
مِنَ الْأَبْوَابِ].

21
00:02:04,297 --> 00:02:04,775
فَهُوَ إِيذَانٌ بِمَقْصِدٍ جَدِيدٍ

22
00:02:28,686 --> 00:02:29,840
مِنْ مَقَاصِدِ

23
00:02:35,609 --> 00:02:36,763
[كِتَابِ التَّوْحِيدِ]،

24
00:02:36,186 --> 00:02:36,763
فَكَيْفَ كَيْ تَأْخُذَ الْأَبْوَابُ بَعْضُهَا بِرِقَابِ بَعْضٍ؟

25
00:02:36,186 --> 00:02:38,840
فَأَرَى أَنْ يَكُونَ بُدَاءَتُنَا بِمَا بَعْدَهُ مِنَ الْأَبْوَابِ

26
00:02:53,197 --> 00:02:54,054
فِي مَقَامٍ آخَرَ نُؤَقِّتُهُ بِحَسَبِ الْحَالِ،

27
00:02:53,626 --> 00:02:54,054
وَأَصْلُ

28
00:02:56,318 --> 00:02:58,275
هَذَا الْبَرْنَاَمَجِ فِكْرَتُهُ إِقْرَاءُ جُمْلَةٍ مِنَ الْكُتُبِ الَّتِي كَانَ عَلَيْهَا

29
00:02:57,297 --> 00:02:58,275
مَدَارُ التَّعْلِيمِ

30
00:03:03,167 --> 00:03:05,123
فِي قُطْرِنَا

31
00:03:11,185 --> 00:03:12,027
فِي أَبْوَابِ الدِّينِ؛ كَـ [فَتْحِ الْمَجِيدِ]،

32
00:03:11,606 --> 00:03:12,027
وَ [شَرْحِ الطَّحَاوِيَّةِ] لِـ

33
00:03:32,980 --> 00:03:34,513
[ابْنِ أَبِي الْعِزِّ]،

34
00:03:33,747 --> 00:03:34,513
وَ [الرَّوْضِ الْمُرْبِعِ] مُؤَقَّتَةً وَغَيْرِهَا

35
00:03:37,580 --> 00:03:39,113
فِي هَذَا الْمِيقَاتِ

36
00:04:04,880 --> 00:04:06,213
مِنَ السَّنَةِ،

37
00:04:05,547 --> 00:04:06,213
فَرُبَّمَا نُبْقِيهِ

38
00:04:37,895 --> 00:04:39,772
عَلَى تَوْقِيتِهِ وَرُبَّمَا نَزِيدُهُ بِحَسَبِ مَا يَسْتَكْمِلُ فِيهِ النَّظَرُ

39
00:04:44,464 --> 00:04:46,341
مِنَ الْبَرَامِجِ تَقْدِيمًا وَتَأْخِيرًا وَزِيَادَةً فِيمَا يَكُونُ

40
00:04:54,910 --> 00:04:56,243
مِنْ بَرَامِجَ أُخْرَى تُلْحَقُ بِقِطَارِ بَرَامِجِ الدَّعْوَةِ وَالْإِرْشَادِ.

41
00:04:55,577 --> 00:04:56,243
فَكَانَ الدَّرْسُ الْمَاضِي هُوَ الْمَجْلِسُ الْمَاضِي،

42
00:04:55,577 --> 00:04:56,243
هُوَ آخِرُ مَجَالِسِ شَرْحِ [فَتْحِ الْمَجِيدِ]،

43
00:04:55,577 --> 00:04:56,243
وَجَرَيَانُ

44
00:05:09,577 --> 00:05:10,243
الطَّرِيقَةِ

45
00:05:20,243 --> 00:05:21,410
فِيهِ عَلَى هَذَا،

46
00:05:20,910 --> 00:05:21,410
وَدَرَكٌ مِنْهُ أَنَّ كُلَّ بَرْنَاَمَجٍ لَهُ فِكْرَتُهُ،

47
00:05:20,910 --> 00:05:21,410
فَإِنَّ

48
00:05:42,803 --> 00:05:43,710
مِنَ الْإِخْوَانِ

49
00:05:52,243 --> 00:05:54,278
مَنْ كَانَ يُطَالِبُ بِعَدَمِ مَدِّ الْقَوْلِ وَبَسْطِهِ فِي هَذِهِ الْمَسَائِلِ

50
00:05:53,822 --> 00:05:54,278
رَجَاءَ

51
00:05:58,840 --> 00:05:59,752
أَنْ يُخْتَمَ الْكِتَابُ،

52
00:05:59,296 --> 00:05:59,752
وَلَيْسَ

53
00:06:12,524 --> 00:06:13,436
مِنْ تَمَامِ الْعِلْمِ

54
00:06:19,601 --> 00:06:20,982
أَنْ يَكُونَ هَمُّ الْإِنْسَانِ

55
00:06:32,034 --> 00:06:33,415
فِي كُلِّ شَيْءٍ أَنْ يَقْرَأَهُ أَنْ يَخْتِمَهُ،

56
00:06:32,725 --> 00:06:33,415
بَلِ الْهَمُّ الْأَكْبَرُ أَنْ تَحْصُلَ الْفَائِدَةُ الْكُبْرَى مِنْهُ.

57
00:06:32,725 --> 00:06:33,415
وَهَذِهِ الْمَسَائِلُ خَاصَّةً وَبَرْنَاَمَجُ الْكِتَابِ الْوَاحِدِ عَامَّةً يَكُونُ فِيهِ الْكَلَامُ

58
00:06:32,725 --> 00:06:33,415
بَسْطًا وَإِيضَاحًا؛ لِأَنَّ

59
00:07:03,355 --> 00:07:04,891
هَذِهِ الْكُتُبَ شُرُوحٌ فَوْقَ الْمُتُونِ،

60
00:07:04,123 --> 00:07:04,891
فَهِيَ تُدَرَّسُ بِمَا يُنَاسِبُهَا مِنَ الْبَيَانِ وَالتَّعْلِيقِ عَلَى الَّذِي جَرَيْنَا

61
00:07:04,123 --> 00:07:04,891
عَلَيْهِ

62
00:07:15,206 --> 00:07:16,525
فِي شَرْحِ مَا سَلَفَ

63
00:07:46,593 --> 00:07:47,860
مِنْ كِتَابِ [فَتْحِ الْمَجِيدِ].

64
00:07:47,227 --> 00:07:47,860
وَبَقِيَ مِمَّا يَلْزَمُ

65
00:08:19,374 --> 00:08:20,942
مِنْ مُتَعَلَّقَاتِ [فَتْحِ الْمَجِيدِ] الْإِجَابَةُ عَلَى الْأَسْئِلَةِ الَّتِي رَفَعْتُمُوهَا مِمَّا

66
00:08:20,158 --> 00:08:20,942
يَتَعَلَّقُ بِالتَّوْحِيدِ أَوْ بِالْكِتَابِ دُونَ غَيْرِهِ،

67
00:08:20,158 --> 00:08:20,942
فَاخْتَرْتُ

68
00:08:39,764 --> 00:08:41,332
مِنَ الْأَسْئِلَةِ الَّتِي جُمِعَتْ

69
00:08:58,340 --> 00:08:59,130
فِي الْأَيَّامِ الْمَاضِيَةِ هَذِهِ الْأَسْئِلَةَ.

70
00:08:58,735 --> 00:08:59,130
- يَقُولُ

71
00:09:18,318 --> 00:09:18,934
هَذَا السَّائِلُ: ذَكَرْتُمْ وُجُوبَ كِتَابَةِ (أَلِفِ ابْنٍ)

72
00:09:28,000 --> 00:09:29,300
فِي [أَحْمَدَ بْنِ حَنْبَلٍ]؛ لِأَنَّ [حَنْبَلًا] جَدُّهُ

73
00:09:49,283 --> 00:09:50,528
لَا أَبُوهُ،

74
00:09:49,906 --> 00:09:50,528
وَقَدْ ذَكَرَ الشَّيْخُ [نَصْرٌ الْهُورِينِيُّ]

75
00:10:15,550 --> 00:10:16,957
فِي [الْمَطَالِعِ النَّصْرِيَّةِ]

76
00:10:38,234 --> 00:10:39,287
أَنَّ الْعَلَمَ إِذَا نُسِبَ

77
00:11:02,647 --> 00:11:06,421
إِلَى جَدِّهِ لِلشُّهْرَةِ يُحْذَفُ وُجُوبًا إِلَى آخِرِهِ؟

78
00:11:06,002 --> 00:11:06,421
هَذَا أَحَدُ الْقَوْلَيْنِ

79
00:11:10,615 --> 00:11:11,453
فِي الْمَسْأَلَةِ،

80
00:11:11,034 --> 00:11:11,453
وَالَّذِي اسْتَقَرَّ

81
00:11:16,836 --> 00:11:17,750
عَلَيْهِ الْإِمْلَاءُ بِأَخَرَةٍ،

82
00:11:17,293 --> 00:11:17,750
وَالَّذِي ذَكَرْنَاهُ.

83
00:11:17,293 --> 00:11:17,750
- يَقُولُ هَذَا السَّائِلُ:

84
00:11:30,550 --> 00:11:31,621
مَا هُوَ الْمُرَادُ بِـ (الِالْتِزَامِ)

85
00:11:37,510 --> 00:11:38,580
فِي كَلَامِ [ابْنِ تَيْمِيَّةَ] رَحِمَهُ

86
00:11:45,540 --> 00:11:46,611
اللَّهُ -يَعْنِي الْمَقْرُوءَ

87
00:11:50,358 --> 00:11:51,429
فِي الدَّرْسِ الْمَاضِي-؟

88
00:11:50,894 --> 00:11:51,429
الْمُرَادُ بِـ (الِالْتِزَامِ) الَّذِي ذَكَرَهُ [ابْنُ تَيْمِيَّةَ]: اعْتِقَادُ كَوْنِهِ مُخَاطَبًا

89
00:11:50,894 --> 00:11:51,429
بِهَذِهِ الشَّرِيعَةِ مُنْدَرِجًا

90
00:12:13,463 --> 00:12:14,638
فِي أَهْلِهَا،

91
00:12:14,050 --> 00:12:14,638
فَالْمُلْتَزِمُ لِلشَّرِيعَةِ

92
00:12:25,219 --> 00:12:26,395
هُوَ الَّذِي يَعْتَقِدُ كَوْنَهُ مُخَاطَبًا بِهَا،

93
00:12:25,807 --> 00:12:26,395
وَهُوَ أَمْرٌ آخَرُ غَيْرُ الْإِقْرَارِ الَّذِي يُقَابِلُهُ الْجَحْدُ؛

94
00:12:55,513 --> 00:12:56,763
فَإِنَّ الْمُقِرَّ

95
00:12:59,885 --> 00:13:01,585
هُوَ الَّذِي يَعْتَقِدُ أَنَّ هَذِهِ مِنْ شَرِيعَةِ الْإِسْلَامِ،

96
00:13:01,058 --> 00:13:01,585
وَالْجَحْدُ

97
00:13:15,300 --> 00:13:15,827
هُوَ

98
00:13:43,341 --> 00:13:44,848
الَّذِي يُنْكِرُهَا،

99
00:13:44,095 --> 00:13:44,848
أَمَّا (الِالْتِزَامُ)

100
00:13:59,920 --> 00:14:00,523
فَهُوَ

101
00:14:15,619 --> 00:14:16,961
الَّذِي يُقِرُّ بِدُخُولِهِ هُوَ فِي هَذِهِ الشَّعِيرَةِ،

102
00:14:16,290 --> 00:14:16,961
وَيُقَابِلُهُ (الِامْتِنَاعُ)؛ فَمَنْ أَقَرَّ بِشَرِيعَةٍ مِنَ الشَّرَائِعِ ثُمَّ زَعَمَ أَنَّهَا

103
00:14:16,290 --> 00:14:16,961
تَنْقُلُ بِشَرِيعَةٍ مِنَ الشَّرَائِعِ فَهَذِهِ الشَّرِيعَةُ تَكُونُ لِغَيْرِهِ لَا هُوَ،

104
00:14:16,290 --> 00:14:18,303
بِأَنْ يَقُولَ مَثَلًا: [الزَّكَاةُ حَقُّ اللَّهِ فِي الْمَالِ لَكِنَّهَا لَيْسَتْ

105
00:14:19,645 --> 00:14:20,987
عَلَيَّ وَعَلَى بَنِي قَوْمِي وَإِنَّمَا عَلَى غَيْرِنَا مِنْ أَبْنَاءِ الْإِسْلَامِ]،

106
00:14:20,316 --> 00:14:20,987
فَهَذَا مُمْتَنِعٌ

107
00:14:50,390 --> 00:14:52,762
عَنِ الْتِزَامِ هَذِهِ الشَّرِيعَةِ.

108
00:14:51,576 --> 00:14:52,762
- [وَالتَّجَاوُزُ

109
00:15:16,547 --> 00:15:17,985
فِي الدُّعَاءِ

110
00:15:25,678 --> 00:15:27,029
مِنْ مَوَانِعِ الْإِجَابَةِ

111
00:15:32,725 --> 00:15:34,173
فِي الدُّنْيَا وَالْآخِرَةِ] كَيْفَ أَعْرِفُ أَنِّي لَمْ أَتَجَاوَزِ الْحُدُودَ فِي

112
00:15:33,449 --> 00:15:34,173
الدُّعَاءِ بِالتَّعَدِّي؟

113
00:15:33,449 --> 00:15:34,173
يُعْلَمُ ذَلِكَ بِأَنْ تَسْلُكَ فِي دُعَائِكَ الطَّرِيقَةَ الشَّرْعِيَّةَ،

114
00:15:33,449 --> 00:15:34,173
فَإِذَا سَلَكَ الْعَبْدُ فِي دُعَائِهِ الطَّرِيقَةَ الشَّرْعِيَّةَ عَلِمَ أَنَّهُ مُتَأَدِّبٌ

115
00:15:33,449 --> 00:15:34,173
فِي دُعَائِهِ غَيْرُ مُتَعَدٍّ فِيهِ،

116
00:15:33,449 --> 00:15:36,346
فَإِنْ خَالَفَ الطَّرِيقَةَ الشَّرْعِيَّةَ وَقَعَ فِي التَّعَدِّي،

117
00:15:35,621 --> 00:15:36,346
كَأَنْ يَسْتَعْجِلَ الْإِنْسَانُ فَيَقُولَ: [دَعَوْتُ ثُمَّ دَعَوْتُ وَلَمْ يُجَبْ لِي]،

118
00:15:35,621 --> 00:15:36,346
فَهَذَا وَاقِعٌ فِي التَّعَدِّي وَخِلَافِ الْأَدَبِ بِمَا يَنْبَغِي فِي الدُّعَاءِ،

119
00:15:35,621 --> 00:15:36,346
أَوْ كَانَ يَدْعُو

120
00:15:47,208 --> 00:15:48,656
اللَّهَ سُبْحَانَهُ وَتَعَالَى بِمَا لَمْ يَأْذَنْ بِهِ

121
00:16:15,713 --> 00:16:18,380
اللَّهُ عَزَّ

122
00:16:18,380 --> 00:16:19,713
وَجَلَّ

123
00:16:27,094 --> 00:16:27,380
