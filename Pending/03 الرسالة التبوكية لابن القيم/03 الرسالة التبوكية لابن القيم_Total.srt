1
00:00:17,260 --> 00:00:19,760
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ

2
00:00:27,968 --> 00:00:29,052
اللَّهِ وَبَرَكَاتُهُ.

3
00:00:28,510 --> 00:00:29,052
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

4
00:00:28,510 --> 00:00:29,052
رَبِّ السَّمَاوَاتِ وَرَبِّ الْأَرْضِ،

5
00:00:28,510 --> 00:00:29,052
رَبِّ الْعَرْشِ الْعَظِيمِ،

6
00:00:30,677 --> 00:00:32,302
وَأَشْهَدُ أَنْ لَا

7
00:00:35,552 --> 00:00:36,635
إِلَهَ إِلَّا

8
00:00:48,371 --> 00:00:49,334
اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

9
00:00:48,853 --> 00:00:51,260
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ صَلَّى اللَّهُ عَلَيْهِ

10
00:00:58,084 --> 00:01:01,379
وَعَلَى آلِهِ وَصَحْبِهِ وَسَلَّمَ تَسْلِيمًا مَزِيدًا.

11
00:01:00,556 --> 00:01:01,379
أَمَّا بَعْدُ:

12
00:01:12,090 --> 00:01:13,090
فَهَذَا الْمَجْلِسُ الثَّالِثُ فِي شَرْحِ الْكِتَابِ الثَّالِثِ

13
00:01:22,321 --> 00:01:23,552
مِنْ بَرْنَامَجِ الْيَوْمِ الْوَاحِدِ التَّاسِعِ،

14
00:01:22,936 --> 00:01:23,552
وَهُوَ كِتَابُ [الرِّسَالَةِ التَّبُوكِيَّةِ] لِلْعَلَّامَةِ أَبِي عَبْدِ

15
00:01:26,628 --> 00:01:27,859
اللَّهِ ابْنِ الْقَيِّمِ رَحِمَهُ

16
00:01:32,460 --> 00:01:33,423
اللَّهُ تَعَالَى،

17
00:01:32,942 --> 00:01:33,423
وَقَدِ انْتَهَى بِنَا الْبَيَانُ

18
00:01:44,674 --> 00:01:45,535
إِلَى قَوْلِهِ: [فَصْلٌ: فَهَذَا حُكْمُ الْأَتْبَاعِ الْأَشْقِيَاءِ].

19
00:01:45,105 --> 00:01:45,535
وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

20
00:01:45,105 --> 00:01:45,535
اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا وَلِلْمُسْلِمِينَ.

21
00:01:45,105 --> 00:01:45,535
قَالَ الْمُصَنِّفُ حَفِظَهُ

22
00:02:03,192 --> 00:02:04,053
اللَّهُ: فَصْلٌ: فَهَذَا حُكْمُ الْأَتْبَاعِ الْأَشْقِيَاءِ،

23
00:02:03,622 --> 00:02:04,053
فَأَمَّا أَتْبَاعُ السُّعَدَاءِ فَنَوْعَانِ: أَتْبَاعُ

24
00:02:22,153 --> 00:02:23,267
اللَّهِ هُمْ حُكْمُ الِاسْتِقْلَالِ،

25
00:02:22,710 --> 00:02:23,267
وَهُمُ الَّذِينَ قَالَ

26
00:02:42,383 --> 00:02:43,488
اللَّهُ عَزَّ وَجَلَّ فِيهِمْ: ﴿وَالسَّابِقُونَ الْأَوَّلُونَ مِنَ الْمُهَاجِرِينَ وَالْأَنْصَارِ وَالَّذِينَ

27
00:02:43,212 --> 00:02:43,488
اتَّبَعُوهُمْ بِإِحْسَانٍ رَضِيَ

28
00:02:46,813 --> 00:02:50,310
اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ﴾ فَهَؤُلَاءِ هُمُ السُّعَدَاءُ الَّذِينَ

29
00:02:50,310 --> 00:02:50,699
ثَبَتَ لَهُمْ رِضَا

30
00:03:10,630 --> 00:03:12,230
اللَّهِ عَنْهُمْ،

31
00:03:21,030 --> 00:03:22,630
وَهُمْ أَصْحَابُ رَسُولِ

32
00:03:28,342 --> 00:03:28,770
اللَّهِ

33
00:03:35,189 --> 00:03:36,901
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

34
00:03:36,901 --> 00:03:39,896
وَكُلُّ مَنْ تَبِعَهُمْ بِإِحْسَانٍ،

35
00:03:39,468 --> 00:03:39,896
وَهَذَا يَعُمُّ كُلَّ مَنِ اتَّبَعَهُمْ بِإِحْسَانٍ،

36
00:03:39,468 --> 00:03:39,896
وَهَذَا يَعُمُّ كُلَّ مَنِ اتَّبَعَهُمْ بِإِحْسَانٍ إِلَى يَوْمِ الْقِيَامَةِ،

37
00:03:54,446 --> 00:03:55,302
وَلَا يُقْتَصَرُ ذَلِكَ بِالْقَرْنِ الَّذِينَ رَأَوْهُمْ فَقَطْ،

38
00:03:54,874 --> 00:03:55,302
وَإِنَّمَا خُصَّ التَّابِعُونَ بِمَنْ رَأَى الصَّحَابَةَ تَخْصِيصًا عُرْفِيًّا لِيَتَمَيَّزُوا

39
00:04:00,274 --> 00:04:01,084
بِهِ عَمَّنْ بَعْدَهُمْ،

40
00:04:00,679 --> 00:04:01,084
فَقِيلَ: التَّابِعُونَ مُطْلَقًا لِذَلِكَ الْقَرْنِ فَقَطْ،

41
00:04:00,679 --> 00:04:01,893
وَإِلَّا فَكُلُّ مَنْ سَلَكَ سَبِيلَهُمْ فَهُوَ

42
00:04:16,873 --> 00:04:17,683
مِنَ التَّابِعِينَ لَهُمْ بِإِحْسَانٍ،

43
00:04:17,278 --> 00:04:17,683
وَهُوَ مِمَّنْ رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ.

44
00:04:17,278 --> 00:04:20,112
وَقَيَّدَ سُبْحَانَهُ هَذِهِ التَّبَعِيَّةَ بِأَنَّهَا تَبَعِيَّةٌ بِإِحْسَانٍ لَيْسَتْ مُطْلَقَةً فَتَحْصُلُ

45
00:04:19,707 --> 00:04:21,327
بِمُجَرَّدِ النِّسْبَةِ وَالِاتِّبَاعِ فِي شَيْءٍ وَالْمُخَالَفَةِ فِي غَيْرِهِ،

46
00:04:20,922 --> 00:04:21,327
وَلَكِنْ تَبَعِيَّةٌ مُصَاحِبَةٌ لِلْإِحْسَانِ،

47
00:04:20,922 --> 00:04:21,327
فَإِنَّ الْبَاءَ هُنَا لِلْمُصَاحَبَةِ،

48
00:04:20,922 --> 00:04:21,327
وَالْإِحْسَانُ فِي الْمُتَابَعَةِ تَتِمُّ فِي حُصُولِ رِضَا اللَّهِ عَنْهُمْ وَجَنَّاتِهِ.

49
00:04:20,922 --> 00:04:21,327
وَقَالَ تَعَالَى: ﴿هُوَ الَّذِي بَعَثَ فِي الْأُمِّيِّينَ رَسُولًا مِنْهُمْ يَتْلُو

50
00:04:20,922 --> 00:04:22,946
عَلَيْهِمْ آيَاتِهِ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَإِنْ كَانُوا مِنْ قَبْلُ

51
00:04:22,541 --> 00:04:22,946
لَفِي ضَلَالٍ مُبِينٍ * وَآخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا بِهِمْ وَهُوَ

52
00:04:22,541 --> 00:04:22,946
الْعَزِيزُ الْحَكِيمُ * ذَلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ

53
00:04:27,630 --> 00:04:28,630
مَنْ يَشَاءُ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾ فَأُولَئِكَ هُمُ الْأَوَّلُونَ الَّذِينَ

54
00:04:28,130 --> 00:04:28,630
أَدْرَكُوا رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَصَحِبُوهُ،

55
00:04:28,130 --> 00:04:28,630
وَالْآخَرُونَ هُمُ الَّذِينَ لَمْ يَلْحَقُوا،

56
00:04:28,130 --> 00:04:28,630
وَيَكُونُونَ الْآخَرُونَ الَّذِينَ لَمْ يَلْحَقُوا بِهِمْ

57
00:04:37,130 --> 00:04:38,130
كُلَّ مَنْ بَعْدَهُمْ عَلَى مِنْهَاجِهِمْ إِلَى يَوْمِ الْقِيَامَةِ،

58
00:04:37,630 --> 00:04:38,130
فَيَكُونُ تَأَخُّرُ عَدَمِ اللِّحَاقِ بِهِمْ فِي الزَّمَانِ،

59
00:04:37,630 --> 00:04:38,130
وَفِي الْآيَةِ قَوْلٌ آخَرُ لِلْمَعْنَى: إِنَّ الْمَعْنَى لَمْ يَلْحَقُوا بِهِمْ

60
00:04:37,630 --> 00:04:38,130
فِي الْفَضْلِ وَالْمَرْتَبَةِ،

61
00:04:37,630 --> 00:04:38,130
وَلَمْ يُدْرِكُوهُمْ،

62
00:04:37,630 --> 00:04:38,130
فَيَكُونُ عَدَمُ اللِّحَاقِ فِي الرُّتْبَةِ.

63
00:04:37,630 --> 00:04:38,130
وَأَمَّا مَنْ لَمْ

64
00:04:41,630 --> 00:04:42,630
يَقْبَلْ هُدَى اللَّهِ

65
00:04:59,594 --> 00:05:00,490
الَّذِي بَعَثَ بِهِ رَسُولَهُ وَلَمْ يَرْفَعْ بِهِ رَأْسًا

66
00:05:05,869 --> 00:05:09,006
فَهُوَ مِنَ الصِّنْفِ الثَّالِثِ،

67
00:05:08,558 --> 00:05:09,902
وَهُمُ الَّذِينَ حُمِّلُوا التَّوْرَاةَ ثُمَّ لَمْ يَحْمِلُوهَا.

68
00:05:09,454 --> 00:05:12,592
وَقَدْ ذَكَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

69
00:05:12,592 --> 00:05:14,833
أَقْسَامَ الْخَلَائِقِ مِنْ نِسْبَتَيْنِ وَدَعْوَتَيْنِ وَمَا بَعَثَهُ اللَّهُ بِهِ مِنَ

70
00:05:14,833 --> 00:05:15,281
الْهُدَى فِي قَوْلِهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ:

71
00:05:18,637 --> 00:05:19,303
[مَثَلُ

72
00:05:23,593 --> 00:05:24,334
مَا بَعَثَنِي اللَّهُ بِهِ

73
00:05:35,690 --> 00:05:36,413
مِنَ الْهُدَى وَالْعِلْمِ كَمَثَلِ غَيْثٍ أَصَابَ أَرْضًا،

74
00:05:36,052 --> 00:05:36,413
فَكَانَتْ مِنْهَا طَائِفَةٌ طَيِّبَةٌ قَبِلَتِ

75
00:05:45,811 --> 00:05:46,534
الْمَاءَ فَأَنْبَتَتِ الْكَلَأَ وَالْعُشْبَ الْكَثِيرَ،

76
00:05:46,172 --> 00:05:46,534
وَكَانَ مِنْهَا جَادِبٌ أَمْسَكَتِ الْمَاءَ فَسَقَى النَّاسُ وَزَرَعُوا،

77
00:05:46,172 --> 00:05:49,064
وَأَصَابَ طَائِفَةً أُخْرَى إِنَّمَا هِيَ قِيعَانٌ لَا تُمْسِكُ مَاءً وَلَا

78
00:05:49,064 --> 00:05:49,425
تُنْبِتُ كَلَأً،

79
00:05:49,064 --> 00:05:49,425
فَذَلِكَ مَثَلُ

80
00:05:53,040 --> 00:05:53,763
مَنْ فَقَّهَهُ

81
00:06:03,755 --> 00:06:04,380
اللَّهُ

82
00:06:26,880 --> 00:06:28,130
فِي دِينِ

83
00:06:35,195 --> 00:06:36,500
اللَّهِ وَنَفَعَهُ مَا بَعَثَنِي

84
00:06:42,369 --> 00:06:43,673
اللَّهُ بِهِ،

85
00:06:43,021 --> 00:06:43,673
وَمَثَلُ

86
00:06:46,282 --> 00:06:47,587
مَنْ لَمْ يَرْفَعْ بِذَلِكَ رَأْسًا وَلَمْ يَقْبَلْ هُدَى

87
00:06:50,847 --> 00:06:51,500
اللَّهِ

88
00:07:21,500 --> 00:07:24,108
الَّذِي أُرْسِلْتُ بِهِ] فَشَبَّهَ

89
00:07:31,186 --> 00:07:33,963
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ الْعِلْمَ

90
00:07:56,741 --> 00:07:57,852
الَّذِي جَاءَ بِهِ بِالْغَيْثِ؛ لِأَنَّ كُلًّا مِنْهُمَا سَبَبُ الْحَيَاةِ،

91
00:07:57,297 --> 00:07:57,852
فَالْغَيْثُ سَبَبُ حَيَاةِ الْأَبْدَانِ،

92
00:07:57,297 --> 00:07:57,852
وَالْعِلْمُ سَبَبُ حَيَاةِ الْقُلُوبِ،

93
00:07:57,297 --> 00:07:57,852
وَشَبَّهَ الْقُلُوبَ الْقَابِلَةَ لِلْعِلْمِ بِالْأَرْضِ الْقَابِلَةِ لِلْغَيْثِ،

94
00:07:57,297 --> 00:07:57,852
كَمَا شَبَّهَ سُبْحَانَهُ الْقُلُوبَ بِالْأَوْدِيَةِ فِي قَوْلِهِ تَعَالَى: ﴿أَنْزَلَ

95
00:08:01,683 --> 00:08:02,735
مِنَ السَّمَاءِ مَاءً فَسَالَتْ أَوْدِيَةٌ بِقَدَرِهَا﴾.

96
00:08:02,209 --> 00:08:03,788
وَكَمَا أَنَّ الْأَرَاضِينَ ثَلَاثَةٌ

97
00:08:13,788 --> 00:08:14,841
مِنْ نِسْبَةٍ إِلَى قَبُولِ الْغَيْثِ: - أَحَدُهَا: أَرْضٌ زَكِيَّةٌ قَابِلَةٌ

98
00:08:14,314 --> 00:08:14,841
لِلشُّرْبِ وَالنَّبَاتِ،

99
00:08:14,314 --> 00:08:14,841
فَإِذَا أَصَابَهَا الْغَيْثُ ارْتَوَتْ مِنْهُ ثُمَّ أَنْبَتَتْ

100
00:08:19,577 --> 00:08:20,630
مِنْ كُلِّ زَوْجٍ بَهِيجٍ،

101
00:08:20,104 --> 00:08:20,630
فَهَذَا مَثَلُ الْقَلْبِ الزَّكِيِّ الذَّكِيِّ،

102
00:08:20,104 --> 00:08:20,630
فَهُوَ يَقْبَلُ الْعِلْمَ بِذَكَائِهِ وَيُثْمِرُ

103
00:08:27,472 --> 00:08:28,525
فِيهِ وُجُوهَ الْحِكَمِ وَدِينَ الْحَقِّ بِذَكَائِهِ،

104
00:08:27,998 --> 00:08:28,525
فَهُوَ قَابِلٌ لِلْعِلْمِ مُثْمِرٌ لِمَوَاسِمِهِ وَفِقْهِهِ وَأَسْرَارِ مَعَادِنِهِ.

105
00:08:27,998 --> 00:08:28,525
- وَالثَّانِيَةُ: أَرْضٌ صُلْبَةٌ قَابِلَةٌ لِثُبُوتِ الْمَاءِ فِيهَا وَحِفْظِهِ،

106
00:08:27,998 --> 00:08:28,525
فَهَذِهِ يَنْتَفِعُ النَّاسُ بِوُرُودِهَا وَالسَّقْيِ مِنْهَا وَالِازْدِرَاعِ،

107
00:08:27,998 --> 00:08:28,525
وَهَذَا مَثَلُ الْقَلْبِ الْحَافِظِ لِلْعِلْمِ الَّذِي يَحْفَظُهُ كَمَا سَمِعَهُ وَلَا

108
00:08:27,998 --> 00:08:28,525
تَصَرُّفَ لَهُ فِيهِ وَلَا اسْتِنْبَاطَ،

109
00:08:27,998 --> 00:08:28,525
بَلْ لَهُ الْحِفْظُ الْمُجَرَّدُ،

110
00:08:27,998 --> 00:08:28,525
فَهُوَ يُؤَدِّي كَمَا سَمِعَ،

111
00:08:27,998 --> 00:08:28,525
وَهُوَ

112
00:08:34,448 --> 00:08:37,721
مِنَ الْقِسْمِ الَّذِينَ قَالَ فِيهِمُ النَّبِيُّ صَلَّى

113
00:08:37,721 --> 00:08:39,903
اللَّهُ عَلَيْهِ وَسَلَّمَ: [فَرُبَّ حَامِلِ فِقْهٍ إِلَى مَنْ هُوَ أَفْقَهُ

114
00:08:39,357 --> 00:08:39,903
مِنْهُ، وَرُبَّ حَامِلِ فِقْهٍ غَيْرِ فَقِيهٍ].

115
00:08:39,357 --> 00:08:39,903
فَالْأَوَّلُ مَثَلُ الْغَنِيِّ التَّاجِرِ الْخَبِيرِ بِوُجُوهِ الْمَكَاسِبِ وَالتِّجَارَاتِ،

116
00:08:39,357 --> 00:08:39,903
فَهُوَ يَكْسِبُ بِمَالِهِ مَا شَاءَ،

117
00:08:39,357 --> 00:08:39,903
وَالثَّانِي مَثَلُ الْغَنِيِّ الَّذِي قُبِرَتْ لَهُ وُجُوهُ الرِّبْحِ وَالْكَسْبِ،

118
00:08:39,357 --> 00:08:39,903
وَلَكِنَّهُ عَاكِفٌ لِمَالِهِ لَا يُحْسِنُ التَّصَرُّفَ وَالتَّقَلُّبَ فِيهِ.

119
00:08:39,357 --> 00:08:39,903
- وَالْعَرُوضُ الثَّالِثَةُ: وَالْقِيعَانُ وَهُوَ الْمُسْتَوِي الَّذِي لَا يَقْبَلُ النَّبَاتَ

120
00:08:39,357 --> 00:08:39,903
وَلَا يُمْسِكُ مَاءً،

121
00:08:39,357 --> 00:08:39,903
فَلَوْ أَصَابَهَا مِنَ الْوَطَرِ مَا أَصَابَهَا لَمْ تَنْتَفِعْ

122
00:09:03,030 --> 00:09:04,630
بِشَيْءٍ مِنْهُ،

123
00:09:03,830 --> 00:09:04,630
فَهَذَا مَثَلُ الْقَلْبِ

124
00:09:13,130 --> 00:09:14,030
الَّذِي لَا يَحْفَظُ لِلْعِلْمِ وَلَا لِلْفِقْهِ وَالدِّرَايَاتِ فِيهِ،

125
00:09:13,580 --> 00:09:14,030
وَإِنَّمَا هُوَ بِمَنْزِلَةِ الْأَرْضِ الْبَوَارِي الَّتِي لَا تُنْبِتُ وَلَا تَحْفَظُ

126
00:09:13,580 --> 00:09:14,030
الْمَاءَ،

127
00:09:20,755 --> 00:09:22,005
وَهُوَ مَثَلُ الْفَقِيرِ الَّذِي

128
00:09:49,565 --> 00:09:52,469
لَا مَالَ لَهُ وَلَا

129
00:09:52,469 --> 00:09:53,436
يُحْسِنُ يُمْسِكُ مَالًا.

130
00:09:52,469 --> 00:09:53,436
فَالْأَوَّلُ عَالِمٌ مُعَلِّمٌ دَاعٍ لِلَّهِ عَلَى بَصِيرَةٍ،

131
00:09:52,469 --> 00:09:53,436
فَهَذَا

132
00:10:06,985 --> 00:10:08,920
مِنْ وَرَثَةِ الرُّسُلِ،

133
00:10:07,953 --> 00:10:08,920
وَالثَّانِي حَافِظٌ مُؤَدٍّ لِمَا سَمِعَهُ،

134
00:10:07,953 --> 00:10:08,920
فَهَذَا يَحْمِلُ لِغَيْرِهِ مَا يَتَّجِرُ بِهِ الْمَحْمُولُ إِلَيْهِ وَيَسْتَثْمِرُ،

135
00:10:07,953 --> 00:10:10,856
وَالثَّالِثُ لَا هَذَا

136
00:10:13,759 --> 00:10:15,695
وَلَا هَذَا،

137
00:10:14,727 --> 00:10:15,695
فَهُوَ الَّذِي

138
00:10:21,380 --> 00:10:23,255
لَمْ يَقْبَلْ هُدَى

139
00:10:37,317 --> 00:10:39,192
اللَّهِ وَلَا رَفَعَ بِهِ رَأْسًا،

140
00:10:38,255 --> 00:10:39,192
فَاسْتَوْعَبَ هَذَا الْحَدِيثُ وَرَقَّسَهَا

141
00:11:32,005 --> 00:11:33,255
مِنْ حَلَقَةِ الدَّعْوَةِ النَّبَوِيَّةِ وَمَنَازِلِهِمْ مِنْهَا قِسْمَانِ سَعِيدَانِ وَقِسْمٌ شَقِيٌّ.

142
00:11:32,630 --> 00:11:33,255
قَالَ الشَّارِحُ هَدَاهُ

143
00:11:37,630 --> 00:11:38,880
اللَّهُ: لَمَّا فَرَغَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ تَعَالَى

144
00:11:53,523 --> 00:11:54,594
مِنْ ذِكْرِ قِسْمَةِ الْأَتْبَاعِ الْأَشْقِيَاءِ وَأَنَّهُمْ نَوْعَانِ: أَحَدُهُمَا: أَتْبَاعٌ مُشْتَرِكُونَ

145
00:11:54,059 --> 00:11:54,594
مَعَ مَتْبُوعِيهِمْ

146
00:12:19,664 --> 00:12:20,681
فِي الضَّلَالَةِ،

147
00:12:20,172 --> 00:12:20,681
وَالْآخَرُ: أَتْبَاعٌ مُخَالِفُونَ لِمَتْبُوعِيهِمْ،

148
00:12:20,172 --> 00:12:20,681
شَرَعَ بَعْدُ يَذْكُرُ الْأَتْبَاعَ السُّعَدَاءَ،

149
00:12:20,172 --> 00:12:20,681
وَجَعَلَهُمْ رَحِمَهُ

150
00:12:34,918 --> 00:12:36,444
اللَّهُ تَعَالَى نَوْعَيْنِ: أَحَدُهُمَا: أَتْبَاعٌ لَهُمْ حُكْمُ الِاسْتِقْلَالِ،

151
00:12:35,935 --> 00:12:36,444
وَهُمُ الَّذِينَ قَالَ

152
00:12:44,579 --> 00:12:45,596
اللَّهُ عَزَّ وَجَلَّ فِيهِمْ: ﴿وَالسَّابِقُونَ الْأَوَّلُونَ

153
00:12:51,550 --> 00:12:52,670
مِنَ الْمُهَاجِرِينَ وَالْأَنْصَارِ وَالَّذِينَ اتَّبَعُوهُمْ بِإِحْسَانٍ رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا

154
00:12:52,110 --> 00:12:52,670
عَنْهُ﴾ فَهَؤُلَاءِ هُمُ السُّعَدَاءُ الَّذِينَ ثَبَتَ لَهُمْ رِضَا اللَّهِ عَنْهُمْ،

155
00:12:52,110 --> 00:12:52,670
وَهُمْ أَصْحَابُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

156
00:12:52,110 --> 00:12:52,670
وَكُلُّ مَنْ تَبِعَهُمْ بِإِحْسَانٍ،

157
00:12:52,110 --> 00:12:52,670
وَإِنَّمَا جُعِلَ هَؤُلَاءِ أَتْبَاعًا عَلَى الِاسْتِقْلَالِ؛ لِأَنَّ مَتْبُوعَهُمُ الْمُعَظَّمَ هُوَ

158
00:12:52,110 --> 00:12:52,670
وَاحِدٌ وَهُوَ مُحَمَّدٌ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

159
00:12:52,110 --> 00:12:54,910
فَبِاعْتِبَارِ كَوْنِهِمْ مُشْتَرِكِينَ فِي الْإِمَامِ

160
00:13:05,550 --> 00:13:06,670
الَّذِي يَقْتَدُونَ

161
00:13:22,593 --> 00:13:23,665
بِهِ وَيَتَّبِعُونَهُ صَارُوا أَصْلًا مُسْتَقِلًّا،

162
00:13:23,129 --> 00:13:23,665
وَهَؤُلَاءِ طَائِفَتَانِ: إِحْدَاهُمَا: طَائِفَةٌ شَهِدَتِ التَّنْزِيلَ وَصَحِبَتِ النَّبِيَّ صَلَّى اللَّهُ

163
00:13:23,129 --> 00:13:23,665
عَلَيْهِ وَسَلَّمَ،

164
00:13:23,129 --> 00:13:23,665
وَهَؤُلَاءِ هُمُ الصَّحَابَةُ،

165
00:13:23,129 --> 00:13:23,665
وَالْأُخْرَى: طَائِفَةٌ جَاءَتْ بَعْدَ مَوْتِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

166
00:13:23,129 --> 00:13:23,665
وَهَؤُلَاءِ

167
00:13:28,486 --> 00:13:29,557
لَا يَنْقَطِعُونَ إِلَى أَنْ يَرِثَ اللَّهُ

168
00:13:44,542 --> 00:13:45,610
الْأَرْضَ وَمَنْ عَلَيْهَا،

169
00:13:45,076 --> 00:13:45,610
وَهُمْ

170
00:13:49,627 --> 00:13:50,519
مَنْ آمَنَ بِمَا آمَنَ بِهِ مَنْ شَهِدَ التَّنْزِيلَ وَصَحِبَ الرَّسُولَ

171
00:13:50,073 --> 00:13:50,519
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

172
00:13:50,073 --> 00:13:50,519
فَيَنْدَرِجُ فِي هَؤُلَاءِ الْقَبْلُ

173
00:13:56,321 --> 00:13:57,214
الَّذِي كَانَ بَعْدَهُ فَمَنْ بَعْدَهُ فَمَنْ بَعْدَهُ فَمَنْ بَعْدَهُ أَنْ

174
00:13:56,767 --> 00:13:57,214
يَكُونُوا عَلَى الْإِحْسَانِ أَيْ عَلَى مَا كَانَ عَلَيْهِ النَّبِيُّ صَلَّى

175
00:14:15,008 --> 00:14:16,043
اللَّهُ عَلَيْهِ وَسَلَّمَ،

176
00:14:15,490 --> 00:14:18,257
وَاسْمُ التَّابِعِينَ بِإِحْسَانٍ غَيْرُ مُخْتَصٍّ بِفَتْرَةٍ بِمُدَّةٍ مِنَ الزَّمَنِ كَانَتْ

177
00:14:17,703 --> 00:14:18,257
بَعْدَ الصَّحَابَةِ رَضِيَ

178
00:14:31,536 --> 00:14:32,534
اللَّهُ عَنْهُمْ،

179
00:14:32,035 --> 00:14:32,534
وَمِنْ أَهْلِ الْعِلْمِ

180
00:14:55,690 --> 00:14:56,730
مِنَ الْمُتَأَخِّرِينَ

181
00:15:14,367 --> 00:15:15,905
مَنْ جَعَلَ التَّابِعِينَ بِإِحْسَانٍ

182
00:15:18,982 --> 00:15:20,521
مِنَ الصَّحَابَةِ وَهُمُ الَّذِينَ أَسْلَمُوا بَعْدَ فَتْحِ مَكَّةَ،

183
00:15:19,752 --> 00:15:20,521
وَرُوِيَ فِيهِ حَدِيثٌ عِنْدَ أَحْمَدَ إِلَّا أَسْلَمَ،

184
00:15:19,752 --> 00:15:20,521
وَالصَّحِيحُ

185
00:15:33,643 --> 00:15:34,584
أَنَّ التَّابِعِينَ بِإِحْسَانٍ اسْمٌ لِكُلِّ

186
00:15:37,408 --> 00:15:38,349
مَنْ جَاءَ بَعْدَ مَوْتِ النَّبِيِّ صَلَّى

187
00:15:43,029 --> 00:15:43,899
اللَّهُ عَلَيْهِ وَسَلَّمَ فَآمَنَ بِهِ أَصْحَابُ النَّبِيِّ صَلَّى

188
00:15:47,377 --> 00:15:48,247
اللَّهُ عَلَيْهِ وَسَلَّمَ وَكَانُوا عَلَى الْإِحْسَانِ،

189
00:15:47,812 --> 00:15:48,247
وَتَنْدَرِجُ

190
00:15:56,073 --> 00:15:56,942
فِي ذَلِكَ قُرُونُ الْأُمَّةِ كَافَّةً.

191
00:15:56,507 --> 00:15:56,942
ثُمَّ

192
00:16:09,986 --> 00:16:10,855
بَيَّنَ الْمُصَنِّفُ رَحِمَهُ

193
00:16:22,790 --> 00:16:23,790
اللَّهُ تَعَالَى

194
00:16:35,790 --> 00:16:36,790
أَنَّ هَؤُلَاءِ تَبَعِيَّتَهُمْ هِيَ تَبَعِيَّةٌ بِإِحْسَانٍ فَلَيْسَتْ مُطْلَقَةً فَتَحْصُلُ بِمُجَرَّدِ

195
00:16:36,290 --> 00:16:36,790
النِّسْبَةِ وَالِاتِّبَاعِ بِشَيْءٍ وَالْمُخَالَفَةِ بِغَيْرِهِ،

196
00:16:36,290 --> 00:16:36,790
وَلَكِنَّهَا تَبَعِيَّةٌ مُصَاحِبَةٌ لِلْإِحْسَانِ.

197
00:16:36,290 --> 00:16:36,790
ثُمَّ أَوْرَدَ قَوْلَ

198
00:16:40,790 --> 00:16:41,807
اللَّهِ عَزَّ وَجَلَّ

199
00:16:44,911 --> 00:16:45,945
فِي سُورَةِ الْجُمُعَةِ: ﴿هُوَ

200
00:16:55,256 --> 00:16:56,290
الَّذِي بَعَثَ

201
00:17:10,256 --> 00:17:11,290
فِي الْأُمِّيِّينَ رَسُولًا مِنْهُمْ يَتْلُو عَلَيْهِمْ آيَاتِهِ ...

202
00:17:10,773 --> 00:17:11,290
وَآخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا بِهِمْ وَهُوَ الْعَزِيزُ الْحَكِيمُ﴾ وَهَؤُلَاءِ الْآيَاتُ

203
00:17:10,773 --> 00:17:11,290
تَضَمَّنَتْ ذِكْرَ نَوْعَيْنِ: فَالنَّوْعُ الْأَوَّلُ الَّذِينَ أَدْرَكُوا رَسُولَ

204
00:17:18,744 --> 00:17:19,738
اللَّهِ صَلَّى

205
00:17:28,185 --> 00:17:29,179
اللَّهُ عَلَيْهِ وَسَلَّمَ وَصَاحَبُوهُ،

206
00:17:28,682 --> 00:17:29,179
وَالنَّوْعُ الثَّانِي

207
00:17:45,002 --> 00:17:47,119
الَّذِينَ لَمْ يُدْرِكُوا النَّبِيَّ صَلَّى

208
00:17:56,112 --> 00:17:57,155
اللَّهُ عَلَيْهِ وَسَلَّمَ وَلَكِنَّهُمْ كَانُوا عَلَى مَا

209
00:18:13,036 --> 00:18:13,929
كَانَ عَلَيْهِ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

210
00:18:13,483 --> 00:18:13,929
وَهَؤُلَاءِ

211
00:18:30,894 --> 00:18:31,786
لَمْ يَلْحَقُوا بِالنَّبِيِّ صَلَّى

212
00:18:40,715 --> 00:18:41,340
اللَّهُ عَلَيْهِ وَسَلَّمَ وَلَا بِصَحْبِهِ

213
00:18:50,990 --> 00:18:51,923
لَا زَمَانًا وَلَا فَضْلًا وَمَقَامًا،

214
00:18:51,457 --> 00:18:51,923
فَالْقَوْلَانِ الْمَذْكُورَانِ

215
00:18:55,190 --> 00:18:56,123
فِي الْآيَةِ هُمَا مُتَلَازِمَانِ كَمَا ذَكَرَ الْمُصَنِّفُ رَحِمَهُ

216
00:19:01,723 --> 00:19:02,657
اللَّهُ تَعَالَى،

217
00:19:19,997 --> 00:19:21,849
فَإِنَّ مَنْ بَعْدَهُمْ لَا يَلْحَقُونَ بِهِمْ لَا بِالْفَضْلِ وَلَا بِالزَّمَانِ،

218
00:19:21,386 --> 00:19:21,849
فَهَؤُلَاءِ الصِّنْفُ الَّذِينَ حُمِّلُوا التَّوْرَاةَ ثُمَّ لَمْ يَحْمِلُوهَا فَهُمْ لَهُمْ

219
00:19:21,386 --> 00:19:21,849
عِلْمٌ لَكِنَّهُمْ لَمْ يَنْتَفِعُوا بِذَلِكَ الْعِلْمِ وَلَا ظَهَرَ أَثَرُهُمْ عَلَيْهِ.

220
00:19:21,386 --> 00:19:21,849
ثُمَّ ذَكَرَ

221
00:19:38,423 --> 00:19:40,090
رَحِمَهُ اللَّهُ تَعَالَى حَدِيثًا عَظِيمًا وَهُوَ حَدِيثُ أَبِي مُوسَى الْأَشْعَرِيِّ

222
00:19:39,673 --> 00:19:40,507
فِي الصَّحِيحِ،

223
00:19:40,090 --> 00:19:40,507
وَكَذَلِكَ الْعِلْمُ وَالْهُدَى وَالنُّورُ سَبَبُ حَيَاةِ الْقُلُوبِ،

224
00:19:40,090 --> 00:19:40,507
وَشَبَّهَ الْقُلُوبَ الْقَابِلَةَ لِلْعِلْمِ بِالْأَرْضِ الْقَابِلَةِ لِلْغَيْثِ،

225
00:20:09,052 --> 00:20:09,898
كَمَا شَبَّهَ

226
00:20:18,077 --> 00:20:19,257
سُبْحَانَهُ الْقُلُوبَ بِالْأَوْدِيَةِ

227
00:20:28,693 --> 00:20:29,872
فِي قَوْلِهِ

228
00:20:37,037 --> 00:20:38,261
تَعَالَى: ﴿أَنْزَلَ

229
00:20:52,945 --> 00:20:54,169
مِنَ السَّمَاءِ مَاءً فَسَالَتْ أَوْدِيَةٌ بِقَدَرِهَا﴾.

230
00:20:53,557 --> 00:20:54,169
ثُمَّ ذَكَرَ رَحِمَهُ اللَّهُ تَعَالَى أَنَّهُ كَمَا أَنَّ الْأَرَاضِينَ ثَلَاثَةٌ

231
00:20:53,557 --> 00:20:54,169
بِالنِّسْبَةِ

232
00:20:57,840 --> 00:20:59,063
إِلَى قَبُولِ الْغَيْثِ فَكَذَلِكَ الْقُلُوبُ: - أَوَّلُهَا: أَرْضٌ زَكِيَّةٌ فَهَذِهِ

233
00:20:58,452 --> 00:20:59,063
الْغَيْثُ قَابِلَةٌ لِلشُّرْبِ وَالنَّبَاتِ،

234
00:20:58,452 --> 00:21:01,511
فَإِذَا أَصَابَهَا الْغَيْثُ اهْتَدَتْ وَرَبَّتْ وَأَنْبَتَتْ مِنْ كُلِّ زَوْجٍ بَهِيجٍ،

235
00:21:00,899 --> 00:21:01,511
وَهَذِهِ مَثَلٌ مَضْرُوبٌ لِلْقَلْبِ الزَّكِيِّ الذَّكِيِّ،

236
00:21:00,899 --> 00:21:01,511
فَهُوَ الَّذِي يَقْبَلُ الْعِلْمَ بِذَكَائِهِ وَيُثْمِرُ فِيهِ وُجُوهَ الْحِكَمِ وَدِينَ

237
00:21:00,899 --> 00:21:01,511
الْحَقِّ بِذَكَائِهِ،

238
00:21:00,899 --> 00:21:01,511
فَهُوَ جَامِعٌ بَيْنَ الذَّكَاءِ وَالزَّكَاءِ،

239
00:21:00,899 --> 00:21:01,511
فَإِنَّ الْمَرْءَ لَا يُفْلِحُ إِلَّا بِذَكَاءٍ وَزَكَاءٍ،

240
00:21:00,899 --> 00:21:01,511
فَإِنْ

241
00:21:09,297 --> 00:21:10,347
كَانَ ذَكَاءٌ دُونَ زَكَاءٍ فَإِنَّهُ لَمْ يُفْلِحْ كَمَا هِيَ حَالُ

242
00:21:09,822 --> 00:21:10,872
وَقَوْلُ كَثِيرٍ مِنَ الْمُتَكَلِّمِينَ

243
00:21:14,023 --> 00:21:15,074
فِي أَبْوَابِ الْخَبَرِ خَاصَّةً دُونَ تَقْوَى وَلَا زَكَاءٍ،

244
00:21:14,549 --> 00:21:15,074
كَمَا قَالَ أَبُو الْعَبَّاسِ ابْنُ تَيْمِيَّةَ فِي [فَصْلِهِمْ فِي إِقْرَارِ

245
00:21:14,549 --> 00:21:15,074
الْحَمَوِيَّةِ]: [أُوتُوا ذَكَاءً وَلَمْ يُؤْتَوْا زَكَاءً،

246
00:21:14,549 --> 00:21:15,074
وَأُعْطُوا عُلُومًا وَلَمْ يُعْطَوْا فُهُومًا،

247
00:21:14,549 --> 00:21:15,074
وَجَعَلَ

248
00:21:42,923 --> 00:21:52,917
اللَّهُ

249
00:21:52,917 --> 00:22:02,910
لَهُمْ

250
00:21:52,917 --> 00:22:02,910
سَمْعًا

251
00:21:52,917 --> 00:22:02,910
وَأَبْصَارًا

252
00:21:52,917 --> 00:22:02,910
وَأَفْئِدَةً

253
00:21:52,917 --> 00:22:02,910
فَمَا

254
00:21:52,917 --> 00:22:02,910
أَغْنَى

255
00:21:52,917 --> 00:22:02,910
عَنْهُمْ

256
00:21:52,917 --> 00:22:02,910
سَمْعُهُمْ

257
00:22:09,612 --> 00:22:10,503
وَلَا أَبْصَارُهُمْ وَلَا أَفْئِدَتُهُمْ

258
00:22:14,513 --> 00:22:15,404
مِنْ شَيْءٍ

259
00:22:27,877 --> 00:22:28,768
إِذْ كَانُوا يَجْحَدُونَ بِآيَاتِ

260
00:22:31,022 --> 00:22:31,966
اللَّهِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ] انْتَهَى كَلَامُهُ.

261
00:22:31,494 --> 00:22:31,966
- وَالثَّانِيَةُ: وَهِيَ

262
00:22:51,606 --> 00:22:55,046
مَنْ ضُرِبَ لَهُ مَثَلٌ فِي أَرْضٍ صُلْبَةٍ قَابِلَةٍ لِثُبُوتِ الْمَاءِ

263
00:22:54,555 --> 00:22:55,046
فِيهَا وَحِفْظِهِ،

264
00:22:54,555 --> 00:22:55,046
فَهَذِهِ يَنْفَعُ النَّاسُ بِالْوُرُودِ عَلَيْهَا وَالسَّقْيِ مِنْهَا وَالِازْدِرَاعِ،

265
00:22:54,555 --> 00:22:55,046
وَهَذَا مَثَلُ الْقَلْبِ الْحَافِظِ لِلْعِلْمِ الَّذِي يَحْفَظُهُ

266
00:23:03,377 --> 00:23:04,272
كَمَا سَمِعَهُ

267
00:23:12,327 --> 00:23:15,906
وَلَا تَصَرُّفَ لَهُ فِيهِ وَلَا اسْتِنْبَاطَ،

268
00:23:15,459 --> 00:23:15,906
بَلْ لَهُ الْحِفْظُ الْمُجَرَّدُ،

269
00:23:15,459 --> 00:23:15,906
فَهُوَ يُؤَدِّي كَمَا سَمِعَ،

270
00:23:15,459 --> 00:23:15,906
وَهَذَانِ النَّوْعَانِ مَثَلُهُمَا مَثَلُ الْغَنِيِّ التَّاجِرِ الْخَبِيرِ بِوُجُوهِ الْمَكَاسِبِ،

271
00:23:15,459 --> 00:23:15,906
فَهُوَ يَكْسِبُ بِمَالِهِ وَيَتَصَرَّفُ بِهِ،

272
00:23:15,459 --> 00:23:15,906
وَهَذَا مِنْ جِنْسِ الْقَلْبِ الذَّكِيِّ الزَّكِيِّ،

273
00:23:27,540 --> 00:23:28,435
وَالثَّانِي مَثَلُ الْغَنِيِّ الَّذِي

274
00:23:31,568 --> 00:23:32,463
لَا خِبْرَةَ

275
00:23:38,058 --> 00:23:38,847
لَهُ بِوُجُوهِ الرِّبْحِ وَالْمَكَاسِبِ،

276
00:23:38,453 --> 00:23:38,847
وَلَكِنْ عِنْدَهُ مَالٌ عَظِيمٌ فَهُوَ قَائِمٌ عَلَى حِفْظِهِ دُونَ تَنْبِيتِهِ

277
00:23:38,453 --> 00:23:38,847
وَتَثْمِيرِهِ وَتَقْلِيبِهِ،

278
00:23:49,498 --> 00:23:50,287
وَهَذَا مَثَلُ الْقَلْبِ الثَّانِي.

279
00:23:49,892 --> 00:23:50,287
- وَالْعَرُوضُ الثَّالِثَةُ: وَهِيَ أَرْضٌ قَاعٌ وَهِيَ الْأَرْضُ الْمُسْتَوِيَةُ الَّتِي

280
00:23:50,287 --> 00:23:51,076
لَا تَقْبَلُ النَّبَاتَ وَلَا تُمْسِكُ الْمَاءَ،

281
00:23:50,681 --> 00:23:52,259
فَلَوْ أَصَابَهَا مِنَ الْمَطَرِ مَا أَصَابَهَا لَمْ تَنْتَفِعْ بِشَيْءٍ وَلَنْ

282
00:23:51,865 --> 00:23:52,259
يَنْتَفِعَ النَّاسُ مِنْهَا بِشَيْءٍ،

283
00:24:11,799 --> 00:24:13,466
فَهَذَا مَثَلُ الْقَلْبِ الَّذِي لَا يَقْبَلُ الْعِلْمَ وَلَا الْفِقْهَ وَالدِّرَايَةَ

284
00:24:12,910 --> 00:24:13,466
فِيهِ، وَإِنَّمَا

285
00:24:27,112 --> 00:24:28,163
هُوَ بِمَنْزِلَةِ الْأَرْضِ الْبَوَارِي الَّتِي لَا تُنْبِتُ وَلَا تَحْفَظُ الْمَاءَ،

286
00:24:27,637 --> 00:24:28,163
وَهُوَ مَثَلُ الْفَقِيرِ الَّذِي لَا مَالَ

287
00:24:49,195 --> 00:24:50,247
لَهُ وَلَا يُحْسِنُ يُمْسِكُ مَالًا.

288
00:24:49,721 --> 00:24:50,247
ثُمَّ ذَكَرَ مَرَاتِبَ النَّاسِ حِينَئِذٍ فَقَالَ: - فَالْأَوَّلُ: عَالِمٌ مُعَلِّمٌ

289
00:24:49,721 --> 00:24:50,247
دَاعٍ

290
00:25:11,921 --> 00:25:13,618
إِلَى اللَّهِ وَفِقْهٍ وَبَصِيرَةٍ،

291
00:25:13,052 --> 00:25:13,618
فَهَذَا

292
00:25:19,840 --> 00:25:20,971
مِنْ وَرَثَةِ الرُّسُلِ.

293
00:25:20,405 --> 00:25:20,971
- وَالثَّانِي: حَافِظٌ مُؤَدٍّ لِمَا سَمِعَهُ،

294
00:25:20,405 --> 00:25:20,971
فَهَذَا يَحْمِلُ لِغَيْرِهِ مَا يَتَّجِرُ بِهِ الْمَحْمُولُ إِلَيْهِ وَيَسْتَثْمِرُ.

295
00:25:20,405 --> 00:25:20,971
- وَالثَّالِثُ: لَا

296
00:25:37,650 --> 00:25:39,016
هَذَا وَلَا هَذَا،

297
00:25:38,333 --> 00:25:39,016
فَهُوَ الَّذِي لَمْ يَقْبَلْ هُدَى

298
00:25:51,992 --> 00:25:53,358
اللَّهِ وَلَا رَفَعَ بِهِ رَأْسًا.

299
00:25:52,675 --> 00:25:53,358
فَكَانَ هَذَا الْحَدِيثُ مُسْتَوْعِبًا لِأَقْسَامِ الْخَلْقِ بِالدَّعْوَةِ النَّبَوِيَّةِ وَمَنَازِلِهِمْ،

300
00:25:52,675 --> 00:25:53,358
وَأَنَّ مِنْهُمْ قِسْمَيْنِ سَعِيدَيْنِ وَثَالِثَهُمْ قِسْمٌ شَقِيٌّ.

301
00:25:52,675 --> 00:25:53,358
وَإِذَا أُورِدَ

302
00:26:14,607 --> 00:26:16,133
عَلَى الْعَبْدِ

303
00:26:38,613 --> 00:26:41,699
هَذَا الْحَدِيثُ يَنْبَغِي لَهُ أَنْ يُزْعِجَ قَلْبَهُ

304
00:26:41,699 --> 00:26:42,213
وَأَنْ يُحَرِّكَ نَفْسَهُ،

305
00:26:41,699 --> 00:26:42,213
فَإِنَّهُ لَا يَبِينُ مِنْ أَيِّ الْقُلُوبِ الثَّلَاثَةِ يَكُونُ،

306
00:26:41,699 --> 00:26:42,213
وَإِنْ أَوْرَدَ مِثْلَ هَذِهِ الْأَحَادِيثِ الَّتِي يُمِرُّهَا بَعْضُ النَّاسِ عَلَى

307
00:26:41,699 --> 00:26:42,213
أَسْمَاعِهِمْ

308
00:26:47,870 --> 00:26:49,133
ثُمَّ لَا يُلْقُونَ إِلَيْهَا بَالًا وَلَا يَرْفَعُونَ إِلَيْهَا رَأْسًا وَلَا

309
00:26:48,502 --> 00:26:49,133
يَتَلَمَّسُ أَحَدُهُمْ مَقَامَهُ

310
00:27:09,870 --> 00:27:10,981
فِي الدِّينِ،

311
00:27:10,426 --> 00:27:10,981
فَلْيَخَفِ

312
00:27:15,426 --> 00:27:15,981
اللَّهَ

313
00:27:39,261 --> 00:27:40,305
أَنْ يَكُونَ

314
00:27:42,688 --> 00:27:44,325
مِنْ أَهْلِ الْمَثَلِ الْأَوَّلِ أَوْ يَكُونَ

315
00:28:12,342 --> 00:28:13,287
مِنْ أَهْلِ الْمَثَلِ الثَّانِي أَوِ الثَّالِثِ؟

316
00:28:12,814 --> 00:28:13,287
وَمَا يَجِبُ

317
00:28:17,064 --> 00:28:18,009
لَهُ انْزِعَاجًا وَخَوْفًا وَإِقْبَالًا عَلَى

318
00:28:39,370 --> 00:28:40,475
اللَّهِ سُبْحَانَهُ وَتَعَالَى وَدَوَامَ سُؤَالٍ لِلَّهِ عَزَّ وَجَلَّ أَنْ يَرْزُقَهُ

319
00:28:51,182 --> 00:28:52,057
الْعِلْمَ النَّافِعَ وَالْعَمَلَ الصَّالِحَ وَأَنْ يَجْعَلَهُ

320
00:28:55,120 --> 00:28:55,995
مِنْ أَهْلِ الذَّكَاءِ وَالزَّكَاةِ،

321
00:28:55,557 --> 00:28:55,995
فَاللَّهُ سُبْحَانَهُ وَتَعَالَى هُوَ الَّذِي يُقَلِّبُ الْقُلُوبَ وَيُصَرِّفُ الْأُمُورَ.

322
00:28:55,557 --> 00:28:55,995
يَقُولُ ابْنُ الْقَيِّمِ رَحِمَهُ اللَّهُ تَعَالَى بِـ[النُّونِيَّةِ]: [وَاجْعَلْ لِقَلْبِكَ بَطْلَتَيْنِ

323
00:28:55,557 --> 00:28:55,995
كِلَاهُمَا

324
00:29:05,761 --> 00:29:06,909
مِنْ رَحْمِ خَشْيَةِ اللَّهِ بَاكِيَتَانِ،

325
00:29:06,335 --> 00:29:06,909
لَوْ شَاءَ رَبُّكَ كُنْتَ أَيْضًا مُذَرَّهُمْ فَالْقَلْبُ

326
00:29:30,862 --> 00:29:31,929
بَيْنَ أَصَابِعِ الرَّحْمَنِ].

327
00:29:31,395 --> 00:29:32,995
فَلَوْ شَاءَ اللَّهُ عَزَّ وَجَلَّ لَحَبَسَكَ عَنِ الْجُلُوسِ فِي بَتْرِ

328
00:29:32,462 --> 00:29:32,995
هَذِهِ الْمَجَالِسِ وَجَعَلَ قَلْبَكَ صَلْدًا لَا يَنْتَفِعُ بِغَيْثٍ أَبَدًا

329
00:29:39,392 --> 00:29:40,458
فَلَا يَهْتَدِي بِهُدًى

330
00:30:01,890 --> 00:30:02,987
وَلَا يَمْتَثِلُ بِأَمْرٍ وَلَا يَنْتَهِي بِنَهْيٍ،

331
00:30:02,438 --> 00:30:02,987
وَصَارَ حَالُ الْمَرْءِ فِيمَا

332
00:30:06,278 --> 00:30:07,375
قَالَ اللَّهُ عَزَّ وَجَلَّ: ﴿وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ

333
00:30:06,826 --> 00:30:08,472
وَقَلْبِهِ﴾. قَالَ بَعْضُ السَّلَفِ: [يُرِيدُ أَنْ يَهْتَدِيَ فَلَا يَهْتَدِي،

334
00:30:07,923 --> 00:30:08,472
وَيُرِيدُ أَنْ يَتُوبَ فَلَا يَتُوبُ].

335
00:30:13,408 --> 00:30:15,602
فَإِذَا نَظَرَ الْإِنْسَانُ

336
00:30:26,230 --> 00:30:27,030
إِلَى حَالِ قَلْبِهِ خَشِيَ

337
00:30:40,063 --> 00:30:42,817
أَنْ يَجْعَلَهُ اللَّهُ سُبْحَانَهُ وَتَعَالَى

338
00:30:50,680 --> 00:30:51,930
مِنْ أَهْلِ الْقِسْمِ الثَّالِثِ،

339
00:30:54,430 --> 00:30:55,344
ثُمَّ رَجَعَ بِحُسْنِ الظَّنِّ وَقُوَّةِ الرَّجَاءِ

340
00:31:05,300 --> 00:31:05,995
إِلَى

341
00:31:25,582 --> 00:31:26,637
اللَّهِ سُبْحَانَهُ وَتَعَالَى مُسْتَغِيثًا مُلْتَمِسًا دَاعِيًا خَاشِعًا خَاضِعًا رَاغِبًا رَاهِبًا

342
00:31:47,297 --> 00:31:48,235
إِلَى اللَّهِ

343
00:31:58,110 --> 00:31:59,110
أَنْ يَجْعَلَهُ مِنْ أَهْلِ الْعِلْمِ وَالذَّكَاءِ وَالزَّكَاءِ

344
00:32:13,084 --> 00:32:14,294
الَّذِي يُقَدِّمُهُ إِلَى اللَّهِ وَلَا يُقَدِّمُهُ إِلَى الْمَنَاصِبِ وَالرِّئَاسَاتِ وَالْجَاهَاتِ

345
00:32:13,689 --> 00:32:14,294
وَالْجَاهِ وَالْمَقَامِ

346
00:32:19,110 --> 00:32:20,310
فِي الدُّنْيَا،

347
00:32:19,710 --> 00:32:20,310
فَإِنَّ هَذَا لَا يُغْنِي عَنِ الْإِنْسَانِ شَيْئًا،

348
00:32:19,710 --> 00:32:20,310
وَكُلُّ مَا فَوْقَ التُّرَابِ تُرَابٌ،

349
00:32:19,710 --> 00:32:20,310
وَلَكِنَّ الْمَقْصُودَ أَنْ تَلْقَى وَتَلْقَى الْعِلْمَ الَّذِي يُقَرِّبُكَ عِنْدَ اللَّهِ

350
00:32:19,710 --> 00:32:20,310
سُبْحَانَهُ وَتَعَالَى.

351
00:32:19,710 --> 00:32:20,310
وَمِنْ عَجَائِبِ الْأَخْبَارِ أَنَّ مُصَنِّفَ هَذَا الْكِتَابِ رَأَى شَيْخَهُ ابْنَ

352
00:32:19,710 --> 00:32:20,310
تَيْمِيَّةَ رَحِمَهُ اللَّهُ تَعَالَى بَعْدَ مَوْتِهِ فَسَأَلَهُ عَنْ مَقَامِهِ فَأَخْبَرَهُ

353
00:32:19,710 --> 00:32:20,310
أَنَّهُ فِي مَقَامٍ عَظِيمٍ ثُمَّ أَخْبَرَهُ بِأَنَّهُ

354
00:32:40,860 --> 00:32:41,422
هُوَ

355
00:33:02,051 --> 00:33:03,110
فِي مَقَامِ أَبِي بَكْرِ بْنِ خُزَيْمَةَ،

356
00:33:02,581 --> 00:33:03,110
فَالرُّقِيُّ وَالصُّعُودُ عِنْدَ

357
00:33:06,268 --> 00:33:07,531
اللَّهِ عَزَّ وَجَلَّ

358
00:33:11,952 --> 00:33:13,215
فِي الدَّرَجَاتِ فِي اعْتِبَارِ الْمَقَامَاتِ هُوَ بِحَسَبِ مَا يَنَالُهُ

359
00:33:16,310 --> 00:33:16,910
الْإِنْسَانُ

360
00:33:22,310 --> 00:33:22,910
مِنَ

361
00:33:33,610 --> 00:33:34,610
الْعِلْمِ الصَّحِيحِ النَّافِعِ الْمُقَرِّبِ إِلَى

362
00:33:38,610 --> 00:33:40,110
اللَّهِ سُبْحَانَهُ وَتَعَالَى،

363
00:33:40,110 --> 00:33:40,584
فَنَسْأَلُهُ سُبْحَانَهُ وَتَعَالَى بِأَسْمَائِهِ الْحُسْنَى وَصِفَاتِهِ الْعُلَى أَنْ يُذِيقَنَا عِلْمًا

364
00:33:40,110 --> 00:33:40,584
نَافِعًا وَعَمَلًا صَالِحًا وَأَنْ يَهَبَ لَنَا الذَّكَاءَ وَالزَّكَاءَ.

365
00:33:45,794 --> 00:33:46,742
قَالَ الْمُصَنِّفُ حَفِظَهُ

366
00:34:10,360 --> 00:34:11,460
اللَّهُ: فَصْلٌ: وَأَمَّا النَّوْعُ الثَّانِي

367
00:34:34,910 --> 00:34:35,939
مِنَ الْأَتْبَاعِ السُّعَدَاءِ فَهُمْ أَتْبَاعُ الْمُؤْمِنِينَ

368
00:34:40,567 --> 00:34:41,596
مِنْ ذُرِّيَّاتِهِمُ الَّذِينَ

369
00:34:54,110 --> 00:34:55,201
لَمْ يَثْبُتْ لَهُمْ حُكْمُ التَّكْلِيفِ

370
00:34:58,474 --> 00:34:59,565
فِي دَارِ الدُّنْيَا،

371
00:34:59,019 --> 00:34:59,565
وَإِنَّمَا هُمْ مَعَ آبَائِهِمْ تَبَعٌ لَهُمْ.

372
00:34:59,019 --> 00:34:59,565
قَالَ اللَّهُ تَعَالَى فِيهِمْ: ﴿وَالَّذِينَ آمَنُوا وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُمْ بِإِيمَانٍ أَلْحَقْنَا

373
00:34:59,019 --> 00:34:59,565
بِهِمْ ذُرِّيَّتَهُمْ وَمَا أَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَيْءٍ كُلُّ امْرِئٍ

374
00:34:59,019 --> 00:34:59,565
بِمَا كَسَبَ رَهِينٌ﴾ أَخْبَرَ سُبْحَانَهُ أَنَّهُ أَلْحَقَ ذُرِّيَّاتِ آبَائِهِمْ

375
00:35:04,474 --> 00:35:05,565
فِي الْجَنَّةِ كَمَا اتَّبَعُوهُمْ إِيَّاهُمْ

376
00:35:10,474 --> 00:35:11,565
فِي الْإِيمَانِ،

377
00:35:11,019 --> 00:35:11,565
وَلَمَّا كَانَتِ الذُّرِّيَّةُ لَا عَمَلَ لَهُمْ يَسْتَحِقُّونَ بِهِ تِلْكَ الدَّرَجَاتِ

378
00:35:37,350 --> 00:35:38,239
قَالَ تَعَالَى: ﴿وَمَا أَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَيْءٍ﴾ وَالضَّمِيرُ عَائِدٌ

379
00:35:48,077 --> 00:35:49,532
إِلَى الَّذِينَ آمَنُوا أَيْ: لَمْ نَنْقُصْهُمْ

380
00:36:07,350 --> 00:36:08,350
فِي عَمَلِهِمْ بَلْ رَفَعْنَا ذُرِّيَّتَهُمْ إِلَى دَرَجَاتِهِمْ مَعَ تَوْفِيَتِهِمْ أُجُورَ

381
00:36:07,850 --> 00:36:08,350
أَعْمَالِهِمْ، فَلَيْسَتْ مَنْزِلَتُهُمْ مَنْزِلَةَ

382
00:36:12,192 --> 00:36:13,139
مَنْ لَمْ يَكُنْ لَهُ عَمَلٌ بَلْ وَفَّيْنَاهُمْ أُجُورَهُمْ وَأَلْحَقْنَا بِهِمْ

383
00:36:12,666 --> 00:36:13,139
ذُرِّيَّاتِهِمْ فَوْقَ مَا يَسْتَحِقُّونَهُ

384
00:36:23,975 --> 00:36:25,850
مِنْ أَعْمَالِهِمْ.

385
00:36:24,912 --> 00:36:25,850
ثُمَّ لَمَّا كَانَ هَذَا الْإِلْحَاقُ فِي الثَّوَابِ وَالدَّرَجَاتِ فَضْلًا

386
00:36:27,725 --> 00:36:29,600
مِنَ اللَّهِ فَرُبَّمَا وَقَعَ بِالْوَهْمِ أَنَّ إِلْحَاقَ الذُّرِّيَّةِ أَيْضًا حَاصِلٌ

387
00:36:28,662 --> 00:36:29,600
بِهِمْ فِي حُكْمِ الْعَدْلِ،

388
00:36:28,662 --> 00:36:29,600
فَإِذَا اكْتَسَبُوا سَيِّئَاتٍ أَوْ وَجَبَتْ عُقُوبَةٌ كَانَ كُلُّ عَامِدٍ رَهِينًا

389
00:36:28,662 --> 00:36:29,600
بِكَسْبِهِ

390
00:37:02,350 --> 00:37:04,350
لَا يَتَعَلَّقُ بِغَيْرِهِ مِنْهُ شَيْءٌ،

391
00:37:03,350 --> 00:37:04,350
فَالْإِلْحَاقُ الْمَذْكُورُ إِنَّمَا هُوَ

392
00:37:07,259 --> 00:37:08,168
فِي الثَّوَابِ وَالدَّرَجَاتِ

393
00:37:11,850 --> 00:37:12,100
لَا

394
00:37:31,316 --> 00:37:32,212
فِي الْعَدْلِ وَالْعِقَابِ،

395
00:37:31,764 --> 00:37:32,212
وَهَذَا وَنَحْوُهُ مِنْ إِشْكَالِ الْقُرْآنِ وَكُلِّ وَزْنٍ الَّذِي يَخْتَصُّ اللَّهُ

396
00:37:31,764 --> 00:37:32,212
بِفَهْمِهَا مَنْ يَشَاءُ.

397
00:37:31,764 --> 00:37:32,212
فَقَدْ تَضَمَّنَتْ هَذِهِ الْآيَاتُ أَقْسَامَ الْخَلَائِقِ كُلِّهِمْ سُعَدَائِهِمْ وَأَشْقِيَائِهِمْ: السُّعَدَاءُ

398
00:37:31,764 --> 00:37:32,212
الْمَتْبُوعُونَ وَالْأَتْبَاعُ،

399
00:37:31,764 --> 00:37:32,212
وَالْأَشْقِيَاءُ الْمَتْبُوعُونَ.

400
00:37:31,764 --> 00:37:32,212
فَعَلَى الْعَاقِلِ النَّاصِحِ لِنَفْسِهِ

401
00:37:41,350 --> 00:37:42,100
أَنْ يَنْظُرَ

402
00:37:55,150 --> 00:37:55,870
مِنْ أَيِّ الْأَقْسَامِ هُوَ وَلَا يَغْتَرَّ بِالْعَادَةِ وَيَخْلُدَ إِلَى الْبَطَالَةِ،

403
00:37:55,510 --> 00:37:55,870
فَإِنْ كَانَ مِنْ قِسْمٍ سَعِيدٍ انْتَقَلَ مِنْهُ إِلَى

404
00:38:00,190 --> 00:38:00,910
مَا فَوْقَهُ وَبَذَلَ جُهْدَهُ وَاللَّهُ وَلِيُّ التَّوْفِيقِ وَالنَّجَاحِ،

405
00:38:00,550 --> 00:38:00,910
وَإِنْ كَانَ

406
00:38:20,572 --> 00:38:21,461
مِنْ قِسْمٍ شَقِيٍّ انْتَقَلَ مِنْهُ إِلَى الْقِسْمِ السَّعِيدِ

407
00:38:33,461 --> 00:38:34,350
فِي زَمَنِ الْإِمْكَانِ قَبْلَ أَنْ يَقُولَ: ﴿يَا لَيْتَنِي اتَّخَذْتُ مَعَ

408
00:38:33,906 --> 00:38:34,350
الرَّسُولِ سَبِيلًا﴾.

409
00:38:33,906 --> 00:38:34,350
قَالَ الشَّارِحُ هَدَاهُ

410
00:38:52,283 --> 00:38:53,217
اللَّهُ: شَرَعَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ

411
00:39:02,550 --> 00:39:03,483
تَعَالَى فِي هَذَا الْفَصْلِ النَّوْعَ الثَّانِيَ مِنَ الْأَتْبَاعِ السُّعَدَاءِ،

412
00:39:03,017 --> 00:39:03,483
وَهُمْ أَتْبَاعُ الْمُؤْمِنِينَ مِنْ ذُرِّيَّاتِهِمُ الَّذِينَ لَمْ يَثْبُتْ حُكْمُ التَّكْلِيفِ

413
00:39:03,017 --> 00:39:03,483
فِي دَارِ الدُّنْيَا،

414
00:39:03,017 --> 00:39:03,483
أَيِ الَّذِينَ لَمْ يَتَعَلَّقْ بِهِمْ خِطَابُ الْأَمْرِ وَالنَّهْيِ كَمَنْ مَاتَ

415
00:39:03,017 --> 00:39:03,483
صَغِيرًا

416
00:39:21,683 --> 00:39:22,350
أَوْ غَيْرِ ذَلِكَ،

417
00:39:22,017 --> 00:39:22,350
وَهَؤُلَاءِ يَكُونُونَ مَعَ آبَائِهِمْ تَبَعًا لَهُمْ كَمَا

418
00:39:32,017 --> 00:39:32,461
قَالَ

419
00:39:56,250 --> 00:39:56,850
اللَّهُ عَزَّ وَجَلَّ: ﴿وَالَّذِينَ آمَنُوا﴾ فَأَخْبَرَ اللَّهُ عَزَّ وَجَلَّ

420
00:40:09,150 --> 00:40:09,950
أَنَّ الذُّرِّيَّةَ تَبَعٌ لِلْآبَاءِ،

421
00:40:09,550 --> 00:40:09,950
وَذَلِكَ فَضْلٌ مِنْهُ سُبْحَانَهُ وَتَعَالَى عَلَيْهِمْ،

422
00:40:09,550 --> 00:40:09,950
فَوَفَّاهُمُ اللَّهُ عَزَّ وَجَلَّ جَزَاءَ أَعْمَالِهِمْ وَزَادَهُمْ فَضْلًا بِأَنْ أَلْحَقَ

423
00:40:09,550 --> 00:40:09,950
بِهِمْ ذُرِّيَّاتِهِمْ،

424
00:40:32,550 --> 00:40:33,483
وَهَذَا الْإِلْحَاقُ هُوَ

425
00:40:47,662 --> 00:40:48,787
فِي الْفَضْلِ دُونَ الْعَدْلِ؛ لِأَنَّ كُلَّ نَفْسٍ ﴿بِمَا كَسَبَتْ رَهِينَةٌ﴾.

426
00:40:48,225 --> 00:40:48,787
ثُمَّ ذَكَرَ رَحِمَهُ اللَّهُ تَعَالَى

427
00:40:54,779 --> 00:40:55,350
أَنَّ الْآيَاتِ الْمُتَقَدِّمَةَ تَضَمَّنَتْ أَقْسَامَ الْخَلَائِقِ كُلِّهِمْ سُعَدَائِهِمْ وَأَشْقِيَائِهِمْ: السُّعَدَاءُ

428
00:40:55,064 --> 00:40:55,350
الْمَتْبُوعُونَ وَالْأَتْبَاعُ،

429
00:40:55,064 --> 00:40:55,350
وَالْأَشْقِيَاءُ الْمَتْبُوعُونَ وَالْأَتْبَاعُ.

430
00:40:55,064 --> 00:40:55,921
ثُمَّ قَالَ وَاعِظًا وَمُوصِيًا: فَلْيَنْظُرِ الْعَاقِلُ النَّاصِحُ لِنَفْسِهِ مِنْ أَيِّ

431
00:40:55,636 --> 00:40:55,921
الْأَقْسَامِ

432
00:41:13,350 --> 00:41:14,017
هُوَ وَلَا يَغْتَرَّ بِالْعَادَةِ وَيَخْلُدَ

433
00:41:28,196 --> 00:41:29,273
إِلَى الْبَطَالَةِ،

434
00:41:28,735 --> 00:41:31,100
فَإِنْ كَانَ مِنْ قِسْمٍ سَعِيدٍ انْتَقَلَ مِنْهُ إِلَى مَا فَوْقَهُ

435
00:41:30,850 --> 00:41:31,100
وَبَذَلَ جُهْدَهُ وَاللَّهُ وَلِيُّ التَّوْفِيقِ وَالنَّجَاحِ،

436
00:41:30,850 --> 00:41:31,100
وَإِنْ كَانَ

437
00:41:43,714 --> 00:41:44,441
مِنْ قِسْمٍ شَقِيٍّ انْتَقَلَ

438
00:41:57,817 --> 00:41:58,350
مِنْهُ إِلَى الْقِسْمِ السَّعِيدِ فِي زَمَنِ الْإِمْكَانِ أَيِ زَمَنِ الْعَمَلِ

439
00:41:58,083 --> 00:41:58,350
وَهُوَ دَارُ الدُّنْيَا،

440
00:41:58,083 --> 00:41:58,350
فَهِيَ الَّتِي يُمْكِنُ لِلْإِنْسَانِ فِيهَا أَنْ يُرَقِّيَ نَفْسَهُ وَأَنْ يَرْتَفِعَ

441
00:41:58,083 --> 00:41:58,350
بِرُتْبَتِهَا

442
00:42:08,055 --> 00:42:09,481
مِنَ الْحَضِيضِ إِلَى الْعُلُوِّ قَبْلَ أَنْ يُقَالَ أَنْ يَقُولَ: ﴿يَا

443
00:42:08,768 --> 00:42:09,481
لَيْتَنِي اتَّخَذْتُ مَعَ الرَّسُولِ سَبِيلًا﴾.

444
00:42:08,768 --> 00:42:09,481
أَحْسَنَ اللَّهُ إِلَيْكُمْ،

445
00:42:08,768 --> 00:42:09,481
وَمَا طَرِيقُهُ وَمَا مَرْكَبُهُ؟

446
00:42:08,768 --> 00:42:09,481
قُلْتُ: زَادُهُ الْعِلْمُ الْمُوَرَّثُ عَنْ خَاتَمِ الْأَنْبِيَاءِ صَلَّى اللَّهُ عَلَيْهِ

447
00:42:08,768 --> 00:42:09,481
وَسَلَّمَ، وَلَا زَادَ لَهُ سِوَاهُ،

448
00:42:08,768 --> 00:42:09,481
فَمَنْ لَمْ يُحَصِّلْ هَذَا الزَّادَ فَلَا يَخْرُجْ

449
00:42:18,038 --> 00:42:19,464
مِنْ بَيْتِهِ وَلْيَقْعُدْ مَعَ الْخَالِفِينَ،

450
00:42:18,751 --> 00:42:19,464
فَرُفَقَاءُ التَّخَلُّفِ وَالْبَطَّالُونَ أَكْثَرُ مِنْ أَنْ يُحْصَوْا،

451
00:42:18,751 --> 00:42:19,464
فَبِهِ وَزَوْجَةٌ بِهِمْ وَلَنْ يَنْفَعَهُ

452
00:42:43,239 --> 00:42:44,028
هَذَا التَّأَسِّي يَوْمَ الْحَسْرَةِ

453
00:42:59,028 --> 00:42:59,818
فِي شَيْءٍ،

454
00:42:59,423 --> 00:42:59,818
كَمَا

455
00:43:04,160 --> 00:43:05,382
قَالَ تَعَالَى: ﴿وَلَنْ يَنْفَعَكُمُ الْيَوْمَ إِذْ ظَلَمْتُمْ أَنَّكُمْ فِي الْعَذَابِ

456
00:43:04,771 --> 00:43:05,382
مُشْتَرِكُونَ﴾ فَقَضَى اللَّهُ

457
00:43:19,430 --> 00:43:20,652
سُبْحَانَهُ انْتِبَاعَهُمْ بِتَأْثِيرِهِمْ بَعْضَهُمْ بِأَمْرٍ فِي الْعَذَابِ،

458
00:43:20,041 --> 00:43:20,652
فَإِنَّ مَصَائِبَ الدُّنْيَا إِذَا عَنَّتْ اتَّصَلَتْ مُتَثَلِّثَةً وَتَأَسَّى بَعْضُ الْمُصَابِينَ

459
00:43:20,041 --> 00:43:20,652
لِبَعْضٍ، كَمَا قَالَتِ الْخَنْسَاءُ: [فَلَوْلَا كَثْرَةُ الْبَاكِينَ حَوْلِي

460
00:43:47,168 --> 00:43:48,126
عَلَى إِخْوَانِهِمْ لَقَتَلَتْنِي نَفْسِي،

461
00:43:47,647 --> 00:43:48,126
وَمَا يَبْكُونَ مِثْلَ أَخِي وَلَكِنْ سَلَّتْ نَفْسِي عَنْهُمْ بِالتَّأَسِّي].

462
00:43:47,647 --> 00:43:48,126
فَهَذَا الرَّوْحُ الْحَاصِلُ

463
00:43:52,916 --> 00:43:53,874
مِنَ التَّأَسِّي مَعْدُومٌ بَيْنَ الْمُشْتَرِكِينَ فِي الْعَذَابِ يَوْمَ الْقِيَامَةِ.

464
00:43:53,395 --> 00:43:53,874
وَأَمَّا طَرِيقُهُ فَهُوَ بَذْلُ الْجُهْدِ وَاسْتِفْرَاغُ الْوُسْعِ،

465
00:43:53,395 --> 00:43:53,874
فَلَنْ يُنَالَ بِالْمُنَى وَلَا يُدْرَكُ بِالْهُوَيْنَى،

466
00:43:53,395 --> 00:43:55,311
وَإِنَّمَا كَمَا قِيلَ: [فَخُذْ غَبَرَاتِ الْمَوْتِ وَاسْمُ إِلَى الْعُلَا لِكَيْ

467
00:43:54,832 --> 00:43:55,311
تُدْرِكَ الْعِزَّ الرَّفِيعَ الدَّائِمِينَ،

468
00:43:54,832 --> 00:43:55,311
فَلَا خَيْرَ فِي نَفْسٍ تَخَافُ

469
00:44:01,059 --> 00:44:02,017
مِنَ الرَّزَايَا وَلَا هِمَّةٍ تَصْبُو إِلَى لَوْمِ لَائِمِينَ].

470
00:44:01,538 --> 00:44:02,017
وَلَا سَبِيلَ إِلَّا رَكْبُ هَذَا الظَّهِيرِ إِلَّا بِأَمْرَيْنِ: - أَحَدُهُمَا:

471
00:44:10,160 --> 00:44:10,912
أَنْ لَا يَصْبُوَ فِي الْحَقِّ إِلَى لَوْمِ لَائِمِينَ،

472
00:44:10,536 --> 00:44:10,912
فَإِنَّ اللَّوْمَ يُدْرِكُ الْفَارِسَ فَيَصْرَعُهُ عَنْ فَرَسِهِ وَيَجْعَلُهُ طَرِيحًا فِي

473
00:44:10,536 --> 00:44:10,912
الْأَرْضِ. - وَالثَّانِي: أَنْ تَهُونَ عَلَيْهِ نَفْسُهُ فِي

474
00:44:18,052 --> 00:44:18,803
اللَّهِ فَيُقَدِّمُهُ حِينَئِذٍ لَا يُخْبِرُكُمْ بِذَلِكَ فَلَنْ يَخَافَ الْأَهْوَالَ،

475
00:44:18,427 --> 00:44:18,803
فَمَتَى خَافَتِ النَّفْسُ تَأَخَّرَتْ وَأَحْجَمَتْ وَأَخْلَدَتْ إِلَى الْأَرْضِ،

476
00:44:18,427 --> 00:44:18,803
وَلَا يَتِمُّ لَهُ هَذَا الْأَمْرَانِ إِلَّا بِالصَّبْرِ،

477
00:44:18,427 --> 00:44:18,803
فَمَنْ صَبَرَ قَلِيلًا صَارَتْ تِلْكَ الْأَهْوَالُ رِيحًا رُخَاءً

478
00:44:29,325 --> 00:44:30,077
فِي حَقِّهِ تَحْمِلُهُ بِنَفْسِهَا إِلَى مَطْلُوبِهِ زَمَنًا مَا هُوَ يَخَافُ

479
00:44:29,701 --> 00:44:30,077
مِنْهَا إِذْ صَارَتْ أَعْظَمَ أَعْوَانِهِ وَخَدَمِهِ،

480
00:44:29,701 --> 00:44:30,077
وَهَذَا أَمْرٌ لَا يَعْرِفُهُ إِلَّا

481
00:44:37,968 --> 00:44:38,720
مَنْ دَخَلَ بِهِ.

482
00:44:38,344 --> 00:44:41,495
وَأَمَّا مَرْكَبُهُ فَالصِّدْقُ وَاللَّجَاءُ إِلَى اللَّهِ

483
00:44:41,495 --> 00:44:42,049
وَالِانْفِضَاعُ إِلَيْهِ بِكُلِّيَّتِهِ وَتَحْقِيقُ الِافْتِقَارِ إِلَيْهِ

484
00:44:48,708 --> 00:44:49,818
مِنْ كُلِّ وَجْهٍ وَالضَّرَاعَةُ إِلَيْهِ وَصِدْقُ التَّوَكُّلِ عَلَيْهِ وَالِاسْتِعَانَةُ بِهِ

485
00:44:49,263 --> 00:44:49,818
وَالِانْطِرَاحُ

486
00:45:00,916 --> 00:45:02,026
مِنْ أَيْدِيهِ كَالْأَنِيَّةِ الَّذِي

487
00:45:18,901 --> 00:45:19,884
لَا شَيْءَ بِهِ يَتَطَلَّعُ إِلَى قَيِّمِهِ وَوَلِيِّهِ أَنْ يَجْبُرَهُ وَيَلُمَّ

488
00:45:19,392 --> 00:45:19,884
شَعْثَهُ وَيَمُدَّهُ

489
00:45:36,594 --> 00:45:37,577
مِنْ فَضْلِهِ وَيَسْتُرَهُ،

490
00:45:37,086 --> 00:45:37,577
فَهَذَا الَّذِي يُرْجَى لَهُ أَنْ يَتَوَلَّى اللَّهُ هِدَايَتَهُ وَأَنْ يَكْشِفَ

491
00:45:37,086 --> 00:45:37,577
لَهُ

492
00:45:44,821 --> 00:45:45,603
مَا خَفِيَ

493
00:45:47,951 --> 00:45:48,734
عَلَى غَيْرِهِ

494
00:45:51,864 --> 00:45:52,647
مِنْ طَرِيقِ هَذِهِ الْهِجْرَةِ وَمَنَازِلِهَا.

495
00:45:57,192 --> 00:45:58,455
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: فَصْلٌ: وَرَأْسُ مَالِ الْأَمْرِ وَعَمُودُهُ فِي

496
00:45:57,823 --> 00:45:58,455
ذَلِكَ إِنَّمَا هُوَ دَوَامُ التَّفَكُّرِ وَتَدَبُّرِ آيَاتِ الْقُرْآنِ بِحَيْثُ يَسْتَفْكِرُ

497
00:45:57,823 --> 00:45:59,718
فِي أَيْدِيهِ كَالْأَنِيَّةِ وَالَّذِي عَلَى الْفِكْرِ وَيَشْغَلُ مِنْ قَلْبِهِ،

498
00:45:59,086 --> 00:46:01,613
فَإِذَا صَارَتْ مَعَانِي الْقُرْآنِ مَكَانَ الْخَوَاطِرِ مِنْ قَلْبِهِ

499
00:46:27,811 --> 00:46:28,353
وَهِيَ الْغَالِبَةُ عَلَيْهِ بِحَيْثُ يَصِيرُ إِلَيْهَا مَفْزَعُهُ وَمَلْجَؤُهُ تَمَكَّنَ حِينَئِذٍ

500
00:46:28,082 --> 00:46:28,353
الْإِيمَانُ

501
00:46:41,543 --> 00:46:42,418
مِنْ قَلْبِهِ وَجَلَسَ عَلَى كُرْسِيِّهِ وَصَارَ

502
00:46:48,630 --> 00:46:49,530
لَهُ تَصَرُّفٌ وَصَارَ وَالْأَمْرُ الْمُطَاعُ أَمْرُهُ،

503
00:46:49,080 --> 00:46:49,530
فَحِينَئِذٍ يَسْتَقِيمُ لَهُ سَيْرُهُ وَيَتَّضِحُ لَهُ الطَّرِيقُ وَتَرَاهُ سَاكِنًا وَهُوَ

504
00:46:49,080 --> 00:46:49,530
يُبَارِي الرِّيحَ وَتَرَى الْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِيَ تَمُرُّ مَرَّ السَّحَابِ.

505
00:46:49,080 --> 00:46:50,880
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَرَحِمَهُ اللَّهُ تَعَالَى مِنْ تَغْيِيرِ مَا

506
00:46:50,880 --> 00:46:54,030
سَبَقَ مِنْ مُقْتَصَرِ التَّعَاوُنِ عَلَى الْبِرِّ وَالتَّقْوَى وَبَيَانِ.

507
00:46:53,580 --> 00:46:54,030
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: جَلَالَةُ الْهِجْرَةِ إِلَى اللَّهِ وَإِلَى رَسُولِهِ

508
00:46:53,580 --> 00:46:54,030
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

509
00:46:53,580 --> 00:46:54,030
بَيَّنَّا

510
00:46:56,813 --> 00:46:57,480
أَنَّ الْمَقْصُودَ بِمَا سَلَفَ

511
00:47:02,168 --> 00:47:02,855
أَنَّ

512
00:47:24,480 --> 00:47:25,147
مِنْ أَعْظَمِ التَّعَاوُنِ عَلَى الْبِرِّ وَالتَّقْوَى التَّعَاوُنَ عَلَى سَفَرِ الْهِجْرَةِ

513
00:47:24,813 --> 00:47:26,813
إِلَى اللَّهِ وَإِلَى رَسُولِهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْيَدِ وَاللِّسَانِ

514
00:47:26,480 --> 00:47:26,813
وَالْقَلْبِ مُسَاعَدَةً وَنُصْرَةً وَتَعْلِيمًا وَإِرْشَادًا وَمَوَدَّةً،

515
00:47:26,480 --> 00:47:28,147
فَمَنْ أَعْمَلَ نَفْسَهُ فِي هَذَا الْمَقْصَدِ وَحَمَلَ عَلَى خَيْلِهِ وَرَجِلِهِ

516
00:47:27,813 --> 00:47:29,147
طَلَبًا لِإِصْلَاحِ النَّاسِ مُتَعَاوِنًا مَعَهُمْ عَلَى الْبِرِّ وَالتَّقْوَى فِي تَحْرِيكِ

517
00:47:28,924 --> 00:47:29,147
جُمُوعِهِمْ إِلَى هِجْرَةِ قُلُوبِهِمْ إِلَى اللَّهِ وَرَسُولِهِ صَلَّى اللَّهُ عَلَيْهِ

518
00:47:28,924 --> 00:47:30,036
وَسَلَّمَ؛ فَذَلِكَ مِنْ أَعْظَمِ النَّصِيحَةِ لَهُمْ وَالْبِرِّ بِهِمْ،

519
00:47:29,813 --> 00:47:30,036
وَمَنْ كَانَ هَكَذَا مَعَ عِبَادِ اللَّهِ كَانَ اللَّهُ بِكُلِّ خَيْرٍ

520
00:47:29,813 --> 00:47:30,036
إِلَيْهِ أَسْرَعَ،

521
00:47:29,813 --> 00:47:30,036
وَأَقْبَلَ اللَّهُ إِلَيْهِ بِقُلُوبِ عِبَادِهِ؛ فَإِنَّهُ

522
00:47:49,291 --> 00:47:50,210
عَلَى قَدْرِ تَصْفِيَةِ الْأَعْمَالِ،

523
00:47:49,750 --> 00:47:51,588
قَالَهُ [أَبُو الْفَرَجِ ابْنُ الْجَوْزِيِّ] فِي [صَيْدِ الْخَاطِرِ].

524
00:47:51,129 --> 00:47:51,588
فَمَنْ صَفَتْ أَعْمَالُهُ

525
00:48:08,409 --> 00:48:09,694
فِي صِدْقِ طِلَابِهِ وَصِحَّةِ مَقْصُودِهِ مُتَعَاوِنًا عَلَى الْبِرِّ وَالتَّقْوَى مَعَ

526
00:48:09,051 --> 00:48:12,266
الْخَلْقِ فِي

527
00:48:12,266 --> 00:48:12,909
حَمْلِهِمْ

528
00:48:40,920 --> 00:48:41,960
عَلَى الْهِجْرَةِ إِلَى

529
00:48:51,320 --> 00:48:52,360
اللَّهِ وَرَسُولِهِ صَلَّى

530
00:49:02,641 --> 00:49:03,803
اللَّهُ عَلَيْهِ وَسَلَّمَ حَصَلَ هَذَا الْخَيْرُ،

531
00:49:03,222 --> 00:49:03,803
وَفَتَحَ اللَّهُ عَلَى قَلْبِهِ أَبْوَابَ الْعِلْمِ وَيَسَّرَهُ لِلْيُسْرَى،

532
00:49:03,222 --> 00:49:03,803
وَمَنْ كَانَ بِالضِّدِّ فَالضِّدُّ،

533
00:49:03,222 --> 00:49:03,803
﴿وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ﴾.

534
00:49:03,222 --> 00:49:04,383
ثُمَّ ذَكَرَ رَحِمَهُ اللَّهُ تَعَالَى سُؤَالًا سَائِلًا حَمَلَهُ عَلَيْهِ

535
00:49:30,446 --> 00:49:31,542
مَا انْتَهَتْ إِلَيْهِ الْحَالُ،

536
00:49:30,994 --> 00:49:34,283
وَهُوَ قَوْلُهُ: قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: فَقَدْ أَشَرْتَ إِلَى سَفَرٍ

537
00:49:37,580 --> 00:49:38,680
عَظِيمٍ وَأَمْرٍ جَسِيمٍ،

538
00:49:38,130 --> 00:49:38,680
فَمَا زَادُ هَذَا السَّفَرِ؟

539
00:49:38,130 --> 00:49:38,680
وَمَا طَرِيقُهُ؟

540
00:49:38,130 --> 00:49:38,680
وَمَا مَرْكَبُهُ؟

541
00:49:38,130 --> 00:49:38,680
قَالَ الشَّارِحُ هَدَاهُ

542
00:49:48,580 --> 00:49:49,680
اللَّهُ: ثُمَّ أَجَابَ

543
00:49:53,530 --> 00:49:54,630
عَنْهُ مُبَيِّنًا زَادَهُ وَطَرِيقَهُ وَمَرْكَبَهُ،

544
00:49:54,080 --> 00:49:54,630
فَقَالَ

545
00:50:13,735 --> 00:50:14,718
فِي الْأَوَّلِ:

546
00:50:21,599 --> 00:50:22,090
قَالَ

547
00:50:37,046 --> 00:50:39,266
الْمُصَنِّفُ حَفِظَهُ اللَّهُ: قُلْتُ: زَادُهُ الْعِلْمُ الْمَوْرُوثُ عَنْ خَاتَمِ الْأَنْبِيَاءِ

548
00:50:38,711 --> 00:50:39,266
صَلَّى

549
00:50:50,370 --> 00:50:51,480
اللَّهُ عَلَيْهِ وَسَلَّمَ.

550
00:50:50,925 --> 00:50:51,480
قَالَ الشَّارِحُ هَدَاهُ

551
00:51:15,093 --> 00:51:16,391
اللَّهُ: فَالزَّادُ الْكَامِلُ النَّافِعُ

552
00:51:35,836 --> 00:51:37,111
فِي الْهِجْرَةِ بِالْقُلُوبِ

553
00:52:00,713 --> 00:52:03,902
إِلَى اللَّهِ وَرَسُولِهِ صَلَّى

554
00:52:11,913 --> 00:52:12,963
اللَّهُ عَلَيْهِ وَسَلَّمَ هُوَ الْعِلْمُ الَّذِي جَاءَ بِهِ النَّبِيُّ صَلَّى

555
00:52:24,659 --> 00:52:25,893
اللَّهُ عَلَيْهِ وَسَلَّمَ،

556
00:52:25,276 --> 00:52:25,893
وَمَنْ لَمْ يُحَصِّلْ

557
00:52:43,693 --> 00:52:44,302
لَهُ

558
00:52:57,331 --> 00:52:58,513
هَذَا الزَّادَ فَلَا يَخْرُجْ مِنْ بَيْتِهِ وَلْيَقْعُدْ مَعَ الْقَاعِدِينَ،

559
00:52:57,922 --> 00:52:58,513
فَرُفَقَاءُ التَّخَلُّفِ الْبَطَّالُونَ أَكْثَرُ مِنْ

560
00:53:06,660 --> 00:53:08,028
أَنْ يُحْصَوْا،

561
00:53:07,344 --> 00:53:08,028
فَلَهُ أُسْوَةٌ بِهِمْ.

562
00:53:07,344 --> 00:53:08,028
وَأَمَّا

563
00:53:33,200 --> 00:53:34,141
مَنْ كَانَ زَادُهُ الْعِلْمَ الْمَوْرُوثَ عَنِ النَّبِيِّ صَلَّى اللَّهُ

564
00:53:39,788 --> 00:53:40,729
عَلَيْهِ وَسَلَّمَ فَإِنَّهُ لَا يَزَالُ يَتَقَلَّبُ

565
00:53:48,738 --> 00:53:49,815
بَيْنَ نَعِيمٍ وَنَعِيمٍ،

566
00:53:49,277 --> 00:53:49,815
وَخَيْرٍ وَخَيْرٍ،

567
00:53:49,277 --> 00:53:49,815
وَفَضْلٍ وَفَضْلٍ.

568
00:53:49,277 --> 00:53:49,815
ذِهْنُهُ فِي الْعِلْمِ الْمَوْرُوثِ عَنِ النَّبِيِّ صَلَّى اللَّهُ

569
00:53:56,738 --> 00:53:58,277
عَلَيْهِ وَسَلَّمَ وَجَدَ

570
00:54:26,318 --> 00:54:27,435
فِيهِ شَيْئًا عَظِيمًا،

571
00:54:26,876 --> 00:54:27,435
تَضِيقُ الْأَوْقَاتُ عَنْ جَمْعِهِ،

572
00:54:26,876 --> 00:54:27,435
وَتَكِلُّ الْأَذْهَانُ عَنِ اسْتِظْهَارِهِ،

573
00:54:26,876 --> 00:54:27,435
وَلَكِنْ

574
00:54:31,906 --> 00:54:33,023
مَنْ صَدَقَ مَعَ اللَّهِ عَزَّ وَجَلَّ فَتَحَ اللَّهُ عَزَّ وَجَلَّ

575
00:54:32,464 --> 00:54:33,023
لَهُ أَنْوَاعَ الْفُتُوحَاتِ.

576
00:54:32,464 --> 00:54:33,023
وَمِنْ دَلَائِلِ ذَلِكَ مَا ذَكَرَهُ [ابْنُ الْعَرَبِيِّ] فِي كِتَابِهِ [أَحْكَامِ

577
00:54:32,464 --> 00:54:33,023
الْقُرْآنِ]

578
00:54:39,170 --> 00:54:39,729
أَنَّهُ

579
00:55:02,460 --> 00:55:03,625
هُوَ وَجَمَاعَةٌ

580
00:55:20,980 --> 00:55:23,860
مِنْ أَصْحَابِهِ مِنَ الْمَالِكِيَّةِ تَذَاكَرُوا

581
00:55:30,197 --> 00:55:31,350
فِي بَغْدَادَ آيَةَ الطَّهَارَةِ،

582
00:55:30,773 --> 00:55:31,350
فَاسْتَنْبَطَ مِنْهَا أَكْثَرَ

583
00:55:52,669 --> 00:55:53,763
مِنْ خَمْسِينَ وَثَمَانِمِائَةِ حُكْمٍ.

584
00:55:53,216 --> 00:55:53,763
وَذَكَرَ [ابْنُ حَجَرٍ]

585
00:56:02,518 --> 00:56:05,802
فِي [فَتْحِ الْبَارِي] أَنَّ

586
00:56:05,802 --> 00:56:06,349
[ابْنَ الْمُنْذِرِ] رَحِمَهُ اللَّهُ

587
00:56:19,440 --> 00:56:20,440
تَعَالَى اسْتَخْرَجَ

588
00:56:23,254 --> 00:56:24,363
مِنْ حَدِيثِ صِفَةِ حَجِّ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

589
00:56:35,459 --> 00:56:36,568
مِنْ حَدِيثِ [جَابِرٍ] أَكْثَرَ

590
00:56:48,325 --> 00:56:49,335
مِنْ أَلْفِ فَائِدَةٍ.

591
00:56:48,830 --> 00:56:49,335
فَزَادُ الْقُلُوبِ

592
00:56:53,135 --> 00:56:54,454
فِي الْعِلْمِ الْمَوْرُوثِ عَنِ النَّبِيِّ صَلَّى اللَّهُ

593
00:56:58,408 --> 00:56:59,726
عَلَيْهِ وَسَلَّمَ أَعْظَمُ مِنْ كُلِّ زَادٍ سِوَاهُ،

594
00:56:59,067 --> 00:56:59,726
وَمَنْ عَدَلَ عَنْهُ

595
00:57:06,976 --> 00:57:08,295
إِلَى غَيْرِهِ فَإِنَّهُ لَا يُحَصِّلُ شَيْئًا،

596
00:57:07,635 --> 00:57:08,295
وَسَيَنْدَمُ عَلَى فَعْلَتِهِ الَّتِي فَعَلَ،

597
00:57:07,635 --> 00:57:08,295
وَلَنْ يَجِدَ لَهُ مَنْ يُوَاسِيهِ عَلَيْهَا؛ لِأَنَّهُ ذَهَبَ وَقْتُ الْمُوَاسَاةِ.

598
00:57:07,635 --> 00:57:08,295
وَرُبَّمَا كَانَ

599
00:57:17,522 --> 00:57:18,840
فِي حَالِ النَّاسِ

600
00:57:26,280 --> 00:57:27,444
فِي الدُّنْيَا مُسَلَّاةٌ يُخَفِّفُ بِهَا بَعْضُهُمْ عَنْ بَعْضٍ أَثَرَ الْآلَامِ،

601
00:57:26,862 --> 00:57:27,444
وَأَمَّا

602
00:57:49,081 --> 00:57:50,296
فِي الْآخِرَةِ فَلَا مُسَلَّاةَ لِأَهْلِهَا،

603
00:57:49,689 --> 00:57:50,296
فَالْأَمْرُ كَمَا قَالَ

604
00:58:01,224 --> 00:58:03,046
[ابْنُ الْقَيِّمِ]: [فَهَذَا الرَّوْحُ الْحَاصِلُ -يَعْنِي الْفَرَجَ بَعْدَ الشِّدَّةِ- الْحَاصِلُ

605
00:58:11,879 --> 00:58:14,260
مِنَ التَّأَسِّي مَعْدُومٌ بَيْنَ الْمُسْتَرِخِينَ فِي الْعَذَابِ يَوْمَ الْقِيَامَةِ؛ لِأَنَّ

606
00:58:13,784 --> 00:58:14,260
انْتِفَاعَهُمْ بِذَلِكَ مُسَلَّاةً كَانَ

607
00:58:18,805 --> 00:58:20,351
فِي الدُّنْيَا،

608
00:58:19,578 --> 00:58:20,351
وَأَمَّا

609
00:58:43,380 --> 00:58:44,340
فِي الْآخِرَةِ فَلَا مَحَلَّ لِذَلِكَ].

610
00:58:56,260 --> 00:58:58,419
ثُمَّ بَيَّنَ طَرِيقَهُ فِي قَوْلِهِ: قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَأَمَّا

611
00:58:57,987 --> 00:58:58,419
طَرِيقُهُ فَهُوَ بَذْلُ الْجُهْدِ وَاسْتِفْرَاغُ الْوُسْعِ.

612
00:58:57,987 --> 00:58:58,419
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: فَلَنْ يُنَالَ بِالْمُنَى،

613
00:58:57,987 --> 00:58:58,419
وَلَنْ يُدْرَكَ بِالْهُوَيْنَى،

614
00:58:57,987 --> 00:58:58,419
وَإِنَّمَا كَمَا قِيلَ: [فَخُذْ غَمَرَاتِ الْمَوْتِ وَاسْمُ إِلَى الْعُلَا ...

615
00:58:57,987 --> 00:58:58,419
لِكَيْ تُدْرِكَ الْعِزَّةَ الرَّفِيعَةَ الدَّعَائِمِ] [فَلَا خَيْرَ فِي نَفْسٍ تَخَافُ

616
00:59:01,874 --> 00:59:02,737
مِنَ الرَّدَى ...

617
00:59:02,305 --> 00:59:02,737
وَلَا هِمَّةٍ تَصْبُو إِلَى دَوْمِ لَائِمِ]

618
00:59:15,260 --> 00:59:15,873
وَفِي

619
00:59:38,173 --> 00:59:38,608
ذَلِكَ

620
00:59:41,651 --> 00:59:42,521
قَالَ أَيْضًا بَعْضُ الشُّعَرَاءِ: [لَوْلَا الْمَشَقَّةُ سَادَ النَّاسُ كُلُّهُمْ ...

621
00:59:42,086 --> 00:59:42,521
الْجُودُ يُفْقِرُ وَالْإِقْدَامُ قَتَّالُ] فَإِذَا لَمْ يَكُنِ الْإِنْسَانُ مُتَحَمِّلًا لِلْمَشَاقِّ،

622
00:59:42,086 --> 00:59:42,521
حَامِلًا

623
00:59:49,093 --> 00:59:50,189
عَلَى نَفْسِهِ

624
01:00:15,850 --> 01:00:17,029
فِي طَلَبِ الْمَعَالِي؛ فَإِنَّهُ

625
01:00:39,038 --> 01:00:40,593
لَا يُمْكِنُ لَهُ رُكُوبُ

626
01:00:42,149 --> 01:00:43,704
هَذَا الطَّرِيقِ.

627
01:00:42,927 --> 01:00:46,337
ثُمَّ ذَكَرَ الْمُصَنِّفُ أَنَّهُ لَا

628
01:00:46,337 --> 01:00:46,875
سَبِيلَ إِلَى رُكُوبِ هَذَا الظَّهْرِ وَلُزُومِ ذَلِكَ إِلَّا بِأَمْرَيْنِ: -

629
01:00:46,337 --> 01:00:46,875
أَحَدُهُمَا: أَلَّا يَصُبَّ فِي الْحَقِّ إِلَى لَوْمَةِ لَائِمٍ،

630
01:00:46,337 --> 01:00:46,875
أَيْ أَلَّا يَلْتَفِتَ إِلَى لَوْمَةِ لَائِمٍ يَلُومُهُ عَلَى أَمْرِهِ

631
01:00:50,645 --> 01:01:01,414
الَّذِي هُوَ بِهِ.

632
01:01:00,875 --> 01:01:01,952
- وَالثَّانِي: أَنْ تَهُونَ

633
01:01:11,645 --> 01:01:12,183
عَلَيْهِ

634
01:01:14,865 --> 01:01:15,400
نَفْسُهُ

635
01:01:33,051 --> 01:01:34,120
فِي اللَّهِ عَزَّ وَجَلَّ،

636
01:01:33,586 --> 01:01:34,120
فَيُقْدِمَ حِينَئِذٍ وَلَا يَخَافَ الْأَهْوَالَ،

637
01:01:33,586 --> 01:01:34,120
فَهُوَ لَا يَطْلُبُ لِنَفْسِهِ شَيْئًا،

638
01:01:33,586 --> 01:01:34,120
وَلَا يَلْتَمِسُ

639
01:01:41,554 --> 01:01:42,260
مِنْ أَحَدٍ

640
01:02:04,563 --> 01:02:05,593
مِنَ الْخَلْقِ إِلَيْهَا إِحْسَانًا.

641
01:02:05,078 --> 01:02:05,593
ثُمَّ ذَكَرَ أَنَّ هَذَيْنِ

642
01:02:31,515 --> 01:02:32,707
الْأَمْرَيْنِ لَا يَتِمَّانِ إِلَّا بِالصَّبْرِ،

643
01:02:32,111 --> 01:02:32,707
فَمَنْ صَبَرَ قَلِيلًا صَارَتْ تِلْكَ الْأَهْوَالُ رِيحًا رُخَاءً فِي حَقِّهِ

644
01:02:32,111 --> 01:02:32,707
تَحْمِلُهُ بِنَفْسِهَا إِلَى مَطْلُوبِهِ؛ لِأَنَّ الصَّبْرَ مِنْ أَعْظَمِ الْمَعُونَةِ لِلْعَبْدِ

645
01:02:32,111 --> 01:02:32,707
فِي إِحْرَازِ مَأْمُولِهِ،

646
01:02:32,111 --> 01:02:32,707
وَالْقُرْآنُ وَالسُّنَّةُ طَافِحَانِ بِالدَّلَائِلِ الْمُبَيِّنَةِ مَقَامَ الصَّبْرِ وَعِظَمَ شَأْنِهِ.

647
01:02:33,898 --> 01:02:35,686
ثُمَّ ذَكَرَ مَرْكَبَهُ بِقَوْلِهِ: قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَأَمَّا مَرْكَبُهُ

648
01:02:35,090 --> 01:02:35,686
فَصِدْقُ اللَّجَإِ إِلَى اللَّهِ،

649
01:02:35,090 --> 01:02:35,686
وَالِانْطِرَاحُ بَيْنَ يَدَيْهِ فِي كُلِّيَّتِهِ،

650
01:02:35,090 --> 01:02:35,686
وَتَحْقِيقُ الِافْتِقَارِ إِلَيْهِ مِنْ كُلِّ وَجْهٍ،

651
01:02:35,090 --> 01:02:35,686
وَالضَّرَاعَةُ إِلَيْهِ،

652
01:02:35,090 --> 01:02:35,686
وَصِدْقُ التَّوَكُّلِ عَلَيْهِ،

653
01:02:35,090 --> 01:02:35,686
وَالِاسْتِعَانَةُ بِهِ،

654
01:02:35,090 --> 01:02:35,686
وَالِانْطِرَاحُ بَيْنَ يَدَيْهِ.

655
01:02:36,877 --> 01:02:38,069
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَيَجْمَعُ ذَلِكَ

656
01:02:59,003 --> 01:03:00,227
مَا أَخْبَرَ

657
01:03:12,957 --> 01:03:13,523
اللَّهُ

658
01:03:19,179 --> 01:03:20,876
عَزَّ وَجَلَّ بِهِ

659
01:03:24,836 --> 01:03:25,967
مِنْ حَالِ النَّاسِ إِذْ قَالَ

660
01:03:43,481 --> 01:03:44,591
اللَّهُ عَزَّ وَجَلَّ: ﴿يَا أَيُّهَا النَّاسُ أَنْتُمُ الْفُقَرَاءُ إِلَى

661
01:03:46,812 --> 01:03:47,922
اللَّهِ وَاللَّهُ هُوَ الْغَنِيُّ الْحَمِيدُ﴾،

662
01:03:47,367 --> 01:03:47,922
وَفِي ذَلِكَ قَالَ نَبِيُّ

663
01:04:00,691 --> 01:04:01,802
اللَّهِ مُوسَى: ﴿رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ

664
01:04:09,574 --> 01:04:10,685
مِنْ خَيْرٍ فَقِيرٌ﴾.

665
01:04:10,130 --> 01:04:10,685
فَالْمَرْكَبُ الَّذِي يَنْبَغِي

666
01:04:16,057 --> 01:04:17,256
أَنْ يَكُونَ عَلَيْهِ الْإِنْسَانُ هُوَ الِافْتِقَارُ إِلَى رَبِّهِ

667
01:04:30,447 --> 01:04:31,646
سُبْحَانَهُ وَتَعَالَى

668
01:04:45,372 --> 01:04:46,404
فِي جَمِيعِ أَحْوَالِهِ.

669
01:05:04,480 --> 01:05:07,239
ثُمَّ بَيَّنَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ تَعَالَى رَأْسَ مَالِ الْأَمْرِ وَعَمُودَهُ

670
01:05:09,209 --> 01:05:09,998
فِي ذَلِكَ،

671
01:05:09,604 --> 01:05:09,998
أَيْ جِمَاعَهُ

