1
00:00:04,980 --> 00:00:07,980
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

2
00:00:07,980 --> 00:00:09,230
الْحَمْدُ لِلَّهِ رَبِّنَا،

3
00:00:09,230 --> 00:00:12,980
وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

4
00:00:12,980 --> 00:00:15,980
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

5
00:00:15,980 --> 00:00:19,380
أَمَّا بَعْدُ: فَهَذَا شَرْحُ الْكِتَابِ

6
00:00:19,380 --> 00:00:22,580
الْأَوَّلِ مِنْ بَرْنَامَجِ [عُدَّةِ

7
00:00:22,580 --> 00:00:24,980
رَمَضَانَ] بِسَنَتِهِ الْأُولَى،

8
00:00:24,980 --> 00:00:27,707
فَالْكِتَابُ الْمَقْرُوءُ فِيهِ

9
00:00:27,707 --> 00:00:30,435
[بُغْيَةُ الصَّائِمِ] مِنْ

10
00:00:30,435 --> 00:00:33,162
صَنِيفِهِ مُحَمَّدِ سَلَامَةِ

11
00:00:33,162 --> 00:00:34,980
مُحَمَّدِ هِلَالٍ،

12
00:00:34,980 --> 00:00:38,313
وَقَبْلَ الشُّرُوعِ فِي إِقْرَائِهِ فَلَا بُدَّ مِنَ

13
00:00:38,313 --> 00:00:39,980
التَّقْدِمَةِ بِمُقَدِّمَتَيْنِ اثْنَتَيْنِ.

14
00:00:39,980 --> 00:00:41,647
الْمُقَدِّمَةُ الْأُولَى:

15
00:01:03,480 --> 00:01:04,480
فِي بَيَانِ السَّبَبِ الْمُوجِبِ لِإِقْرَائِهِ،

16
00:01:03,980 --> 00:01:04,480
وَحَاصِلُ مَا يَتَلَخَّصُ فِيمَا يَتَعَلَّقُ بِالْمُوجِبِ لِإِقْرَاءِ هَذَا الْكِتَابِ هُوَ

17
00:01:03,980 --> 00:01:06,980
تَحْقِيقُ ثَلَاثَةِ مَقَاصِدَ عُظْمَى: الْمَقْصِدُ الْأَوَّلُ: تَحْقِيقُ الْعِلْمِ الْوَاجِبِ الْمُتَعَلِّقِ

18
00:01:06,480 --> 00:01:09,855
بِالصِّيَامِ، فَإِنَّ الَّذِي تَقَرَّرَ غَيْرَ مَرَّةٍ

19
00:01:22,580 --> 00:01:23,780
فِي الدُّرُوسِ الْمُتَقَدِّمَةِ أَنَّ

20
00:01:27,380 --> 00:01:28,647
الْعِلْمَ الْوَاجِبَ لَهُ حَدٌّ يَحُدُّهُ،

21
00:01:27,980 --> 00:01:28,647
وَهُوَ الَّذِي ذَكَرَهُ جَمَاعَةٌ

22
00:01:43,605 --> 00:01:44,980
مِنْ كِبَارِ الْعُلَمَاءِ بِقَوْلِهِمْ:

23
00:02:15,618 --> 00:02:50,913
[أَنَّ كُلَّ مَا وَجَبَ الْعَمَلُ بِهِ وَجَبَ تَقَدُّمُ الْعِلْمِ عَلَيْهِ]،

24
00:02:50,913 --> 00:02:51,702
ذَكَرَهُ ابْنُ الْقَيِّمِ رَحِمَهُ اللَّهُ تَعَالَى

25
00:02:57,000 --> 00:02:57,973
فِي [مِفْتَاحِ دَارِ السَّعَادَةِ]،

26
00:02:57,487 --> 00:02:57,973
وَالْآجُرِّيُّ

27
00:03:04,320 --> 00:03:05,787
فِي [فَرْضِ طَلَبِ الْعِلْمِ]،

28
00:03:05,053 --> 00:03:05,787
وَالْقَرَافِيُّ

29
00:03:15,716 --> 00:03:16,807
فِي [الْفُرُوقِ]،

30
00:03:16,262 --> 00:03:19,535
وَمُحَمَّدُ حُسَيْنِ الْمَكِّيُّ فِي [تَهْذِيبِ الْفُرُوقِ]،

31
00:03:18,989 --> 00:03:19,535
فَمِمَّا يَجِبُ

32
00:03:24,712 --> 00:03:25,869
عَلَى أَحَدِنَا تَعَلُّمُهُ مَا يَحْتَاجُ إِلَيْهِ

33
00:03:44,863 --> 00:03:45,819
فِي فِقْهِ الصِّيَامِ وَمَا

34
00:04:01,858 --> 00:04:02,636
يَتَعَلَّقُ

35
00:04:30,247 --> 00:04:31,080
بِهِ

36
00:04:36,969 --> 00:04:38,080
مِنَ الْأَحْوَالِ.

37
00:04:37,524 --> 00:04:38,080
الْمَقْصِدُ

38
00:05:01,969 --> 00:05:03,747
الثَّانِي: تَرْسِيخُ

39
00:05:13,080 --> 00:05:13,580
الْعِلْمِ

40
00:05:42,794 --> 00:05:44,509
فِي الْقَلْبِ،

41
00:05:43,651 --> 00:05:44,509
وَإِنَّ

42
00:06:07,433 --> 00:06:09,551
مِمَّا يَتَرَسَّخُ بِهِ الْعِلْمُ فِي الْقَلْبِ الْإِقْبَالُ

43
00:06:27,680 --> 00:06:30,080
عَلَى مَا يُحْتَاجُ

44
00:06:38,480 --> 00:06:39,680
إِلَى تَعَلُّمِهِ رِعَايَةً لِفِقْهِ الْمُنَاسَبَاتِ،

45
00:06:39,080 --> 00:06:39,680
فَإِذَا أَصَابَ

46
00:07:03,280 --> 00:07:04,480
الْعَبْدُ مُنَاسَبَةً

47
00:07:20,580 --> 00:07:21,580
مِنْ مُنَاسَبَاتِ الْعِبَادَةِ لِلَّهِ عَزَّ وَجَلَّ كَانَ

48
00:07:39,651 --> 00:07:43,080
مِمَّا يُرَسِّخُ الْعِلْمَ الْمُتَعَلِّقَ بِهَذِهِ الْمُنَاسَبَةِ

49
00:07:44,223 --> 00:07:45,366
فِي قَلْبِهِ

50
00:07:53,830 --> 00:07:54,330
أَنْ يُرَاجِعَهُ عَلَى وَجْهِ التَّلَقِّي لَهُ اسْتِشْرَاحًا لِمَتْنٍ

51
00:08:01,747 --> 00:08:05,080
أَوْ نَحْوِ ذَلِكَ

52
00:08:05,080 --> 00:08:05,695
مِمَّا يَنْفَعُهُ

53
00:08:24,392 --> 00:08:25,705
فِي تَلَقِّيهِ.

54
00:08:25,049 --> 00:08:25,705
الْمَقْصِدُ الثَّالِثُ: بَذْلُ الْعَوْنِ بِتَهْيِئَةِ النَّفْسِ لِاسْتِقْبَالِ رَمَضَانَ،

55
00:08:25,049 --> 00:08:25,705
فَإِنَّ الْعَبْدَ إِذَا آنَسَ مِنْ نَفْسِهِ عِلْمًا وَعَمَلًا وَتَعْلِيمًا لِأَحْكَامِ

56
00:08:25,049 --> 00:08:25,705
الصِّيَامِ وَمَا يَتَعَلَّقُ بِهَا مِنَ الْأَحْوَالِ مِمَّا يَكُونُ

57
00:08:31,611 --> 00:08:32,924
فِي رَمَضَانَ مُتَقَدِّمًا عَلَيْهِ بِمُدَّةٍ وَلَوْ يَسِيرَةً أَمْكَنَ لَهُ

58
00:08:36,205 --> 00:08:37,518
أَنْ يُوقِعَ هَذِهِ الْأَحْكَامَ

59
00:08:47,374 --> 00:08:48,198
فِي رَمَضَانَ

60
00:09:05,914 --> 00:09:08,596
عَلَى الْوَجْهِ الْمَحْمُودِ شَرْعًا،

61
00:09:07,702 --> 00:09:08,596
أَمَّا

62
00:09:40,508 --> 00:09:41,584
أَنْ تُلْقَى إِلَيْهِ هَذِهِ الْأَحْكَامُ

63
00:10:28,459 --> 00:10:29,232
فِي أَوَّلِ رَمَضَانَ أَوْ أَلَّا تُلْقَى إِلَيْهَا بِمُدَّةٍ أَوَّلَ رَمَضَانَ

64
00:10:28,845 --> 00:10:29,232
بَلْ يَعْتَمِدُ فِيهَا

65
00:10:50,690 --> 00:10:52,690
عَلَى مَا سَبَقَ تَلَقِّيهِ

66
00:11:02,370 --> 00:11:04,370
مِنَ الْعُلُومِ فَهَذَا يُوقِعُ

67
00:11:29,832 --> 00:11:31,062
الْعَبْدَ فِي حَالٍ مِنَ الضَّعْفِ وَالْهَوَانِ فِي ابْتِدَاءِ عِبَادَتِهِ،

68
00:11:30,447 --> 00:11:31,062
فَإِنَّهُ يَجِدُ مِنْ نَفْسِهِ حَالَ وَحْشَةٍ فِي إِقْبَالِهِ

69
00:12:00,503 --> 00:12:01,970
عَلَى شَهْرِ رَمَضَانَ بِشَيْءٍ لَمْ يَكُنْ عِنْدَهُ مُنْذُ بِضْعِ أَيَّامٍ

70
00:12:01,237 --> 00:12:04,170
يَسِيرَةٍ، وَهَذِهِ حَالٌ لَا تُنَاسِبُ مَقَامَ صِيَامِ رَمَضَانَ وَمَا يَتَعَلَّقُ

71
00:12:04,170 --> 00:12:04,903
بِهِ

72
00:12:28,447 --> 00:12:30,139
مِنَ الْأَحْكَامِ،

73
00:12:29,293 --> 00:12:30,139
فَإِنَّهُ رُكْنٌ عَظِيمٌ مِنْ أَرْكَانِ الدِّينِ يَنْبَغِي

74
00:12:55,825 --> 00:12:57,461
لِلْعَبْدِ أَنْ يَسْعَى

75
00:13:21,870 --> 00:13:22,870
فِي تَهْيِئَةِ نَفْسِهِ لَهُ لِيُؤَدِّيَهُ عَلَى الْوَجْهِ الْأَكْمَلِ فِيمَا يَرْضَاهُ

76
00:13:22,370 --> 00:13:22,870
رَبُّهُ

77
00:13:30,814 --> 00:13:32,370
عَزَّ وَجَلَّ،

78
00:13:32,370 --> 00:13:32,870
وَتَحْقِيقًا لِهَذِهِ الْمَقَاصِدِ الثَّلَاثَةِ رُمْتُ

79
00:13:49,259 --> 00:13:50,370
إِلَى بَيَانِ أَحْكَامِ هَذَا الشَّهْرِ

80
00:13:59,370 --> 00:14:00,870
فِي جُمْلَةٍ مِنَ الْمُتُونِ النَّافِعَةِ

81
00:14:30,703 --> 00:14:31,814
مِمَّا يَتَعَلَّقُ بِاسْمِ

82
00:14:57,040 --> 00:14:59,040
هَذَا الْبَرْنَامَجِ

83
00:15:15,949 --> 00:15:17,585
وَهُوَ بَرْنَامَجُ [عُدَّةِ رَمَضَانَ]،

84
00:15:16,767 --> 00:15:17,585
وَمُبْتَدَأُ هَذِهِ الْمُتُونِ بِعَوْنِ اللَّهِ

85
00:15:24,940 --> 00:15:25,640
هُوَ

86
00:15:57,707 --> 00:15:59,040
هَذَا الْكِتَابُ النَّافِعُ الْمُسَمَّى [بُغْيَةَ الصَّائِمِ].

87
00:15:58,373 --> 00:15:59,040
الْمُقَدِّمَةُ الثَّانِيَةُ:

88
00:16:06,040 --> 00:16:07,707
فِي بَيَانِ صِفَةِ النَّفْعِ وَالِانْتِفَاعِ بِهَذَا الْكِتَابِ،

89
00:16:06,873 --> 00:16:07,707
وَفِيهَا مَقْصِدَانِ اثْنَانِ: الْمَقْصِدُ الْأَوَّلُ: بَيَانُ صِفَةِ الِانْتِفَاعِ بِهِ،

90
00:16:06,873 --> 00:16:07,707
وَذَلِكَ

91
00:16:26,665 --> 00:16:29,290
فِي ثَلَاثَةِ أُمُورٍ: الْأَوَّلُ: الْإِنْصَاتُ إِلَى مَا يُلْقَى

92
00:16:31,740 --> 00:16:35,940
فِي اسْتِشْرَاحِهِ مِنَ الْعِلْمِ،

93
00:16:35,240 --> 00:16:35,940
فَإِنَّ الْعَبْدَ إِذَا أُلْقِيَ إِلَيْهِ عِلْمٌ لَمْ يَجْمَعْ قَلْبَهُ عَلَيْهِ

94
00:16:35,240 --> 00:16:35,940
لَمْ يَسْتَقِرَّ

95
00:16:45,111 --> 00:16:46,397
فِي قَلْبِهِ فَلَمْ يُمْكِنْ لَهُ حِينَئِذٍ الِانْتِفَاعُ بِهِ

96
00:17:06,240 --> 00:17:08,040
عَلَى الْوَجْهِ الْأَتَمِّ،

97
00:17:37,040 --> 00:17:39,460
ثُمَّ يَفْقِدُ مِنْهُ بَعْدَ مُدَّةٍ قَدْرًا

98
00:18:14,192 --> 00:18:15,666
مِمَّا يُضْعِفُهُ عَنْ اسْتِقْبَالِ رَمَضَانَ

99
00:18:23,100 --> 00:18:24,600
عَلَى الْوَجْهِ الَّذِي قَدَّمْنَاهُ،

100
00:18:23,850 --> 00:18:24,600
وَالْأَمْرُ الثَّانِي:

101
00:18:59,950 --> 00:19:02,172
أَنْ يُرَاعِيَ تَقْيِيدَ الْفَوَائِدِ الَّتِي تُلْقَى إِلَيْهِ،

102
00:19:01,061 --> 00:19:02,172
فَإِنَّ

103
00:19:12,200 --> 00:19:13,700
هَذِهِ الْفَوَائِدَ

104
00:19:20,450 --> 00:19:21,950
مِنْ جُمْلَةِ

105
00:19:43,950 --> 00:19:45,093
مَا يَضِيعُ مِنَ

106
00:20:04,750 --> 00:20:11,341
الْعِلْمِ لِقِلَّةِ الْعِنَايَةِ بِهِ،

107
00:20:11,341 --> 00:20:12,037
فَإِنَّ ذَاكِرَةَ الْعَبْدِ مَهْمَا بَلَغَتْ

108
00:20:17,602 --> 00:20:18,993
مِنَ الْقُوَّةِ لَا يُمْكِنُ لَهَا

109
00:20:49,758 --> 00:20:50,912
أَنْ تَحْفَظَ فَوَائِدَ

110
00:21:05,335 --> 00:21:06,488
الْعِلْمِ حِفْظًا تَامًّا،

111
00:21:05,912 --> 00:21:06,488
وَإِنَّمَا

112
00:21:10,506 --> 00:21:11,617
الَّذِي يَحْفَظُ

113
00:21:21,657 --> 00:21:22,877
الْعِلْمَ تَدْوِينُهُ،

114
00:21:22,267 --> 00:21:22,877
فَيَنْبَغِي لِلسَّامِعِ وَالْمُنْصِتِ بِهَذَا

115
00:21:31,413 --> 00:21:32,633
الْعِلْمِ الْمُلْقَى

116
00:21:51,950 --> 00:22:12,521
أَنْ يَحْرِصَ عَلَى تَدْوِينِ الْفَوَائِدِ الَّتِي تُلْقَى إِلَيْهِ،

117
00:22:12,521 --> 00:22:13,236
وَجِمَاعُ

118
00:22:31,093 --> 00:22:32,521
هَذِهِ الْفَوَائِدِ أَرْبَعٌ: الْأَوَّلُ: التَّعْرِيفَاتُ،

119
00:22:31,807 --> 00:22:32,521
وَهِيَ الْمُسَمَّى

120
00:22:46,513 --> 00:22:47,888
فِي لِسَانِ الْمُتَقَدِّمِينَ بِالْحُدُودِ وَالْحَقَائِقِ،

121
00:22:47,200 --> 00:22:47,888
وَالثَّانِي: الْأَنْوَاعُ وَالتَّقَاسِيمُ،

122
00:22:47,200 --> 00:22:47,888
وَالثَّالِثُ: الْقَوَاعِدُ الْكُلِّيَّةُ،

123
00:22:47,200 --> 00:22:47,888
وَالرَّابِعُ: الضَّوَابِطُ الْفِقْهِيَّةُ،

124
00:22:47,200 --> 00:22:47,888
فَإِذَا اعْتَنَى الْعَبْدُ بِهَذِهِ

125
00:23:18,950 --> 00:23:19,950
الْأَرْبَعِ أَمْكَنَ

126
00:23:34,664 --> 00:23:35,379
لَهُ

127
00:23:55,379 --> 00:23:58,236
أَنْ يَجْمَعَ أُصُولَ مَا يَحْتَاجُهُ مِمَّا يَتَعَلَّمُهُ فِي

128
00:23:58,236 --> 00:23:58,950
هَذَا الْبَرْنَامَجِ،

129
00:23:58,236 --> 00:23:58,950
ثُمَّ يُتْبِعُ بِهَذِهِ الْأَرْبَعِ

130
00:24:04,642 --> 00:24:05,104
مَا يَحْتَاجُ إِلَيْهِ

131
00:24:26,283 --> 00:24:27,217
مِمَّا يَتَعَلَّقُ بِهَا وَيَتَعَلَّقُ بِمَوْضُوعِ الْكِتَابِ وَمَقْصِدِ الْبَرْنَامَجِ

132
00:24:48,093 --> 00:24:49,236
مِنْ ضَبْطِ أَحْكَامِ الصِّيَامِ وَآدَابِهِ وَأَحْوَالِهِ،

133
00:24:48,664 --> 00:24:49,236
الْأَمْرُ الثَّالِثُ: يُحَثُّ

134
00:24:53,807 --> 00:24:54,950
عَلَى تَلْخِيصِ

135
00:24:59,254 --> 00:24:59,733
مَا

136
00:25:07,450 --> 00:25:08,950
بَلَغَهُ مِنَ التَّدْوِينِ بَعْدَ انْتِهَاءِ

137
00:25:35,750 --> 00:25:37,350
كُلِّ كِتَابٍ أَوْ بَعْدَ انْتِهَاءِ قَدْرٍ مِنْهُ يُؤْنِسُ مَعَهُ الْحَاجَةَ

138
00:25:53,586 --> 00:25:54,859
إِلَى جَمْعِ

139
00:26:19,325 --> 00:26:20,575
مَا تَفَرَّقَ مِنَ الْأَحْكَامِ،

140
00:26:19,950 --> 00:26:20,575
فَيَحْسُنُ تَلْخِيصُهُ،

141
00:26:19,950 --> 00:26:20,575
وَيَعْمَدُ إِلَى كُنَّاشَةٍ مِنَ الْكَنَانِيشِ فَيَجْمَعُ فِيهَا الْأَحْكَامَ مُرَتَّبَةً

142
00:26:49,529 --> 00:26:51,108
عَلَى هَيْئَةٍ يُمْكِنُ مَعَهَا أَنْ يَنْظُرَ

143
00:27:06,788 --> 00:27:08,067
فِي هَذِهِ الْأَحْكَامِ بَلَغَهُ مَا تَفَرَّقَ مِنْهُ بَعْدَ شَهْرٍ أَوْ

144
00:27:07,427 --> 00:27:08,067
بَعْدَ شَهْرَيْنِ أَوْ نَحْوِ

145
00:27:24,057 --> 00:27:25,336
ذَلِكَ مِمَّا قَدْ يَحْتَاجُ فِيهِ الْعَبْدُ أَنْ يُرَاجِعَ الْأَحْكَامَ فَيَجِدَهَا

146
00:27:24,696 --> 00:27:25,336
مُرَتَّبَةً مُيَسَّرَةً يُمْكِنُ لَهُ اسْتِحْضَارُ مَا أَرَادَهُ بِهَا.

147
00:27:24,696 --> 00:27:25,336
الْمَقْصِدُ الثَّانِي: بَيَانُ صِفَةِ النَّفْعِ بِهَذَا الْبَرْنَامَجِ،

148
00:27:24,696 --> 00:27:25,336
وَأَوْلَى مَا يَقَعُ بِهِ

149
00:27:51,107 --> 00:27:52,569
ذَلِكَ جَمْعُ مَنْ يُمْكِنُ

150
00:28:01,343 --> 00:28:02,074
لَهُ

151
00:28:24,968 --> 00:28:26,206
أَنْ يَنْتَفِعَ بِعِلْمِكَ ثِقَةً بِهَذَا الْعِلْمِ وَيُؤْنِسُ مِنْكَ نَفْعًا وَفَائِدَةً

152
00:28:45,397 --> 00:28:46,635
فِي مَجَالِسَ عِدَّةٍ تُلْقِي فِيهَا مَا بَلَغَكَ

153
00:28:50,757 --> 00:28:52,298
فِي هَذَا الْبَرْنَامَجِ مِنَ الْعِلْمِ فَتَنْفَعُ فِيهِ غَيْرَكَ،

154
00:29:04,108 --> 00:29:05,135
وَهَذَا مِمَّا يُفْقَدُ

155
00:29:12,185 --> 00:29:13,003
فِي طَلَبَةِ الْعِلْمِ،

156
00:29:12,594 --> 00:29:13,003
فَتَجِدُ أَحَدَهُمْ يَسْعَى

157
00:29:28,592 --> 00:29:29,902
فِي طَلَبِ الْعِلْمِ لِيَنْتَفِعَ بِهِ

158
00:29:45,018 --> 00:29:46,090
ثُمَّ إِذَا جَمَعَ خَلْقًا حَوْلَهُ

159
00:30:10,117 --> 00:30:11,783
مِنْ أَصْنَافٍ شَتَّى

160
00:30:20,879 --> 00:30:21,450
لَمْ يَكُنْ هَمُّهُ

161
00:30:33,450 --> 00:30:34,950
أَنْ يَجْمَعَ بِهِ هَذَا الْعِلْمَ فَهَذَا الْعِلْمُ يَجْلِسُ لِتَعْلِيمِهِمْ وَإِفْهَامِهِمْ،

162
00:30:34,450 --> 00:30:34,950
وَإِنَّمَا يَكُونُ غَايَةُ

163
00:30:42,700 --> 00:30:44,294
مَا يَقَعُ مِنْهُ

164
00:30:58,450 --> 00:31:00,450
أَنْ يُبْرِزَ فَائِدَةً أَوْ

165
00:31:17,397 --> 00:31:18,345
أَنْ يُلْقِيَ سُؤَالًا أَوْ نَحْوَ ذَلِكَ،

166
00:31:17,871 --> 00:31:18,345
وَهَذَا إِنَّمَا يَصْلُحُ حَالَ الِابْتِدَاءِ لِيَكُونَ

167
00:31:23,555 --> 00:31:24,503
فِيهِ إِبْرَازٌ بِحَاجَةِ هَؤُلَاءِ الْخَلْقِ إِلَى الْعِلْمِ،

168
00:31:24,029 --> 00:31:24,503
أَمَّا أَنْ يُعْلَمَ مِنْهُمْ ذَلِكَ ثُمَّ تُعْرِضُ عَنْ تَعْلِيمِهِمْ أَوْ

169
00:31:24,029 --> 00:31:24,503
أَنْ تَكْتَفِيَ بِإِلْقَاءِ مِثْلِ هَذِهِ السُّؤَالَاتِ إِلَيْهِمْ فَهَذَا تَقْصِيرٌ

170
00:31:43,700 --> 00:31:48,294
فِي الدَّعْوَةِ إِلَى اللَّهِ،

171
00:31:48,294 --> 00:31:48,950
وَيَنْبَغِي

172
00:32:08,450 --> 00:32:09,681
أَنْ يُعْلَمَ أَنَّ هَذَا أَصْلٌ أَصِيلٌ

173
00:32:11,527 --> 00:32:12,758
فِي دِينِنَا،

174
00:32:12,142 --> 00:32:12,758
فَمَنْ عَلِمَ شَيْئًا يَنْبَغِي لَهُ أَنْ يَحْرِصَ عَلَى إِيصَالِهِ لِمَنْ

175
00:32:21,210 --> 00:32:22,570
لَا يَعْلَمُهُ أَمْرًا بِالْمَعْرُوفِ وَحَثًّا

176
00:32:50,075 --> 00:32:51,158
عَلَى الْخَيْرِ،

177
00:32:50,617 --> 00:32:51,158
وَبِهَذَا تَعْلَمُ

178
00:33:03,054 --> 00:33:04,657
أَنَّ كَمَالَ الِانْتِفَاعِ بِهَذَا الْبَرْنَامَجِ

179
00:33:07,865 --> 00:33:08,667
هُوَ

180
00:33:32,420 --> 00:33:33,420
فِي نَفْعِ غَيْرِكَ بِهِ مِمَّنْ يُمْكِنُ لَكَ نَفْعُهُ أَيْضًا بِمَا

181
00:33:32,920 --> 00:33:33,420
يُلْقَى إِلَيْكَ فِيهِ

182
00:33:36,912 --> 00:33:38,109
مِنَ الْعِلْمِ،

183
00:33:37,511 --> 00:33:38,109
وَبِهَذَا نَكُونُ قَدِ انْتَهَيْنَا

184
00:33:45,290 --> 00:33:46,487
مِنَ الْمُقَدِّمَتَيْنِ وَاللَّتَيْنِ أَرْجُو

185
00:33:53,070 --> 00:33:54,267
أَنْ تَنْتَفِعُوا بِهِمَا

186
00:33:57,857 --> 00:33:59,054
عَلَى الْوَجْهِ الْمُنَاسِبِ لِلْمَقَامِ.

187
00:33:58,456 --> 00:33:59,054
قَالَ الْمُصَنِّفُ حَفِظَهُ

188
00:34:01,448 --> 00:34:02,645
اللَّهُ: بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

189
00:34:02,046 --> 00:34:02,645
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

190
00:34:02,046 --> 00:34:02,645
صَلَّى اللَّهُ وَسَلَّمَ

191
00:34:11,107 --> 00:34:12,440
عَلَى نَبِيِّنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

192
00:34:11,773 --> 00:34:12,440
اللَّهُمَّ اغْفِرْ لِشَيْخِنَا وَلِوَالِدَيْهِ وَشُيُوخِنَا وَالْمُسْلِمِينَ وَالْحَاضِرِينَ،

193
00:34:11,773 --> 00:34:12,440
أَقُولُ وَفَّقَكُمُ اللَّهُ

194
00:34:46,583 --> 00:34:48,011
فِي هَذَا الْمَتْنِ [بُغْيَةِ الصَّائِمِ]: بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

195
00:34:47,297 --> 00:34:48,011
الْحَمْدُ لِلَّهِ

196
00:34:57,167 --> 00:34:58,258
مَا صَامَ الصَّائِمُونَ وَعَمِلَ الْمُتَّقُونَ،

197
00:34:57,713 --> 00:34:58,258
وَأَشْهَدُ

198
00:35:01,107 --> 00:35:01,551
أَنْ لَا إِلَهَ إِلَّا اللَّهُ يَجْزِي الصَّائِمِينَ بِغَيْرِ حِسَابٍ،

199
00:35:01,329 --> 00:35:01,551
وَأَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ صَلَّى عَلَيْهِ اللَّهُ وَالْآلِ وَالْأَصْحَابِ وَسَلَّمَ

200
00:35:01,329 --> 00:35:01,551
عَلَيْهِمْ

201
00:35:37,168 --> 00:35:38,548
أَهْلَ السُّنَّةِ وَالْكِتَابِ،

202
00:35:37,858 --> 00:35:38,548
أَمَّا بَعْدُ.

203
00:35:37,858 --> 00:35:38,548
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: [أَمَّا بَعْدُ] الَّتِي اقْتَصَرَ عَلَيْهَا النَّبِيُّ

204
00:35:37,858 --> 00:35:38,548
صَلَّى اللَّهُ

205
00:36:10,570 --> 00:36:12,120
عَلَيْهِ وَسَلَّمَ

206
00:36:25,827 --> 00:36:26,970
فِي رَسَائِلِهِ وَمُكَاتَبَاتِهِ إِلَى الْمُلُوكِ وَالتَّصْنِيفُ تَجْرِي مَجْرَاهَا،

207
00:36:26,399 --> 00:36:26,970
ثُمَّ أَشَارَ الْمُصَنِّفُ إِلَى مَقْصُودِ كِتَابِهِ بِقَوْلِهِ: [الْحَمْدُ لِلَّهِ مَا

208
00:36:26,399 --> 00:36:26,970
صَامَ الصَّائِمُونَ]،

209
00:36:26,399 --> 00:36:26,970
وَهِيَ مِنْ بَرَاعَةِ الِاسْتِهْلَالِ،

210
00:36:31,770 --> 00:36:32,570
إِنَّ مِمَّا يُحْمَدُ فِي التَّصْنِيفِ الْإِشَارَةُ إِلَى مَقْصُودِ الْكِتَابِ فِي

211
00:36:32,170 --> 00:36:32,570
ابْتِدَاءِ دِيبَاجَتِهِ،

212
00:36:32,170 --> 00:36:32,570
وَعَطَفَ

213
00:36:43,170 --> 00:36:44,370
عَلَى هَذِهِ الْعِبَادَةِ الْعَظِيمَةِ أَثَرَهَا فِي قَوْلِهِ: [وَعَمِلَ الْمُتَّقُونَ]،

214
00:36:43,770 --> 00:36:44,370
فَإِنَّ الْمَقْصُودَ الْأَعْظَمَ مِنْ حُصُولِ الصِّيَامِ هُوَ التَّقْوَى،

215
00:36:43,770 --> 00:36:44,370
قَالَ تَعَالَى: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الصِّيَامُ

216
00:36:49,970 --> 00:36:51,303
كَمَا كُتِبَ

217
00:37:20,541 --> 00:37:21,684
عَلَى الَّذِينَ

218
00:37:24,970 --> 00:37:25,970
مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ﴾،

219
00:37:25,470 --> 00:37:25,970
وَفِيهِ بَيَانُ

220
00:37:33,684 --> 00:37:35,399
أَنَّ مَنْ لَمْ يَبْلُغْ

221
00:37:56,399 --> 00:37:57,399
بِهِ الصِّيَامُ حَقِيقَةَ التَّقْوَى فَقَدْ قَصَّرَ

222
00:38:01,414 --> 00:38:02,137
فِي

223
00:38:21,340 --> 00:38:23,340
صِيَامِهِ عَنِ الْمُتَّقُونَ الْمَطْلُوبِ

224
00:38:33,911 --> 00:38:36,090
مِنْهُ شَرْعًا،

225
00:38:34,340 --> 00:38:36,090
وَالتَّقْوَى شَرْعًا هِيَ: اتِّخَاذُ الْعَبْدِ وِقَايَةً بَيْنَهُ وَبَيْنَ

226
00:38:54,708 --> 00:38:55,551
مَا يَخْشَاهُ بِاتِّبَاعِ خِطَابِ الشَّرْعِ،

227
00:38:55,129 --> 00:38:55,551
فَقُلْنَا: اتِّخَاذُ الْعَبْدِ وِقَايَةً،

228
00:38:55,129 --> 00:38:57,656
وَهَذَا بِاعْتِبَارِ الْأَصْلِ اللُّغَوِيِّ لِلتَّقْوَى فَإِنَّهَا تُشِيرُ إِلَى الْحِرْزِ الَّذِي

229
00:38:57,656 --> 00:38:58,077
يُحْتَمَى بِهِ،

230
00:38:57,656 --> 00:38:59,340
ثُمَّ ذَكَرْنَا أَنَّ وَسِيلَةَ هَذِهِ التَّقْوَى

231
00:39:26,976 --> 00:39:27,885
هِيَ اتِّبَاعُ خِطَابِ الشَّرْعِ،

232
00:39:27,431 --> 00:39:27,885
وَالْمَذْكُورُ

233
00:39:33,673 --> 00:39:35,007
فِي قَوْلِنَا اتِّبَاعُ خِطَابِ الشَّرْعِ يَشْمَلُ اتِّبَاعَهُ عَلَى صُوَرِهِ كُلِّهَا

234
00:39:34,340 --> 00:39:35,007
فِيمَا يَتَعَلَّقُ بِنَوْعَيْ خِطَابِ الشَّرْعِ،

235
00:39:48,340 --> 00:39:49,292
فَإِنَّ لِخِطَابِ الشَّرْعِ نَوْعَانِ

236
00:40:17,673 --> 00:40:19,007
اثْنَانِ: أَحَدُهُمَا: خِطَابُ الشَّرْعِ الْخَبَرِيُّ وَمُتَعَلَّقُهُ الِاعْتِقَادُ،

237
00:40:18,340 --> 00:40:19,007
وَالْآخَرُ: خِطَابُ الشَّرْعِ الطَّلَبِيُّ وَمُتَعَلَّقُهُ الْأَوَامِرُ وَالنَّوَاهِي وَأَحْكَامُ الْحَلَالِ،

238
00:40:18,340 --> 00:40:19,673
وَبِهِ تَعْلَمُ أَنَّ

239
00:40:45,882 --> 00:40:47,040
الْعَمَلَ بِهَذَيْنِ النَّوْعَيْنِ

240
00:41:09,792 --> 00:41:11,082
مِنَ الْخِطَابِ الشَّرْعِيِّ يَقَعُ وَفْقَ أَرْبَعِ أَحْوَالٍ: الْأَوَّلُ: اعْتِقَادُ حِلِّ

241
00:41:10,437 --> 00:41:11,082
الْحَلَالِ، وَالثَّانِي: فِعْلُ الْأَوَامِرِ،

242
00:41:10,437 --> 00:41:11,082
وَالثَّالِثُ: اجْتِنَابُ النَّوَاهِي،

243
00:41:10,437 --> 00:41:11,082
وَالرَّابِعُ: التَّصْدِيقُ بِالْخَبَرِ إِثْبَاتًا وَنَفْيًا،

244
00:41:10,437 --> 00:41:11,082
فَهَذِهِ الْأَرْبَعَةُ هِيَ الَّتِي تُحَقِّقُ لِلْعَبْدِ التَّقْوَى فِيمَا يَتَعَلَّقُ بِأَنْوَاعِ

245
00:41:10,437 --> 00:41:11,082
خِطَابِ الشَّرْعِ كُلِّهَا.

246
00:41:23,340 --> 00:41:24,673
ثُمَّ ذَكَرْنَا أَيْضًا فِيمَا يَتَعَلَّقُ بِحَدِّ التَّقْوَى أَنَّهَا بَيْنَ الْعَبْدِ

247
00:41:24,007 --> 00:41:24,673
وَبَيْنَ مَا يَخْشَاهُ،

248
00:41:24,007 --> 00:41:24,673
وَلَيْسَ هَذَا مَقْصُورًا عَلَى اللَّهِ عَزَّ وَجَلَّ،

249
00:41:41,340 --> 00:41:42,483
فَإِنَّ مَا يَخْشَاهُ الْعَبْدُ يَتَنَوَّعُ،

250
00:41:41,911 --> 00:41:43,626
وَلِهَذَا عُلِّقَتِ التَّقْوَى فِي خِطَابِ الشَّرْعِ بِأَكْثَرَ

251
00:41:52,197 --> 00:41:53,340
مِنْ مُتَعَلَّقٍ،

252
00:41:52,769 --> 00:41:53,340
فَتَجِدُ التَّقْوَى بِاعْتِبَارِ كَوْنِ الْعَبْدِ يَخْشَى

253
00:42:17,653 --> 00:42:18,778
اللَّهَ عَزَّ وَجَلَّ وَهِيَ الَّتِي وَرَدَتْ فِيهَا جُمْلَةٌ

254
00:42:24,451 --> 00:42:30,118
مِنَ الْآيَاتِ فِي قَوْلِهِ تَعَالَى: ﴿وَاتَّقُوا اللَّهَ﴾،

255
00:42:30,118 --> 00:42:30,562
ثُمَّ تَجِدُ تَقْوَى بِاعْتِبَارِ تَعَلُّقِهَا بِالْيَوْمِ الْآخِرِ وَفِيهِ قَوْلُهُ تَعَالَى:

256
00:42:30,118 --> 00:42:56,950
﴿وَاتَّقُوا يَوْمًا تُرْجَعُونَ فِيهِ إِلَى اللَّهِ﴾،

257
00:43:24,972 --> 00:43:26,083
ثُمَّ تَجِدُ التَّقْوَى بِاعْتِبَارِ النَّارِ وَتَعَلُّقِهَا بِهِ وَتَعَلُّقِهَا بِهَا

258
00:43:42,964 --> 00:43:44,893
فِي قَوْلِهِ تَعَالَى: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا قُوا أَنْفُسَكُمْ وَأَهْلِيكُمْ

259
00:43:44,250 --> 00:43:44,893
نَارًا﴾، فَمُتَعَلَّقَاتُ التَّقْوَى مُتَعَدِّدَةٌ وَإِنْ

260
00:44:13,002 --> 00:44:14,754
كَانَ أَصْلُهَا تَقْوَى

261
00:44:28,916 --> 00:44:30,630
اللَّهِ عَزَّ وَجَلَّ إِلَّا أَنَّهَا لَا تَقْتَصِرُ عَلَيْهَا،

262
00:44:29,630 --> 00:44:30,630
وَلِهَذَا فَالْمَذْكُورُ تَحْقِيقًا

263
00:44:41,844 --> 00:44:43,130
فِي حَدِّ التَّقْوَى

264
00:45:06,925 --> 00:45:08,834
أَنَّ اتِّخَاذَ

265
00:45:10,743 --> 00:45:12,652
الْعَبْدِ وِقَايَةً بَيْنَهُ وَبَيْنَ مَا يَخْشَاهُ فَضَمَّ عَامَّةَ مَا يَحْمِلُ

266
00:45:11,698 --> 00:45:12,652
هَذَا الْوَصْفَ مِمَّا يَخْشَاهُ الْعَبْدُ سَوَاءٌ كَانَ مِمَّا تَقَدَّمَهُ فِي

267
00:45:11,698 --> 00:45:12,652
الْأَمْثِلَةِ الَّتِي مَرَّضْنَاهَا لَكُمْ أَوْ مَا وَرَاءَ

268
00:45:27,380 --> 00:45:29,380
ذَلِكَ مِمَّا يُبَيَّنُ

269
00:45:32,080 --> 00:45:33,480
إِنْ شَاءَ

270
00:45:49,012 --> 00:45:50,169
اللَّهُ فِي مَحَلِّهِ اللَّائِقِ بِهِ.

271
00:45:49,591 --> 00:45:50,169
ثُمَّ ذَكَرَ بَعْدُ

272
00:46:02,303 --> 00:46:03,072
أَنَّ جَزَاءَ اللَّهِ عَزَّ وَجَلَّ لِلصَّائِمِينَ عَلَى صَوْمِهِمْ يَكُونُ بِغَيْرِ

273
00:46:02,688 --> 00:46:03,072
حِسَابٍ، وَوَقَعَ

274
00:46:08,936 --> 00:46:09,824
هَذَا مِنْهُ عَلَى إِرَادَةِ جَعْلِ الْجَزَاءِ بَعْدَ الْعَمَلِ،

275
00:46:09,380 --> 00:46:09,824
فَكَانَ ابْتِدَاءُ كَلَامِهِ

276
00:46:32,255 --> 00:46:33,630
فِي الصِّيَامِ وَأَثَرِهِ

277
00:46:48,880 --> 00:46:49,880
الَّذِي هُوَ التَّقْوَى وَانْتِهَاءُ كَلَامِهِ فِي مَا يَتَعَلَّقُ بِجَزَائِهَا

278
00:46:57,327 --> 00:46:58,906
وَهُوَ كَوْنُهُ وَاقِعًا بِغَيْرِ حِسَابٍ،

279
00:46:58,117 --> 00:46:58,906
وَهَذَا

280
00:47:11,991 --> 00:47:13,436
الَّذِي ذُكِرَ

281
00:47:36,980 --> 00:47:40,198
مِنْ كَوْنِ جَزَاءِ الصَّائِمِينَ هُوَ بِغَيْرِ حِسَابٍ هُوَ مُسْتَفَادٌ مِنْ

282
00:47:40,198 --> 00:47:40,653
قَوْلِهِ تَعَالَى: ﴿إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ بِغَيْرِ حِسَابٍ﴾،

283
00:47:40,198 --> 00:47:40,653
وَهَذِهِ الْآيَةُ فِي أَكْثَرِ الْأَقْوَالِ هِيَ فِي الصَّائِمِينَ،

284
00:47:40,198 --> 00:47:40,653
فَالصَّابِرُونَ هُمُ الصَّائِمُونَ،

285
00:47:40,198 --> 00:47:42,016
وَذَلِكَ لِمَا جَمَعَ الصَّوْمُ مِنْ أَنْوَاعِ الصَّائِمِينَ فَأَنْوَاعِ الصَّبْرِ،

286
00:47:41,562 --> 00:47:42,016
فَإِنَّ فِيهِ صَبْرٌ عَلَى الطَّاعَةِ

287
00:47:44,744 --> 00:47:47,925
الَّتِي هِيَ رُكْنُ أَرْكَانِ الْإِسْلَامِ فِي هَذَا الْمَحَلِّ وَهُوَ صِيَامُ

288
00:47:52,120 --> 00:47:52,860
رَمَضَانَ،

289
00:48:21,340 --> 00:48:22,935
وَفِيهِ صَبْرٌ

290
00:48:30,111 --> 00:48:31,705
عَنِ الْمَعْصِيَةِ الَّذِي يَتَمَثَّلُ

291
00:48:52,267 --> 00:48:53,481
فِي إِمْسَاكِ الْعَبْدِ نَفْسَهُ عَنِ الْإِفْطَارِ وَتَنَاوُلِ الْمُحَرَّمَاتِ الَّتِي لَا

292
00:48:52,874 --> 00:48:53,481
جُزْءَ لَهُ تَعَاطِيهَا حَالَ صَوْمِهِ

293
00:49:00,565 --> 00:49:01,376
مِنَ الطَّعَامِ وَالشَّرَابِ وَغَيْرِ

294
00:49:10,787 --> 00:49:13,855
ذَلِكَ مِنَ

295
00:49:13,855 --> 00:49:14,320
الْمُفْطِرَاتِ وَمُفْسِدَاتِ الصِّيَامِ،

296
00:49:13,855 --> 00:49:14,320
وَكَذَا النَّوْعُ الثَّالِثُ

297
00:49:17,110 --> 00:49:18,040
مِنَ الصَّبْرِ

298
00:49:34,135 --> 00:49:35,257
هُوَ الصَّبْرُ عَلَى الْبَلَاءِ،

299
00:49:34,696 --> 00:49:35,257
فَإِنَّ الْعَبْدَ مَا دَامَ صَائِمًا فَهُوَ فِي بَلَاءٍ لِشِدَّةِ حَاجَتِهِ

300
00:49:34,696 --> 00:49:35,257
إِلَى الطَّعَامِ وَالشَّرَابِ وَضَعْفِ قُوَّتِهِ وَخَوَارِهِ،

301
00:49:34,696 --> 00:49:35,257
فَهُوَ فِي هَذِهِ الْحَالِ صَابِرٌ

302
00:49:59,684 --> 00:50:00,929
مِنْ جِهَةِ أَنْوَاعِ الصَّبْرِ الثَّلَاثَةِ،

303
00:50:00,307 --> 00:50:00,929
فَهُوَ أَحَقُّ

304
00:50:04,662 --> 00:50:05,907
مَنْ يُوصَفُ بِالصَّبْرِ،

305
00:50:05,284 --> 00:50:05,907
وَمِنْ ثَمَّ هُوَ أَحَقُّ

306
00:50:12,701 --> 00:50:13,722
مَنْ يَدْخُلُ

307
00:50:16,273 --> 00:50:16,783
فِي

308
00:50:37,140 --> 00:50:38,390
هَذِهِ الْآيَةِ،

309
00:50:37,765 --> 00:50:38,390
وَقَدْ وَقَعَ تَسْمِيَتُهُ شَهْرَ رَمَضَانَ بِاسْمِ شَهْرِ الصَّبْرِ

310
00:50:50,618 --> 00:50:53,507
فِي بَعْضِ أَلْفَاظِ حَدِيثٍ وَرَدَ فِي [صَحِيحِ مُسْلِمٍ] رِعَايَةً لِهَذَا

311
00:50:52,929 --> 00:50:53,507
الْأَصْلِ، وَقَدْ عُمِلَ بِهَذَا الْأَصْلِ فَهْمًا

312
00:51:13,332 --> 00:51:14,409
بِهَذِهِ الْآيَةِ فَوَقَعُوهَا

313
00:51:26,880 --> 00:51:30,240
عَلَى الصَّائِمِينَ جَمَاعَةٌ مِنْ

314
00:51:30,240 --> 00:51:31,080
كِبَارِ السَّلَفِ مِنْهُمْ سُفْيَانُ بْنُ عُيَيْنَةَ وَأَبُو عُبَيْدَةَ وَالْقَاسِمُ بْنُ

315
00:51:30,240 --> 00:51:31,080
سَلَّامٍ صَاحِبُ [غَرِيبِ الْحَدِيثِ] وَتَابَعَهُمَا أَبُو الْفَضْلِ بْنُ حَجَرٍ فِي

316
00:51:30,240 --> 00:51:31,080
[فَتْحِ الْبَارِي شَرْحِ صَحِيحِ الْبُخَارِيِّ]،

317
00:51:30,240 --> 00:51:31,080
وَيَشْهَدُ لَهُ جُمْلَةٌ

318
00:51:34,440 --> 00:51:36,120
مِنَ الْوَارِدِ فِي السُّنَّةِ النَّبَوِيَّةِ

319
00:51:53,464 --> 00:51:54,562
عَلَى مَا يُبَيَّنُ

320
00:51:59,503 --> 00:52:00,601
إِنْ شَاءَ

321
00:52:05,542 --> 00:52:06,091
اللَّهُ

322
00:52:20,758 --> 00:52:22,374
فِي مَحَلٍّ آخَرَ.

323
00:52:35,300 --> 00:52:36,500
ثُمَّ خَتَمَ دِيبَاجَةَ كِتَابِهِ بِوَصْفِ الْآلِ وَالْأَصْحَابِ بِأَنَّهُمْ أَهْلُ السُّنَّةِ

324
00:52:35,900 --> 00:52:38,900
وَالْكِتَابِ، وَهَذَا عَلَى

325
00:52:38,900 --> 00:52:39,500
إِرَادَةِ أَنَّهُمْ تَحَقَّقُوا بِالسُّنَّةِ عِلْمًا وَتَعْلِيمًا وَدَعْوَةً وَعَمَلًا وَنَحْوَ ذَلِكَ

326
00:52:51,527 --> 00:52:52,891
مِنْ أَوْجُهِ الِاتِّصَالِ بِهَا،

327
00:52:52,209 --> 00:52:52,891
وَكَذَا بِالْقُرْآنِ،

328
00:52:52,209 --> 00:52:52,891
وَيَسُوغُ تَأْخِيرُ الْقُرْآنِ عَنِ السُّنَّةِ مَعَ عُلُوِّ مَقَامِهِ عَنْهَا بِحَاجَةِ

329
00:52:52,209 --> 00:52:52,891
السَّجْعِ، فَهَذَا مِمَّا يُقَوِّي الْكَلَامَ فَيُظْهِرُ فَصَاحَتَهُ وَيَحُدُّ بَيَانَهُ،

330
00:52:52,209 --> 00:52:52,891
وَهُوَ مِمَّا جَرَى أَهْلُ

331
00:53:22,800 --> 00:53:23,925
الْعِلْمِ

332
00:53:51,157 --> 00:53:52,586
عَلَى التَّسَامُحِ فِيهِ بِعَظِيمِ أَثَرِهِ وَنَفْعِ مَقْصَدِهِ.

333
00:53:51,871 --> 00:53:52,586
قَالَ الْمُصَنِّفُ حَفِظَهُ

334
00:53:56,685 --> 00:53:58,377
اللَّهُ: فَهَذِهِ رِسَالَةٌ فِقْهِيَّةٌ نَافِعَةٌ تَحْوِي مُهِمَّاتِ أَحْكَامِ الصِّيَامِ الْجَامِعَةِ

335
00:53:57,531 --> 00:53:58,377
عَلَى الرَّاجِحِ

336
00:54:02,608 --> 00:54:04,300
مِنَ الْمَذَاهِبِ الْأَرْبَعَةِ مُرَتَّبَةً

337
00:54:06,100 --> 00:54:07,300
فِي فُصُولٍ مُتَرْجَمَةٍ مَسْرُودَةٍ بِعِبَارَةٍ مُحْكَمَةٍ،

338
00:54:06,700 --> 00:54:07,300
وَأَسْأَلُ

339
00:54:13,531 --> 00:54:15,223
اللَّهَ أَنْ يَتَقَبَّلَهَا بِوَاسِعِ رَحْمَتِهِ وَيَنْفَعَ بِهَا بِعَظِيمِ فَضْلِهِ وَمِنَّتِهِ.

340
00:54:14,377 --> 00:54:16,915
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ وَصْفَ

341
00:54:16,069 --> 00:54:17,762
هَذَا الْمُصَنَّفِ بِقَوْلِهِ: [رِسَالَةٌ]،

342
00:54:16,915 --> 00:54:17,762
وَرِسَالَةٌ يَا مَا لَطُفَ حَجْمُهُ مِنَ الْمُصَنَّفَاتِ

343
00:54:20,300 --> 00:54:21,100
هُوَ

344
00:54:33,189 --> 00:54:35,633
فِي مَقَامِ مُخْتَصَرَاتٍ،

345
00:54:34,411 --> 00:54:35,633
ثُمَّ ذَكَرَ أَنَّهَا رِسَالَةٌ فِقْهِيَّةٌ أَيْ مُتَعَلِّقَةٌ بِعِلْمِ الْفِقْهِ وَعِلْمِ

346
00:54:34,411 --> 00:54:35,633
الْحَلَالِ وَالْحَرَامِ وَالْعِلْمِ الَّذِي يَخْتَصُّ بِالْأَحْكَامِ الطَّلَبِيَّةِ،

347
00:54:34,411 --> 00:54:35,633
ثُمَّ وَصَفَهَا بِكَوْنِهَا نَافِعَةً،

348
00:54:34,411 --> 00:54:35,633
وَالنَّافِعُ مِنَ الْعِلْمِ

349
00:54:55,700 --> 00:54:57,100
هُوَ مَا يُهْتَدَى بِهِ إِلَى

350
00:55:26,712 --> 00:55:29,006
اللَّهِ عَزَّ وَجَلَّ،

351
00:55:29,006 --> 00:55:29,771
فَلَيْسَ النَّفْعُ بِكَثْرَةِ الْمَعْلُومَاتِ أَوْ بِاتِّسَاعِ الْمَدَارِكِ أَوْ بِشَيْءٍ مِمَّا

352
00:55:29,006 --> 00:55:29,771
يَسْعَى إِلَيْهِ النَّاسُ بِآخِرَةٍ،

353
00:55:29,006 --> 00:55:29,771
حَتَّى قَالَ فِيهِمُ ابْنُ الْجَوْزِيِّ

354
00:55:35,157 --> 00:55:36,014
فِي [صَيْدِ خَاطِرِهِ]: [وَجَدْتُ أَكْثَرَ النَّاسِ وَاقِفِينَ مَعَ صُورَةِ الْعِلْمِ

355
00:55:35,586 --> 00:55:36,014
لَا حَقِيقَتِهِ]،

356
00:55:35,586 --> 00:55:36,014
وَإِنَّمَا الْعِلْمُ النَّافِعُ هُوَ الَّذِي يَهْدِي الْخَلْقَ إِلَى رَبِّهِمْ فَيُحْسِنُونَ

357
00:55:35,586 --> 00:55:36,014
بِهِ عِبَادَتَهُمْ وَيَتَقَرَّبُونَ بِهِ إِلَى

358
00:55:39,482 --> 00:55:40,573
اللَّهِ عَزَّ وَجَلَّ،

359
00:55:40,027 --> 00:55:40,573
وَيَظْهَرُ عَلَيْهِمْ مِنْ آثَارِهِ الْحَمِيدَةِ وَعَوَاقِبِهِ الْجَمِيلَةِ مَا يَكُونُ بِهِ

360
00:55:40,027 --> 00:55:40,573
حَالُهُمْ عِنْدَ

361
00:55:47,189 --> 00:55:48,300
اللَّهِ أَكْمَلَ،

362
00:55:47,744 --> 00:55:48,300
فَتَجِدُ فِيهِمْ عَمَلًا وَتَعْلِيمًا وَدَعْوَةً وَإِصْلَاحًا وَإِرْشَادًا فَيَكُونُونَ أَسْبَابًا لِلْخَيْرِ

363
00:55:47,744 --> 00:55:48,300
وَمَفَاتِيحًا لَهُمْ

364
00:55:51,800 --> 00:55:52,300
عَلَى

365
00:56:16,400 --> 00:56:17,300
مَا هُوَ مَعْرُوفٌ

366
00:56:42,260 --> 00:56:43,700
فِيهِ آثَارُ أَهْلِ الْعِلْمِ

367
00:56:59,744 --> 00:57:01,300
عَلَى الْخَلْقِ،

368
00:57:00,522 --> 00:57:01,300
فَهَذَا هُوَ الْعِلْمُ النَّافِعُ،

369
00:57:00,522 --> 00:57:01,300
أَمَّا جَمْعُ الْمَعْلُومَاتِ فَلَيْسَ

370
00:57:10,900 --> 00:57:12,180
مِنْ ذَلِكَ،

371
00:57:11,540 --> 00:57:12,180
فَإِذَا أَرَدْتَ أَنْ تَقِيسَ قَدْرَ انْتِفَاعِكَ بِهَذِهِ الرِّسَالَةِ فَانْظُرْ إِلَى

372
00:57:22,146 --> 00:57:23,531
مَا أَوْقَعَتْ

373
00:57:25,608 --> 00:57:26,992
فِي نَفْسِكَ

374
00:57:42,300 --> 00:57:43,300
مِنْ

375
00:57:53,300 --> 00:57:55,300
هَذِهِ الْأَحْوَالِ وَمَا ظَهَرَ عَلَيْكَ مِنْهَا

376
00:57:56,300 --> 00:57:58,300
فِي مُعَامَلَتِكَ لِلْخَلْقِ

377
00:58:19,616 --> 00:58:20,774
فِي أَمْرٍ عَظِيمٍ هُوَ

378
00:58:33,433 --> 00:58:34,167
مِنَ

379
00:59:03,633 --> 00:59:04,936
الْعِلْمِ الْوَاجِبِ

380
00:59:09,391 --> 00:59:10,664
فِي أَصْلٍ عَظِيمٍ وَهُوَ صِيَامُ رَمَضَانَ،

381
00:59:10,027 --> 00:59:10,664
فَهَذَا

382
00:59:19,300 --> 00:59:20,500
الَّذِي تُرَاعِي بِهِ أَحْوَالَ الْخَلْقِ فِيمَا يَحْتَاجُونَ إِلَيْهِ،

383
00:59:19,900 --> 00:59:20,500
أَمَّا مَنْ يَتَلَقَّى هَذِهِ الرِّسَالَةِ ثُمَّ

384
00:59:30,383 --> 00:59:31,217
لَا يَظْهَرُ عَلَيْهِ شَيْءٌ مِنَ الْعِلْمِ الَّذِي تَلَقَّاهُ فِيهَا لَا

385
00:59:30,800 --> 00:59:31,217
تَعْلِيمًا وَلَا دَعْوَةً وَلَا هُوَ فِي عَمَلِهِ يَعْتَنِي بِمَا تَلَقَّاهُ

386
00:59:30,800 --> 00:59:31,217
مِنَ الْعِلْمِ فَهَذَا لَا يَكُونُ مِنَ النَّافِعِ فِي شَيْءٍ وَلَا

387
00:59:30,800 --> 00:59:31,217
هُوَ أَصَابَ شَيْئًا مِنَ الْعِلْمِ وَمِنْ مَقْصُودِ هَذِهِ الرِّسَالَةِ سِوَى

388
00:59:30,800 --> 00:59:31,217
أَنَّهُ انْقَضَى بِهَا بَعْدَ الْوَقْتِ الَّذِي حَجَبَهُ عَمَّا هُوَ مِنَ

389
00:59:30,800 --> 00:59:31,217
الْمُحَرَّمَاتِ، وَهَذِهِ حَالٌ رَدِيئَةٌ يَنْبَغِي أَنْ يَتَنَزَّهَ طَالِبُ الْعِلْمِ عَنْهَا.

390
00:59:30,800 --> 00:59:31,217
ثُمَّ ذَكَرَ أَنَّ هَذِهِ الرِّسَالَةَ تَحْوِي مُهِمَّاتِ أَحْكَامِ الصِّيَامِ الْجَامِعَةِ،

391
00:59:30,800 --> 00:59:31,217
وَهُوَ الْمُوَافِقُ بِعُنْوَانِ هَذِهِ الرِّسَالَةِ فَإِنَّهَا تُسَمَّى [بُغْيَةَ الصَّائِمِ]،

392
00:59:30,800 --> 00:59:31,217
فَهَذَا يُسَمَّى لِمَا يُحْتَاجُ إِلَيْهِ،

393
00:59:30,800 --> 00:59:31,217
فَإِنَّ الَّذِي يُبْتَغَى أَنْ يُطْلَقَ وَيُسْعَى إِلَيْهِ هُوَ الْمُحْتَاجُ إِلَيْهِ،

394
00:59:30,800 --> 00:59:31,217
وَهُوَ الْمُوَافِقُ لِقَوْلِهِ الْمُهِمِّ،

395
00:59:30,800 --> 00:59:31,217
فَإِنَّ الْمُهِمَّ هُوَ أَيْضًا اسْمٌ لِمَا تَشْتَدُّ الْحَاجَةُ إِلَيْهِ،

396
00:59:30,800 --> 00:59:31,217
وَبِهِ تَعْلَمُ أَنَّ هَذِهِ الرِّسَالَةَ هِيَ الَّتِي تُرَاعِي مَا يُحْتَاجُ

397
00:59:30,800 --> 00:59:31,217
إِلَيْهِ مِنْ فِقْهِ مُنَاسَبَةٍ،

398
00:59:30,800 --> 00:59:31,217
أَمَّا مَا زَادَ عَنْ ذَلِكَ وَهُوَ زَائِدٌ عَنْ قَدْرِ الْحَاجَةِ،

399
00:59:30,800 --> 00:59:31,217
وَالْأَصْلُ فِي دَعْوَةِ الْخَلْقِ وَتَعْلِيمِهِمْ أَنْ يُرَاعَى مَا يَنْفَعُهُمْ دُونَ

400
00:59:30,800 --> 00:59:31,217
زِيَادَةٍ عَلَيْهِ،

401
00:59:30,800 --> 00:59:31,217
فَإِنَّ الْعِلْمَ لَا يُحْمَدُ بِالْبَسْطِ وَالِاتِّسَاعِ وَإِنَّمَا يُحْمَدُ بِالنَّفْعِ وَالِانْتِفَاعِ،

402
00:59:30,800 --> 00:59:31,217
فَهَذَا هُوَ الَّذِي جَرَى عَلَيْهِ عُلَمَاؤُنَا وَمَشَايِخُنَا فَنَفَعُوا بِهِ الْخَلْقَ،

403
00:59:30,800 --> 00:59:31,217
فَهَذِهِ الرِّسَالَةُ إِنَّمَا تَحْوِي مَا يُحْتَاجُ إِلَيْهِ مِنْ أَحْكَامِ الصِّيَامِ،

404
00:59:30,800 --> 00:59:31,217
ثُمَّ ذَكَرَ أَنَّهَا تَقَعُ عَلَى الرَّاجِحِ مِنَ الْمَذَاهِبِ الْأَرْبَعِ،

405
00:59:30,800 --> 00:59:31,217
وَالرَّاجِحُ هُوَ مَا انْتَهَى إِلَيْهِ قَوْلُ مُجْتَهِدٍ،

406
00:59:30,800 --> 00:59:31,217
وَهَذَا الْمُجْتَهِدُ فِي هَذِهِ الرِّسَالَةِ وَمَا يَتَعَلَّقُ بِأَحْكَامِهِ هُوَ شَيْخُنَا

407
00:59:30,800 --> 00:59:31,217
صَالِحُ بْنُ عَبْدِ

408
00:59:35,100 --> 00:59:36,300
اللَّهِ بْنِ حَمَدٍ الْعُصَيْمِيُّ حَفِظَهُ اللَّهُ،

409
00:59:35,700 --> 00:59:36,300
وَإِنَّ لَهُ بَاعًا وَاسِعًا فِي هَذِهِ الْأَحْكَامِ تَقْرِيرُهُ لِجُمْلَةٍ كَبِيرَةٍ

410
00:59:35,700 --> 00:59:36,300
مِنْهَا فِي مُخْتَلِفِ دُرُوسِهِ فِي بَرَامِجَ عِدَّةٍ فَيُنْتَقَى مِنْ هَذِهِ

411
00:59:35,700 --> 00:59:36,300
الْأَحْكَامِ مَا يُنَاسِبُ الْمَقَامَ ثُمَّ تُلْقَى إِلَيْكُمْ بِعَوْنِ اللَّهِ،

412
00:59:35,700 --> 00:59:36,300
وَبِهِ تَعْلَمُ أَنَّ مَا نُلْقِيهِ فِي هَذِهِ الْمَجَالِسِ فَهُوَ فِي

413
00:59:35,700 --> 00:59:36,300
قَيْدِ الرَّاجِحِ أَيْ بِالِاجْتِهَادِ،

414
00:59:35,700 --> 00:59:36,300
فَهُوَ مِنْ جُمْلَةِ مَا بَلَغَ اجْتِهَادُ الشَّيْخِ أَنْ وَقَفَ عَلَيْهِ

415
00:59:35,700 --> 00:59:36,300
مِنْ أَحْكَامِ الصِّيَامِ فَعَلَّمَهُ الْخَلْقَ وَهَا أَنَا أُعَلِّمُكُمُ إِيَّاهُ،

416
00:59:35,700 --> 00:59:36,300
فَلَا يُنْكَرُ عَلَى أَحَدٍ خَالَفَ شَيْئًا مِنْ هَذِهِ الْأَحْكَامِ إِنْ

417
00:59:35,700 --> 00:59:36,300
خَالَفَهُ بِاجْتِهَادٍ آخَرَ،

418
00:59:35,700 --> 00:59:36,300
فَإِنَّ قَوْلَ مُجْتَهِدٍ لَيْسَ بِحُجَّةٍ عَلَى مُجْتَهِدٍ آخَرَ،

419
00:59:35,700 --> 00:59:36,300
فَمَنْ رَأَى فِي الْخَلْقِ شَيْئًا مِمَّا يُخَالِفُ مَا سَنُقَرِّرُهُ إِنْ

420
00:59:35,700 --> 00:59:36,300
شَاءَ اللَّهُ فِي هَذِهِ الرِّسَالَةِ فَلَا يُبَادِرَنَّهُ بِتَخْطِئَتِهِ وَالْحُكْمِ عِصْيَانِهِ

421
00:59:35,700 --> 00:59:36,300
أَوْ فُسُوقِهِ أَوْ نَحْوِ ذَلِكَ،

422
00:59:35,700 --> 00:59:36,300
فَهَذَا عَطَطٌ،

423
00:59:35,700 --> 00:59:36,300
إِنَّ طَالِبَ الْعِلْمِ يَنْبَغِي لَهُ أَنْ يَعْلَمَ قَدْرَ الْعُلَمَاءِ وَأَنَّهُ

424
00:59:35,700 --> 00:59:36,300
مَا مِنْ عَالِمٍ قَطُّ لَهُ اجْتِهَادٌ فِي مَسْأَلَةٍ إِلَّا وَقَدْ

425
00:59:35,700 --> 00:59:36,300
بَنَاهُ عَلَى دَلِيلٍ،

426
00:59:35,700 --> 00:59:36,300
وَمِثْلُ هَذَا لَا يُعَابُ عَلَيْهِ،

427
00:59:35,700 --> 00:59:36,300
فَإِنْ رَجَّحَ شَيْئًا خِلَافَ مَا رَجَّحْنَاهُ فَأَفْتَى بِهِ جُمْهُورَ الْخَلْقِ

428
00:59:35,700 --> 00:59:36,300
فَعَمِلُوا بِهِ لَمْ يَكُنْ ذَلِكَ سَبَبًا لِلَّوْمِ عَلَيْهِ،

429
00:59:35,700 --> 00:59:36,300
فَكُلٌّ يَعْمَلُ بِمَا بَلَغَهُ مِنَ الْعِلْمِ.

430
00:59:35,700 --> 00:59:36,300
ثُمَّ ذَكَرَ مَا وَقَعَ بِهَذِهِ الرِّسَالَةِ فِي الصِّنَاعَةِ الْعِلْمِيَّةِ وَهُوَ

431
00:59:35,700 --> 00:59:36,300
فِي قَوْلِهِ أَنَّهَا وَقَعَتْ مُرَتَّبَةً فِي فُصُولٍ مُتَرْجَمَةٍ مَسْرُودَةٍ بِعِبَارَةٍ

432
00:59:35,700 --> 00:59:36,300
مُحْكَمَةٍ، فَأَمَّا كَوْنُهَا مُرَتَّبَةً فِي فُصُولٍ مُتَرْجَمَةٍ فَهُوَ بِاعْتِبَارِ كَوْنِهَا

433
00:59:35,700 --> 00:59:36,300
وَقَعَتْ بِتَرَاجِمَ فِي كُلِّ فَصْلٍ يَفْصِلُ الْوَاقِعَ فِيهِ عَمَّا يَتَقَدَّمُهُ

434
00:59:35,700 --> 00:59:36,300
وَمَا يَتْبَعُهُ،

435
00:59:35,700 --> 00:59:36,300
وَالتَّرَاجِمُ هِيَ الْعَنَاوِينُ،

436
00:59:35,700 --> 00:59:36,300
فَالْمُرَادُ أَنَّهُ جَعَلَهَا أَجْزَاءً ذَاتَ عَنَاوِينَ لِيَسْهُلَ جَمْعُ مَا يَتَحَقَّقُ

437
00:59:35,700 --> 00:59:36,300
فِي كُلِّ جُزْءٍ مِنْهَا فَيُرَدُّ إِلَى الْأَصْلِ الْجَامِعِ لَهُ وَهُوَ

438
00:59:35,700 --> 00:59:36,300
الْعُنْوَانُ الَّذِي وُضِعَ رَأْسًا لَهُ فَهِيَ يَسُرُّ بِذَلِكَ قَطُّهَا،

439
00:59:35,700 --> 00:59:36,300
ثُمَّ ذَكَرَ أَنَّهَا وَقَعَتْ مَسْرُودَةً بِعِبَارَةٍ مُحْكَمَةٍ،

440
00:59:35,700 --> 00:59:36,300
وَالْمُحْكَمَةُ الْعِبَارَةُ الْمُحْكَمَةُ هِيَ الْعِبَارَةُ الْجَامِعَةُ الْمَانِعَةُ،

441
00:59:35,700 --> 00:59:36,300
أَمَّا كَوْنُهَا جَامِعَةً فَالْمُرَادُ بِهِ أَنَّهَا تَجْمَعُ مَا يَحْتَاجُ إِلَيْهِ

442
00:59:35,700 --> 00:59:36,300
مِمَّا يَدْخُلُ فِي حَقِيقَتِهَا وَيُرَادُ مِنْهَا فَتَجْمَعُ مَا يَحْتَاجُ إِلَيْهِ

443
00:59:35,700 --> 00:59:36,300
فِي فَهْمِهَا،

444
00:59:35,700 --> 00:59:36,300
وَأَمَّا كَوْنُهَا مَانِعَةً فَهِيَ فَهْمُ كَوْنِهَا لَا تَحْوِي شَيْئًا مِمَّا

445
00:59:35,700 --> 00:59:36,300
يُمْكِنُ بِهِ سُوءُ الْفَهْمِ أَوْ حُصُولُ الْوَهَمِ أَوْ نَحْوِ ذَلِكَ

446
00:59:35,700 --> 00:59:36,300
مِمَّا يَضُرُّ بِطَالِبِ الْعِلْمِ،

447
00:59:35,700 --> 00:59:36,300
فَهِيَ مَضْبُوطَةٌ عَلَى الْمُرَادِ مِنْهَا تُوفِي بِهِ.

448
00:59:35,700 --> 00:59:36,300
ثُمَّ دَعَا لِنَفْسِهِ وَلِغَيْرِهِ فَأَصَابَ مِنْ ذَلِكَ جُمْلَةً مِنَ الْأَمْرِ،

449
00:59:35,700 --> 00:59:36,300
أَوَّلُهَا بِوَاسِعِ رَحْمَتِهِ،

450
00:59:35,700 --> 00:59:36,300
وَالْمَعْرُوفُ فِي خِطَابِ الشَّرْعِ الدُّعَاءُ بِالتَّقَبُّلِ لَا بِالْقَبُولِ،

451
00:59:35,700 --> 00:59:36,300
وَلَمْ يَزَلْ هَذَا دُعَاءَ الْأَنْبِيَاءِ فِي الْقُرْآنِ،

452
00:59:35,700 --> 00:59:36,300
فَتَجِدُ فِيهِ قَوْلَ اللَّهِ تَعَالَى: ﴿رَبَّنَا وَتَقَبَّلْ دُعَاءِ﴾،

453
00:59:35,700 --> 00:59:36,300
إِلَى غَيْرِ ذَلِكَ مِنَ الْآيَاتِ الدَّالَّةِ عَلَى هَذَا الْمَعْنَى،

454
00:59:35,700 --> 00:59:36,300
وَمُوجِبُ تَضَافُرِ الْأَنْبِيَاءِ عَلَى الدُّعَاءِ بِالتَّقَبُّلِ لَا بِالْقَبُولِ أَنَّهُ أَبْلَغُ

455
00:59:35,700 --> 00:59:36,300
مِنَ الْقَبُولِ،

456
00:59:35,700 --> 00:59:36,300
فَإِنَّ الْقَبُولَ إِنَّمَا يُفِيدُ مَعْنًى هُوَ صِحَّةُ الْعَمَلِ أَوْ وُقُوعُ

457
00:59:35,700 --> 00:59:36,300
الْجَزَاءِ عَلَيْهِ،

458
00:59:35,700 --> 00:59:36,300
أَمَّا التَّقَبُّلُ فَإِنَّهُ يُفِيدُ مَعَ ذَلِكَ مَحَبَّةَ اللَّهِ لِلْعَبْدِ وَرِضَاهُ

459
00:59:35,700 --> 00:59:36,300
عَنْهُ، فَهُوَ قَدْرٌ زَائِدٌ عَنِ الْقَبُولِ بِأَثَرٍ عَظِيمٍ لَهُ وَهُوَ

460
00:59:35,700 --> 00:59:36,300
مَحَبَّةٌ لِلْعَبْدِ وَرِضَاهُ عَنْهُ فَكَانَ الدُّعَاءُ بِهِ أَكْمَلَ،

461
00:59:35,700 --> 00:59:36,300
ثُمَّ أَعْلَقَ ذَلِكَ عَلَى رَحْمَةِ اللَّهِ عَزَّ وَجَلَّ مَعَ وَصْفِهَا

462
00:59:35,700 --> 00:59:36,300
بِكَوْنِهَا وَاسِعَةً وَوَافَقَهُ مِنْ غَالِبِ سِيَاقِ الْخِطَابِ الشَّرْعِيِّ فِي الْقُرْآنِ،

463
00:59:35,700 --> 00:59:36,300
وَمِنْهُ قَوْلُهُ تَعَالَى: ﴿وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ﴾،

464
00:59:35,700 --> 00:59:36,300
هِيَ صَرِيحَةُ الدَّلَالَةِ عَلَى هَذَا الْمَعْنَى،

465
00:59:35,700 --> 00:59:36,300
وَكَذَا دَعَا أَنْ يَنْفَعَ اللَّهُ بِهَا مَنْ يَتَلَقَّاهَا عَنْهُ وَلَمْ

466
00:59:35,700 --> 00:59:36,300
يُصَرِّحْ بِهِ لِلْعِلْمِ بِهِ،

467
00:59:35,700 --> 00:59:36,300
وَعَلَّقَ ذَلِكَ عَلَى فَضْلِ اللَّهِ عَزَّ وَجَلَّ مَعَ وَصْفِهِ بِالْعَظَمَةِ،

468
00:59:35,700 --> 00:59:36,300
وَوَقَعَ ذَلِكَ مِنْهُ أَيْضًا مُوَافَقَةً لِغَالِبِهِ الْخِطَابِ الْقُرْآنِيِّ كَمَا فِي

469
00:59:35,700 --> 00:59:36,300
قَوْلِهِ تَعَالَى: ﴿وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ﴾،

470
00:59:35,700 --> 00:59:36,300
وَالْمُلَاحَظُ فِي هَذَا السِّيَاقِ أَنَّ الْمُصَنِّفُ قَدَّمَ الدُّعَاءَ لِنَفْسِهِ ثُمَّ

471
00:59:35,700 --> 00:59:36,300
دَعَا لِغَيْرِهِ،

472
00:59:35,700 --> 00:59:36,300
فَإِنَّهُ دَعَا لِنَفْسِهِ بِتَقَبُّلِ هَذِهِ الرِّسَالَةِ ثُمَّ دَعَا لِغَيْرِهِ أَنْ

473
00:59:35,700 --> 00:59:36,300
يَنْتَفِعَ بِهَا،

474
00:59:35,700 --> 00:59:36,300
وَهَذَا هُوَ الْمُوَافِقُ لِسُنَّةِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَمَا

475
00:59:35,700 --> 00:59:36,300
صَحَّ عَنْ أَنَسِ بْنِ مَالِكٍ فِي [الصَّحِيحِ] أَنَّ النَّبِيَّ صَلَّى

476
00:59:35,700 --> 00:59:36,300
اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ إِذَا دَعَا لِنَفْسِهِ وَلِغَيْرِهِ ابْتَدَى بِنَفْسِهِ

477
00:59:35,700 --> 00:59:36,300
أَوَّلًا لِأَنَّ الْعَبْدَ أَعْلَمُ بِحَاجَةِ نَفْسِهِ،

478
00:59:35,700 --> 00:59:36,300
وَلَا يُؤْثِرُ عَلَى نَفْسِهِ أَحَدًا فِي مَقَامَاتِ الْقُرْبِ مِنَ اللَّهِ

479
00:59:35,700 --> 00:59:36,300
عَزَّ وَجَلَّ وَالْعِبَادَةِ لَهُ سُبْحَانَهُ،

480
00:59:35,700 --> 00:59:36,300
وَمِنْهَا مَقَامُ الدُّعَاءِ،

481
00:59:35,700 --> 00:59:36,300
فَالسُّنَّةُ أَنْ يُقَدِّمَ الْعَبْدُ الدُّعَاءُ لِنَفْسِهِ أَوَّلًا ثُمَّ يَدْعُو لِغَيْرِهِ

482
00:59:35,700 --> 00:59:36,300
إِنْ وَقَعَ مِنْهُ دُعَاؤُهُ لِنَفْسِهِ وَلِغَيْرِهِ فِي عِبَارَةٍ وَاحِدَةٍ.

483
00:59:35,700 --> 00:59:36,300
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: فَصْلٌ: رَجَبٌ وَشَعْبَانُ،

484
00:59:35,700 --> 00:59:36,300
وَرَجَبٌ هُوَ الشَّهْرُ الْكَائِنُ بَيْنَ جُمَادَى الْآخِرَةِ وَشَعْبَانَ،

485
00:59:35,700 --> 00:59:36,300
وَلَا يَخْتَصُّ بِعَمَلٍ مِنْ صِيَامٍ أَوْ غَيْرِهِ فَيُبَاحُ صِيَامُهُ كَغَيْرِهِ

486
00:59:35,700 --> 00:59:36,300
إِلَّا تَهَيُّؤًا لِرَمَضَانَ فَيُسْتَحَبُّ،

487
00:59:35,700 --> 00:59:36,300
وَيُكْرَهُ تَخْصِيصُهُ بِصِيَامٍ مَا لَمْ يَتَّخِذْهُ كُنَّةً فَإِنَّهُ يَحْرُمُ.

488
00:59:35,700 --> 00:59:36,300
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَفِي هَذِهِ الْجُمْلَةِ بَيَّنَ الْمُصَنِّفُ فَغْوَ

489
00:59:35,700 --> 00:59:36,300
اللَّهِ فِي كَلَامِهِ مَا يَتَعَلَّقُ بِحُكْمِ الصِّيَامِ رَجَبٍ،

490
00:59:35,700 --> 00:59:36,300
إِنَّ هَذَا الْفَصْلَ مُتَعَلِّقٌ بِحُكْمِ الصِّيَامِ رَجَبٍ وَحُكْمِ الصِّيَامِ شَعْبَانَ،

491
00:59:35,700 --> 00:59:36,300
وَمُوجِبُ تَقْدِيمِ الْكَلَامِ فِي صِيَامِ رَجَبٍ وَكَوْنُهُ أَوَّلَ مَا يَقَعُ

492
00:59:35,700 --> 00:59:36,300
فِيهِ الْخَلْطُ فِي أَحْوَالِ النَّاسِ فِيمَا يَتَعَلَّقُ بِأَحْوَالِ الصِّيَامِ فِيهِ

493
00:59:35,700 --> 00:59:36,300
وَغَيْرِ ذَلِكَ مِنَ الْأَعْمَالِ مِمَّا يَحْتَاجُ إِلَى بَيَانِهِ فِي مِثْلِ

494
00:59:35,700 --> 00:59:36,300
هَذَا الْكِتَابِ،

495
00:59:35,700 --> 00:59:36,300
فَأَقُولُ وَبِاللَّهِ التَّوْفِيقُ: أَنَّ صِيَامَ رَجَبٍ هُوَ صِيَامُ الشَّهْرِ الْوَاقِعِ

496
00:59:35,700 --> 00:59:36,300
بَيْنَ جُمَادَى الْآخِرَةِ وَشَعْبَانَ،

497
00:59:35,700 --> 00:59:36,300
فَالْأَفْصَحُ فِيهِ شُهُورٌ وَخِلَافُ الْمَعْهُودِ فِيهَا مِنَ النَّاسِ،

498
00:59:35,700 --> 00:59:36,300
إِذَا أَرَدْتَ أَنْ تَقِفَ عَلَى شَيْءٍ مِنَ الْفَصِيحِ فِي الْإِتْيَانِ

499
00:59:35,700 --> 00:59:36,300
بِاسْمِ شَهْرٍ مِنَ الشُّهُورِ فَرَاجِعْ فِيهِ كَلَامَ أَهْلِ الْعَرَبِيَّةِ،

500
00:59:35,700 --> 00:59:36,300
وَبِخَصِّ شَهْرِ جُمَادَى فَإِنَّهُ يُقَالُ فِيهِ جُمَادَى الْآخِرَةِ لَا جُمَادَى.

501
00:59:35,700 --> 00:59:36,300
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: الثَّانِيَةُ فَالأُولَى أَفْصَحُ،

502
00:59:35,700 --> 00:59:36,300
وَرَجَبٌ هَذَا هُوَ شَهْرٌ أَفْصَحُ الْمَعْرُوفُ،

503
00:59:35,700 --> 00:59:36,300
وَتَعْرِيفُهُ بِهَذِهِ الْجُمْلَةِ هُوَ مُنَاسَبَةٌ لِمَا وَقَعَ فِي [الصَّحِيحِ] مِنْ

504
00:59:35,700 --> 00:59:36,300
قَوْلِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: [لَرَجَبُ هُوَ رَجَبُ مُضَرَ

505
00:59:35,700 --> 00:59:36,300
الَّذِي بَيْنَ جُمَادَى الآخِرَةِ وَشَعْبَانَ]،

506
00:59:35,700 --> 00:59:36,300
وَلِهَذَا وَقَعَ تَعْرِيفُهُ عَلَى هَذِهِ الْهَيْئَةِ؛ ثُمَّ ذَكَرَ الْمُصَنِّفُ وَثَّقَهُ

507
00:59:35,700 --> 00:59:36,300
اللَّهُ أَنَّهُ لَا يَخْتَصُّ بِعَمَلٍ مِنْ صِيَامٍ أَوْ غَيْرِهِ،

508
00:59:35,700 --> 00:59:36,300
وَوَجْهُ ذَلِكَ أَنَّ شَهْرَ رَجَبٍ لَيْسَ مُعَظَّمًا فِي الشَّرْعِ إِلَّا

509
00:59:35,700 --> 00:59:36,300
بِكَوْنِهِ شَهْرًا مِنَ الأَشْهُرِ الْحُرُمِ،

510
00:59:35,700 --> 00:59:36,300
وَالأَشْهُرُ الْحُرُمُ فِي أَصَحِّ قَوْلَيْ أَهْلِ الْعِلْمِ لَا تُعَظَّمُ بِعَمَلٍ

511
00:59:35,700 --> 00:59:36,300
وَلَا تَخْتَصُّ بِهِ،

512
00:59:35,700 --> 00:59:36,300
فَإِنَّ وُرُودَهَا فِي خِطَابِ الشَّرْعِ وَقَعَ فِي سِيَاقِ التَّحْذِيرِ مِنَ

513
00:59:35,700 --> 00:59:36,300
الْمَعْصِيَةِ فِيهَا كَمَا بِقَوْلِهِ تَعَالَى بَعْدَ ذِكْرِ الأَشْهُرِ الْحُرُمِ: ﴿فَلَا

514
00:59:35,700 --> 00:59:36,300
تَظْلِمُوا فِيهِنَّ أَنْفُسَكُمْ﴾،

515
00:59:35,700 --> 00:59:36,300
فَفِيهِ النَّهْيُ أَنَّهُ إِيقَاعُ الْمَعْصِيَةِ فِيهَا لِأَنَّهَا أَعْظَمُ عِنْدَ اللَّهِ

516
00:59:35,700 --> 00:59:36,300
مِنْ إِيقَاعِهَا فِي غَيْرِ هَذِهِ الأَشْهُرِ،

517
00:59:35,700 --> 00:59:36,300
وَلَيْسَ ذَلِكَ حَثًّا عَلَى الطَّاعَةِ فِي شَيْءٍ فِي أَصَحِّ قَوْلَيْ

518
00:59:35,700 --> 00:59:36,300
أَهْلِ الْعِلْمِ،

519
00:59:35,700 --> 00:59:36,300
فَإِنَّ هَذِهِ الأَشْهُرَ لَا تَخْتَصُّ بِطَاعَةٍ وَلَا يَتَعَلَّقُ بِهَا شَيْءٌ

520
00:59:35,700 --> 00:59:36,300
مِنْ ذَلِكَ؛ ثُمَّ بَيَّنَ أَنَّ صِيَامَ رَجَبٍ عَلَى هَذِهِ الْحَالِ

521
00:59:35,700 --> 00:59:36,300
هُوَ مِنَ الْمُبَاحِ،

522
00:59:35,700 --> 00:59:36,300
هُوَ كَصِيَامِ صَفَرٍ وَكَصِيَامِ جُمَادَى الأُولَى وَنَحْوِ ذَلِكَ مِنَ الشُّهُورِ،

523
00:59:35,700 --> 00:59:36,300
فَلَا يَخْتَصُّ رَجَبٌ بِفَضْلِ صِيَامٍ وَلَا بِاسْتِحْبَابِ فِعْلِهِ،

524
00:59:35,700 --> 00:59:36,300
وَإِنَّمَا هُوَ مِنْ جُمْلَةِ الْمُبَاحِ كَغَيْرِهِ إِلَّا تَهَيُّؤًا لِرَمَضَانَ،

525
00:59:35,700 --> 00:59:36,300
فَإِنَّ فِي كَلَامِ السَّلَافِ عِبَارَاتٍ مُتَعَدِّدَةً تَدُلُّ عَلَى أَنَّهُ مِنَ

526
00:59:35,700 --> 00:59:36,300
الْمُسْتَحَبِّ لِلْعَبْدِ أَنْ لَا يُقْبِلَ عَلَى رَمَضَانَ إِلَّا وَقَدْ هَيَّأَ

527
00:59:35,700 --> 00:59:36,300
نَفْسَهُ لَهُ بِأَنْوَاعٍ مِنَ الْعِبَادَاتِ أَخَصُّهَا مَا يَقَعُ فِي رَمَضَانَ

528
00:59:35,700 --> 00:59:36,300
كَالصِّيَامِ، فَإِنَّ الْعَبْدَ إِذَا أَمْكَنَ لَهُ أَنْ يَصُومَ فِي رَجَبٍ

529
00:59:35,700 --> 00:59:36,300
ثُمَّ زَادَ فِي ذَلِكَ عَلَى مَا يَأْتِي بَيَانُهُ إِنْ شَاءَ

530
00:59:35,700 --> 00:59:36,300
اللَّهُ تَعَالَى فَصَامَ فِي شَعْبَانَ أَمْكَنَ لَهُ أَنْ يُوقِعَ الصِّيَامَ

531
00:59:35,700 --> 00:59:36,300
فِي رَمَضَانَ دُونَ تَكَلُّفٍ وَمَشَقَّةٍ،

532
00:59:35,700 --> 00:59:36,300
تُسْتَطَاعُ بِذَلِكَ جَمْعُ نَفْسِهِ عَلَى الصِّيَامِ وَنَفْعُ نَفْسِهِ بِهِ،

533
00:59:35,700 --> 00:59:36,300
أَمَّا أَنْ يَهْجُمَ عَلَى رَمَضَانَ وَهُوَ مُنْذُ قَرَابَةِ الْعَامِ لَمْ

534
00:59:35,700 --> 00:59:36,300
يَصُمْ مَرَّةً فَهَذَا شَيْءٌ يُضْعِفُ إِقْبَالَهُ وَيُثْقِلُ سَيْرَهُ،

535
00:59:35,700 --> 00:59:36,300
وَمِنْ هُنَا ذَكَرَ جَمَاعَةٌ مِنَ السَّلَفِ هُوَ الشَّهْرُ الَّذِي يَكُونُ

536
00:59:35,700 --> 00:59:36,300
فِيهِ عَمَلُ الْمَرْءِ بِمَنْزِلَةِ الْغَرْسِ،

537
00:59:35,700 --> 00:59:36,300
وَشَعْبَانُ يَكُونُ فِيهِ الْعَمَلُ بِمَنْزِلَةِ السَّقْيِ،

538
00:59:35,700 --> 00:59:36,300
ثُمَّ يَكُونُ فِي رَمَضَانَ الثَّمَرَةُ الَّتِي تَنْتُجُ لِلْعَبْدِ مِنْ أَثَرِ

539
00:59:35,700 --> 00:59:36,300
الْغَرْسِ ثُمَّ السَّقْيِ،

540
00:59:35,700 --> 00:59:36,300
فَإِنَّمَا يَحْصُرُ الْعَبْدُ فِي رَمَضَانَ مَا قَدَّمَ لَهُ فِي رَجَبٍ

541
00:59:35,700 --> 00:59:36,300
وَشَعْبَانَ، وَمِنْ هُنَا يُسْتَحَبُّ أَنْ يَقَعَ صِيَامٌ لِلْعَبْدِ فِي رَمَضَانَ

542
00:59:35,700 --> 00:59:36,300
ثُمَّ فِي شَعْبَانَ تَهَيُّؤًا لِرَمَضَانَ فَهَذَا يُسْتَحَبُّ؛ ثُمَّ ذَكَرَ حُكْمًا

543
00:59:35,700 --> 00:59:36,300
ثَالِثًا وَهُوَ حُكْمُ تَخْصِيصِ رَجَبٍ بِصِيَامٍ كَأَنْ يُقَرِّرَ أَنْ يَصُومَ

544
00:59:35,700 --> 00:59:36,300
أُسْبُوعًا فِي رَجَبٍ ثُمَّ يَتْرُكُ الصِّيَامَ إِلَى أَنْ يَدْخُلَ شَهْرُ

545
00:59:35,700 --> 00:59:36,300
رَمَضَانَ فَهَذَا مَكْرُوهٌ،

546
00:59:35,700 --> 00:59:36,300
هَذَا مَكْرُوهٌ فِي قَوْلِ جُمْهُورِ أَهْلِ الْعِلْمِ،

547
00:59:35,700 --> 00:59:36,300
عِنْدَ الْحَنَابِلَةِ وَجْهٌ بِالتَّحْرِيمِ اخْتَارَهُ جَمَاعَةٌ مِنَ الْمُحَقِّقِينَ كَـ [ابْنِ

548
00:59:35,700 --> 00:59:36,300
تَيْمِيَّةَ الْحَفِيدِ] وَفِيهِ نَظَرٌ،

549
00:59:35,700 --> 00:59:36,300
وَالأَجْهَهُ الْكَرَاهَةُ،

550
00:59:35,700 --> 00:59:36,300
فَيُكْرَهُ لِلْعَبْدِ أَنْ يُخَصِّصَ شَهْرَ رَجَبٍ بِصِيَامٍ مَا لَمْ يُتَّخَذْ

551
00:59:35,700 --> 00:59:36,300
سُنَّةً فَإِنَّهُ يَحْرُمُ،

552
00:59:35,700 --> 00:59:36,300
وَالْمُرَادُ بِكَوْنِهِ يُتَّخَذُ سُنَّةً أَيْ يَقَعُ مِنْهُ شَابَهَهُ لِلسُّنَّةِ فَتَجِدُهُ

553
00:59:35,700 --> 00:59:36,300
يَعْتَقِدُ فَضْلَهُ أَوْ يُدَاوِمُ عَلَيْهِ أَوْ يَدْعُو الْخَلْقَ إِلَيْهِ أَوْ

554
00:59:35,700 --> 00:59:36,300
يُعَاتِبُ مَنْ تَرَكَهُ وَيَصِفُهُ بِنَقْصِ دِينِهِ وَضَعْفِ إِيمَانِهِ وَنَحْوِ ذَلِكَ،

555
00:59:35,700 --> 00:59:36,300
هَذِهِ أَحْوَالٌ لَا تَكُونُ إِلَّا فِي السُّنَّةِ،

556
00:59:35,700 --> 00:59:36,300
فَعَامَلَ بِهَذَا صِيَامَ رَجَبٍ مُعَامَلَةَ السُّننَةِ وَلَا شَكَّ أَنَّ هَذِهِ

557
00:59:35,700 --> 00:59:36,300
بِدْعَةٌ فَيَقْوَى الْقَوْلُ بِالتَّحْرِيمِ حِينَئِذٍ؛ وَبِهِ تَعْلَمُ أَنَّ صِيَامَ رَجَبٍ

558
00:59:35,700 --> 00:59:36,300
لَا يَتَعَلَّقُ بِهِ حُكْمٌ وَاحِدٌ وَإِنَّمَا يَكُونُ عَلَى أَرْبَعَةِ أَحْكَامٍ:

559
00:59:35,700 --> 00:59:36,300
الأَوَّلُ: أَنْ يَكُونَ مُبَاحًا،

560
00:59:35,700 --> 00:59:36,300
وَهَذَا إِذَا صَامَهُ كَمَا يَصُومُ غَيْرَهُ.

561
00:59:35,700 --> 00:59:36,300
وَالثَّانِي: أَنْ يَكُونَ مُسْتَحَبًّا،

562
00:59:35,700 --> 00:59:36,300
وَهَذَا إِذَا وَقَعَ مِنْهُ تَهَيُّؤًا لِرَمَضَانَ.

563
00:59:35,700 --> 00:59:36,300
وَالثَّالِثُ: أَنْ يَكُونَ مَكْرُوهًا،

564
00:59:35,700 --> 00:59:36,300
وَهَذَا إِذَا وَقَعَ مِنْهُ تَخْصِيصًا لَهُ دُونَ غَيْرِهِ.

565
00:59:35,700 --> 00:59:36,300
وَالرَّابِعُ: أَنْ يَكُونَ حَرَامًا،

566
00:59:35,700 --> 00:59:36,300
وَهَذَا إِذَا وَقَعَ مِنْهُ مَعَ اتِّخَاذِهِ ذَلِكَ سُنَّةً،

567
00:59:35,700 --> 00:59:36,300
وَذَلِكَ يُعْرَفُ بِمَا يَحْتَفُّ بِعَمَلِهِ مِنَ الْقَرَائِنِ الدَّالَّةِ عَلَى كَوْنِهِ

568
00:59:35,700 --> 00:59:36,300
يَتَّخِذُ هَذَا الْعَمَلَ سُنَّةً فَيَكُونُ حِينَئِذٍ مِنَ الْبِدَعِ.

569
00:59:35,700 --> 00:59:36,300
وَبِهِ يَظْهَرُ لَكَ أَقْوَالُ الْفُقَهَاءِ بَيْنَ الْفُقَهَاءِ يَنْبَغِي فِيهِ أَنْ

570
00:59:35,700 --> 00:59:36,300
يُرْجَعَ إِلَى مَنَاطِ الْحُكْمِ وَيُنْظَرَ فِيهِ إِلَى عِبَارَاتِهِمْ وَاعْتِبَارَاتِهِمْ،

571
00:59:35,700 --> 00:59:36,300
فَلَا تُقَرِّرْ أَنَّ صِيَامَ رَجَبٍ مَكْرُوهٌ أَوْ صِيَامَ رَجَبٍ حَرَامٌ

572
00:59:35,700 --> 00:59:36,300
دُونَ النَّظَرِ إِلَى صُورَةِ الْمَسْأَلَةِ وَحَقِيقَتِهَا وَحَالِ هَذَا الصَّائِمِ وَمَا

573
00:59:35,700 --> 00:59:36,300
يَتَعَلَّقُ بِهِ،

574
00:59:35,700 --> 00:59:36,300
فَإِنَّ هَذَا قَوْلٌ عَنِ اللَّهِ بِغَيْرِ عِلْمٍ،

575
00:59:35,700 --> 00:59:36,300
فَيَنْبَغِي التَّرَيُّثُ فِي الْحُكْمِ وَمُرَاجَعَةُ أَحْوَالِ الْخَلْقِ فِي أَحْكَامِ الْفُقَهَاءِ

576
00:59:35,700 --> 00:59:36,300
بِمَا يُمْكِنُ بِهِ الْحُكْمُ عَلَى مَا تَرَاهُ مِنْهُمْ؛ وَشَعْبَانُ هُوَ

577
00:59:35,700 --> 00:59:36,300
الشَّهْرُ الَّذِي يَتَقَدَّمُ رَمَضَانَ وَيُسْتَحَبُّ صِيَامُهُ أَكْثَرَ وَلَا يُكْرَهُ صِيَامُهُ

578
00:59:35,700 --> 00:59:36,300
بَعْدَ انْتِصَافِهِ وَلَوْ لِغَيْرِ عَادَةٍ،

579
00:59:35,700 --> 00:59:36,300
وَيَحْرُمُ تَقَدُّمُ رَمَضَانَ بِيَوْمٍ أَوْ يَوْمَيْنِ مِنْهُ،

580
00:59:35,700 --> 00:59:36,300
وَكَذَا صِيَامُ يَوْمِ شَكِّهِ،

581
00:59:35,700 --> 00:59:36,300
وَيَوْمُ الشَّكِّ هُوَ يَوْمُ الثَّلَاثِينَ مِنْ شَعْبَانَ الَّذِي تَكُونُ لَيْلَتُهُ

582
00:59:35,700 --> 00:59:36,300
صَحْوَةً لَا غَيْمَ فِيهَا وَلَا قَطْرَ؛ أَشَارَ الْمُصَنِّفُ أَخُونَا إِلَى

583
00:59:35,700 --> 00:59:36,300
حُكْمِ صِيَامِ شَعْبَانَ بَعْدَ مَا قَدَّمَ تَعْرِيفَهُ فَقَالَ: هُوَ الشَّهْرُ

584
00:59:35,700 --> 00:59:36,300
الَّذِي يَتَقَدَّمُ رَمَضَانَ أَيْ يَسْبِقُهُ،

585
00:59:35,700 --> 00:59:36,300
فَهُوَ الشَّهْرُ الَّذِي يَتَقَدَّمُ رَمَضَانَ مُبَاشَرَةً،

586
00:59:35,700 --> 00:59:36,300
وَذَكَرَ لَهُ جُمْلَةً مِنَ الأَحْكَامِ فَابْتَدَى بِقَوْلِهِ: وَيُسْتَحَبُّ صِيَامُ أَكْثَرِهِ،

587
00:59:35,700 --> 00:59:36,300
فَهُوَ الَّذِي رَوَتْهُ عَائِشَةُ فِي [الصَّحِيحِ] عَنِ النَّبِيِّ صَلَّى اللَّهُ

588
00:59:35,700 --> 00:59:36,300
عَلَيْهِ وَسَلَّمَ فَقَالَتْ: [كَانَ يَصُومُ شَعْبَانَ كُلَّهُ،

589
00:59:35,700 --> 00:59:36,300
كَانَ يَصُومُهُ إِلَّا قَلِيلَهُ]،

590
00:59:35,700 --> 00:59:36,300
فَفِيهِ بَيَانُ أَنَّ كُلَّهُ الْمَذْكُورَةَ فِي الْحَدِيثِ إِنَّمَا هِيَ كُلِّيَّةٌ

591
00:59:35,700 --> 00:59:36,300
أَغْلَبِيَّةٌ لَا كُلَّةٌ مُطَّرِدَةٌ،

592
00:59:35,700 --> 00:59:36,300
فَلَا تَضُمُّ جَمِيعَ الأَفْرَادِ الْمُنْدَرِجَةِ فِي اسْمِ هَذَا الشَّهْرِ وَإِنَّمَا

593
00:59:35,700 --> 00:59:36,300
تَضُمُّ أَغْلَبَهُ،

594
00:59:35,700 --> 00:59:36,300
وَلِهَذَا وَقَعَ تَفْسِيرُ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا لِهَذِهِ الْجُمْلَةِ بِقَوْلِهَا:

595
00:59:35,700 --> 00:59:36,300
[كَانَ يَصُومُهُ إِلَّا قَلِيلَهُ]،

596
00:59:35,700 --> 00:59:36,300
فَإِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَصُمْ جَمِيعَ شَعْبَانَ

597
00:59:35,700 --> 00:59:36,300
فِي أَصَحِّ الْقَوْلَيْنِ بِمَا ظَهَرَ لَكَ مِنْ دَلَالَةِ هَذَا الْحَدِيثِ

598
00:59:35,700 --> 00:59:36,300
وَغَيْرِهِ، فَيُسْتَحَبُّ صِيَامُ أَكْثَرِ شَهْرِ شَعْبَانَ؛ وَقَالَ الْعُلَمَاءُ رَحِمَهُمُ اللَّهُ

599
00:59:35,700 --> 00:59:36,300
فِي عِلَّةِ إِكْثَارِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الصِّيَامِ

600
00:59:35,700 --> 00:59:36,300
فِي شَعْبَانَ،

601
00:59:35,700 --> 00:59:36,300
وَالَّذِي يَتَرَجَّحُ وَاللَّهُ أَعْلَمُ أَنَّ مُوجِبَ ذَلِكَ أَمْرَانِ اثْنَانِ: الأَوَّلُ:

602
00:59:35,700 --> 00:59:36,300
أَنَّ رَفْعَ الأَعْمَالِ السَّنَوِيَّ يَقَعُ فِي شَهْرِ شَعْبَانَ،

603
00:59:35,700 --> 00:59:36,300
أَيْ أَنَّ الأَعْمَالُ تُرْفَعُ إِلَى اللَّهِ عَزَّ وَجَلَّ كُلَّ عَامٍ

604
00:59:35,700 --> 00:59:36,300
وَالْوَقْتُ الَّذِي تُرْفَعُ فِيهِ هُوَ شَهْرُ شَعْبَانَ،

605
00:59:35,700 --> 00:59:36,300
وَكَانَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يُحِبُّ أَنْ يُرْفَعَ عَمَلُهُ

606
00:59:35,700 --> 00:59:36,300
وَهُوَ صَائِمٌ لَعَلَّ هَذَا أَنْ يَكُونَ أَدْعَى إِلَى تَقَبُّلِ اللَّهِ

607
00:59:35,700 --> 00:59:36,300
عَزَّ وَجَلَّ لِهَذَا الْعَمَلِ،

608
00:59:35,700 --> 00:59:36,300
فَكَانَ يَصُومُ شَعْبَانَ بُغْيَةَ ذَلِكَ وَهُوَ الَّذِي ثَبَتَتْ بِهِ الأَحَادِيثُ.

609
00:59:35,700 --> 00:59:36,300
وَالثَّانِي: أَنَّ شَعْبَانَ مُتَقَدِّمٌ عَنْ رَمَضَانَ وَهُوَ مِمَّا يُسْتَعَدُّ بِهِ

610
00:59:35,700 --> 00:59:36,300
وَيَتَهَيَّأُ اسْتِقْبَالًا لِرَمَضَانَ،

611
00:59:35,700 --> 00:59:36,300
فَكَانَ مِمَّا يَقَعُ بِذَلِكَ الِاسْتِقْبَالِ هَذَا الشَّهْرِ أَنْ يُكْثِرَ الْعَبْدُ

612
00:59:35,700 --> 00:59:36,300
مِنَ الصِّيَامِ فِي شَهْرِ شَعْبَانَ لِيَكُونَ ذَلِكَ حَامِلًا لَهُ عَلَى

613
00:59:35,700 --> 00:59:36,300
الإِقْبَالِ عَلَى صِيَامِ رَمَضَانَ دُونَ أَنْ يَذْكُرَ ذَلِكَ عَنْهُ بِمَا

614
00:59:35,700 --> 00:59:36,300
يُضْعِفُهُ. ثُمَّ ذَكَرَ بَعْدَهُ أَنَّهُ لَا يُكْرَهُ صِيَامٌ بَعْدَ انْتِصَافِهِ

615
00:59:35,700 --> 00:59:36,300
أَيْ بَعْدَ بُلُوغِ لَيْلَةِ النِّصْفِ مِنْ شَعْبَانَ،

616
00:59:35,700 --> 00:59:36,300
فَلَا يُكْرَهُ صِيَامٌ بَعْدَهَا خِلَافًا لِلْمَشْهُورِ مِنْ كَلَامِ جَمَاعَةٍ مِنَ

617
00:59:35,700 --> 00:59:36,300
الْعُلَمَاءِ، فَإِنَّ لِلْعُلَمَاءِ فِي هَذِهِ الْمَسْأَلَةِ قَوْلَانِ اثْنَانِ: الأَوَّلُ: أَنَّهُ

618
00:59:35,700 --> 00:59:36,300
يُكْرَهُ الصِّيَامُ إِذَا انْتَصَفَ شَعْبَانُ،

619
00:59:35,700 --> 00:59:36,300
وَيُكْرَهُ لِلْعَبْدِ إِذَا بَلَغَ النِّصْفَ مِنْ شَعْبَانَ أَنْ يَصُومَ بَعْدَ

620
00:59:35,700 --> 00:59:36,300
هَذَا النِّصْفِ،

621
00:59:35,700 --> 00:59:36,300
أَنْ يَصُومَ السَّادِسَ عَشَرَ أَوِ السَّابِعَ عَشَرَ أَوْ نَحْوَ ذَلِكَ

622
00:59:35,700 --> 00:59:36,300
مِمَّا يُسْتَقْبَلُ مِنْ أَيَّامِ شَعْبَانَ حَتَّى يَدْخُلَ رَمَضَانُ.

623
00:59:35,700 --> 00:59:36,300
وَالْقَوْلُ الآخَرُ: أَنَّ ذَلِكَ لَا يُكْرَهُ،

624
00:59:35,700 --> 00:59:36,300
وَعُمْدَةُ أَصْحَابِ الْقَوْلِ الأَوَّلِ هُوَ الْحَدِيثُ الَّذِي رَوَاهُ أَبُو هُرَيْرَةَ

625
00:59:35,700 --> 00:59:36,300
عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَفِيهِ النَّهْيُ عَنْ صِيَامِ

626
00:59:35,700 --> 00:59:36,300
الْعَبْدِ النِّصْفَ مِنْ شَعْبَانَ فِيمَا وَرَاءَهُ حَتَّى يَدْخُلَ رَمَضَانُ،

627
00:59:35,700 --> 00:59:36,300
قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: [إِذَا بَلَغْتُمُ النِّصْفَ مِنْ

628
00:59:35,700 --> 00:59:36,300
شَعْبَانَ فَأَمْسِكُوا عَنِ الصِّيَامِ حَتَّى يَدْخُلَ رَمَضَانُ]،

629
00:59:35,700 --> 00:59:36,300
وَحَدِيثٌ رَوَاهُ أَبُو دَاوُدَ وَالتِّرْمِذِيُّ وَإِسْنَادُهُ مُنْكَرٌ،

630
00:59:35,700 --> 00:59:36,300
فَإِنَّ هَذَا الْحَدِيثَ أَنْكَرَهُ جَمَاعَةٌ مِنَ الْحُفَّاظِ الْكِبَارِ كَالأَمَامِ أَحْمَدَ

631
00:59:35,700 --> 00:59:36,300
وَأَبِي حَاتِمٍ الرَّازِيِّ وَغَيْرِهِمَا،

632
00:59:35,700 --> 00:59:36,300
هُوَ حَدِيثٌ لَا يَثْبُتُ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

633
00:59:35,700 --> 00:59:36,300
وَبِهَذَا يَكُونُ عَلَى الأَصْلِ فِي الصِّيَامِ الإِبَاحَةُ،

634
00:59:35,700 --> 00:59:36,300
فَلَا يُكْرَهُ لِلْعَبْدِ أَنْ يَصُومَ بَعْدَ لَيْلَةِ نِصْفٍ مِنْ شَعْبَانَ

635
00:59:35,700 --> 00:59:36,300
إِذْ لَا دَلِيلَ عَلَى الْكَرَاهَةِ؛ وَقَالَ: وَلَوْ لِغَيْرِ عَادَةٍ،

636
00:59:35,700 --> 00:59:36,300
فَإِنَّ الْقَائِلِينَ بِكَرَاهَةِ الصِّيَامِ بَعْدَ النِّصْفِ مِنْ شَعْبَانَ يَجْعَلُونَ حَالَ

637
00:59:35,700 --> 00:59:36,300
الْمُعْتَادِ لِصِيَامٍ قَبْلَهُ غَيْرَ عَادَةٍ،

638
00:59:35,700 --> 00:59:36,300
يَقُولُونَ: إِنِ اعْتَادَ صِيَامًا ثُمَّ أَرَادَ أَنْ يُتِمَّهُ بَعْدَ النِّصْفِ

639
00:59:35,700 --> 00:59:36,300
مِنْ شَعْبَانَ فَلَهُ ذَلِكَ دُونَ ابْتِدَاءِ صِيَامٍ جَدِيدٍ،

640
00:59:35,700 --> 00:59:36,300
وَالرَّاجِحُ كَمَا ذَكَرْنَا أَنَّهُ لَا يُكْرَهُ لَهُ لِيَصُومَ بَعْدَ النِّصْفِ

641
00:59:35,700 --> 00:59:36,300
مِنْ شَعْبَانَ وَلَوْ صِيَامًا غَيْرَ مُعْتَادٍ؛ ثُمَّ ذَكَرَ حُكْمًا ثَالِثًا

642
00:59:35,700 --> 00:59:36,300
وَهُوَ فِي قَوْلِهِ: وَيَحْرُمُ تَقَدُّمُ رَمَضَانَ بِيَوْمٍ أَوْ يَوْمَيْنِ مِنْهُ،

643
00:59:35,700 --> 00:59:36,300
أَيْ يَحْرُمُ عَلَى الْعَبْدِ أَنْ يَتَقَدَّمَ صِيَامَ رَمَضَانَ بِصِيَامِ يَوْمٍ

644
00:59:35,700 --> 00:59:36,300
أَوْ يَوْمَيْنِ مِنْ شَعْبَانَ،

645
00:59:35,700 --> 00:59:36,300
وَوَجْهُ الْحُرْمَةِ هُوَ الْحَدِيثُ الَّذِي رَوَاهُ أَبُو هُرَيْرَةَ وَفِي [الصَّحِيحِ]

646
00:59:35,700 --> 00:59:36,300
النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْهُ قَالَ: [لَا تَقَدَّمُوا رَمَضَانَ

647
00:59:35,700 --> 00:59:36,300
بِيَوْمٍ أَوْ يَوْمَيْنِ إِلَّا صَوْمًا كَانَ يَصُومُهُ أَحَدُهُمْ]،

648
00:59:35,700 --> 00:59:36,300
وَالْحَدِيثُ مَحْمُولٌ عَلَى الْكَرَاهَةِ عِنْدَ جُمْهُورِ أَهْلِ الْعِلْمِ،

649
00:59:35,700 --> 00:59:36,300
وَاخْتَارَ جَمَاعَةٌ مِنَ الْعُلَمَاءِ التَّحْرِيمَ مِنْهُمْ أَبُو الْعَبَّاسِ [ابْنُ تَيْمِيَّةَ]

650
00:59:35,700 --> 00:59:36,300
رَحِمَهُ اللَّهُ وَهُوَ الأَجْهَهُ،

651
00:59:35,700 --> 00:59:36,300
فَالصَّحِيحُ تَحْرِيمُ تَقَدُّمِ شَهْرِ رَمَضَانَ لِصِيَامِ يَوْمٍ أَوْ يَوْمَيْنِ مِنْ

652
00:59:35,700 --> 00:59:36,300
شَعْبَانَ؛ وَذَكَرَ الْعُلَمَاءُ لِهَذَا عِلَلًا أَحْسَنَهُمْ فِي بَيَانِهَا [ابْنُ رَجَبٍ]

653
00:59:35,700 --> 00:59:36,300
رَحِمَهُ اللَّهُ فِي [لَطَائِفِ الْمَعَارِفِ]،

654
00:59:35,700 --> 00:59:36,300
فَذَكَرَ ثَلَاثَ عِلَلٍ: الأُولَى: وُصُولُ الْفَصْلِ بَيْنَ شَعْبَانَ وَرَمَضَانَ كَمَا

655
00:59:35,700 --> 00:59:36,300
يَحْسُنُ الْفَصْلُ مَا بَيْنَ السُّنَّةِ وَالْفَرْضِ فِي الصَّلَاةِ فَيَقَعُ بِذَلِكَ

656
00:59:35,700 --> 00:59:36,300
تَمْيِيزُ مَقَامِ كُلٍّ عَنِ الآخَرِ.

657
00:59:35,700 --> 00:59:36,300
الثَّانِيَةُ: أَنَّ وُقُوعَ الصِّيَامِ مِنَ الْعَبْدِ مُتَّصِلًا مِنْ شَعْبَانَ إِلَى

658
00:59:35,700 --> 00:59:36,300
رَمَضَانَ قَدْ رُبَّمَا أَنْهَكَهُ فَثَقُلَ بِهِ أَنْ يُقْبِلَ عَلَى رَمَضَانَ

659
00:59:35,700 --> 00:59:36,300
وَكَانَ ضَعِيفَ الْقُوَى مُنْهَكَ الْبَدَنِ فَأَثْقَلَ ذَلِكَ صِيَامَهُ وَأَضْعَفَ سَيْرَهُ.

660
00:59:35,700 --> 00:59:36,300
وَالثَّالِثَةُ: أَنَّ ذَلِكَ وَقَعَ عَلَى إِرَادَةِ مَنْعِ اشْتِبَاهِ أَحَدِهِمَا بِالآخَرِ،

661
00:59:35,700 --> 00:59:36,300
أَيْ لِئَلَّا يُظَنَّ أَنَّ شَهْرَ رَمَضَانَ قَدْ بَدَأَ وَلَمْ يَبْدَأْ

662
00:59:35,700 --> 00:59:36,300
بَعْدُ، فَلِأَجْلِ هَذِهِ الْعِلَلِ الثَّلَاثِ فَقَدْ نَهَى النَّبِيُّ صَلَّى اللَّهُ

663
00:59:35,700 --> 00:59:36,300
عَلَيْهِ وَسَلَّمَ نَهْيَ تَحْرِيمٍ عَنْ تَقَدُّمِ رَمَضَانَ بِيَوْمٍ أَوْ يَوْمَيْنِ،

664
00:59:35,700 --> 00:59:36,300
وَهِيَ عِلَلٌ صَحِيحَةٌ لَهَا مَأْخَذٌ حَسَنٌ،

665
00:59:35,700 --> 00:59:36,300
إِلَّا أَنَّهُ مِمَّا يُنَبَّهُ إِلَيْهِ أَنَّ حَالَ الْمُعْتَادِ لِلصِّيَامِ حَالٌ

666
00:59:35,700 --> 00:59:36,300
مُسْتَثْنَاةٌ مِنْ ذَلِكَ،

667
00:59:35,700 --> 00:59:36,300
فَإِنَّ الْعَبْدَ إِذَا كَانَ مُعْتَادًا لِصِيَامٍ قَبْلَ بُلُوغِ هَذَا الْوَقْتِ

668
00:59:35,700 --> 00:59:36,300
مِنَ السَّنَةِ فَلَهُ أَنْ يُتِمَّهُ كَمَا إِنِ اعْتَادَ صَوْمَ يَوْمِ

669
00:59:35,700 --> 00:59:36,300
الِاثْنَيْنِ أَوْ يَوْمِ الْخَمِيسِ أَوْ نَحْوَ ذَلِكَ فَوَافَقَ أَحَدُ هَذِهِ

670
00:59:35,700 --> 00:59:36,300
الأَيَّامِ يَوْمًا أَوْ يَوْمَيْنِ قَبْلَ رَمَضَانَ فَلَهُ أَنْ يَصُومَهُ،

671
00:59:35,700 --> 00:59:36,300
فَإِنَّهُ لَا يَصُومُهُ حِينَئِذٍ لِأَنَّهُ قَبْلَ رَمَضَانَ بِيَوْمٍ أَوْ يَوْمَيْنِ،

672
00:59:35,700 --> 00:59:36,300
وَإِنَّمَا هُوَ يَصُومُهُ لِوُقُوعِهِ فِي ذَلِكَ مُنْذُ بَدْءِ اعْتِيَادِهِ لَهُ

673
00:59:35,700 --> 00:59:36,300
فَلَا يَكُونُ حِينَئِذٍ مُحَرَّمًا فِي حَقِّهِ.

674
00:59:35,700 --> 00:59:36,300
ثُمَّ ذَكَرَ حُكْمًا خَامِسًا وَهُوَ حُكْمُ صِيَامِ يَوْمِ الشَّكِّ وَأَفْصَحَ

675
00:59:35,700 --> 00:59:36,300
عَنْ حَدِّهِ بِقَوْلِهِ: وَهُوَ يَوْمُ الثَّلَاثِينَ مِنْ شَعْبَانَ الَّذِي تَكُونُ

676
00:59:35,700 --> 00:59:36,300
لَيْلَتُهُ صَحْوَةً لَا غَيْمَ فِيهَا وَلَا قَطْرَ،

677
00:59:35,700 --> 00:59:36,300
فَيَوْمُ الشَّكِّ عَلَى الْحَدِّ الْمَذْكُورِ وَهُوَ قَوْلُ الإِمَامِ أَحْمَدَ وَأَبِي

678
00:59:35,700 --> 00:59:36,300
حَنِيفَةَ وَالَّتِي اخْتَارَهُ جَمَاعَةٌ مِنَ الْعُلَمَاءِ وَالْمَعْرُوفَةُ عَنِ السَّلَفِ،

679
00:59:35,700 --> 00:59:36,300
فَهُوَ يَوْمُ الثَّلَاثِينَ مِنْ شَعْبَانَ الَّذِي تَكُونُ لَيْلَتُهُ صَحْوَةً أَيْ

680
00:59:35,700 --> 00:59:36,300
يَكُونُ الْخَلَاءُ فِيهَا وَاضِحَةً لَا يَشْتَبِهُ عَلَى أَحَدٍ،

681
00:59:35,700 --> 00:59:36,300
فَتَكُونُ لَيْلَةٌ فِيهَا قَمَرٌ مُنِيرٌ وَاضِحٌ جَلِيٌّ لَا يَشْتَبِهُ عَلَى

682
00:59:35,700 --> 00:59:36,300
أَحَدٍ، فَيُمْكِنُ الْجَزْمُ حَالَ هَذِهِ اللَّيْلَةِ أَنَّهَا لَيْلَةُ الثَّلَاثِينَ مِنْ

683
00:59:35,700 --> 00:59:36,300
شَعْبَانَ، فَهِيَ لَيْلَةٌ خَالِيَةٌ مِنْ حَوَائِلِ الرُّؤْيَةِ مِنْ غَيْمٍ أَوْ

684
00:59:35,700 --> 00:59:36,300
قَطْرٍ، وَهُوَ مَا يَجْبَعُ الضُّبَّاطَ الَّتِي تَحُولُ دُونَ الْجَزْمِ بِكَوْنِ

685
00:59:35,700 --> 00:59:36,300
هَذَا يَجْبَعُ الضُّبَّاطَ هِلَالَ رَمَضَانَ أَمْ هِلَالَ الثَّلَاثِينَ مِنْ شَعْبَانَ،

686
00:59:35,700 --> 00:59:36,300
فَاللَّيْلَةُ الْخَالِيَةُ مِنْ هَذِهِ الْمَوَانِعِ تُسَمَّى لَيْلَةَ يَوْمِ الشَّكِّ،

687
00:59:35,700 --> 00:59:36,300
فَيَكُونُ يَوْمُ الثَّلَاثِينَ مِنْ شَعْبَانَ الَّذِي هُوَ مُحَقَّقٌ كَوْنُهُ هُوَ

688
00:59:35,700 --> 00:59:36,300
الثَّلَاثِينَ مِنْ شَعْبَانَ هُوَ يَوْمُ الشَّكِّ،

689
00:59:35,700 --> 00:59:36,300
فَهَذَا يَحْرُمُ صِيَامُهُ حُرْمَةً جَازِمَةً فَلَا يَجُوزُ لِلْعَبْدِ أَنْ يَصُومَهُ،

690
00:59:35,700 --> 00:59:36,300
وَفِيهِ قَوْلُ [عَمَّارِ بْنِ يَاسِرٍ]: [نَهَى النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ

691
00:59:35,700 --> 00:59:36,300
وَسَلَّمَ عَنْ صَوْمِ يَوْمِ الشَّكِّ]،

692
00:59:35,700 --> 00:59:36,300
ثُمَّ قَالَ: [فَمَنْ صَامَ يَوْمَ الشَّكِّ فَقَدْ عَصَى أَبَا الْقَاسِمِ

693
00:59:35,700 --> 00:59:36,300
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ]،

694
00:59:35,700 --> 00:59:36,300
وَكَلَامُ الصَّحَابِيِّ بِقَوْلِهِ: [فَقَدْ عَصَى أَبَا الْقَاسِمِ] هُوَ حُكْمٌ مِنْهُ

695
00:59:35,700 --> 00:59:36,300
عَلَى عَمَلٍ بِالْمَعْصِيَةِ،

696
00:59:35,700 --> 00:59:36,300
وَهَذَا فِي أَصَحِّ الْقَوْلَيْنِ هُوَ فِي حُكْمِ الْمَرْفُوعِ إِلَى النَّبِيِّ

697
00:59:35,700 --> 00:59:36,300
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

698
00:59:35,700 --> 00:59:36,300
فَيَكُونُ مِنْ جُمْلَةِ كَلَامِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

699
00:59:35,700 --> 00:59:36,300
وَاتَّذَكَرَهُ عَلَى هَذَا الإِجْمَاعِ [ابْنُ عَبْدِ الْبَرِّ] رَحِمَهُ اللَّهُ تَعَالَى

700
00:59:35,700 --> 00:59:36,300
فَقَالَ: [وَأَجْمَعَ الْعُلَمَاءُ أَنَّ مَا يَقَعُ مِنْ ذَلِكَ مُسْنَدٌ عَلَى

701
00:59:35,700 --> 00:59:36,300
رَفْعِ مَا يَقَعُ مِنْ ذَلِكَ مُسْنَدٌ عَلَى حُكْمٍ بِالْمَعْصِيَةِ عَلَى

702
00:59:35,700 --> 00:59:36,300
عَمَلٍ مِنَ الأَعْمَالِ أَنَّهُ مَرْفُوعٌ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ

703
00:59:35,700 --> 00:59:36,300
وَسَلَّمَ]، وَنَزَعَهُ فِي ذَلِكَ [ابْنُ الْقَيِّمِ] إِلَّا أَنَّ كَلَامَ [ابْنِ

704
00:59:35,700 --> 00:59:36,300
عَبْدِ الْبَرِّ] أَوْثَقُ وَأَقْوَى،

705
00:59:35,700 --> 00:59:36,300
فَالصَّحِيحُ أَنَّ هَذَا مِنْ كَلَامِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

706
00:59:35,700 --> 00:59:36,300
حُكْمًا، هُوَ مَرْفُوعٌ إِلَيْهِ حُكْمًا،

707
00:59:35,700 --> 00:59:36,300
وَبِهِ تَعْلَمُ أَنَّهُ يَحْرُمُ صِيَامُ يَوْمِ الشَّكِّ الَّذِي هَذِهِ صِفَتُهُ؛

708
00:59:35,700 --> 00:59:36,300
أَمَّا إِنْ كَانَ يَوْمُ الشَّكِّ لَمْ يَحْصُلْ بِأَنْ تَكُونَ قَدْ

709
00:59:35,700 --> 00:59:36,300
تَقَدَّمَتْهُ لَيْلَةٌ فِيهَا غَيْمٌ أَوْ قَطْرٌ أَوْ نَحْوُ ذَلِكَ مِمَّا

710
00:59:35,700 --> 00:59:36,300
حَالَ دُونَ رُؤْيَةِ الْهِلَالِ فَلَمْ يُجْزَمْ أَغَدًا هُوَ الثَّلَاثُونَ مِنْ

711
00:59:35,700 --> 00:59:36,300
شَعْبَانَ أَوْ هُوَ أَوَّلُ لَيْلَةٍ أَوِ الْيَوْمِ مِنْ رَمَضَانَ،

712
00:59:35,700 --> 00:59:36,300
فَحَالئِذٍ لَا يَحْرُمُ صِيَامُ هَذَا الْيَوْمِ بَلْ يَجُوزُ،

713
00:59:35,700 --> 00:59:36,300
وَمَذْهَبُ الصَّحَابَةِ فَإِنَّ مِنْهُمْ مَنْ صَامَ هَذَا الْيَوْمَ لِأَجْلِ أَنَّهُ

714
00:59:35,700 --> 00:59:36,300
رَأَى فِي لَيْلَتِهِ قَطْرًا أَوْ غَيْمًا حَالَ دُونَ رُؤْيَةِ الْهِلَالِ،

715
00:59:35,700 --> 00:59:36,300
وَيَكُونُ هَذَا مُسْتَثْنًى مِنَ الْحَدِيثِ الْمَعْرُوفِ الَّذِي فِيهِ النَّهْيُ عَنْ

716
00:59:35,700 --> 00:59:36,300
تَقَدُّمِ رَمَضَانَ بِيَوْمٍ أَوْ يَوْمَيْنِ مِنْ حَدِيثِ أَبِي هُرَيْرَةَ الَّذِي

717
00:59:35,700 --> 00:59:36,300
قَدَّمْنَاهُ، وَالصَّحَابَةُ أَعْرَفُ بِالأَحْكَامِ وَأَعْلَمُ بِمَدَارِكِهَا.

718
00:59:35,700 --> 00:59:36,300
وَهَذَا آخِرُ الْبَيَانِ عَلَى هَذِهِ الْجُمْلَةِ مِنَ الْكِتَابِ،

719
00:59:35,700 --> 00:59:36,300
وَبِهِ تَعْلَمُ قَدْرَ الْحَاجَةِ إِلَى مَعْرِفَةِ أَحْكَامِ الصِّيَامِ،

720
00:59:35,700 --> 00:59:36,300
فَإِنَّ الْجُمْلَةَ مِنْ هَذِهِ الأَحْكَامِ تَخْفَى عَلَى الْخَلْقِ بِمَا يُضْعِفُ

721
00:59:35,700 --> 00:59:36,300
حَالَهُمْ فِي مُعَامَلَةِ الشَّرِيعَةِ فِي هَذِهِ الأَيَّامِ فِي رَجَبٍ وَفِي

722
00:59:35,700 --> 00:59:36,300
شَعْبَانَ وَغَيْرِهَا،

723
00:59:35,700 --> 00:59:36,300
إِمَّا بِتَرْكِ سُنَّةٍ أَوْ بِالإِقْبَالِ عَلَى بِدْعَةٍ أَوْ بِالتَّدَبُّسِ بِمَكْرُوهٍ

724
00:59:35,700 --> 00:59:36,300
أَوْ بِمُحَرَّمٍ أَوْ نَحْوِ ذَلِكَ،

725
00:59:35,700 --> 00:59:36,300
وَهَذِهِ حَالٌ لَا تَلِيقُ بِطَالِبِ عِلْمٍ،

726
00:59:35,700 --> 00:59:36,300
فَيَنْبَغِي أَنْ يَكُونَ عَلَى عِلْمٍ بِهَذِهِ الأَحْكَامِ لِئَلَّا يَقَعَ فِي

727
00:59:35,700 --> 00:59:36,300
شَيْءٍ مِنْهَا،

728
00:59:35,700 --> 00:59:36,300
وَمِنْ لَطِيفِ مَا يُذْكَرُ أَنَّ تَكْرَارَ الأَحْكَامِ يُورِثُ الإِحْكَامَ،

729
00:59:35,700 --> 00:59:36,300
فَمَنْ كَانَ عَلَى عِلْمٍ بِشَيْءٍ مِنْ هَذِهِ الأَحْكَامِ فَلَا يُخْلِي

730
00:59:35,700 --> 00:59:36,300
نَفْسَهُ مِنْ تَكْرَارِهَا لَعَلَّهُ يَنْتَفِعُ بِهَا،

731
00:59:35,700 --> 00:59:36,300
هَذَا آخِرُ الْبَيَانِ بِهَذَا الْمَقَامِ،

732
00:59:35,700 --> 00:59:36,300
وَأَسْأَلُ اللَّهَ أَنْ يَنْفَعَنِي وَإِيَّاكُمْ بِمَا أُلْقِيَ فِيهِ،

733
00:59:35,700 --> 00:59:36,300
وَأَنْ يَجْعَلَنَا مَفَاتِيحَ لِلْخَيْرِ،

734
00:59:35,700 --> 00:59:36,300
وَأَنْ يَرْزُقَنَا خَيْرِيَّةَ الدُّنْيَا وَالآخِرَةِ،

735
00:59:35,700 --> 00:59:36,300
وَاللَّهُ أَعْلَمُ،

736
00:59:35,700 --> 00:59:36,300
صَلَّى اللَّهُ وَسَلَّمَ عَلَى رَسُولِهِ مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

737
00:59:35,700 --> 00:59:36,300
سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ أَسْتَغْفِرُكَ

738
00:59:35,700 --> 00:59:36,300
وَأَتُوبُ إِلَيْكَ،

739
00:59:35,700 --> 00:59:36,300
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.

740
00:59:35,700 --> 00:59:36,300
الْمَسْأَلَةُ حُكْمُ صِيَامِ الأَشْهُرِ الْحُرُمِ،

741
00:59:35,700 --> 00:59:36,300
فَإِنَّ الشَّيْخَ صَالِحَ الْعُصَيْمِيَّ عَفَا اللَّهُ كَانَ لَهُ تَرْجِيحٌ قَدِيمٌ

742
00:59:35,700 --> 00:59:36,300
فِي هَذِهِ الْمَسْأَلَةِ هُوَ أَنَّهُ يُسْتَحَبُّ صِيَامُ الأَشْهُرِ الْحُرُمِ،

743
00:59:35,700 --> 00:59:36,300
فَكَانَ هَذَا فِي سَنَةِ سِتٍّ وَعِشْرِينَ وَأَرْبَعِ مِئَةٍ وَأَلْفٍ،

744
00:59:35,700 --> 00:59:36,300
ثُمَّ عَدَلَ عَنْهُ فِي تَعْلِيقِهِ عَلَى [حُكْمِ صَوْمِ رَجَبٍ وَشَعْبَانَ]

745
00:59:35,700 --> 00:59:36,300
لِـ [ابْنِ الْعَطَّارِ] فِي سَنَةِ تِسْعٍ وَعِشْرِينَ وَأَرْبَعِ مِئَةٍ وَأَلْفٍ،

746
00:59:35,700 --> 00:59:36,300
وَاخْتَارَ أَنَّهُ لَا يُسْتَحَبُّ صِيَامُ شَيْءٍ مِنَ الأَشْهُرِ الْحُرُمِ سِوَى

747
00:59:35,700 --> 00:59:36,300
شَهْرِ اللَّهِ الْمُحَرَّمِ،

748
00:59:35,700 --> 00:59:36,300
ثُمَّ رَجَعَ إِلَيْهِ مَرَّةً أُخْرَى سَنَةَ أَرْبَعٍ وَثَلَاثِينَ وَأَرْبَعِ مِئَةٍ

749
00:59:35,700 --> 00:59:36,300
وَأَلْفٍ فِي شَرْحِهِ لِكِتَابِ الصِّيَامِ مِنْ كِتَابِ [نُورِ الْبَصَائِرِ وَالأَلْبَابِ]

750
00:59:35,700 --> 00:59:36,300
رَحِمَهُ اللَّهُ،

751
00:59:35,700 --> 00:59:36,300
وَكَانَ هَذَا الَّذِي اسْتَقَرَّ عَلَيْهِ الأَمْرُ فِي حَالِ الشَّيْخِ،

752
00:59:35,700 --> 00:59:36,300
فَعَغْدًا بِهَذَا وَنُصْحًا لِطُلَّابِ الْعِلْمِ أَقُولُ وَبِاللَّهِ التَّوْفِيقُ: إِنَّ صِيَامَ

753
00:59:35,700 --> 00:59:36,300
رَجَبٍ يُسْتَحَبُّ ضِمْنَ صِيَامِ الأَشْهُرِ الْحُرُمِ لِلْحَدِيثِ الْمُخَرَّجِ فِي [الصَّحِيحِ]

754
00:59:35,700 --> 00:59:36,300
أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: [أَفْضَلُ الصِّيَامِ بَعْدَ

755
00:59:35,700 --> 00:59:36,300
رَمَضَانَ صِيَامُ شَهْرِ اللَّهِ الْمُحَرَّمِ]،

756
00:59:35,700 --> 00:59:36,300
وَاخْتَلَفَ الْعُلَمَاءُ فِي مَعْنَاهُ عَلَى قَوْلَيْنِ اثْنَيْنِ: أَوَّلُهُمَا: أَنَّ الْمُرَادَ

757
00:59:35,700 --> 00:59:36,300
بِشَهْرِ اللَّهِ الْمُحَرَّمِ هُوَ شَهْرُ الْمُحَرَّمِ دُونَ غَيْرِهِ مِنَ الأَشْهُرِ،

758
00:59:35,700 --> 00:59:36,300
هُوَ شَهْرٌ وَاحِدٌ فِي الْعَامِ وَالشَّهْرُ الَّذِي يُسَمَّى الْمُحَرَّمَ.

759
00:59:35,700 --> 00:59:36,300
وَالْقَوْلُ الثَّانِي: أَنَّ الْمُرَادَ بِشَهْرِ اللَّهِ الْمُحَرَّمِ فِي هَذَا الْحَدِيثِ

760
00:59:35,700 --> 00:59:36,300
الأَشْهُرُ الْحُرُمُ جَمِيعًا،

761
00:59:35,700 --> 00:59:36,300
هُوَ مُفْرَدٌ أُرِيدَ بِهِ الْجَمْعُ،

762
00:59:35,700 --> 00:59:36,300
وَكَأَنَّهُ أَرَادَ جِنْسَ الشَّهْرِ الْمُحَرَّمِ،

763
00:59:35,700 --> 00:59:36,300
فَيَكُونُ بِذَلِكَ مِمَّا يَدْخُلُ فِي هَذَا الْحَدِيثِ الأَشْهُرُ الْحُرُمُ جَمِيعًا،

764
00:59:35,700 --> 00:59:36,300
فَيَدْخُلُ فِيهِ ذُو الْقَعْدَةِ وَذُو الْحِجَّةِ وَالْمُحَرَّمُ وَرَجَبٌ،

765
00:59:35,700 --> 00:59:36,300
وَعَلَيْهِ فَيُسْتَحَبُّ صِيَامُ رَجَبٍ،

766
00:59:35,700 --> 00:59:36,300
وَهَذَا الثَّانِي هُوَ الرَّاجِحُ وَالَّذِي اسْتَقَرَّ عَلَيْهِ الشَّيْخُ كَمَا قَدَّمْتُ،

767
00:59:35,700 --> 00:59:36,300
فَيَكُونُ الْمُسْتَحَبُّ فِي صِيَامِ رَجَبٍ أَنْ يَقَعَ إِمَّا تَهَيُّؤًا لِرَمَضَانَ

768
00:59:35,700 --> 00:59:36,300
أَوْ أَنْ يَقَعَ عَلَى إِرَادَةِ صَوْمِهِ ضِمْنَ الأَشْهُرِ الْحُرُمِ جَمِيعًا.

769
00:59:35,700 --> 00:59:36,300
وَهُوَ إِشْكَالٌ آخَرُ وَهُوَ إِذَا كَانَ صِيَامُ الأَشْهُرِ الْحُرُمِ أَفْضَلَ

770
00:59:35,700 --> 00:59:36,300
عِنْدَ اللَّهِ عَزَّ وَجَلَّ مِنْ صِيَامِ شَعْبَانَ،

771
00:59:35,700 --> 00:59:36,300
فَلِمَاذَا أَكْثَرَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مِنَ الصِّيَامِ فِي

772
00:59:35,700 --> 00:59:36,300
شَعْبَانَ دُونَ الأَشْهُرِ الْحُرُمِ؟

773
00:59:35,700 --> 00:59:36,300
وَأَجَابَ عَنْهُ [النَّوَوِيُّ] رَحِمَهُ اللَّهُ فِي شَرْحِهِ عَلَى [صَحِيحِ مُسْلِمٍ]

774
00:59:35,700 --> 00:59:36,300
بِجَوَابَيْنِ: الأَوَّلُ: أَنَّ هَذَا الْخَبَرَ بِضَغِيلِ صِيَامِ شَهْرِ اللَّهِ الْمُحَرَّمِ،

775
00:59:35,700 --> 00:59:36,300
وَالْمُرَادُ بِهِ كَمَا قَدَّمْنَا الأَشْهُرُ الْحُرُمُ جَمِيعًا عَلَى صِيَامِ شَعْبَانَ،

776
00:59:35,700 --> 00:59:36,300
إِنَّمَا وَقَعَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي آخِرِ حَيَاتِهِ،

777
00:59:35,700 --> 00:59:36,300
فَوَقَعَ ذَلِكَ بَعْدَمَا كَانَ اعْتَادَ صِيَامَ شَعْبَانَ فَعَسُرَ عَلَيْهِ أَنْ

778
00:59:35,700 --> 00:59:36,300
يَصُومَ الأَشْهُرَ الْحُرُمَ.

779
00:59:35,700 --> 00:59:36,300
وَالْجَوَابُ الثَّانِي: أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ رُبَّمَا شُغِلَ

780
00:59:35,700 --> 00:59:36,300
بِشَاغِلٍ مِنْ مَرَضٍ أَوْ سَفَرٍ أَوْ أَيِّ شَيْءٍ مَا يَخُصُّهُ

781
00:59:35,700 --> 00:59:36,300
أَوْ سَفَرٍ أَوْ نَحْوِ ذَلِكَ مِمَّا حَالَ بَيْنَهُ وَبَيْنَ صِيَامِ

782
00:59:35,700 --> 00:59:36,300
الأَشْهُرِ الْحُرُمِ،

783
00:59:35,700 --> 00:59:36,300
فَوَقَعَ بِذَلِكَ أَكْثَرُ صِيَامِهِ فِي شَعْبَانَ،

784
00:59:35,700 --> 00:59:36,300
إِلَّا أَنَّ لَنَا أَنَّ الْمُقَدَّمَةَ فِي السُّنَّةِ السُّنَّةُ الْقَوْلِيَّةُ لَا

785
00:59:35,700 --> 00:59:36,300
الْفِعْلِيَّةُ، فَإِنَّ قَوْلَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِيهِ نُصْحٌ

786
00:59:35,700 --> 00:59:36,300
لِلأُمَّةِ بِمَا يَلْزَمُهَا بِالأَخْذِ بِهِ اسْتِحْبَابًا أَوْ وُجُوبًا،

787
00:59:35,700 --> 00:59:36,300
وَأَمَّا سُنَّتُهُ الْفِعْلِيَّةُ فَرُبَّمَا وَقَعَتْ مِنْهُ لِعُذْرٍ أَوْ غَيْرِ ذَلِكَ،

788
00:59:35,700 --> 00:59:36,300
فَالْفِعْلِيَّةُ الْقَوْلِيَّةُ مُقَدَّمَةٌ عَلَى الْفِعْلِيَّةِ.

789
00:59:35,700 --> 00:59:36,300
وَهَذَا الِاخْتِيَارُ الَّذِي قَدَّمْنَاهُ فِي صِيَامِ الأَشْهُرِ الْحُرُمِ أَنَّهُ يُسْتَحَبُّ

790
00:59:35,700 --> 00:59:36,300
صَوْمُهَا جَمِيعًا وَاخْتِيَارُ جَمَاعَةٍ مِنَ الْعُلَمَاءِ مِنْهُ [ابْنُ تَيْمِيَّةَ الْحَفِيدُ]

791
00:59:35,700 --> 00:59:36,300
رَحِمَهُ اللَّهُ وَحَفِيدُهُ بِالتَّلْمَذَةِ [أَبُو الْفَرَجِ ابْنُ رَجَبٍ] وَغَيْرُهُمَا،

792
00:59:35,700 --> 00:59:36,300
وَيَشْهَدُ لَهُ مَا صَحَّ عِنْدَ [عَبْدِ الرَّزَّاقِ] فِي [مُصَنَّفِهِ] عَنِ

793
00:59:35,700 --> 00:59:36,300
[ابْنِ عُمَرَ] رَضِيَ اللَّهُ عَنْهُمَا أَنَّهُ كَانَ يَصُومُ الأَشْهُرَ الْحُرُمَ

794
00:59:35,700 --> 00:59:36,300
جَمِيعًا، فَصَحَّ بِذَلِكَ الْقَوْلُ بِأَنَّ هَذَا هُوَ الْمُرَادُ مِنَ الْحَدِيثِ،

795
00:59:35,700 --> 00:59:36,300
فَكَمْ بُنِيَ عَلَى مَا ذَكَرْتُهُ،

796
00:59:35,700 --> 00:59:36,300
وَذَكَرْنَا أَنَّ التَّرْجِيحَ الْمُعْتَدَّ بِهِ فِي هَذِهِ الْمَسْأَلَةِ اسْتِحْبَابُهُ فِي

797
00:59:35,700 --> 00:59:36,300
جَمِيعِهِ، وَلَا يَنْبَغِي أَنْ يُشْكِلَ عَلَى مَا ذَكَرْنَا كَأَنَّ الشَّيْخَ

798
00:59:35,700 --> 00:59:36,300
غَيَّرَ تَرْجِيحَهُ مَرَّةً بَعْدَ مَرَّةٍ،

799
00:59:35,700 --> 00:59:36,300
فَهَذَا لَا إِشْكَالَ فِيهِ أَنَّ الْعَالِمَ كَمَا تَجَدَّدَتْ لَهُ مِنْ

800
00:59:35,700 --> 00:59:36,300
أَفْرَادِ الْعِلْمِ أَوْجَبَ تَغْيِيرَ تَرْجِيحِهِ،

801
00:59:35,700 --> 00:59:36,300
وَهَذَا يَحْصُلُ بِأَكَابِرَ مِنَ الْعُلَمَاءِ كَمَا حَصَلَ لِلإِمَامِ أَحْمَدَ فِي

802
00:59:35,700 --> 00:59:36,300
مَسَائِلَ كَثِيرَةٍ تَجِدُ لَهُ فِيهَا قَوْلًا وَقَوْلَيْنِ وَثَلَاثَةً وَأَرْبَعَةً وَخَمْسَةَ

803
00:59:35,700 --> 00:59:36,300
أَقْوَالٍ وَرُبَّمَا سِتَّةَ أَقْوَالٍ،

804
00:59:35,700 --> 00:59:36,300
وَحَصَلَ كَذَلِكَ لِـ [ابْنِ تَيْمِيَّةَ] وَ [ابْنِ الْقَيِّمِ] وَغَيْرِهِمْ مِنَ

805
00:59:35,700 --> 00:59:36,300
الْعُلَمَاءِ الْمُحَقِّقِينَ مِنْ عُلَمَاءِ أَهْلِ السُّنَّةِ وَالْجَمَاعَةِ،

806
00:59:35,700 --> 00:59:36,300
فَلْيَخْفَ عَلَى طَالِبِ عِلْمٍ عَلَى طَالِبِ عِلْمٍ حَالُ الْعُلَمَاءِ فِي

807
00:59:35,700 --> 00:59:36,300
ذَلِكَ، فَرُجُوعُ عَالِمٍ عَنْ طُولٍ ثُمَّ إِيَابُهُ إِلَيْهِ مَرَّةً أُخْرَى

808
00:59:35,700 --> 00:59:36,300
لَا يَقْدَحُ فِي عِلْمِهِ وَلَا يَعْنِي عَدَمَ الأَخْذِ بِهِ،

809
00:59:35,700 --> 00:59:36,300
وَإِنَّمَا يُفْرَحُ بِذَلِكَ لِأَجْلِ مَا تَجَدَّدَ عِنْدَهُ وَعِنْدَ الْمُتَلَقِّي عَنْهُ

810
00:59:35,700 --> 00:59:36,300
مِنَ الْعِلْمِ،

811
00:59:35,700 --> 00:59:36,300
وَعَلَى الشَّيْخِ صَالِحٍ الْعُصَيْمِيِّ عَبْدِ اللَّهِ مَعُوضَةُ النَّافِعَةُ فِي هَذَا

812
00:59:35,700 --> 00:59:36,300
الْبَابِ ذَكَرَهَا فِي شَرْحِ [أَعْلَامِ السُّنَّةِ الْمَنْشُورَةِ] فِي بَرْنَامَجِ [تَأْسِيسِ

813
00:59:35,700 --> 00:59:36,300
الْمُتَعَلِّمِ] قَدْ يُرَاجَعُ،

814
00:59:35,700 --> 00:59:36,300
هَذَا آخِرُ الْبَيَانِ الَّذِي رُمْتُهُ فِي هَذَا الْمَجْلِسِ،

815
00:59:35,700 --> 00:59:36,300
وَاللَّهُ أَعْلَمُ،

816
00:59:35,700 --> 00:59:36,300
صَلَّى اللَّهُ عَلَى مُحَمَّدٍ وَعَلَيْهِ وَصَحْبِهِ وَسَلَّمَ،

817
00:59:35,700 --> 00:59:36,300
سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ أَسْتَغْفِرُكَ

818
00:59:35,700 --> 00:59:36,300
أَتُوبُ إِلَيْكَ،

819
00:59:35,700 --> 00:59:36,300
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.
