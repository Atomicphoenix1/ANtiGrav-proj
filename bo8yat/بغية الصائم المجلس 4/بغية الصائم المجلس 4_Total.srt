409
01:30:07,660 --> 01:30:08,260
وَأَوَّلُ هَذِهِ الْمُفْتِرَاتِ هُوَ الْأَكْلُ وَالشُّرْبُ وَانْعَقَدَ الْإِجْمَاعُ عَلَى الْإِفْطَارِ

410
01:30:07,660 --> 01:30:08,260
بِهِمَا ذَكَرَهُ ابْنُ عَبْدِ الْبَرِّ وَابْنُ تَيْمِيَّةَ الْحَفِيدُ فِي آخَرِينَ،

411
01:30:07,660 --> 01:30:08,260
وَالْأَكْلُ هُوَ إِدْخَالُ جَامِدٍ مِنَ الْفَمِلِ الْجَوْفِ وَالشُّرْبُ هُوَ إِدْخَالُ

412
01:30:07,660 --> 01:30:08,260
سَائِلٍ مِنَ الْفَمِلِ الْجَوْفِ،

413
01:30:07,660 --> 01:30:08,260
وَيُقَاسُ عَلَى الثَّانِي الدَّخَانُ فَيَنْدَرِجُ فِيهِ كَمَنْ تَنَاوَلَ شَيْئًا مِنَ

414
01:30:07,660 --> 01:30:08,260
التَّبْغِ هُوَ الْمَعْرُوفُ بِاسْمِ السَّجَائِرِ وَالْمَعْرُوفُ بِاسْمِ السَّجَائِرِ السَّجَائِرِ فَيَكُونُ

415
01:30:07,660 --> 01:30:08,260
تَنَاوُلُهُ لِدُخَانِ هَذَا التَّبْغِ فِي حُكْمِ الشُّرْبِ وَهُوَ مَا تَعَارَفَ

416
01:30:07,660 --> 01:30:08,260
عَلَيْهِ النَّاسُ بِاسْمِ شُرْبِ السَّجَائِرِ فَإِنَّ الدَّخَانَ يَتَسَرَّبُ مِنَ الرِّئَةِ

417
01:30:07,660 --> 01:30:08,260
إِلَى الْمَعِدَةِ وَلَوْ فِي قَدْرٍ يَسِيرٍ مِنْهُ فَلَهُ حُكْمُ الشُّرْبِ،

418
01:30:07,660 --> 01:30:08,260
ثُمَّ أَشَارَ الْمُصَنِّفُ إِلَى مُفْتِرٍ آخَرَ مِمَّا يَتْبَعُ الْأَكْلَ وَالشُّرْبَ

419
01:30:07,660 --> 01:30:08,260
وَهُوَ مَا كَانَ فِي مَعْنَاهُمَا ثُمَّ أَشَارَ الْمُصَنِّفُ إِلَى مُفْتِرٍ

420
01:30:07,660 --> 01:30:08,260
آخَرَ مِمَّا يَتْبَعُ الْأَكْلَ وَالشُّرْبَ وَهُوَ مَا كَانَ فِي مَعْنَاهُمَا

421
01:30:07,660 --> 01:30:08,260
وَذَكَرَ حَدَّهُ بِقَوْلِهِ: وَهُوَ مَا شَارَكَ أَحَدَهُمَا فِي شَيْءٍ مِنْ

422
01:30:07,660 --> 01:30:08,260
مُتَعَلِّقَاتِهِ الثَّلَاثِ وَهُوَ مَا شَارَكَ أَحَدَهُمَا فِي شَيْءٍ مِنْ مُتَعَلِّقَاتِهِ

423
01:30:07,660 --> 01:30:08,260
الثَّلَاثِ، وَهَذِهِ الثَّلَاثُ هِيَ الْمَقْصِدُ وَالْأَثَرُ وَالْمُسْتَقَرُّ،

424
01:30:07,660 --> 01:30:08,260
فَالْمَقْصِدُ أَيِ الْمُرَادُ وَهِيَ الْغَايَةُ الْمَنْشُودَةُ مِنَ الْأَكْلَ وَالشُّرْبِ فَالْمَقْصِدُ

425
01:30:07,660 --> 01:30:08,260
أَيِ الْمُرَادُ وَهِيَ الْغَايَةُ الْمَنْشُودَةُ مِنَ الْأَكْلَ وَالشُّرْبِ،

426
01:30:07,660 --> 01:30:08,260
وَالْأَثَرُ هُوَ النَّتِيجَةُ الْمُتَرَتِّبَةُ عَلَى الْأَكْلِ وَالشُّرْبِ مِمَّا يُوجَدُ بَعْدَهُمَا،

427
01:30:07,660 --> 01:30:08,260
وَالْمُسْتَقَرُّ هُوَ مَحَلُّ اسْتِقْرَارِ الْأَكْلِ وَالشُّرْبِ،

428
01:30:07,660 --> 01:30:08,260
وَالْأَثَرُ هُوَ النَّتِيجَةُ الْمُتَرَتِّبَةُ عَلَى الْأَكْلِ وَالشُّرْبِ مِمَّا يُوجَدُ بَعْدَهُمَا

429
01:30:07,660 --> 01:30:08,260
وَهِيَ مَحَلُّ سُكُونِهِمَا،

430
01:30:07,660 --> 01:30:08,260
وَهَذَا الْحَدُّ الَّذِي ذَكَرَهُ الْمُصَنِّفُ وَأَفْصَحَ بِهِ عَنِ الْمُرَادِ مِنْ

431
01:30:07,660 --> 01:30:08,260
قَوْلِنَا وَمَا فِي مَعْنَاهُمَا لَيْسَ مَذْكُورًا بِنَصِّهِ فِي شَيْءٍ مِنْ

432
01:30:07,660 --> 01:30:08,260
كُتُبِ الْفُقَهَاءِ الْمَعْرُوفَةِ لَيْسَ مَذْكُورًا بِنَصِّهِ فِي شَيْءٍ مِنْ كُتُبِ

433
01:30:07,660 --> 01:30:08,260
الْفُقَهَاءِ الْمَعْرُوفَةِ،

434
01:30:07,660 --> 01:30:08,260
وَإِنَّمَا يُسْتَدَلُّ عَلَيْهِ مِنْ تَصَرُّفِهِمْ فِي كُتُبِهِمْ فَيُمْكِنُ اسْتِفَادَتُهُ مِنَ

435
01:30:07,660 --> 01:30:08,260
الْأَمْثِلَةِ الَّتِي يَذْكُرُونَهَا بِضَمِّ الشَّبِيهِ إِلَى الشَّبِيهِ بِضَمِّ الشَّبِيهِ إِلَى

436
01:30:07,660 --> 01:30:08,260
الشَّبِيهِ وَفَصْلِ الْمُتَفَرِّقَاتِ وَهَذَا هُوَ الْفِقْهُ،

437
01:30:07,660 --> 01:30:08,260
قَالَ عَبْدُ الْحَقِّ الصَّمْبَاطِيُّ مِنْ فُقَهَاءِ الشَّافِعِيَّةِ: [الْفِقْهُ الْجَمْعُ وَالْفَرْقُ]

438
01:30:07,660 --> 01:30:08,260
[الْفِقْهُ الْجَمْعُ وَالْفَرْقُ]،

439
01:30:07,660 --> 01:30:08,260
فَمَنْ عَمَدَ إِلَى جَمْعِ الْمُتَشَابِهَاتِ وَفَصْلِ الْمُتَفَرِّقَاتِ أَمْكَنَ لَهُ تَخْصِيلُ

440
01:30:07,660 --> 01:30:08,260
الْفِقْهِ، وَهَذَا مِمَّا يُحْمَدُ فِي التَّصَانِيفِ الْعِلْمِيِّ وَهَذَا مِمَّا يُحْمَدُ

441
01:30:07,660 --> 01:30:08,260
فِي التَّصَانِيفِ الْعِلْمِيِّ وَخَاصَّةً الْفِقْهِيَّةَ فَإِنَّ الرَّدَّ إِلَى أُصُولٍ كُلِّيَّةٍ

442
01:30:07,660 --> 01:30:08,260
أَنْفَعُ مِنَ الْجُزْئِيَّاتِ الْمُطَوَّلَةِ فَالْعِبَارَةُ الْجَامِعَةُ هِيَ الْعِبَارَةُ النَّافِعَةُ،

443
01:30:07,660 --> 01:30:08,260
وَلِهَذَا كَانَ الْقُرْآنُ مِنْ جَوَامِعِ الْكَلِمِ وَعَظُمَ شَأْنُ النَّبِيِّ بِإِدَائِهِ

444
01:30:07,660 --> 01:30:08,260
جَوَامِعَ الْكَلِمِ وَعَظُمَ شَأْنُ النَّبِيِّ بِإِدَائِهِ جَوَامِعَ الْكَلِمِ وَعَظُمَ شَأْنُ

445
01:30:07,660 --> 01:30:08,260
النَّبِيِّ بِإِدَائِهِ جَوَامِعَ الْكَلِمِ،

446
01:30:07,660 --> 01:30:08,260
فَمَنْ أَخَذَ بِطَرِيقَةِ الْقُرْآنِ وَالسُّنَّةِ حَصَلَتْ لَهُ الْبَرَكَةُ فِي عِلْمِهِ

447
01:30:07,660 --> 01:30:08,260
وَبَيَانِهِ فَلَا يُعَابُ صَنِيعُ أَحَدٍ مِنَ الْمُصَنِّفِينَ إِذَا وَافَقَ الْعُلَمَاءَ

448
01:30:07,660 --> 01:30:08,260
مَعْنًى وَخَالَفَهُمْ مَبْنًى فَلَا يُعَابُ صَنِيعُ أَحَدٍ مِنَ الْمُصَنِّفِينَ إِذَا

449
01:30:07,660 --> 01:30:08,260
وَافَقَ الْعُلَمَاءَ مَعْنًى وَخَالَفَهُمْ مَبْنًى إِذَا كَانَ لَهُ عُذْرٌ يَسْتَنِدُ

450
01:30:07,660 --> 01:30:08,260
إِلَيْهِ كَطُولِ عِبَارَةِ الْعُلَمَاءِ فِي كُتُبِهِمْ وَتَعَدُّدِ الْأَفْرَادِ الَّتِي يَذْكُرُونَهَا

451
01:30:07,660 --> 01:30:08,260
بِمَا يُثْقِلُ الْعِلْمَ وَيَشُقُّ فَهْمُهُ بِهِ فَيَسْعَى إِلَى تَقْرِيبِهِ لِلْمُتَعَلِّمِينَ

452
01:30:07,660 --> 01:30:08,260
لِعِبَارَةٍ جَامِعَةٍ تُؤَدِّي الْمَعْنَى الْمَقْصُودَ بِسُهُولَةٍ وَيُسْرٍ فَيَكُونُ ذَلِكَ مُوَافَقَةً

453
01:30:07,660 --> 01:30:08,260
لِيُسْرِ الدِّينِ وَيُحْمَدُ لِصَاحِبِهِ.

454
01:30:07,660 --> 01:30:08,260
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: نَعَمْ وَأَوَّلُهَا الْمَقْصِدُ وَهُوَ التَّغْذِيَةُ وَمِنْهَا

455
01:30:07,660 --> 01:30:08,260
حُقَنُ الْبُرُوتِينَاتِ وَالْفِيتَامِينَاتِ وَالْمَحَلِيلِ وَنَحْوِهَا وَلَا تَضُرُّ الْإِبَرُ غَيْرُ الْمُغْزِيَةِ

456
01:30:07,660 --> 01:30:08,260
كَحُقَنِ الْأَمْسَلِينِ وَنَحْوِهَا،

457
01:30:07,660 --> 01:30:08,260
وَثَانِيهَا الْأَثَرُ وَهُوَ طَعْمٌ فِي الْحَلْقِ كَالْعِلْكَةِ الْمُنَكَّهَةِ وَقَطْرَةِ الْأَنْفِ

458
01:30:07,660 --> 01:30:08,260
إِذَا وُجِدَ طَعْمُهَا فِي حَلْقِهِ وَنَحْوُ ذَلِكَ وَلَا يَضُرُّ اسْتِعْمَالُ

459
01:30:07,660 --> 01:30:08,260
مَا لَا يَنْفُذُ لِلْجَوْفِ كَالْكُحْلِ وَقَطْرَةِ الْعَيْنِ وَقَطْرَةِ الْأُذُنِ وَنَحْوِهَا،

460
01:30:07,660 --> 01:30:08,260
وَكَذَا لَا يَضُرُّ مَا لَا يُمْكِنُ التَّحَرُّزُ مِنْ أَثَرِهِ كَمَاءٍ

461
01:30:07,660 --> 01:30:08,260
فِي مَضْمَضَةٍ وَسِوَاكٍ وَبَقَرِهِ طَعَامٍ لَا يُمْكِنُ مَجُّهُ وَبَخَّاخِ رَبْوَهْ

462
01:30:07,660 --> 01:30:08,260
وَنَحْوِهَا، وَثَالِثُهَا الْمُسْتَقَرُّ وَهُوَ الْجَوْفُ كَالْحُوبِ وَالْأَقْرَاسِ وَنَحْوِهَا وَلَا يَضُرُّ

463
01:30:07,660 --> 01:30:08,260
تَذَوُّقُهُ دُونَ ابْتِلَاعِهِ مَا لَمْ يُخَلِّفْ مَا لَمْ يُخَلِّفْ أَثَرَ

464
01:30:07,660 --> 01:30:08,260
أَثَرَهُ. قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: تَدَهْ بِصَنْقٍ فِي بَيَانِ مَا

465
01:30:07,660 --> 01:30:08,260
يَتَعَلَّقُ بِالْبَذْكُورِ فِي الْعِبَارَةِ الْمُتَقَدِّمَةِ وَهِيَ الْجَامِعَةُ بِمَا يَتَضَمَّنُهُ مَعْنَى

466
01:30:07,660 --> 01:30:08,260
أَبْلِ وَالشَّرْطِ وَجَعَلَهُ فِي ثَلَاثِ مُتَعَلِّقَاتٍ: الْأَوَّلُ: الْمَقْصِدُ أَيْ مَقْصِدُ

467
01:30:07,660 --> 01:30:08,260
الْأَكْلِ وَالشُّرْبِ فَكُلُّ مَا شَارَكَ الْأَكْلَ وَالشُّرْبَ فِي مَقْصِدِهِمْ كَانَ

468
01:30:07,660 --> 01:30:08,260
مِمَّا يَدْخُلُ فِي مَعْنَاهُمَا،

469
01:30:07,660 --> 01:30:08,260
وَمَقْصِدُ الْأَكْلِ وَالشُّرْبِ هُوَ التَّغْذِيَةُ كَمَا صَرَّحَ بِهِ الْمُصَنِّفُ أَمَّمَا

470
01:30:07,660 --> 01:30:08,260
يُشَارِكُ الْأَكْلَ وَالشُّرْبَ فِي هَذَا الْمَقْصِدِ الْعِبَرُ الْمُغَذِّيَةُ وَهِيَ الْحُقَنُ

471
01:30:07,660 --> 01:30:08,260
الَّتِي تُسْتَعْمَلُ لِإِرَادَةِ نَقْلِ نَوْعٍ مِنَ الْغِذَائِيِّ إِلَى بَدَنِ الْإِنْسَانِ

472
01:30:07,660 --> 01:30:08,260
فَحُقَنُ الْبُرُوتِينَاتِ أَوِ الْفِيتَامِينَاتِ أَوْ غَيْرِهَا مِمَّا يَدْخُلُ تَحْتَ اسْمِ

473
01:30:07,660 --> 01:30:08,260
الْغِذَاءِ الْيِبَرُ الْمُغَذِّيَةُ أَيْمَا هُوَ مَعْرُوفٌ عِنْدَ أَهْلِ الطِّبِّ،

474
01:30:07,660 --> 01:30:08,260
وَمِمَّا يُشَارِكُ الْأَكْلَ وَالشُّرْبَ فِي مَقْصِدِهِمَا فَيَدْخُلُ فِي مَعْنَاهُمَا أَيْضًا

475
01:30:07,660 --> 01:30:08,260
الْمَحَلِيلُ فَإِنَّهَا تَعَلَّقُ عَلَى إِرَادَةِ تَغْذِيَةِ بَدَنٍ ضَعِيفٍ فَتُشَارِكُ الْأَكْلَ

476
01:30:07,660 --> 01:30:08,260
وَالشُّرْبَ مِنْ جِهَةِ مَقْصِدِهِمَا،

477
01:30:07,660 --> 01:30:08,260
وَمَا كَانَ مِنْ هَذَا الصِّنْفِ كَانَ اسْتِعْمَالُهُ مُفْطِرًا لِمَا تَقَدَّمَ

478
01:30:07,660 --> 01:30:08,260
مِنْ كَوْنِهِ فِي مَعْنَى الْأَكْلِ وَالشُّرْبِ فَيُفْطِرُ كَمَا يُفْطِرَانِ،

479
01:30:07,660 --> 01:30:08,260
بِخِلَافِ مَا لَمْ يُشَارِكْهُمَا فِي مَقْصِدِهِمَا كَالْيِبَرِ غَيْرِ الْمُغَذِّيَةِ فَإِنَّمَا

480
01:30:07,660 --> 01:30:08,260
تُرَادُ لِنَقْلِ مَادَّةٍ إِلَى الْبَدَنِ دُونَ إِرَادَةِ التَّغْذِيَةِ بِهَا،

481
01:30:07,660 --> 01:30:08,260
وَمِنْ هَذَا الصِّنْفِ حُقَنُ الْأَمْسَلِينِ فَإِنَّهَا لَا تَسُدُّ جُوعَهُ وَلَا

482
01:30:07,660 --> 01:30:08,260
تُخَفِّفُ عَطَشَهُ فَلَا تُؤَدِّي مَعْنَى التَّغْذِيَةِ،

483
01:30:07,660 --> 01:30:08,260
وَالْمُتَعَلِّقُ الثَّانِي: هُوَ الْأَثَرُ وَأَفْصَحَ عَنْهُ الْمُصَنِّفُ بِقَوْلِهِ: وَهُوَ الطَّعْمُ

484
01:30:07,660 --> 01:30:08,260
فِي الْحَلْقِ،

485
01:30:07,660 --> 01:30:08,260
إِذَا وُجِدَ شَيْءٌ يُشَارِكُ الْأَكْلَ وَالشُّرْبَ فِي أَثَرِهِمَا بِأَنْ وُجِدَ

486
01:30:07,660 --> 01:30:08,260
لَهُ طَعْمٌ فِي الْحَلْقِ كَانَ دَاخِلًا فِي مَعْنَاهُمَا فَأَفْطَرَ مُتَعَاطِيهِ

487
01:30:07,660 --> 01:30:08,260
كَانَ دَاخِلًا فِي مَعْنَاهُمَا فَأَفْطَرَ مُتَعَاطِيهِ كَالْعِلْكَةِ الْمُنَكَّهَةِ وَهِيَ الْعِلْكَةُ

488
01:30:07,660 --> 01:30:08,260
الَّتِي تَكُونُ لَهَا نَكْهَةٌ فِي الْفَمِ فَإِنَّ هَذِهِ الْعِلْكَةَ تَكُونُ

489
01:30:07,660 --> 01:30:08,260
فِيهَا مِنَ السُّكَّرِيَّاتِ مَا تَتَحَلَّلُ فِي لُعَابِ الْمَاضِغِ لَهَا ثُمَّ

490
01:30:07,660 --> 01:30:08,260
يَبْتَلِعُهَا مَعَ الرِّيقِ فَيَكُونُ قَدِ ابْتَلَعَهَا مَعَ الرِّيقِ فَيَكُونُ قَدِ

491
01:30:07,660 --> 01:30:08,260
ابْتَلَعَهَا مَعَ الرِّيقِ شَيْئًا مِمَّا يُفْطَرُ بِهِ،

492
01:30:07,660 --> 01:30:08,260
وَيَدُلُّ عَلَى هَذَا الْمَعْنَى مَا يَجِدُهُ فِي حَلْقِهِ مِنْ طَعْمِ

493
01:30:07,660 --> 01:30:08,260
هَذِهِ الْعِلْكَةِ بِخِلَافِ الْعِلْكَةِ غَيْرِ الْمُنَكَّهَةِ لِأَنَّهَا تَخْلُو مِمَّا يَتَحَلَّلُ

494
01:30:07,660 --> 01:30:08,260
فِي اللُّعَابِ فَلَا تُفْطِرُ وَأَمَارَتُ ذَلِكَ أَنْ لَا يُوجَدَ لَهَا

495
01:30:07,660 --> 01:30:08,260
طَعْمٌ فِي الْحَلْقِ،

496
01:30:07,660 --> 01:30:08,260
وَمِمَّا يُشَارِكُ الطَّعَامَ وَالشَّرَابَ فِي أَثَرَيْهِمَا قَطْرَةُ الْأَنْفِ فَإِنَّ الْأَنْفَ

497
01:30:07,660 --> 01:30:08,260
مَمْفَذٌ لِلْجَوْفِ وَقَطْرَةُ الْأَنْفِ لَهَا حَلَّانِ: الْأُولَى: أَنْ وُجِدَ مُتَنَاوِلُهَا

498
01:30:07,660 --> 01:30:08,260
طَعْمَهَا فِي الْحَلْقِ فَهُوَ مَمْفَذٌ لِلْجَوْفِ أَنْ وُجِدَ مُتَنَاوِلُهَا طَعْمَهَا

499
01:30:07,660 --> 01:30:08,260
فِي حَلْقِهِ وَيَا الْمَرَارَةُ الَّتِي تَعْقُبُ اسْتِعْمَالَهَا فَيُفْطِرُ بِذَلِكَ،

500
01:30:07,660 --> 01:30:08,260
وَالْحَالُ الثَّانِيَةُ: أَنْ لَا يَجِدَ طَعْمَهَا فِي حَلْقِهِ فَلَا يُفْطِرُ

501
01:30:07,660 --> 01:30:08,260
بِهَا لِأَنَّهَا بِهَذَا الْحَالِ لَا تُشَارِكُ الْأَكْلَ وَالشُّرْبَ فِي أَثَرِهِمَا،

502
01:30:07,660 --> 01:30:08,260
ثُمَّ ذَكَرَ الْمُصَنِّفُ مَا لَا يَدْخُلُ فِي مَعْنَى الْأَكْلِ وَالشُّرْبِ

503
01:30:07,660 --> 01:30:08,260
مِنْ هَذِهِ الْجِهَةِ فَقَالَ: وَ لَا يَضُرُّ اسْتِعْمَالُ مَا لَا

504
01:30:07,660 --> 01:30:08,260
يَنْفُذُ لِلْجَوْفِ أَيْ مَا لَا يَكُونُ مَمْفَدًا إِلَى بَاطِنِ الْبَدَنِ

505
01:30:07,660 --> 01:30:08,260
أَيْ مَا لَا يَكُونُ مَمْفَدًا إِلَى بَاطِنِ الْبَدَنِ كَالْكُحْلِ وَقَطْرَةِ

506
01:30:07,660 --> 01:30:08,260
الْعَيْنِ فَإِنَّهُمَا يُوضَعَانِ لِلْعَيْنِ وَالْعَيْنُ فِي قَوْلِ الْجُمْهُورِ لَيْسَتْ مَمْفَدًا

507
01:30:07,660 --> 01:30:08,260
لِلْجَوْفِ فَلَا تُحْدِثُ أَثَرًا فِي الْحَلْقِ فَلَا تَدْخُلُ فِيمَا ذَكَرْنَاهُ،

508
01:30:07,660 --> 01:30:08,260
وَكَذَا قَطْرَةُ الْأُذُنِ أَنَّ الْأُذُنَ أَيْضًا لَيْسَتْ مَمْفَدًا لِلْجَوْفِ،

509
01:30:07,660 --> 01:30:08,260
ثُمَّ ذَكَرَ الْمُصَنِّفُ قَرْعًا آخَرَ عَنْ هَذِهِ الْمَسْأَلَةِ وَهُوَ مَا

510
01:30:07,660 --> 01:30:08,260
لَا يُمْكِنُ التَّحَرُّزُ مِنْ أَثَرِهِ أَيْ لَا يُمْكِنُ اجْتِنَابُهُ فَإِنَّ

511
01:30:07,660 --> 01:30:08,260
مَنْ تَمَضْمَضَ بِمَاءٍ فَلَا بُدَّ لَهُ أَنْ يَجِدَ أَثَرَ رُطُوبَتِهِ

512
01:30:07,660 --> 01:30:08,260
فِي فَمِهِ فَهَذَا الْأَثَرُ لَا يُمْكِنُ التَّخَلُّصُ مِنْهُ فَلَا يَضُرُّ

513
01:30:07,660 --> 01:30:08,260
الصَّائِمَ فِي شَيْءٍ،

514
01:30:07,660 --> 01:30:08,260
وَأَيْضُ فَاسْتِوَاكُ فَمَنْ اسْتَاكَ بِعُودٍ فَرُبَّمَا تَفَتَّتَ بِقَدْرٍ يَسِيرٍ بَيْنَ

515
01:30:07,660 --> 01:30:08,260
أَثْنَانِهِ فَهَذَا أَثَرٌ رُبَّمَا يُحِسُّ بِهِ الْمُتَسَوِّكُ دُونَ أَنْ كَانَ

516
01:30:07,660 --> 01:30:08,260
بُلُوغُهُ بِلِسَانِهِ فَلَا يَسْتَطِيعُ جَمْعَهُ وَلَفْظَهُ مِنْ فَإِنَّهُ غَيْرُ ذَلِكَ

517
01:30:07,660 --> 01:30:08,260
فَهَذَا أَيْضًا لَا شَيْءَ فِيهِ،

518
01:30:07,660 --> 01:30:08,260
وَمَا يَدْخُلُ بِهَذَا الْمَعْنَى مِمَّا عَظُمَ بِهِ الْبَلَاءُ بَقِيَّةُ الطَّعَامِ

519
01:30:07,660 --> 01:30:08,260
الَّذِي لَا يُمْكِنُ مَجُّهُ وَمَجُّ الشَّيْءِ أَيْ لَفْظُهُ وَالْمُرَادُ بِهِ

520
01:30:07,660 --> 01:30:08,260
إِلْقَاؤُهُ مِنَ الْفَمِ فَمَنْ أَحَسَّ بِشَيْءٍ مِنْ بَقِيَّةِ طَعَامٍ بَيْنَ

521
01:30:07,660 --> 01:30:08,260
أَثْنَانِهِ وَكَانَ أَدَقَّ مِنْ أَنْ يُخْرِجَهُ عَلَى لِسَانِهِ فَلَمْ يُمْكِنْهُ

522
01:30:07,660 --> 01:30:08,260
لَفْظُهُ لَمْ يَكُنْ ذَلِكَ مُؤَثِّرًا فِي صَوْمِهِ،

523
01:30:07,660 --> 01:30:08,260
وَمِمَّا يَدْخُلُ فِي هَذَا أَيْضًا بَخَّاخُ الرَّبْ هُوَ بَخَّاخٌ يَنْشُرُ

524
01:30:07,660 --> 01:30:08,260
نُقَطًا يَسِيرَةً فِي فَمِ الْمُتَلَقِّلِهِ دُونَ أَنْ يَسْقُطَ مِنْهَا شَيْءٌ

525
01:30:07,660 --> 01:30:08,260
عَلَى لِسَانِهِ يُمْكِنُ أَنْ يَرَاهُ أَوْ يُحِسَّ بِهِ فَهَذِهِ أَيْضًا

526
01:30:07,660 --> 01:30:08,260
تُخَلِّفُ أَثَرَهُ أَضْعَفَهُ مِنْ أَنْ يُحْتَرَزَ مِنْهُ فَلَا تَضُرُّ،

527
01:30:07,660 --> 01:30:08,260
وَبِهِ تَعْلَمُ أَنَّ الَّذِي يَضُرُّ فِي هَذَا الْمُتَعَلِّقِ هُوَ مَا

528
01:30:07,660 --> 01:30:08,260
وُجِدَ أَثَرُهُ دُونَ مَا لَمْ يُوجَدْ أَثَرُهُ لِضَعْفِهِ لَهُ حُكْمُ

529
01:30:07,660 --> 01:30:08,260
الْعَدَمِ أَوْ مَا لَمْ يُوجَدْ أَثَرُهُ لِضَعْفِهِ لَهُ حُكْمُ الْعَدَمِ

530
01:30:07,660 --> 01:30:08,260
مَا لَمْ يُوجَدْ أَثَرُهُ أَصْلًا فَكَانَ عَدَمًا،

531
01:30:07,660 --> 01:30:08,260
فَفَقْدُ الْأَثَرِ فِي الْجُمْلَتَيْنِ الْأَخِيرَتَيْنِ لَهُ نَوْعَانِ: فَقْدٌ حَقِيقِيٌّ بِأَنْ

532
01:30:07,660 --> 01:30:08,260
لَا يَكُونَ لِلْمُتَنَاوَلِ أَثَرٌ أَصْلَى،

533
01:30:07,660 --> 01:30:08,260
وَالثَّانِي: فَقْدٌ حُكْمِيٌّ بِأَنْ يُوجَدَ لَهُ أَثَرٌ يَسِيرٌ لَا يُمْكِنُ

534
01:30:07,660 --> 01:30:08,260
التَّحَرُّزُ مِنْهُ فَيَكُونُ فِي حُكْمِ الْعَدَمِ،

535
01:30:07,660 --> 01:30:08,260
وَالْمُتَعَلِّقُ الثَّالِثُ: الْمُسْتَقَرُّ وَهُوَ مَحَلُّ اسْتِقْرَارِ الطَّعَامِ وَالشَّرَابِ كَمَا تَقَدَّمَ

536
01:30:07,660 --> 01:30:08,260
وَهُوَ الْجَوْفُ فَكُلُّ مَا يَتَعَطَّاهُ الْإِنْسَانُ مِمَّا يَسْتَقِرُّ فِي الْجَوْفِ

537
01:30:07,660 --> 01:30:08,260
فَيُهْضَمُ كَالطَّعَامِ وَالشَّرَابِ فَيَكُونُ مُشَارِكًا لَهُمَا مِنْ هَذِهِ الْجِهَةِ يَكُونُ

538
01:30:07,660 --> 01:30:08,260
مُفْطِرًا إِذْ أَنَّهُ هُنَا يَكُونُ فِي مَعْنَاهُمَا الْحُوبُ وَالْأَخْرَاصُ وَسَائِرُ

539
01:30:07,660 --> 01:30:08,260
مَا يُتَنَاوَلُ بِالْفَمِ،

540
01:30:07,660 --> 01:30:08,260
وَيَخْرُجُ بِقَوْلِنَا الْجَوْفُ مَا لَمْ يَصِلْ إِلَيْهِ كَطَعَامٍ أَوْ شَرَابٍ

541
01:30:07,660 --> 01:30:08,260
عَلَى لِسَانٍ يَتَذَوَّقُهُ صَاحِبُهُ دُونَ ابْتِلَاعِهِ فَإِنْ هُوَ مَا لَمْ

542
01:30:07,660 --> 01:30:08,260
يَفْصِلْ إِلَيْهِ فَلَنْ يَصِلَ إِلَى الْجَوْفِ،

543
01:30:07,660 --> 01:30:08,260
فَلَنْ يُشَارِكَ الطَّعَامَ وَالشَّرَابَ مِنْ هَذِهِ الْجِهَةِ،

544
01:30:07,660 --> 01:30:08,260
مَا لَمْ يُخَلِّفْ أَثَرًا،

545
01:30:07,660 --> 01:30:08,260
مَا لَمْ يَتْرُكْ أَثَرًا،

546
01:30:07,660 --> 01:30:08,260
يَظْهَرُ فِي الْحَلْقِ بَعْدَهُ،

547
01:30:07,660 --> 01:30:08,260
فَيَكُونُ حِينَئِذٍ مُشَارِكًا لِلطَّعَامِ وَالشَّرَابِ مِنْ جِهَةٍ أُخْرَى عَلَى مَا

548
01:30:07,660 --> 01:30:08,260
قَدَّمْنَا بَيَانًا،

549
01:30:07,660 --> 01:30:08,260
وَمِمَّا يُنَبَّهُ إِلَيْهِ أَنَّ مِنَ النَّاسِ مَنْ يَشُقُّ عَلَى نَفْسِهِ

550
01:30:07,660 --> 01:30:08,260
فِيمَا يَتَعَلَّقُ بِهَذِهِ الْأَحْكَامِ،

551
01:30:07,660 --> 01:30:08,260
فَتَجِدُهُ إِذَا تَمَضَّضَ فِي وُضُوءٍ جَلَسَ يَدْفُلُ الْمَاءَ مِنْ فَمِهِ،

552
01:30:07,660 --> 01:30:08,260
حَتَّى يَجِفَّ فَمُهُ وَ يَضُمَّهُ بِهَا،

553
01:30:07,660 --> 01:30:08,260
فَلَنْ يُشَارِكَ الطَّعَامَ.
