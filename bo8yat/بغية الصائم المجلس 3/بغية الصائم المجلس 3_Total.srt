572
01:32:45,240 --> 01:32:46,040
وَهُوَ قَوْلُ جُمْهُورِ أَهْلِ الْعِلْمِ،

573
01:32:45,240 --> 01:32:46,040
وَالْمُوجِبَانِ اللَّذَانِ ذَكَرَهُمَا الْمُصَنِّفُ هُمَا: - الْأَوَّلُ: شُهُودُ الشَّهْرِ،

574
01:32:45,240 --> 01:32:46,040
وَمَعْنَاهُ شُهُودُ شَهْرِ رَمَضَانَ أَيْ: بِالصِّيَامِ فِيهِ؛ فَإِنَّ لِهَذَا شَرَفًا

575
01:32:45,240 --> 01:32:46,040
لَا يَكُونُ لِغَيْرِهِ مِنَ الشُّهُورِ،

576
01:32:45,240 --> 01:32:46,040
إِذْ هُوَ سَيِّدُ شُهُورِ الْعَامِ.

577
01:32:45,240 --> 01:32:46,040
- وَالْمُوجِبُ الثَّانِي: هُوَ ثِقَةُ النَّاسِ،

578
01:32:45,240 --> 01:32:46,040
وَالْمُرَادُ مِنْهُ الِاسْتِعَانَةُ بِهِمْ عَلَى الْعِبَادَةِ؛ فَإِنَّ مُوَافَقَتَهُمْ فِي عِبَادَتِهِمْ

579
01:32:45,240 --> 01:32:46,040
تُيَسِّرُ الْعَمَلَ بِهِمْ،

580
01:32:45,240 --> 01:32:46,040
وَهَذَا مُشَاهَدٌ مَلْحُوظٌ فِي أَحْوَالِ الْخَلْقِ.

581
01:32:45,240 --> 01:32:46,040
وَالْحُكْمُ التَّاسِعُ فِي قَوْلِهِ: «وَلَا يُؤَثِّرُ اعْتِيَادُهُ لِلسَّفَرِ» أَيْ: لَا

582
01:32:45,240 --> 01:32:46,040
مُتَعَلَّقَ لَهُ بِمَا ذَكَرْنَا مِنَ الْأَحْيَانِ،

583
01:32:45,240 --> 01:32:46,040
فَلَا يُغَيِّرُ فِيهَا شَيْئًا،

584
01:32:45,240 --> 01:32:46,040
وَلَا يَعْدِلُ مِنْهَا شَيْئًا؛ فَإِنَّ مَنِ اعْتَادَ السَّفَرَ فَهُوَ مُسَافِرٌ،

585
01:32:45,240 --> 01:32:46,040
فَيَتَرَخَّصُ فِي رُخَصِ الْمُسَافِرِ مَهْمَا كَانَ اعْتِيَادُهُ لَهُ،

586
01:32:45,240 --> 01:32:46,040
وَلَوْ كَانَ يُسَافِرُ كُلَّ يَوْمٍ،

587
01:32:45,240 --> 01:32:46,040
قَالَ: مَا يُسَافِرُ بِالْقُيُودِ الْمُوَضَّحَةِ فِي مَعْنَى الْمُسَافِرِ كَمَا قَدَّمْنَا،

588
01:32:45,240 --> 01:32:46,040
فَيَصْدُقُ عَلَيْهِ اسْمُ الْمُسَافِرِ وَلَهُ أَحْكَامُهُ،

589
01:32:45,240 --> 01:32:46,040
فَلَا يُؤَثِّرُ اعْتِيَادُهُ بِالسَّفَرِ.

590
01:32:45,240 --> 01:32:46,040
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَفَرْضٌ كَنَفْلٍ سِوَى وُجُوبٍ فِي فَرْضٍ،

591
01:32:45,240 --> 01:32:46,040
وَإِسْرَارِ فِطْرٍ فِي رَمَضَانَ،

592
01:32:45,240 --> 01:32:46,040
أَوْ إِطْعَامٍ لَهُ.

593
01:32:45,240 --> 01:32:46,040
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: مَاذَا أَرَادَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ؟

594
01:32:45,240 --> 01:32:46,040
اسْتِوَاءَ أَحْكَامِ صِيَامِ النَّفْلِ مَعَ صِيَامِ الْفَرْضِ فِيمَا تَقَدَّمَ مِنَ

595
01:32:45,240 --> 01:32:46,040
الْأَحْكَامِ؛ فَالْأَصْلُ كَوْنُ صِيَامِ الْفَرْضِ وَصِيَامِ النَّفْلِ عَلَى دَرَجَةٍ وَاحِدَةٍ

596
01:32:45,240 --> 01:32:46,040
مِنَ الْأَحْكَامِ الْمَذْكُورَةِ سِوَى ثَلَاثَةِ أَحْكَامٍ: - أَحَدُهَا: الْوُجُوبُ فِي

597
01:32:45,240 --> 01:32:46,040
صِيَامِ الْفَرْضِ؛ فَإِنَّ النَّفْلَ لَا يَجِبُ بِخِلَافِ الْفَرْضِ.

598
01:32:45,240 --> 01:32:46,040
- وَثَانِيهَا: إِسْرَارُ الْفِطْرِ فِي رَمَضَانَ؛ فَإِنَّهُ كَانَ الْعَبْدُ يُطَالَبُ

599
01:32:45,240 --> 01:32:46,040
بِهِ حِينَئِذٍ تَحْقِيقًا لِلِاسْتِبْرَاءِ فِي دِينِهِ وَعِرْضِهِ،

600
01:32:45,240 --> 01:32:46,040
فَيَدْفَعُ سُوءَ الظَّنِّ عَنْ نَفْسِهِ،

601
01:32:45,240 --> 01:32:46,040
وَيَطْلُبُ سَلَامَةَ الصَّدْرِ لِلْمُسْلِمِينَ،

602
01:32:45,240 --> 01:32:46,040
وَلَيْسَ شَيْءٌ مِنْ ذَلِكَ فِي غَيْرِ رَمَضَانَ مِنْ صِيَامِ الْفَرْضِ

603
01:32:45,240 --> 01:32:46,040
فَضْلًا عَنْ صِيَامِ النَّفْلِ؛ فَإِنَّ النَّاسَ لَا تَتَوَافَقُ فِي هَذِهِ

604
01:32:45,240 --> 01:32:46,040
الْمَوَاسِمِ بِالتَّوَاطُؤِ عَلَى عِبَادَةِ الصِّيَامِ،

605
01:32:45,240 --> 01:32:46,040
وَإِنَّمَا يَتَّفِقُونَ فِي رَمَضَانَ وَهُوَ الصَّوْمُ الرُّكْنُ،

606
01:32:45,240 --> 01:32:46,040
فَيُسَاءُ الظَّنُّ بِأَحَدِهِمْ إِنْ ظَهَرَ فِطْرُهُ فِيهِ.

607
01:32:45,240 --> 01:32:46,040
- وَثَالِثُهَا: فِي قَوْلِهِ: [أَوْ إِطْعَامٍ لَهُ]؛ فَإِنَّهُ لَيْسَ فِيهِ

608
01:32:45,240 --> 01:32:46,040
شَيْءٌ مِمَّا تَقَدَّمَ،

609
01:32:45,240 --> 01:32:46,040
فَالْإِطْعَامُ لَا يَكُونُ مُعَلَّقًا إِلَّا بِصِيَامِ رَمَضَانَ،

610
01:32:45,240 --> 01:32:46,040
فَلَا يُشَارِكُهُ غَيْرُهُ مِنَ الْفَرْضِ فَضْلًا عَنِ النَّوَافِلِ؛ فَهَذِهِ الثَّلَاثَةُ

611
01:32:45,240 --> 01:32:46,040
هِيَ الْمُسْتَثْنَيَاتُ مِنَ الْأَحْكَامِ الْمُتَعَلِّقَةِ بِالصِّيَامِ مِمَّا قَدَّمْنَاهُ فِي هَذَا

612
01:32:45,240 --> 01:32:46,040
الْفَصْلِ، وَهِيَ الَّتِي تَخْتَصُّ فِي صِيَامٍ دُونَ الصِّيَامِ،

613
01:32:45,240 --> 01:32:46,040
وَإِنَّمَا غَيْرُهَا مِنَ الْأَحْكَامِ الْمَذْكُورَةِ فِي الصِّيَامِ الْفَرْضُ فِيهَا كَالنَّفْلِ؛

614
01:32:45,240 --> 01:32:46,040
فَمَثَلًا يُبَاحُ لِلْمُسَافِرِ الْفِطْرُ،

615
01:32:45,240 --> 01:32:46,040
هَذَا الْحُكْمُ لَا يَخْتَصُّ بِفِطْرِ رَمَضَانَ بَلْ يُبَاحُ لَهُ الْفِطْرُ

616
01:32:45,240 --> 01:32:46,040
فِي أَيِّ فَرْضٍ كَانَ وَغَيْرِهِ مِنَ الْأَحْكَامِ.

617
01:32:45,240 --> 01:32:46,040
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: نَعَمْ،

618
01:32:45,240 --> 01:32:46,040
وَصَحَّ الصَّوْمُ مِنْ كُلِّ مُسْلِمٍ عَاقِلٍ وَلَوْ مُمَيِّزًا،

619
01:32:45,240 --> 01:32:46,040
وَيَجِبُ عَلَى وَلِيِّهِ أَمْرُهُ بِهِ إِذَا مَيَّزَ لِاعْتِيَادِهِ كَالصَّلَاةِ.

620
01:32:45,240 --> 01:32:46,040
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَفِي هَذِهِ الْجُمْلَةِ بَيَانُ حُكْمَيْنِ مُتَعَلِّقَيْنِ

621
01:32:45,240 --> 01:32:46,040
بِصِحَّةِ الصِّيَامِ؛ فَإِنَّهُ لَمَّا فَرَغَ الْمُصَنِّفُ مِنْ بَيَانِ مَا يَتَعَلَّقُ

622
01:32:45,240 --> 01:32:46,040
بِوُجُوبِ الصِّيَامِ،

623
01:32:45,240 --> 01:32:46,040
وَكَانَ هَذَا الْفَصْلُ مُتَعَلِّقًا بِمَنْ يَجِبُ عَلَيْهِمُ الصِّيَامُ،

624
01:32:45,240 --> 01:32:46,040
وَمَنْ يَصِحُّ مِنْهُمْ،

625
01:32:45,240 --> 01:32:46,040
شَرَعَ فِي بَيَانِ أَحْكَامِ مَنْ يَصِحُّ مِنْهُمُ الصِّيَامُ،

626
01:32:45,240 --> 01:32:46,040
وَأَخَّرَ ذِكْرَهَا لِقِصَرِهَا،

627
01:32:45,240 --> 01:32:46,040
فَكَانَ ذَلِكَ مِمَّا يُنَاسِبُ جَعْلَهَا فِي آخِرِ الْفَصْلِ بَعْدَ الْفَرَاغِ

628
01:32:45,240 --> 01:32:46,040
مِمَّا هُوَ أَهَمُّ وَأَشَدُّ حَاجَةً إِلَى الْبَيَانِ،

629
01:32:45,240 --> 01:32:46,040
وَالْمَذْكُورُ فِيهَا حُكْمَانِ اثْنَانِ: - فَالْحُكْمُ الْأَوَّلُ: صِحَّةُ الصَّوْمِ مِنْ

630
01:32:45,240 --> 01:32:46,040
كُلِّ مُسْلِمٍ عَاقِلٍ وَلَوْ مُمَيِّزًا،

631
01:32:45,240 --> 01:32:46,040
وَالْمُمَيِّزُ هُوَ مَنْ بَلَغَ سِنَّ التَّمْيِيزِ،

632
01:32:45,240 --> 01:32:46,040
وَهُوَ السِّنُّ الَّذِي يَتَمَكَّنُ فِيهِ الْمَرْءُ مِنْ مَعْرِفَةِ مَنَافِعِهِ وَمَضَارِّهِ،

633
01:32:45,240 --> 01:32:46,040
فَفَارَقَ بِذَلِكَ مَنْ يَجِبُ عَلَيْهِمُ الصِّيَامُ بِفَارِقٍ وَاحِدٍ وَهُوَ فَارِقُ

634
01:32:45,240 --> 01:32:46,040
الْبُلُوغِ وَالتَّمْيِيزِ؛ فَإِنَّهُ لَا يَجِبُ الصِّيَامُ إِلَّا عَلَى بَالِغٍ فِي

635
01:32:45,240 --> 01:32:46,040
حِينِ أَنَّهُ يَصِحُّ مِنْ مُمَيِّزٍ.

636
01:32:45,240 --> 01:32:46,040
- وَالْحُكْمُ الثَّانِي: أَنَّهُ يَجِبُ عَلَى وَلِيِّهِ أَمْرُهُ بِهِ إِذَا

637
01:32:45,240 --> 01:32:46,040
مَيَّزَ لِيَعْتَادَهُ كَالصَّلَاةِ،

638
01:32:45,240 --> 01:32:46,040
فَالْمُرَادُ بِوَلِيِّهِ أَيِ الْقَائِمُ عَلَى شُؤُونِهِ،

639
01:32:45,240 --> 01:32:46,040
فَهَذَا يَجِبُ عَلَيْهِ أَنْ يَأْمُرَهُ بِالصِّيَامِ إِذَا بَلَغَ سِنَّ التَّمْيِيزِ،

640
01:32:45,240 --> 01:32:46,040
وَالْأَصْلُ فِي هَذَا قَوْلُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: [مُرُوا

641
01:32:45,240 --> 01:32:46,040
أَوْلَادَكُمْ بِالصَّلَاةِ لِسَبْعٍ وَاضْرِبُوهُمْ عَلَى عَشْرٍ]؛ فَإِنَّ السَّبْعَةَ هِيَ سِنُّ

642
01:32:45,240 --> 01:32:46,040
التَّمْيِيزِ الْغَالِبُ لِلْأَطْفَالِ،

643
01:32:45,240 --> 01:32:46,040
وَأَمْرُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِلْخَلْقِ بِأَنْ يَأْمُرُوا أَوْلَادَهُمْ

644
01:32:45,240 --> 01:32:46,040
بِالصَّلَاةِ لِسَبْعٍ فِيهِ وُجُوبُ ذَلِكَ عَلَيْهِ،

645
01:32:45,240 --> 01:32:46,040
وَإِذَا كَانَ ذَلِكَ وَاجِبًا فِي الصَّلَاةِ،

646
01:32:45,240 --> 01:32:46,040
كَانَ كَذَلِكَ وَاجِبًا فِي الصِّيَامِ؛ فَإِنَّ الصِّيَامَ كَالصَّلَاةِ يَلْزَمُ تَعْوِيدُ

647
01:32:45,240 --> 01:32:46,040
الطِّفْلِ عَلَيْهِ حَتَّى يَعْتَادَهُ،

648
01:32:45,240 --> 01:32:46,040
فَيُمْكِنُ لَهُ أَدَاؤُهُ عَلَى الْوَجْهِ الصَّحِيحِ إِذَا بَلَغَهُ،

649
01:32:45,240 --> 01:32:46,040
وَبِهَذَا تَعْلَمُ أَنَّ الطِّفْلَ إِذَا تَمَيَّزَ وَلَمْ يَجِبْ عَلَيْهِ الصِّيَامُ،

650
01:32:45,240 --> 01:32:46,040
فَإِنَّهُ يَجِبُ عَلَى وَلِيِّهِ أَمْرُهُ بِهِ،

651
01:32:45,240 --> 01:32:46,040
فَوُجُوبُ الصِّيَامِ حَاصِلٌ،

652
01:32:45,240 --> 01:32:46,040
لَكِنْ مِنْ جِهَةِ الْوَلِيِّ،

653
01:32:45,240 --> 01:32:46,040
لَا مِنْ جِهَةِ الطِّفْلِ،

654
01:32:45,240 --> 01:32:46,040
فَلَيْسَ هُوَ مَأْمُورًا أَنْ يَصُومَ عَلَى وَجْهِ الْوُجُوبِ،

655
01:32:45,240 --> 01:32:46,040
وَإِنَّمَا وَلِيُّهُ مَأْمُورٌ أَنْ يَأْمُرَهُ بِهِ عَلَى وَجْهِ الْوُجُوبِ،

656
01:32:45,240 --> 01:32:46,040
أَنْ يَلْزَمَ وَلِيَّهُ وُجُوبًا أَنْ يَأْمُرَ طِفْلَهُ بِهِ،

657
01:32:45,240 --> 01:32:46,040
وَهَذَا آخِرُ الْبَيَانِ عَلَى هَذَا الْفَصْلِ،

658
01:32:45,240 --> 01:32:46,040
فِي بَيَانِ أَحْوَالِ الْخَلْقِ وَأَحْكَامِ هَذِهِ الْأَحْوَالِ فِيمَا يَتَعَلَّقُ بِالصَّوْمِ

659
01:32:45,240 --> 01:32:46,040
وَالْفِطْرِ، وَأَسْتَكْمِلُ بَقِيَّةَ هَذَا الْكِتَابِ فِي الْفَصْلِ اللَّاحِقِ،

660
01:32:45,240 --> 01:32:46,040
بَعْدَ الصَّلَاةِ،

661
01:32:45,240 --> 01:32:46,040
إِنْ شَاءَ اللَّهُ تَعَالَى،

662
01:32:45,240 --> 01:32:46,040
سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ،

663
01:32:45,240 --> 01:32:46,040
أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ،

664
01:32:45,240 --> 01:32:46,040
أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ،

665
01:32:45,240 --> 01:32:46,040
وَاللَّهُ أَعْلَمُ،

666
01:32:45,240 --> 01:32:46,040
وَصَلَّى اللَّهُ عَلَى مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ،

667
01:32:45,240 --> 01:32:46,040
وَالسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.
