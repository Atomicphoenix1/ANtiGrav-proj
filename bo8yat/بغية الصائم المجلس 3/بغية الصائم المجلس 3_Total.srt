1
00:00:02,700 --> 00:00:05,309
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ

2
00:00:09,483 --> 00:00:10,526
اللَّهِ وَبَرَكَاتُهُ،

3
00:00:44,233 --> 00:00:46,133
الْحَمْدُ لِلَّهِ رَبِّنَا،

4
00:00:45,500 --> 00:00:46,133
وَأَشْهَدُ أَنْ لَا

5
00:00:51,200 --> 00:00:52,467
إِلَهَ إِلَّا

6
00:00:58,023 --> 00:00:59,254
اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

7
00:00:58,638 --> 00:00:59,254
وَأَشْهَدُ أَنْ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

8
00:00:58,638 --> 00:00:59,254
أَمَّا

9
00:01:18,210 --> 00:01:20,512
بَعْدُ: فَهَذَا الْمَجْلِسُ الثَّالِثُ

10
00:01:25,115 --> 00:01:27,416
فِي شَرْحِ الْكِتَابِ الْأَوَّلِ مِنْ بَرْنَامَجِ [عُدَّةِ رَمَضَانَ]

11
00:03:05,780 --> 00:03:07,820
فِي

12
00:03:07,820 --> 00:03:09,860
سَنَتِهِ الْأُولَى سَنَةَ خَمْسٍ وَأَرْبَعِينَ وَأَرْبَعِ مِئَةٍ وَأَلْفٍ،

13
00:03:07,820 --> 00:03:09,860
وَالْكِتَابُ الْمَقْرُوءُ فِيهِ [بُغْيَةُ الصَّائِمِ] لِمُصَنِّفِهِ مُحَمَّدِ بْنِ سَلَامَةَ بْنِ

14
00:03:07,820 --> 00:03:09,860
مُحَمَّدِ بْنِ هِلَالٍ.

15
00:03:07,820 --> 00:03:09,860
قَالَ

16
00:04:08,996 --> 00:04:10,349
الْمُصَنِّفُ رَحِمَهُ اللَّهُ: بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

17
00:04:09,672 --> 00:04:10,349
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

18
00:04:09,672 --> 00:04:10,349
صَلَّى اللَّهُ وَسَلَّمَ عَلَى رَسُولِهِ مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

19
00:04:09,672 --> 00:04:10,349
اللَّهُمَّ اغْفِرْ لِشَيْخِنَا وَلِوَالِدَيْهِ وَلِلْمُسْلِمِينَ أَجْمَعِينَ،

20
00:04:09,672 --> 00:04:11,025
أَقُولُ وَفَّقَكُمُ اللَّهُ فِي مَتْنِ [بُغْيَةِ الصَّائِمِ]: الْفَصْلُ

21
00:04:21,936 --> 00:04:25,218
فِي الْمُتَعَبِّدِ.

22
00:04:23,577 --> 00:04:25,218
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: عَقَدَ الْمُصَنِّفُ فَصْلًا آخَرَ فِي بَيَانِ

23
00:04:23,577 --> 00:04:25,218
أَحْكَامِ الْمُتَعَبِّدِ بِالصِّيَامِ،

24
00:04:23,577 --> 00:04:25,218
وَقَدْ وَقَعَ هَذَا الْفَصْلُ

25
00:04:49,638 --> 00:04:52,340
مِنْهُ

26
00:04:52,340 --> 00:04:53,585
بَعْدَ الْفَرَاغِ

27
00:04:57,318 --> 00:04:58,563
مِنْ

28
00:05:09,857 --> 00:05:39,088
ذِكْرِ أَحْكَامِ النِّيَّةِ فِي الصِّيَامِ،

29
00:05:39,088 --> 00:05:40,846
وَمُوجِبُ تَأْخِيرِهِ عَنْ أَحْكَامِ النِّيَّةِ أَمْرَانِ اثْنَانِ: - أَحَدُهُمَا: كَوْنُهُ

30
00:05:39,088 --> 00:05:40,846
مِمَّا يُعْرَفُ أَصْلُهُ وَإِنْ جُهِلَ فَصْلُهُ بِخِلَافِ النِّيَّةِ.

31
00:05:39,088 --> 00:05:40,846
- وَالثَّانِي: شِدَّةُ طُولِهِ وَاتِّسَاعُ فُرُوعِهِ،

32
00:05:39,088 --> 00:05:40,846
فَوَقَعَ بِهَذَا

33
00:05:42,604 --> 00:05:44,362
حَتَّى

34
00:05:44,362 --> 00:05:46,120
يَسِيرَ بِالتَّقْدِمَةِ بِالنِّيَّةِ

35
00:05:59,118 --> 00:06:01,284
قَبْلَ

36
00:06:01,284 --> 00:06:03,450
الشُّرُوعِ فِيهِ.

37
00:06:01,284 --> 00:06:03,450
وَمُوجِبُ ذِكْرِ هَذَا الْفَصْلِ أَصْلًا كَوْنُ الْمَذْكُورِ

38
00:06:49,678 --> 00:06:52,384
فِي

39
00:06:52,384 --> 00:06:55,089
تَرْجَمَتِهِ

40
00:08:45,101 --> 00:08:47,142
-وَهُوَ

41
00:08:47,142 --> 00:08:49,182
الْمُتَعَبِّدُ بِالصِّيَامِ- أَحَدَ الْمُتَعَلِّقَاتِ الْخَمْسِ التَّابِعَةِ لِحَقِيقَةِ الصِّيَامِ كَمَا تَقَدَّمَ،

42
00:08:47,142 --> 00:08:49,182
وَهُوَ

43
00:09:32,594 --> 00:09:34,822
الَّذِي

44
00:11:12,019 --> 00:11:14,354
يَجِبُ

45
00:11:14,354 --> 00:11:16,689
عَلَيْهِ

46
00:11:16,689 --> 00:11:19,025
الصِّيَامُ

47
00:11:19,025 --> 00:11:21,360
أَوْ يَصِحُّ مِنْهُ.

48
00:11:19,025 --> 00:11:21,360
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَيَجِبُ صَوْمُهُ بِالْفَرْضِ

49
00:11:33,785 --> 00:11:36,270
عَلَى

50
00:11:36,270 --> 00:11:38,755
مُسْلِمٍ بَالِغٍ عَاقِلٍ مُسْتَطِيعٍ سَالِمٍ

51
00:12:09,580 --> 00:12:14,060
مِنَ الْمَوَانِعِ.

52
00:12:11,820 --> 00:12:14,060
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: بَيَّنَ الْمُصَنِّفُ

53
00:13:37,002 --> 00:13:39,065
فِي

54
00:13:39,065 --> 00:13:41,129
هَذِهِ الْجُمْلَةِ مَعْنَى الْمُتَعَبِّدِ،

55
00:13:39,065 --> 00:13:41,129
وَصَفَهُ بِوَصْفَيْنِ اثْنَيْنِ هُوَ مُحَقَّقٌ فِي أَحَدِهِمَا

56
00:15:11,934 --> 00:15:14,916
أَوْ

57
00:15:14,916 --> 00:15:17,899
كِلَيْهِمَا: - الْأَوَّلُ: أَنَّهُ

58
00:15:54,706 --> 00:15:56,704
الَّذِي

59
00:17:20,705 --> 00:17:22,629
يَجِبُ

60
00:17:22,629 --> 00:17:26,478
عَلَيْهِ الصِّيَامُ.

61
00:17:24,554 --> 00:17:26,478
-

62
00:17:26,478 --> 00:17:28,402
وَالثَّانِي: أَنَّهُ الَّذِي يَصِحُّ

63
00:18:00,729 --> 00:18:02,740
الصِّيَامُ مِنْهُ.

64
00:18:01,940 --> 00:18:02,740
ثُمَّ

65
00:18:21,980 --> 00:18:25,420
ذَكَرَ تَفْصِيلَ الْأَوَّلِ

66
00:18:27,140 --> 00:18:30,580
مِنْ هَذَيْنِ الْوَصْفَيْنِ بِبَيَانِ وَصْفِ

67
00:18:35,740 --> 00:18:47,674
مَنْ يَجِبُ عَلَيْهِ الصِّيَامُ،

68
00:18:47,674 --> 00:18:49,373
ثُمَّ ذَكَرَ تَفْصِيلَ الْأَوَّلِ

69
00:19:52,256 --> 00:19:55,194
مِنْ

70
00:19:55,194 --> 00:19:58,132
هَذَيْنِ الْوَصْفَيْنِ بِبَيَانِ وَصْفِ

71
00:20:31,785 --> 00:20:34,456
مَنْ

72
00:20:34,456 --> 00:21:48,346
يَجِبُ عَلَيْهِ الصِّيَامُ،

73
00:21:48,346 --> 00:21:49,709
وَفِيهِ خَمْسُ صِفَاتٍ: - أَوَّلُهَا: أَنَّهُ مُسْلِمٌ،

74
00:21:48,346 --> 00:21:49,709
فَلَا يَجِبُ الصِّيَامُ

75
00:22:06,617 --> 00:22:07,825
عَلَى الْكَافِرِ

76
00:22:31,992 --> 00:22:33,200
حَتَّى يُسْلِمَ،

77
00:22:32,596 --> 00:22:33,200
وَلَا يَصِحُّ مِنْهُ إِذَا وَقَعَ قَبْلَ إِسْلَامِهِ،

78
00:22:32,596 --> 00:22:33,200
وَلَا يَصِحُّ مِنْهُ إِذَا وَقَعَ قَبْلَ إِسْلَامِهِ.

79
00:22:32,596 --> 00:22:33,200
- وَثَانِيهَا: أَنَّهُ بَالِغٌ،

80
00:22:32,596 --> 00:22:33,200
وَهُوَ مُشْتَقٌّ

81
00:22:37,962 --> 00:22:39,867
مِنَ الْبُلُوغِ،

82
00:22:38,914 --> 00:22:39,867
وَالْبُلُوغُ شَرْعًا هُوَ وُصُولُ الْعَبْدِ حَدَّ الْمُؤَاخَذَةِ

83
00:23:31,562 --> 00:23:34,572
عَلَى سَيِّئَاتِهِ،

84
00:23:33,067 --> 00:23:34,572
وَلَهُ عَلَامَاتٌ مِنْهَا

85
00:23:52,660 --> 00:23:55,700
فِي الذَّكَرِ: بُلُوغُهُ خَمْسَةَ عَشَرَ سَنَةً،

86
00:23:54,180 --> 00:23:55,700
وَنَبَاتُ شَعْرِ عَانَتِهِ،

87
00:23:54,180 --> 00:23:55,700
وَخُرُوجُ مَنِيِّهِ بِاحْتِلَامٍ أَوْ غَيْرِهِ،

88
00:23:54,180 --> 00:23:55,700
وَكَذَا

89
00:24:01,336 --> 00:24:04,080
فِي الْأُنْثَى،

90
00:24:02,708 --> 00:24:04,080
وَكَذَا

91
00:24:35,287 --> 00:24:38,813
فِي الْأُنْثَى،

92
00:24:37,050 --> 00:24:38,813
فَخَرَجَ بِهَذَا الْوَصْفِ مَنْ

93
00:25:09,084 --> 00:25:11,666
لَمْ

94
00:25:11,666 --> 00:25:14,248
يَبْلُغْ حَدَّ الْبُلُوغِ كَالْمُمَيِّزِ وَمَنْ دُونَهُ،

95
00:25:21,155 --> 00:25:23,318
فَلَا يَجِبُ

96
00:25:24,399 --> 00:25:25,480
الصَّوْمُ

97
00:25:25,480 --> 00:25:28,313
إِلَّا

98
00:26:15,464 --> 00:26:23,260
عَلَى بَالِغٍ،

99
00:26:19,362 --> 00:26:23,260
فَلَا

100
00:26:19,362 --> 00:26:23,260
يَجِبُ

101
00:26:19,362 --> 00:26:23,260
الصَّوْمُ

102
00:26:19,362 --> 00:26:23,260
إِلَّا

103
00:26:19,362 --> 00:26:23,260
عَلَى بَالِغٍ.

104
00:26:19,362 --> 00:26:23,260
-

105
00:26:19,362 --> 00:26:23,260
وَثَالِثُهَا:

106
00:26:19,362 --> 00:26:23,260
أَنَّهُ عَاقِلٌ،

107
00:26:28,760 --> 00:26:30,593
وَهُوَ

108
00:26:30,593 --> 00:26:32,427
مُشْتَقٌّ

109
00:27:34,944 --> 00:27:39,605
مِنَ الْعَقْلِ،

110
00:27:37,274 --> 00:27:39,605
وَالْعَقْلُ قُوَّةٌ يَتَمَكَّنُ بِهَا الْمَرْءُ

111
00:28:41,155 --> 00:28:46,337
مِنَ الْإِدْرَاكِ،

112
00:28:43,746 --> 00:28:46,337
فَخَرَجَ بِهَذَا

113
00:29:25,855 --> 00:29:27,740
مَنْ يُعَانِي

114
00:29:47,938 --> 00:29:50,239
مِنْ زَوَالِ عَقْلٍ أَوْ تَغْطِيَتِهِ،

115
00:29:49,089 --> 00:29:50,239
وَمِنْ زَوَالِ الْعَقْلِ

116
00:30:59,229 --> 00:31:01,267
الَّذِي

117
00:31:01,267 --> 00:31:03,305
هُوَ فَقْدُ الْجُنُونِ وَهَذَا زَوَالٌ حَقِيقِيٌّ،

118
00:31:01,267 --> 00:31:03,305
وَمِنْ زَوَالِ الْعَقْلِ أَيْضًا كَوْنُ

119
00:31:58,555 --> 00:31:59,661
الْمَرْءِ طِفْلًا تَحْتَ سِنِّ التَّمْيِيزِ

120
00:32:14,582 --> 00:32:15,687
فَإِنَّ عَقْلَهُ

121
00:32:28,340 --> 00:32:31,431
فِي حُكْمِ الْعَدَمِ لِكَوْنِهِ غَيْرَ قَادِرٍ عَلَى اسْتِعْمَالِهِ،

122
00:32:30,813 --> 00:32:31,431
وَيُعْرَفُ هَذَا بِالزَّوَالِ الْحُكْمِيِّ،

123
00:32:30,813 --> 00:32:31,431
وَمِنْ تَغْطِيَةِ الْعَقْلِ الْإِغْمَاءُ الطَّوِيلُ كَغَيْبُوبَةٍ وَنَحْوِهَا،

124
00:32:30,813 --> 00:32:31,431
فَمَنْ لَابَسَ شَيْئًا

125
00:32:49,340 --> 00:32:50,776
مِنْ ذَلِكَ لَمْ يَجِبْ عَلَيْهِ الصِّيَامُ أَصْلًا.

126
00:32:50,140 --> 00:33:20,438
- وَرَابِعُهَا: أَنَّهُ مُسْتَطِيعٌ أَيْ قَادِرٌ عَلَى الصِّيَامِ،

127
00:33:20,438 --> 00:33:21,053
فَخَرَجَ بِذَلِكَ الْعَاجِزُ عَنْهُ،

128
00:33:20,438 --> 00:33:21,053
وَهَذَا الْعَاجِزُ نَوْعَانِ: الْأَوَّلُ: عَاجِزٌ حَقِيقِيٌّ،

129
00:33:20,438 --> 00:33:21,053
وَهَذَا حَظُّ

130
00:33:30,446 --> 00:33:31,709
مَنْ لَا يَقْدِرُ

131
00:33:42,637 --> 00:33:44,806
عَلَى الصِّيَامِ أَصْلًا كَالْمَرِيضِ مَرَضًا شَدِيدًا،

132
00:33:43,721 --> 00:33:44,806
وَالْآخَرُ: عَجْزٌ حُكْمِيٌّ،

133
00:33:44,806 --> 00:33:48,059
وَهُوَ حَظُّ مَنْ

134
00:33:48,059 --> 00:33:49,143
شَقَّ

135
00:33:52,397 --> 00:33:53,481
عَلَيْهِ

136
00:34:49,736 --> 00:34:52,804
الصِّيَامُ مَشَقَّةً شَدِيدَةً يَقْدِرُ مَعَهَا

137
00:35:19,874 --> 00:35:21,656
عَلَى

138
00:35:21,656 --> 00:35:23,437
الصِّيَامِ

139
00:35:23,437 --> 00:35:25,218
لَكِنْ يَثْقُلُ

140
00:35:25,218 --> 00:35:28,780
ذَلِكَ عَلَيْهِ،

141
00:35:26,999 --> 00:35:28,780
عَجْزٌ حَقِيقِيٌّ يَثْقُلُ

142
00:35:33,780 --> 00:35:35,780
ذَلِكَ عَلَيْهِ غَايَةَ الثِّقَلِ،

143
00:35:34,780 --> 00:35:35,780
فَهَذَا

144
00:36:53,129 --> 00:36:55,199
فِي حُكْمِ الْعَاجِزِ عَنِ

145
00:37:13,580 --> 00:37:16,126
الصِّيَامِ بِشِدَّةِ مُشَابَهَتِهِ لَهُمْ،

146
00:37:14,580 --> 00:37:16,126
وَمِثْلُ هَؤُلَاءِ

147
00:37:34,678 --> 00:37:37,770
لَا يَجِبُ عَلَيْهِمُ

148
00:37:59,240 --> 00:38:02,675
الصِّيَامُ بَلْ يَحْرُمُ مِنْهُمْ كَمَا سَيَأْتِي.

149
00:38:00,957 --> 00:38:02,675
- وَالْوَصْفُ

150
00:39:12,086 --> 00:39:13,972
الْخَامِسُ:

151
00:39:13,972 --> 00:39:15,858
كَوْنُهُ سَالِمًا

152
00:39:44,285 --> 00:39:46,676
مِنَ

153
00:39:46,676 --> 00:39:49,068
الْمَوَانِعِ أَيْ خَالِيًا مِنْهَا،

154
00:39:46,676 --> 00:39:49,068
وَمَوَانِعُ الصِّيَامِ هِيَ أَحْوَالٌ تَطْرَأُ عَلَى الْعَبْدِ يُمْنَعُ مَعَهَا

155
00:40:34,460 --> 00:40:36,250
مِنَ

156
00:40:36,250 --> 00:40:38,040
الصِّيَامِ كَرَاهَةً أَوْ تَحْرِيمًا كَالْحَيْضِ،

157
00:40:36,250 --> 00:40:38,040
فَإِنَّ الْحَائِضَ يَحْرُمُ عَلَيْهَا الصِّيَامُ وَلَا يَصِحُّ مِنْهَا كَمَا سَيَأْتِي.

158
00:40:36,250 --> 00:40:38,040
وَهَذَا الْوُجُوبُ الَّذِي ذَكَرَهُ الْمُصَنِّفُ يَتَعَلَّقُ بِصَوْمِ الْفَرْضِ،

159
00:40:36,250 --> 00:40:38,040
وَصَوْمُ الْفَرْضِ اسْمٌ جَامِعٌ لِكُلِّ مَا أَوْجَبَهُ اللَّهُ

160
00:40:57,509 --> 00:41:00,003
مِنَ الصِّيَامِ،

161
00:40:58,756 --> 00:41:00,003
وَأَوْجَبُهُ صِيَامُ رَمَضَانَ

162
00:41:13,540 --> 00:41:15,926
وَهُوَ

163
00:41:15,926 --> 00:41:18,312
رُكْنٌ

164
00:41:23,085 --> 00:41:25,471
مِنْ

165
00:41:25,471 --> 00:41:27,858
أَرْكَانِ الْإِسْلَامِ كَمَا تَقَدَّمَ،

166
00:41:25,471 --> 00:41:27,858
وَلَا يَقْتَصِرُ اسْمُ الْفَرْضِ عَلَيْهِ،

167
00:41:25,471 --> 00:41:27,858
فَإِنَّ

168
00:42:00,760 --> 00:42:02,530
مِنَ

169
00:42:02,530 --> 00:42:04,300
الصِّيَامِ الْفَرْضِ صِيَامَ النَّذْرِ وَصِيَامَ الْكَفَّارَةِ وَغَيْرَهَا مِمَّا يَجِبُ بِهِ

170
00:42:02,530 --> 00:42:04,300
الصِّيَامُ، فَلَا يَقْتَصِرُ اسْمُ الْفَرْضِ عَلَى صِيَامِ رَمَضَانَ كَمَا قَدَّمْنَا.

171
00:42:02,530 --> 00:42:04,300
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: نَعَمْ،

172
00:42:02,530 --> 00:42:04,300
وَيَحْرُمُ

173
00:43:24,190 --> 00:43:26,480
الصَّوْمُ

174
00:43:26,480 --> 00:43:28,770
عَلَى الْحَائِضِ وَالنُّفَسَاءِ مُطْلَقًا.

175
00:43:26,480 --> 00:43:28,770
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: بَعْدَ أَنْ بَيَّنَ الْمُصَنِّفُ كَوْنَ وُجُوبِ

176
00:43:26,480 --> 00:43:28,770
الصِّيَامِ مُعَلَّقًا عَلَى جُمْلَةٍ

177
00:43:56,885 --> 00:44:01,601
مِنَ الْأَوْصَافِ،

178
00:43:59,243 --> 00:44:01,601
وَكَانَ

179
00:44:35,188 --> 00:44:37,832
مِنْ جُمْلَةِ هَذِهِ الْأَوْصَافِ سَلَامَةُ الْمُبْتَغِي لِلصِّيَامِ

180
00:44:45,764 --> 00:44:48,408
مِنْ مَوَانِعِهِ،

181
00:44:47,086 --> 00:44:48,408
شَرَعَ

182
00:44:52,085 --> 00:44:54,439
فِي

183
00:44:54,439 --> 00:44:56,794
ذِكْرِ أَنْوَاعٍ شَتَّى

184
00:44:59,148 --> 00:45:01,503
مِنَ

185
00:45:01,503 --> 00:45:03,858
الْخَلْقِ تَقُومُ بِهِمْ جُمْلَةٌ

186
00:45:13,276 --> 00:45:15,631
مِنَ

187
00:45:15,631 --> 00:45:17,985
الْمَوَانِعِ يَتَرَتَّبُ عَلَيْهَا تَعَدُّدُ أَحْكَامِ

188
00:46:30,887 --> 00:46:34,244
الصِّيَامِ

189
00:46:37,601 --> 00:46:40,958
فِي

190
00:46:40,958 --> 00:46:44,315
حَقِّ كُلٍّ مِنْهُمْ،

191
00:46:40,958 --> 00:46:44,315
وَابْتَدَأَ بِذِكْرِ الْحَائِضِ وَالنُّفَسَاءِ لِكَوْنِ

192
00:47:04,134 --> 00:47:06,156
الْحُكْمِ الْمُتَعَلِّقِ بِهِمَا

193
00:47:41,089 --> 00:47:43,690
حُكْمًا

194
00:47:43,690 --> 00:47:46,291
وَاحِدًا

195
00:48:39,010 --> 00:49:21,595
لَا غَيْرَ،

196
00:49:21,595 --> 00:49:24,343
وَهُوَ حُرْمَةُ صِيَامِهِمَا مُطْلَقًا.

197
00:49:21,595 --> 00:49:24,343
وَالْمُرَادُ بِقَوْلِهِ مُطْلَقًا

198
00:50:20,232 --> 00:50:23,143
أَيْ

199
00:50:23,143 --> 00:50:26,053
فَرْضًا وَنَفْلًا،

200
00:50:23,143 --> 00:50:26,053
وَالْحَائِضُ هِيَ مَنْ

201
00:50:26,053 --> 00:50:28,964
يَخْرُجُ مِنْهَا دَمُ الْحَيْضِ

202
00:51:16,156 --> 00:51:18,992
فِي أَوْقَاتٍ مَعْلُومَةٍ،

203
00:51:17,574 --> 00:51:18,992
وَالْحَيْضُ

204
00:52:31,911 --> 00:52:33,987
هُوَ

205
00:52:33,987 --> 00:52:36,064
دَمُ الْجِبِلَّةِ أَيْ خِلْقَةً يَخْرُجُ

206
00:53:12,393 --> 00:53:15,352
مِنَ الْمَرْأَةِ

207
00:53:33,104 --> 00:53:36,063
فِي أَوْقَاتٍ مَعْلُومَةٍ،

208
00:53:34,584 --> 00:53:36,063
وَالنُّفَسَاءُ هِيَ الَّتِي يَخْرُجُ مِنْهَا دَمُ النِّفَاسِ،

209
00:53:34,584 --> 00:53:36,063
وَدَمُ النِّفَاسِ هُوَ دَمٌ يَخْرُجُ

210
00:54:21,696 --> 00:54:23,608
مِنَ

211
00:54:23,608 --> 00:54:25,519
الْمَرْأَةِ عِنْدَ الْوِلَادَةِ وَيَبْقَى بَعْدَهَا مُدَّةً،

212
00:54:23,608 --> 00:54:25,519
فَمَنْ خَرَجَ مِنْهَا دَمُ الْحَيْضِ

213
00:55:17,640 --> 00:55:19,837
أَوْ دَمُ النِّفَاسِ صَارَتْ بِذَلِكَ حَائِضًا أَوْ نُفَسَاءَ،

214
00:55:18,739 --> 00:55:19,837
فَحَرُمَ عَلَيْهَا الصِّيَامُ وَلَمْ يَصِحَّ مِنْهَا فَرْضًا كَانَ أَوْ نَفْلًا.

215
00:55:18,739 --> 00:55:19,837
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: نَعَمْ،

216
00:55:18,739 --> 00:55:19,837
وَمَا وَجَبَ صَوْمُ رَمَضَانَ عَلَى

217
00:56:54,001 --> 00:56:54,766
الْمَرِيضِ

218
00:57:03,183 --> 00:57:03,949
مَا

219
00:57:38,384 --> 00:57:40,365
لَمْ يَشُقَّ

220
00:58:00,586 --> 00:58:01,871
عَلَيْهِ فَيُكْرَهُ،

221
00:58:01,229 --> 00:58:05,729
وَإِنْ تَضَرَّرَ بِهِ حَرُمَ،

222
00:58:05,729 --> 00:58:08,943
وَمَنْ أَفْطَرَ تَعَلَّقَ بِذِمَّتِهِ قَضَاءٌ مِنْ حِينِ إِمْكَانِهِ،

223
00:58:09,586 --> 00:58:10,871
فَإِنْ مَاتَ قَبْلَهُ سَقَطَ عَنْهُ بِلَا إِطْعَامٍ،

224
00:58:10,229 --> 00:58:10,871
فَإِنْ

225
00:58:41,494 --> 00:58:43,791
كَانَ لَا يُرْجَى بُرْؤُهُ لَزِمَهُ الْإِطْعَامُ،

226
00:58:42,642 --> 00:58:43,791
فَإِذَا أَطْعَمَ ثُمَّ بَرَأَ لَمْ يَقْضِ،

227
00:58:42,642 --> 00:58:43,791
وَإِنْ لَمْ يُطْعِمْ حَتَّى مَاتَ وَلَوْ مُفَرِّطًا لَزِمَ وَلِيَّهُ الْإِطْعَامُ

228
00:58:48,385 --> 00:58:50,682
مِنْ تَرِكَتِهِ،

229
00:58:49,533 --> 00:58:50,682
فَإِذَا لَمْ تَكْفِ أَطْعَمَ

230
00:58:55,330 --> 00:58:56,730
مِنْ مَالِهِ

231
00:59:52,740 --> 00:59:54,740
إِنْ

232
00:59:54,740 --> 00:59:56,740
كَانَ ابْنًا لَهُ وُجُوبًا وَإِلَّا اسْتُحِبَّ.

233
00:59:54,740 --> 00:59:56,740
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: بَيَّنَ الْمُصَنِّفُ

234
01:02:11,670 --> 01:02:12,470
فِي

235
01:03:05,800 --> 01:03:07,800
هَذِهِ الْجُمْلَةِ جُمْلَةً

236
01:03:09,190 --> 01:03:11,970
مِنَ الْأَحْكَامِ مِمَّا يَتَعَلَّقُ بِصِيَامِ الْمَرِيضِ،

237
01:03:10,580 --> 01:03:11,970
وَقَدَّمَ الْمُصَنِّفُ الْقَوْلَ

238
01:04:44,414 --> 01:04:48,041
فِي

239
01:04:48,041 --> 01:04:51,669
الْمَرِيضِ

240
01:04:48,041 --> 01:04:51,669
تِبَاعًا

241
01:04:48,041 --> 01:04:51,669
لِخِطَابِ الشَّرْعِ،

242
01:05:02,550 --> 01:05:04,683
فَإِنَّهُ

243
01:05:46,580 --> 01:05:48,486
فِي

244
01:05:48,486 --> 01:05:50,391
قَوْلِهِ تَعَالَى: ﴿وَمَنْ كَانَ مَرِيضًا أَوْ عَلَى سَفَرٍ فَعِدَّةٌ

245
01:06:20,714 --> 01:06:22,765
مِنْ

246
01:06:35,912 --> 01:06:37,560
أَيَّامٍ

247
01:07:48,587 --> 01:07:51,750
أُخَرَ﴾ قَدَّمَ سُبْحَانَهُ ذِكْرَ الْمَرِيضِ عَلَى غَيْرِهِ.

248
01:07:49,420 --> 01:07:51,750
وَذَكَرَ الْمُصَنِّفُ

249
01:08:54,923 --> 01:08:56,066
فِي هَذِهِ الْجُمْلَةِ عَشَرَةَ أَحْكَامٍ لِلْمَرِيضِ

250
01:09:15,610 --> 01:09:17,110
فِي صِيَامِهِ: - فَأَوَّلُهَا: حُكْمُهُ الْأَصْلِيُّ وَهُوَ وُجُوبُ صَوْمِ رَمَضَانَ،

251
01:09:16,360 --> 01:09:17,110
وَاقْتَصَرَ الْمُصَنِّفُ عَلَى ذِكْرِ رَمَضَانَ

252
01:09:28,942 --> 01:09:31,900
فِي هَذِهِ الْجُمْلَةِ لِأَهَمِّيَّتِهِ فَإِنَّهُ أَوْجَبُ أَنْوَاعِ الصِّيَامِ كَمَا قَدَّمْنَا،

253
01:09:30,421 --> 01:09:31,900
وَمَحَلُّ وُجُوبِ صَوْمِ رَمَضَانَ عَلَى الْمَرِيضِ

254
01:10:10,204 --> 01:10:12,231
هُوَ مَا لَمْ يَشُقَّ عَلَيْهِ

255
01:10:13,245 --> 01:10:15,272
أَيْ كَانَ مَرَضُهُ خَفِيفًا فَلَا يَشُقُّ مَعَهُ الصَّوْمُ.

256
01:10:14,258 --> 01:10:15,272
- وَالْحُكْمُ الثَّانِي:

257
01:11:37,637 --> 01:11:39,234
هُوَ كَرَاهَةُ صَوْمِ الْمَرِيضِ فِي

258
01:11:43,226 --> 01:11:44,025
رَمَضَانَ

259
01:12:01,406 --> 01:12:03,404
إِنْ شَقَّ عَلَيْهِ،

260
01:12:02,405 --> 01:12:03,404
وَمُوجِبُ الْكَرَاهَةِ تَرْكُهُ لِلرُّخْصَةِ وَإِشْقَاقُهُ عَلَى نَفْسِهِ،

261
01:12:02,405 --> 01:12:03,404
فَأَمَّا الْمُوجِبُ

262
01:12:34,631 --> 01:12:36,762
الْأَوَّلُ وَهُوَ تَرْكُ الرُّخْصَةِ يُكْرَهُ بِأَنَّ

263
01:12:55,939 --> 01:12:57,004
اللَّهَ

264
01:13:04,462 --> 01:13:05,527
يُحِبُّ

265
01:13:14,050 --> 01:13:16,598
أَنْ

266
01:13:16,598 --> 01:13:19,146
تُؤْتَى رُخَصُهُ كَمَا

267
01:14:03,291 --> 01:14:03,967
فِي

268
01:14:48,358 --> 01:14:52,110
قَوْلِهِ:

269
01:14:52,110 --> 01:14:54,004
[إِنَّ

270
01:15:20,860 --> 01:15:22,193
اللَّهَ يُحِبُّ

271
01:16:28,525 --> 01:16:31,470
أَنْ تُؤْتَى رُخَصُهُ كَمَا يُحِبُّ

272
01:16:55,931 --> 01:16:56,832
أَنْ تُؤْتَى عَزَائِمُهُ]،

273
01:16:56,381 --> 01:16:56,832
فَفِيهِ بَيَانُ

274
01:17:06,208 --> 01:17:07,292
أَنَّ

275
01:17:24,635 --> 01:17:26,802
اللَّهَ يُحِبُّ

276
01:18:07,193 --> 01:18:10,309
مِنَ

277
01:18:10,309 --> 01:18:13,424
الْعَبْدِ الْأَخْذَ بِالرُّخَصِ كَمَا يُحِبُّ مِنْهُ أَدَاءَ الْفُرُوضِ فَإِنَّ عَزَائِمَهُ

278
01:18:10,309 --> 01:18:13,424
هِيَ فُرُوضُهُ.

279
01:18:10,309 --> 01:18:13,424
- وَالْمُوجِبُ الثَّانِي لِلْكَرَاهَةِ:

280
01:18:29,430 --> 01:18:30,430
هُوَ إِشْقَاقُهُ عَلَى نَفْسِهِ،

281
01:18:29,930 --> 01:18:30,430
وَعِلَّةُ الْكَرَاهَةِ فِيهِ فَأَنَّ

282
01:18:36,739 --> 01:18:38,142
اللَّهَ يُحِبُّ

283
01:18:45,750 --> 01:18:46,750
مِنَ الْعَبْدِ الْيُسْرَ وَيَكْرَهُ مِنْهُ الْعُسْرَ

284
01:19:36,210 --> 01:19:37,057
كَمَا

285
01:19:47,079 --> 01:19:48,477
قَالَ تَعَالَى: ﴿يُرِيدُ

286
01:19:50,575 --> 01:19:51,973
اللَّهُ بِكُمُ الْيُسْرَ وَلَا يُرِيدُ بِكُمُ الْعُسْرَ﴾،

287
01:19:51,274 --> 01:19:51,973
وَهَذِهِ الْجُمْلَةُ

288
01:20:03,502 --> 01:20:05,074
مِنَ الْآيَةِ قَدْ وَقَعَتْ

289
01:20:45,508 --> 01:20:47,000
فِي نَفْسِ آيَةِ الصِّيَامِ الَّتِي قَدَّمْنَاهَا،

290
01:20:46,254 --> 01:20:47,000
فَهِيَ

291
01:20:50,770 --> 01:20:52,655
فِي

292
01:20:52,655 --> 01:20:54,540
قَوْلِهِ

293
01:20:54,540 --> 01:20:56,249
تَعَالَى: ﴿وَمَنْ كَانَ مَرِيضًا أَوْ عَلَى سَفَرٍ فَعِدَّةٌ

294
01:21:58,206 --> 01:22:01,127
مِنْ أَيَّامٍ أُخَرَ يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ

295
01:22:50,300 --> 01:22:52,800
وَلَا

296
01:22:52,800 --> 01:22:55,300
يُرِيدُ بِكُمُ الْعُسْرَ﴾،

297
01:22:52,800 --> 01:22:55,300
فَكَانَتْ أَصْلًا

298
01:23:22,880 --> 01:23:23,880
فِي الرُّخْصَةِ

299
01:23:37,715 --> 01:23:39,385
فِي بَابِ الصِّيَامِ،

300
01:23:38,550 --> 01:23:39,385
وَمَعْنَى يُرِيدُ أَيْ يُحِبُّ،

301
01:23:38,550 --> 01:23:39,385
اللَّهُ يُحِبُّ الْيُسْرَ وَلَا يُحِبُّ الْعُسْرَ.

302
01:23:38,550 --> 01:23:39,385
- وَالْحُكْمُ الثَّالِثُ:

303
01:24:02,273 --> 01:24:04,767
فِي

304
01:24:04,767 --> 01:24:07,260
قَوْلِ الْمُصَنِّفِ: [وَإِنْ تَضَرَّرَ بِهِ حَرُمَ]،

305
01:24:04,767 --> 01:24:07,260
فَفِيهِ حُرْمَةُ الصِّيَامِ الَّذِي يُسَبِّبُ الضَّرَرَ لِلْمَرِيضِ،

306
01:24:08,816 --> 01:24:10,371
فِي حَدِيثِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ:

307
01:24:51,366 --> 01:24:53,988
[لَا ضَرَرَ وَلَا ضِرَارَ] رَوَاهُ ابْنُ مَاجَه وَغَيْرُهُ وَإِسْنَادُهُ حَسَنٌ،

308
01:24:52,677 --> 01:24:53,988
فَيَحْرُمُ عَلَى

309
01:25:05,749 --> 01:25:08,361
الْعَبْدِ الَّذِي يَضُرُّ بِنَفْسِهِ.

310
01:25:07,055 --> 01:25:08,361
وَمِمَّا يُنَبَّهُ إِلَيْهِ مِمَّا يَتَعَلَّقُ بِالْحُكْمَيْنِ الْأَخِيرَيْنِ أَنَّ كَثِيرًا

311
01:25:25,810 --> 01:25:26,965
مِنَ

312
01:25:41,356 --> 01:25:44,728
النَّاسِ يَظُنُّ خِلَافَ ذَلِكَ،

313
01:25:43,042 --> 01:25:44,728
فَيَظُنُّ

314
01:26:13,701 --> 01:26:16,156
أَنَّ الْمَرْءَ إِذَا شَقَّ عَلَى نَفْسِهِ وَأَكْثَرَ

315
01:26:54,970 --> 01:26:56,788
مِنْ

316
01:26:56,788 --> 01:26:58,606
ذَلِكَ حَتَّى بَلَغَ بِهَا حَدَّ الضَّرَرِ كَانَ ذَلِكَ أَعْظَمَ

317
01:27:45,416 --> 01:27:47,448
لَهُ عِنْدَ رَبِّهِ مِمَّا يَجِدُ

318
01:27:52,530 --> 01:27:54,380
مِنَ الصَّبْرِ وَالْمُصَابَرَةِ فِي الْعِبَادَةِ،

319
01:27:53,455 --> 01:27:54,380
وَهَذَا مَعْنًى بَاطِلٌ،

320
01:27:53,455 --> 01:27:54,380
فَإِنَّ اللَّهَ لَمْ يَتَعَبَّدْنَا بِالصِّيَامِ لِيُعَذِّبَنَا

321
01:28:06,401 --> 01:28:08,251
بِهِ وَلَمْ يَجْعَلْ دِينَنَا كَذَلِكَ،

322
01:28:07,326 --> 01:28:08,251
وَلِهَذَا تَجِدُ

323
01:28:19,950 --> 01:28:21,283
مِنْ هَؤُلَاءِ

324
01:28:38,811 --> 01:28:40,559
مَنْ يَصُومُ خَائِرَ الْقُوَى ضَعِيفَ الْبَدَنِ وَلَا يَجِدُ

325
01:28:51,049 --> 01:28:52,797
فِي نَفْسِهِ إِقْبَالًا عَلَى اللَّهِ عَزَّ وَجَلَّ،

326
01:28:51,923 --> 01:28:52,797
وَكَيْفَ يُقْبِلُ وَهَذِهِ الْحَالُ؟

327
01:28:51,923 --> 01:28:53,672
ثُمَّ إِذَا قَالَ لَهُ أَحَدُهُمْ: يَا أَخِي يَعْنِي أَخِّرْ صِيَامَكَ

328
01:28:52,797 --> 01:28:53,672
بَعْضَ الْوَقْتِ لَعَلَّكَ تَكُونُ بِخَيْرٍ إِنْ شَاءَ اللَّهُ ثُمَّ تَكُونُ

329
01:28:52,797 --> 01:28:53,672
فِي حَالٍ مُنَاسِبَةٍ لِلصِّيَامِ يُمْكِنُ لَكَ بِكَثِيرٍ

330
01:29:07,153 --> 01:29:07,991
مِنَ

331
01:29:32,875 --> 01:29:34,938
الصِّيَامِ وَيَجِبُ بِهَا إِقْبَالٌ

332
01:29:46,286 --> 01:29:47,317
عَلَى

333
01:30:20,980 --> 01:30:22,100
اللَّهِ فَتَكُونُ

334
01:30:52,001 --> 01:30:53,442
فِي حَالٍ أَكْمَلَ

335
01:30:56,323 --> 01:30:57,764
فِي الْعُبُودِيَّةِ،

336
01:30:57,043 --> 01:30:57,764
نَظَرَ إِلَيْهِ بِاشْمِئْزَازٍ وَقَالَ: وَأَيُّ عُبُودِيَّةٍ أَكْمَلُ

337
01:31:30,213 --> 01:31:31,439
مِنَ الَّتِي أَنَا فِيهَا الْآنَ؟

338
01:31:30,826 --> 01:31:31,439
فَإِنِّي أَصْبِرُ وَأُصَابِرُ،

339
01:31:55,860 --> 01:31:57,193
وَهَذَا فَهْمٌ سَقِيمٌ،

340
01:31:56,527 --> 01:31:57,193
فَإِنَّ الْأَمْرَ كَمَا قَدَّمْنَا

341
01:31:59,860 --> 01:32:01,862
فِي آيَاتِ الصِّيَامِ وَقَعَ

342
01:32:38,151 --> 01:32:39,707
عَلَى هَذَا النَّحْوِ الَّذِي ذَكَرْنَاهُ،

343
01:32:38,929 --> 01:32:39,707
بَعْدَ أَنْ أَمَرَ

344
01:32:44,440 --> 01:32:46,040
اللَّهُ الْعِبَادَ بِصَوْمِ شَهْرِ رَمَضَانَ وَهُوَ رُكْنٌ مِنْ أَرْكَانِ الْإِسْلَامِ

345
01:32:45,240 --> 01:32:46,040
فَأَسْقَطَ اللَّهُ رُكْنًا لِأَجْلِ هَذَا الْمَعْنَى،

346
01:32:45,240 --> 01:32:46,040
هُوَ سُبْحَانَهُ الَّذِي فَرَضَهُ وَأَوْجَبَهُ،

347
01:32:45,240 --> 01:32:46,040
وَالْعَبْدُ عَلَى نَفْسِهِ وَهُوَ أَضْعَفُ مِنْ ذَلِكَ فَاللَّهُ يَرْحَمُهُ وَيَتَفَضَّلُ

348
01:32:45,240 --> 01:32:46,040
عَلَيْهِ بِهَذِهِ الرَّحْمَةِ وَهُوَ يَتَعَالَى عَنْ أَنْ يَقْبَلَهَا،

349
01:32:45,240 --> 01:32:46,040
فَهَذِهِ حَالُ سُوءٍ يَنْبَغِي لِلْعَبْدِ أَنْ يَتَنَزَّهَ عَنْهَا.

350
01:32:45,240 --> 01:32:46,040
- وَالْحُكْمُ الرَّابِعُ: فِي بَيَانِ مَا يَتَرَتَّبُ عَلَى الْإِفْطَارِ فَقَالَ:

351
01:32:45,240 --> 01:32:46,040
[وَمَنْ أَفْطَرَ تَعَلَّقَ بِذِمَّتِهِ الْقَضَاءُ مِنْ حِينِ إِمْكَانِهِ]،

352
01:32:45,240 --> 01:32:46,040
[وَمَنْ أَفْطَرَ تَعَلَّقَ بِذِمَّتِهِ الْقَضَاءُ مِنْ حِينِ إِمْكَانِهِ]،

353
01:32:45,240 --> 01:32:46,040
فَإِذَا أَفْطَرَ عَبْدٌ لِمَرَضٍ شَقَّ مَعَهُ الصِّيَامُ فَإِنَّ الْقَضَاءَ وَاجِبٌ

354
01:32:45,240 --> 01:32:46,040
عَلَيْهِ كَمَا تَقَدَّمَ،

355
01:32:45,240 --> 01:32:46,040
وَيَبْتَدِئُ وَقْتُ وُجُوبِ الْقَضَاءِ مِنْ حِينِ إِمْكَانِهِ،

356
01:32:45,240 --> 01:32:46,040
وَالْمُرَادُ بِإِمْكَانِهِ قُدْرَةُ الْعَبْدِ عَلَى الصِّيَامِ وَصِحَّةُ ذَلِكَ مِنْهُ،

357
01:32:45,240 --> 01:32:46,040
قُدْرَةُ الْعَبْدِ عَلَى الصِّيَامِ وَصِحَّةُ ذَلِكَ مِنْهُ،

358
01:32:45,240 --> 01:32:46,040
فَأَمَّا قُدْرَتُهُ عَلَى الصِّيَامِ فَتَقَعُ بِتَعَافِيهِ مِنَ الْمَرَضِ أَوْ تَخَفُّفِهِ

359
01:32:45,240 --> 01:32:46,040
مِنْهُ، وَأَمَّا صِحَّةُ الصِّيَامِ مِنْهُ بِأَنْ لَا يَكُونَ صِيَامًا مُحَرَّمًا

360
01:32:45,240 --> 01:32:46,040
كَصَوْمِ يَوْمِ عِيدِ الْفِطْرِ،

361
01:32:45,240 --> 01:32:46,040
فَمَنْ مَرِضَ فِي رَمَضَانَ مَرَضًا شَدِيدًا ثُمَّ تَعَافَى مِنْهُ شَيْئًا

362
01:32:45,240 --> 01:32:46,040
فَشَيْئًا حَتَّى بَلَغَ يَوْمَ الْعِيدِ وَهُوَ يَتَعَافَى وَلَمْ يَبْلُغْ بَعْدُ

363
01:32:45,240 --> 01:32:46,040
الْقُدْرَةَ عَلَى الصِّيَامِ،

364
01:32:45,240 --> 01:32:46,040
فَلَمَّا أَصْبَحَ فِي يَوْمِ عِيدِ الْفِطْرِ وَجَدَ فِي نَفْسِهِ قُدْرَةً

365
01:32:45,240 --> 01:32:46,040
عَلَى الصِّيَامِ فَهَذَا لَا يَصِحُّ لَهُ صَوْمُهُ وَإِنْ نَوَاهُ مِنَ

366
01:32:45,240 --> 01:32:46,040
اللَّيْلِ إِذْ يَحْرُمُ صِيَامُ يَوْمِ الْعِيدِ إِذْ يَحْرُمُ صِيَامُ يَوْمِ

367
01:32:45,240 --> 01:32:46,040
الْعِيدِ إِجْمَاعًا،

368
01:32:45,240 --> 01:32:46,040
فَلَيْسَ بِإِمْكَانِهِ الصِّيَامُ فِي هَذَا الْيَوْمِ فَلَمْ يَبْلُغْ حَدَّ الْإِمْكَانِ

369
01:32:45,240 --> 01:32:46,040
فَلَمْ يَتَعَلَّقِ الْقَضَاءُ بِذِمَّتِهِ بَعْدُ،

370
01:32:45,240 --> 01:32:46,040
فَإِذَا قَضَى الْيَوْمَ مَعَ أَهْلِهِ ثُمَّ نَامَ مُرِيدًا أَنْ يَصُومَ

371
01:32:45,240 --> 01:32:46,040
أَوَّلَ يَوْمٍ بَعْدَ الْعِيدِ قَضَاءً لِرَمَضَانَ صَحَّ ذَلِكَ مِنْهُ،

372
01:32:45,240 --> 01:32:46,040
صَحَّ ذَلِكَ مِنْهُ لِكَوْنِهِ قَادِرًا عَلَى الصِّيَامِ فِي وَقْتٍ يَصْلُحُ

373
01:32:45,240 --> 01:32:46,040
فِيهِ الصِّيَامُ.

374
01:32:45,240 --> 01:32:46,040
- وَالْحُكْمُ الْخَامِسُ: هُوَ الْمَذْكُورُ فِي قَوْلِهِ: [فَإِنْ مَاتَ قَبْلَهُ

375
01:32:45,240 --> 01:32:46,040
سَقَطَ عَنْهُ بِلَا إِطْعَامٍ]،

376
01:32:45,240 --> 01:32:46,040
فَفِي هَذَا بَيَانُ أَنَّ مَنْ لَمْ يُدْرِكْ وَقْتًا مُنَاسِبًا لِلْقَضَاءِ

377
01:32:45,240 --> 01:32:46,040
سَقَطَ عَنْهُ الْقَضَاءُ وَلَمْ يَلْزَمْ إِطْعَامُهُ،

378
01:32:45,240 --> 01:32:46,040
كَمَنْ ظَلَّ مَرِيضًا حَتَّى مَاتَ،

379
01:32:45,240 --> 01:32:46,040
أَوْ كَمَنْ تَعَافَى لَيْلَةَ الْعِيدِ ثُمَّ مَاتَ مِنْ يَوْمِهِ فَإِنَّهُ

380
01:32:45,240 --> 01:32:46,040
لَمْ يُدْرِكْ مَحَلًّا صَالِحًا لِلْقَضَاءِ،

381
01:32:45,240 --> 01:32:46,040
وَدَلِيلُ سُقُوطِ الْقَضَاءِ عَنْهُ قَوْلُهُ تَعَالَى: ﴿فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ﴾،

382
01:32:45,240 --> 01:32:46,040
وَدَلِيلُ سُقُوطِ الْقَضَاءِ عَنْهُ قَوْلُهُ تَعَالَى: ﴿فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ﴾،

383
01:32:45,240 --> 01:32:46,040
وَهُوَ لَمْ يُدْرِكْهَا فَلَيْسَ مِنْ أَهْلِ الْقَضَاءِ أَصْلًا،

384
01:32:45,240 --> 01:32:46,040
وَمِنْ ثَمَّ فَلَا يَجِبُ إِطْعَامٌ عَنْهُ.

385
01:32:45,240 --> 01:32:46,040
- وَالْحُكْمُ السَّادِسُ: هُوَ فِي نَوْعٍ خَاصٍّ مِنَ الْمَرْضَى وَهُوَ

386
01:32:45,240 --> 01:32:46,040
مَنْ كَانَ لَا يُرْجَى بُرْؤُهُ أَيْ لَا يُطْمَعُ فِي شِفَائِهِ

387
01:32:45,240 --> 01:32:46,040
لِتَعَذُّرِهِ، فَهَذَا لَنْ يَسْتَطِيعَ الْقَضَاءَ،

388
01:32:45,240 --> 01:32:46,040
هَذَا لَنْ يَسْتَطِيعَ الْقَضَاءَ،

389
01:32:45,240 --> 01:32:46,040
فَيَسْقُطُ عَنْهُ الْقَضَاءُ وَيَلْزَمُهُ الْإِطْعَامُ،

390
01:32:45,240 --> 01:32:46,040
فَتَصِيرُ الْقَاعِدَةُ أَنَّ مَنْ لَمْ يَسْتَطِعِ الصَّوْمَ أُمِرَ بِالْقَضَاءِ مَا

391
01:32:45,240 --> 01:32:46,040
اسْتَطَاعَهُ، وَمَنْ لَمْ يَسْتَطِعِ الْقَضَاءَ أُمِرَ بِالْإِطْعَامِ،

392
01:32:45,240 --> 01:32:46,040
وَمَنْ لَمْ يَسْتَطِعِ الْقَضَاءَ أُمِرَ بِالْإِطْعَامِ،

393
01:32:45,240 --> 01:32:46,040
إِلَّا مَنْ لَمْ يُدْرِكْ مَحَلًّا صَالِحًا لِلْقَضَاءِ فَإِنَّهُ لَا قَضَاءَ

394
01:32:45,240 --> 01:32:46,040
عَلَيْهِ وَلَا إِطْعَامَ كَمَا قَدَّمْنَا،

395
01:32:45,240 --> 01:32:46,040
وَالْمَذْكُورُ فِي هَذَا الْحُكْمِ مِنْ قَوْلِهِ: [يُرْجَى بُرْؤُهُ] أَيْ بِاعْتِبَارِ

396
01:32:45,240 --> 01:32:46,040
مَا يُعْرَفُ مِنَ الْأَطِبَّاءِ الثِّقَاتِ،

397
01:32:45,240 --> 01:32:46,040
وَالْمَذْكُورُ فِي هَذَا الْحُكْمِ مِنَ الْقَضَاءِ أَيْ بِاعْتِبَارِ مَا يُعْرَفُ

398
01:32:45,240 --> 01:32:46,040
مِنَ الْأَطِبَّاءِ الثِّقَاتِ.

399
01:32:45,240 --> 01:32:46,040
- الْحُكْمُ السَّابِعُ: أَنَّ مَنْ أَطْعَمَ ثُمَّ بَرَأَ لَمْ يَقْضِ،

400
01:32:45,240 --> 01:32:46,040
وَفِي مَنْ أَطْعَمَ ثُمَّ بَرَأَ لَمْ يَقْضِ،

401
01:32:45,240 --> 01:32:46,040
فَإِنَّهُ يُكْتَفَى بِإِطْعَامِهِ عَنِ الْقَضَاءِ،

402
01:32:45,240 --> 01:32:46,040
فَإِنَّهُ يُكْتَفَى بِإِطْعَامِهِ عَنِ الْقَضَاءِ،

403
01:32:45,240 --> 01:32:46,040
فَإِنَّهُ يُكْتَفَى بِإِطْعَامِهِ عَنِ الْقَضَاءِ لِكَوْنِ الْإِطْعَامِ وَقَعَ بَدَلًا عَنِ

404
01:32:45,240 --> 01:32:46,040
الْقَضَاءِ حَالَ عَجْزِهِ عَنْهُ فَأَسْقَطَ الصِّيَامَ الْمُتَعَلِّقَ فِي ذِمَّتِهِ،

405
01:32:45,240 --> 01:32:46,040
وَلَا تَعَارُضَ بَيْنَ الْحُكْمَيْنِ الْأَخِيرَيْنِ،

406
01:32:45,240 --> 01:32:46,040
فَإِنَّ قَوْلَنَا فِي الْحُكْمِ الْأَوَّلِ: [لَا يُرْجَى بُرْؤُهُ] كَانَ بِاعْتِبَارِ

407
01:32:45,240 --> 01:32:46,040
الثِّقَاتِ مِنَ الْأَطِبَّاءِ فَكَانَ رَأْيًا بَشَرِيًّا،

408
01:32:45,240 --> 01:32:46,040
وَقَوْلُنَا فِي الْحُكْمِ الثَّانِي: [ثُمَّ بَرَأَ] كَانَ بِاعْتِبَارِ إِرَادَةِ اللَّهِ

409
01:32:45,240 --> 01:32:46,040
فِيهِ فَكَانَ حُكْمًا إِلَهِيًّا،

410
01:32:45,240 --> 01:32:46,040
وَالْحُكْمُ الْإِلَهِيُّ نَافِذٌ وَلَوْ ضِدَّ إِرَادَةِ جَمِيعِ الْبَشَرِ.

411
01:32:45,240 --> 01:32:46,040
- وَالْحُكْمُ الثَّامِنُ: قَوْلُهُ: [وَإِنْ لَمْ يُطْعِمْ حَتَّى مَاتَ وَلَوْ

412
01:32:45,240 --> 01:32:46,040
مُفَرِّطًا لَزِمَ وَلِيَّهُ الْإِطْعَامُ مِنْ تَرِكَتِهِ]،

413
01:32:45,240 --> 01:32:46,040
فَفِيهِ بَيَانُ أَنَّهُ مَنْ وَقَعَ عَلَيْهِ إِطْعَامٌ لِكَوْنِهِ مَرِيضًا لَا

414
01:32:45,240 --> 01:32:46,040
يُرْجَى بُرْؤُهُ ثُمَّ مَاتَ دُونَ أَنْ يُطْعِمَ -إِمَّا لِعَجْزِهِ عَنِ

415
01:32:45,240 --> 01:32:46,040
الْإِطْعَامِ أَوْ لِكَوْنِهِ مُفَرِّطًا أَيْ مُهْمِلًا مُتَجَاهِلًا لِلْحُكْمِ أَوْ غَيْرَ

416
01:32:45,240 --> 01:32:46,040
ذَلِكَ- فَإِنَّ وُجُوبَ الْإِطْعَامِ يَنْتَقِلُ إِلَى ذِمَّةِ وَلِيِّهِ،

417
01:32:45,240 --> 01:32:46,040
وَوَلِيُّهُ هُوَ الْقَائِمُ عَلَى أَحْوَالِهِ مِنْ وَرَثَتِهِ،

418
01:32:45,240 --> 01:32:46,040
فَيُطْعَمُ عَنْهُ مِنْ تَرِكَتِهِ أَيْ مِنْ وَرَثَتِهِ،

419
01:32:45,240 --> 01:32:46,040
وَيَكُونُ هَذَا خَارِجًا عَنْ قِسْمَةِ الْمِيرَاثِ فَإِنَّهُ كَالدَّيْنِ بَيْنَ الْعَبْدِ

420
01:32:45,240 --> 01:32:46,040
وَرَبِّهِ، وَدَيْنُ اللَّهِ أَحَقُّ أَنْ يُقْضَى.

421
01:32:45,240 --> 01:32:46,040
- وَالْحُكْمُ التَّاسِعُ: فِي قَوْلِهِ: [فَإِنْ لَمْ تَكْفِ أَطْعَمَ مِنْ

422
01:32:45,240 --> 01:32:46,040
مَالِهِ إِنْ كَانَ ابْنًا لَهُ وُجُوبًا]،

423
01:32:45,240 --> 01:32:46,040
فَفِيهِ بَيَانُ أَنَّ مَنْ لَمْ تَفِ تَرِكَتُهُ مِنَ الْمَوْتَى عَلَى

424
01:32:45,240 --> 01:32:46,040
هَذِهِ الْحَالِ مِمَّنْ وَجَبَ عَلَيْهِ مِنَ الْإِطْعَامِ وَلَمْ يُطْعِمْهُ وَكَانَ

425
01:32:45,240 --> 01:32:46,040
وَلِيُّهُ ابْنًا لَهُ فَيَجِبُ عَلَيْهِ أَنْ يُطْعِمَ عَنْ أَبِيهِ مِنْ

426
01:32:45,240 --> 01:32:46,040
مَالِهِ هُوَ بِالْبِرِّ بِأَبِيهِ.

427
01:32:45,240 --> 01:32:46,040
- وَالْحُكْمُ الْعَاشِرُ: قَوْلُهُ: [وَإِلَّا اسْتُحِبَّ]،

428
01:32:45,240 --> 01:32:46,040
وَالْمُرَادُ بِهِ بَيَانُ حُكْمِ الْإِطْعَامِ مِنْ مَالِ الْوَلِيِّ إِذَا لَمْ

429
01:32:45,240 --> 01:32:46,040
تَفِ تَرِكَةُ الْمَيِّتِ بِحَقِّ الْإِطْعَامِ الَّذِي كَانَ وَاجِبًا عَلَيْهِ فِي

430
01:32:45,240 --> 01:32:46,040
حَالِ أَنَّ الْوَلِيَّ لَيْسَ ابْنًا لِلْمَيِّتِ،

431
01:32:45,240 --> 01:32:46,040
وَإِنَّمَا يَكُونُ أَخًا لَهُ أَوْ صَدِيقًا وَنَحْوَ ذَلِكَ،

432
01:32:45,240 --> 01:32:46,040
فَهَذَا يُسْتَحَبُّ لَهُ أَنْ يُطْعِمَ عَنِ الْمَيِّتِ وَلَا يَجِبُ عَلَيْهِ،

433
01:32:45,240 --> 01:32:46,040
فَإِنْ بَذَلَ مِنْ مَالِهِ فِي الْإِطْعَامِ كَانَ ذَلِكَ إِحْسَانًا لِلْمَيِّتِ.

434
01:32:45,240 --> 01:32:46,040
وَبِهِ تَعْلَمُ أَنَّ الصِّيَامَ لَا يَسْقُطُ وُجُوبُهُ أَبَدًا،

435
01:32:45,240 --> 01:32:46,040
فَإِنَّهُ لَمَّا لَمْ يَصُمْ طُولِبَ بِالْقَضَاءِ،

436
01:32:45,240 --> 01:32:46,040
فَلَمَّا لَمْ يَقْدِرْ عَلَى الْقَضَاءِ طُولِبَ بِالْإِطْعَامِ،

437
01:32:45,240 --> 01:32:46,040
فَلَمَّا لَمْ يُطْعِمْ طُولِبَ وَلِيُّهُ بِالْإِطْعَامِ إِمَّا وُجُوبًا أَوِ اسْتِحْبَابًا،

438
01:32:45,240 --> 01:32:46,040
فَلَا يَسْقُطُ الطَّلَبُ بِالصِّيَامِ أَبَدًا إِلَّا فِي حَقِّ مَنْ سَعَى

439
01:32:45,240 --> 01:32:46,040
إِلَى أَدَائِهِ ثُمَّ اخْتَرَمَتْهُ الْمَنِيَّةُ قَبْلَ أَنْ يُدْرِكَ مَحَلًّا صَالِحًا

440
01:32:45,240 --> 01:32:46,040
لَهُ فَإِنَّ الْقَضَاءَ لَمْ يَكُنْ قَدْ عَلِقَ بِذِمَّتِهِ بَعْدُ.

441
01:32:45,240 --> 01:32:46,040
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَالْكَبِيرُ الْعَاجِزُ كَالْمَرِيضِ الَّذِي لَا يُرْجَى

442
01:32:45,240 --> 01:32:46,040
بُرْؤُهُ. قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: هَذِهِ الْجُمْلَةُ بَيَانُ كَوْنِ الْمَرِيضِ

443
01:32:45,240 --> 01:32:46,040
الَّذِي لَا يُرْجَى بُرْؤُهُ لَهُ نَظِيرٌ آخَرُ مُشَارِكٌ لَهُ فِي

444
01:32:45,240 --> 01:32:46,040
عَامَّةِ مَا ذَكَرْنَاهُ مِنَ الْأَحْكَامِ وَهُوَ الْكَبِيرُ الْعَاجِزُ،

445
01:32:45,240 --> 01:32:46,040
وَأَفْرَدَ الْمُصَنِّفُ حُكْمَ هَذَا النَّوْعِ مِنَ النَّاسِ بِبَيَانِ الْفَاصِلِ لِلْحَاجَةِ

446
01:32:45,240 --> 01:32:46,040
إِلَيْهِ فَإِنَّهُ مُتَفَشٍّ فِيهِمْ.

447
01:32:45,240 --> 01:32:46,040
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَيُبَاحُ الْفِطْرُ لِلْمُسَافِرِ سَفَرَ قَصْرٍ لَمْ

448
01:32:45,240 --> 01:32:46,040
يَتَحَايَلْ بِهِ مِنْ بِدَايَةِ سَفَرِهِ وَإِلَّا حَرُمَ،

449
01:32:45,240 --> 01:32:46,040
وَمَنْ أَفْطَرَ لِسَفَرٍ لَمْ يَلْزَمْهُ الْإِمْسَاكُ وَإِذَا أَقَامَ فِي الْوَقْتِ،

450
01:32:45,240 --> 01:32:46,040
وَلَا يَجْهَرُ بِفِطْرِهِ فِي رَمَضَانَ طَلَبًا لِسَلَامَةِ الصَّدْرِ،

451
01:32:45,240 --> 01:32:46,040
وَإِنْ شَقَّ عَلَيْهِ الصِّيَامُ كُرِهَ لَهُ،

452
01:32:45,240 --> 01:32:46,040
فَإِنْ كَانَتْ شَدِيدَةً حَرُمَ،

453
01:32:45,240 --> 01:32:46,040
وَيُسْتَحَبُّ لَهُ الْأَيْسَرُ مِنَ الصَّوْمِ وَالْفِطْرِ،

454
01:32:45,240 --> 01:32:46,040
فَإِنِ اسْتَوَيَا فَالْأَفْضَلُ الصَّوْمُ لِشُهُورِ الشَّهْرِ وَمُوَافَقَةِ النَّاسِ،

455
01:32:45,240 --> 01:32:46,040
وَلَا يُؤَثِّرُ اعْتِيَادُهُ لِلسَّفَرِ.

456
01:32:45,240 --> 01:32:46,040
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ أَحْكَامَ

457
01:32:45,240 --> 01:32:46,040
صِيَامِ الْمُسَافِرِ،

458
01:32:45,240 --> 01:32:46,040
وَأَخَّرَ الْمُسَافِرَ عَنِ الْمَرِيضِ فِي ذِكْرِ أَحْكَامِهِ تِبَاعًا لِلْوَارِدِ فِي

459
01:32:45,240 --> 01:32:46,040
خِطَابِ الشَّرْعِ كَمَا قَالَ تَعَالَى: ﴿فَمَنْ كَانَ مَرِيضًا أَوْ عَلَى

460
01:32:45,240 --> 01:32:46,040
سَفَرٍ فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ﴾.

461
01:32:45,240 --> 01:32:46,040
عِدَّةُ الْمَذْكُورِ فِيمَا يَتَعَلَّقُ بِالْمُسَافِرِ مِنَ الْأَحْكَامِ فِي هَذِهِ الْجُمْلَةِ

462
01:32:45,240 --> 01:32:46,040
تِسْعَةُ أَحْكَامٍ: - الْحُكْمُ الْأَوَّلُ: إِبَاحَةُ الْفِطْرِ لِلْمُسَافِرِ بِشَرْطَيْنِ اثْنَيْنِ:

463
01:32:45,240 --> 01:32:46,040
الْأَوَّلُ: كَوْنُهُ مُسَافِرًا سَفَرَ قَصْرٍ أَيْ سَفَرًا يَتَجَاوَزُ بِهِ مَسَافَةَ

464
01:32:45,240 --> 01:32:46,040
الْقَصْرِ، وَالْمُرَادُ بِذَلِكَ أَنْ يَتَرَخَّصَ فِيهِ بِقَصْرِ الصَّلَاةِ،

465
01:32:45,240 --> 01:32:46,040
وَهَذِهِ الْمَسَافَةُ هِيَ أَرْبَعَةُ بُرُدٍ وَعِدَّتُهَا بِالْأَكْيَالِ سِتَّةٌ وَسَبْعُونَ كَيْلًا

466
01:32:45,240 --> 01:32:46,040
وَثَمَانُ مِئَةِ مِتْرٍ،

467
01:32:45,240 --> 01:32:46,040
فَيُقَالُ تَقْرِيبًا ثَمَانِينَ كَيْلًا،

468
01:32:45,240 --> 01:32:46,040
وَالشَّرْطُ الثَّانِي: كَوْنُهُ لَمْ يَتَحَايَلْ بِهِ أَيْ لَمْ يَتَّخِذْهُ حِيلَةً

469
01:32:45,240 --> 01:32:46,040
لِإِسْقَاطِ وُجُوبِ الصِّيَامِ فَإِنَّ الرُّخَصَ لَا تُحَصَّلُ بِالْحِيلَةِ،

470
01:32:45,240 --> 01:32:46,040
فَمَنْ سَافَرَ سَفَرَ قَصْرٍ بُغْيَةَ أَنْ يُفْطِرَ فِي رَمَضَانَ فَأَتَمَّ

471
01:32:45,240 --> 01:32:46,040
سَفَرَهُ ثُمَّ أَفْطَرَ فَقَدْ عَصَى بِسَفَرِهِ ثُمَّ عَصَى بِفِطْرِهِ وَيَلْزَمُهُ

472
01:32:45,240 --> 01:32:46,040
الْقَضَاءُ، فَقَدْ عَصَى بِسَفَرِهِ ثُمَّ عَصَى بِفِطْرِهِ وَيَلْزَمُهُ الْقَضَاءُ.

473
01:32:45,240 --> 01:32:46,040
ثُمَّ ذَكَرَ الْمُصَنِّفُ فِي هَذَا الْحُكْمِ أَيْضًا ابْتِدَاءَ الرُّخَصِ فَقَالَ:

474
01:32:45,240 --> 01:32:46,040
[مِنْ ابْتِدَاءِ السَّفَرِ]،

475
01:32:45,240 --> 01:32:46,040
فَابْتِدَاءُ هَذِهِ الرُّخَصِ هُوَ مِنْ ابْتِدَاءِ السَّفَرِ لِكَوْنِهَا مَنُوطَةً بِهِ،

476
01:32:45,240 --> 01:32:46,040
وَابْتِدَاءُ السَّفَرِ يَكُونُ بِمُفَارَقَةِ عُمْرَانِ الْبَلَدِ أَيْ مَا كَانَ عَامِرًا

477
01:32:45,240 --> 01:32:46,040
فِيهَا بِالسُّكَّانِ،

478
01:32:45,240 --> 01:32:46,040
فَمَتَى فَارَقَ عَامِرَ بَلَدِهِ سُمِّيَ مُسَافِرًا،

479
01:32:45,240 --> 01:32:46,040
وَيَصْدُقُ اسْمُ السَّفَرِ عَلَيْهِ إِذَا تَجَاوَزَ مَسَافَةَ الْقَصْرِ ثُمَّ أَقَامَ

480
01:32:45,240 --> 01:32:46,040
فِي بَلَدٍ دُونَ أَرْبَعَةِ أَيَّامٍ فَإِنَّهُ يُسَمَّى مُسَافِرًا،

481
01:32:45,240 --> 01:32:46,040
أَوْ أَقَامَ لِحَاجَةٍ لَا يَعْلَمُ زَمَنًا قَضَائِهَا،

482
01:32:45,240 --> 01:32:46,040
فَمِنَ الْأَوَّلِ رَجُلٌ سَافَرَ لِزِيَارَةِ أَهْلِ اللَّهِ فِي بَلَدٍ تَبْعُدُ

483
01:32:45,240 --> 01:32:46,040
عَنْ بَلَدِهِ مِئَةَ كَيْلٍ ثُمَّ أَقَامَ عِنْدَهُمْ ثَلَاثَةَ أَيَّامٍ فَهَذَا

484
01:32:45,240 --> 01:32:46,040
مُسَافِرٌ فَلَهُ الْفِطْرُ طَوَالَ هَذِهِ الْمُدَّةِ،

485
01:32:45,240 --> 01:32:46,040
فَإِنْ مَاتَ أَحَدٌ مِنْ أَهْلِهِ فِي الْيَوْمِ الثَّالِثِ فَقَرَّرَ الْمُكْثَ

486
01:32:45,240 --> 01:32:46,040
