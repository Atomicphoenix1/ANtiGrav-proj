1
00:00:01,300 --> 00:00:03,300
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ

2
00:00:09,668 --> 00:00:10,511
اللَّهِ وَبَرَكَاتُهُ وَبَرَكَاتُهُ،

3
00:00:10,089 --> 00:00:10,511
الْحَمْدُ لِلَّهِ رَبِّنَا،

4
00:00:11,774 --> 00:00:13,037
وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

5
00:00:12,616 --> 00:00:14,300
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ الْمُبْعَدُ،

6
00:00:14,300 --> 00:00:17,616
فَهَذَا الْمَجْلِسُ الثَّامِنُ فِي شَرْحِ الْكِتَابِ الْأَوَّلِ

7
00:00:17,616 --> 00:00:20,932
مِنْ بَرْنَامَجِ [عُدَّةِ رَمَضَانَ] فِي سَنَتِهِ الْأُولَى

8
00:00:20,932 --> 00:00:23,300
سَنَةَ خَمْسِينَ وَأَرْبَعِينَ وَأَرْبَعِمِائَةٍ وَأَلْفٍ،

9
00:00:23,300 --> 00:00:26,531
وَالْكِتَابُ الْمَقْرُوءُ فِيهِ [بُغْيَةُ الصَّائِمِ] لِمُصَنِّفِهِ

10
00:00:26,531 --> 00:00:30,300
[مُحَمَّدِ بْنِ سَلَامَةَ بْنِ مُحَمَّدِ بْنِ هِلَالٍ]،

11
00:00:30,300 --> 00:00:33,682
وَقَدِ انْتَهَى بِنَا الْبَيَانُ إِلَى

12
00:00:33,682 --> 00:00:37,065
قَوْلِ الْمُصَنِّفِ: فَصْلٌ فِي مَقَاصِدِ

13
00:00:37,065 --> 00:00:38,418
الصِّيَامِ وَفَضَائِلِهِ،

14
00:00:38,418 --> 00:00:39,771
نَعَمْ. قَالَ

15
00:01:05,139 --> 00:01:08,217
الْمُصَنِّفُ رَحِمَهُ اللَّهُ: فَصْلٌ فِي

16
00:01:08,986 --> 00:01:10,525
مَقَاصِدِ الصِّيَامِ،

17
00:01:10,525 --> 00:01:11,294
بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

18
00:01:10,525 --> 00:01:11,294
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

19
00:01:10,525 --> 00:01:11,294
بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ

20
00:01:52,590 --> 00:01:54,426
عَلَى نَبِيِّنَا مُحَمَّدٍ

21
00:02:21,140 --> 00:02:23,140
عَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

22
00:02:22,140 --> 00:02:23,140
أَمَّا بَعْدُ،

23
00:02:22,140 --> 00:02:23,140
وَهُمْ مَغْفِرٌ لِلشَّيْخَيْنِ وَلِوَلِيِّهِ وَلِشُيُوخِهِ وَلِلْمُسْلِمِينَ أَجْمَعِينَ،

24
00:02:22,140 --> 00:02:25,140
أَقُولُ وَفَّقَكُمُ اللَّهُ

25
00:02:25,140 --> 00:02:26,140
فِي مَتْنِ [بُغْيَةِ الصَّائِمِ]: فَصْلٌ فِي مَقَاصِدِ

26
00:02:34,740 --> 00:02:35,640
الصِّيَامِ وَفَضَائِلِهِ.

27
00:02:35,140 --> 00:02:35,640
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: عَقَدَ

28
00:02:39,310 --> 00:02:41,650
الْمُصَنِّفُ فَصْلًا آخَرَ

29
00:03:14,642 --> 00:03:16,026
فِي بَيَانِ مَقَاصِدِ الصِّيَامِ وَفَضَائِلِهِ،

30
00:03:15,334 --> 00:03:16,026
فَفِيهِ بَيَانُ أَمْرَيْنِ اثْنَيْنِ: أَحَدُهُمَا: مَقَاصِدُ الصِّيَامِ،

31
00:03:15,334 --> 00:03:16,026
وَهِيَ الْأَهْدَافُ الْمَنْشُودَةُ مِنْهُ،

32
00:03:15,334 --> 00:03:16,026
فَهِيَ

33
00:03:34,180 --> 00:03:35,103
مَا

34
00:03:43,411 --> 00:03:45,257
يُطْلَبُ الصِّيَامُ لِأَجْلِهِ،

35
00:03:44,334 --> 00:03:45,257
وَالثَّانِي: فَضَائِلُهُ،

36
00:03:44,334 --> 00:03:46,180
وَهِيَ مَا تَعَلَّقَ بِهِ مِنَ الْخَصَائِصِ

37
00:04:10,403 --> 00:04:12,892
فِيمَا يَحْسُنُ بِالْعَبْدِ أَلَّا يَزْهَدَ فِيهِ وَأَلَّا يُخْلِيَ نَفْسَهُ مِنْهُ؛

38
00:04:11,647 --> 00:04:12,892
وَوَقَعَ هَذَا الْفَصْلُ

39
00:05:09,220 --> 00:05:11,540
فِي آخِرِ هَذَا الْكِتَابِ لِيَكُونَ عَوْنًا لِمُتَلَقِّيهِ عَلَى تَهْيِئَةِ نَفْسِهِ

40
00:05:10,380 --> 00:05:11,540
لِاسْتِقْبَالِ رَمَضَانَ،

41
00:05:10,380 --> 00:05:11,540
فَيُذْكِي

42
00:05:40,895 --> 00:05:42,520
بِهِ شُعْلَةَ نَفْسِهِ

43
00:05:49,020 --> 00:05:51,487
فِي الْعِلْمِ وَالْعَمَلِ بِمَا تَلَقَّاهُ،

44
00:05:50,253 --> 00:05:52,720
فَإِذَا أُلْقِيَ إِلَيَّ شَيْءٌ مِنَ

45
00:05:52,720 --> 00:05:53,953
الْفَضَائِلِ وَأَدْرَكَ

46
00:06:34,527 --> 00:06:35,733
مِنْ مَقَاصِدِ

47
00:06:48,234 --> 00:06:50,116
الصِّيَامِ مَا يَنْبَغِي إِدْرَاكُهُ حَمَلَهُ ذَلِكَ عَلَى الْإِقْبَالِ عَلَى اللَّهِ

48
00:06:49,175 --> 00:06:50,116
بِالصِّيَامِ وَتَحْسِينِهِ وَالِاجْتِهَادِ فِيهِ بِمَا يَصْلُحُ بِهِ صِيَامُهُ وَيَحْصُلُ لَهُ

49
00:06:49,175 --> 00:06:50,116
بِهِ عَدَدُ

50
00:06:51,999 --> 00:06:53,654
الصِّيَامِ كَمَالُ حَالِهِ عِنْدَ رَبِّهِ عَزَّ وَجَلَّ.

51
00:06:52,940 --> 00:06:53,654
وَوَقَعَ الْمُصَنِّفُ بِهَذَا الْفَصْلُ عَلَى ذِكْرِ الْآيَاتِ وَالْأَحَادِيثِ الْمُتَعَلِّقَةِ بِفَضَائِلِ

52
00:07:18,185 --> 00:07:19,343
الصِّيَامِ وَمَقَاصِدِهِ مَعَ إِخْلَائِهِ عُمُومًا الْكِتَابَ

53
00:07:24,374 --> 00:07:25,198
مِنْ ذَلِكَ بِأَمْرَيْنِ اثْنَيْنِ: أَحَدُهُمَا:

54
00:07:53,740 --> 00:07:55,100
أَنْ يَحْمِلَ مُتَلَقِّي هَذَا

55
00:08:03,240 --> 00:08:04,320
الْكِتَابِ الْعَمَلَ بِهَذِهِ الْفَضَائِلِ وَالْمَقَاصِدِ،

56
00:08:11,560 --> 00:08:13,240
فَإِنَّ أَذِلَّةَ الشَّرِيعَةِ إِذَا وَقَرَتْ

57
00:08:27,780 --> 00:08:29,780
فِي نَفْسِ الْمُتَعَلِّمِ كَانَتْ حَامِلًا لَهُ عَلَى الْخَيْرِ،

58
00:08:28,780 --> 00:08:29,780
فَإِنَّ مِمَّا يَحْسُنُ بِهِ سَوْقُ النَّاسِ إِلَى عُبُودِيَّةِ رَبِّهِمُ اسْتِعْمَالُ

59
00:08:28,780 --> 00:08:29,780
كَلَامِهِ وَكَلَامِ نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

60
00:08:28,780 --> 00:08:29,780
فَلَهُمَا

61
00:08:38,580 --> 00:08:39,780
مِنْ حَمِيدِ الْأَثَرِ

62
00:08:51,780 --> 00:08:52,780
مَا يَصْلُحُ بِهِ قَلْبُ الْمُتَلَقِّي لَهُ بِمَا يَحْمِلُهُ عَلَى مَا

63
00:08:52,280 --> 00:08:52,780
يُطْلَبُ مِنَ الْخَيْرِ؛ وَالْمُوجِبُ الثَّانِي: مُنَازَعَةٌ لِمَنْ أَسَاءَ اسْتِعْمَالُ

64
00:09:04,973 --> 00:09:06,307
هَذِهِ الْأَدِلَّةِ مِمَّنْ تَصَدَّرَ لِلتَّدْرِيسِ

65
00:09:19,640 --> 00:09:21,640
فِي النَّاسِ بِآخِرِهِ وَوَعْظِهِمْ وَدَلَالَتِهِمْ

66
00:10:08,320 --> 00:10:09,920
عَلَى الْخَيْرِ،

67
00:10:09,120 --> 00:10:09,920
فَإِنَّ مِمَّا سَاءَ النَّاسَ بِآخِرِهِ فِيمَا يَتَعَلَّقُ بِهَذِهِ الْأَدِلَّةِ أَمْرَانِ

68
00:10:09,120 --> 00:10:09,920
اثْنَانِ: أَحَدُهُمَا: خَلْطُ الْحَابِلِ بِالنَّابِلِ وَاسْتِعْمَالُ الْمُنْكَرِ وَالْبَاطِلِ وَالْمُضْطَرِبِ

69
00:10:23,640 --> 00:10:24,840
مِنَ الْأَحَادِيثِ بِمَا يُفْسِدُ دِينَ النَّاسِ بِجَعْلِهِ مَبْنِيًّا

70
00:10:40,097 --> 00:10:41,553
عَلَى الْبَاطِلِ لَا

71
00:11:17,900 --> 00:11:20,300
عَلَى الْحَقِّ،

72
00:11:19,100 --> 00:11:20,300
وَالْأَمْرُ الثَّانِي: أَنَّهُمْ أَسَاءَ فَهْمَ

73
00:11:44,700 --> 00:11:46,600
هَذِهِ

74
00:11:46,600 --> 00:11:48,500
الْأَدِلَّةِ وَرَدَّهَا إِلَى أُصُولِهَا الشَّرْعِيَّةِ وَإِحْكَامِ مَوَارِدِهَا،

75
00:11:46,600 --> 00:11:48,500
فَنَتَجَ

76
00:12:02,133 --> 00:12:04,000
مِنْ ذَلِكَ ضَعْفٌ

77
00:12:37,560 --> 00:12:39,537
فِي الْأَحْكَامِ وَإِخْلَالٌ بِمَقَاصِدِ الشَّرْعِيِّ وَغَيْرُ

78
00:13:11,280 --> 00:13:12,080
ذَلِكَ

79
00:13:15,280 --> 00:13:16,880
مِنَ الْعَوَاقِبِ الْوَخِيمَةِ لِلْجَهْلِ الْفَاشِي

80
00:13:39,213 --> 00:13:41,080
فِي النَّاسِ.

81
00:13:40,147 --> 00:13:41,080
فَإِذَا عَلِمْتَ ذَلِكَ عَلِمْتَ أَنَّهُ

82
00:14:03,080 --> 00:14:04,080
مِنْ مَنْفَعَةِ الْمُتَعَلِّمِ أَنْ تَضْبِطَ لَهُ هَذِهِ الْأَدِلَّةَ

83
00:14:21,860 --> 00:14:23,527
مِنْ جِهَةِ صِحَّةِ الدَّلِيلِ وَصِحَّةِ الِاسْتِدْلَالِ بِمَا يَتَحَقَّقُ لَهُ بِهِ

84
00:14:22,693 --> 00:14:23,527
حِفْظُ دِينِهِ مِمَّا يَشُوبُهُ مِنْ كَلَامِ هَؤُلَاءِ الْجُهَّالِ فِيهِ

85
00:14:57,640 --> 00:14:59,140
فِي الْبَاطِلِ

86
00:15:05,765 --> 00:15:07,015
مِنَ الْأَحَادِيثِ وَالْمُنْكَرِ وَغَيْرِهِ وَفِي الْأَحْكَامِ الَّتِي يَسْتَدِلُّونَ عَلَيْهَا بِهَذِهِ

87
00:15:06,390 --> 00:15:07,015
الْأَحَادِيثِ وَالدِّينُ مِنْهَا ضَرَاءُ،

88
00:15:06,390 --> 00:15:07,015
فَيَكُونُ بِذَلِكَ صَحَّ لَهُ تَلَقِّيهِ وَعَمَلُهُ وَهُوَ الْمُرَادُ،

89
00:15:06,390 --> 00:15:07,015
نَعَمْ.

90
00:15:19,711 --> 00:15:20,740
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: قَوْلُ اللَّهِ قَوْلُ اللَّهِ تَعَالَى قَوْلُ

91
00:15:20,140 --> 00:15:20,740
اللَّهِ تَعَالَى: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ

92
00:15:36,390 --> 00:15:37,890
الصِّيَامُ كَمَا كُتِبَ

93
00:15:50,997 --> 00:15:52,283
عَلَى الَّذِينَ

94
00:16:06,728 --> 00:16:08,140
مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ﴾

95
00:16:17,551 --> 00:16:20,263
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ فِي هَذَا الدَّلِيلِ ثَلَاثَ

96
00:16:19,977 --> 00:16:21,812
مَسَائِلَ: الْمَسْأَلَةُ الْأُولَى: بِقَوْلِهِ: ﴿كُتِبَ عَلَيْكُمُ الصِّيَامُ﴾،

97
00:16:21,812 --> 00:16:22,505
وَالْمُرَادُ فُرِضَ عَلَيْكُمُ الصِّيَامُ،

98
00:16:21,812 --> 00:16:22,505
فَإِنَّ الْكِتَابَةَ الْمَذْكُورَةَ فِي خِطَابِ الشَّرْعِيِّ نَوْعَاءُ: كِتَابَةٌ قَدَرِيَّةٌ وَمُتَعَلَّقُهَا

99
00:16:21,812 --> 00:16:22,505
تَقْدِيرُ الْوَقَاعِ وَالْحَوَادِثِ،

100
00:16:21,812 --> 00:16:22,505
وَالْآخَرُ: كِتَابَةٌ شَرْعِيَّةٌ،

101
00:16:21,812 --> 00:16:22,505
وَمِنْهَا هَذِهِ الْآيَةُ إِنَّ الْمَذْكُورَ فِيهَا

102
00:16:52,870 --> 00:16:54,120
مِنْ جُمْلَةِ الشَّرْعِ ذُو عِبَادَةٍ

103
00:17:07,120 --> 00:17:09,120
مِنَ الْعِبَادَاتِ،

104
00:17:08,120 --> 00:17:09,120
الْمُرَادُ بِقَوْلِهِ: ﴿كُتِبَ عَلَيْكُمُ

105
00:17:19,298 --> 00:17:19,950
الصِّيَامُ﴾

106
00:17:40,560 --> 00:18:20,135
أَيْ فُرِضَ عَلَيْكُمُ الصِّيَامُ،

107
00:18:56,045 --> 00:18:57,971
إِنَّ الْكِتَابَةَ الشَّرْعِيَّةَ

108
00:19:10,360 --> 00:19:11,860
تَكُونُ بِمَعْنَى الْفَرْضِ وَالْإِيجَابِ،

109
00:19:11,110 --> 00:19:12,610
وَيَا مِنْ أَلْفَاظِ الْأَمْرِ غَيْرِ الصَّرِيحَةِ غَيْرِ الصَّرِيحَةِ فِي الْقُرْآنِ

110
00:19:11,860 --> 00:19:12,610
غَيْرِ الصَّرِيحِ فِي الْقُرْآنِ،

111
00:19:11,860 --> 00:19:12,610
ذَكَرَهُ جَمَاعَةٌ مِنْهُمْ [أَبُو عَبْدِ

112
00:19:20,620 --> 00:19:21,420
اللَّهِ بْنُ الْقَيِّمِ]

113
00:20:03,651 --> 00:20:05,977
فِي [بَدَائِعِ الْفَوَائِدِ] وَ[مُحَمَّدُ بْنُ إِسْمَاعِيلَ الصَّنْعَانِيُّ الْأَمِيرُ]

114
00:20:08,140 --> 00:20:09,140
فِي [بُغْيَةِ الْآمِلِ].

115
00:20:08,640 --> 00:20:09,140
وَالْمَسْأَلَةُ الثَّانِيَةُ:

116
00:20:16,219 --> 00:20:17,234
فِي

117
00:20:39,250 --> 00:20:41,539
قَوْلِهِ: ﴿كَمَا كُتِبَ

118
00:21:31,500 --> 00:21:32,700
عَلَى الَّذِينَ

119
00:21:35,549 --> 00:21:37,798
مِنْ قَبْلِكُمْ﴾،

120
00:21:36,674 --> 00:21:37,798
فَإِنَّهَا أَفَادَتْ أَنَّ شَرِيعَةَ الصِّيَامِ لَيْسَتْ مُسْتَحْدَثَةً

121
00:21:46,747 --> 00:21:47,824
فِي الدِّينِ،

122
00:21:47,285 --> 00:21:47,824
وَإِنَّمَا هِيَ

123
00:22:01,770 --> 00:22:04,370
مِنْ جُمْلَةِ الشَّرَائِعِ الْمَنْقُولَةِ عَنْ أَهْلِ الْكِتَابِ مِمَّنْ تَقَدَّمَنَا،

124
00:22:03,070 --> 00:22:06,148
إِلَّا أَنَّنَا نُخَالِفُهُمْ فِي صِفَةِ هَذِهِ الشَّرِيعَةِ،

125
00:22:05,703 --> 00:22:06,148
فَإِنَّ أَهْلِ الْكِتَابِ إِنَّمَا اعْتَادُوا صِيَامًا أَيَّامًا،

126
00:22:05,703 --> 00:22:06,148
وَإِمَّا نَحْنُ فَقَدْ أُمِرْنَا بِصِيَامِ شَهْرٍ وَهُوَ شَهْرُ رَمَضَانَ،

127
00:22:05,703 --> 00:22:06,148
وَإِنَّمَا نَحْنُ فَقَدْ أُمِرْنَا هُوَ

128
00:22:13,170 --> 00:22:15,570
الْمَذْكُورُ بَعْدَ هَذِهِ الْآيَةِ فِي قَوْلِهِ: ﴿فَمَنْ شَهِدَ مِنْكُمُ الشَّهْرَ

129
00:22:14,770 --> 00:22:15,570
فَلْيَصُمْهُ﴾؛ وَمِنْ مَحَاسِنِ

130
00:22:56,818 --> 00:22:58,972
مَا ذَكَرَهُ جَمَاعَةٌ

131
00:23:00,049 --> 00:23:02,203
مِنَ الْمُفَسِّرِينَ

132
00:23:35,137 --> 00:23:37,563
أَنَّ آيَاتِ الصِّيَامِ لَمَّا ذَكَرَتِ الْقَدْرَ الَّذِي يَصُومُهُ

133
00:23:49,899 --> 00:23:51,535
الْعَبْدُ لَمْ تُصَرِّحْ بِكَوْنِهِ شَهْرًا ابْتِدَاءً،

134
00:23:50,717 --> 00:23:51,535
وَإِنَّمَا أَوَّلُ مَا

135
00:24:25,684 --> 00:24:26,953
ذُكِرَ وَهُوَ التَّابِعُ لِهَذِهِ الْآيَةِ مُبَاشَرَةً

136
00:24:37,101 --> 00:24:39,216
قَوْلُهُ: ﴿أَيَّامًا مَعْدُودَاتٍ﴾،

137
00:24:38,159 --> 00:24:39,216
ثُمَّ وَقَعَ بَعْدَ ذَلِكَ بَيَانُ

138
00:25:26,520 --> 00:25:27,520
أَنَّ هَذِهِ الْأَيَّامَ تَبْلُغُ شَهْرًا،

139
00:25:27,020 --> 00:25:27,520
وَمُوجِبُ التَّعْبِيرِ بِالْأَيَّامِ قَبْلَ ذِكْرِ الشَّهْرِ أَمْرَانِ اثْنَانِ: أَحَدُهُمَا:

140
00:25:59,986 --> 00:26:00,719
أَنَّ

141
00:26:08,784 --> 00:26:10,250
هَذَا الَّذِي اعْتَادَتْهُ الْعَرَبُ فِي صِيَامِهَا فِي الْأَدْيَانِ الْمُتَقَدِّمَةِ،

142
00:26:09,517 --> 00:26:10,250
وَلَا آخَرُ: تَهْوِينُ صِيَامِ هَذَا الْمَأْمُورِ شَرْعِيٌّ بِوَصْفِهِ بِكَوْنِهِ أَيَّامًا

143
00:26:09,517 --> 00:26:10,250
أَيْ مُدَّةً يَسِيرَةً،

144
00:26:09,517 --> 00:26:12,552
فَيَحْصُلُ لِمُتَلَقِّي هَذَا الْحُكْمِ أَنْ

145
00:26:12,552 --> 00:26:13,319
يَسْتَحْضِرَ كَوْنَهُ هَيِّنًا يَسِيرًا فَيَسْتَقْبِلُهُ بِانْشِرَاحِ صَدْرٍ وَطِيبِ نَفْسٍ،

146
00:26:12,552 --> 00:26:13,319
وَآذَانِ الْمُوجِبَانِ

147
00:26:17,155 --> 00:26:18,690
مِنْ دَقَائِقِ التَّصَرُّفَاتِ فِي الْخِطَابِ الشَّرْعِيِّ بِمَا يُوَافِقُ مَقْصِدَ الشَّرِيعَةِ

148
00:26:17,923 --> 00:26:18,690
فِي تَيْسِيرِ الْأَحْكَامِ

149
00:26:59,510 --> 00:27:00,875
عَلَى الْعِبَادِ.

150
00:27:00,192 --> 00:27:00,875
وَالْمَقْصِدُ وَالْمَسْأَلَةُ الثَّالِثَةُ:

151
00:27:13,470 --> 00:27:15,470
فِي قَوْلِهِ: ﴿لَعَلَّكُمْ تَتَّقُونَ﴾،

152
00:27:14,470 --> 00:27:15,470
فِيهَا بَيَانُ أَنَّ الْمَقْصِدَ الْأَعْظَمَ مِنَ

153
00:27:49,142 --> 00:27:51,584
الصِّيَامِ هُوَ تَحْقِيقُ التَّقْوَى،

154
00:27:50,363 --> 00:27:51,584
وَتَقَدَّمَ الْكَلَامُ عَلَيْهَا غَيْرَ مَرَّةٍ؛ وَمِنْ مَحَاسِنِ الْقَوْلِ مَا ذَكَرَهُ

155
00:27:50,363 --> 00:27:51,584
[ابْنُ الْقَيِّمِ]

156
00:27:57,687 --> 00:28:00,128
فِي [مِفْتَاحِ دَارِ السَّعَادَةِ]

157
00:28:13,883 --> 00:28:15,430
مِنْ قَوْلِهِ:

158
00:28:50,970 --> 00:28:51,770
[مَا اسْتُعِينَ

159
00:29:12,630 --> 00:29:14,630
عَلَى حِفْظِ حُدُودِ

160
00:29:22,933 --> 00:29:25,020
اللَّهِ وَاجِدُنَا بِمَحَالِمِهِ بِمِثْلِ الصِّيَامِ] انْتَهَى كَلَامُهُ،

161
00:29:23,977 --> 00:29:25,020
وَكَذَا قَالَ

162
00:29:36,453 --> 00:29:38,604
فِي [الْوَابِلِ الصَّيِّبِ]: [لَيْسَ الصِّيَامُ عَنِ الشَّرَابِ وَالطَّعَامِ،

163
00:29:37,529 --> 00:29:38,604
وَإِنَّمَا الصِّيَامُ عَنِ الْمُحَرَّمَاتِ وَالْآثَامِ] انْتَهَى كَلَامُهُ أَيْضًا،

164
00:29:37,529 --> 00:29:38,604
فَفِيهِ بَيَانُ أَنَّ الصِّيَامَ إِنَّمَا يَتَعَلَّقُ بِحِفْظِ حَقِّ اللَّهِ عَزَّ

165
00:29:37,529 --> 00:29:38,604
وَجَلَّ وَتَصْبِيرِ النَّفْسِ وَتَعْوِيدِهَا عَلَى حِفْظِ حُدُودِهِ وَاجْتِنَامِ مَحَارِمِهِ،

166
00:29:37,529 --> 00:29:38,604
فَلَيْسَ الشَّأْنُ تَرْكَ الطَّعَامِ وَالشَّرَابِ كَمَا سَيَأْتِي.

167
00:29:37,529 --> 00:29:38,604
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَقَوْلُ اللَّهِ تَعَالَى: ﴿وَالصَّائِمِينَ وَالصَّائِمَاتِ﴾ قَالَ

168
00:29:37,529 --> 00:29:38,604
الشَّارِحُ هَدَاهُ اللَّهُ:

169
00:29:42,124 --> 00:29:44,568
فِي هَذِهِ الْآيَةِ بَيَانُ فَضِيلَةِ الصِّيَامِ،

170
00:29:43,346 --> 00:29:44,568
فَإِنَّ اللَّهَ عَزَّ وَجَلَّ ذَكَرَ

171
00:29:46,790 --> 00:29:48,790
فِي تَتِمَّتِهَا: ﴿أَعَدَّ اللَّهُ لَهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا﴾،

172
00:29:47,790 --> 00:29:48,790
فَيَكُونُ

173
00:29:58,314 --> 00:30:00,750
مِنَ الْمَوْعُودِ بِهِ لِلصَّائِمِ أَمْرَانِ: أَحَدُهُمُ: الْمَغْفِرَةُ،

174
00:29:59,532 --> 00:30:00,750
وَفِيهَا أَحَادِيثُ مَشْهُورَةٌ،

175
00:29:59,532 --> 00:30:00,750
ثَانِي: الْأَجْرُ الْعَظِيمُ،

176
00:29:59,532 --> 00:30:00,750
وَفِيهِ الدَّلِيلُ الَّذِي سَيَأْتِي.

177
00:29:59,532 --> 00:30:00,750
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَقَوْلُهُ تَعَالَى: ﴿إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُمْ

178
00:29:59,532 --> 00:30:00,750
بِغَيْرِ حِسَابٍ﴾ قَالَ الشَّارِحُ هَدَاهُ اللَّهُ:

179
00:30:09,917 --> 00:30:11,346
فِي هَذِهِ الْآيَةِ بَيَانُ عِظَمِ جَزَاءِ الصَّائِمِينَ،

180
00:30:10,631 --> 00:30:11,346
فَإِنَّ الصَّابِرِينَ الْمَذْكُورِينَ

181
00:30:22,037 --> 00:30:24,015
فِي هَذِهِ الْآيَةِ هُمُ الصَّائِمُونَ

182
00:30:49,300 --> 00:30:50,800
فِي أَكْثَرِ الْأَقْوَالِ،

183
00:30:50,050 --> 00:30:50,800
اخْتِيَارُ جَمَاعَةٍ مِنْهُمْ [أَبُو مُحَمَّدٍ سُفْيَانُ بْنُ عُيَيْنَةَ الْهِلَالِيُّ]،

184
00:30:50,050 --> 00:30:50,800
وَكَذَا [أَبُو عُبَيْدٍ الْقَاسِمُ بْنُ سَلَّامٍ] صَاحِبُ [غَرِيبِ الْحَدِيثِ]،

185
00:30:50,050 --> 00:30:50,800
وَدَابَعَهُمَا [أَبُو الْفَضْلِ بْنُ حَجَرٍ]

186
00:31:18,430 --> 00:31:19,630
فِي [فَتْحِ الْبَارِي]؛ وَمُوجِبُ ذَلِكَ مَا كَانَ فِيهِ الصِّيَامُ مِنْ

187
00:31:19,030 --> 00:31:19,630
أَنْوَاعِ الصَّبْرِ الثَّلَاثِ: صَبْرٌ

188
00:31:35,801 --> 00:31:38,143
عَلَى الطَّاعَةِ،

189
00:31:36,972 --> 00:31:38,143
وَصَبْرٌ عَنِ الْمَعْصِيَةِ بِحِفْظِ النَّفْسِ عَنِ الْإِفْطَارِ،

190
00:31:36,972 --> 00:31:38,143
وَصَبْرٌ عَلَى الْبَلَاءِ بِمَا يُعَانِي الصَّائِمُ

191
00:31:59,633 --> 00:32:20,850
مِنَ الْجُهْدِ وَالْمَشَقَّةِ دَرَاءَ فَقْدِهِ لِطَعَامِهِ وَشَرَابِهِ،

192
00:32:20,850 --> 00:32:21,906
فَلَمَّا وُجِدَتْ

193
00:33:01,120 --> 00:33:02,620
هَذِهِ الْمَعَانِي

194
00:33:42,895 --> 00:33:44,395
فِي الصَّبْرِ وَوُجِدَ هَذَا الصَّبْرُ فِي

195
00:34:25,560 --> 00:34:26,060
الصِّيَامِ

196
00:34:29,931 --> 00:34:31,279
كَانَ الصِّيَامُ

197
00:34:33,975 --> 00:34:35,998
حَقِيقًا بِأَنْ يَدْخُلَ

198
00:34:52,596 --> 00:34:54,679
فِي هَذِهِ الْآيَةِ،

199
00:34:53,638 --> 00:34:54,679
فَيَكُونُ أَجْرُهُ بِغَيْرِ حِسَابٍ،

200
00:34:53,638 --> 00:34:54,679
فَلَا يَنْتَهِي أَجْرُ الصِّيَامِ إِلَى حَدٍّ

201
00:35:09,316 --> 00:35:10,989
هُوَ تَصْدِيقٌ لِلْمَذْكُورِ

202
00:35:14,335 --> 00:35:16,008
فِي الْآيَةِ الْمُتَقَدِّمَةِ

203
00:35:36,921 --> 00:35:38,594
مِنْ قَوْلِ

204
00:36:04,719 --> 00:36:06,912
اللَّهِ تَعَالَى: ﴿أَعَدَّ اللَّهُ لَهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا﴾،

205
00:36:05,815 --> 00:36:06,912
فَيَكُونُ

206
00:36:19,402 --> 00:36:21,767
هَذَا الْأَجْرُ الْعَظِيمُ غَيْرَ مُنْتَهٍ إِلَى حَدٍّ،

207
00:36:20,585 --> 00:36:21,767
فَيَأْتِي مَزِيدُ بَيَانٍ لِهَذَا

208
00:36:22,950 --> 00:36:25,315
فِي الْحَدِيثِ الْأَوَّلِ مِنْ

209
00:36:37,140 --> 00:36:39,505
هَذَا الْبَابِ،

210
00:36:38,322 --> 00:36:39,505
نَعَمْ. قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَقَوْلُهُ تَعَالَى: ﴿وَإِذَا سَأَلَكَ عِبَادِي

211
00:36:38,322 --> 00:36:39,505
عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ﴾ قَالَ الشَّارِحُ

212
00:36:38,322 --> 00:36:39,505
هَدَاهُ اللَّهُ: بِهَذِهِ الْآيَةِ بَيَانُ اسْتِجَابَةِ اللَّهِ لِدُعَاءِ الدَّاعِيِينَ،

213
00:36:38,322 --> 00:36:39,505
وَأَمَّا وَجْهُ تَعَلُّقِ ذَلِكَ بِالصِّيَامِ فَهُوَ لِنُكْتَةٍ لَطِيفَةٍ؛ إِذْ

214
00:37:17,887 --> 00:37:19,983
أَنَّ هَذِهِ الْآيَةَ لَمَّا ذُكِرَتْ ذُكِرَتْ تَابِعَةً لِآيَاتٍ

215
00:37:22,080 --> 00:37:48,340
فِي الصِّيَامِ،

216
00:37:48,340 --> 00:38:33,159
فَصَارَتْ وَاقِعَةً بَيْنَ آيَاتِ الصِّيَامِ،

217
00:38:33,159 --> 00:38:33,603
فَدَلَّ ذَلِكَ

218
00:38:37,159 --> 00:38:38,048
عَلَى شِدَّةِ تَعَلُّقِهَا بِالصِّيَامِ،

219
00:38:37,603 --> 00:38:38,048
فَيُسْتَفَادُ

220
00:38:51,211 --> 00:38:52,670
مِنْ ذَلِكَ كَوْنُ الصِّيَامِ مَحَلًّا لِإِجَابَةِ الدُّعَاءِ،

221
00:38:51,940 --> 00:38:52,670
قَدْ دَلَّتْ عَلَيْهِ السُّنَّةُ

222
00:39:12,340 --> 00:39:12,840
كَمَا

223
00:39:24,735 --> 00:39:26,261
فِي حَدِيثِ [أَبِي هُرَيْرَةَ] عِنْدَ [التِّرْمِذِيِّ] وَ[ابْنِ مَاجَهْ] بِإِسْنَادٍ حَسَنٍ

224
00:39:34,656 --> 00:39:36,182
أَنَّ النَّبِيَّ

225
00:40:03,508 --> 00:40:05,659
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: إِذَا أَتَتْ تِرْمِذِيَّةُ ابْنُ مَاجَهْ

226
00:40:05,121 --> 00:40:05,659
إِذَا أَتَتْ تِرْمِذِيَّةُ ابْنُ مَاجَهْ إِذَا أَتَتْ تِرْمِذِيَّةُ ابْنُ مَاجَهْ

