369
00:49:36,691 --> 00:49:37,434
لَا تَقْدِيمِ غَيْرِهِ فِيهَا؛ قَالَ الْمُصَنِّفُ حَفِظَهُ

370
00:49:40,407 --> 00:49:41,150
اللَّهُ: بَابٌ فِي مَشْرُوعِيَّةِ الْقُنُوتِ وَصِفَتِهِ؛ قَالَ الشَّارِحُ هَدَاهُ اللَّهُ:

371
00:49:40,778 --> 00:49:41,150
عَقَدَ الْمُصَنِّفُ بَابًا فِي بَيَانِ مَشْرُوعِيَّةِ الْقُنُوتِ وَصِفَتِهِ،

372
00:49:40,778 --> 00:49:41,150
وَالْمَقْصُودُ مِنْ مَشْرُوعِيَّةِ الْقُنُوتِ بَيَانُ اسْتِحْبَابِهِ وَجَوَازِهِ،

373
00:49:40,778 --> 00:49:41,150
فَمَتَى يُسْتَحَبُّ وَمَتَى لَا يُسْتَحَبُّ؟

374
00:49:40,778 --> 00:49:41,150
مَتَى يَجُوزُ وَمَتَى لَا يَجُوزُ؟

375
00:49:40,778 --> 00:49:41,150
فَفِيهِ بَيَانُ مَا يَتَعَلَّقُ بِهَذِهِ الْمَوَاضِعِ فِيمَا يَسْتَقْبِلُ هَذَا الْمَقْصِدَ

376
00:49:40,778 --> 00:49:41,150
الْأَوَّلَ، مَقْصِدَ التَّرْجَمَةِ،

377
00:49:40,778 --> 00:49:41,150
وَالْمَقْصِدُ الثَّانِي فِي قَوْلِهِ: "وَصِفَتِهِ" أَيْ الْحَالِ الَّتِي يَقَعُ بِهَا

378
00:49:40,778 --> 00:49:41,150
الْقُنُوتُ بِبَيَانِ أَقْوَالِهِ وَأَفْعَالِهِ وَتَفَاصِيلِ أَحْوَالِهِ بِحَيْثُ يُحْسِنُ الْعَبْدُ قُنُوتَهُ

379
00:49:40,778 --> 00:49:41,150
كَمَا كَانَ يَفْعَلُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَبَعْدَهُ أَصْحَابُهُ

380
00:49:40,778 --> 00:49:41,150
كَمَا سَيَأْتِي،

381
00:49:40,778 --> 00:49:41,150
نَعَمْ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَهُوَ دُعَاءٌ حَالَ الْقِيَامِ فِي

382
00:49:40,778 --> 00:49:41,150
الصَّلَاةِ، وَمَحَلُّهُ فِي الرَّكْعَةِ الْأَخِيرَةِ بَعْدَ الرَّفْعِ مِنَ الرُّكُوعِ اسْتِحْبَابًا

383
00:49:40,778 --> 00:49:41,150
وَيَجُوزُ قَبْلَهَا؛ قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ فِي هَذِهِ

384
00:49:40,778 --> 00:49:41,150
الْجُمْلَةِ بَيَانَ حَقِيقَةِ الْقُنُوتِ بِقَوْلِهِ: "وَدُعَاءٌ حَالَ الْقِيَامِ فِي الصَّلَاةِ"،

385
00:49:40,778 --> 00:49:41,150
وَالْقِيَامُ الْمُرَادُ فِي هَذَا الْمَحَلِّ أَحَدُ مَعْنَيَيْنِ: أَحَدُهُمَا: الْقِيَامُ الَّذِي

386
00:49:40,778 --> 00:49:41,150
هُوَ فِي ابْتِدَاءِ الرَّكْعَةِ الَّذِي تُقْرَأُ فِيهِ الْفَاتِحَةُ،

387
00:49:40,778 --> 00:49:41,150
وَالْآخَرُ: الْقِيَامُ الَّذِي يَكُونُ بَعْدَ الرُّكُوعِ وَهُوَ الِاعْتِدَالُ مِنَ الرُّكُوعِ،

388
00:49:40,778 --> 00:49:41,150
وَهَذَانِ الْمَعْنَيَانِ دَاخِلَانِ فِي الْقِيَامِ فِي هَذَا الْمَحَلِّ،

389
00:49:40,778 --> 00:49:41,150
فَيُقَالُ فِي الْقُنُوتِ إِنَّهُ دُعَاءٌ حَالَ الْقِيَامِ فِي الصَّلَاةِ بِاعْتِبَارِ

390
00:49:40,778 --> 00:49:41,150
كَوْنِهِ قَبْلَ الرُّكُوعِ،

391
00:49:40,778 --> 00:49:41,150
وَيُقَالُ فِيهِ دُعَاءٌ حَالَ الْقِيَامِ فِي الصَّلَاةِ بِاعْتِبَارِ كَوْنِهِ بَعْدَ

392
00:49:40,778 --> 00:49:41,150
الرُّكُوعِ، فَيَصْلُحُ لِهَذَا وَذَاكَ،

393
00:49:40,778 --> 00:49:41,150
وَنَعْلَمُ خَبَرَ الْمَشْرُوعِ مِنْهُمَا إِنْ شَاءَ اللَّهُ فِي الْجُمْلَةِ التَّالِيَةِ،

394
00:49:40,778 --> 00:49:41,150
وَهِيَ الَّتِي بَيَّنَ فِيهَا الْمُصَنِّفُ مَحَلَّ الْقُنُوتِ فَقَالَ: "مَحَلُّهُ فِي

395
00:49:40,778 --> 00:49:41,150
الرَّكْعَةِ الْأَخِيرَةِ" إِذْ كَانَ هُوَ الْمَعْهُودُ عَنِ النَّبِيِّ صَلَّى اللَّهُ

396
00:49:40,778 --> 00:49:41,150
عَلَيْهِ وَسَلَّمَ وَالصَّحَابَةِ،

397
00:49:40,778 --> 00:49:41,150
فَإِنَّهُمْ كَانُوا إِذَا قَنَتُوا أَيَّ قُنُوتٍ جَعَلُوهُ فِي الرَّكْعَةِ الْأَخِيرَةِ

398
00:49:40,778 --> 00:49:41,150
مِنْ صَلَاتِهِ،

399
00:49:40,778 --> 00:49:41,150
ثُمَّ بَيَّنَ مَحَلَّهُ فِي هَذِهِ الرَّكْعَةِ فَقَالَ: "بَعْدَ الرَّفْعِ مِنَ

400
00:49:40,778 --> 00:49:41,150
الرُّكُوعِ اسْتِحْبَابًا وَيَجُوزُ قَبْلَهُ"،

401
00:49:40,778 --> 00:49:41,150
فَلَهُمْ مَحَلَّانِ اثْنَانِ: أَحَدُهُمَا: بَعْدَ الرَّفْعِ مِنَ الرُّكُوعِ هُوَ الَّذِي

402
00:49:40,778 --> 00:49:41,150
يَكُونُ فِيهِ الْقِيَامُ بِمَعْنَى الِاعْتِدَالِ عَنِ الرُّكُوعِ فَيَكُونُ حَالًا حِينَئِذٍ

403
00:49:40,778 --> 00:49:41,150
مُسْتَحَبًّا لِفِعْلِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

404
00:49:40,778 --> 00:49:41,150
وَالْآخَرُ قَبْلَ الرُّكُوعِ كَمَا صَحَّ عَنْ جَمَاعَةٍ مِنْهُمْ،

405
00:49:40,778 --> 00:49:41,150
فَيَكُونُ ذَلِكَ جَائِزًا لِكَوْنِهِ مِنْ فِعْلِ الصَّحَابَةِ،

406
00:49:40,778 --> 00:49:41,150
وَالْمُقَدَّمُ فِعْلُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِكَوْنِهِ السُّنَّةَ،

407
00:49:40,778 --> 00:49:41,150
فَيَكُونُ الْمُسْتَحَبُّ جَعْلَهُ بَعْدَ الرُّكُوعِ،

408
00:49:40,778 --> 00:49:41,150
وَإِنْ جَعَلَهُ قَبْلَ الرُّكُوعِ فَلَا بَأْسَ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ:

409
00:49:40,778 --> 00:49:41,150
وَهُوَ نَوْعَانِ: الْأَوَّلُ قُنُوتُ النَّازِلَةِ،

410
00:49:40,778 --> 00:49:41,150
وَيُسْتَحَبُّ فِي الْمَكْتُوبَاتِ لِنَازِلَةٍ لَمْ تَسْتَقِرَّ كَكَثْرَةِ قَتْلٍ وَشِدَّةِ اسْتِضْعَافٍ

411
00:49:40,778 --> 00:49:41,150
وَنَحْوِهِمَا، فَإِنِ اسْتَقَرَّتْ أَوْ ارْتَفَعَتْ لَمْ يُشْرَعْ،

412
00:49:40,778 --> 00:49:41,150
وَصِفَتُهُ النِّيَّةُ بِالدُّعَاءِ فِي غَيْرِهِ،

413
00:49:40,778 --> 00:49:41,150
وَيَدْعُو الْإِمَامُ بِحَسَبِ مُقْتَضَى الْحَالِ دُونَ زِيَادَةٍ أَوْ تَطْوِيلٍ،

414
00:49:40,778 --> 00:49:41,150
وَيُؤَمِّنُ الْمَأْمُومُ عَلَى الدُّعَاءِ وَيَسْكُتُ فِي غَيْرِهِ،

415
00:49:40,778 --> 00:49:41,150
فَإِنْ ذَكَرَ اللَّهَ بِتَسْبِيحٍ وَنَحْوِهِ جَازَ،

416
00:49:40,778 --> 00:49:41,150
وَيُشْرَعُ فِي هَذَا الْمَحَلِّ وَغَيْرِهِ رَفْعُ الْيَدَيْنِ مَبْسُوطَتَيْنِ وَبُطُونُهُمَا إِلَى

417
00:49:40,778 --> 00:49:41,150
السَّمَاءِ، وَيَجْعَلُهُمَا حِيَالَ صَدْرِهِ وَيَضُمُّهُمَا بِلَا تَفْرِيجٍ وَلَا يَجْعَلُ إِحْدَاهُمَا

418
00:49:40,778 --> 00:49:41,150
فِي بَطْنِ الْأُخْرَى؛ قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: جَعَلَ الْمُصَنِّفُ الْقُنُوتَ

419
00:49:40,778 --> 00:49:41,150
بِاعْتِبَارِ سَبَبِهِ نَوْعَيْنِ،

420
00:49:40,778 --> 00:49:41,150
فَهَذِهِ الْقِسْمَةُ هِيَ بِاعْتِبَارِ سَبَبِ الْقُنُوتِ أَيِ الدَّاعِي الْمُوجِبِ لَهُ،

421
00:49:40,778 --> 00:49:41,150
ذَكَرَ الْمُصَنِّفُ النَّوْعَ الْأَوَّلَ مِنْ أَنْوَاعِ الْقُنُوتِ وَهُوَ قُنُوتُ النَّازِلَةِ،

422
00:49:40,778 --> 00:49:41,150
وَالنَّازِلَةُ هِيَ الْمُصِيبَةُ الَّتِي تَحُلُّ بِالْمُسْلِمِينَ فَيُقْنَتُ لَهَا،

423
00:49:40,778 --> 00:49:41,150
فَذَكَرَ فِي بَيَانِ أَحْكَامِهِ تِسْعَةَ أَحْكَامٍ: الْحُكْمُ الْأَوَّلُ: فِي قَوْلِهِ:

424
00:49:40,778 --> 00:49:41,150
"وَيُسْتَحَبُّ فِي الْمَكْتُوبَاتِ"،

425
00:49:40,778 --> 00:49:41,150
فَمَحَلُّهَا فِي الصَّلَوَاتِ الْمَكْتُوبَاتِ أَيِ الْفَرَائِضِ وَهِيَ الصَّلَوَاتُ الْخَمْسُ،

426
00:49:40,778 --> 00:49:41,150
وَيُسْتَثْنَى مِنْ ذَلِكَ الْجُمُعَةُ لِمَا سَيَأْتِي بَيَانُهُ فِي فَصْلٍ آخَرَ،

427
00:49:40,778 --> 00:49:41,150
وَيُسْتَثْنَى مِنْ ذَلِكَ الْجُمُعَةُ لِمَا سَيَأْتِي بَيَانُهُ فِي ذَلِكَ الْفَصْلِ

428
00:49:40,778 --> 00:49:41,150
الْآخَرِ، فَالْمُرَادُ بِالْمَكْتُوبَاتِ فِي هَذَا الْمَحَلِّ الصَّلَوَاتُ الْخَمْسُ لَا الْجُمُعَةُ،

429
00:49:40,778 --> 00:49:41,150
وَمِنَ الْغَلَطِ النَّاشِئِ عِنْدَ كَثِيرٍ مِنْ طَلَبَةِ الْعِلْمِ قِيَاسُ الْجُمُعَةِ

430
00:49:40,778 --> 00:49:41,150
عَلَى غَيْرِهَا مِنَ الصَّلَوَاتِ،

431
00:49:40,778 --> 00:49:41,150
هَذَا خِلَافُ الْمَعْهُودِ مِنَ الصَّحَابَةِ،

432
00:49:40,778 --> 00:49:41,150
الْأَنْبِيَاءُ بْنُ عُمَرَ رَحِمَهُ اللَّهُ رُبَّمَا نَقَلَ أَحْكَامًا لِلصَّلَوَاتِ الْخَمْسِ

433
00:49:40,778 --> 00:49:41,150
وَنَقَلَ أَحْكَامًا لِلْجُمُعَةِ مَعَ مُوَافَقَةٍ بَيْنَهُمَا فِي الْأَحْكَامِ،

434
00:49:40,778 --> 00:49:41,150
وَمَعَ ذَلِكَ لَمْ يَسْتَغْنِ بِنَقْلِ الْأَحْكَامِ الْمُتَعَلِّقَةِ بِالصَّلَوَاتِ الْخَمْسِ عَنِ

435
00:49:40,778 --> 00:49:41,150
الْأَحْكَامِ الْمُتَعَلِّقَةِ بِالْجُمُعَةِ،

436
00:49:40,778 --> 00:49:41,150
مِمَّا يَدُلُّكَ عَلَى أَنَّ الْجُمُعَةَ صَلَاةٌ لَهَا أَحْكَامٌ خَاصَّةٌ بِهَا

437
00:49:40,778 --> 00:49:41,150
فِي الْمَعْرُوفِ مِنْ فِعْلِ الصَّحَابَةِ وَنَقْلِهِ مِنَ الدِّينِ،

438
00:49:40,778 --> 00:49:41,150
فَكَذَا يَنْبَغِي أَنْ يَكُونَ بَيَانُ طَالِبِ الْعِلْمِ لِغَيْرِهِ وَبَيَانُهُ مِنَ

439
00:49:40,778 --> 00:49:41,150
الْعِلْمِ بَيَانُ الْعِلْمِ لَهُ عَلَى هَذَا الْوَجْهِ أَنَّهُ يَتَلَقَّى أَحْكَامَ

440
00:49:40,778 --> 00:49:41,150
الْجُمُعَةِ مُنْفَصِلَةً عَنْ غَيْرِهَا مِنَ الصَّلَوَاتِ،

441
00:49:40,778 --> 00:49:41,150
فَلَا يَحْصُلُ بَيْنَهُمَا قِيَاسٌ مَعَ الْفَارِقِ الشَّاسِعِ بَيْنَهُمَا فِي الْأَحْكَامِ،

442
00:49:40,778 --> 00:49:41,150
هَذَا غَلَطٌ،

443
00:49:40,778 --> 00:49:41,150
وَالْمَعْرُوفُ مِنْ مَذْهَبِ الْحَنَابِلَةِ رَحِمَهُ اللَّهُ تَعَالَى فَهُوَ مِنْ أَحْسَنِ

444
00:49:40,778 --> 00:49:41,150
الْمَذَاهِبِ فِي هَذِهِ الْمَسَائِلِ؛ وَالْحُكْمُ الثَّانِي: فِي قَوْلِهِ: "لِنَازِلَةٍ لَمْ

445
00:49:40,778 --> 00:49:41,150
تَسْتَقِرَّ كَكَثْرَةِ قَتْلٍ وَشِدَّةِ اسْتِضْعَافٍ وَنَحْوِهِمَا"،

446
00:49:40,778 --> 00:49:41,150
فَهِيَ بَيَانُ مُوجِبِ قُنُوتِ النَّازِلَةِ،

447
00:49:40,778 --> 00:49:41,150
وَمِنِ اسْمِهَا نَازِلَةٌ أَيْ نَازِلَةٌ بِالْمُسْلِمِينَ فَحَلَّتْ بِهِمْ كَمُصِيبَةٍ،

448
00:49:40,778 --> 00:49:41,150
وَذَكَرَ مِنْهَا أَفْرَادًا كَكَثْرَةِ الْقَتْلِ وَشِدَّةِ الِاسْتِضْعَافِ وَنَحْوِهِمَا،

449
00:49:40,778 --> 00:49:41,150
وَوَقَعَ كُلٌّ مِنْهُمَا فِيمَا صَحَّ مِنْ قُنُوتِ النَّبِيِّ صَلَّى اللَّهُ

450
00:49:40,778 --> 00:49:41,150
عَلَيْهِ وَسَلَّمَ،

451
00:49:40,778 --> 00:49:41,150
فَإِنَّهُ لَمَّا كَانَ كَمَا تَقَدَّمَ يَقْنُتُ شَهْرًا يَدْعُو عَلَى رِعْلٍ

452
00:49:40,778 --> 00:49:41,150
وَذَكْوَانَ، فَإِنَّهُ كَانَ يَدْعُو عَلَى قَبِيلَتَيْنِ قَتَلَتَا أَصْحَابَهُ الْقُرَّاءَ،

453
00:49:40,778 --> 00:49:41,150
أَنَّهُ أَرْسَلَ أَصْحَابًا لَهُ مِنَ الْقُرَّاءِ،

454
00:49:40,778 --> 00:49:41,150
وَالْقُرَّاءُ اسْمُهُ فِيمَا تَقَدَّمَ كَمَنْ أَصَابَ مِنَ الْقُرْآنِ حَظًّا مِنْهُ

455
00:49:40,778 --> 00:49:41,150
الْقِرَاءَةُ لَهُ أَيْ عِلْمًا وَالْفَهْمَ وَالْعَمَلَ بِهِ وَالْفَهْمَ وَالْعَمَلَ بِهِ،

456
00:49:40,778 --> 00:49:41,150
وَلَمْ يَكُنْ مَعْرُوفًا عَنِ السَّلَفِ أَنْ يُقَالَ هَذَا قَارِئٌ دُونَ

457
00:49:40,778 --> 00:49:41,150
أَنْ يَكُونَ فَاهِمًا لِلْقُرَّاءِ عَامِلًا بِهِ،

458
00:49:40,778 --> 00:49:41,150
بَلْ كَمَا هُوَ مَعْهُودٌ عِنْدَ الْمُتَأَخِّرِينَ،

459
00:49:40,778 --> 00:49:41,150
فَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَرْسَلَ جُمْلَةً مِنْ أَصْحَابِهِ الْقُرَّاءِ

460
00:49:40,778 --> 00:49:41,150
لِيُعَلِّمُوا هَؤُلَاءِ دِينَهُمْ،

461
00:49:40,778 --> 00:49:41,150
فَلَمَّا أَرْسَلَهُمْ هَؤُلَاءِ الْقُرَّاءَ قَتَلُوهُمْ،

462
00:49:40,778 --> 00:49:41,150
فَقَنَتَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ شَهْرًا يَدْعُو عَلَيْهِمْ،

463
00:49:40,778 --> 00:49:41,150
وَكَذَا قَنَتَ لَمَّا أُوذُوا فِي مَكَّةَ وَعُذِّبُوا عَذَابًا شَدِيدًا فَاسْتَنْصَرَ

464
00:49:40,778 --> 00:49:41,150
اللَّهَ عَزَّ وَجَلَّ بِالْقُنُوتِ،

465
00:49:40,778 --> 00:49:41,150
فَهَذَا هُوَ الْمُشَارُ إِلَيْهِ فِي كَلَامِ الْمُصَنِّفِ بِشِدَّةِ الِاسْتِضْعَافِ،

466
00:49:40,778 --> 00:49:41,150
فَكَذَا الْمَعْنَيَيْنِ حَصَلَ سَبَبًا لِلْقُنُوتِ فِي زَمَنِ النَّبِيِّ صَلَّى اللَّهُ

467
00:49:40,778 --> 00:49:41,150
عَلَيْهِ وَسَلَّمَ،

468
00:49:40,778 --> 00:49:41,150
وَكَذَا هُمَا يَدْخُلُ بِاسْمِ النَّازِلَةِ هُوَ الِاسْمُ الَّذِي وَضَعَهُ الْفُقَهَاءُ

469
00:49:40,778 --> 00:49:41,150
لِلدَّلَالَةِ عَلَى هَذِهِ النَّازِلَةِ؛ وَالْحُكْمُ الثَّالِثُ: فِي قَوْلِهِ: "فَإِنِ اسْتَقَرَّتْ

470
00:49:40,778 --> 00:49:41,150
أَوْ ارْتَفَعَتْ لَمْ يُشْرَعْ"،

471
00:49:40,778 --> 00:49:41,150
فِي هَذِهِ الْجُمْلَةِ أَنْ يُقَالَ إِنَّ سَبَبَ مَشْرُوعِيَّةِ الْقُنُوتِ كَانَ

472
00:49:40,778 --> 00:49:41,150
وُجُودَ النَّازِلَةِ،

473
00:49:40,778 --> 00:49:41,150
وَسَبَبُ مَشْرُوعِيَّتِهِ أَمْرَانِ: أَحَدُهُمَا: أَنْ تُرْفَعَ النَّازِلَةُ لِأَنْ يَنْصُرَ اللَّهُ

474
00:49:40,778 --> 00:49:41,150
اللَّهَ، فَحَالٌ إِذًا لَا سَبَبَ لِلْقُنُوتِ أَيْ تَعْتَادُ كَمَا حَصَلَ

475
00:49:40,778 --> 00:49:41,150
بِالنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

476
00:49:40,778 --> 00:49:41,150
فَإِنَّهُ لَمَّا قَنَتَ شَهْرًا قَنَتَ ثُمَّ تَرَكَ الْقُنُوتَ مَعَ كَوْنِ

477
00:49:40,778 --> 00:49:41,150
أَسْبَابِ الْقُنُوتِ كَانَتْ لَا زَالَتْ قَائِمَةً،

478
00:49:40,778 --> 00:49:41,150
لَكِنْ يَنْبَغِي أَنْ يُعْلَمَ أَنَّ الْقُنُوتَ حَالَةُ اسْتِثْنَاءٍ فَلَيْسَتْ فِيهَا

479
00:49:40,778 --> 00:49:41,150
الْأَصْلُ، فَلَا تَقَعُ إِلَّا اسْتِثْنَاءً،

480
00:49:40,778 --> 00:49:41,150
تَبُتُّ بِالْمُسْلِمِينَ نَازِلَةٌ قَنَتُوا لَهَا ثُمَّ بَقِيَتْ هَذِهِ النَّازِلَةُ مُدَّةً

481
00:49:40,778 --> 00:49:41,150
لَمْ تَرْتَفِعْ اعْتَادُوا عَلَيْهَا فَضَعُفَ الْأَلَمُ بِهَا،

482
00:49:40,778 --> 00:49:41,150
فَصَارَ الْمَشْرُوعُ حِينَئِذٍ أَنْ نَعُودَ إِلَى الْأَصْلِ بِأَنْ يُتْرَكَ الْقُنُوتُ،

483
00:49:40,778 --> 00:49:41,150
فَإِنَّ الْحَالَةَ الِاسْتِثْنَائِيَّةَ الَّتِي حَصَلَ فِيهَا لَمْ تَعُدْ مَوْجُودَةً فِي

484
00:49:40,778 --> 00:49:41,150
قُلُوبِنَا وَلَمْ يَعُدِ الْأَلَمُ.

485
00:49:40,778 --> 00:49:41,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: كَمَا كَانَ فِي ابْتِدَائِهِ بَلْ خَفَّ،

486
00:49:40,778 --> 00:49:41,150
فَيَكُونُ الْأَمْرُ حِيَالَهُ أَيْ أَيْ إِذَنْ أَنَّهُ لَا يُشْرَعُ الْقُنُوتُ،

487
00:49:40,778 --> 00:49:41,150
فَمِنَ الْغَلَطِ أَنْ يَقْنُتَ قَانِتٌ الْآنَ عَلَى مَا حَصَلَ فِي

488
00:49:40,778 --> 00:49:41,150
غَزَّةَ، هَذَا غَلَطٌ،

489
00:49:40,778 --> 00:49:41,150
هَذَا لَا يُشْرَعُ لَهُ الْقُنُوتُ بِاعْتِبَارِ أَنَّهُ مَضَى مُسْتَقِرٌّ،

490
00:49:40,778 --> 00:49:41,150
قَانِتٌ لِإِرَادَتِهِ أَنْ يَجْمَعَ الْمُسْلِمِينَ وَيُؤَمِّنُوا عَلَى دُعَائِهِ فَهَذَا أَيْضًا

491
00:49:40,778 --> 00:49:41,150
غَلَطٌ؛ فَإِنَّ الْقُنُوتَ لَا يُشْرَعُ لِهَذَا الْمَعْنَى،

492
00:49:40,778 --> 00:49:41,150
إِنَّمَا يُشْرَعُ لِنَازِلَةٍ حَصَلَتْ،

493
00:49:40,778 --> 00:49:41,150
وَإِنَّمَا الْمَحَلُّ الْآنَ فِي الْمَكْتَبَاتِ أَنَّهُ يُشْرَعُ،

494
00:49:40,778 --> 00:49:41,150
قَالَهُ كَمَا أَشَارَتِ الْمَكْتَبَاتُ أَنَّهُ يُشْرَعُ لِنَازِلَةٍ حَصَلَتْ لَا لِمُجَرَّدِ

495
00:49:40,778 --> 00:49:41,150
جَمْعِ الْمُسْلِمِينَ بِالدُّعَاءِ فَهَذَا لَا يُشْرَعُ،

496
00:49:40,778 --> 00:49:41,150
وَإِنَّمَا جَمْعُهُمْ بِالدُّعَاءِ يُحَصِّلُهُ فِي الْجُمُعَةِ،

497
00:49:40,778 --> 00:49:41,150
وَيَسْتَغْنِي بِالدُّعَاءِ فِي غَيْرِهِ أَيْ فِي غَيْرِهِ مِنَ الْمَحَالِّ الْمُجَعَّلَةِ

498
00:49:40,778 --> 00:49:41,150
فِي الصَّلَاةِ لِالدُّعَاءِ كَالسُّجُودِ وَمَا بَعْدَ التَّشَهُّدِ قَبْلَ السَّلَامِ،

499
00:49:40,778 --> 00:49:41,150
وَمِنْ مَحَالِّ الدُّعَاءِ الْمُطْلَبِ أَنْ يَدْعُوَ فِي جُلُوسِهِ بَيْنَ السَّجْدَتَيْنِ،

500
00:49:40,778 --> 00:49:41,150
وَغَيْرِ ذَلِكَ مِنَ الْمَحَالِّ،

501
00:49:40,778 --> 00:49:41,150
نَحْنُ لَنْ نَقُولَ كُفَّ عَنِ الدُّعَاءِ،

502
00:49:40,778 --> 00:49:41,150
فَإِنَّ الدُّعَاءَ سِلَاحُ الْمُؤْمِنِ،

503
00:49:40,778 --> 00:49:41,150
وَإِنَّمَا الَّذِي يُقَالُ أَنْ لَا تَجْعَلَ الدُّعَاءَ إِلَّا كَيْفَمَا رَتَّبَتْهُ

504
00:49:40,778 --> 00:49:41,150
الشَّرِيعَةُ، فَالشَّرِيعَةُ جَعَلَتِ الْقُنُوتَ لِحَالٍ،

505
00:49:40,778 --> 00:49:41,150
وَهَذِهِ الْحَالَةُ تَغَيَّرَتْ،

506
00:49:40,778 --> 00:49:41,150
فَلَمْ يُشْرَعِ الْقُنُوتُ،

507
00:49:40,778 --> 00:49:41,150
لَكِنْ لَازَالَ الدُّعَاءُ مَشْرُوعًا فِي مَحَالِّهِ الْمُعْتَادَةِ وَيَنْبَغِي لِلْعَبْدِ أَنْ

508
00:49:40,778 --> 00:49:41,150
يَحْرِصَ عَلَى هَذِهِ الْمَحَالِّ،

509
00:49:40,778 --> 00:49:41,150
وَهَذَا مِنَ الْحِكْمَةِ الَّتِي يُتْرَكُ لِأَجْلِهَا الْقُنُوتُ؛ لِأَنَّ الْقُنُوتَ إِذَا

510
00:49:40,778 --> 00:49:41,150
شَاعَ فِي الْخَلْقِ مُدَّةً طَوِيلَةً،

511
00:49:40,778 --> 00:49:41,150
رُبَّمَا حَمَلَهُمْ ذَلِكَ عَلَى تَرْكِ الدُّعَاءِ فِي غَيْرِهِ مِنَ الْمَحَالِّ،

512
00:49:40,778 --> 00:49:41,150
وَهَذَا مَعْهُودٌ مَشْهُورٌ مِنَ النَّاسِ،

513
00:49:40,778 --> 00:49:41,150
فَتَجِدُ هُوَ يَدْعُو دُعَاءً كَثِيرًا حَالَ قُنُوتِهِ،

514
00:49:40,778 --> 00:49:41,150
ثُمَّ إِذَا سَجَدَ لَمْ يَدْعُ إِلَّا بِالْيَسِيرِ،

515
00:49:40,778 --> 00:49:41,150
مَعَ مَعْرِفَتِهِ بِحَدِيثِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: [أَقْرَبُ مَا

516
00:49:40,778 --> 00:49:41,150
يَكُونُ الْعَبْدُ مِنْ رَبِّهِ وَهُوَ سَاجِدٌ]،

517
00:49:40,778 --> 00:49:41,150
فَأَكْثِرُوا الدُّعَاءَ بِالسُّجُودِ،

518
00:49:40,778 --> 00:49:41,150
وَلَا يَدْعُو،

519
00:49:40,778 --> 00:49:41,150
يَعْرِفُ مِنْ حَالِ نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ كَانَ

520
00:49:40,778 --> 00:49:41,150
يُكْثِرُ مِنَ الدُّعَاءِ دُبُرَ الصَّلَاةِ،

521
00:49:40,778 --> 00:49:41,150
أَيْ بَعْدَ التَّشَهُّدِ قَبْلَ السَّلَامِ،

522
00:49:40,778 --> 00:49:41,150
أَنَّ دُبُرَهُ فِي هَذَا،

523
00:49:40,778 --> 00:49:41,150
دُبُرَ الصَّلَاةِ فِي هَذَا الْمَحَلِّ مُرَادٌ بِهِ آخِرُهَا لَا بَعْدَهُ،

524
00:49:40,778 --> 00:49:41,150
عَلَى مَا ذَهَبَ إِلَيْهِ [ابْنُ تَيْمِيَّةَ] رَحِمَهُ اللَّهُ،

525
00:49:40,778 --> 00:49:41,150
فَالْمَقْصُودُ أَنَّهُ يَعْرِفُ هَذَا،

526
00:49:40,778 --> 00:49:41,150
ثُمَّ تَجِدُهُ إِذَا بَلَغَ التَّشَهُّدَ أَنْهَاهُ،

527
00:49:40,778 --> 00:49:41,150
ثُمَّ صَلَّى عَلَى نَبِيِّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ثُمَّ تَعَوَّذَ

528
00:49:40,778 --> 00:49:41,150
بِهَذِهِ التَّعَوُّذَاتِ الْأَرْبَعِ ثُمَّ سَلَّمَ فَلَا يَدْعُو بِشَيْءٍ،

529
00:49:40,778 --> 00:49:41,150
هَذِهِ حَالُ سُوءٍ،

530
00:49:40,778 --> 00:49:41,150
وَلِهَذَا يَنْبَغِي لِمَنْ عَقَلَ هَذِهِ الْأَحْوَالَ أَنْ يَفْهَمَ أَنَّ قُنُوتَ

531
00:49:40,778 --> 00:49:41,150
الْخَلْقِ مُدَّةً يُضْعِفُ حَالَهُمْ فِي الْمَقَامَاتِ الْأُخْرَى الَّتِي يُسْتَحَبُّ فِيهَا

532
00:49:40,778 --> 00:49:41,150
الدُّعَاءُ، مَعَ كَوْنِهَا أَعْظَمَ عِنْدَ اللَّهِ مِنَ الدُّعَاءِ فِي الْقُنُوتِ،

533
00:49:40,778 --> 00:49:41,150
هَذَا مِمَّا يَنْبَغِي التَّنَبُّهُ لَهُ.

534
00:49:40,778 --> 00:49:41,150
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَالْحُكْمُ الْخَامِسُ: يُقَالُ: وَدُعَاءُ الْإِمَامِ بِحَسَبِ

535
00:49:40,778 --> 00:49:41,150
مُقْتَضَى الْحَالِ،

536
00:49:40,778 --> 00:49:41,150
دُونَ زِيَادَةٍ أَوْ تَطْوِيلٍ.

537
00:49:40,778 --> 00:49:41,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: فَإِنَّ الْقُنُوتَ إِنَّمَا شُرِعَ لِنَازِلَةٍ،

538
00:49:40,778 --> 00:49:41,150
فَيَكُونُ الدُّعَاءُ مُتَعَلِّقًا بِهَذِهِ النَّازِلَةِ،

539
00:49:40,778 --> 00:49:41,150
وَمِنَ الْغَلَطِ الْوَاقِعِ فِيهِ أَمْرَانِ: أَحَدُهُمَا: الزِّيَادَةُ،

540
00:49:40,778 --> 00:49:41,150
أَيِ الزِّيَادَةُ عَلَى مَا يَتَعَلَّقُ بِهَذِهِ النَّازِلَةِ،

541
00:49:40,778 --> 00:49:41,150
كَدُعَاءٍ لِلطَّلَبَةِ فِي امْتِحَانَاتِهِمْ،

542
00:49:40,778 --> 00:49:41,150
وَدُعَاءٍ لِلْمَرْضَى فِي أَمْرَاضِهِمْ وَغَيْرِ ذَلِكَ،

543
00:49:40,778 --> 00:49:41,150
هَذَا لَا يُشْرَعُ،

544
00:49:40,778 --> 00:49:41,150
الْقُنُوتُ لَمْ يُدْعَ لِهَذَا وَإِنَّمَا جَعَلَهُ لِلنَّازِلَةِ،

545
00:49:40,778 --> 00:49:41,150
نَعَمْ نَقُولُ ادْعُ دُعَاءً عَامًّا لِلْمُؤْمِنِينَ،

546
00:49:40,778 --> 00:49:41,150
هَذَا لَا بَأْسَ بِهِ،

547
00:49:40,778 --> 00:49:41,150
أَمَّا أَنْ يَكُونَ هَذَا أَصْلَ قُنُوتِكَ وَأَكْثَرَهُمْ فَلَا،

548
00:49:40,778 --> 00:49:41,150
وَإِنَّمَا يَدْعُو دُعَاءً دُعَاءَيْنِ أَوْ شَيْئًا مِنْ ذَلِكَ فِي ابْتِدَاءِ

549
00:49:40,778 --> 00:49:41,150
قُنُوتِهِ لِعُمُومِ الْمُسْلِمِينَ،

550
00:49:40,778 --> 00:49:41,150
ثُمَّ إِذَا دَعَا بِمَا دَعَا بِهِ انْتَقَلَ إِلَى الدُّعَاءِ لِحَالِ

551
00:49:40,778 --> 00:49:41,150
النَّازِلَةِ، فَرَكَّزَ دُعَاءَهُ فِيهِ،

552
00:49:40,778 --> 00:49:41,150
يَكُونُ أَكْثَرُ دُعَائِهِ دُعَاءً لِلْمُؤْمِنِينَ وَدُعَاءً لِأَفْرَادٍ مِنْهُمْ وَنَحْوِ ذَلِكَ،

553
00:49:40,778 --> 00:49:41,150
ثُمَّ فِي آخِرِ دُعَائِهِ رُبَّمَا أَلْقَى دُعَاءً أَوْ دُعَاءَيْنِ فِيمَا

554
00:49:40,778 --> 00:49:41,150
يَتَعَلَّقُ بِالنَّازِلَةِ،

555
00:49:40,778 --> 00:49:41,150
هَذَا لَا يُشْرَعُ،

556
00:49:40,778 --> 00:49:41,150
هَذَا مِنْ غَلَطِ وَعَدِّ الْأَئِمَّةِ هَدَاهُمُ اللَّهُ.

557
00:49:40,778 --> 00:49:41,150
وَكَذَا مِنَ الْغَلَطِ: التَّطْوِيلُ،

558
00:49:40,778 --> 00:49:41,150
فَإِنَّ الْقُنُوتَ كَمَا تَقَدَّمَ وَاقِعٌ فِي الرَّكْعَةِ الْأَخِيرَةِ مِنَ الصَّلَاةِ،

559
00:49:40,778 --> 00:49:41,150
وَقَاعِدَةُ الصَّلَاةِ أَنَّهَا قَصُرَتْ كُلَّمَا تَقَدَّمَتْ قَصُرَتْ،

560
00:49:40,778 --> 00:49:41,150
هَذِهِ قَاعِدَةُ الصَّلَاةِ،

561
00:49:40,778 --> 00:49:41,150
هَذِهِ وَاحِدَةٌ،

562
00:49:40,778 --> 00:49:41,150
وَالْأُخْرَى أَنَّ جَمِيعَ مَا وَرَدَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ

563
00:49:40,778 --> 00:49:41,150
وَسَلَّمَ وَغَيْرِهِ فِي دُعَاءِ الْقُنُوتِ إِنَّمَا هُوَ دُعَاءٌ قَصِيرٌ لَا

564
00:49:40,778 --> 00:49:41,150
يُعْرَفُ عَنِ السَّلَفِ تَطْوِيلُهُ فِي دُعَاءِ الْقُنُوتِ،

565
00:49:40,778 --> 00:49:41,150
فَيَكُونُ مَنْ طَوَّلَ فِي دُعَاءِ الْقُنُوتِ قَدْ خَالَفَ السَّلَفَ،

566
00:49:40,778 --> 00:49:41,150
وَالْأَمْرُ الثَّالِثُ أَنَّهُ يُعَوِّدُ النَّاسَ عَلَى تَرْكِ الدُّعَاءِ فِي غَيْرِهِ

567
00:49:40,778 --> 00:49:41,150
مِنَ الْمَحَالِّ كَمَا تَقَدَّمَ،

568
00:49:40,778 --> 00:49:41,150
فَإِذَا ظَنُّوا أَنَّهُمْ دَعَوْا دُعَاءً كَثِيرًا فِي الْقُنُوتِ،

569
00:49:40,778 --> 00:49:41,150
ظَنُّوا أَنَّهُ يَعُودُ الدُّعَاءُ فِي مَحَالَّ أُخَرَ،

570
00:49:40,778 --> 00:49:41,150
مَعَ كَوْنِهِ آكَلَ مِنْهُ،

571
00:49:40,778 --> 00:49:41,150
وَفِيهِ أَيْضًا أَنَّ التَّطْوِيلَ فِي دُعَاءِ الْقُنُوتِ رُبَّمَا أَثْقَلَ عَلَى

572
00:49:40,778 --> 00:49:41,150
الْمَأْمُومِينَ الدُّعَاءَ بِمَا يَجْعَلُهُمْ غَيْرَ آبِهِينَ لِاسْتِجَابَتِهِ،

573
00:49:40,778 --> 00:49:41,150
وَهَذَا غَلَطٌ بَلْ لَا يَحْصُلُ لِلْعَبْدِ الِاسْتِجَابَةُ إِلَّا مَعَ كَوْنِهِ

574
00:49:40,778 --> 00:49:41,150
مُعَلَّقًا بِهَذِهِ الِاسْتِجَابَةِ،

575
00:49:40,778 --> 00:49:41,150
مَعَ كَوْنِهِ حَرِيصًا عَلَيْهَا حَتَّى وَكَأَنَّهُ يَدْعُو دُعَاءَ مُضْطَرٍّ،

576
00:49:40,778 --> 00:49:41,150
وَمِنَ الْغَلَطِ أَيْضًا الَّذِي يَتَرَتَّبُ عَلَى التَّطْوِيلِ فِي الْقُنُوتِ أَنَّهُ

577
00:49:40,778 --> 00:49:41,150
يَجْعَلُ هَذَا الْمَحَلَّ مِنَ الصَّلَاةِ رُبَّمَا مَا بَلَغَ أَنَّهُ أَطْوَلُ

578
00:49:40,778 --> 00:49:41,150
مِنْ صَلَاتِهِ كُلِّهِ،

579
00:49:40,778 --> 00:49:41,150
فَيُصَلِّي خَمْسَةَ دَقَائِقَ وَيَقْنُتُ ثَمَانِيَةَ دَقَائِقَ،

580
00:49:40,778 --> 00:49:41,150
وَهَذَا غَلَطٌ،

581
00:49:40,778 --> 00:49:41,150
فَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمْ يَكُنْ لَا فِي صَلَاتِهِ

582
00:49:40,778 --> 00:49:41,150
وَلَمْ يَكُنْ فِي صَلَاتِهِ كُلِّهِ،

583
00:49:40,778 --> 00:49:41,150
وَإِنَّمَا كَانَ يُرَاعِي أَنْ يَكُونَ الْقُنُوتُ جُزْءًا مِنَ الصَّلَاةِ،

584
00:49:40,778 --> 00:49:41,150
وَمِنَ الْغَلَطِ الْوَاقِعِ أَيْضًا فِي تَطْوِيلِ الْقُنُوتِ أَنَّهُ لَا يَجْعَلُهُ

585
00:49:40,778 --> 00:49:41,150
كَالْقِيَامِ، وَقَدْ تَقَدَّمَ الْقَوْلُ بِأَنَّ أَفْضَلَ الصَّلَاةِ طُولُ الْقِيَامِ،

586
00:49:40,778 --> 00:49:41,150
هَذَا جَعَلَ صَلَاتَهُ أَطْوَلَ مَا فِيهَا الْقُنُوتُ لَا الْقِيَامُ،

587
00:49:40,778 --> 00:49:41,150
فَخَالَفَ بِذَلِكَ سُنَّةَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

588
00:49:40,778 --> 00:49:41,150
وَإِنَّمَا مَا ذَكَرْنَا هُوَ الْمَعْرُوفُ عَنِ السَّلَفِ،

589
00:49:40,778 --> 00:49:41,150
فَلَا يَنْبَغِي لِلْعَبْدِ أَنْ يَزِيدَ أَوْ يُطَوِّلَ فِي الْقُنُوتِ،

590
00:49:40,778 --> 00:49:41,150
وَمِمَّا يُخْشَى عَلَى الْعَبْدِ حَالِئِذٍ أَنَّهُ إِذَا طَوَّلَ فِي الْقُنُوتِ

591
00:49:40,778 --> 00:49:41,150
أَسَاءَ، أَيْ أَسَاءَ فِي الدُّعَاءِ،

592
00:49:40,778 --> 00:49:41,150
فَإِنَّ كَثِيرًا مِنَ الْأَدْعِيَةِ الْمُنْتَشِرَةِ فِي الْخَلْقِ فِيهَا مِنَ الْغَلَطِ

593
00:49:40,778 --> 00:49:41,150
مَا فِيهَا كَقَوْلِ أَحَدِهِمْ: [اللَّهُمَّ اقْذِفِ الْأَمْرَ]،

594
00:49:40,778 --> 00:49:41,150
طَيِّبْ هَلِ الْإِيمَانُ قَذِيفَةٌ؟

595
00:49:40,778 --> 00:49:41,150
الْإِيمَانُ شَيْءٌ لَطِيفٌ،

596
00:49:40,778 --> 00:49:41,150
وَمِنْهُ قَوْلُ اللَّهِ تَعَالَى: ﴿وَحَبَّبَ إِلَيْكُمُ الْإِيمَانَ﴾،

597
00:49:40,778 --> 00:49:41,150
فَفِيهِ الدُّعَاءُ بِتَحْبِيبِ الْإِيمَانِ إِلَيْنَا وَتَزْيِينِهِ فِي قُلُوبِنَا كَمَا صَرَّحَ

598
00:49:40,778 --> 00:49:41,150
ذَلِكَ فِي الْآيَاتِ،

599
00:49:40,778 --> 00:49:41,150
وَالْحَدِيثُ فِيهِ مَعْنًى لَطِيفٌ لَا يُنَاسِبُهُ الْقَذْفُ،

600
00:49:40,778 --> 00:49:41,150
وَكَذَا تَجِدُ بَعْضَهُمْ رُبَّمَا فِي الثَّنَاءِ أَخْطَأَ فَقَالَ: [يَا مَنْ

601
00:49:40,778 --> 00:49:41,150
لَا يَصِفُهُ الْوَاصِفُونَ]،

602
00:49:40,778 --> 00:49:41,150
طَيِّبْ وَالْأَسْمَاءُ الْحُسْنَى؟

603
00:49:40,778 --> 00:49:41,150
أَيْنَ الْأَسْمَاءُ الْحُسْنَى؟

604
00:49:40,778 --> 00:49:41,150
أَيْنَ الصِّفَاتُ الْإِلَهِيَّةُ؟

605
00:49:40,778 --> 00:49:41,150
هَذَا غَلَطٌ،

606
00:49:40,778 --> 00:49:41,150
أَوْ [يَا مَنْ لَا تَرَاهُ الْعُيُونُ]،

607
00:49:40,778 --> 00:49:41,150
هَذَا وَإِنْ كَانَ صَحِيحًا أَنْ لَا نَرَى اللَّهَ عَزَّ وَجَلَّ،

608
00:49:40,778 --> 00:49:41,150
لَكِنْ عَقِيدَةُ أَهْلِ السُّنَّةِ وَالْجَمَاعَةِ أَنْ نَرَاهُ يَوْمَ الْقِيَامَةِ،

609
00:49:40,778 --> 00:49:41,150
فَهَذَا يَعْنِي فِيهِ صَحِيحٌ وَخَاطِئٌ،

610
00:49:40,778 --> 00:49:41,150
حَقٌّ وَبَاطِلٌ،

611
00:49:40,778 --> 00:49:41,150
هَذَا لَيْسَ حَسَنًا فِي مَقَامِ الثَّنَاءِ عَنِ اللَّهِ عَزَّ وَجَلَّ،

612
00:49:40,778 --> 00:49:41,150
وَإِنَّمَا يُثْنَى عَلَيْهِ بِمَا لَا يَحْتَمِلُ بَاطِلًا إِلَى آخِرِ مَا

613
00:49:40,778 --> 00:49:41,150
يَغْلَطُ بِهِ الْأَئِمَّةُ،

614
00:49:40,778 --> 00:49:41,150
[اللَّهُمَّ لَا تَبْخَلْ عَلَيْنَا بِالْجَنَّةِ]،

615
00:49:40,778 --> 00:49:41,150
لَا إِلَهَ إِلَّا اللَّهُ،

616
00:49:40,778 --> 00:49:41,150
أَوْ تَرَى أَنَّ اللَّهَ إِذَا لَمْ يُعْطِكَ الْجَنَّةَ قَدْ بَخِلَ

617
00:49:40,778 --> 00:49:41,150
عَلَيْكَ؟ إِذَا لَمْ يُعْطِكَ الْجَنَّةَ كَانَ ذَلِكَ مِنْهُ عَدْلَهُ،

618
00:49:40,778 --> 00:49:41,150
وَإِذَا أَعْطَاكَ الْجَنَّةَ كَانَ ذَلِكَ مِنْهُ فَضْلَهُ،

619
00:49:40,778 --> 00:49:41,150
فَفِعْلُ اللَّهِ دَائِرٌ بَيْنَ الْعَدْلِ وَالْفَضْلِ،

620
00:49:40,778 --> 00:49:41,150
هَذَا غَلَطٌ مِنْ كَثِيرٍ مِنَ الْأَئِمَّةِ أَنَّهُمْ يُعَرِّضُونَ نَفْسَهُمْ بِهَذَا

621
00:49:40,778 --> 00:49:41,150
التَّطْوِيلِ لِلْغَلَطِ فِي الدُّعَاءِ فِي ارْتِكَابِ جُمْلَةٍ مِنَ الْمَكْرُوهَاتِ،

622
00:49:40,778 --> 00:49:41,150
كَمَنْ يَقُولُ: [اللَّهُمَّ ارْزُقْنَا الْجَنَّةَ وَطَعَامَهَا وَشَرَابَهَا وَثِمَارَهَا وَأَنْهَارَهَا وَعَسَلَهَا

623
00:49:40,778 --> 00:49:41,150
وَلَبَنَهَا]، ثُمَّ يُعَدِّدُ كُلَّ مَا يَعْرِفُهُ فِي الْجَنَّةِ،

624
00:49:40,778 --> 00:49:41,150
أَحَدُ السَّلَفِ سَمِعَ ابْنَهُ يَدْعُو بِتِلْكَ قَالَ: [يَا بُنَيَّ قُلِ

625
00:49:40,778 --> 00:49:41,150
اللَّهُمَّ ارْزُقْنَا الْجَنَّةَ،

626
00:49:40,778 --> 00:49:41,150
إِذَا رَزَقَكَ الْجَنَّةَ رَزَقَكَ جَمِيعَ مَا فِيهَا]،

627
00:49:40,778 --> 00:49:41,150
هَذَا مِنَ التَّطْوِيلِ الْمُخَالِفِ لِسُنَنِ الدُّعَاءِ،

628
00:49:40,778 --> 00:49:41,150
فَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَمَا صَحَّ عِنْدَ بَعْضِ أَصْحَابِ

629
00:49:40,778 --> 00:49:41,150
السُّنَنِ عَنْ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا أَنَّهَا قَالَتْ: [إِنَّ النَّبِيَّ

630
00:49:40,778 --> 00:49:41,150
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يُحِبُّ الْجَوَامِعَ مِنَ الدُّعَاءِ]،

631
00:49:40,778 --> 00:49:41,150
أَيْ أَلْفَاظُهُ قَلِيلَةٌ مَعَانِيهِ كَثِيرَةٌ،

632
00:49:40,778 --> 00:49:41,150
لَا بِتَطْوِيلِ الْأَلْفَاظِ،

633
00:49:40,778 --> 00:49:41,150
فَهَذَا ضِدُّ الْبَلَاغَةِ،

634
00:49:40,778 --> 00:49:41,150
وَالْعَبْدُ يَتَخَيَّرُ مِنَ الدُّعَاء مَا كَانَ أَبْلَغَهُ،

635
00:49:40,778 --> 00:49:41,150
فَإِنَّهُ أَحْسَنُ عِنْدَ اللَّهِ عَزَّ وَجَلَّ،

636
00:49:40,778 --> 00:49:41,150
وَلِهَذَا فَالْجَادَّةُ السَّالِمَةُ فِي هَذَا الْمَحَلِّ أَنْ يَدْعُوَ الْعَبْدُ بِمَا

637
00:49:40,778 --> 00:49:41,150
وَرَدَ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ دُونَ غَيْرِهِ،

638
00:49:40,778 --> 00:49:41,150
فَإِنَّهُ إِذَا فَعَلَ ذَلِكَ: - أَوَّلًا: أَصَابَ السُّنَّةَ.

639
00:49:40,778 --> 00:49:41,150
- ثَانِيًا: بَلَغَ الْغَايَةَ الْجَامِعَةَ الَّتِي فِيهَا مَعَانٍ عَظِيمَةٌ وَهِيَ

640
00:49:40,778 --> 00:49:41,150
دِعَايَةُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.

641
00:49:40,778 --> 00:49:41,150
- ثَالِثًا: أَصَابَ مَا يُحِبُّهُ اللَّهُ عَزَّ وَجَلَّ وَهُوَ دُعَاءُ

642
00:49:40,778 --> 00:49:41,150
نَبِيِّهِ، فَإِنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَحَبُّ الْخَلْقِ إِلَى

643
00:49:40,778 --> 00:49:41,150
اللَّهِ وَدُعَاؤُهُ يَكُونُ أَحَبَّ الدُّعَاءِ إِلَى اللَّهِ بِهَذَا الْمَعْنَى.

644
00:49:40,778 --> 00:49:41,150
- وَرَابِعًا: أَنَّهُ أَبْعَدَ نَفْسَهُ عَمَّا قَدْ يَحْصُلُ لَهُ مِنَ

645
00:49:40,778 --> 00:49:41,150
الْخَطَأِ فِي الدُّعَاءِ،

646
00:49:40,778 --> 00:49:41,150
فَصَارَ دُعَاؤُهُ آمِنًا لِأَجْدَادِهِ،

647
00:49:40,778 --> 00:49:41,150
هَذَا الَّذِي يَنْبَغِي،

648
00:49:40,778 --> 00:49:41,150
ثُمَّ يَنْظُرُ إِنْ وَجَدَ شَيْئًا أَحَبَّهُ مِنْ دُعَاءِ عَالِمٍ مِنَ

649
00:49:40,778 --> 00:49:41,150
الْعُلَمَاءِ يَأْخُذُ بِهِ،

650
00:49:40,778 --> 00:49:41,150
أَمَّا أَنْ يَدْعُوَ كَيْفَمَا اتَّفَقَ فَهَذَا يُعَرِّضُهُ لِخَطَأٍ كَثِيرٍ مَعَ

651
00:49:40,778 --> 00:49:41,150
جَوَازِهِ، إِلَّا أَنَّ غَلَبَةَ الْجَهْرِ عَلَى الْخَلْقِ صَارَتْ تَدْعُو إِلَى

652
00:49:40,778 --> 00:49:41,150
الْقَوْلِ بِالْبُعْدِ عَنْهُ قَدْرَ مَا أَمْكَنَ.

653
00:49:40,778 --> 00:49:41,150
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: الْحُكْمُ السَّابِعُ فِي قَوْلِهِ: وَيُؤَمِّنُ الْمَأْمُومُ

654
00:49:40,778 --> 00:49:41,150
عَلَى الدُّعَاءِ وَيَسْكُتُ فِي غَيْرِهِ،

655
00:49:40,778 --> 00:49:41,150
فَإِنْ ذَكَرَ اللَّهَ بِتَسْبِيحٍ وَنَحْوِهِ جَازَ.

656
00:49:40,778 --> 00:49:41,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: فَنَجْعَلُ الْحُكْمَ السَّابِعَ فِي قَوْلِهِ: وَيُؤَمِّنُ

657
00:49:40,778 --> 00:49:41,150
الْمَأْمُومُ عَلَى الدُّعَاءِ وَيَسْكُتُ فِي غَيْرِهِ،

658
00:49:40,778 --> 00:49:41,150
فَفِيهِ أَنَّ الْإِمَامَ لَهُ حَالَانِ: الْحَالُ الْأُولَى: أَنْ يَدْعُوَ،

659
00:49:40,778 --> 00:49:41,150
فَالْمُوَافِقُ حَالِئِذٍ لِلسُّنَّةِ أَنْ يُؤَمِّنَ الْمَأْمُومُ فَيُسْتَحَبُّ لَهُ التَّأْمِينُ.

660
00:49:40,778 --> 00:49:41,150
وَالْحَالُ الْأُخْرَى: أَنْ لَا يَدْعُوَ بِأَنْ يَقَعَ مِنْهُ ثَنَاءٌ وَنَحْوُهُ،

661
00:49:40,778 --> 00:49:41,150
كَأَنْ يَقُولَ: [إِنَّكَ لَا يَعِزُّ مَنْ عَادَيْتَ وَلَا يَذِلُّ مَنْ

662
00:49:40,778 --> 00:49:41,150
وَالَيْتَ] إِلَى آخِرِ مَا يَقُولُ الْأَئِمَّةُ ثَنَاءً عَلَى اللَّهِ عَزَّ

663
00:49:40,778 --> 00:49:41,150
وَجَلَّ، فَهَذَا الْمَشْرُوعُ فِيهِ لِلْمَأْمُومِ أَنْ يَسْكُتَ،

664
00:49:40,778 --> 00:49:41,150
السُّنَّةُ أَنْ يَسْكُتَ،

665
00:49:40,778 --> 00:49:41,150
وَيُؤَمِّنُ فِي قَوْلِهِ: فَإِنْ ذَكَرَ اللَّهَ بِتَسْبِيحٍ وَنَحْوِهِ جَازَ،

666
00:49:40,778 --> 00:49:41,150
أَيْ فَإِنْ قَالَ: [سُبْحَانَ اللَّهِ،

667
00:49:40,778 --> 00:49:41,150
لَا إِلَهَ إِلَّا اللَّهُ،

668
00:49:40,778 --> 00:49:41,150
حَقًّا، أَشْهَدُ]،

669
00:49:40,778 --> 00:49:41,150
غَيْرَ ذَلِكَ مِنَ الْعِبَارَاتِ الْمَعْرُوفَةِ فِي النَّاسِ إِذَا سَمِعُوا ثَنَاءً

670
00:49:40,778 --> 00:49:41,150
عَلَى اللَّهِ عَزَّ وَجَلَّ،

671
00:49:40,778 --> 00:49:41,150
فَهَذَا جَائِزٌ،

672
00:49:40,778 --> 00:49:41,150
وَالسُّنَّةُ كَمَا تَقَدَّمَ أَنْ يَسْكُتَ،

673
00:49:40,778 --> 00:49:41,150
فَالتَّأْمِينُ لَا يُسْتَحَبُّ إِلَّا لِلدُّعَاءِ أَمَّا الثَّنَاءُ فَالسُّنَّةُ أَنْ يَسْكُتَ،

674
00:49:40,778 --> 00:49:41,150
فَإِنْ ذَكَرَ اللَّهَ بِشَيْءٍ جَازَ،

675
00:49:40,778 --> 00:49:41,150
وَآتٍ فِي مَحَلِّهِ الْمُسْتَقِلِّ بَيَانُ حُكْمِ التَّأْمِينِ عَلَى الثَّنَاءِ.

676
00:49:40,778 --> 00:49:41,150
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَالْحُكْمُ التَّاسِعُ فِي قَوْلِهِ: وَيُشْرَعُ فِي

677
00:49:40,778 --> 00:49:41,150
هَذَا الْمَحَلِّ وَغَيْرِهِ رَفْعُ الْيَدَيْنِ مَبْسُوطَتَيْنِ وَبُطُونُهُمَا إِلَى السَّمَاءِ،

678
00:49:40,778 --> 00:49:41,150
يَجْعَلُهُمَا حَذْوَ صَدْرِهِ وَيَضُمُّهُمَا بِلَا تَفْرِيجٍ وَلَا يَجْعَلُ إِحْدَاهُمَا فِي

679
00:49:40,778 --> 00:49:41,150
بَطْنِ الْأُخْرَى.

680
00:49:40,778 --> 00:49:41,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَفِيهِ بَيَانُ وَيُشْرَعُ الْعَدْنُ مِنْ رَفْعِ

681
00:49:40,778 --> 00:49:41,150
الْيَدَيْنِ فِي هَذَا الْمَحَلِّ،

682
00:49:40,778 --> 00:49:41,150
وَهُوَ عَلَى الصِّفَاتِ الْمَذْكُورَةِ سَوَاءً فِي هَذَا الْمَحَلِّ أَوْ غَيْرِهِ،

683
00:49:40,778 --> 00:49:41,150
فَهَذِهِ صِفَةٌ عَامَّةٌ فِي رَفْعِ الْيَدَيْنِ فِي الدُّعَاءِ،

684
00:49:40,778 --> 00:49:41,150
وَهُوَ مِنَ السُّنَنِ الْمُسْتَحَبَّةِ فِي عُمُومِ الدُّعَاءِ،

685
00:49:40,778 --> 00:49:41,150
إِلَّا الْمَوَاضِعَ الَّتِي خَلَتْ عَنْهُ كَالرَّفْعِ بَيْنَ الْأَذَانِ وَالْإِقَامَةِ إِذَا

686
00:49:40,778 --> 00:49:41,150
دَعَا هَذَا جَائِزٌ،

687
00:49:40,778 --> 00:49:41,150
أَمَّا هَذَا الْمَحَلُّ وَالْقُنُوتُ،

688
00:49:40,778 --> 00:49:41,150
فَيُسْتَحَبُّ فِيهِ رَفْعُ الْيَدَيْنِ مِنَ الْإِمَامِ وَالْمَأْمُومِ مَعَهُ،

689
00:49:40,778 --> 00:49:41,150
وَصِفَةُ رَفْعِ الْيَدَيْنِ هِيَ الْمَذْكُورَةُ فِي قَوْلِهِ: مَبْسُوطَتَيْنِ،

690
00:49:40,778 --> 00:49:41,150
فَيَجْعَلُهُمَا مَفْهُودَتَيْنِ مَبْسُوطَتَيْنِ،

691
00:49:40,778 --> 00:49:41,150
ثُمَّ يَجْعَلُ بُطُونَهُمَا إِلَى السَّمَاءِ،

692
00:49:40,778 --> 00:49:41,150
بِأَنْ يُشِيرَ بِكَفِّهِ إِلَى السَّمَاءِ وَظَهْرُ يَدِهِ يَكُونُ إِلَى الْأَرْضِ،

693
00:49:40,778 --> 00:49:41,150
ثُمَّ يَجْعَلُهُمَا حَذْوَ صَدْرِهِ،

694
00:49:40,778 --> 00:49:41,150
أَيْ مُقَابِلَ صَدْرِهِ،

695
00:49:40,778 --> 00:49:41,150
فَيُحَاذِي بِهِمَا صَدْرَهُ وَيَضُمُّهُمَا بِلَا تَفْرِيجٍ،

696
00:49:40,778 --> 00:49:41,150
فَلَمْ يَدُلَّ الدَّلِيلُ عَلَى التَّفْرِيجِ،

697
00:49:40,778 --> 00:49:41,150
الصَّحِيحُ أَنَّهُ يَضُمُّهُمَا بِلَا تَفْرِيجٍ،

698
00:49:40,778 --> 00:49:41,150
أَنْ يُلْصِقَهُمَا بِبَعْضِهِمَا،

699
00:49:40,778 --> 00:49:41,150
وَلَا يَجْعَلُ إِحْدَاهُمَا فِي بَطْنِ الْأُخْرَى،

700
00:49:40,778 --> 00:49:41,150
فَإِنَّ الْمُرَادَ جَعْلُ الْيَدَيْنِ مَعًا إِلَى السَّمَاءِ،

701
00:49:40,778 --> 00:49:41,150
فَإِذَا جَعَلَ أَحَدَهُمَا فِي بَطْنِ الْأُخْرَى بِأَنْ ضَمَّهَا إِلَى الْأُخْرَى

702
00:49:40,778 --> 00:49:41,150
وَجَعَلَهَا فَوْقَهَا،

703
00:49:40,778 --> 00:49:41,150
كَانَ كَمَنْ يَرْفَعُ يَدًا وَاحِدَةً،

704
00:49:40,778 --> 00:49:41,150
فَالصَّحِيحُ أَنْ يُلْصِقَهُمَا دُونَ أَنْ يَجْعَلَ إِحْدَاهُمَا فَوْقَهَا،

705
00:49:40,778 --> 00:49:41,150
فَهَذِهِ هِيَ صِفَةُ رَفْعِ الْيَدَيْنِ فِي دُعَاءِ الْقُنُوتِ وَفِي غَيْرِهِ

706
00:49:40,778 --> 00:49:41,150
مِنَ الْأَدْعِيَاتِ الَّتِي يُسْتَحَبُّ فِيهَا رَفْعُ الْيَدَيْنِ،

707
00:49:40,778 --> 00:49:41,150
وَهِيَ إِحْدَى الصِّفَاتِ الْمَشْهُورَةِ فِي الرَّفْعِ،

708
00:49:40,778 --> 00:49:41,150
وَوَرَدَ فِي السُّنَّةِ وَمِنْ فِعْلِ الصَّحَابَةِ صِفَاتٌ أُخْرَى،

709
00:49:40,778 --> 00:49:41,150
وَأَحْسَنُ مَنْ ذَكَرَهَا [أَبُو الْفَرَجِ بْنُ رَجَبٍ] بِشَرْحِ الْحَدِيثِ الْعَاشِرِ

710
00:49:40,778 --> 00:49:41,150
مِنَ [الْأَرْبَعِينَ النَّوَوِيَّةِ] فِي كِتَابِهِ [جَامِعِ الْعُلُومِ وَالْحِكَمِ]،

711
00:49:40,778 --> 00:49:41,150
إِلَّا أَنَّ هَذِهِ الصِّفَةَ هِيَ مِنْ أَحْسَنِ الصِّفَاتِ الْوَارِدَةِ وَمِنْ

712
00:49:40,778 --> 00:49:41,150
بَغِ الْعَدِّ أَلَّا يُخْلِيَ نَفْسَهُ مِنْهَا،

713
00:49:40,778 --> 00:49:41,150
وَالْمَقْصِدُ مِنْ هَذِهِ الصِّفَةِ أَنْ يَكُونَ كَمَنْ يُرِيدُ شَيْئًا مِنْ

714
00:49:40,778 --> 00:49:41,150
أَحَدٍ فَيَمُدُّ أَعْدِيَ إِلَيْهِ بُغْيَةَ أَنْ يُعْطِيَهُ ذَلِكَ،

715
00:49:40,778 --> 00:49:41,150
وَهَذِهِ حَالُ الدَّاعِي،

716
00:49:40,778 --> 00:49:41,150
فَإِنَّهُ يُرِيدُ مِنَ اللَّهِ مُبْتَغًى يَبْتَغِيهِ مِنْهُ،

717
00:49:40,778 --> 00:49:41,150
فَيَمُدُّ أَعْدِيَهُ لِهَذِهِ ذَلِكَ،

718
00:49:40,778 --> 00:49:41,150
وَبِهَذَا نَكُونُ قَدْ فَرَغْنَا مِمَّا يَتَعَلَّقُ بِهِ قُنُوتُ النَّازِلَةِ،

719
00:49:40,778 --> 00:49:41,150
مِمَّا يَتَعَلَّقُ بِجُمْلَةٍ مِنْ أَحْكَامِهِ،

720
00:49:40,778 --> 00:49:41,150
فَنَكْتَفِي بِهَذَا مُنْتَظِرِي،

721
00:49:40,778 --> 00:49:41,150
وَنُتِمُّ هَذِهِ الْكِتَابَةَ إِنْ شَاءَ اللَّهُ تَعَالَى فِي مَجْلِسٍ لَاحِقٍ،

722
00:49:40,778 --> 00:49:41,150
وَاللَّهُ أَعْلَمُ،

723
00:49:40,778 --> 00:49:41,150
وَصَلَّى اللَّهُ وَسَلَّمَ عَلَى آلِهِ وَصَحْبِهِ،

724
00:49:40,778 --> 00:49:41,150
وَصَلَّى اللَّهُ وَسَلَّمَ عَلَى مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ أَجْمَعِينَ،

725
00:49:40,778 --> 00:49:41,150
سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ،

726
00:49:40,778 --> 00:49:41,150
أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ،

727
00:49:40,778 --> 00:49:41,150
أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ،

728
00:49:40,778 --> 00:49:41,150
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.
