115
00:15:23,560 --> 00:15:26,342
وَهُوَ مُسْتَحَبٌّ،

116
00:15:29,123 --> 00:15:31,905
وَهُوَ مُسْتَحَبٌّ كَمَا سَيَأْتِي،

117
00:15:30,514 --> 00:15:31,905
وَالْآخَرُ: "وَيُؤْمِنُ الْمُؤْمِنُونَ" وَيُؤْمِنُ الْمُؤْمِنُونَ وَيَكُونُ الْفَاعِلُ

118
00:15:43,211 --> 00:15:44,783
مِنَ الْفِعْلِ وَيَكُونُ الْفَاعِلُ

119
00:16:04,276 --> 00:16:05,185
مِنَ الْفَاعِلِ؛ وَقَوْلُ

120
00:16:17,219 --> 00:16:18,377
الْمُصَنِّفِ: "وَأُصَلِّي وَأُسَلِّمُ عَلَيْهِ وَعَلَى آلِهِ وَصَحْبِهِ مَا صَلَّى الْمُصَلُّونَ

121
00:16:17,798 --> 00:16:18,377
وَقَنَتَ الْقَانِتُونَ"،

122
00:16:17,798 --> 00:16:18,377
كَمْ مَرَّةً وَقَعَتْ مِنْهُ

123
00:16:26,482 --> 00:16:27,640
هَذِهِ الصَّلَاةُ وَالسَّلَامُ؟

124
00:16:27,061 --> 00:16:27,640
الْجَوَابُ: وَقَعَتْ مَرَّةً وَاحِدَةً،

125
00:16:27,061 --> 00:16:27,640
فَإِنَّهُ لَمْ يَكْتُبْهَا سِوَى مَرَّةٍ فَلَمْ تُحْسَبْ إِلَّا مَرَّةً وَاحِدَةً،

126
00:16:27,061 --> 00:16:27,640
لَا بِعَدَدِ قُنُوتِ الْقَانِتِينَ وَصَلَاةِ الْمُصَلِّينَ أَيْضًا،

127
00:16:27,061 --> 00:16:27,640
بَلْ تُحْسَبُ

128
00:16:44,084 --> 00:16:45,137
لَهُ مَرَّةً وَاحِدَةً،

129
00:16:44,611 --> 00:16:46,716
إِلَّا أَنَّ

130
00:17:18,680 --> 00:17:19,930
هَذِهِ الْمَرَّةَ أَجْرُهَا عَظِيمٌ لِأَنَّهَا بِقَدْرِ صَلَاةِ الْمُصَلِّينَ وَقُنُوتِ الْقَانِتِينَ،

131
00:17:19,305 --> 00:17:19,930
فَكَأَنَّهَا وُزِنَتْ

132
00:17:25,015 --> 00:17:26,351
فِي مِيزَانٍ فَجُعِلَتْ عَظِيمَةً

133
00:17:33,027 --> 00:17:34,362
فِي هَذَا الْمِيزَانِ مَعَ كَوْنِهَا مَرَّةً وَاحِدَةً بِإِجْبَارِهَا وَتَعْظِيمِهَا بِقَدْرِ

134
00:17:33,695 --> 00:17:34,362
مَا يُصَلِّي الْمُصَلُّونَ وَيَقْنُتُ الْقَانِتُونَ،

135
00:17:33,695 --> 00:17:34,362
أَشَارَ لِهَذَا الْمَعْنَى ابْنُ الْقَيِّمِ رَحِمَهُ اللَّهُ تَعَالَى

136
00:17:41,030 --> 00:17:42,887
فِي [الْمَنَارِ الْمُنِيفِ]،

137
00:17:41,959 --> 00:17:42,887
وَحِينَئِذٍ يَكُونُ قَوْلُهُ: "مَا صَلَّى الْمُصَلُّونَ وَقَنَتَ الْقَانِتُونَ"

138
00:18:23,509 --> 00:18:25,736
مِنْ عَطْفِ الْخَاصِّ عَلَى الْعَامِّ أَمْ

139
00:18:51,076 --> 00:18:52,621
مِنْ عَطْفِ الْعَامِّ

140
00:19:11,918 --> 00:19:12,977
عَلَى الْخَاصِّ؟

141
00:19:12,448 --> 00:19:12,977
الْجَوَابُ: يَجُوزُ هَكَذَا وَيَجُوزُ كَذَلِكَ،

142
00:19:12,448 --> 00:19:12,977
رُبَّمَا كَانَ

143
00:19:29,205 --> 00:19:30,455
مِنْ عَطْفِ الْخَاصِّ

144
00:19:45,997 --> 00:19:47,219
عَلَى الْعَامِّ إِذَا

145
00:20:13,476 --> 00:20:18,107
كَانَ الْقُنُوتُ هُنَا بِمَعْنَى الْقِيَامِ فِي الصَّلَاةِ أَوِ الدُّعَاءِ فِيهِ،

146
00:20:18,107 --> 00:20:18,690
وَرُبَّمَا يَكُونُ

147
00:20:43,627 --> 00:20:44,704
مِنْ عَطْفِ الْعَامِّ

148
00:20:59,983 --> 00:21:01,817
عَلَى الْخَاصِّ إِذَا كَانَ الْقُنُوتُ بِمَعْنَى الطَّاعَةِ،

149
00:21:00,900 --> 00:21:01,817
فَإِنَّ الطَّاعَةَ عَامَّةٌ وَالصَّلَاةَ خَاصَّةٌ هِيَ فَرْدٌ

150
00:21:12,200 --> 00:21:13,400
مِنَ الْأَفْرَادِ الْمُنْدَرِجَةِ

151
00:21:20,400 --> 00:21:21,400
فِي مَعْنَى الطَّاعَةِ،

152
00:21:20,900 --> 00:21:21,400
لَا يَكُونُ حِيَالَ ذَلِكَ؛ إِذًا

153
00:21:26,491 --> 00:21:27,582
هَذَا الْعَطْفُ إِمَّا

154
00:21:35,733 --> 00:21:37,067
مِنْ عَطْفِ الْعَامِّ

155
00:21:59,067 --> 00:21:59,900
عَلَى الْخَاصِّ أَوْ مِنْ عَطْفِ الْخَاصِّ

156
00:22:22,400 --> 00:22:23,200
عَلَى الْعَامِّ،

157
00:22:22,800 --> 00:22:23,200
وَقَدْ لَا يَكُونُ كَذَلِكَ وَلَا كَذَلِكَ إِذَا كَانَتِ الصَّلَاةُ بِمَعْنَى

158
00:22:22,800 --> 00:22:23,200
الدُّعَاءِ فِي صَلَاةِ الْمَلَائِكَةِ،

159
00:22:22,800 --> 00:22:24,000
فَإِنَّهَا دُعَاءٌ كَمَا تَقَدَّمَ غَيْرَ مَرَّةٍ فِي بَعْضِ الْمَجَالِسِ أَنْ

160
00:22:24,000 --> 00:22:24,400
قَدْ بَيَّنَّا

161
00:22:35,317 --> 00:22:36,150
أَنَّ صَلَاةَ الْمَلَائِكَةِ هَذَا الرَّجُلَ هِيَ دُعَاءٌ

162
00:22:46,029 --> 00:22:48,756
الَّذِي هُوَ بِالْمَغْفِرَةِ وَالرَّحْمَةِ،

163
00:22:48,302 --> 00:22:48,756
قَوْلُهُمْ: [اللَّهُمَّ اغْفِرْ لَهُ اللَّهُمَّ ارْحَمْهُ]،

164
00:22:48,302 --> 00:22:48,756
وَالْقُنُوتُ يَكُونُ حَالًا

165
00:23:00,120 --> 00:23:01,453
إِذًا بِمَعْنَى

166
00:23:17,436 --> 00:23:18,278
الدُّعَاءِ أَيْضًا،

167
00:23:17,857 --> 00:23:18,278
فَيَكُونُ هَذَا عَطْفَ دُعَاءٍ عَلَى دُعَاءٍ،

168
00:23:17,857 --> 00:23:18,699
فَلَا يَكُونُ أَحَدُهُمَا أَعَمَّ مِنَ الْآخَرِ إِلَّا لَوْ قِيلَ

169
00:23:29,594 --> 00:23:30,541
إِنَّ دُعَاءَ الْقُنُوتِ حِينَئِذٍ يَطُولُ عَنِ الْمَغْفِرَةِ وَالرَّحْمَةِ فَيَكُونُ ذَلِكَ

170
00:23:30,067 --> 00:23:30,541
وَجِيهًا؛ قَالَ

171
00:23:59,605 --> 00:24:00,855
الْمُصَنِّفُ حَفِظَهُ اللَّهُ: أَمَّا بَعْدُ؛ فَهَذِهِ رِسَالَةٌ مُخْتَصَرَةٌ لِبَيَانِ جُمْلَةٍ

172
00:24:05,123 --> 00:24:07,409
مِنْ أَحْكَامِ الْقُنُوتِ مِمَّا يَنْتَفِعُ

173
00:24:27,980 --> 00:24:28,980
بِهَا عُمُومُ الْمُسْلِمِينَ،

174
00:24:28,480 --> 00:24:28,980
وَيَسْتَعِينُونَ بِهَا

175
00:24:45,245 --> 00:24:46,780
عَلَى إِقَامَةِ الدِّينِ،

176
00:24:46,012 --> 00:24:46,780
وَيَظْهَرُ بِهِ الْبَاطِلُ

177
00:24:57,523 --> 00:24:59,058
مِنَ الْحَقِّ الْمُبِينِ،

178
00:24:58,290 --> 00:24:59,058
جَعَلْتُهَا

179
00:25:02,408 --> 00:25:03,455
فِي أَبْوَابٍ مُتَرْجَمَةٍ مُضَمَّنَةٍ لِعِبَارَاتٍ مُحْكَمَةٍ لِتَسْتَقِرَّ أُصُولُهَا وَتَمْتَازَ فُصُولُهَا،

180
00:25:02,931 --> 00:25:03,455
وَأَسْأَلُ اللَّهَ أَنْ يَتَقَبَّلَهَا وَيَنْفَعَ بِهَا مُصَنِّفَهَا وَقَارِئَهَا؛ قَالَ الشَّارِحُ

181
00:25:02,931 --> 00:25:03,455
هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ

182
00:25:07,646 --> 00:25:08,693
فِي هَذِهِ الْجُمْلَةِ مَا يَتَعَلَّقُ بِهَذِهِ الرِّسَالَةِ،

183
00:25:08,170 --> 00:25:08,693
فَذَكَرَ أَنَّهَا رِسَالَةٌ مُخْتَصَرَةٌ،

184
00:25:08,170 --> 00:25:08,693
وَالرِّسَالَةُ اسْمٌ لِمَا لَطُفَ حَجْمُهُ

185
00:25:29,516 --> 00:25:31,709
مِنَ التَّصْنِيفِ،

186
00:25:30,613 --> 00:25:31,709
ثُمَّ ذَكَرَ أَنَّهَا مُخْتَصَرَةٌ،

187
00:25:30,613 --> 00:25:31,709
وَالْمُخْتَصَرُ مِنَ الْكَلَامِ مَا قَلَّ مَبَانِيهِ وَجَلَّ مَعْنَاهُ،

188
00:25:30,613 --> 00:25:31,709
مَا قَلَّ مَبَانِيهِ؛ فَأَلْفَاظٌ قَلِيلَةٌ وَمَعَانِيهِ كَثِيرَةٌ،

189
00:25:30,613 --> 00:25:31,709
وَكَلَامٌ جَامِعٌ،

190
00:25:30,613 --> 00:25:31,709
وَهُوَ أَحَقُّ الْكَلَامِ إِلَى النَّبِيِّ صَلَّى

191
00:25:59,937 --> 00:26:00,526
اللَّهُ

192
00:26:11,552 --> 00:26:12,097
عَلَيْهِ وَسَلَّمَ،

193
00:26:12,097 --> 00:26:12,370
وَكَذَا كَانَ حَالُ أَنْزَالِ الْقُرْآنِ أَنَّهُ كَانَ جَامِعًا،

194
00:26:12,097 --> 00:26:12,370
إِنَّ الْقُرْآنَ

195
00:26:17,370 --> 00:26:18,370
مِنْ جَوَامِعِ الْكَلَامِ،

196
00:26:17,870 --> 00:26:18,370
فَهُوَ

197
00:26:24,799 --> 00:26:26,227
مِنَ الْأُصُولِ الشَّرْعِيَّةِ،

198
00:26:25,513 --> 00:26:26,227
فَمِمَّا يَحْسُنُ بِالْمُتَعَلِّمِ أَنْ يَتَلَقَّى الْعِلْمَ

199
00:26:31,370 --> 00:26:34,370
مِنَ الْقُرْآنِ وَالسُّنَّةِ وَفْقَ طَرِيقَةِ الْقُرْآنِ وَالسُّنَّةِ بِأَنْ يَكُونَ الْبَيَانُ

200
00:26:33,870 --> 00:26:34,870
فِيهِ جَامِعًا كَالْقُرْآنِ وَالسُّنَّةِ،

201
00:26:34,370 --> 00:26:34,870
وَيَصْلُحُ بِذَلِكَ تَلَقِّيهِ؛ ثُمَّ ذَكَرَ ثَلَاثَةَ مَقَاصِدَ لِتَصْنِيفِ هَذَا الْكِتَابِ:

202
00:26:34,370 --> 00:26:34,870
الْمَقْصِدُ الْأَوَّلُ: فِي قَوْلِهِ: "لِبَيَانِ جُمْلَةٍ

203
00:27:19,570 --> 00:27:20,391
مِنْ أَحْكَامِ الْقُنُوتِ مِمَّا يَنْتَفِعُ بِهِ عُمُومُ الْمُسْلِمِينَ"،

204
00:27:19,980 --> 00:27:20,391
فَالْمُرَادُ

205
00:27:24,903 --> 00:27:25,724
مِنْ هَذَا

206
00:27:39,298 --> 00:27:41,162
الْمُصَنَّفِ تَحْقِيقُ أَمْرَيْنِ: أَحَدُهُمَا: تَعْلِيمُ أَحْكَامِ الْقُنُوتِ بِبَيَانِهَا،

207
00:27:40,230 --> 00:27:41,162
وَاخْتَصَرَ الْمُصَنِّفُ عَلَى بَيَانِ مَا يَنْتَفِعُ بِهِ

208
00:27:49,550 --> 00:27:51,414
أَيْ مَا تَشْتَدُّ الْحَاجَةُ إِلَيْهِ لَا جَمِيعَ أَحْكَامِ الْقُنُوتِ؛ لِأَنَّ

209
00:27:50,482 --> 00:27:51,414
هَذَا يَطُولُ مَعَ قِلَّةِ الْمَنْفَعِ فِيهِ،

210
00:27:50,482 --> 00:27:51,414
وَالْعِلْمُ لَيْسَ بِالْبَسْطِ وَالِاتِّسَاعِ وَإِنَّمَا بِالنَّفْعِ وَالِانْتِفَاعِ،

211
00:27:50,482 --> 00:27:51,414
وَالْأَمْرُ الثَّانِي: أَنَّهُ يُرِيدُ بِبَيَانِ أَحْكَامِ الْقُنُوتِ نَفْعَ الْمُسْلِمِينَ،

212
00:27:50,482 --> 00:27:51,414
وَهَذَا النَّفْعُ يَتَحَقَّقُ بِمَعْرِفَتِهَا مَعْرِفَةً تَامَّةً أَيْ بِفَهْمِهَا

213
00:28:18,071 --> 00:28:19,682
عَلَى الْوَجْهِ الصَّحِيحِ وَالْعَمَلِ بِهَا وَالدَّعْوَةِ إِلَيْهَا وَالصَّبْرِ عَلَى ذَلِكَ

214
00:28:18,877 --> 00:28:19,682
وَمُرَاجَعَتِهَا وَمُذَاكَرَتِهَا مَعَ الْغَيْرِ

215
00:28:34,182 --> 00:28:35,793
إِلَى غَيْرِ ذَلِكَ

216
00:28:50,135 --> 00:28:52,098
مِنْ أَوْجُهِ الِاتِّصَالِ بِالْعِلْمِ،

217
00:28:51,117 --> 00:28:52,098
وَلَيْسَ الشَّأْنُ أَنْ تَعْرِفَ هَذِهِ الْأَحْكَامَ لِتَعْرِفَهَا،

218
00:28:51,117 --> 00:28:52,098
فَإِنَّمَا يُحْمَدُ الْعِلْمُ

219
00:29:29,765 --> 00:29:31,863
لِمَا يَتَرَتَّبُ عَلَيْهِ

220
00:29:36,424 --> 00:29:37,151
مِنْ آثَارِهِ الْحَمِيدَةِ الْأَهْدَدَاتِ،

221
00:29:36,787 --> 00:29:37,151
فَإِنَّمَا يَنْبَغِي أَنْ يَقْتَرِنَ بِعِلْمِكَ

222
00:29:41,782 --> 00:29:42,930
هَذَا الْعَمَلُ أَوِ الدَّعْوَةُ أَوْ غَيْرُ

223
00:30:05,979 --> 00:30:06,528
ذَلِكَ

224
00:30:12,560 --> 00:30:13,483
مِمَّا يُطْلَبُ

225
00:30:17,175 --> 00:30:19,022
فِي الِاقْتِرَانِ بِالْعِلْمِ مِنَ الْمَأْمُورَاتِ الشَّرْعِيَّةِ؛ وَالْمَقْصِدُ الثَّانِي:

226
00:30:36,219 --> 00:30:36,682
فِي

227
00:30:46,341 --> 00:30:47,528
قَوْلِهِ: "وَيَسْتَعِينُونَ بِهِ عَلَى إِقَامَةِ الدِّينِ"،

228
00:30:46,935 --> 00:30:47,528
وَهُوَ بِمَعْنَى الْعَمَلِ بِهِ،

229
00:30:46,935 --> 00:30:47,528
وَمَا يَتْبَعُ الْعَمَلَ كَالدَّعْوَةِ وَغَيْرِهَا،

230
00:30:46,935 --> 00:30:47,528
يَكُونُ ذَلِكَ

231
00:31:06,210 --> 00:31:07,247
مِنْ عَطْفِ خَاصٍّ

232
00:31:16,970 --> 00:31:18,067
عَلَى الْعِلْمِ،

233
00:31:17,519 --> 00:31:18,067
فَإِنَّ الِانْتِفَاعَ عَامٌّ فِي الْعِلْمِ

234
00:31:32,065 --> 00:31:33,440
وَالْعَمَلِ وَغَيْرِهِ،

235
00:31:32,753 --> 00:31:33,440
أَمَّا الِاسْتِعَانَةُ بِهَا عَلَى إِقَامَةِ الدِّينِ فَهِيَ خَاصَّةٌ تَتَعَلَّقُ بِالْعَمَلِ

236
00:31:32,753 --> 00:31:35,503
وَمَا يَتَّصِلُ بِهِ؛ ثُمَّ ذَكَرَ الْمَقْصِدَ الثَّالِثَ: بِقَوْلِهِ: "وَيَظْهَرُ بِهِ

237
00:31:35,503 --> 00:31:36,190
الْبَاطِلُ

238
00:31:53,171 --> 00:31:54,094
مِنَ الْحَقِّ الْمُبِينِ" أَيْ يَمْتَازُ بِهِ الْحَقُّ عَنِ الْبَاطِلِ،

239
00:31:53,632 --> 00:31:54,094
فَيَكُونُ الْحَقُّ ظَاهِرًا بَيِّنًا وَالْبَاطِلُ يَكُونُ كَذَلِكَ جَلِيًّا،

240
00:31:53,632 --> 00:31:54,094
وَمُرَادُ الْمُصَنِّفِ مِنْ هَذَا بَيَانُ جُمْلَةٍ مِنَ الْأَخْطَاءِ الشَّائِعَةِ فِيمَا

241
00:31:53,632 --> 00:31:54,094
يَتَعَلَّقُ بِالْقُنُوتِ لِيُصْلِحَ لِلْمَرْءِ حِينَئِذٍ دِينَهُ بِتَجَنُّبِ هَذِهِ الْأَخْطَاءِ وَتَمْيِيزِهَا؛

242
00:31:53,632 --> 00:31:54,094
ثُمَّ ذَكَرَ الصَّنْعَةَ الَّتِي عَمِلَ بِهَا

243
00:32:09,369 --> 00:32:10,797
فِي وَضْعِ هَذَا الْمُصَنَّفِ بِقَوْلِهِ: "جَعَلْتُهَا

244
00:32:19,369 --> 00:32:20,797
فِي أَبْوَابٍ مُتَرْجَمَةٍ مُضَمَّنَةٍ لِعِبَارَاتٍ مُحْكَمَةٍ"،

245
00:32:20,083 --> 00:32:20,797
فَجَعَلَهَا

246
00:32:25,055 --> 00:32:25,902
فِي أَبْوَابٍ مُخْتَلِفَةٍ كُلُّ بَابٍ مِنْهَا لَهُ تَرْجَمَةٌ أَيْ عُنْوَانٌ،

247
00:32:46,936 --> 00:32:48,935
إِنَّ التَّرْجَمَةَ تَشْمَلُ

248
00:33:18,567 --> 00:33:19,985
لِمَا يُعَنْوَنُ بِهِ مِنَ الْأَقْوَالِ،

249
00:33:19,276 --> 00:33:19,985
قَوْلُهُ: "مُضَمَّنَةٍ لِعِبَارَاتٍ مُحْكَمَةٍ" أَيْ عِبَارَاتٍ جَامِعَةٍ مَانِعَةٍ تَتَّصِفُ بِوَصْفَيْنِ:

250
00:33:19,276 --> 00:33:19,985
أَحَدُهُمَا الْجَمْعُ: فَتَجْمَعُ مَا يُحْتَاجُ إِلَيْهِ لِلْفِعْلِ،

251
00:33:19,276 --> 00:33:22,112
وَالْآخَرُ الْمَنْعُ: فَتَمْنَعُ مَا يُشَوِّشُ الْفَهْمَ وَيُحْدِثُ سُوءَ الْفَهْمِ؛ ثُمَّ

252
00:33:22,112 --> 00:33:22,821
ذَكَرَ الدَّاعِيَ لَهُ عَلَى صَنْعَةِ كِتَابِهِ عَلَى

253
00:33:44,311 --> 00:33:45,589
هَذِهِ الْحَالِ بِقَوْلِهِ: "لِتَسْتَقِرَّ أُصُولُهَا وَتَمْتَازَ فُصُولُهَا"،

254
00:33:44,950 --> 00:33:45,589
فَالْمَقْصِدُ الْأَوَّلُ:

255
00:34:03,475 --> 00:34:04,752
فِي قَوْلِهِ: "لِتَسْتَقِرَّ أُصُولُهَا" أَيْ لِتَكُونَ بَيَانُهُ ظَاهِرَةً جَلِيَّةً فَتَرْسَخَ

256
00:34:08,585 --> 00:34:09,862
فِي قَلْبِ الْمُتَعَلِّمِ،

257
00:34:09,224 --> 00:34:09,862
وَلَا يَحْصُلُ ذَلِكَ إِلَّا بِقِسْمَتِهَا إِلَى أَبْوَابٍ مُخْتَلِفَةٍ بِحَيْثُ يَحْصُلُ

258
00:34:09,224 --> 00:34:09,862
الْمُتَعَلِّمُ

259
00:34:19,812 --> 00:34:20,765
أَنْ

260
00:34:41,735 --> 00:34:43,641
يَجْمَعَ الْعِلْمَ الْمُنْدَرِجَ

261
00:34:57,447 --> 00:34:58,838
فِي كُلِّ بَابٍ عَلَى حِدَةٍ فَيَضْبِطَهُ،

262
00:34:58,143 --> 00:34:58,838
أَمَّا

263
00:35:35,476 --> 00:35:36,680
أَنْ تَقَعَ الرِّسَالَةُ سَرْدًا فَهَذَا مِمَّا يُضْعِفُ ضَبْطَ الْمُتَعَلِّمِ لِلْأَحْكَامِ

264
00:35:36,078 --> 00:35:36,680
الْمُنْدَرِجَةِ فِيهِ،

265
00:35:36,078 --> 00:35:36,680
وَكَذَا يَقَعُ بِكَوْنِهَا مُضَمَّنَةً لِعِبَارَاتٍ مُحْكَمَةٍ،

266
00:35:45,107 --> 00:35:46,311
فَإِنَّ الْكَلَامَ

267
00:36:11,131 --> 00:36:11,976
إِذَا كَثُرَ وَتَشَعَّبَ عَسُرَ إِدْرَاكُهُ،

268
00:36:11,553 --> 00:36:11,976
وَإِنْ أَمْكَنَ إِدْرَاكُهُ عَسُرَ ضَبْطُهُ،

269
00:36:11,553 --> 00:36:11,976
فَكَانَ

270
00:36:17,046 --> 00:36:17,891
مِنَ النَّافِعِ حِينَئِذٍ أَنْ يُجْمَعَ الْكَلَامُ فِي عِبَارَاتٍ مُحْكَمَةٍ لِيَحْصُلَ

271
00:36:17,469 --> 00:36:17,891
بِذَلِكَ اسْتِقْرَارُ فُصُولِ هَذَا الْكِتَابِ أَيْ أَهَمُّ

272
00:36:29,722 --> 00:36:30,567
مَا فِيهِ؛ ثُمَّ ذَكَرَ الْمَقْصِدَ الثَّانِي:

273
00:36:46,288 --> 00:36:47,110
فِي قَوْلِهِ: "وَتَمْتَازَ فُصُولُهَا" أَيْ مَوَارِدُ الْأَحْكَامِ فِيهَا،

274
00:36:46,699 --> 00:36:47,521
فَإِنَّ كُلَّ فَصْلٍ مِنْ هَذَا الْكِتَابِ وَفُصُولِهِ أَيْ أَبْوَابِهِ لَهُ

275
00:36:47,110 --> 00:36:49,986
أَحْكَامٌ مُسْتَقِلَّةٌ تَتَعَلَّقُ بِهِ،

276
00:36:49,986 --> 00:36:50,397
فَإِنْ لَمْ يَفْصِلِ الْعَبْدُ بَيْنَ

277
00:37:06,415 --> 00:37:07,779
هَذِهِ الْأَحْكَامِ رُبَّمَا تَدَاخَلَتْ وَشَتَّتَتْهُ،

278
00:37:07,097 --> 00:37:07,779
فَهَذَا مُضِرٌّ بِالْمُتَعَلِّمِ،

279
00:37:07,097 --> 00:37:07,779
فَاحْتَاجَ طَالِبُ الْعِلْمِ إِلَى تَلَقِّي الْكِتَابِ عَلَى وَجْهِ كَوْنِهِ أَبْوَابًا

280
00:37:37,722 --> 00:37:38,802
أَوْ فُصُولًا لِيَحْصُلَ لَهُ بِذَلِكَ تَمَيُّزُ هَذِهِ الْأَحْكَامِ فَيَسْتَطِيعُ ضَبْطَهَا،

281
00:37:38,262 --> 00:37:38,802
وَإِذَا أَشْكَلَ عَلَيْهِ شَيْءٌ اسْتَطَاعَ رَدَّهُ إِلَى الْبَابِ الَّذِي يُشْكِلُ

282
00:37:38,262 --> 00:37:38,802
عَلَيْهِ دُونَ

283
00:37:49,606 --> 00:37:50,686
مَا يَقَعُ

284
00:38:18,770 --> 00:38:20,037
مِنْ كَثِيرٍ

285
00:38:47,949 --> 00:38:48,986
مِنَ الطَّلَبَةِ أَنَّهُ يَسْتَشْكِلُ الْمَتْنَ كَامِلًا لِكَوْنِهِ غَالِطٌ

286
00:39:00,420 --> 00:39:02,500
فِي فَهْمِ حُكْمِهِ،

287
00:39:01,460 --> 00:39:04,580
فَهَذَا مِمَّا يَحْصُلُ مِنَ

288
00:39:04,580 --> 00:39:05,620
الطَّلَبَةِ وَيَضُرُّ الْأَبْوَابَ

289
00:39:19,617 --> 00:39:20,784
فِي التَّعْلِيمِ،

290
00:39:28,716 --> 00:39:29,971
فَيَكُونُ الْأَوْلَى حِينَئِذٍ

291
00:39:48,623 --> 00:39:49,255
أَنْ

292
00:40:19,610 --> 00:40:21,110
يُجْعَلَ الْكِتَابُ عَلَى الْأَبْوَابِ وَالْفُصُولِ لِيَحْصُلَ لَهُ إِمْكَانُ رَدِّ

293
00:40:33,735 --> 00:40:34,767
غَلَطِ الْفَهْمِ إِلَى بَابٍ بِعَيْنِهِ دُونَ

294
00:40:42,570 --> 00:40:43,970
أَنْ يَجْنِيَ عَلَى نَفْسِهِ بِالْقَوْلِ بِسُوءِ الْفَهْمِ

295
00:40:49,570 --> 00:40:50,970
فِي الْكِتَابِ كُلِّهِ؛ ثُمَّ ذَكَرَ فِيمَا بَعْدُ دُعَاءً لَهُ وَلِمُطْلِقِ

296
00:40:50,270 --> 00:40:50,970
هَذِهِ الرِّسَالَةِ فَقَالَ: "وَأَسْأَلُ

297
00:41:06,790 --> 00:41:07,350
اللَّهَ

298
00:41:18,301 --> 00:41:20,267
أَنْ يَتَقَبَّلَهَا وَيَنْفَعَ بِهَا مُصَنِّفَهَا وَقَارِئَهَا"،

299
00:41:19,284 --> 00:41:20,267
فَدَعَا بِأَمْرَيْنِ: أَحَدُهُمَا التَّقَبُّلُ: وَأَبْلَغُ آيَةٍ

300
00:41:32,033 --> 00:41:34,117
مِنَ الْقَبُولِ إِذْ كَانَ هُوَ دُعَاءُ الْأَنْبِيَاءِ فِي الْقُرْآنِ،

301
00:41:33,700 --> 00:41:34,117
وَيَزِيدُ عَنِ الْقَبُولِ بِكَوْنِهِ

302
00:41:58,200 --> 00:42:00,353
فِيهِ مَحَبَّةُ

303
00:42:26,778 --> 00:42:28,478
اللَّهِ عَزَّ وَجَلَّ لِلْعَبْدِ وَرِضَاهُ عَنْهُ،

304
00:42:28,053 --> 00:42:28,478
أَمَّا الْقَبُولُ فَتَارَةً يُرَادُ

305
00:42:50,619 --> 00:42:51,988
بِهِ صِحَّةُ الْعَمَلِ وَتَارَةً أُخْرَى يُرَادُ بِهِ الْجَزَاءُ عَلَيْهِ،

306
00:42:51,303 --> 00:42:51,988
وَالدُّعَاءُ الثَّانِي: فِي قَوْلِهِ: "وَيَنْفَعَ بِهَا مُصَنِّفَهَا وَقَارِئَهَا"،

307
00:42:51,303 --> 00:42:51,988
وَهُوَ الْأَوَّلُ

308
00:43:13,704 --> 00:43:14,947
مِنَ الْمَقَاصِدِ الثَّلَاثَةِ الْمَذْكُورَةِ فِيمَا تَقَدَّمَ لِتَصْنِيفِ هَذَا الْكِتَابِ وَهُوَ

309
00:43:14,325 --> 00:43:14,947
أَعَمُّهَا، فَيَدْخُلُ فِيهِ الْمَقْصِدَانِ الْأُخْرَيَانِ،

310
00:43:14,325 --> 00:43:14,947
وَدُعَاءُ مُصَنِّفٍ

311
00:43:18,056 --> 00:43:21,300
بِهَذَا الدُّعَاءِ

312
00:43:21,300 --> 00:43:21,999
وَقَعَ عَلَى أَمْرَيْنِ: أَحَدُهُمَا: أَنَّهُ دَعَا لِنَفْسِهِ وَلِغَيْرِهِ،

313
00:43:21,300 --> 00:43:22,698
وَدُعَاؤُهُ لِنَفْسِهِ فِي قَوْلِهِ: "لِمُصَنِّفِهَا"،

314
00:43:21,999 --> 00:43:22,698
وَدُعَاؤُهُ لِغَيْرِهِ

315
00:43:35,982 --> 00:43:37,380
فِي قَوْلِهِ: "قَارِئَهَا"،

316
00:43:36,681 --> 00:43:37,380
وَقَارِئُ الْمَتْنِ هُوَ

317
00:43:47,047 --> 00:43:48,380
مَنْ يَتَلَقَّاهُ عَلَى شَيْخٍ يَشْرَحُهُ وَيُبَيِّنُ لَهُ مَعْنِيَّهُ وَلَوْ لَمْ

318
00:43:47,713 --> 00:43:48,380
يَكُنْ يَقْرَؤُهُ فِي الْحَقِيقَةِ،

319
00:43:47,713 --> 00:43:48,380
فَالْقِرَاءَةُ نَوْعَانِ: أَحَدُهُمَا قِرَاءَةٌ حَقِيقِيَّةٌ: وَهِيَ قِرَاءَةُ الْقَارِئِ الَّذِي يَقْرَأُ

320
00:43:47,713 --> 00:43:48,380
هَذَا الْمَتْنَ ثُمَّ يُعَلِّقُ عَلَى

321
00:44:07,861 --> 00:44:08,992
مَا ذُكِرَ مِنْهُ الْمُعَلِّمُ،

322
00:44:08,427 --> 00:44:08,992
وَالْقِرَاءَةُ الثَّانِيَةُ قِرَاءَةٌ حُكْمِيَّةٌ:

323
00:44:26,820 --> 00:44:27,602
وَهِيَ قِرَاءَةُ

324
00:44:43,646 --> 00:44:44,428
مَنْ يَتَلَقَّى

325
00:44:46,776 --> 00:44:47,559
هَذَا الْمَتْنَ بِالسَّمَاعِ حُضُورًا أَوْ غِيَابًا

326
00:44:58,668 --> 00:45:01,104
مَعَ سَمَاعِ الْمُسَجَّلِ مِنْهُ دُونَ أَنْ يَقْرَأَهُ بِلِسَانِهِ الْمُصَنِّفُ،

327
00:45:00,617 --> 00:45:01,104
فَإِنَّهُ

328
00:45:09,719 --> 00:45:12,488
فِي حُكْمِ الْقَارِئِ،

329
00:45:11,104 --> 00:45:12,488
فَإِنَّهُ

330
00:45:19,411 --> 00:45:22,180
فِي حُكْمِ الْقَارِئِ،

331
00:45:20,795 --> 00:45:23,137
وَالْمَعْرُوفُ مِنْ كَلَامِ الْعُلَمَاءِ فَإِنْ قَالَ أَحَدُهُمْ: [قَرَأْتُ

332
00:45:28,397 --> 00:45:29,354
عَلَى فُلَانٍ كَذَا]

333
00:45:39,808 --> 00:45:40,692
لَا يُرِيدُ أَنَّهُ قَرَأَهُ بِلِسَانِهِ،

334
00:45:40,250 --> 00:45:40,692
وَإِنَّمَا يُرِيدُ أَنَّهُ تَلَقَّاهُ عَنْهُ،

335
00:45:40,250 --> 00:45:40,692
وَكَانَ الْأَصْلُ

336
00:45:58,058 --> 00:45:58,646
فِي

337
00:46:09,813 --> 00:46:10,989
ذَلِكَ أَنَّهُ

338
00:46:22,830 --> 00:46:24,230
إِنْ

339
00:46:35,058 --> 00:46:36,772
ذَكَرَ الْقِرَاءَةَ فَإِنَّهُ كَانَ حَاضِرًا

340
00:46:39,343 --> 00:46:41,057
فِي مَجْلِسٍ،

341
00:46:40,200 --> 00:46:41,057
