1
00:00:01,330 --> 00:00:03,730
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ:

2
00:00:04,930 --> 00:00:07,330
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

3
00:00:07,330 --> 00:00:09,638
وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

4
00:00:09,407 --> 00:00:09,638
الْحَمْدُ لِلَّهِ رَبِّنَا،

5
00:00:10,330 --> 00:00:11,530
وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

6
00:00:11,130 --> 00:00:11,530
وَأَشْهَدُ

7
00:00:25,530 --> 00:00:26,730
أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

8
00:00:26,130 --> 00:00:29,580
ثُمَّ أَمَّا بَعْدُ؛ فَهَذَا الْمَجْلِسُ

9
00:00:29,580 --> 00:00:30,330
الثَّالِثُ فِي شَرْحِ الْكِتَابِ

10
00:00:59,330 --> 00:01:01,330
الثَّانِي مِنْ بَرْنَامَجِ [عُدَّةِ رَمَضَانَ]

11
00:01:23,190 --> 00:01:23,990
فِي سَنَتِهِ الأُولَى،

12
00:01:23,590 --> 00:01:23,990
سَنَةَ خَمْسٍ وَأَرْبَعِينَ وَأَرْبَعِمِائَةٍ وَأَلْفٍ،

13
00:01:23,590 --> 00:01:23,990
وَأَتَقَدَّمُ الْقَوْلُ أَنَّ الْكِتَابَ الْمَقْرُوءَ

14
00:01:30,990 --> 00:01:32,323
فِي هَذَا الْمَجْلِسِ وَسَابِقِهِ هُوَ كِتَابُ [فَتْحِ كَامِلِ النُّعُوتِ بِبَيَانِ

15
00:01:31,657 --> 00:01:32,323
أَحْكَامِ الْقُنُوتِ]،

16
00:01:58,460 --> 00:01:59,793
وَهُوَ تَابِعٌ لِكِتَابِ [بُغْيَةِ الْقَائِمِ] لَيْسَ مُنْفَصِلًا عَنْهُ،

17
00:01:59,127 --> 00:01:59,793
وَإِنَّمَا مُتَمِّمٌ لَهُ،

18
00:01:59,127 --> 00:01:59,793
فَيُسْتَفَادُ

19
00:02:03,174 --> 00:02:04,127
مِنْهُ مَا يَتَعَلَّقُ بِالْقِيَامِ إِذِ الْقُنُوتُ مِنْهُ،

20
00:02:03,460 --> 00:02:04,127
وَقَدِ انْتَهَى بِنَا الْبَيَانُ

21
00:02:18,127 --> 00:02:21,460
مِنَ الْمَجْلِسِ السَّابِقِ إِلَى قَوْلِ الْمُصَنِّفِ: "الثَّانِي: قُنُوتُ الْوِتْرِ"،

22
00:02:21,460 --> 00:02:22,127
نَعَمْ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

23
00:02:21,460 --> 00:02:22,127
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

24
00:02:21,460 --> 00:02:22,127
وَالصَّلَاةُ وَالسَّلَامُ عَلَى نَبِيِّنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحَابَتِهِ أَجْمَعِينَ،

25
00:02:21,460 --> 00:02:22,127
اللَّهُمَّ اغْفِرْ لَنَا،

26
00:02:21,460 --> 00:02:22,127
اللَّهُمَّ اغْفِرْ لِشَيْخِنَا وَلِوَالِدَيْهِ وَلِشُيُوخِهِ وَلِلْمُسْلِمِينَ أَجْمَعِينَ،

27
00:02:21,460 --> 00:02:22,127
أَمَّا بَعْدُ؛ قُلْتُمْ وَفَّقَكُمُ اللَّهُ

28
00:02:47,460 --> 00:02:50,960
فِي مُصَنَّفِكُمْ [فَتْحِ كَامِلِ النُّعُوتِ]: الثَّانِي: قُنُوتُ الْوِتْرِ فِي

29
00:02:50,960 --> 00:02:51,460
السَّنَةِ كُلِّهَا،

30
00:02:54,628 --> 00:02:55,460
فِي السَّنَةِ كُلِّهَا،

31
00:03:27,642 --> 00:03:30,369
فِي السَّنَةِ كُلِّهَا،

32
00:03:37,660 --> 00:03:40,860
سِوَى فِي نِصْفِ رَمَضَانَ

33
00:03:40,860 --> 00:03:42,460
الأَوَّلِ فَيَجُوزُ،

34
00:03:42,460 --> 00:03:45,793
وَصِفَتُهُ كَقُنُوتِ النَّازِلَةِ إِلَّا لِلْمُفْرَدِ فِي تَأْمِينِهِ فَيَجُوزُ وَلَا يُسْتَحَبُّ

35
00:03:45,127 --> 00:03:45,793
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: لَمَّا فَرَغَ الْمُصَنِّفُ مِمَّا يَتَعَلَّقُ بِالنَّوْعِ

36
00:04:21,271 --> 00:04:23,817
الأَوَّلِ مِنْ

37
00:04:23,817 --> 00:04:25,090
أَنْوَاعِ الْقُنُوتِ،

38
00:04:23,817 --> 00:05:13,552
وَهُوَ قُنُوتُ النَّازِلَةِ،

39
00:05:13,552 --> 00:05:14,988
وَعَدَّدَ

40
00:05:45,060 --> 00:05:46,253
الأَحْكَامَ الْمُتَعَلِّقَةَ بِهِ،

41
00:05:57,181 --> 00:05:58,467
شَرَعَ فِي مَا يَتَعَلَّقُ بِالنَّوْعِ الثَّانِي مِنْهُ،

42
00:05:57,824 --> 00:05:58,467
وَهُوَ قُنُوتُ الْوِتْرِ،

43
00:05:57,824 --> 00:06:01,039
فَذَكَرَ فِيهِ

44
00:06:01,039 --> 00:06:01,681
أَرْبَعَةَ أَحْكَامٍ؛ الْحُكْمُ الأَوَّلُ: فِي قَوْلِهِ: "يُسْتَحَبُّ فِي الْوِتْرِ فِي

45
00:06:01,039 --> 00:06:01,681
السَّنَةِ كُلِّهَا"،

46
00:06:01,039 --> 00:06:01,681
فَذَكَرَ مَحَلَّ اسْتِحْبَابِهِ،

47
00:06:01,039 --> 00:06:01,681
وَهُوَ مُتَعَلِّقٌ بِأَمْرَيْنِ: أَحَدُهُمَا: مَحَلُّهُ

48
00:06:51,352 --> 00:06:53,094
مِنَ الصَّلَاةِ،

49
00:06:52,223 --> 00:06:53,094
وَهُوَ الْوِتْرُ،

50
00:06:52,223 --> 00:06:53,094
مَحَلُّهُ

51
00:07:01,805 --> 00:07:03,547
مِنَ الصَّلَاةِ وَهُوَ الْوِتْرُ،

52
00:07:02,676 --> 00:07:03,547
وَالآخَرُ: وَقْتُهُ،

53
00:07:02,676 --> 00:07:03,547
وَقْتُهُ وَهُوَ السَّنَةُ كُلُّهَا،

54
00:07:02,676 --> 00:07:03,547
وَقْتُهُ وَهُوَ السَّنَةُ كُلُّهَا،

55
00:07:02,676 --> 00:07:03,547
فَيُسْتَحَبُّ لِمَنْ أَوْتَرَ أَنْ يَقْنُتَ

56
00:07:14,871 --> 00:07:16,613
فِي وِتْرِهِ أَوْ غَيْرِهِ،

57
00:07:15,742 --> 00:07:16,613
سَوَاءٌ

58
00:07:38,016 --> 00:07:39,241
كَانَ وِتْرُهُ

59
00:08:02,899 --> 00:08:03,627
فِي

60
00:08:17,454 --> 00:08:18,910
رَمَضَانَ أَوْ غَيْرِهِ،

61
00:08:18,182 --> 00:08:18,910
وَبِهِ تَعْلَمُ،

62
00:08:18,182 --> 00:08:18,910
وَبِهِ تَعْلَمُ أَنَّ الْقُنُوتَ

63
00:08:32,183 --> 00:08:33,528
لَا يَخْتَصُّ بِالْجَمَاعَةِ،

64
00:08:32,856 --> 00:08:33,528
إِذْ رُبَّمَا يُصَلِّي مُوتِرٌ وِتْرَهُ فَرْدًا،

65
00:08:32,856 --> 00:08:33,528
فَهَذِهِ هِيَ الْحَالُ الأَصْلِيَّةُ فِيمَا

66
00:08:42,269 --> 00:08:57,060
يَتَعَلَّقُ بِالْوِتْرِ خَارِجَ رَمَضَانَ،

67
00:08:57,060 --> 00:08:57,673
فَلَازَالَ هَذَا يُسْتَحَبُّ لَهُ

68
00:09:00,736 --> 00:09:01,961
أَنْ يَقْنُتَ

69
00:09:15,438 --> 00:09:16,663
فِي وِتْرِهِ وَإِنْ

70
00:09:41,452 --> 00:09:42,643
كَانَ مُنْفَرِدًا؛ وَالْحُكْمُ الثَّانِي:

71
00:09:47,406 --> 00:09:48,597
فِي قَوْلِهِ: "سِوَى

72
00:09:57,206 --> 00:09:58,488
فِي نِصْفِ رَمَضَانَ الأَوَّلِ فَيَجُوزُ"،

73
00:09:57,847 --> 00:09:58,488
فَفِيهِ أَنَّ الْقُنُوتَ

74
00:10:08,383 --> 00:10:09,485
فِي وِتْرِ رَمَضَانَ

75
00:10:16,095 --> 00:10:17,197
عَلَى دَرَجَتَيْنِ اثْنَتَيْنِ،

76
00:10:16,646 --> 00:10:17,197
فَفِيهِ أَنَّ الْقُنُوتَ

77
00:10:33,907 --> 00:10:36,453
فِي

78
00:10:36,453 --> 00:10:39,000
وِتْرِ رَمَضَانَ عَلَى دَرَجَتَيْنِ اثْنَتَيْنِ: الدَّرَجَةُ الأُولَى: الِاسْتِحْبَابُ،

79
00:11:17,780 --> 00:11:20,558
وَهُوَ فِي النِّصْفِ

80
00:11:43,780 --> 00:11:44,780
الثَّانِي

81
00:11:52,780 --> 00:11:54,447
مِنْ رَمَضَانَ،

82
00:11:53,613 --> 00:11:54,447
وَيُسَاوِي بِهَذَا الْقُنُوتَ

83
00:12:13,857 --> 00:12:15,242
فِي وِتْرِهِ أَيَّ يَوْمٍ آخَرَ

84
00:12:46,539 --> 00:12:48,043
مِنَ الْعَامِ،

85
00:12:47,291 --> 00:12:48,043
وَالثَّانِيَةُ الدَّرَجَةُ الثَّانِيَةُ: الْجَوَازُ،

86
00:12:47,291 --> 00:12:48,043
وَهِيَ

87
00:13:08,369 --> 00:13:09,898
فِي قُنُوتِ الْمُوتِرِ لِوِتْرِهِ

88
00:13:12,957 --> 00:13:16,016
فِي النِّصْفِ الأَوَّلِ مِنَ الْعَامِ،

89
00:13:15,251 --> 00:13:16,016
وَبِهِ تَعْلَمُ

90
00:13:40,710 --> 00:13:41,910
أَنَّ الأَكْمَلَ تَأْخِيرُ الْقُنُوتِ

91
00:13:46,128 --> 00:13:47,037
فِي الْوِتْرِ إِلَى النِّصْفِ الثَّانِي

92
00:13:50,219 --> 00:13:51,128
مِنْ رَمَضَانَ،

93
00:13:50,674 --> 00:13:51,128
فَهَذَا هُوَ الْمُسْتَحَبُّ،

94
00:13:50,674 --> 00:13:51,128
وَعَلَيْهِ جَرَى عَمَلُ الصَّحَابَةِ،

95
00:13:50,674 --> 00:13:51,128
وَمَا صَحَّ عَنْهُمْ أَنَّهُمْ كَانُوا يَقْنُتُونَ

96
00:13:58,999 --> 00:14:02,125
فِي رَمَضَانَ يُخَصَّصُ بِكَوْنِهِمْ كَانُوا يَقْنُتُونَ فِي

97
00:14:02,125 --> 00:14:02,907
رَمَضَانَ

98
00:14:05,251 --> 00:14:06,814
فِي النِّصْفِ الثَّانِي مِنْهُ؛ وَالْحُكْمُ الثَّالِثُ:

99
00:14:30,718 --> 00:14:32,273
بِقَوْلِهِ: "وَصِفَتُهُ كَقُنُوتِ النَّازِلَةِ"،

100
00:14:31,496 --> 00:14:32,273
فَفِيهِ

101
00:14:49,667 --> 00:14:51,304
أَنَّ صِفَتَهُ قُنُوتِ الْوِتْرِ كَقُنُوتِ النَّازِلَةِ،

102
00:14:50,485 --> 00:14:51,304
أَيْ

103
00:15:21,576 --> 00:15:22,667
مِنْ جِهَةِ وُقُوعِهِ بَعْدَ الرُّكُوعِ

104
00:15:51,051 --> 00:15:51,940
مِنْ جِهَةِ الأَكْمَلِ،

105
00:15:51,496 --> 00:15:51,940
وَيَجُوزُ قَبْلَهُ،

106
00:15:51,496 --> 00:15:51,940
وَهُوَ وَهُوَ

107
00:15:55,051 --> 00:15:55,940
مِنْ جِهَةِ كَوْنِهِ يَشْتَمِلُ عَلَى دُعَاءٍ،

108
00:15:55,496 --> 00:15:58,213
وَمِنْ جِهَةِ أَنَّهُ

109
00:16:04,440 --> 00:16:05,607
لَا يُسْتَحَبُّ تَطْوِيلُهُ،

110
00:16:05,023 --> 00:16:05,607
وَهَكَذَا إِلَى آخِرِ مَا تَقَدَّمَ

111
00:16:24,225 --> 00:16:26,475
مِنَ الأَحْكَامِ،

112
00:16:25,350 --> 00:16:26,475
إِلَّا

113
00:16:37,029 --> 00:16:37,886
أَنَّهُ مِمَّا يُعْلَمُ أَنَّ قُنُوتَ الْوِتْرِ يُفَارِقُ قُنُوتَ

114
00:17:06,600 --> 00:17:07,100
النَّازِلَةِ

115
00:17:12,600 --> 00:17:14,100
فِي أَصْلٍ أَصِيلٍ،

116
00:17:13,350 --> 00:17:14,100
وَهُوَ

117
00:17:22,509 --> 00:17:23,418
أَنَّ قُنُوتَ النَّازِلَةِ إِنَّمَا شُرِعَ لِوُجُودِ نَازِلَةٍ،

118
00:17:22,964 --> 00:17:23,418
فَيَتَعَلَّقُ الدُّعَاءُ فِيهِ بِهَذِهِ النَّازِلَةِ كَمَا تَقَدَّمَ،

119
00:17:22,964 --> 00:17:23,418
بِخِلَافِ قُنُوتِ الْوِتْرِ لِأَنَّهُ

120
00:17:50,691 --> 00:17:52,873
لَمْ يُشْرَعْ لِنَازِلَةٍ،

121
00:17:52,145 --> 00:17:52,873
إِذْ هُوَ قُنُوتٌ دَائِمٌ لَا قُنُوتٌ طَارِئٌ،

122
00:17:52,145 --> 00:17:52,873
فَيَكُونُ بِذَلِكَ

123
00:18:09,000 --> 00:18:10,400
الدُّعَاءُ الْمَشْرُوعُ

124
00:18:41,610 --> 00:18:42,960
فِيهِ هُوَ مُطْلَقُ الدُّعَاءِ،

125
00:18:42,360 --> 00:18:42,960
هُوَ مُطْلَقُ الدُّعَاءِ مَعَ الدُّعَاءِ،

126
00:18:42,360 --> 00:18:42,960
مَعَ دُعَاءِ الْمُسْلِمِينَ عُمُومًا وَلَعْنِ الْكَفَرَةِ،

127
00:18:42,360 --> 00:18:42,960
لِأَنَّهُ أَحَدُ مَقَاصِدِ الْقُنُوتِ،

128
00:18:42,360 --> 00:18:42,960
فَفَارَقَ النَّازِلَةَ

129
00:18:58,610 --> 00:18:59,360
مِنْ جِهَةِ سَبَبِهَا،

130
00:18:58,985 --> 00:18:59,360
فَتَرَتَّبَ

131
00:19:25,206 --> 00:19:26,283
عَلَى ذَلِكَ مُفَارَقَتُهُ

132
00:19:28,360 --> 00:19:30,360
فِي مَا

133
00:19:45,960 --> 00:19:47,560
يَخْتَصُّ بِهَا مِنَ الدُّعَاءِ،

134
00:19:46,760 --> 00:19:47,560
إِلَّا أَنَّهُ لَمْ يَخْرُجْ عَنْ اسْمِ الْقُنُوتِ،

135
00:19:46,760 --> 00:19:47,560
فَاسْتُعْمِلَ فِيهِ مَا يُسْتَعْمَلُ

136
00:19:50,360 --> 00:19:51,360
فِي الْقُنُوتِ مَعَ مُطْلَقِ الدُّعَاءِ؛ وَالْحُكْمُ الرَّابِعُ: أَنَّهُ يَقَعُ لِمُنْفَرِدٍ

137
00:19:50,860 --> 00:19:51,360
لَا

138
00:20:23,036 --> 00:20:28,388
فِي جَمَاعَةٍ،

139
00:20:25,712 --> 00:20:28,388
فَبَيَّنَ حُكْمَ التَّأْمِينِ،

140
00:20:25,712 --> 00:20:28,388
أَنَّهُ تَقَدَّمَ الْقَوْلُ أَنَّهُ يُسْتَحَبُّ التَّأْمِينُ عَلَى

141
00:21:08,140 --> 00:21:09,740
دُعَاءِ الإِمَامِ

142
00:21:36,375 --> 00:21:37,985
فِي الْقُنُوتِ،

143
00:21:37,180 --> 00:21:37,985
لَكِنْ إِذَا كَانَ الْقَانِتُ مُنْفَرِدًا،

144
00:21:37,180 --> 00:21:40,400
فَهَلْ يُؤَمِّنُ عَلَى دُعَاءِ نَفْسِهِ؟

145
00:21:39,595 --> 00:21:40,400
الصَّحِيحُ أَنَّهُ جَائِزٌ

146
00:21:50,290 --> 00:21:51,123
لَا يُسْتَحَبُّ،

147
00:21:50,707 --> 00:21:51,123
فَلَهُ أَنْ يُؤَمِّنَ عَلَى دُعَاءِ نَفْسِهِ،

148
00:21:50,707 --> 00:21:51,123
وَلَهُ أَنْ لَا يُؤَمِّنَ عَلَى دُعَاءِ نَفْسِهِ،

149
00:21:50,707 --> 00:21:51,123
فَهَذَا فَرْقٌ بَيْنَ قُنُوتِ الْوِتْرِ وَقُنُوتِ النَّازِلَةِ

150
00:22:23,270 --> 00:22:24,270
فِي الصِّفَةِ،

151
00:22:23,770 --> 00:22:24,270
وَبِهَذَا تَظْهَرُ مَسْأَلَةٌ مِمَّا يَخْفَى

152
00:22:29,770 --> 00:22:30,270
فِي

153
00:22:39,770 --> 00:22:41,270
هَذَا الْمَحَلِّ؛ قُنُوتُ الْوِتْرِ جُعِلَ مُسْتَحَبًّا فِي النِّصْفِ الثَّانِي

154
00:22:52,630 --> 00:22:53,710
مِنْ رَمَضَانَ دُونَ الأَوَّلِ،

155
00:22:53,170 --> 00:22:53,710
وَقَبْلَ

156
00:23:12,610 --> 00:23:13,150
ذَلِكَ

157
00:23:29,341 --> 00:23:31,056
تَقَدَّمَ الْقَوْلُ بِأَنَّ قُنُوتَ النَّازِلَةِ كَقُنُوتِ الْوِتْرِ

158
00:23:46,870 --> 00:23:48,270
أَيْضًا يُسْتَحَبُّ جَعْلُهُ

159
00:24:00,870 --> 00:24:02,270
بَعْدَ الرَّفْعِ

160
00:24:32,001 --> 00:24:33,308
مِنَ الرُّكُوعِ

161
00:24:43,770 --> 00:25:07,770
لَا قَبْلُ،

162
00:25:07,770 --> 00:25:08,861
وَفِي الرَّكْعَةِ الأَخِيرَةِ

163
00:25:22,539 --> 00:25:23,462
لَا قَبْلَهَا،

164
00:25:23,001 --> 00:25:23,462
فَمَا مُوجِبُ تَأْخِيرِ كُلِّ مَا يَتَعَلَّقُ بِالْقُنُوتِ؟

165
00:25:23,001 --> 00:25:23,924
يَكُونُ بَعْدَ مَا تُدْرَكُ بِهِ الرَّكْعَةُ،

166
00:25:38,199 --> 00:25:40,341
يَكُونُ فِي الرَّكْعَةِ الأَخِيرَةِ مِنْهَا،

167
00:25:39,913 --> 00:25:41,627
يَكُونُ فِي النِّصْفِ الأَخِيرِ

168
00:25:46,270 --> 00:25:47,270
مِنْ رَمَضَانَ،

169
00:25:46,770 --> 00:25:47,270
كَثِيرٌ

170
00:25:56,770 --> 00:26:18,214
مِنْ طَلَبَةِ الْعِلْمِ،

171
00:26:18,214 --> 00:26:19,437
وَجَوَابُهُ

172
00:26:38,970 --> 00:26:40,170
أَنْ يُقَالَ:

173
00:27:02,627 --> 00:27:03,484
أَنَّ مُوجِبَ التَّأْخِيرِ أَنَّ الصَّلَاةَ كُلَّ

174
00:27:09,770 --> 00:27:11,103
مَا زَادَتْ وَتَقَدَّمَتْ فِيهَا الْعَبْدُ كُلَّ

175
00:27:15,103 --> 00:27:16,437
مَا قَوِيَتْ عُبُودِيَّاتُهُ لِلَّهِ عَزَّ وَجَلَّ،

176
00:27:15,770 --> 00:27:16,437
وَلِهَذَا شُرِعَ

177
00:27:22,559 --> 00:27:23,928
فِي آخِرِ الرَّكَعَاتِ وَآخِرِ الصَّلَاةِ مَا

178
00:27:34,103 --> 00:27:35,437
لَمْ يُشْرَعْ

179
00:27:38,950 --> 00:27:40,130
فِي أَوَّلِهَا،

180
00:27:39,540 --> 00:27:41,900
فَإِنَّهُ يُشْرَعُ لِلْعَبْدِ أَنْ يَدْعُوَهُ

181
00:27:43,080 --> 00:27:44,260
فِي السُّجُودِ،

182
00:27:43,670 --> 00:27:44,260
وَيُشْرَعُ لَهُ

183
00:27:59,151 --> 00:28:00,445
أَنْ يَدْعُوَهُ بَعْدَ التَّشَهُّدِ وَقَبْلَ السَّلَامِ لِأَنَّهُ عَلَى رَجَائِهِ إِجَابَةً،

184
00:27:59,798 --> 00:28:00,445
وَمُوجِبُ ذَلِكَ

185
00:28:03,034 --> 00:28:04,328
أَنَّهُ لَمَّا قَوِيَتْ عُبُودِيَّتُهُ بِتَمَامِ عَمَلِهِ لِلَّهِ عَزَّ وَجَلَّ كَانَ

186
00:28:03,681 --> 00:28:04,328
ذَلِكَ أَحْرَى

187
00:28:16,067 --> 00:28:17,496
أَنْ يَكُونَ مُقْبِلًا عَلَى اللَّهِ عَزَّ وَجَلَّ

188
00:28:19,825 --> 00:28:20,902
فِي دُعَائِهِ بِمَا يَكُونُ مَعَ دُعَائِهِ

189
00:28:42,162 --> 00:28:43,400
هَذَا عَلَى رَجَائِهِ إِجَابَةً،

190
00:28:50,210 --> 00:28:51,386
فَهَذَا هُوَ الْحَالُ،

191
00:28:50,798 --> 00:28:51,386
فَهَذِهِ الْحَالُ الْكَمَلَةُ

192
00:29:14,210 --> 00:29:15,210
فِي الدُّعَاءِ لِلَّهِ عَزَّ وَجَلَّ،

193
00:29:14,710 --> 00:29:15,210
وَلَمَّا

194
00:29:36,010 --> 00:29:37,610
كَانَ الْقُنُوتُ نَوْعَ دُعَاءٍ كَانَ الأَفْضَلُ هُوَ تَأْخِيرَهُ،

195
00:29:36,810 --> 00:29:37,610
فَيَكُونُ بِذَلِكَ الْعَبْدُ أَقْوَى

196
00:29:44,639 --> 00:29:46,067
فِي الْعُبُودِيَّةِ لِلَّهِ عَزَّ وَجَلَّ،

197
00:29:45,353 --> 00:29:46,067
فَيَكُونُ

198
00:30:12,960 --> 00:30:14,937
ذَلِكَ أَدْعَى إِلَى تَحْصِيلِ

199
00:30:34,681 --> 00:30:35,622
مَا ذَكَرْنَا

200
00:30:39,857 --> 00:30:40,798
مِنَ الإِقْبَالِ

201
00:30:45,610 --> 00:30:47,310
عَلَى اللَّهِ عَزَّ وَجَلَّ وَرَجَائِهِ الإِجَابَةَ،

202
00:30:46,460 --> 00:30:47,310
هَذَا مَا يَتَعَلَّقُ بِمَا ذُكِرَ مِنْهُ

203
00:30:53,260 --> 00:30:54,960
مِنْ أَنْوَاعِ الْقُنُوتِ وَمَشْرُوعِيَّةِ كُلِّ نَوْعٍ مِنْهَا مَعَ صِفَتِهِ وَمَا

204
00:30:54,110 --> 00:30:54,960
يَتَعَلَّقُ بِأَحْكَامِهِ بَابٌ

205
00:31:00,460 --> 00:31:02,960
فِي قُنُوتِ الصُّبْحِ وَالْجُمُعَةِ لَمَّا فَرَغَ الْمُصَنِّفُ مِنْ ذِكْرِ مَا

206
00:31:01,710 --> 00:31:02,960
يَتَعَلَّقُ بِالْقُنُوتِ مَشْرُوعِيَّةً وَصِفَةً،

207
00:31:01,710 --> 00:31:02,960
شَرَغَ

208
00:31:06,210 --> 00:31:07,210
فِي بَيَانِ نَوْعَيْنِ خَاصَّيْنِ مِنَ الْقُنُوتِ؛ أَمَّا النَّوْعُ الأَوَّلُ: فَهُوَ

209
00:31:06,710 --> 00:31:07,210
قُنُوتُ الصُّبْحِ،

210
00:31:06,710 --> 00:31:07,210
وَمُوجِبُ اسْتِعْمَالِهِ إِفْرَادًا لَهُ دُونَ غَيْرِهِ فِي هَذَا الْمَحَلِّ أَنَّ

211
00:31:06,710 --> 00:31:07,210
قُنُوتَ الصُّبْحِ

212
00:31:11,210 --> 00:31:12,210
مِمَّا شَاعَ

213
00:31:40,499 --> 00:31:42,296
فِي الْخَلْقِ الْقَوْلُ بِأَنَّهُ مُسْتَحَبٌّ مُطْلَقًا،

214
00:31:41,398 --> 00:31:44,093
وَهُوَ أَحَدُ الأَقْوَالِ فِي

215
00:31:44,093 --> 00:31:44,992
هَذِهِ الْمَسْأَلَةِ،

216
00:31:44,093 --> 00:31:44,992
وَالْمَشْهُورُ عَنِ الشَّافِعِيَّةِ فَيَرَوْنَ أَنَّهُ يُسْتَحَبُّ لِلْعَبْدِ أَنْ يَقْنُتَ

217
00:31:59,368 --> 00:32:01,165
فِي عُمُومِ صُبْحِهِ،

218
00:32:00,266 --> 00:32:01,165
سَوَاءٌ لِوُجُودِ نَازِلَةٍ أَوْ دُونَ وُجُودِ نَازِلَةٍ،

219
00:32:00,266 --> 00:32:01,165
فَكَانَ ذَلِكَ دَاعِيًا

220
00:32:19,401 --> 00:32:20,555
إِلَى مَزِيدِ قَوْلٍ فِيهِ لِبَيَانِ

221
00:32:24,595 --> 00:32:26,326
مَا يَتَعَلَّقُ بِهِ مِنْ حُكْمِهِ،

222
00:32:25,749 --> 00:32:26,326
وَالنَّوْعُ الثَّانِي: هُوَ قُنُوتُ الْجُمُعَةِ،

223
00:32:25,749 --> 00:32:26,326
وَمُوجِبُ ذِكْرِهِ

224
00:32:40,600 --> 00:32:42,240
أَنَّ مَا تَقَدَّمَ ذِكْرُهُ مِنَ الأَحْكَامِ

225
00:33:08,425 --> 00:33:10,004
هُوَ لِنَوْعَيْنِ

226
00:33:24,910 --> 00:33:26,290
مِنَ الصَّلَوَاتِ: النَّوْعُ الأَوَّلُ: الصَّلَوَاتُ الْمَكْتُوبَاتُ،

227
00:33:25,600 --> 00:33:26,290
وَالْمُرَادُ بِهَا الْفَرَائِضُ الْخَمْسُ،

228
00:33:25,600 --> 00:33:26,290
وَالنَّوْعُ الثَّانِي: صَلَاةُ الْوِتْرِ،

229
00:33:25,600 --> 00:33:26,290
وَالنَّوْعُ الثَّانِي صَلَاةُ الْوِتْرِ،

230
00:33:25,600 --> 00:33:26,290
فَلَمْ يَتَقَدَّمِ الْقَوْلُ

231
00:33:36,953 --> 00:33:38,958
فِي صَلَاةِ الْجُمُعَةِ،

232
00:33:37,955 --> 00:33:38,958
فَاحْتِيجَ

233
00:33:53,646 --> 00:33:54,709
إِلَى الْقَوْلِ فِيهَا فِي بَابٍ مُسْتَقِلٍّ،

234
00:33:54,178 --> 00:33:54,709
طَيِّبْ؛ أَلَا يَقُولُ قَائِلٌ: قَدَّمْنَا الْقَوْلَ فِي الصَّلَوَاتِ الْمَكْتُوبَاتِ،

235
00:33:54,178 --> 00:33:54,709
فَلِمَاذَا لَا نَقُولُ الْجُمُعَةُ كَالصَّلَوَاتِ الْمَكْتُوبَاتِ؟

236
00:33:54,178 --> 00:33:54,709
يَعْنِي قِيَاسًا عَلَى الظُّهْرِ مَثَلًا،

237
00:33:54,178 --> 00:33:54,709
وَجَوَابُهُ

238
00:34:15,990 --> 00:34:19,323
أَنْ يُقَالَ: أَنَّ

239
00:34:19,323 --> 00:34:19,990
هَذَا لَيْسَ بِصَحِيحٍ،

240
00:34:19,323 --> 00:34:19,990
فَالْجُمُعَةُ تُفَارِقُ الصَّلَوَاتِ الْخَمْسَ

241
00:34:25,375 --> 00:34:26,452
فِي كَثِيرٍ

242
00:34:45,907 --> 00:34:46,990
مِنَ الأَحْكَامِ،

243
00:34:46,448 --> 00:34:46,990
فَلَيْسَ لَهَا نَفْسُ أَحْكَامِ الصَّلَوَاتِ الْخَمْسِ،

244
00:34:46,448 --> 00:34:46,990
فَلَا تُقَاسُ عَلَيْهَا إِلَّا بِدَلِيلٍ،

245
00:34:46,448 --> 00:34:46,990
وَلِهَذَا كَانَتْ عَادَةُ الصَّحَابَةِ

246
00:34:53,232 --> 00:34:54,445
إِذَا نَقَلُوا أَحْكامَ الصَّلَوَاتِ

247
00:35:00,505 --> 00:35:01,717
عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ نَقَلُوا مَا يَخُصُّ الْجُمُعَةَ

248
00:35:01,111 --> 00:35:04,142
وَحْدَهَا، وَإِنْ لَمْ تُفَارِقْ غَيْرَهَا فِي الأَحْكَامِ،

249
00:35:03,535 --> 00:35:04,142
فَرُبَّمَا شَارَكَتِ الظُّهْرَ وَالْعَصْرَ

250
00:35:10,657 --> 00:35:12,323
فِي جُمْلَةٍ

251
00:35:24,790 --> 00:35:26,390
مِنَ الأَحْكَامِ الَّتِي يَنْقُلُهَا الصَّحَابِيُّ،

252
00:35:25,590 --> 00:35:26,390
فَيَنْقُلُونَ الأَحْكَامَ مَرَّتَيْنِ: مَرَّةً فِيمَا يَتَعَلَّقُ بِالظُّهْرِ وَالْعَصْرِ،

253
00:35:25,590 --> 00:35:26,390
وَمَرَّةً فِيمَا يَتَعَلَّقُ بِالْجُمُعَةِ،

254
00:35:25,590 --> 00:35:26,390
فَالْجُمُعَةُ صَلَاةٌ مُسْتَقِلَّةٌ هُوَ الْمَشْهُورُ عَنِ الْحَنَابِلَةِ وَالْمُعْتَمَدُ عَنْ جَمَاعَةٍ

255
00:35:34,390 --> 00:35:35,990
مِنْ فُقَهَاءِ الصَّحَابَةِ كَابْنِ عُمَرَ وَغَيْرِهِ،

256
00:35:35,190 --> 00:35:35,990
فَإِذَا كَانَتْ صَلَاةً مُسْتَقِلَّةً كَانَ الْمُنَاسِبُ

257
00:35:38,390 --> 00:35:39,990
فِي حَالِئِذٍ

258
00:35:45,190 --> 00:35:46,390
أَنْ تَكُونَ لَهَا أَحْكَامُهَا الْخَاصَّةُ بِهَا،

259
00:35:45,790 --> 00:35:46,390
زِدْ عَلَى

260
00:35:55,561 --> 00:35:57,276
ذَلِكَ أَنَّهَا فِي هَذَا الْمَحَلِّ تَفْتَرِقُ

261
00:36:24,785 --> 00:36:26,203
عَنِ الصَّلَوَاتِ الْمَكْتُوبَاتِ

262
00:36:49,235 --> 00:36:50,158
فِي جُمْلَةٍ

263
00:37:16,158 --> 00:37:18,312
مِنْ أَحْكَامِ الْقُنُوتِ كَمَا سَيَأْتِي بَيَانُ طَرَفٍ مِنْ ذَلِكَ

264
00:37:33,235 --> 00:37:34,774
قَالَ الْمُصَنِّفُ حَفِظَهُ

265
00:37:58,700 --> 00:38:01,500
اللَّهُ: وَلَا يُشْرَعُ قُنُوتٌ لِغَيْرِ نَازِلَةٍ فِي الصُّبْحِ،

266
00:38:00,940 --> 00:38:01,500
وَلَا

267
00:38:11,580 --> 00:38:12,700
فِي غَيْرِهِ مِنَ الْمَكْتُوبَاتِ،

268
00:38:12,140 --> 00:38:13,820
وَلَا فِي الْجُمُعَةِ مُطْلَقًا؛ لِحُصُولِ الْمَقْصُودِ بِالدُّعَاءِ قَالَ الشَّارِحُ هَدَاهُ

269
00:38:21,896 --> 00:38:22,856
اللَّهُ: ذَكَرَ الْمُصَنِّفُ بِمَا يَتَعَلَّقُ بِهَذَا الْبَابِ ثَلَاثَةَ أَحْكَامٍ؛

270
00:38:30,530 --> 00:38:31,489
الْحُكْمُ الأَوَّلُ:

271
00:38:43,001 --> 00:38:46,231
أَنَّهُ لَا يُشْرَعُ قُنُوتٌ لِغَيْرِ نَازِلَةٍ فِي الصُّبْحِ،

272
00:38:45,783 --> 00:38:46,231
وَفِيهِ بَيَانُ أَنَّ الْقُنُوتَ الدَّائِمَ فِي الصُّبْحِ لَا يَصِحُّ شَرْعًا،

273
00:38:45,783 --> 00:38:46,231
وَالْمُرَادُ بِقَوْلِهِ: "لَا يُشْرَعُ" أَيْ لَيْسَ

274
00:38:48,918 --> 00:38:49,813
مِنَ السُّنَّةِ الْمُسْتَحَبَّةِ،

275
00:38:49,365 --> 00:38:49,813
وَإِنَّمَا يَكُونُ جَائِزًا إِذْ هُوَ

276
00:39:00,559 --> 00:39:01,455
مِنْ جِنْسِ الدُّعَاءِ

277
00:39:09,515 --> 00:39:10,410
فَيَكُونُ جَائِزًا،

278
00:39:09,962 --> 00:39:11,753
وَلَا يُحْكَمُ عَلَى فَاعِلِهِ بِالْبِدْعَةِ إِلَّا إِنْ عَمِلَهُ مُعَامَلَةَ السُّنَّةِ

279
00:39:11,306 --> 00:39:11,753
بِأَنِ اعْتَقَدَ فَضْلَهُ،

280
00:39:11,306 --> 00:39:11,753
أَوْ اعْتَادَهُ،

281
00:39:11,306 --> 00:39:11,753
أَوْ دَعَا إِلَيْهِ،

282
00:39:11,306 --> 00:39:11,753
أَوْ غَيْرَ ذَلِكَ،

283
00:39:11,306 --> 00:39:11,753
مَعَ التَّنَبُّهِ

284
00:39:31,830 --> 00:39:32,287
إِلَى

285
00:39:38,694 --> 00:39:39,609
أَنَّ الْمَسْأَلَةَ فِيهَا خِلَافٌ،

286
00:39:39,152 --> 00:39:39,609
وَالْخِلَافُ فِيهَا اجْتِهَادِيٌّ،

287
00:39:39,152 --> 00:39:39,609
فَإِذَا قَنَتَ إِمَامٌ

288
00:39:43,320 --> 00:39:46,200
فِي الصُّبْحِ دَائِمًا عَلَى اعْتِبَارِ الْقَوْلِ

289
00:40:09,700 --> 00:40:10,700
فِي ذَلِكَ عِنْدَ الشَّافِعِيَّةِ وَغَيْرِهِمْ بِاعْتِبَارِ

290
00:40:30,431 --> 00:40:31,354
مَا بَلَغَهُ

291
00:40:44,700 --> 00:41:16,300
مِنَ الْعِلْمِ لَمْ يَكُنْ ذَلِكَ سَبَبًا لِلَّوْمِ عَلَيْهِ،

292
00:41:16,300 --> 00:41:17,050
بَلْ هِيَ مَسْأَلَةٌ اجْتِهَادِيَّةٌ لَا يُنْكَرُ فِيهَا عَلَى أَحَدٍ،

293
00:41:16,300 --> 00:41:17,050
إِلَّا

294
00:41:45,810 --> 00:41:46,810
أَنَّ الرَّاجِحَ كَمَا ذَكَرْنَا أَنَّهُ لَا يَقْنُتُ

295
00:42:04,560 --> 00:42:05,810
فِي الصُّبْحِ إِلَّا لِنَازِلَةٍ،

296
00:42:05,185 --> 00:42:05,810
فَلَيْسَ هُنَاكَ قُنُوتٌ دَائِمٌ فِي الصُّبْحِ،

297
00:42:05,185 --> 00:42:05,810
وَإِنَّمَا قُنُوتٌ طَارِئٌ يَتَعَلَّقُ بِنَازِلَةٍ كَمَا تَقَدَّمَ؛ وَالْحُكْمُ الثَّانِي: فِي

298
00:42:05,185 --> 00:42:05,810
قَوْلِهِ: "وَلَا فِي غَيْرِهِ

299
00:42:09,560 --> 00:42:10,810
مِنَ الْمَكْتُوبَاتِ"،

300
00:42:10,185 --> 00:42:10,810
فَالَّذِي يَجْرِي فِي الصُّبْحِ يَجْرِي فِي غَيْرِهِ مِنَ الصَّلَوَاتِ،

301
00:42:10,185 --> 00:42:10,810
فَإِنَّ أَحَدَ الأَقْوَالِ أَيْضًا أَنَّهُ يُشْرَعُ الْقُنُوتُ دَائِمًا فِي جَمِيعِ

302
00:42:10,185 --> 00:42:10,810
الصَّلَوَاتِ، وَالصَّحِيحُ خِلَافُهُ،

303
00:42:10,185 --> 00:42:10,810
فَلَا يُشْرَعُ الْقُنُوتُ دَائِمًا لَا فِي الصُّبْحِ وَلَا فِي غَيْرِهِ،

304
00:42:10,185 --> 00:42:13,310
وَفِيمَا يَتَعَلَّقُ بِنَازِلَةٍ اسْتَدْعَتْ ذَلِكَ،

305
00:42:14,310 --> 00:42:15,097
وَتَقَدَّمَ الْقَوْلُ أَنَّ مُوجِبَ تَخْصِيصِ الصُّبْحِ بِالذِّكْرِ قَبْلَ غَيْرِهِ أَنَّهُ

306
00:42:14,310 --> 00:42:15,097
أَشْهَرُ فِي تَخْصِيصِهِ بِالْقُنُوتِ مِنَ الصَّلَوَاتِ الْمَكْتُوبَاتِ،

307
00:42:14,310 --> 00:42:15,097
فَمُرَاعَاةً لِذَلِكَ وَجَبَ التَّنْبِيهُ

308
00:42:27,680 --> 00:42:29,253
عَلَيْهِ؛ وَالْحُكْمُ الثَّالِثُ: فِي قَوْلِهِ: "وَلَا فِي الْجُمُعَةِ مُطْلَقًا؛ لِحُصُولِ

309
00:42:28,467 --> 00:42:29,253
الْمَقْصُودِ بِالدُّعَاءِ فِيهِ"،

310
00:42:28,467 --> 00:42:29,253
فَبَيَّنَ أَنَّهُ لَا يُشْرَعُ الْقُنُوتُ فِي الْجُمُعَةِ،

311
00:42:28,467 --> 00:42:29,253
وَهُوَ الصَّحِيحُ فِي هَذِهِ الْمَسْأَلَةِ،

312
00:42:28,467 --> 00:42:29,253
فَإِنَّ الْجُمُعَةَ فِيهَا مَحَلٌّ خَاصٌّ بِالدُّعَاءِ،

313
00:42:28,467 --> 00:42:29,253
وَهُوَ مَا يَكُونُ فِي آخِرِ خُطْبَةِ الإِمَامِ،

314
00:42:28,467 --> 00:42:29,253
فَإِنَّهُ يَدْعُو وَيُؤَمِّنُ الْمُؤْمِنُونَ

315
00:42:53,896 --> 00:42:55,209
عَلَى دُعَائِهِ،

316
00:42:54,552 --> 00:42:55,209
وَإِذَا كَانَ الْحَالُ كَذَلِكَ اسْتُغْنِيَ بِهَذَا الْمَحَلِّ وَلَمْ يُحْتَجْ إِلَى

317
00:42:54,552 --> 00:42:55,209
الْقُنُوتِ فِي الْجُمُعَةِ،

318
00:42:54,552 --> 00:42:55,209
وَلِهَذَا فَإِنَّ الصَّحَابَةَ لَمَّا نَقَلُوا قُنُوتَ النَّازِلَةِ لِلنَّبِيِّ صَلَّى

319
00:43:14,740 --> 00:43:15,740
اللَّهُ عَلَيْهِ وَسَلَّمَ كَمَا صَحَّ عَنْ دَاوُدَ أَوْ عِنْدَ مُسْلِمٍ

320
00:43:15,240 --> 00:43:15,740
فِي صَحِيحِهِ ذَكَرُوا أَنَّهُ قَنَتَ فِي الصَّلَوَاتِ الْخَمْسِ وَلَمْ يَذْكُرُوا

321
00:43:15,240 --> 00:43:15,740
قُنُوتَ الْجُمُعَةِ،

322
00:43:15,240 --> 00:43:15,740
وَتَقَدَّمَ الْقَوْلُ

323
00:43:44,462 --> 00:43:46,351
أَنَّ الأَصْلَ

324
00:43:53,573 --> 00:43:54,507
أَنَّ قُنُوتَ الْجُمُعَةِ بِحَاجَةٍ إِلَى ذِكْرِهِ،

325
00:43:54,040 --> 00:43:54,973
وَأَنَّهُ لَا يُقَاسُ

326
00:44:04,346 --> 00:44:05,287
عَلَى الْقُنُوتِ

327
00:44:12,840 --> 00:44:13,640
فِي الصَّلَوَاتِ الْمَكْتُوبَاتِ مِنَ الْيَوْمِ وَاللَّيْلَةِ،

328
00:44:45,193 --> 00:44:48,240
فَهَذَا مِمَّا يَنْبَغِي

329
00:44:48,240 --> 00:44:49,002
التَّنَبُّهُ إِلَيْهِ،

330
00:44:48,240 --> 00:44:49,002
لِذَلِكَ الْمُوَافِقُ عَلَى إِذْنِ الشَّرْعِ

331
00:44:58,050 --> 00:44:59,250
أَنْ يَدْعُوَ

332
00:45:04,614 --> 00:45:05,742
الْعَبْدُ فِي الْمَحَلِّ الْمَوْضُوعِ شَرْعًا لِلدُّعَاءِ،

333
00:45:05,178 --> 00:45:08,563
وَلَا يَشْغَلَ بَالَهُ بِغَيْرِهِ مِنَ الْمَحَالِّ الَّتِي لَمْ يُشْرَعْ فِيهَا

334
00:45:07,999 --> 00:45:10,255
ذَلِكَ، طَيِّبْ؛ إِنْ قَالَ قَائِلٌ: يَعْنِي الصَّلَوَاتُ الْمَكْتُوبَاتُ أَلَيْسَ فِيهَا

335
00:45:09,691 --> 00:45:10,255
سُجُودٌ وَفِيهَا جُلُوسٌ لِلتَّشَهُّدِ،

336
00:45:09,691 --> 00:45:10,255
وَهَذِهِ مَحَالُّ يُسْتَجَابُ فِيهَا الدُّعَاءُ،

337
00:45:09,691 --> 00:45:10,255
وَمَعَ هَذَا شُرِعَ فِيهَا الْقُنُوتُ،

338
00:45:09,691 --> 00:45:10,255
فَلِمَاذَا نَقُولُ

339
00:45:17,588 --> 00:45:18,717
أَنَّ وُجُودَ مَحَلٍّ لِلدُّعَاءِ فِي الْجُمُعَةِ يُغْنِي عَنِ الْقُنُوتِ،

340
00:45:18,153 --> 00:45:18,717
وَلَا نَقُولُ ذَلِكَ فِي غَيْرِهَا مِنَ الصَّلَوَاتِ؟

341
00:45:18,153 --> 00:45:18,717
وَجَوَابُهُ

342
00:45:35,461 --> 00:45:37,734
أَنْ يُقَالَ: أَنَّ هَذَا إِشْكَالٌ يُشْكِلُ

343
00:45:52,513 --> 00:45:53,650
عَلَى

344
00:46:25,484 --> 00:46:26,814
مَنْ لَمْ يُدَقِّقْ فِي الْعِلْمِ،

345
00:46:26,149 --> 00:46:26,814
وَلَا يَنْبَغِي لِطَالِبِ الْعِلْمِ

346
00:46:53,620 --> 00:46:54,626
أَنْ يَعْرِضَ إِشْكَالًا قَبْلَ

347
00:46:58,148 --> 00:46:59,154
أَنْ يُمْضِيَ عَقْلَهُ

348
00:47:05,192 --> 00:47:06,199
فِي التَّفَكُّرِ فِيهِ،

349
00:47:05,696 --> 00:47:06,199
فَإِنَّ الإِشْكَالَ سِلَاحٌ ذُو حَدَّيْنِ:

350
00:47:18,240 --> 00:47:18,740
إِمَّا

351
00:47:26,202 --> 00:47:26,971
أَنْ يَكُونَ نَافِعًا لِصَاحِبِهِ إِذَا كَانَ يُعَوِّدُهُ

352
00:47:29,681 --> 00:47:31,622
عَلَى أَنْ يُحِدَّ ذِهْنَهُ وَيُقَوِّيَ عَقْلَهُ،

353
00:47:30,651 --> 00:47:32,592
وَإِمَّا أَنْ يَكُونَ ضَارًّا بِصَاحِبِهِ إِذَا كَانَ يُلْقِي مَا يَخْطُرُ

354
00:48:03,377 --> 00:48:04,543
لَهُ مِنْ كَلَامٍ بِلَا تَفَكُّرٍ

355
00:48:10,377 --> 00:48:13,877
فِيهِ أَوْ تَأَنٍّ أَوْ بَحْثٍ يَتَعَلَّقُ بِهِ إِنْ كَانَ

356
00:48:43,160 --> 00:48:44,360
مِنْ أَهْلِ الْبَحْثِ حَسَبَ مَرْتَبَتِهِ

357
00:48:51,195 --> 00:48:52,581
فِي الْعِلْمِ،

358
00:48:51,888 --> 00:48:52,581
فَمَلَكَةُ الِاسْتِشْكَالِ

359
00:48:58,430 --> 00:49:00,430
فِي الْعِلْمِ إِنَّمَا تَكُونُ نَافِعَةً فِي الْحَالِ الأُولَى فَقَطْ إِذَا

360
00:48:59,430 --> 00:49:00,430
كَانَ الإِشْكَالُ لَهُ مَحَلٌّ فِي الْعِلْمِ،

361
00:48:59,430 --> 00:49:00,430
أَمَّا أَنْ يَسْتَشْكِلَ كُلَّ مَا يَتَّفِقُ لَهُ أَنْ يَخْطُرُ عَلَى

362
00:48:59,430 --> 00:49:00,430
بَالِهِ فَهَذَا غَلَطٌ،

363
00:48:59,430 --> 00:49:00,430
وَلِمَعَانٍ فِي الْفَائِدَةِ نَقُولُ أَنَّ جَوَابَ هَذَا الإِشْكَالِ أَنْ يُقَالَ:

364
00:48:59,430 --> 00:49:00,430
أَنَّ الْمَقْصُودَ مِنَ الْقُنُوتِ

365
00:49:13,885 --> 00:49:14,612
هُوَ حُصُولُ دُعَاءٍ مِنَ الإِمَامِ مَعَ تَأْمِينٍ مِنَ الْمَأْمُومِينَ،

366
00:49:14,248 --> 00:49:14,612
فَهَذَا الَّذِي يَخْتَصُّ بِهِ الْقُنُوتُ،

367
00:49:14,248 --> 00:49:14,612
وَهَذَا لَا يَحْصُلُ لَا

368
00:49:24,097 --> 00:49:25,430
فِي السُّجُودِ وَلَا بَعْدَ التَّشَهُّدِ وَقَبْلَ السَّلَامِ كَمَا يُعْرَفُ بِاسْمِ

369
00:49:24,763 --> 00:49:25,430
دُبُرِ الصَّلَاةِ،

370
00:49:24,763 --> 00:49:25,430
أَمَّا الْجُمُعَةُ فَإِنَّهُ يَحْصُلُ فِيهَا

371
00:49:47,490 --> 00:49:48,990
ذَلِكَ بِكَوْنِ الْخَطِيبِ يُخَاطِبُ النَّاسَ

372
00:50:04,669 --> 00:50:05,954
عَلَى الْمِنْبَرِ فَيَدْعُو فَيَسْمَعُونَهُ،

373
00:50:11,740 --> 00:50:13,002
فَهَذَا جَوَابُ الْمَسْأَلَةِ بِجَلَاءٍ،

374
00:50:12,371 --> 00:50:13,002
فَيَنْبَغِي التَّنَبُّهُ لِئَلَّا تُعْرَضَ مِثْلُ هَذِهِ الإِشْكَالَاتِ عَلَى الْعُلَمَاءِ،

375
00:50:12,371 --> 00:50:13,002
بَلْ يَتَرَوَّى صَاحِبُهَا وَيُدَقِّقُ فِيهَا أَوَّلًا بَابٌ فِي الذِّكْرِ قَبْلَ

376
00:50:12,371 --> 00:50:13,002
الْقُنُوتِ

377
00:50:39,383 --> 00:50:40,050
لَمَّا فَرَغَ الْمُصَنِّفُ

378
00:50:57,810 --> 00:50:58,810
مِنْ بَيَانِ

379
00:51:25,083 --> 00:51:26,719
مَا يَتَعَلَّقُ بِمَشْرُوعِيَّةِ الْقُنُوتِ وَصِفَتِهِ وَأَحْكَامِهِ،

380
00:51:26,174 --> 00:51:26,719
شَرَغَ

381
00:51:34,013 --> 00:51:36,217
فِي

382
00:51:55,871 --> 00:51:58,178
بَيَانِ مَا يَتَعَلَّقُ بِمَشْرُوعِيَّةِ الْقُنُوتِ

383
00:52:04,025 --> 00:52:05,102
فِي نَفْسِهِ بِمَا يَحْصُلُ بِهِ الدُّعَاءُ فِيهِ،

384
00:52:04,563 --> 00:52:05,102
فَذَكَرَ ثَلَاثَةَ أَبْوَابٍ بَعْدُ كُلُّهَا

385
00:52:25,340 --> 00:52:27,140
مِمَّا يَتَعَلَّقُ بِهَذَا الْمَعْنَى؛ فَأَوَّلُهَا: مَا يَتَقَدَّمُ دُعَاءَ الْقُنُوتِ،

386
00:52:26,240 --> 00:52:27,140
وَهُوَ الذِّكْرُ قَبْلَ دُعَاءِ الْقُنُوتِ،

387
00:52:26,240 --> 00:52:27,140
وَثَانِيهَا: مَا

388
00:52:44,452 --> 00:52:46,376
يَحْصُلُ بِهِ الْقُنُوتُ،

389
00:52:45,414 --> 00:52:46,376
وَهُوَ دُعَاءُ الْقُنُوتِ نَفْسُهُ،

390
00:52:45,414 --> 00:52:46,376
وَثَالِثُهَا:

391
00:53:17,000 --> 00:53:19,000
مَا يَأْتِي بَعْدَ دُعَاءِ الْقُنُوتِ،

392
00:53:18,000 --> 00:53:19,000
وَهُوَ التَّأْمِينُ

393
00:53:43,364 --> 00:53:44,545
عَلَى دُعَاءِ الْقُنُوتِ،

394
00:53:43,955 --> 00:53:44,545
وَهَذِهِ الأَحْكَامُ الثَّلَاثَةُ هِيَ مِمَّا يُحْتَاجُ إِلَيْهِ

395
00:53:47,500 --> 00:53:48,682
فِي التَّعَامُلِ مَعَ دُعَاءِ الْقُنُوتِ،

396
00:54:25,520 --> 00:54:27,520
نَعَمْ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَمَنْ قَنَتَ بَعْدَ الرَّفْعِ مِنَ

397
00:54:27,020 --> 00:54:27,520
الرُّكُوعِ لَازَمَهُ قَوْلُ: "رَبَّنَا وَلَكَ الْحَمْدُ" ابْتِدَاءً،

398
00:54:27,020 --> 00:54:27,520
وَلَا تَسْقُطُ بِالْقُنُوتِ لِأَنَّهَا مِنْ وَاجِبَاتِ الصَّلَاةِ،

399
00:54:27,020 --> 00:54:27,520
فَمَنْ تَرَكَهَا عَمْدًا حَتَّى فَاتَ مَحَلُّهَا بَطَلَتْ صَلَاتُهُ،

400
00:54:27,020 --> 00:54:27,520
وَمَنْ تَرَكَهَا سَهْوًا أَوْ جَهْلًا لَمْ تَبْطُلْ صَلَاتُهُ وَلَمْ تَلْزَمْهُ

401
00:54:27,020 --> 00:54:27,520
الإِعَادَةُ، وَعَلَى الأَوَّلِ سُجُودُ السَّهْوِ بِشَرْطِهِ وَصِفَتِهِ قَالَ الشَّارِحُ هَدَاهُ

402
00:54:36,520 --> 00:54:37,520
اللَّهُ: فَشَرَعَ الْمُصَنِّفُ بِذِكْرِ مَا يَتَعَلَّقُ بِمَا قَبْلَ الْقُنُوتِ،

403
00:54:37,020 --> 00:54:38,020
وَهُوَ الذِّكْرُ فِي الصَّلَاةِ الَّذِي يَتَقَدَّمُ الْقُنُوتَ،

404
00:54:37,520 --> 00:54:38,020
فَذَكَرَ

405
00:55:04,429 --> 00:55:05,702
فِيهِ خَمْسَةَ أَحْكَامٍ؛ الْحُكْمُ الأَوَّلُ: فِي قَوْلِهِ: "وَمَنْ قَنَتَ بَعْدَ

406
00:55:05,065 --> 00:55:08,247
الرَّفْعِ مِنَ

407
00:55:08,247 --> 00:55:08,884
الرُّكُوعِ لَازَمَهُ قَوْلُ رَبَّنَا وَلَكَ الْحَمْدُ"،

408
00:55:08,247 --> 00:55:08,884
فَفِيهِ بَيَانُ

409
00:55:13,338 --> 00:55:14,611
أَنَّ الذِّكْرَ الْوَاجِبَ

410
00:55:51,773 --> 00:55:52,551
فِي

411
00:56:05,554 --> 00:56:07,211
هَذَا الْمَحَلِّ لُزُومًا هُوَ قَوْلُ: "رَبَّنَا وَلَكَ الْحَمْدُ"،

412
00:56:06,383 --> 00:56:07,211
وَفِي رِوَايَةٍ: "رَبَّنَا لَكَ الْحَمْدُ"،

413
00:56:06,383 --> 00:56:07,211
فَيَنْبَغِي لِلْعَبْدِ

414
00:56:10,573 --> 00:56:11,640
أَنْ يَذْكُرَ اللَّهَ بِهَذَا الذِّكْرِ لِأَنَّهُ

415
00:56:17,507 --> 00:56:18,573
مِنْ وَاجِبَاتِ الصَّلَاةِ،

416
00:56:18,040 --> 00:56:18,573
كَمَا قَالَ الْمُصَنِّفُ: "وَلَا تَسْقُطُ بِالْقُنُوتِ لِأَنَّهَا

417
00:56:22,840 --> 00:56:23,907
مِنْ وَاجِبَاتِ الصَّلَاةِ"،

418
00:56:23,373 --> 00:56:23,907
فَفِيهِ بَيَانُ

419
00:56:31,762 --> 00:56:32,383
أَنَّ

420
00:56:39,210 --> 00:56:40,452
مِنْ وَاجِبَاتِ الصَّلَاةِ الَّتِي

421
00:56:42,934 --> 00:56:44,176
لَا تَصِحُّ الصَّلَاةُ

422
00:56:57,900 --> 00:56:59,173
إِلَّا بِهَا قَوْلُ: "رَبَّنَا وَلَكَ الْحَمْدُ" بَعْدَ الرَّفْعِ مِنَ الرُّكُوعِ،

423
00:56:58,536 --> 00:56:59,173
وَأَنَّ ذَلِكَ

424
00:57:06,173 --> 00:57:07,445
لَا يَسْقُطُ بِالْقُنُوتِ،

425
00:57:06,809 --> 00:57:07,445
وَهَذَا غَلَطٌ شَائِعٌ وَسَبَبُهُ أَنَّ الْخَلْقَ

426
00:57:48,491 --> 00:57:49,881
لَا يُكَامِلُونَ مَعَارِفَهُمْ،

427
00:57:49,310 --> 00:57:49,881
وَهَذَا غَلَطٌ شَائِعٌ،

428
00:57:49,310 --> 00:57:49,881
يَعْنِي ذَكَرْنَا فِيمَا تَقَدَّمَ

429
00:57:53,310 --> 00:57:55,596
أَنَّهُ يَنْبَغِي لِمَنْ أَرَادَ الْفِطْرَ فِي وَقْتِ الْمَغْرِبِ أَنْ يَقُولَ

430
00:57:55,024 --> 00:57:55,596
دُعَاءً

431
00:58:11,134 --> 00:58:12,722
هُوَ مِنَ الدُّعَاءِ الْخَاصِّ عِنْدَ الْفِطْرِ،

432
00:58:12,192 --> 00:58:12,722
وَأَنْ يَدْعُوَ بِذَلِكَ أَيْضًا لِمُفَطِّرِهِ،

433
00:58:12,192 --> 00:58:12,722
وَأَنْ يَدْعُوَ دُعَاءً عَامًّا،

434
00:58:12,192 --> 00:58:12,722
فَادْعُ بِمَا تُرِيدُ

435
00:58:38,088 --> 00:58:39,199
أَنْ تَدْعُوَ بِهِ

436
00:59:03,210 --> 00:59:04,610
مِمَّا يَصِحُّ الدُّعَاءُ بِهِ،

437
00:59:05,310 --> 00:59:06,310
طَيِّبْ؛ هَلْ

438
00:59:29,739 --> 00:59:31,167
لَهُ بَعْدَ هَذِهِ الأَدْعِيَةِ أَنْ يَأْكُلَ تَمْرًا أَوْ أَنْ يَشْرَبَ

439
00:59:30,453 --> 00:59:46,310
دُونَ أَنْ يَقُولَ: "بِسْمِ اللَّهِ"؟

440
00:59:46,310 --> 00:59:46,810
لَا،

441
01:00:11,977 --> 01:00:13,421
هَذَا غَلَطٌ،

442
01:00:17,762 --> 01:00:18,729
هَذَا غَلَطٌ؛ لِأَنَّ الأَكْلَ

443
01:00:27,439 --> 01:00:28,407
أَوِ الشُّرْبَ كِلَاهُمَا يَلْزَمُ لَهُ التَّسْمِيَةُ،

444
01:00:27,923 --> 01:00:28,407
وَإِنْ يَعْنِي اخْتَلَفَ الْعِلْمُ

445
01:00:38,060 --> 01:00:38,960
فِي الِاسْتِحْبَابِ أَوِ الْوُجُوبِ،

446
01:00:38,510 --> 01:00:38,960
وَالرَّاجِحُ هُوَ الْوُجُوبُ،

447
01:00:38,510 --> 01:00:38,960
لَكِنِ الَّذِي يَنْبَغِي بَيَانُهُ

448
01:00:41,548 --> 01:00:42,786
أَنَّ التَّسْمِيَةَ لَمْ تَسْقُطْ مِنْ هَذَا الْمَحَلِّ،

449
01:00:42,167 --> 01:00:42,786
وَإِنَّمَا أَغْفَلَ مَنْ تَكَلَّمَ مِنَ الْعُلَمَاءِ

450
01:00:50,834 --> 01:00:54,199
فِي الأَحْوَالِ الْمُتَعَلِّقَةِ بِالْمُفْطِرِ ذِكْرَ

451
01:00:54,199 --> 01:00:54,643
التَّسْمِيَةِ لِكَوْنِهَا شَائِعَةً مَعْرُوفَةً

452
01:01:17,719 --> 01:01:19,991
لَا تَحْتَاجُ إِلَى بَيَانٍ عَنْهَا،

453
01:01:18,855 --> 01:01:19,991
وَلِكَوْنِهَا تَحْصُلُ

454
01:01:58,490 --> 01:01:59,919
فِي كُلِّ مَحَلِّ،

455
01:01:59,204 --> 01:01:59,919
وَهُوَ إِنَّمَا يَتَكَلَّمُ عَمَّا يَخْتَصُّ بِهَذَا الْمَحَلِّ

456
01:02:05,720 --> 01:02:07,207
مِنَ الأَذْكَارِ وَالأَدْعِيَةِ،

457
01:02:06,463 --> 01:02:07,207
لَكِنْ لَا يُفْهَمُ

458
01:02:34,736 --> 01:02:35,347
مِنْ

459
01:03:00,430 --> 01:03:01,513
ذَلِكَ

460
01:03:34,876 --> 01:03:36,019
أَنَّ التَّسْمِيَةَ تَسْقُطُ،

461
01:03:35,447 --> 01:03:36,019
فَيَنْبَغِي لِلْخَلْقِ

462
01:03:43,923 --> 01:03:45,034
أَنْ يُكَامِلَ مَعَارِفَهُ،

463
01:03:44,479 --> 01:03:45,034
إِذَا عَرَفْتَ

464
01:04:02,590 --> 01:04:03,590
شَيْئًا فَلَا تُخْرِجْهُ عَمَّا تَعْرِفُهُ قَبْلُ،

465
01:04:03,090 --> 01:04:03,590
بَلِ اجْعَلْ كِلَا الْمَعْرِفَتَيْنِ اللَّتَيْنِ أَصَبْتَهُمَا بِأُخْرَى مُتَكَامِلَتَيْنِ،

466
01:04:03,090 --> 01:04:03,590
فَتَعْمَلُ بِهَذِهِ وَتِلْكَ،

467
01:04:03,090 --> 01:04:04,090
وَهَكَذَا الْعِلْمُ

468
01:04:21,076 --> 01:04:22,047
يَا إِخْوَانُ،

469
01:04:22,047 --> 01:04:23,019
يَعْنِي الْعِلْمُ لَا يَكُونُ بَعْضُهُ فِي طَرَفٍ وَبَعْضُهُ فِي طَرَفٍ

470
01:04:37,104 --> 01:04:37,590
آخَرَ،

471
01:04:55,373 --> 01:04:59,199
هَذَا لَا يَحْصُلُ،

472
01:04:58,720 --> 01:05:15,220
فَالْعِلْمُ شَيْءٌ وَاحِدٌ كُلُّهُ دِينُ اللَّهِ،

473
01:05:15,220 --> 01:05:15,765
صَدَرَ عَنْ وَاحِدٍ هُوَ النَّبِيُّ صَلَّى

474
01:05:20,675 --> 01:05:21,720
اللَّهُ عَلَيْهِ وَسَلَّمَ،

475
01:05:21,220 --> 01:05:21,720
شَرْعُهُ وَاحِدٌ هُوَ

476
01:05:27,765 --> 01:05:28,720
اللَّهُ عَزَّ وَجَلَّ،

477
01:05:28,220 --> 01:05:30,220
فَلَا يَكُونُ أَبَدًا بَعْضُهُ فِي مَحَلٍّ وَبَعْضُهُ

478
01:05:35,220 --> 01:05:36,220
فِي مَحَلٍّ

479
01:06:08,553 --> 01:06:08,887
آخَرَ

480
01:06:26,137 --> 01:06:26,970
إِلَّا لِعِلَّةٍ أَوْجَبَتْ ذَلِكَ،

481
01:06:26,553 --> 01:06:26,970
أَمَّا وَإِنْ لَمْ تَسْمَعْ بِشَيْءٍ مِنَ الْعِلَلِ الَّتِي تَجْعَلُ هَذَا

482
01:06:26,553 --> 01:06:26,970
الْمَحَلَّ يُقَالُ فِيهِ: "بِسْمِ اللَّهِ"،

483
01:06:26,553 --> 01:06:26,970
أَوْ تَجْعَلُ الْمَحَلَّ الَّذِي نَذْكُرُهُ الآنَ تَسْقُطُ مِنْهُ الأَذْكَارُ الْمُتَعَلِّقَةُ

484
01:06:26,553 --> 01:06:26,970
بِالرَّفْعِ مِنَ الرُّكُوعِ،

485
01:06:26,553 --> 01:06:26,970
فَإِنْ لَمْ تَسْمَعْ بِشَيْءٍ مِنْ هَذِهِ الْعِلَلِ الَّتِي تُسْقِطُ هَذِهِ

486
01:06:26,553 --> 01:06:26,970
الأَذْكَارَ فَمَا عَلَيْكَ مِمَّا يُصَوِّرُهُ لَكَ الشَّيْطَانُ بِأَنْ يَقُولَ: قَالَ

487
01:06:26,553 --> 01:06:26,970
أَنَا الشَّيْخُ لَمْ يَذْكُرْ كَذَا وَلَمْ يَقُلْ كَذَا،

488
01:06:26,553 --> 01:06:26,970
لَمْ يَذْكُرْهُ لِأَنَّكَ تَعْرِفُهُ،

489
01:06:26,553 --> 01:06:26,970
وَأَهْلُ الْعِلْمِ مَبْنَى عُلُومِهِمْ عَلَى الْجَمْعِ لَا عَلَى الْبَسْطِ وَالتَّطْوِيلِ،

490
01:06:26,553 --> 01:06:26,970
كَمَا يَقُولُونَ فِي الْفِقْهِ مَثَلًا،

491
01:06:26,553 --> 01:06:26,970
يَقُولُونَ: وَيَكْفِي الظَّنُّ،

492
01:06:26,553 --> 01:06:26,970
طَيِّبْ؛ لَوْ أَنَّ إِنْسَانًا كَانَ ظَنُّهُ مُشِكًّا فِيمَا يَكْفِيهِ،

493
01:06:26,553 --> 01:06:26,970
لَا يَكْفِيهِ فِي شَيْءٍ،

494
01:06:26,553 --> 01:06:26,970
لَا يَكْفِيهِ فِي شَيْءٍ،

495
01:06:26,553 --> 01:06:26,970
وَإِنَّمَا الَّذِي يَكْفِي الظَّنُّ الْغَالِبُ،

496
01:06:26,553 --> 01:06:26,970
الظَّنُّ الْغَالِبُ،

497
01:06:26,553 --> 01:06:26,970
طَيِّبْ؛ لِمَاذَا لَمْ يُعَبِّرُوا بِقَوْلِهِمُ: "الْغَالِبُ"؟

498
01:06:26,553 --> 01:06:28,220
لَمْ يَحْتَاجُوا إِلَيْهِ لِأَنَّهُ مَعْرُوفٌ،

499
01:06:27,803 --> 01:06:28,220
فَمَا الدَّاعِي إِلَى قَوْلِنَا: "الظَّنُّ الْغَالِبُ" إِذَا كُنْتَ تَعْرِفُ أَنَّ

500
01:06:27,803 --> 01:06:28,220
الظَّنَّ الْمُعْتَدَّ بِهِ هُوَ الظَّنُّ الْغَالِبُ؟

501
01:06:27,803 --> 01:06:28,220
كَذَا عِنْدَ عُلَمَاءِ الِاعْتِقَادِ تَجِدُهُمْ يَقُولُونَ: الشِّرْكُ الأَكْبَرُ هُوَ مَا

502
01:06:27,803 --> 01:06:28,220
أَخَلَّ بِأَصْلِ الإِيمَانِ،

503
01:06:27,803 --> 01:06:28,220
وَالشِّرْكُ الأَصْغَرُ هُوَ مَا أَخَلَّ بِكَمَالِ الإِيمَانِ،

504
01:06:27,803 --> 01:06:28,220
طَيِّبْ؛ يَأْتِيكَ قَائِلٌ فَيَقُولُ: الآنَ هُنَاكَ مُسْتَحَبَّاتٌ فِي الإِيمَانِ فَإِذَا

505
01:06:27,803 --> 01:06:28,220
تَرَكْتَهَا أَخْلَلْتَ بِكَمَالِ الإِيمَانِ،

506
01:06:27,803 --> 01:06:28,220
فَكَيْفَ أَكُونُ مُشْرِكًا شِرْكًا أَصْغَرَ؟

507
01:06:27,803 --> 01:06:28,220
هَذَا جَاهِلٌ،

508
01:06:27,803 --> 01:06:28,220
هَذَا مِنْ جَهْلِهِ لَمْ يَعْرِفْ لُغَةَ الْعِلْمِ،

509
01:06:27,803 --> 01:06:28,220
وَإِنَّمَا الَّذِي يَشْرَبُ الْعِلْمَ فِي قَلْبِهِ يَقُولُ: أَنَّ كَمَالَ الإِيمَانِ

510
01:06:27,803 --> 01:06:28,220
الْمُرَادَ فِي هَذَا الْمَحَلِّ هُوَ كَمَالُ الإِيمَانِ الْوَاجِبُ،

511
01:06:27,803 --> 01:06:28,220
كَمَالُ الإِيمَانِ الْوَاجِبُ،

512
01:06:27,803 --> 01:06:28,220
فَيَكُونُ حَالًا إِذَنْ إِذَا تَرَكَهُ الْعَبْدُ فَقَدْ فَرَّطَ فِي وَاجِبٍ

513
01:06:27,803 --> 01:06:28,220
إِنَّمَا يَتَعَلَّقُ بِالإِيمَانِ،

514
01:06:27,803 --> 01:06:28,220
فَلَمَّا تَعَلَّقَ بِكَمَالِهِ كَانَ شِرْكًا أَصْغَرَ،

515
01:06:27,803 --> 01:06:28,220
فَتَبَيَّنَ مِنْ هَذَا أَنَّ عَدَمَ قَوْلِهِمُ: "الْوَاجِبُ" لَا يَعْنِي أَنَّهُ

516
01:06:27,803 --> 01:06:28,220
لَيْسَ وَاجِبًا،

517
01:06:27,803 --> 01:06:28,220
هُوَ وَاجِبٌ لَكِنَّهُمُ اخْتَصَرُوا الْعِبَارَةَ،

518
01:06:27,803 --> 01:06:28,220
وَهَذَا الْقَيْدُ لِلْعِلْمِ بِهِ دُونَ الْحَاجَةِ إِلَى بَيَانِهِ،

519
01:06:27,803 --> 01:06:28,220
فَهَذَا أَصْلٌ يَنْبَغِي أَنْ يُعْتَنَى بِهِ؛ وَالْحُكْمُ الثَّانِي: فِي قَوْلِهِ:

520
01:06:27,803 --> 01:06:28,220
"فَمَنْ تَرَكَهَا عَمْدًا حَتَّى فَاتَ مَحَلُّهَا بَطَلَتْ صَلَاتُهُ"،

521
01:06:27,803 --> 01:06:28,220
وَفِيهِ بَيَانُ أَنَّ تَرْكَ وَاجِبَاتِ الصَّلَاةِ عَمْدًا مُبْطِلٌ لَهَا،

522
01:06:27,803 --> 01:06:28,220
وَمِنْهُ تَرْكُ قَوْلِ: "رَبَّنَا وَلَكَ الْحَمْدُ" مِمَّا يُنْبِئُ عَنْ أَهَمِّيَّتِهِ،

523
01:06:27,803 --> 01:06:28,220
وَفِيهِ أَنْ يَعْتَنِيَ الْعَبْدُ بِمَعْرِفَةِ أَحْوَالِ الصَّلَاةِ لِأَنَّ هَذَا الْغَلَطَ

524
01:06:27,803 --> 01:06:28,220
الَّذِي أَنْبَأْنَا قَبْلَ قَلِيلٍ بِكَوْنِهِ مُتَكَرِّرًا وَشَائِعًا فِي الْخَلْقِ مُبْطِلٌ

525
01:06:27,803 --> 01:06:28,220
لِلصَّلَاةِ، فَهَذَا مِمَّا يَنْبَغِي التَّنَبُّهُ لَهُ،

526
01:06:27,803 --> 01:06:28,220
وَإِنْ كَانَتِ الْمَسْأَلَةُ فِيهَا خِلَافٌ لَكِنَّ الإِنْسَانَ لَا يُعَرِّضُ نَفْسَهُ

527
01:06:27,803 --> 01:06:28,220
لِمِثْلِ هَذَا،

528
01:06:27,803 --> 01:06:28,220
فَيَنْبَغِي لَهُ أَلَّا يُخْلِيَ نَفْسَهُ مِنْ شَيْءٍ مِنْ ذَلِكَ،

529
01:06:27,803 --> 01:06:28,220
أَيْ أَلَّا يُخْلِيَ نَفْسَهُ مِنْ شَيْءٍ مِنْ تَعَلُّمِ أَحْكَامِ الصَّلَاةِ،

530
01:06:27,803 --> 01:06:28,220
وَلَوْ كَانَ يَأْخُذُ بِالْقَوْلِ بِكَوْنِ "رَبَّنَا وَلَكَ الْحَمْدُ" فِي هَذَا

531
01:06:27,803 --> 01:06:28,220
الْمَحَلِّ سُنَّةً فَإِنَّهُ لَا يُفَوِّتُ سُنَّةً،

532
01:06:27,803 --> 01:06:28,220
يَعْنِي يَا أَخِي أَنْتَ الآنَ تَأْتِي بِالْقُنُوتِ وَهَذَا الْقُنُوتُ سُنَّةٌ،

533
01:06:27,803 --> 01:06:28,220
إِذَا أَتَيْتَ بِالْقُنُوتِ كَوْنُهُ سُنَّةً،

534
01:06:27,803 --> 01:06:28,220
طَيِّبْ؛ أَذْكَارُ الصَّلَاةِ الَّتِي هِيَ أَصْلًا مِنْهَا أَوْلَى مِمَّا هُوَ

535
01:06:27,803 --> 01:06:28,220
طَارِئٌ عَلَيْهَا وَهُوَ الْقُنُوتُ،

536
01:06:27,803 --> 01:06:28,220
أَوْلَى مِمَّا هُوَ طَارِئٌ عَلَيْهَا وَهُوَ الْقُنُوتُ،

537
01:06:27,803 --> 01:06:28,220
فَإِذَا كَانَ الأَمْرُ وَلَوْ سُنَّةً فَعَلَيْكَ أَنْ تَلْزَمَهُ لِتَنْفَعَ نَفْسَكَ؛

538
01:06:27,803 --> 01:06:28,220
وَالْحُكْمُ الثَّالِثُ: فِي قَوْلِهِ: "وَمَنْ تَرَكَهَا سَهْوًا أَوْ جَهْلًا لَمْ

539
01:06:27,803 --> 01:06:28,220
تَبْطُلْ وَلَمْ تَلْزَمْهُ الإِعَادَةُ"،

540
01:06:27,803 --> 01:06:28,220
فَفِيهِ بَيَانُ أَنَّ مَنْ نَسِيَ قَوْلَ: "رَبَّنَا وَلَكَ الْحَمْدُ" أَوْ

541
01:06:27,803 --> 01:06:28,220
لَمْ يَعْلَمْ بِوُجُوبِهَا أَصْلًا فَتَرَكَهَا لَمْ تَبْطُلْ صَلَاتُهُ إِذْ لَمْ

542
01:06:27,803 --> 01:06:28,220
يَتَعَمَّدْ ذَلِكَ،

543
01:06:27,803 --> 01:06:28,220
وَالْوَاجِبَاتُ الَّتِي تُسَامَحُ فِيهَا دُونَ الأَرْكَانِ،

544
01:06:27,803 --> 01:06:28,220
وَالْفَرْقُ بَيْنَهُمَا عِنْدَ أَهْلِ الْفِقْهِ؛ وَالْحُكْمُ الْخَامِسُ: فِي قَوْلِهِ: "وَلَمْ

545
01:06:27,803 --> 01:06:28,220
تَلْزَمْهُ الإِعَادَةُ" لِكَوْنِهِ لَمْ تَبْطُلْ صَلَاتُهُ،

546
01:06:27,803 --> 01:06:28,220
فَهُوَ قَدْ صَلَّى أَدَّى مَا عَلَيْهِ لِلَّهِ عَزَّ وَجَلَّ،

547
01:06:27,803 --> 01:06:28,220
فَأَسْقَطَتْ تِلْكَ الصَّلَاةُ مَا تَعَلَّقَ بِذِمَّتِهِ مِنَ الْوُجُوبِ فَلَمْ تَلْزَمْهُ

548
01:06:27,803 --> 01:06:28,220
الإِعَادَةُ؛ وَالْحُكْمُ الْخَامِسُ: فِي قَوْلِهِ: "عَلَى الأَوَّلِ سُجُودٌ لِلسَّهْوِ بِشَرْطِهِ

549
01:06:27,803 --> 01:06:28,220
وَصِفَتِهِ"، وَالْمُرَادُ بِالأَوَّلِ أَيْ مَنْ تَرَكَهَا سَهْوًا،

550
01:06:27,803 --> 01:06:28,220
فَقَالَ عَلَيْهِ سُجُودٌ لِلسَّهْوِ،

551
01:06:27,803 --> 01:06:28,220
وَسَجْدَتَانِ فِي الصَّلَاةِ لِلسَّهْوِ رُبَّمَا عَرَضَ لِلإِنْسَانِ نَقْصٌ فِي الصَّلَاةِ

552
01:06:27,803 --> 01:06:28,220
أَوْ زِيَادَةٌ فِيهَا أَوْ شَكٌّ أَوْ غَيْرُ ذَلِكَ مِمَّا يَذْكُرُهُ

553
01:06:27,803 --> 01:06:28,220
الْفُقَهَاءُ مِمَّا يَرْجِعُ إِلَى هَذِهِ الثَّلَاثَةِ،

554
01:06:27,803 --> 01:06:28,220
فَقَالُوا عَلَيْهِ سُجُودٌ لِلسَّهْوِ بِشَرْطِهِ وَصِفَتِهِ،

555
01:06:27,803 --> 01:06:28,220
وَشُرُوطُ سُجُودِ السَّهْوِ هِيَ الَّتِي يُشْرَعُ لَهَا السَّهْوُ،

556
01:06:27,803 --> 01:06:28,220
هِيَ أَسْبَابُ مَشْرُوعِيَّاتِهِ،

557
01:06:27,803 --> 01:06:28,220
هِيَ الزِّيَادَةُ وَالنَّقْصُ وَالشَّكُّ،

558
01:06:27,803 --> 01:06:28,220
وَصِفَتُهُ هِيَ صِفَتُهُ الْمَعْرُوفَةُ عِنْدَهَا،

559
01:06:27,803 --> 01:06:28,220
وَصَفَهَا الْفُقَهَاءُ بِكَوْنِهِ قَبْلَ السَّلَامِ أَوْ بَعْدَهُ فِي مَوَاضِعَ مُبَيَّنَةٍ

560
01:06:27,803 --> 01:06:28,220
فِي كُتُبِ الْفِقْهِ الْمُطَوَّلَةِ،

561
01:06:27,803 --> 01:06:28,220
وَكَوْنِهِ ذَا ذِكْرٍ وَقَوْلِهِ "سُبْحَانَ رَبِّيَ الأَعْلَى" وَسَجْدَتَيْنِ وَهُمَا نَظِيرُ

562
01:06:27,803 --> 01:06:28,220
السَّجْدَتَيْنِ الْمَعْرُوفَتَيْنِ إِلَى آخِرِ الْمَعْرُوفِ فِي الأَحْكَامِ الْمُتَعَلِّقِةِ بِسُجُودِ السَّهْوِ

563
01:06:27,803 --> 01:06:28,220
بَابٌ فِي دُعَاءِ الْقُنُوتِ،

564
01:06:27,803 --> 01:06:28,220
بَابٌ فِي دُعَاءِ الْقُنُوتِ لَمَّا فَرَغَ الْمُصَنِّفُ فِي ذِكْرِ مَا

565
01:06:27,803 --> 01:06:28,220
يَتَعَلَّقُ بِالْقُنُوتِ مِنَ الدُّعَاءِ،

566
01:06:27,803 --> 01:06:28,220
فَقَدْ بَدَأَ أَوَّلًا الْكَلَامَ عَلَى الذِّكْرِ قَبْلَ الْقُنُوتِ،

567
01:06:27,803 --> 01:06:28,220
وَأَنْبَهَ فِيهِ إِلَى خَطَأٍ شَائِعٍ يَتَعَلَّقُ بِهِ،

568
01:06:27,803 --> 01:06:28,220
وَالآنَ يَشْرَعُ فِي بَيَانِ مَا يَتَعَلَّقُ بِدُعَاءِ الْقُنُوتِ،

569
01:06:27,803 --> 01:06:28,220
نَعَمْ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَيَدْعُو لِلْمُسْلِمِينَ،

570
01:06:27,803 --> 01:06:28,220
وَيَلْعَنُ لِلْكَفَرَةِ بِمَا وَرَدَتْهُ وَهُوَ أَكْمَلُ،

571
01:06:27,803 --> 01:06:28,220
أَوْ بِغَيْرِهِ،

572
01:06:27,803 --> 01:06:28,220
وَلَا يَلْزَمُهُ لَفْظٌ بِعَيْنِهِ اتِّفَاقًا،

573
01:06:27,803 --> 01:06:28,220
وَالأَفْضَلُ أَنْ يَجْعَلَ آخِرَ قُنُوتِهِ الصَّلَاةَ عَلَى النَّبِيِّ صَلَّى اللَّهُ

574
01:06:27,803 --> 01:06:28,220
عَلَيْهِ وَسَلَّمَ قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: فَذَكَرَ الْمُصَنِّفُ فِي هَذِهِ

575
01:06:27,803 --> 01:06:28,220
الْجُمْلَةِ أَرْبَعَةَ أَحْكَامٍ؛ الْحُكْمُ الأَوَّلُ: فِي قَوْلِهِ: "وَدَعَا لِلْمُسْلِمِينَ وَيَلْعَنُ

576
01:06:27,803 --> 01:06:28,220
الْكَفَرَةَ بِمَا وَرَدَ وَهُوَ أَكْمَلُ أَوْ بِغَيْرِهِ"،

577
01:06:27,803 --> 01:06:28,220
فَفِيهِ أَنَّ الدُّعَاءُ يَكُونُ لِلْمُسْلِمِينَ وَيَكُونُ بِلَعْنِ الْكَفَرَةِ،

578
01:06:27,803 --> 01:06:28,220
هَذَا هُوَ الأَصْلُ فِي الْقُنُوتِ أَنَّهُ يَكُونُ لِلدُّعَاءِ لِلْمُسْلِمِينَ وَلَعْنِ

579
01:06:27,803 --> 01:06:28,220
الْكَفَرَةِ، وَأَنَّهُ يَقَعُ بِمَا وَرَدَ أَيْ عَنِ النَّبِيِّ صَلَّى اللَّهُ

580
01:06:27,803 --> 01:06:28,220
عَلَيْهِ وَسَلَّمَ مَنْ بَعْدَهُ مِنَ الصَّحَابَةِ وَالتَّابِعِينَ،

581
01:06:27,803 --> 01:06:28,220
أَوْ بِغَيْرِهِ أَيْ مِمَّا صَحَّ مَعْنَاهُ وَجَازَ الدُّعَاءُ بِهِ،

582
01:06:27,803 --> 01:06:28,220
وَالأَوَّلُ أَكْمَلُ،

583
01:06:27,803 --> 01:06:28,220
فَالدَّاعِي فِي الْقُنُوتِ لَهُ حَالَانِ اثْنَتَانِ: الْحَالُ الأُولَى: أَنْ يَدْعُوَ

584
01:06:27,803 --> 01:06:28,220
بِمَا وَرَدَ،

585
01:06:27,803 --> 01:06:28,220
وَهَذِهِ الْحَالُ الْكَمَلَةُ،

586
01:06:27,803 --> 01:06:28,220
وَأَجْرُ كَمَالِهَا أَنَّ أَحَبَّ الْكَلَامِ إِلَى اللَّهِ كَلَامُ نَبِيِّهِ،

587
01:06:27,803 --> 01:06:28,220
وَأَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ كَانَ يَتَخَيَّرُ مِنَ الدُّعَاءِ

588
01:06:27,803 --> 01:06:28,220
أَجْمَعَهُ كَمَا صَحَّ عَنْ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا فَإِنَّهُ كَانَ

589
01:06:27,803 --> 01:06:28,220
يُحِبُّ الدُّعَاءَ قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: الْجَامِعُ أَيْ الَّذِي تَقِلُّ

590
01:06:27,803 --> 01:06:28,220
مَبَانِيهِ وَتَكْثُرُ مَعَانِيهِ يَكُونُ أَعْظَمَ وَأَبْلَغَ،

591
01:06:27,803 --> 01:06:28,220
فَيَكُونُ بِذَلِكَ أَحْرَى أَنْ يُدْعَى بِهِ وَأَرْجَى أَنْ يُجَابَ،

592
01:06:27,803 --> 01:06:28,220
وَكَذَا أَنَّهُ أَبْعَدُ عَنِ الْغَلَطِ الشَّائِعِ عِنْدَ كَثِيرٍ مِنَ الْخَلْقِ

593
01:06:27,803 --> 01:06:28,220
فِي دُعَائِهِمْ،

594
01:06:27,803 --> 01:06:28,220
وَأَبْعَدُ عَنْ صُوَرِ الِاعْتِدَاءِ الْمَكْرُوهَةِ أَوِ الْمُحَرَّمَةِ الَّتِي ضَرَبَتْ فِي

595
01:06:27,803 --> 01:06:28,220
الْأَرْضِ بِأَطْنَابِهَا فِي الْخَلْقِ؛ فَهَذَا مِمَّا يَنْبَغِي أَنْ يُعْلَمَ أَنَّ

596
01:06:27,803 --> 01:06:28,220
دُعَاءَهُمْ مُقَدَّمٌ عَلَى دُعَاءِ غَيْرِهِمْ،

597
01:06:27,803 --> 01:06:28,220
أَيْ: دُعَاءُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَأَصْحَابِهِ مُقَدَّمٌ عَلَى

598
01:06:27,803 --> 01:06:28,220
دُعَاءِ مَنْ تَلَاهُمْ،

599
01:06:27,803 --> 01:06:28,220
وَإِذَا كَانَ الْأَمْرُ كَذَلِكَ كَانَ الْمُلَائِمُ حِينَئِذٍ أَنْ يُقَالَ: إِنَّهُ

600
01:06:27,803 --> 01:06:28,220
يَنْبَغِي إِذَا عَلِمْتَ هَذَا الْمَعْنَى أَنْ تَسْعَى فِي تَعَلُّمِ الْأَدْعِيَةِ

601
01:06:27,803 --> 01:06:28,220
النَّبَوِيَّةِ وَمَا نُقِلَ عَنْ جَمَاعَةٍ مِنَ الْعُلَمَاءِ فِي هَذَا الْبَابِ

602
01:06:27,803 --> 01:06:28,220
مِنَ الْأَدْعِيَةِ مِمَّا يَحْسُنُ بِكَ أَنْ تَتَعَلَّمَهُ،

603
01:06:27,803 --> 01:06:28,220
وَإِلَّا فَقَعْتَ فِي الدُّعَاءِ بِمَا اعْتَدْتَهُ أَوْ سَمِعْتَهُ أَوْ أَعْجَبَكَ

604
01:06:27,803 --> 01:06:28,220
فِي كِتَابٍ أَوْ فِي قَوْلِ قَائِلٍ،

605
01:06:27,803 --> 01:06:28,220
هَذَا كُلُّهُ يَفُوتُ بِهِ مِمَّا ذَكَرْنَا مِنَ الْفَضَائِلِ،

606
01:06:27,803 --> 01:06:28,220
مِمَّا كَوْنُهُ يَجْعَلُكَ عُرْضَةً لِضَيَاعِ الصَّحِيحِ فِي دُعَائِكَ بِخَلْطِهِ بِغَيْرِهِ

607
01:06:27,803 --> 01:06:28,220
مِنَ الْبَاطِلِ مِمَّا يُوقِعُ الِاعْتِدَاءَ فِي هَذَا الدُّعَاءِ وَيَجْعَلُهُ مِنَ

608
01:06:27,803 --> 01:06:28,220
الْغَلَطِ، فَلْيُتَنَبَّهْ.

609
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَشَرْطُهُ أَنْ يَكُونَ مِمَّا يَصِحُّ الدُّعَاءُ

610
01:06:27,803 --> 01:06:28,220
بِهِ وَيَجُوزُ.

611
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَالْحَالُ الثَّانِيَةُ: أَنْ تَدْعُوَ بِغَيْرِهِ،

612
01:06:27,803 --> 01:06:28,220
وَشَرْطُهُ أَنْ يَكُونَ مِمَّا يَصِحُّ الدُّعَاءُ بِهِ وَيَجُوزُ،

613
01:06:27,803 --> 01:06:28,220
وَلَا يَكُونُ ذَلِكَ إِلَّا لِمَنْ طَلَبَ قَدْرًا مِنَ الْعِلْمِ،

614
01:06:27,803 --> 01:06:28,220
فَبَلَغَ فِيهِ أَنَّهُ يُمَيِّزُ هَذِهِ الْأَدْعِيَةَ؛ فَإِنَّ كَثِيرًا مِنَ الْأَدْعِيَةِ

615
01:06:27,803 --> 01:06:28,220
ظَاهِرُهُ أَنَّهُ يَصْلُحُ لِلدُّعَاءِ بِهِ،

616
01:06:27,803 --> 01:06:28,220
فَيَنْبَغِي لِلْعَبْدِ أَنْ لَا يُعَرِّضَ نَفْسَهُ لِهَذَا كَمَا قَدَّمَهُ،

617
01:06:27,803 --> 01:06:28,220
فَادْعُ بِالْوَارِدِ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

618
01:06:27,803 --> 01:06:28,220
أَوْ مَا سَمِعْتَهُ مِنْ عَالِمٍ،

619
01:06:27,803 --> 01:06:28,220
وَنَحْوِ ذَلِكَ،

620
01:06:27,803 --> 01:06:28,220
وَلَا تَدْعُ بِغَيْرِهِ،

621
01:06:27,803 --> 01:06:28,220
وَإِنْ كَانَ جَائِزًا إِلَّا أَنَّكَ تَجْتَنِبُهُ مَا لَمْ تَطْمَئِنَّ إِلَى

622
01:06:27,803 --> 01:06:28,220
صِحَّتِهِ بِقَوْلِ عَالِمٍ،

623
01:06:27,803 --> 01:06:28,220
أَوْ طَالِبِ عِلْمٍ مُجْتَهِدٍ،

624
01:06:27,803 --> 01:06:28,220
وَغَيْرِهِمَا مِمَّنْ يَكُونُ لَهُ بَاعٌ فِي هَذَا.

625
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَلَا يَلْزَمُهُ لَفْظٌ بِعَيْنِهِ اتِّفَاقًا.

626
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَالْحُكْمُ الثَّانِي فِي قَوْلِهِ: «وَلَا يَلْزَمُهُ

627
01:06:27,803 --> 01:06:28,220
لَفْظٌ بِعَيْنِهِ اتِّفَاقًا»،

628
01:06:27,803 --> 01:06:28,220
وَمِمَّا يُنَبَّهُ إِلَيْهِ هُنَا أَنَّ دُعَاءَ الْقُنُوتِ الْمَشْهُورَ عَنِ الْحَسَنِ

629
01:06:27,803 --> 01:06:28,220
بْنِ عَلِيِّ بْنِ أَبِي طَالِبٍ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ

630
01:06:27,803 --> 01:06:28,220
وَسَلَّمَ، أَنْ يُقَالَ: [اللَّهُمَّ اهْدِنَا فِيمَنْ هَدَيْتَ،

631
01:06:27,803 --> 01:06:28,220
وَعَافِنَا فِيمَنْ عَافَيْتَ]،

632
01:06:27,803 --> 01:06:28,220
أَنَّهُ لَا يَصِحُّ تَعْلِيقُهُ بِالْقُنُوتِ؛ فَإِنَّ الزِّيَادَةَ الَّتِي فِيهَا أَنَّ

633
01:06:27,803 --> 01:06:28,220
النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمَّا عَلَّمَ هَذَا الدُّعَاءَ لِلْحَسَنِ،

634
01:06:27,803 --> 01:06:28,220
قَالَ: [قُلْ فِي قُنُوتِ الْوِتْرِ كَذَا وَكَذَا]،

635
01:06:27,803 --> 01:06:28,220
فَهَذِهِ الزِّيَادَةُ فِي قُنُوتِ الْوِتْرِ لَا تَصِحُّ،

636
01:06:27,803 --> 01:06:28,220
ذَكَرَهُ [الدَّارَقُطْنِيُّ] وَغَيْرُهُ،

637
01:06:27,803 --> 01:06:28,220
زِيَادَةٌ ضَعِيفَةٌ،

638
01:06:27,803 --> 01:06:28,220
وَهَذَا مِمَّا أَلْجَأَ جَمَاعَةً مِنَ الْعُلَمَاءِ إِلَى الْقَوْلِ بِأَنَّهُ لَا

639
01:06:27,803 --> 01:06:28,220
يَصِحُّ شَيْءٌ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي أَدْعِيَةِ

640
01:06:27,803 --> 01:06:28,220
قُنُوتِ الْوِتْرِ،

641
01:06:27,803 --> 01:06:28,220
ذَكَرَهُ جَمَاعَةٌ مِنْهُمْ [أَبُو عُمَرَ بْنُ عَبْدِ الْبَرِّ]،

642
01:06:27,803 --> 01:06:28,220
فَيُعْلَمُ بِهَذَا أَنَّهُ لَا يَصِحُّ شَيْءٌ فِي الدُّعَاءِ فِي الْقُنُوتِ،

643
01:06:27,803 --> 01:06:28,220
فَإِذَا كَانَ الْأَمْرُ كَذَلِكَ،

644
01:06:27,803 --> 01:06:28,220
كَانَ لِلْعَبْدِ أَنْ يَدْعُوَ كَيْفَمَا شَاءَ،

645
01:06:27,803 --> 01:06:28,220
وَنَقَلَ [النَّوَوِيُّ] رَحِمَهُ اللَّهُ عَنْ جَمَاعَةِ أَهْلِ الْعِلْمِ أَنَّهُ لَا

646
01:06:27,803 --> 01:06:28,220
يَلْزَمُهُ لَفْظٌ بِعَيْنِهِ فِي الْقُنُوتِ،

647
01:06:27,803 --> 01:06:28,220
أَيْ: فِي دُعَاءِ الْقُنُوتِ.

648
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَالْأَفْضَلُ أَنْ يَجْعَلَ قُنُوتَ عُمَرَ آخِرَ

649
01:06:27,803 --> 01:06:28,220
قُنُوتِهِ. قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَالْحُكْمُ الثَّالِثُ فِي قَوْلِهِ: «وَالْأَفْضَلُ

650
01:06:27,803 --> 01:06:28,220
أَنْ يَجْعَلَ قُنُوتَ عُمَرَ آخِرَ قُنُوتِهِ»،

651
01:06:27,803 --> 01:06:28,220
وَقُنُوتُ عُمَرَ وَمَا صَحَّ عَنْهُ رَضِيَ اللَّهُ عَنْهُ فِي قُنُوتِهِ

652
01:06:27,803 --> 01:06:28,220
بِالصَّحَابَةِ، أَنَّهُ قَنَتَ بِهِ،

653
01:06:27,803 --> 01:06:28,220
وَجْهُ جَعْلِهِ فِي الْقُنُوتِ أَنَّهُ دُعَاءٌ جَامِعٌ،

654
01:06:27,803 --> 01:06:28,220
هُوَ مِنْ دُعَاءِ أَحَدِ الْخُلَفَاءِ الرَّاشِدِينَ،

655
01:06:27,803 --> 01:06:28,220
وَقَدْ أُمِرْنَا بِاتِّبَاعِ سُنَّتِهِمْ،

656
01:06:27,803 --> 01:06:28,220
كَمَا صَحَّ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: [عَلَيْكُمْ بِسُنَّتِي

657
01:06:27,803 --> 01:06:28,220
وَسُنَّةِ الْخُلَفَاءِ الرَّاشِدِينَ الْمَهْدِيِّينَ مِنْ بَعْدِي]،

658
01:06:27,803 --> 01:06:28,220
رَوَاهُ [مُسْلِمٌ] عَنِ [الْعِرْبَاضِ بْنِ سَارِيَةَ]،

659
01:06:27,803 --> 01:06:28,220
فَفِيهِ أَنَّنَا أُمِرْنَا بِاتِّبَاعِ سُنَّةِ الْخُلَفَاءِ الرَّاشِدِينَ،

660
01:06:27,803 --> 01:06:28,220
وَمِنْهُمْ عُمَرُ بْنُ الْخَطَّابِ،

661
01:06:27,803 --> 01:06:28,220
فَيَكُونُ الْمُنَاسِبُ حِينَئِذٍ أَنْ نَقْتَفِيَ بِأَثَرِهِ فِي الْقُنُوتِ،

662
01:06:27,803 --> 01:06:28,220
فَنَدْعُوَ بِدُعَائِهِ،

663
01:06:27,803 --> 01:06:28,220
وَأَمَّا جَعْلُهُ فِي آخِرِ الْقُنُوتِ،

664
01:06:27,803 --> 01:06:28,220
فَهُوَ لِمُوجِبِ مَا ذَكَرْنَا قَبْلَهُ أَنَّ الْعَبْدَ يَنْبَغِي لَهُ أَنْ

665
01:06:27,803 --> 01:06:28,220
يَعْلَمَ أَنَّ آخِرَ الْقُنُوتِ أَفْضَلُ مِنْ أَوَّلِهِ،

666
01:06:27,803 --> 01:06:28,220
وَأَنَّ آخِرَ الصَّلَاةِ أَفْضَلُ مِنْ أَوَّلِهَا،

667
01:06:27,803 --> 01:06:28,220
وَأَنَّ آخِرَ الرَّكْعَةِ أَفْضَلُ مِنْ أَوَّلِهَا،

668
01:06:27,803 --> 01:06:28,220
إِلَى آخِرِ مَا قَدَّمْنَا الْقَوْلَ فِيهِ،

669
01:06:27,803 --> 01:06:28,220
وَيَكُونُ أَنْفَعَ لَهُ وَأَجْمَعَ لِقَلْبِهِ وَأَقْوَى لِعُبُودِيَّتِهِ،

670
01:06:27,803 --> 01:06:28,220
أَنْ يَجْعَلَ قُنُوتَ عُمَرَ آخِرَ قُنُوتِهِ.

671
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: ثُمَّ الصَّلَاةُ عَلَى النَّبِيِّ.

672
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَالْحُكْمُ الرَّابِعُ فِي قَوْلِهِ: «ثُمَّ الصَّلَاةُ

673
01:06:27,803 --> 01:06:28,220
عَلَى النَّبِيِّ»،

674
01:06:27,803 --> 01:06:28,220
ثُمَّ يَخْتِمُ بِالصَّلَاةِ عَلَى النَّبِيِّ،

675
01:06:27,803 --> 01:06:28,220
فَإِنَّهُ يُسْتَحَبُّ أَنْ يَخْتِمَ الْعَبْدُ دُعَاءَهُ بِالصَّلَاةِ عَلَى النَّبِيِّ،

676
01:06:27,803 --> 01:06:28,220
فَهَذَا مِنْ كَمَالِ الْأَدَبِ مَعَ النَّبِيِّ،

677
01:06:27,803 --> 01:06:28,220
لَا يَخْلُو دُعَاءٌ مِنَ الصَّلَاةِ عَلَيْهِ،

678
01:06:27,803 --> 01:06:28,220
وَالْمُنَاسِبُ لِهَذَا الْمَحَلِّ أَنْ يُجْعَلَ فِي آخِرِ الدُّعَاءِ وَأَوَّلِهِ،

679
01:06:27,803 --> 01:06:28,220
وَالْحُكْمُ الْمَعْرُوفُ فِي الْأَدْعِيَةِ أَنَّ الصَّلَاةَ عَلَى النَّبِيِّ تَقَعُ فِي

680
01:06:27,803 --> 01:06:28,220
آخِرِ الدُّعَاءِ وَتَقَعُ أَيْضًا فِي أَوَّلِهِ،

681
01:06:27,803 --> 01:06:28,220
هِيَ وَاقِعَةٌ فِي أَوَّلِهِ وَآخِرِهِ،

682
01:06:27,803 --> 01:06:28,220
وَيَكُونُ الدُّعَاءُ مَا بَيْنَ هَاتَيْنِ الصَّلَاتَيْنِ عَلَى النَّبِيِّ،

683
01:06:27,803 --> 01:06:28,220
لَكِنْ لِمَاذَا فِي هَذَا الْمَحَلِّ لَمْ نَذْكُرْ مُطْلَقًا أَنَّنَا نُصَلِّي

684
01:06:27,803 --> 01:06:28,220
عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي ابْتِدَاءِ الدُّعَاءِ بَعْدَ

685
01:06:27,803 --> 01:06:28,220
الْفَرَاغِ مِنَ الدُّعَاءِ؟

686
01:06:27,803 --> 01:06:28,220
وَجَوَابُهُ أَنْ يُقَالَ: أَنَّ هَذَا الدُّعَاءَ مُفْتَتَحٌ بِمَا تَقَدَّمَهُ مِنَ

687
01:06:27,803 --> 01:06:28,220
الصَّلَاةِ، وَهَذِهِ الصَّلَاةُ بِرُكُوعِهَا وَسُجُودِهَا وَقِيَامِهَا الَّذِي فِيهِ قِرَاءَةُ الْقُرْآنِ

688
01:06:27,803 --> 01:06:28,220
كَانَتْ كُلُّهَا ذِكْرًا لِلَّهِ وَدُعَاءً وَثَنَاءً عَلَيْهِ سُبْحَانَهُ وَتَعَالَى،

689
01:06:27,803 --> 01:06:28,220
فَكَانَتْ مُقَدِّمَةً نَافِعَةً لِدُعاءِ الْقُنُوتِ،

690
01:06:27,803 --> 01:06:28,220
فَلَمْ يَحْتَجْ مَعَهَا إِلَى مُقَدِّمَةٍ أُخْرَى،

691
01:06:27,803 --> 01:06:28,220
وَهَذِهِ نُكْتَةٌ بَلِيغَةٌ فَتَأَمَّلْهَا،

692
01:06:27,803 --> 01:06:28,220
أَشَارَ إِلَيْهَا شَيْخُ شُيُوخِنَا [بَكْرٌ أَبُو زَيْدٍ] فِي مُصَنَّفٍ لَهُ،

693
01:06:27,803 --> 01:06:28,220
هَذَا مِمَّا يَنْبَغِي أَنْ يُتَنَبَّهَ لَهُ غَايَةَ التَّنَبُّهِ،

694
01:06:27,803 --> 01:06:28,220
فَيَكُونُ الْعَبْدُ إِذَا فَرَغَ مِنْ قَوْلِ: «رَبَّنَا وَلَكَ الْحَمْدُ» أَوْ

695
01:06:27,803 --> 01:06:28,220
غَيْرِهَا مِنْ أَذْكَارِ الرَّفْعِ مِنَ الرُّكُوعِ إِذَا اعْتَدَلَ مِنْهُ،

696
01:06:27,803 --> 01:06:28,220
كَانَ الْمُلَائِمُ حِينَئِذٍ الْمُوَافِقُ لِلشَّرْعِ أَنْ يَشْرَعَ فِي الْقُنُوتِ مُبَاشَرَةً

697
01:06:27,803 --> 01:06:28,220
دُونَ أَنْ يَتَقَدَّمَ الْقُنُوتُ بِأَيٍّ مِنَ الْمُقَدِّمَاتِ لِعَدَمِ الْحَاجَةِ إِلَى

698
01:06:27,803 --> 01:06:28,220
ذَلِكَ، فَإِذَا دَعَا اخْتَتَمَ دُعَاءَهُ بِقُنُوتِ عُمَرَ،

699
01:06:27,803 --> 01:06:28,220
وَهُوَ أَكْمَلُ الْأَدْعِيَةِ الْمُتَعَلِّقَةِ بِالْقُنُوتِ،

700
01:06:27,803 --> 01:06:28,220
ثُمَّ الصَّلَاةِ عَلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَعَكُمْ.

701
01:06:27,803 --> 01:06:28,220
وَقُنُوتُ عُمَرَ الَّذِي ثَبَتَ عَنْهُ: [اللَّهُمَّ اغْفِرْ لَنَا وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ

702
01:06:27,803 --> 01:06:28,220
وَالْمُسْلِمِينَ وَالْمُسْلِمَاتِ،

703
01:06:27,803 --> 01:06:28,220
وَأَلِّفْ بَيْنَ قُلُوبِهِمْ،

704
01:06:27,803 --> 01:06:28,220
وَأَصْلِحْ ذَاتَ بَيْنِهِمْ،

705
01:06:27,803 --> 01:06:28,220
وَانْصُرْهُمْ عَلَى عَدُوِّكَ وَعَدُوِّهِمْ،

706
01:06:27,803 --> 01:06:28,220
اللَّهُمَّ الْعَنْ كَفَرَةَ أَهْلِ الْكِتَابِ الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِكَ،

707
01:06:27,803 --> 01:06:28,220
وَيُكَذِّبُونَ رُسُلَكَ،

708
01:06:27,803 --> 01:06:28,220
وَيُقَاتِلُونَ أَوْلِيَاءَكَ،

709
01:06:27,803 --> 01:06:28,220
اللَّهُمَّ خَالِفْ بَيْنَ كَلِمَتِهِمْ،

710
01:06:27,803 --> 01:06:28,220
وَزَلْزِلْ أَقْدَامَهُمْ،

711
01:06:27,803 --> 01:06:28,220
وَأَنْزِلْ بِهِمْ بَأْسَكَ الَّذِي لَا تَرُدُّهُ عَنِ الْقَوْمِ الْمُجْرِمِينَ،

712
01:06:27,803 --> 01:06:28,220
بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

713
01:06:27,803 --> 01:06:28,220
اللَّهُمَّ إِنَّا نَسْتَعِينُكَ وَنَسْتَغْفِرُكَ،

714
01:06:27,803 --> 01:06:28,220
وَنُثْنِي عَلَيْكَ وَلَا نَكْفُرُكَ،

715
01:06:27,803 --> 01:06:28,220
وَنَخْلَعُ وَنَتْرُكُ مَنْ يَفْجُرُكَ،

716
01:06:27,803 --> 01:06:28,220
بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

717
01:06:27,803 --> 01:06:28,220
اللَّهُمَّ إِيَّاكَ نَعْبُدُ،

718
01:06:27,803 --> 01:06:28,220
وَلَكَ نُصَلِّي وَنَسْجُدُ،

719
01:06:27,803 --> 01:06:28,220
وَإِلَيْكَ نَسْعَى وَنَحْفِدُ،

720
01:06:27,803 --> 01:06:28,220
وَنَخْشَى عَذَابَكَ الْجِدَّ،

721
01:06:27,803 --> 01:06:28,220
وَنَرْجُو رَحْمَتَكَ،

722
01:06:27,803 --> 01:06:28,220
إِنَّ عَذَابَكَ بِالْكَافِرِينَ مُلْحَقٌ].

723
01:06:27,803 --> 01:06:28,220
هَذَا الَّذِي تَقَدَّمَهُ هُوَ قُنُوتُ عُمَرَ،

724
01:06:27,803 --> 01:06:28,220
يَنْبَغِي لِلْعَبْدِ أَنْ لَا يُخْلِيَ نَفْسَهُ مِنْهُ فِي أَيٍّ مِنْ

725
01:06:27,803 --> 01:06:28,220
قُنُوتِهِ؛ فَإِنَّهُ قُنُوتٌ عَظِيمُ الشَّأْنِ،

726
01:06:27,803 --> 01:06:28,220
وَفِيهِ فَوَائِدُ كَثِيرَةٌ حَقِيقَةً،

727
01:06:27,803 --> 01:06:28,220
لَكِنَّ الْمَقَامَ لَا يَسَعُ لِذِكْرِهَا،

728
01:06:27,803 --> 01:06:28,220
فَنَقْتَصِرُ عَلَى بَيَانِ جُمْلَةٍ مِنَ الْفَوَائِدِ الْمُتَعَلِّقَةِ بِهِ: - أَوَّلُهَا:

729
01:06:27,803 --> 01:06:28,220
أَنْ يُقَالَ أَنَّهُ جَمَعَ بَيْنَ الدُّعَاءِ لِلْمُؤْمِنِينَ وَلَعْنِ الْكَفَرَةِ كَمَا

730
01:06:27,803 --> 01:06:28,220
هُوَ ظَاهِرٌ فِي كَلَامِهِ.

731
01:06:27,803 --> 01:06:28,220
- الثَّانِي: أَنْ يُقَالَ أَنَّهُ فِي آخِرِ دُعَائِهِ قَالَ: [وَلَكَ

732
01:06:27,803 --> 01:06:28,220
نَسْعَى وَنَحْفِدُ]،

733
01:06:27,803 --> 01:06:28,220
أَيْ: نُسَارِعُ،

734
01:06:27,803 --> 01:06:28,220
نَحْفِدُ أَيْ: نُسَارِعُ،

735
01:06:27,803 --> 01:06:28,220
الْمُرَادُ أَنَّنَا نَسْعَى وَنُسَارِعُ فِي سَعْيِنَا هَذَا قَدْرَ إِمْكَانِنَا.

736
01:06:27,803 --> 01:06:28,220
- وَالْفَائِدَةُ الثَّالِثَةُ: أَنَّهُ جَمَعَ بَيْنَ الدُّعَاءِ وَالثَّنَاءِ كَمَا هُوَ

737
01:06:27,803 --> 01:06:28,220
ظَاهِرٌ فِي دُعَائِهِ،

738
01:06:27,803 --> 01:06:28,220
فَهَذَا أَصْلٌ نَافِعٌ يَنْبَغِي أَلَّا يُخْلِيَ الْعَبْدُ نَفْسَهُ مِنْهُ؛ فَإِنَّ

739
01:06:27,803 --> 01:06:28,220
[ابْنَ الْقَيِّمِ] رَحِمَهُ اللَّهُ ذَكَرَهُ وَغَيْرُهُ بِعِبَارَاتٍ مُخْتَلِفَةٍ،

740
01:06:27,803 --> 01:06:28,220
إِلَّا أَنَّ [ابْنَ الْقَيِّمِ] مِنْ أَحْسَنِ مَنْ أَبَانَ عَنْ هَذَا

741
01:06:27,803 --> 01:06:28,220
الْمَعْنَى، أَنَّ الْعَبْدَ لَا يَحْصُلُ لَهُ رَجَاؤُهُ مِنْ رَبِّهِ إِلَّا

742
01:06:27,803 --> 01:06:28,220
إِنْ ظَهَرَ حَاجَتُهُ وَافْتِقَارُهُ إِلَى اللَّهِ عَزَّ وَجَلَّ،

743
01:06:27,803 --> 01:06:28,220
وَظَهَرَ خُضُوعُهُ لَهُ سُبْحَانَهُ وَتَعَالَى بِمَا يُظْهِرُ أَنَّ الْعَبْدَ ضَعِيفٌ

744
01:06:27,803 --> 01:06:28,220
وَالرَّبَّ قَوِيٌّ،

745
01:06:27,803 --> 01:06:28,220
وَأَنَّ الْعَبْدَ بِحَاجَةٍ إِلَى عَوْنِ رَبِّهِ عَزَّ وَجَلَّ وَتَقْوِيَتِهِ لَهُ،

746
01:06:27,803 --> 01:06:28,220
فَهَذِهِ الْأَحْوَالُ مِمَّا يَحْمِلُ الْعَبْدَ عَلَى مَزِيدِ إِقْبَالٍ عَلَى اللَّهِ

747
01:06:27,803 --> 01:06:28,220
عَزَّ وَجَلَّ،

748
01:06:27,803 --> 01:06:28,220
فَيَجْعَلُ دُعَاءَهُ أَرْجَى أَنْ يُجَابَ،

749
01:06:27,803 --> 01:06:28,220
وَفَرْقٌ بَيْنَ الثَّنَاءِ وَالدُّعَاءِ؛ فَإِنَّ الثَّنَاءَ تَعْظِيمٌ لِلَّهِ،

750
01:06:27,803 --> 01:06:28,220
أَمَّا الدُّعَاءُ فَهُوَ سُؤَالٌ لَهُ عَلَى إِرَادَةِ نَفْعٍ مِنْهُ،

751
01:06:27,803 --> 01:06:28,220
فَالْأَوَّلُ أَعْظَمُ عِنْدَ اللَّهِ عَلَى نَفْسِهِ مِنْهُ،

752
01:06:27,803 --> 01:06:28,220
بَلْ يَجْعَلُهُ دَاعِمًا لِدُعَائِهِ مُقَوِّيًا لَهُ.

753
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: بَابٌ فِي التَّأْمِينِ عَلَى الْحَمْدِ وَالثَّنَاءِ.

754
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: لَمَّا فَرَغَ الْمُصَنِّفُ مِمَّا يَتَعَلَّقُ بِدُعَاءِ

755
01:06:27,803 --> 01:06:28,220
الْقُنُوتِ وَمَا قَبْلَهُ،

756
01:06:27,803 --> 01:06:28,220
شَرَعَ فِيمَا يَتَعَلَّقُ بِمَا بَعْدَ كُلِّ دُعَاءٍ مِنْ أَدْعِيَةِ الْقُنُوتِ،

757
01:06:27,803 --> 01:06:28,220
لَكِنْ لَمَّا تَقَدَّمَ الْقَوْلُ بِالتَّأْمِينِ عَلَى الدُّعَاءِ وَمَا يَكُونُ فِيهِ

758
01:06:27,803 --> 01:06:28,220
مِنَ الثَّنَاءِ وَغَيْرِهِ،

759
01:06:27,803 --> 01:06:28,220
كَانَ الْمُنَاسِبُ حَالِئِذٍ أَلَّا يُعِيدَ الْمُصَنِّفُ ذِكْرَ مَا تَقَدَّمَ مِنْ

760
01:06:27,803 --> 01:06:28,220
هَذَا الْحَالِ،

761
01:06:27,803 --> 01:06:28,220
وَإِنَّمَا يُنَبِّهُ إِلَى حَالٍ خَاصَّةٍ،

762
01:06:27,803 --> 01:06:28,220
وَهِيَ حَالُ التَّأْمِينِ عَلَى الْحَمْدِ وَالثَّنَاءِ؛ فَإِنَّهُ تَقَدَّمَ الْقَوْلُ أَنَّ

763
01:06:27,803 --> 01:06:28,220
الْمُسْتَحَبَّ التَّأْمِينُ عَلَى الدُّعَاءِ،

764
01:06:27,803 --> 01:06:28,220
وَأَمَّا الْحَمْدُ وَالثَّنَاءُ فَيَجُوزُ أَنْ يَذْكُرَ اللَّهَ مَعَ سَمَاعِهَا بِأَيٍّ

765
01:06:27,803 --> 01:06:28,220
مِنَ الْأَذْكَارِ مِنْ قَوْلِهِ: «أَشْهَدُ حَقًّا» الَّذِي شَاعَ فِي النَّاسِ

766
01:06:27,803 --> 01:06:28,220
أَوْ غَيْرِ ذَلِكَ،

767
01:06:27,803 --> 01:06:28,220
أَوْ أَنْ يَسْكُتَ السَّامِعُ لَهُ فَلَا يَقُولُ شَيْئًا وَهُوَ الْأَوْجَهُ،

768
01:06:27,803 --> 01:06:28,220
وَلَكِنْ مِمَّا يُحْتَاجُ لِلتَّنْبِيهِ عَلَيْهِ مَسْأَلَةٌ خَاصَّةٌ،

769
01:06:27,803 --> 01:06:28,220
وَهِيَ مَا إِذَا أَمَّنَ عَلَى الذِّكْرِ أَوِ الثَّنَاءِ فَمَاذَا يَكُونُ

770
01:06:27,803 --> 01:06:28,220
حُكْمُ ذَلِكَ؟

771
01:06:27,803 --> 01:06:28,220
فَأَفْرَدَ الْمُصَنِّفُ لَهُ بَابًا مُسْتَقِلًّا لِحَالٍ تَتَعَلَّقُ بِهِ تُبَيِّنُهُ إِنْ

772
01:06:27,803 --> 01:06:28,220
شَاءَ اللَّهُ نَعْلَمُ.

773
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَيَحْرُمُ التَّأْمِينُ عَلَى مَا يُعَظَّمُ بِهِ

774
01:06:27,803 --> 01:06:28,220
اللَّهُ مِنْ وَصْفِهِ بِأَنْوَاعِ الْكَمَالَاتِ وَإِنْ تَكَرَّرَ؛ لِمَا فِيهِ مِنْ

775
01:06:27,803 --> 01:06:28,220
تَنْقِيصِ اللَّهِ بِطَلَبِ تَحْقِيقِ وَصْفِهِ بِذَلِكَ.

776
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: فَذَكَرَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ حُكْمًا

777
01:06:27,803 --> 01:06:28,220
وَاحِدًا، وَهُوَ بَيَانُ أَنَّهُ يَحْرُمُ التَّأْمِينُ عَلَى جَمِيعِ مَا يُذْكَرُ

778
01:06:27,803 --> 01:06:28,220
اللَّهُ بِهِ تَعْظِيمًا لَهُ؛ فَإِنَّ مَعْنَى الذِّكْرِ هُوَ إِعْظَامُ اللَّهِ

779
01:06:27,803 --> 01:06:28,220
شَرْعًا، هُوَ أَحَدُ الْمَعَانِي الْمُنْدَرِجَةِ فِيهِ،

780
01:06:27,803 --> 01:06:28,220
فَالْمُرَادُ بِمَا يُعَظَّمُ بِهِ اللَّهُ أَيْ: بِمَا يُذْكَرُ بِهِ اللَّهُ

781
01:06:27,803 --> 01:06:28,220
عَزَّ وَجَلَّ،

782
01:06:27,803 --> 01:06:28,220
وَذَكَرَ وَجْهَ كَوْنِهِ مُعَظِّمًا لِلَّهِ بِأَنَّهُ يُوصَفُ بِذَلِكَ بِأَنْوَاعِ الْكَمَالَاتِ،

783
01:06:27,803 --> 01:06:28,220
فَهَذَا ذِكْرٌ،

784
01:06:27,803 --> 01:06:28,220
ثُمَّ قَالَ: «وَإِنْ تَكَرَّرَ» هَذَا ثَنَاءٌ،

785
01:06:27,803 --> 01:06:28,220
إِذَنْ مَا الْفَرْقُ بَيْنَ الْحَمْدِ وَالثَّنَاءِ؟

786
01:06:27,803 --> 01:06:28,220
الْحَمْدُ هُوَ الْإِخْبَارُ عَنْ مَحَاسِنِ الْمَحْمُودِ مَعَ حُبِّهِ وَتَعْظِيمِهِ،

787
01:06:27,803 --> 01:06:28,220
هُوَ تَعْظِيمٌ لِلَّهِ عَزَّ وَجَلَّ بِذِكْرِ مَحَاسِنِهِ مِنْ أَنْوَاعِ كَمَالَاتِهِ،

788
01:06:27,803 --> 01:06:28,220
وَالْآخَرُ الثَّنَاءُ هُوَ تَكْرَارُ الْحَمْدِ،

789
01:06:27,803 --> 01:06:28,220
هُوَ تَكْرَارُ الْحَمْدِ كَمَا فِي قَوْلِهِ تَعَالَى: ﴿الْحَمْدُ لِلَّهِ رَبِّ

790
01:06:27,803 --> 01:06:28,220
الْعَالَمِينَ﴾ ﴿الرَّحْمَنِ الرَّحِيمِ﴾،

791
01:06:27,803 --> 01:06:28,220
فَهُوَ فِي الْحَدِيثِ: [فَإِذَا قَالَ الْعَبْدُ: {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ}،

792
01:06:27,803 --> 01:06:28,220
قُلْتُ: حَمِدَنِي عَبْدِي،

793
01:06:27,803 --> 01:06:28,220
فَإِذَا قَالَ: {الرَّحْمَنِ الرَّحِيمِ}،

794
01:06:27,803 --> 01:06:28,220
قُلْتُ: أَثْنَى عَلَيَّ عَبْدِي]،

795
01:06:27,803 --> 01:06:28,220
فَجَعَلَ الثَّنَاءَ تَكْرَارًا لِلْحَمْدِ؛ فَإِنَّ قَوْلَ: ﴿الرَّحْمَنِ الرَّحِيمِ﴾ هُوَ تَعْدَادٌ

796
01:06:27,803 --> 01:06:28,220
لِمَحَاسِنَ أُخْرَى لِلَّهِ عَزَّ وَجَلَّ،

797
01:06:27,803 --> 01:06:28,220
وَهِيَ أَسْمَاؤُهُ الْحُسْنَى: الرَّحْمَنُ وَالرَّحِيمُ،

798
01:06:27,803 --> 01:06:28,220
فَكَانَ أَيْضًا حَمْدًا وَإِنْ لَمْ يَكُنْ فِيهِ لَفْظُ الْحَمْدِ،

799
01:06:27,803 --> 01:06:28,220
فَوَقَعَتْ فِي الْحَدِيثِ،

800
01:06:27,803 --> 01:06:28,220
فَوَقَعَ بِذَلِكَ تَكْرَارُ الْحَمْدِ فَصَارَ ثَنَاءً،

801
01:06:27,803 --> 01:06:28,220
فَهُوَ بِمَعْنَى الْحَمْدِ ثَانِيَةً،

802
01:06:27,803 --> 01:06:28,220
أَيْ: مَرَّةً ثَانِيَةً،

803
01:06:27,803 --> 01:06:28,220
فَفِيهِ مَعْنَى التَّكْرَارِ،

804
01:06:27,803 --> 01:06:28,220
ذَكَرَهُ [ابْنُ الْقَيِّمِ] فِي [بَدَائِعِ الْفَوَائِدِ]،

805
01:06:27,803 --> 01:06:28,220
فَذَكَرَ أَنَّهُ الْحَمْدُ الثَّانِي،

806
01:06:27,803 --> 01:06:28,220
وَالْحَمْدُ الثَّانِي،

807
01:06:27,803 --> 01:06:28,220
وَعَلَّلَ ذَلِكَ بِقَوْلِهِ: «تَنْقِيصِ اللَّهِ بِطَلَبِ تَحَقُّقِ وَصْفِهِ»،

808
01:06:27,803 --> 01:06:28,220
إِنَّ مَعْنَى «آمِينَ» اللَّهُمَّ اسْتَجِبْ،

809
01:06:27,803 --> 01:06:28,220
هُوَ سُؤَالٌ مِنَ الْعَبْدِ لِلَّهِ عَزَّ وَجَلَّ أَنْ يُحَقِّقَ هَذَا

810
01:06:27,803 --> 01:06:28,220
الدُّعَاءَ، طَيِّبْ إِذَا أَمَّنْتَ عَلَى ذِكْرٍ أَوْ ثَنَاءٍ فَكَأَنَّكَ تَقُولُ:

811
01:06:27,803 --> 01:06:28,220
اللَّهُمَّ اسْتَجِبْ ذَلِكَ بِأَنْ تَجْعَلَهُ فِيكَ،

812
01:06:27,803 --> 01:06:28,220
فَهَذَا مُخَالِفٌ لِعَقِيدَةِ أَهْلِ السُّنَّةِ وَالْجَمَاعَةِ أَنَّ اللَّهَ مُتَّصِفٌ بِأَنْوَاعِ

813
01:06:27,803 --> 01:06:28,220
الْكَمَالَاتِ، فَلَا مَعْنَى أَنْ تَطْلُبَهَا مِنْهُ سُبْحَانَهُ وَتَعَالَى،

814
01:06:27,803 --> 01:06:28,220
وَإِنَّمَا الصَّحِيحُ أَنْ تَعْتَقِدَ وُجُودَهَا فِيهِ فَلَا تَطْلُبُهَا مِنْهُ،

815
01:06:27,803 --> 01:06:28,220
فَهِيَ مُتَحَقِّقَةٌ لَا أَنَّهَا لَازَالَتْ سَتَتَحَقَّقُ،

816
01:06:27,803 --> 01:06:28,220
فَهَذَا غَلَطٌ،

817
01:06:27,803 --> 01:06:28,220
فَهَذَا غَلَطٌ.

818
01:06:27,803 --> 01:06:28,220
وَنَظِيرُهُ قَوْلُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لَمَّا سَمِعَ أَحَدَ

819
01:06:27,803 --> 01:06:28,220
الصَّحَابَةِ يَقُولُ: «السَّلَامُ عَلَى اللَّهِ»،

820
01:06:27,803 --> 01:06:28,220
قَالَ: [لَا تَقُولُوا السَّلَامُ عَلَى اللَّهِ؛ فَإِنَّ اللَّهَ هُوَ السَّلَامُ]؛

821
01:06:27,803 --> 01:06:28,220
لِأَنَّ السَّلَامُ عَلَى اللَّهِ مَاذَا؟

822
01:06:27,803 --> 01:06:28,220
دُعَاءٌ، فَأَنْتَ إِذَا قُلْتَ: «السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ» أَنْتَ

823
01:06:27,803 --> 01:06:28,220
تَدْعُو لِمَنْ تُلْقِي عَلَيْهِ السَّلَامَ بِأَنْ يُسَلِّمَهُ اللَّهُ مِنَ النَّقْصِ

824
01:06:27,803 --> 01:06:28,220
وَالشَّرِّ وَالْعَيْبِ،

825
01:06:27,803 --> 01:06:28,220
فَكَذَا إِذَا قُلْتَ: «السَّلَامُ عَلَى اللَّهِ» فَكَأَنَّكَ تَدْعُو لِلَّهِ أَنْ

826
01:06:27,803 --> 01:06:28,220
يُسَلِّمَهُ، فَهَذَا لَا يَصِحُّ؛ فَإِنَّهُ هُوَ السَّلَامُ،

827
01:06:27,803 --> 01:06:28,220
فَتَبَيَّنَ بِذَلِكَ أَنَّ هَذِهِ حَالٌ خَاصَّةٌ مِمَّا يَخْفَى عَلَى النَّاسِ

828
01:06:27,803 --> 01:06:28,220
أَمْرُهَا فَيُؤَمِّنُونَ عَلَى الذِّكْرِ وَالثَّنَاءِ،

829
01:06:27,803 --> 01:06:28,220
فَاحْتَاجَ الْعَبْدُ إِلَى أَنْ يَتَنَبَّهَ لِمِثْلِ مَا يَتَعَلَّقُ بِهَا مِنَ

830
01:06:27,803 --> 01:06:28,220
الْأَحْكَامِ، لِهَذَا أَفْرَدَ الذِّكْرَ دُونَ غَيْرِهَا مِمَّا تَقَدَّمَهُ.

831
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: بَابٌ فِي مُتَابَعَةِ الْإِمَامِ فِي الْقُنُوتِ

832
01:06:27,803 --> 01:06:28,220
لِمَا لَا يَرَى بِهِ.

833
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَهَذَا الْبَابُ ذَكَرَهُ الْمُصَنِّفُ بَعْدَمَا فَرَغَ

834
01:06:27,803 --> 01:06:28,220
مِنْ بَيَانِ عَامَّةِ مَا يَتَعَلَّقُ بِأَحْكَامِ الْقُنُوتِ،

835
01:06:27,803 --> 01:06:28,220
فَذَكَرَ حَالًا عَارِضَةً،

836
01:06:27,803 --> 01:06:28,220
وَهِيَ إِذَا وَقَعَ خِلَافٌ بَيْنَ الْإِمَامِ وَالْمَأْمُومِ فِي أَحْكَامِ الْقُنُوتِ،

837
01:06:27,803 --> 01:06:28,220
فَاجْتَهَدَ الْإِمَامُ بِحُكْمٍ وَاجْتَهَدَ الْمَأْمُومُ بِحُكْمٍ آخَرَ،

838
01:06:27,803 --> 01:06:28,220
أَوْ كَانَا مُقَلِّدَيْنِ يُقَلِّدُ كُلٌّ مِنْهُمَا عَالِمًا مُجْتَهِدًا،

839
01:06:27,803 --> 01:06:28,220
وَاخْتَلَفَتِ اجْتِهَادَاتُ الْعُلَمَاءِ فَاخْتَلَفَ الْإِمَامُ وَالْمَأْمُومُ فِيمَا يَتَعَلَّقُ بِأَحْكَامِ الْقُنُوتِ،

840
01:06:27,803 --> 01:06:28,220
وَذِكْرُ هَذَا الْبَابِ مِمَّا يَجْذِبُ انْتِبَاهَ طَالِبِ الْعِلْمِ لِمَسْأَلَتَيْنِ: -

841
01:06:27,803 --> 01:06:28,220
الأُولَى: أَنَّهُ لَا يَنْبَغِي أَنْ تَعْلَمَ أَنَّهُ لَا شَيْءَ فِي

842
01:06:27,803 --> 01:06:28,220
الْعِلْمِ بِلَا حُكْمٍ،

843
01:06:27,803 --> 01:06:28,220
فَلَيْسَ ثَمَّةَ شَيْءٌ يَحْصُلُ فِي صَلَاةٍ أَوْ فِي مُعَامَلَةٍ بَيْنَ

844
01:06:27,803 --> 01:06:28,220
الْخَلْقِ إِلَّا وَلَهُ حُكْمٌ شَرْعِيٌّ،

845
01:06:27,803 --> 01:06:28,220
فَمِنَ الْغَلَطِ إِذَا عَرَضَ لَكَ حَالٌ مَعَ صَاحِبٍ لَكَ،

846
01:06:27,803 --> 01:06:28,220
أَوْ إِمَامٍ فِي صَلَاةٍ،

847
01:06:27,803 --> 01:06:28,220
أَوْ وَالِدٍ،

848
01:06:27,803 --> 01:06:28,220
أَوْ شَيْخٍ كَبِيرٍ،

849
01:06:27,803 --> 01:06:28,220
أَوْ طِفْلٍ صَغِيرٍ،

850
01:06:27,803 --> 01:06:28,220
أَوْ امْرَأَةٍ،

851
01:06:27,803 --> 01:06:28,220
أَوْ غَيْرِ ذَلِكَ،

852
01:06:27,803 --> 01:06:28,220
فَالْعَبْدُ يَنْبَغِي أَنْ يَفْزَعَ إِلَى مَا يَسْتَحْدِثُهُ قَلْبُكَ مِنَ أَنْوَاعِ

853
01:06:27,803 --> 01:06:28,220
الْمَشَاعِرِ فَتَحْكُمَ بِهَا،

854
01:06:27,803 --> 01:06:28,220
أَوْ أَنْ تَلْجَأَ إِلَى رَأْيِكَ وَهَوَاكَ فَتَمْضِيَ بِهِ،

855
01:06:27,803 --> 01:06:28,220
وَهَذَا وَذَاكَ كِلَاهُمَا غَلَطٌ،

856
01:06:27,803 --> 01:06:28,220
وَإِنَّمَا الدِّينُ كَامِلٌ فَتَنْظُرُ حُكْمَ اللَّهِ فِي هَذَا،

857
01:06:27,803 --> 01:06:28,220
فَالْعَبْدُ يَنْبَغِي إِذَا وَقَفَ عَلَى حَالٍ لَمْ يَجِدْ فِيهَا حُكْمًا

858
01:06:27,803 --> 01:06:28,220
شَرْعِيًّا فِي نَفْسِهِ أَنْ يَسْأَلَ عَنْهُ،

859
01:06:27,803 --> 01:06:28,220
وَهَذَا الَّذِي كَانَ عَلَيْهِ الصَّحَابَةُ وَالتَّابِعُونَ وَمَنْ بَعْدَهُمْ مِنْ أَهْلِ

860
01:06:27,803 --> 01:06:28,220
الْخَيْرِ وَالصَّلَاحِ،

861
01:06:27,803 --> 01:06:28,220
وَمِنْهُ الْمَشْهُورُ عَنْ سُفْيَانَ الثَّوْرِيِّ أَنَّهُ قَالَ: [إِنِ اسْتَطَعْتَ أَلَّا

862
01:06:27,803 --> 01:06:28,220
تَحُكَّ رَأْسَكَ إِلَّا بِأَثَرٍ فَافْعَلْ].

863
01:06:27,803 --> 01:06:28,220
الشيخ: أَفَهِمْتَ؟

864
01:06:27,803 --> 01:06:28,220
طالب: الشَّيْخُ،

865
01:06:27,803 --> 01:06:28,220
الْمَايِكُ مَكْتُومٌ.

866
01:06:27,803 --> 01:06:28,220
الشيخ: نَعَمْ،

867
01:06:27,803 --> 01:06:28,220
أَعَزَّكَ اللَّهُ خَيْرًا،

868
01:06:27,803 --> 01:06:28,220
عَفْوًا. طالب: وَجَزَاكَ يَا بُنَيَّ.

869
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: آخِرُ مَا ذَكَرْتُ أَنَّهُ يَنْبَغِي أَنْ

870
01:06:27,803 --> 01:06:28,220
يُرْجَعَ إِلَى حَالِ الشَّرِيعَةِ لِيَعْرِفَ حُكْمَ اللَّهِ فِي هَذِهِ الْمُعَامَلَةِ

871
01:06:27,803 --> 01:06:28,220
كَمَا كَانَ السَّلَفُ يَفْعَلُونَ،

872
01:06:27,803 --> 01:06:28,220
فَفِيهِ كَلَامُ [سُفْيَانَ الثَّوْرِيِّ] أَنَّهُ كَانَ يَقُولُ: [إِنِ اسْتَطَعْتَ أَلَّا

873
01:06:27,803 --> 01:06:28,220
تَحُكَّ رَأْسَكَ إِلَّا بِأَثَرٍ فَافْعَلْ]،

874
01:06:27,803 --> 01:06:28,220
أَيْ: إِنِ اسْتَطَعْتَ أَلَّا تُمْضِيَ أَظَافِرَكَ فِي رَأْسِكَ حَكًّا لَهُ

875
01:06:27,803 --> 01:06:28,220
إِلَّا إِنْ وَقَفْتَ عَلَى أَثَرٍ فِي ذَلِكَ فَافْعَلْ،

876
01:06:27,803 --> 01:06:28,220
لُزُومًا لِهَذَا الْأَثَرِ لِتَتَيَقَّنَ إِبَاحَتَهُ وَلِتَمْضِيَ فِيهِ بِالسُّنَّةِ،

877
01:06:27,803 --> 01:06:28,220
إِلَى غَيْرِ ذَلِكَ مِنَ الْمَقَاصِدِ الشَّرْعِيَّةِ،

878
01:06:27,803 --> 01:06:28,220
فَيَنْبَغِي لِلْعَبْدِ إِذَا تَحَصَّلَ لَهُ شَيْءٌ أَنْ يَنْظُرَ حُكْمَ اللَّهِ

879
01:06:27,803 --> 01:06:28,220
فِيهِ؛ فَإِنَّكَ مُتَعَبَّدٌ بِهَذَا الدِّينِ.

880
01:06:27,803 --> 01:06:28,220
وَالْمَسْأَلَةُ الثَّانِيَةُ: أَنَّ الْخِلَافَ بَيْنَ الْإِمَامِ وَالْمَأْمُومِ يَرِدُ،

881
01:06:27,803 --> 01:06:28,220
فَلَا يَنْبَغِي أَنْ يَظُنَّ أَحَدٌ أَنَّ وَحْدَةَ الْمُسْلِمِينَ وَكَوْنَهُمْ يَسْعَوْنَ

882
01:06:27,803 --> 01:06:28,220
لِلْحَقِّ سَبَبٌ مُوجِبٌ لِأَنْ يَتَحَقَّقَ فِيهِمْ مَعْنَى أَنَّهُمْ لَا يَخْتَلِفُونَ،

883
01:06:27,803 --> 01:06:28,220
هَذَا بَاطِلٌ؛ فَإِنَّنَا بَشَرٌ نَخْتَلِفُ فِي فَهْمِنَا وَنَخْتَلِفُ فِي أَحْوَالِنَا،

884
01:06:27,803 --> 01:06:28,220
فَهَذِهِ الْكَثِيرَةُ مِنَ الْمَسَائِلِ الشَّرْعِيَّةِ لَا يَنْبَغِي أَنْ يُقَالَ حَيْثُ

885
01:06:27,803 --> 01:06:28,220
أَنَّ هَذَا الْخِلَافَ شَرٌّ،

886
01:06:27,803 --> 01:06:28,220
هَذَا غَلَطٌ،

887
01:06:27,803 --> 01:06:28,220
وَلَا أَنْ يُقَالَ: الْخِلَافُ رَحْمَةٌ،

888
01:06:27,803 --> 01:06:28,220
كِلَاهُمَا لَا يَصِحُّ بِإِطْلَاقٍ؛ فَالْخِلَافُ يَكُونُ شَرًّا إِذَا أَتَى مِنْ

889
01:06:27,803 --> 01:06:28,220
شَرٍّ أَوْ حَمَلَ عَلَى شَرٍّ،

890
01:06:27,803 --> 01:06:28,220
وَيَكُونُ خَيْرًا إِذَا أَتَى مِنْ خَيْرٍ أَوْ حَمَلَ عَلَى خَيْرٍ،

891
01:06:27,803 --> 01:06:28,220
فَالْمُنَاسِبُ لِهَذِهِ الْحَالِ أَنْ يُقَالَ أَنَّهُ خِلَافٌ بَشَرِيٌّ يَحْصُلُ لِاخْتِلَافِ

892
01:06:27,803 --> 01:06:28,220
الْخَلْقِ فِي اجْتِهَادَاتِهِمْ وَاخْتِلَافِهِمْ فِي مَنْ يُقَلِّدُونَ مِنَ الْعُلَمَاءِ،

893
01:06:27,803 --> 01:06:28,220
فَيُتَقَبَّلُ حَالِئِذٍ لَا يُنْكَرُ عَلَى الْمُخَالِفِ فِيهِ،

894
01:06:27,803 --> 01:06:28,220
لَكِنْ يُوَجَّهُ بِتَوْجِيهٍ فِيمَا سَنُدْرِكُ فِي هَذَا الْبَابِ مِنَ الْأَحْكامِ

895
01:06:27,803 --> 01:06:28,220
الْمُتَعَلِّقَةِ بِبِدَايَةِ هَذَا الْخِلَافِ،

896
01:06:27,803 --> 01:06:28,220
إِنَّمَا الَّذِي تَدُلُّ الْإِشَارَةُ إِلَيْهِ أَلَّا يُسَاءَ فَهْمُ الْخِلَافِ،

897
01:06:27,803 --> 01:06:28,220
أَوْ أَنْ يُعَامَلَ مُعَامَلَةً يَكُونُ فِيهَا إِنْكَارٌ وَشِدَّةٌ بِمَا لَا

898
01:06:27,803 --> 01:06:28,220
يَلِيقُ بِالْمُسْلِمِينَ وَأَهْلِ الْخَيْرِ فِي مَقَامٍ كَمَقَامِ الصَّلَاةِ الَّذِي نُصَلِّي

899
01:06:27,803 --> 01:06:28,220
فِيهِ جَمَاعَةً إِشَارَةً إِلَى اجْتِمَاعِنَا عَلَى مَعْنًى وَاحِدٍ وَهُوَ عِبَادَةُ

900
01:06:27,803 --> 01:06:28,220
اللَّهِ عَزَّ وَجَلَّ،

901
01:06:27,803 --> 01:06:28,220
نَعَمْ. قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَمَنْ قَنَتَ إِمَامُهُ فِي مَكْتُوبَةٍ

902
01:06:27,803 --> 01:06:28,220
لِغَيْرِ نَازِلَةٍ أَمَّنَ عَلَى دُعَائِهِ؛ لِثُبُوتِ إِمَامَتِهِ ابْتِدَاءً مَعَ حُصُولِ

903
01:06:27,803 --> 01:06:28,220
خِلَافٍ وَإِمْكَانِهِ الِاجْتِهَادِ،

904
01:06:27,803 --> 01:06:28,220
الْمَأْمُومُ بَاقٍ عَلَى أَصْلِهِ،

905
01:06:27,803 --> 01:06:28,220
وَالْإِتْمَامُ بِغَيْرِهِ أَوْلَى.

906
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ حُكْمَيْنِ:

907
01:06:27,803 --> 01:06:28,220
- أَحَدُهُمَا: أَنَّهُ ذَكَرَ فِي مَنْ قَنَتَ إِمَامُهُ فِي مَكْتُوبَةٍ

908
01:06:27,803 --> 01:06:28,220
لِغَيْرِ نَازِلَةٍ أَنَّهُ يُؤَمِّنُ عَلَى دُعَائِهِ،

909
01:06:27,803 --> 01:06:28,220
فَهُوَ لَا يَنْفَكُّ عَنْهُ وَلَا يَرْغَبُهُ وَلَا يَتْرُكُ التَّأْمِينَ عَلَى

910
01:06:27,803 --> 01:06:28,220
دُعَائِهِ بَلْ يُؤَمِّنُ،

911
01:06:27,803 --> 01:06:28,220
وَذِكْرُهُ لِلتَّأْمِينَ عَلَى دُعَائِهِ هُوَ مِنَ التَّنْبِيهِ بِالْأَدْنَى عَلَى الْأَعْلَى،

912
01:06:27,803 --> 01:06:28,220
أَيْ: إِذَا كَانَ سَيُؤَمِّنُ عَلَى دُعَائِهِ وَهَذَا أَدْنَى الْمَطْلُوبِ فِي

913
01:06:27,803 --> 01:06:28,220
الْقُنُوتِ فَإِنَّهُ مُسْتَحَبٌّ،

914
01:06:27,803 --> 01:06:28,220
فَمِنْ بَابِ أَوْلَى أَنَّهُ لَنْ يُفَارِقَهُ فِي الصَّلَاةِ فَيُصَلِّي مُنْفَرِدًا،

915
01:06:27,803 --> 01:06:28,220
وَلَنْ يُعَارِضَهُ فَيُنْكِرَ عَلَيْهِ،

916
01:06:27,803 --> 01:06:28,220
فَهَذَا وَذَاكَ أَشَدُّ مِنَ التَّأْمِينِ،

917
01:06:27,803 --> 01:06:28,220
وَمَعَ هَذَا فَالْمَطْلُوبُ مِنْهُ شَرْعًا أَنْ يُؤَمِّنَ عَلَى دُعَائِهِ،

918
01:06:27,803 --> 01:06:28,220
فَكُلٌّ مِنْهُمَا مُصِيبٌ بِاعْتِبَارِ فِعْلِهِ،

919
01:06:27,803 --> 01:06:28,220
أَنَّ الْإِمَامَ أَخَذَ بِقَوْلِ عَالِمٍ وَالْمَأْمُومَ أَخَذَ بِقَوْلِ عَالِمٍ،

920
01:06:27,803 --> 01:06:28,220
فَأَخَذَ الْإِمَامُ بِالْقَوْلِ بِقُنُوتِ الْمَكْتُوبَاتِ وَلَوْ لِغَيْرِ نَازِلَةٍ،

921
01:06:27,803 --> 01:06:28,220
وَأَخَذَ الْمَأْمُومُ بِصِحَّةِ الْقَوْلِ بِالْقُنُوتِ لِنَازِلَةٍ فَقَطْ دُونَ غَيْرِهَا مِمَّا

922
01:06:27,803 --> 01:06:28,220
يَتَعَلَّقُ بِالْمَكْتُوبَاتِ،

923
01:06:27,803 --> 01:06:28,220
طَيِّبْ كُلٌّ مِنْهُمَا عَامِلٌ بِمَا بَلَغَهُ،

924
01:06:27,803 --> 01:06:28,220
كُلٌّ أَجَابَ قَوْلَهُ تَعَالَى: ﴿فَاسْأَلُوا أَهْلَ الذِّكْرِ إِنْ كُنْتُمْ لَا

925
01:06:27,803 --> 01:06:28,220
تَعْلَمُونَ﴾، كُلٌّ إِذَا وَقَفَ يَسْأَلُ بَيْنَ يَدَيْ رَبِّهِ: مَاذَا أَجَبْتُمُ

926
01:06:27,803 --> 01:06:28,220
الْمُرْسَلِينَ؟ وَجَدَ جَوَابًا يُمْضِيهِ فِي حِسَابِهِ،

927
01:06:27,803 --> 01:06:28,220
فَلَا يُعَابُ حَالِئِذٍ عَلَى فَاعِلِ شَيْءٍ بِخِلَافِ مُعْتَقَدِهِ طَالَمَا لَهُ

928
01:06:27,803 --> 01:06:28,220
وَجْهٌ عِنْدَ أَهْلِ الْعِلْمِ،

929
01:06:27,803 --> 01:06:28,220
وَالْمَسْأَلَةُ كَمَا تَقَدَّمَ خِلَافِيَّةٌ،

930
01:06:27,803 --> 01:06:28,220
وَالْمَسْأَلَةُ كَمَا تَقَدَّمَ خِلَافِيَّةٌ.

931
01:06:27,803 --> 01:06:28,220
وَعَلَّلَ ذَلِكَ بِقَوْلِهِ: «لِثُبُوتِ إِمَامَتِهِ ابْتِدَاءً»،

932
01:06:27,803 --> 01:06:28,220
فَهُوَ الْإِمَامُ،

933
01:06:27,803 --> 01:06:28,220
وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: [إِنَّمَا جُعِلَ الْإِمَامُ لِيُؤْتَمَّ

934
01:06:27,803 --> 01:06:28,220
بِهِ]، فَهُوَ إِمَامٌ لِيَتَّبِعَهُ النَّاسُ،

935
01:06:27,803 --> 01:06:28,220
ثُمَّ قَالَ: «مَعَ حُصُولِ الْخِلَافِ وَإِمْكَانِهِ الِاجْتِهَادِ»،

936
01:06:27,803 --> 01:06:28,220
فَهِيَ الْعِلَّةُ الَّتِي قَدَّمْنَاهَا،

937
01:06:27,803 --> 01:06:28,220
وَالْعِلَّةُ الثَّانِيَةُ عَامَّةٌ الَّتِي قَدَّمْنَاهَا فِي الذِّكْرِ مَا هُنَا،

938
01:06:27,803 --> 01:06:28,220
فَهِيَ بَعْدَ كَوْنِهِ إِمَامًا،

939
01:06:27,803 --> 01:06:28,220
فَإِمَامَتُهُ هِيَ الْعِلَّةُ الْأُولَى بِالْمُرَاعَاةِ فِي هَذَا الْمَحَلِّ خُصُوصًا لِأَنَّكَ

940
01:06:27,803 --> 01:06:28,220
تَابِعٌ لِلْإِمَامِ،

941
01:06:27,803 --> 01:06:28,220
ثُمَّ أَكَّدَ عَلَى هَذَا الْمَعْنَى بِقَوْلِهِ: «فَالْمَأْمُومُ بَاقٍ عَلَى أَصْلِهِ»،

942
01:06:27,803 --> 01:06:28,220
أَيْ: فِي وُجُوبِ اتِّبَاعِهِ،

943
01:06:27,803 --> 01:06:28,220
فَلَا يُنْكَرُ عَلَيْهِ وَلَا يُخْتَلَفُ عَلَيْهِ بِالْخُرُوجِ مِنَ الصَّلَاةِ أَوْ

944
01:06:27,803 --> 01:06:28,220
نَحْوِ ذَلِكَ،

945
01:06:27,803 --> 01:06:28,220
فَالْخُرُوجُ مِنَ الْفَرْضِ حَرَامٌ،

946
01:06:27,803 --> 01:06:28,220
وَتَرْكُ الْجَمَاعَةِ أَيْضًا حَرَامٌ لِمَا تَقَدَّمَ الْقَوْلُ فِيهِ غَيْرَ مَرَّةٍ

947
01:06:27,803 --> 01:06:28,220
أَنَّ صَلَاةَ الْجَمَاعَةِ وَاجِبَةٌ فِي الْمَسْجِدِ مَعَ جَمَاعَةِ الْمَسْجِدِ،

948
01:06:27,803 --> 01:06:28,220
وَبِهَذَا يُعْرَفُ أَنَّ الْإِمَامَ لَازَال بَاقِيًا عَلَى حَالِهِ وَالْمَأْمُومَ لَازَال

949
01:06:27,803 --> 01:06:28,220
بَاقِيًا عَلَى حَالِهِ،

950
01:06:27,803 --> 01:06:28,220
فَالْمَأْمُومُ بَاقٍ عَلَى أَصْلِهِ فِي وُجُوبِ اتِّبَاعِ الْإِمَامِ.

951
01:06:27,803 --> 01:06:28,220
ثُمَّ ذَكَرَ الْحُكْمَ الثَّانِيَ فِي قَوْلِهِ: «وَالْإِتْمَامُ بِغَيْرِهِ أَوْلَى»،

952
01:06:27,803 --> 01:06:28,220
إِنَّ الْعَبْدَ إِذَا أَتَمَّ أَنْ يُرَافِقَهُ فِي الْأَحْكَامِ صَلَاةً صَلَاةً

953
01:06:27,803 --> 01:06:28,220
وَاحِدَةً، كَانَ ذَلِكَ أَوْفَقَ لِلْخُشُوعِ فِيهَا،

954
01:06:27,803 --> 01:06:28,220
وَلَمْ يَقَعْ فِي قَلْبِهِ شَيْءٌ مِمَّا يَصْرِفُهُ عَنِ الْخُشُوعِ فِيهَا،

955
01:06:27,803 --> 01:06:28,220
فَيَكُونُ ذَلِكَ أَوْلَى،

956
01:06:27,803 --> 01:06:28,220
فَإِذَا وَقَفَ عَلَى هَذَا الْإِمَامِ فَكَانَ لَهُ عَلَى إِذْنٍ أَنْ

957
01:06:27,803 --> 01:06:28,220
يَأْتَمَّ بِهِ.

958
01:06:27,803 --> 01:06:28,220
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: كَتَبَهُ مُحَمَّدُ بْنُ سَلَامَةَ بْنِ مُحَمَّدِ

959
01:06:27,803 --> 01:06:28,220
بْنِ هِلَالٍ،

960
01:06:27,803 --> 01:06:28,220
غَفَرَ اللَّهُ لَهُ وَلِوَالِدَيْهِ وَلِمَشَايِخِهِ وَلِلْمُسْلِمِينَ،

961
01:06:27,803 --> 01:06:28,220
لَيْلَةَ الثُّلَاثَاءِ التَّاسِعِ وَالْعِشْرِينَ مِنْ شَعْبَانَ سَنَةَ أَرْبَعٍ وَأَرْبَعِينَ بَعْدَ

962
01:06:27,803 --> 01:06:28,220
الْأَرْبَعِمِائَةِ وَالْأَلْفِ فِي مِصْرَ،

963
01:06:27,803 --> 01:06:28,220
حَفِظَهَا اللَّهُ دَارًا لِلْإِسْلَامِ وَالسُّنَّةِ.

964
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: تَرَى تَعَدُّدَ جَمَاعَةٍ مِنْ أَهْلِ الْعِلْمِ

965
01:06:27,803 --> 01:06:28,220
أَنْ يَخْتِمُوا كُتُبَهُمْ بِالْإِشَارَةِ إِلَى أَنَّهُمْ هُمُ الَّذِينَ كَتَبُوهَا لِيُعْرَفَ

966
01:06:27,803 --> 01:06:28,220
عَنْهُمْ ذَلِكَ،

967
01:06:27,803 --> 01:06:28,220
يَذْكُرُونَهَا ثُمَّ يَدْعُونَ لِأَنْفُسِهِمْ وَلِغَيْرِهِمْ مِمَّنْ هُوَ أَوْلَى بِالدُّعَاءِ،

968
01:06:27,803 --> 01:06:28,220
ثُمَّ لِعُمُومِ الْمُسْلِمِينَ مَعَ تَعْيِينِ زَمَنِ انْتِهَاءِ التَّصْنِيفِ،

969
01:06:27,803 --> 01:06:28,220
يَكُونُ ذَلِكَ أَدْعَى إِلَى مَعْرِفَةِ مَا تَقَدَّمَ وَمَا تَأَخَّرَ مِنَ

970
01:06:27,803 --> 01:06:28,220
التَّصْنِيفِ لِلْمُصَنِّفِ الْوَاحِدِ؛ فَإِنَّ الْعَادَةَ أَنَّ مَا تَأَخَّرَ مِنْ تَصْنِيفِهِ

971
01:06:27,803 --> 01:06:28,220
يَكُونُ فِيهِ الْقَوْلُ هُوَ الْقَوْلَ الْمُحَقَّقَ عِنْدَهُ،

972
01:06:27,803 --> 01:06:28,220
فَإِذَا خَالَفَ حَالِئِذٍ مُصَنَّفًا مُتَقَدِّمًا عَلَيْهِ كَانَ الْمُخْتَارُ الْمُصَنَّفَ الْمُتَأَخِّرَ،

973
01:06:27,803 --> 01:06:28,220
فَهَذَا يَنْفَعُ فِي التَّرْجِيحِ،

974
01:06:27,803 --> 01:06:28,220
ثُمَّ عَيَّنَ مَكَانَ ذَلِكَ وَهُوَ مِصْرُ،

975
01:06:27,803 --> 01:06:28,220
وَدَعَا لَهَا بِحِفْظِهَا دَارًا لِلْإِسْلَامِ وَالسُّنَّةِ،

976
01:06:27,803 --> 01:06:28,220
وَهَذَا يَنْفَعُ فِي بَيَانِ مَا يَتَعَلَّقُ بِحَالِ تَصْنِيفِ هَذَا الْمُصَنِّفِ،

977
01:06:27,803 --> 01:06:28,220
وَهَذِهِ الْجُمْلَةُ مِمَّا يُغْفِلُهُ كَثِيرٌ مِنْ طَلَبَةِ الْعِلْمِ إِذَا وَقَفُوا

978
01:06:27,803 --> 01:06:28,220
عَلَيْهِ لَا يَقْرَؤُونَ،

979
01:06:27,803 --> 01:06:28,220
وَهَذَا غَلَطٌ؛ فَإِنَّ قَلِيلَ الْكِتَابِ كَكَثِيرِهِ،

980
01:06:27,803 --> 01:06:28,220
وَقَلِيلَ الْعِلْمِ كَكَثِيرِهِ،

981
01:06:27,803 --> 01:06:28,220
إِذَا قَرَأْتَ الْكَثِيرَ فَيَلْزَمُكَ أَنْ تَقْرَأَ الْقَلِيلَ.

982
01:06:27,803 --> 01:06:28,220
وَكَانَ فِي أَخْبَارِ شَيْخِ شَيْخِنَا [عَبْدِ اللَّهِ بْنِ عَقِيلٍ] أَنَّهُ

983
01:06:27,803 --> 01:06:28,220
حَضَرَ إِلَيْهِ دُكْتُورٌ جَامِعِيٌّ فَأَرَادَ أَنْ يَقْرَأَ عَلَيْهِ،

984
01:06:27,803 --> 01:06:28,220
فَقَالَ لَهُ: «ائْتِنَا غَدًا وَأَحْضِرْ كِتَابَ [أَخْصَرِ الْمُخْتَصَرَاتِ]»،

985
01:06:27,803 --> 01:06:28,220
فَلَمَّا أَحْضَرَهُ فَقَالَ: «اقْرَأْ»،

986
01:06:27,803 --> 01:06:28,220
فَقَالَ: «بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

987
01:06:27,803 --> 01:06:28,220
كِتَابُ الطَّهَارَةِ»،

988
01:06:27,803 --> 01:06:28,220
فَقَالَ: «يَا بُنَيَّ،

989
01:06:27,803 --> 01:06:28,220
فَلَا يَتَقَدَّمُ كِتَابَ الطَّهَارَةِ شَيْءٌ مِنَ الْعِلْمِ فِي مُقَدِّمَةٍ وَنَحْوِهَا؟»،

990
01:06:27,803 --> 01:06:28,220
قَالَ لَنَا: «نَعَمْ،

991
01:06:27,803 --> 01:06:28,220
لَكِنْ يَعْنِي هَذِهِ هِيَ السِّيرَةُ نَعْرِفُهَا وَيَعْنِي...»،

992
01:06:27,803 --> 01:06:28,220
فَقَالَ لَنَا: «نَبْدَأُ بِكِتَابِ الطَّهَارَةِ،

993
01:06:27,803 --> 01:06:28,220
وَإِذَا وَجَدْنَا وَقْتًا رُبَّمَا عُدْنَا إِلَيْهَا لِنَسْتَفِيدَ فِي أَحْكَامِهِ»،

994
01:06:27,803 --> 01:06:28,220
فَقَالَ لَنَا: «لَا،

995
01:06:27,803 --> 01:06:28,220
اقْرَأْ، وَإِذَا أَتْمَمْنَاهَا انْتَقَلْنَا إِلَى كِتَابِ الطَّهَارَةِ»،

996
01:06:27,803 --> 01:06:28,220
قَالَ: «يَا شَيْخُ،

997
01:06:27,803 --> 01:06:28,220
يَعْنِي أَنَا وَقْتِي ضَيِّقٌ،

998
01:06:27,803 --> 01:06:28,220
وَيَعْنِي لَمْ أَجِدْ فِيمَا تَقَدَّمَ مِنَ الزَّمَانِ وَقْتًا لِأَقْرَأَ عَلَيْكَ،

999
01:06:27,803 --> 01:06:28,220
فَالْحَمْدُ لِلَّهِ أَنْ وَفَّقَنَا إِلَى هَذِهِ الْفُرْصَةِ،

1000
01:06:27,803 --> 01:06:28,220
فَأُرِيدُ أَنْ أَسْتَغِلَّ الْوَقْتَ،

1001
01:06:27,803 --> 01:06:28,220
فَلَعَلَّكُمْ تُرْجِئُونَ إِقْرَاءَ الْمُقَدِّمَةِ إِلَى مَقَامٍ آخَرَ»،

1002
01:06:27,803 --> 01:06:28,220
فَقَالَ لَنَا: «قُمْ،

1003
01:06:27,803 --> 01:06:28,220
وَإِذَا وَجَدْتَ وَقْتًا تَقْرَأُ عَلَيَّ فِيهِ الْمُقَدِّمَةَ وَمَا يَلِيهَا أَنَا

1004
01:06:27,803 --> 01:06:28,220
أَنْتَظِرُكَ»، فَقَامَ عَنْهُ وَرَحَلَ وَلَمْ يَأْتِ إِلَيْهِ ثَانِيًا،

1005
01:06:27,803 --> 01:06:28,220
طَيِّبْ لِمَاذَا فَعَلَ الشَّيْخُ [عَبْدُ اللَّهِ بْنُ عَقِيلٍ] هَذَا الَّذِي

1006
01:06:27,803 --> 01:06:28,220
فَعَلَهُ؟ الْجَوَابُ: لِأَنَّ مَنْ لَا يُبَالِي بِقَلِيلِ الْعِلْمِ لَا يُبَالِي

1007
01:06:27,803 --> 01:06:28,220
بِكَثِيرِهِ، وَالْمُقَدِّمَاتُ مَفَاتِيحُ الْكُتُبِ كَمَا يُقَالُ،

1008
01:06:27,803 --> 01:06:28,220
ذَاتُهُ يُقَالُ فِي خَاتِمَةٍ لَيْلَةَ كَثِيرٍ مِنْ عِلْمِنَا فِي آخِرِهَا:

1009
01:06:27,803 --> 01:06:28,220
«تَمَّ بِحَمْدِ اللَّهِ»،

1010
01:06:27,803 --> 01:06:28,220
فَتَجِدُ الطَّالِبَ يَقْرَأُ الْكِتَابَ كَامِلًا ثُمَّ لَا يَقْرَأُ: «تَمَّ بِحَمْدِ

1011
01:06:27,803 --> 01:06:28,220
اللَّهِ»، طَيِّبْ أَلَيْسَتْ هَذِهِ تَذْكِرَةً؟

1012
01:06:27,803 --> 01:06:28,220
أَلَيْسَتْ فِيهِ فَائِدَةٌ أَنَّهُ يُسْتَحَبُّ لِمَنْ أَتَمَّ تَصْنِيفًا أَنْ يَحْمَدَ

1013
01:06:27,803 --> 01:06:28,220
اللَّهَ؟ هَذَا زُهْدٌ فِي الْعِلْمِ،

1014
01:06:27,803 --> 01:06:28,220
وَمَنْ جَعَلَ تَعَامُلَهُ هَكَذَا مَعَ أَدَبِ الْعِلْمِ وَأَخْلَاقِ أَهْلِهِ فِي

1015
01:06:27,803 --> 01:06:28,220
عِبَادَتِهِمْ فِي تَصَانِيفِهِمْ وَالْأَذْكَارِ الَّتِي يَضَعُونَهَا فِيهَا،

1016
01:06:27,803 --> 01:06:28,220
كَانَ ذَلِكَ مِرْقَاةَ إِصَابَتِهِ بِالْجَهْلِ عَاجِلًا أَوْ آجِلًا وَحِرْمَانِهِ مِنَ

1017
01:06:27,803 --> 01:06:28,220
الْخُلُقِ، فَذَلِكَ الَّذِي يَنْبَغِي لِلْعَبْدِ وَيَخُصُّهُ مِنَ الْأَغْلَبِ مِمَّا قَدَّرْنَا

1018
01:06:27,803 --> 01:06:28,220
بِهَذَا الْكِتَابِ وَغَيْرِهِ،

1019
01:06:27,803 --> 01:06:28,220
وَأَنْ يَعْمَلَهُ وَيَصِفَ نَفْسَهُ فِي مُعَامَلَاتِهِ مَعَ الْخَلْقِ،

1020
01:06:27,803 --> 01:06:28,220
وَيُبَادِرَ إِلَيْهِ مَنْ يَسْمَعُ لَهُ لَعَلَّهُ يَنْتَفِعُ بِهِ،

1021
01:06:27,803 --> 01:06:28,220
وَهَذَا آخِرُ الْبَيَانِ عَلَى هَذَا.

1022
01:06:27,803 --> 01:06:28,220
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ...

1023
01:06:27,803 --> 01:06:28,220
الْقَدْرِ، وَنَكُونُ بِهَذَا فَتَفَرَّغْنَا مِمَّا يَتَعَلَّقُ بِأَحْكَامِ الْقُنُوتِ،

1024
01:06:27,803 --> 01:06:28,220
وَلِلَّهِ الْحَمْدُ،

1025
01:06:27,803 --> 01:06:28,220
وَاللَّهُ أَعْلَمُ؛ فَصَلَّى اللَّهُ عَلَى مُحَمَّدٍ وَآلِهِ وَصَحْبِهِ وَسَلَّمَ،

1026
01:06:27,803 --> 01:06:28,220
[سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ،

1027
01:06:27,803 --> 01:06:28,220
أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ،

1028
01:06:27,803 --> 01:06:28,220
أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ].
