1
00:00:06,450 --> 00:00:09,216
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ

2
00:00:13,641 --> 00:00:14,748
اللَّهِ وَبَرَكَاتُهُ،

3
00:00:14,194 --> 00:00:14,748
الْحَمْدُ لِلَّهِ رَبِّنَا،

4
00:00:16,407 --> 00:00:18,067
وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا

5
00:00:51,934 --> 00:00:53,541
اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

6
00:00:52,738 --> 00:00:53,541
وَأَشْهَدُ أَنْ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

7
00:00:52,738 --> 00:00:53,541
أَمَّا بَعْدُ،

8
00:00:52,738 --> 00:00:53,541
فَهَذَا شَرْحُ الْكِتَابِ الْأَوَّلِ

9
00:01:34,400 --> 00:01:37,400
مِنْ بَرْنَامَجِ [عُدَّةِ رَمَضَانَ]

10
00:01:47,400 --> 00:01:48,733
فِي سَنَتِهِ الْأُولَى سَنَةَ خَمْسٍ وَأَرْبَعِينَ وَأَرْبَعِمِائَةٍ وَأَلْفٍ،

11
00:01:48,067 --> 00:01:48,733
وَالْكِتَابُ الْمَقْرُوءُ فِيهِ [بُغْيَةُ الصَّائِمِ] لِمُصَنِّفِهِ مُحَمَّدِ بْنِ هِلَالٍ،

12
00:01:48,067 --> 00:01:48,733
وَقَدِ انْتَهَى بِنَا الْبَيَانُ

13
00:02:20,370 --> 00:02:22,370
إِلَى قَوْلِ الْمُصَنِّفِ: فَصْلٌ

14
00:02:27,941 --> 00:02:29,656
فِي حَقِيقَةِ

15
00:03:19,818 --> 00:04:11,580
الصِّيَامِ وَصِيَامِ رَمَضَانَ.

16
00:04:11,580 --> 00:04:13,188
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

17
00:04:11,580 --> 00:04:13,188
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

18
00:04:11,580 --> 00:04:13,188
وَصَلَّى اللَّهُ وَسَلَّمَ عَلَى رَسُولِهِ مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

19
00:04:11,580 --> 00:04:13,188
اللَّهُمَّ اغْفِرْ لِشَيْخِنَا وَلِوَالِدَيْهِ وَاغْفِرْ لِلْمُسْلِمِينَ أَجْمَعِينَ،

20
00:04:11,580 --> 00:04:13,188
أَقُولُ وَفَّقَكُمُ اللَّهُ فِي مَتْنِ [بُغْيَةِ الصَّائِمِ]: فَصْلٌ فِي حَقِيقَةِ

21
00:05:05,444 --> 00:05:08,635
الصِّيَامِ وَصِيَامِ رَمَضَانَ.

22
00:05:08,635 --> 00:05:09,081
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: عَقَدَ

23
00:05:27,300 --> 00:05:32,100
الْمُصَنِّفُ فَصْلًا بِبَيَانِ حَقِيقَةِ الصِّيَامِ وَصِيَامِ رَمَضَانَ،

24
00:05:32,100 --> 00:05:33,100
وَهَذَا هُوَ

25
00:06:15,243 --> 00:06:17,100
الْفَصْلُ الثَّانِي

26
00:06:24,803 --> 00:06:26,604
مِنْ كِتَابِهِ،

27
00:06:25,703 --> 00:06:27,505
وَوَقَعَ مِنْهُ ذَلِكَ بَعْدَ الْفَرَاغِ

28
00:06:37,218 --> 00:06:40,295
مِنْ بَيَانِ أَحْكَامِ صِيَامِ رَجَبٍ وَشَعْبَانَ فِي الْفَصْلِ الْمُتَقَدِّمِ،

29
00:06:39,679 --> 00:06:40,295
وَالْمُتَرْجَمُ

30
00:06:49,577 --> 00:06:50,910
بِهِ

31
00:07:20,120 --> 00:07:20,870
فِي

32
00:08:10,653 --> 00:08:13,341
هَذَا الْفَصْلِ يَتَضَمَّنُ أَمْرَيْنِ اثْنَيْنِ:

33
00:08:16,030 --> 00:08:20,300
الْأَوَّلُ:

34
00:08:20,300 --> 00:08:22,300
حَقِيقَةُ الصِّيَامِ؛ أَيْ حَدُّهُ الْمُفْصِحُ عَنْهُ الْمُبَيِّنُ لِمَضْمُونِهِ،

35
00:08:20,300 --> 00:08:22,300
وَمُوجِبُ تَأْخِيرِ ذِكْرِ حَقِيقَةِ الصِّيَامِ إِلَى الْفَصْلِ الثَّانِي

36
00:09:01,997 --> 00:09:05,053
مِنَ الْكِتَابِ عُدُولًا عَنْ ذِكْرِهِ فِي الْفَصْلِ الْأَوَّلِ مِنْهُ أَمْرَانِ

37
00:09:03,525 --> 00:09:05,053
اثْنَانِ: الْأَوَّلُ: تَقْدِيمُ مَا يُحْتَاجُ إِلَيْهِ

38
00:09:28,440 --> 00:09:30,440
مِنْ أَحْكَامِ صِيَامِ رَجَبٍ وَشَعْبَانَ؛ فَإِنَّ كَثِيرًا

39
00:10:14,940 --> 00:10:16,940
مِنَ الْخَلْقِ يَقَعُونَ

40
00:10:29,263 --> 00:10:31,641
فِي مُخَالَفَاتٍ عَدِيدَةٍ مِمَّا يَتَعَلَّقُ بِأَحْكَامِ صِيَامِ هَذَيْنِ الشَّهْرَيْنِ،

41
00:10:30,452 --> 00:10:31,641
وَالْآخَرُ: أَنَّ صِيَامَ رَمَضَانَ أَنَّ

42
00:11:31,380 --> 00:11:32,735
هَذَا

43
00:12:02,010 --> 00:12:05,177
الصِّيَامَ عَلَى الْحَقِيقَةِ

44
00:12:13,340 --> 00:12:15,340
هُوَ مِمَّا يَعْرِفُ الْخَلْقُ أَصْلَهُ وَإِنْ جَهِلُوا فَصْلَهُ؛

45
00:13:05,810 --> 00:13:08,477
فَإِنَّ الصِّيَامَ

46
00:13:08,477 --> 00:13:09,810
لَا يَخْفَى حَقِيقَةً عَلَى أَحَدٍ مِنَ الْمُسْلِمِينَ،

47
00:13:08,477 --> 00:13:09,810
فَتَأْخِيرُ ذِكْرِهِ لَا يُوجِبُ الْجَهْلَ بِهِ فَلَا يُنَفِّرُ عَنْهُ.

48
00:13:08,477 --> 00:13:09,810
وَالْمَقْصُودُ الثَّانِي: الْمُتَضَمَّنُ

49
00:13:35,323 --> 00:13:38,125
فِي هَذِهِ

50
00:13:38,125 --> 00:13:40,926
التَّرْجَمَةِ هُوَ

51
00:13:40,926 --> 00:13:42,327
قَوْلُهُ: صِيَامُ رَمَضَانَ،

52
00:13:40,926 --> 00:13:42,327
وَمُوجِبُ ذِكْرِهِ فِيهَا أَمْرَانِ اثْنَانِ أَيْضًا: الْأَوَّلُ: مُوَافَقَةً لِتَتَابُعِ نَسَقِ

53
00:13:40,926 --> 00:13:42,327
الْكِتَابِ، مُوَافَقَةً لِتَتَابُعِ نَسَقِ الْكِتَابِ؛ فَإِنَّهُ ابْتَدَأَ بِصِيَامِ رَجَبٍ وَشَعْبَانَ

54
00:13:40,926 --> 00:13:42,327
فَكَانَ اللَّائِقُ

55
00:13:56,107 --> 00:13:58,107
بِهِ أَنْ يُتْبِعَهُ بِصِيَامِ رَمَضَانَ،

56
00:13:57,440 --> 00:13:58,107
وَالثَّانِي: أَنَّ صِيَامَ رَمَضَانَ

57
00:14:06,830 --> 00:14:15,030
هُوَ أَوْجَبُ أَنْوَاعِ الصِّيَامِ،

58
00:14:15,030 --> 00:14:16,270
وَالثَّانِي

59
00:15:25,659 --> 00:15:27,438
أَنَّ صِيَامَ رَمَضَانَ هُوَ أَوْجَبُ أَنْوَاعِ الصِّيَامِ،

60
00:15:26,549 --> 00:15:27,438
وَهُوَ رُكْنٌ مِنْ أَرْكَانِ الْإِسْلَامِ كَمَا سَيَأْتِي،

61
00:15:26,549 --> 00:15:27,438
وَمَقْصُودُ الْمُصَنِّفِ بِقَوْلِهِ: صِيَامُ رَمَضَانَ؛ أَيْ

62
00:15:39,987 --> 00:15:41,865
أَحْكَامُ

63
00:15:41,865 --> 00:15:43,743
صِيَامِ رَمَضَانَ،

64
00:15:41,865 --> 00:15:43,743
وَمَقْصُودُ الْمُصَنِّفِ بِقَوْلِهِ: صِيَامُ رَمَضَانَ؛ أَيْ أَحْكَامُ صِيَامِ رَمَضَانَ،

65
00:15:41,865 --> 00:15:43,743
وَعَدَلَ عَنِ التَّعْبِيرِ بِلَفْظِ أَحْكَامٍ اخْتِصَارًا لِلتَّرْجَمَةِ؛ فَإِنَّ الْأَصْلَ فِي

66
00:15:41,865 --> 00:15:43,743
التَّرَاجِمِ الِاخْتِصَارُ فِيهَا،

67
00:15:41,865 --> 00:15:43,743
هِيَ بِمَنْزِلَةِ الْعَنَاوِينِ الْمُفْصِحَةِ عَنْ مَضْمُونِ الْفَصْلِ،

68
00:16:18,980 --> 00:16:21,116
فَلَا يَنْبَغِي أَنْ يَقَعَ

69
00:17:10,943 --> 00:17:16,467
فِيهَا تَطْوِيلٌ،

70
00:17:13,705 --> 00:17:16,467
إِنَّمَا مَا يَقَعُ مِنْ ذَلِكَ بِقَدْرِ مَا يُحْتَاجُ إِلَيْهِ

71
00:17:46,289 --> 00:17:49,546
فِي أَثْنَاءِ الْفَصْلِ.

72
00:17:47,917 --> 00:17:49,546
قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: فَهُوَ شَرْعًا الْإِمْسَاكُ بِنِيَّةٍ عَنْ أَشْيَاءَ

73
00:17:47,917 --> 00:17:49,546
مَعْلُومَةٍ مِنْ عَبْدٍ مَعْلُومٍ

74
00:18:00,280 --> 00:18:03,093
فِي وَقْتٍ مَعْلُومٍ،

75
00:18:01,687 --> 00:18:03,093
فَلَهَا مُتَعَلَّقَاتٌ خَمْسٌ: وَثَانِيهَا

76
00:18:33,927 --> 00:18:36,380
النِّيَّةُ الشَّرْعِيَّةُ،

77
00:18:35,153 --> 00:18:36,380
وَثَالِثُهَا الْمُتَعَبَّدُ بِهِ،

78
00:18:35,153 --> 00:18:36,380
وَرَابِعُهَا وَقْتُهُ،

79
00:18:35,153 --> 00:18:36,380
وَخَامِسُهَا مُفْسِدَاتُهُ،

80
00:18:35,153 --> 00:18:36,380
وَصِيَامُ رَمَضَانَ هُوَ الرُّكْنُ الْخَامِسُ

81
00:19:09,630 --> 00:19:11,786
مِنْ أَرْكَانِ الْإِسْلَامِ،

82
00:19:10,708 --> 00:19:11,786
وَتَرْكُهُ فُسُوقٌ إِلَّا لِعُذْرٍ يُتَرَخَّصُ بِهِ،

83
00:19:10,708 --> 00:19:11,786
وَمَنْ تَرَكَهُ مُتَعَمِّدًا وَجَبَ عَلَيْهِ قَضَاؤُهُ،

84
00:20:07,140 --> 00:20:10,400
فَإِنْ أَخَّرَهُ إِلَى مِثْلِهِ وَجَبَ عَلَيْهِ أَيْضًا الْإِطْعَامُ،

85
00:20:59,247 --> 00:21:01,171
فَإِنْ

86
00:21:01,171 --> 00:21:03,096
أَخَّرَهُ إِلَى مِثْلِهِ وَجَبَ عَلَيْهِ الْإِطْعَامُ.

87
00:21:01,171 --> 00:21:03,096
قَالَ الشَّارِحُ هَدَاهُ

88
00:21:09,520 --> 00:21:11,020
اللَّهُ: وَذَكَرَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ بَيَانَ حَقِيقَةِ الصِّيَامِ مُوَافِقًا

89
00:21:10,270 --> 00:21:11,020
لِمَقْصُودِ الْأَمْرِ الْأَوَّلِ

90
00:21:40,125 --> 00:21:41,408
مِنَ الْأَمْرَيْنِ الْمُتَضَمَّنَيْنِ فِي تَرْجَمَتِهِ،

91
00:21:40,767 --> 00:21:41,408
وَعَبَّرَ عَنْ حَقِيقَةِ الصِّيَامِ بِقَوْلِهِ: وَهُوَ شَرْعًا كَالْإِمْسَاكِ بِنِيَّةٍ عَنْ

92
00:21:40,767 --> 00:21:41,408
أَشْيَاءَ مَعْلُومَةٍ

93
00:21:48,827 --> 00:21:50,182
مِنْ عَبْدٍ مَعْلُومٍ فِي وَقْتٍ مَعْلُومٍ،

94
00:21:49,505 --> 00:21:50,182
وَمِمَّا يُلَاحَظُ فِي هَذَا الْحَدِّ أَمْرَانِ اثْنَانِ: الْأَوَّلُ: أَنَّهُ الْمُشَارُ

95
00:21:51,783 --> 00:21:52,091
بِهِ

96
00:22:10,872 --> 00:22:12,875
عَنِ

97
00:22:12,875 --> 00:23:30,213
الْحَدِّ الشَّرْعِيِّ،

98
00:23:59,600 --> 00:24:01,475
وَهُوَ

99
00:24:01,475 --> 00:24:03,350
الْمُشَارُ إِلَيْهِ بِقَوْلِهِ:

100
00:25:01,160 --> 00:25:03,324
وَهُوَ شَرْعًا،

101
00:25:02,242 --> 00:25:03,324
دُونَ الْحَدِّ اللُّغَوِيِّ أَوْ غَيْرِهِ،

102
00:25:02,242 --> 00:25:03,324
وَعِلَّةُ ذَلِكَ أَنَّ الْحَدَّ الشَّرْعِيَّ

103
00:25:16,043 --> 00:25:18,032
هُوَ الْمُرَادُ أَصَالَةً فِي التَّعْلِيمِ،

104
00:25:17,038 --> 00:25:19,027
وَأَمَّا غَيْرُهُ مِنَ الْحُدُودِ كَالْحَدِّ اللُّغَوِيِّ فَيُجْعَلُ كَالتَّقْدِمَةِ بَيْنَ يَدَيِ

105
00:25:18,032 --> 00:25:19,027
الْحَدِّ الشَّرْعِيِّ تَيْسِيرًا

106
00:25:52,427 --> 00:25:54,938
لَهُ

107
00:25:54,938 --> 00:25:57,450
وَتَوْطِئَةً لِبَيَانِهِ،

108
00:25:54,938 --> 00:25:57,450
وَأَمَّا دُونَ ذَلِكَ مِنَ الْحُدُودِ كَالْحَدِّ اللُّغَوِيِّ وَغَيْرِهِ فَيُجْعَلُ مُقَدِّمَةً

109
00:25:54,938 --> 00:25:57,450
بَيْنَ يَدَيِ الْحَدِّ الشَّرْعِيِّ تَيْسِيرًا لَهُ وَتَوْطِئَةً لِبَيَانِهِ،

110
00:25:54,938 --> 00:25:57,450
وَالْأَمْرُ الثَّانِي: وُقُوعُ وَصْفِ مَوَارِدِ هَذَا الْحَدِّ بِقَيْدِ الْمَعْلُومِ،

111
00:25:54,938 --> 00:25:57,450
فَفِيهِ رَدُّ هَذِهِ الْمَوَارِدِ

112
00:26:18,907 --> 00:26:21,004
إِلَى الْعِلْمِ،

113
00:26:19,956 --> 00:26:24,151
فَفِيهِ رَدُّ هَذِهِ الْمَوَارِدِ إِلَى الْعِلْمِ،

114
00:26:23,102 --> 00:26:24,151
وَهُوَ أَكْمَلُ مِمَّا شَاعَ عِنْدَ كَثِيرٍ

115
00:27:24,380 --> 00:27:26,627
مِنَ الْفُقَهَاءِ

116
00:27:31,750 --> 00:27:33,750
مِنَ التَّعْبِيرِ بِقَوْلِهِمْ: مَخْصُوصٌ،

117
00:27:32,750 --> 00:27:33,750
وَيَقُولُونَ:

118
00:28:15,136 --> 00:28:17,107
عَنْ

119
00:28:17,107 --> 00:28:19,078
أَشْيَاءَ

120
00:28:19,078 --> 00:28:21,049
مَخْصُوصَةٍ

121
00:28:25,449 --> 00:28:27,877
مِنْ عَبْدٍ مَخْصُوصٍ فِي وَقْتٍ مَخْصُوصٍ،

122
00:28:26,663 --> 00:28:27,877
وَوَجْهُ كَمَالِهِ أَنَّهُ الْوَارِدُ فِي خِطَابِ الشَّرْعِ كَمَا فِي قَوْلِهِ

123
00:28:26,663 --> 00:28:27,877
تَعَالَى: ﴿الْحَجُّ أَشْهُرٌ مَعْلُومَاتٌ﴾ فِي آيٍ أُخَرَ،

124
00:28:26,663 --> 00:28:27,877
وَقَدِ اسْتَعْمَلَهُ جَمَاعَةٌ

125
00:28:32,949 --> 00:28:34,377
مِنْ قُدَامَى الْفُقَهَاءِ كَالْإِمَامِ [مَالِكٍ] وَ[التِّرْمِذِيِّ] فِي [جَامِعِهِ]،

126
00:28:33,663 --> 00:28:34,377
فَالتَّعْبِيرُ بِهِ أَوْلَى وَالْعُدُولُ عَنْ غَيْرِهِ أَحْرَى.

127
00:28:33,663 --> 00:28:34,377
ثُمَّ بَيَّنَ هَذَا الْحَدَّ

128
00:29:28,438 --> 00:29:31,826
الَّذِي ذَكَرَهُ بِتَفْصِيلِ مُتَعَلَّقَاتِهِ

129
00:30:24,460 --> 00:30:25,460
فِي خَمْسِ مُتَعَلَّقَاتٍ مُتَعَدِّدَةٍ: أَوَّلُهَا: الْإِمْسَاكُ،

130
00:30:24,960 --> 00:30:25,460
وَهُوَ مُطَابِقٌ لِلْمَذْكُورِ فِي حَدِّ الصِّيَامِ؛ فَإِنَّهُ عَبَّرَ عَنْهُ بِلَفْظِ

131
00:30:24,960 --> 00:30:25,460
الْإِمْسَاكِ، وَالْإِمْسَاكُ

132
00:30:35,349 --> 00:30:36,238
هُوَ فَطْمُ النَّفْسِ عَنْ مَأْلُوفَاتِهَا،

133
00:30:35,793 --> 00:30:36,238
الْإِمْسَاكُ

134
00:30:40,402 --> 00:30:41,344
هُوَ فَطْمُ النَّفْسِ عَنْ مَأْلُوفَاتِهَا بِمَنْعِهَا عَمَّا اعْتَادَتْهُ مِنْهَا كَطَعَامٍ

135
00:30:40,873 --> 00:30:41,344
أَوْ شَرَابٍ أَوْ غَيْرِ ذَلِكَ،

136
00:30:40,873 --> 00:30:41,344
وَتَفْسِيرُ الصِّيَامِ بِالْإِمْسَاكِ وَقَعَ بِمُلَاحَظَةِ أَصْلِهِ اللُّغَوِيِّ،

137
00:30:40,873 --> 00:30:41,344
وَتَفْسِيرُ الصِّيَامِ بِالْإِمْسَاكِ وَقَعَ بِمُلَاحَظَةِ أَصْلِهِ اللُّغَوِيِّ؛

138
00:30:55,700 --> 00:30:57,033
فَإِنَّ الصِّيَامَ شَرْعًا فَإِنَّ الصِّيَامَ لُغَةً

139
00:31:38,650 --> 00:31:40,921
هُوَ الْإِمْسَاكُ،

140
00:31:39,786 --> 00:31:40,921
وَيَدُلُّ

141
00:32:17,720 --> 00:32:19,120
عَلَيْهِ قَوْلُهُ تَعَالَى: ﴿إِنِّي نَذَرْتُ لِلرَّحْمَنِ صَوْمًا فَلَنْ أُكَلِّمَ الْيَوْمَ

142
00:32:18,420 --> 00:32:19,120
إِنْسِيًّا﴾، ﴿إِنِّي نَذَرْتُ لِلرَّحْمَنِ صَوْمًا فَلَنْ أُكَلِّمَ الْيَوْمَ إِنْسِيًّا﴾،

143
00:32:18,420 --> 00:32:19,120
﴿إِنِّي نَذَرْتُ لِلرَّحْمَنِ صَوْمًا فَلَنْ أُكَلِّمَ الْيَوْمَ إِنْسِيًّا﴾،

144
00:32:18,420 --> 00:32:19,120
وَفِيهِ

145
00:32:24,391 --> 00:32:25,534
أَنَّ الصِّيَامَ

146
00:32:45,393 --> 00:32:47,393
فِي هَذِهِ الْآيَةِ هُوَ بِمَعْنَى الْإِمْسَاكِ

147
00:33:05,880 --> 00:33:09,616
عَنِ الْكَلَامِ كَمَا هُوَ مَذْكُورٌ فِي تَتِمَّتِهَا،

148
00:33:08,748 --> 00:33:09,616
فَيُعْلَمُ بِهِ

149
00:33:38,340 --> 00:33:39,540
أَنَّ الصِّيَامَ بِمَعْنَى الْإِمْسَاكِ.

150
00:33:38,940 --> 00:33:39,540
وَالْمُتَعَلِّقُ الثَّانِي: هُوَ النِّيَّةُ الشَّرْعِيَّةُ،

151
00:33:38,940 --> 00:33:39,540
وَهِيَ الْمَذْكُورَةُ

152
00:34:03,940 --> 00:34:05,140
فِي حَدِّ الصِّيَامِ

153
00:34:20,710 --> 00:34:22,710
فِي قَوْلِنَا: بِنِيَّةٍ؛ أَيْ مُصَاحِبًا لِلنِّيَّةِ،

154
00:34:21,710 --> 00:34:22,710
وَالْمَذْكُورُ

155
00:34:26,210 --> 00:34:47,418
فِي حَدِّ الصِّيَامِ بِقَوْلِنَا: بِنِيَّةٍ؛ أَيْ مُصَاحِبًا لِلنِّيَّةِ مُتَلَبِّسًا بِهَا،

156
00:34:47,418 --> 00:34:48,960
وَالنِّيَّةُ الشَّرْعِيَّةُ هِيَ إِرَادَةُ الْقَلْبِ الْعَمَلَ تَقَرُّبًا إِلَى اللَّهِ،

157
00:34:47,418 --> 00:34:48,960
وَالنِّيَّةُ الشَّرْعِيَّةُ

158
00:34:53,660 --> 00:34:54,260
فِي

159
00:35:19,237 --> 00:35:19,903
الصِّيَامِ تَقَعُ بِأَمْرَيْنِ،

160
00:35:19,570 --> 00:35:21,237
تَقَعُ بِأَمْرَيْنِ: أَوَّلُهُمَا: تَعْيِينُ الصَّوْمِ؛ فَيَنْوِي أَنْ يَصُومَ غَدًا أَوْ

161
00:35:22,570 --> 00:35:23,237
أَنْ يَصُومَ يَوْمَ الِاثْنَيْنِ أَوْ يَوْمَ الْخَمِيسِ أَوْ غَيْرَ ذَلِكَ،

162
00:35:22,903 --> 00:35:23,237
وَلَهُذَا أَحْكَامٌ تَتَعَلَّقُ بِهِ يَأْتِي بَيَانُهَا

163
00:35:28,100 --> 00:35:28,767
إِنْ شَاءَ اللَّهُ،

164
00:35:28,433 --> 00:35:28,767
وَالثَّانِي: إِرَادَةُ ذَلِكَ عَلَى وَجْهِ الْعِبَادَةِ،

165
00:35:28,433 --> 00:35:28,767
الثَّانِي إِرَادَةُ ذَلِكَ عَلَى وَجْهِ الْعِبَادَةِ

166
00:35:35,026 --> 00:35:36,878
لَا عَلَى وَجْهِ الْعَادَةِ،

167
00:35:39,500 --> 00:35:41,040
لَا عَلَى وَجْهِ الْعَادَةِ؛ فَيُرِيدُ التَّقَرُّبَ بِصَوْمِهِ إِلَى اللَّهِ،

168
00:35:40,270 --> 00:35:41,040
فَلَا يَصُومُ حِمْيَةً أَوْ تَفَرُّحًا أَوْ نَحْوَ ذَلِكَ مِنْ أُمُورِ

169
00:35:40,270 --> 00:35:41,040
الدُّنْيَا وَمَقَاصِدِ أَهْلِهَا،

170
00:35:40,270 --> 00:35:41,040
وَإِنَّمَا يَكُونُ ذَلِكَ لِوَجْهِ اللَّهِ،

171
00:35:40,270 --> 00:35:41,040
فَهَذِهِ وَالَّتِي تَقَدَّمَتْهَا هُمَا اللَّتَانِ تَجْمَعَانِ مَقَاصِدَ النِّيَّةُ الشَّرْعِيَّةُ

172
00:35:49,580 --> 00:35:52,580
فِي الصِّيَامِ.

173
00:35:52,580 --> 00:35:54,070
وَالنِّيَّةُ الَّتِي يَنْوِيهَا الصَّائِمُ لِصَوْمِهِ يُنَبَّهُ فِيهَا إِلَى أَمْرَيْنِ:

174
00:36:28,350 --> 00:36:31,479
الْأَوَّلُ: أَنَّهُ لَا يَضُرُّهُ بَعْدَ حُصُولِ النِّيَّةِ

175
00:37:13,680 --> 00:37:15,680
مِنْهُ الْإِتْيَانُ بِمُفْطِرٍ؛ فَمَنْ نَوَى مَثَلًا

176
00:37:35,550 --> 00:37:37,348
أَنْ

177
00:37:37,348 --> 00:37:39,145
يَصُومَ يَوْمًا

178
00:38:21,101 --> 00:38:23,435
فِي السَّاعَةِ الْوَاحِدَةِ لَيْلًا قَبْلَ بَدْئِهِ ثُمَّ تَنَاوَلَ طَعَامًا

179
00:39:04,295 --> 00:39:06,829
فِي السَّاعَةِ الثَّالِثَةِ ثُمَّ ابْتَدَى الْيَوْمَ

180
00:40:18,117 --> 00:40:20,689
الَّذِي

181
00:40:20,689 --> 00:40:23,260
أَرَى صَوْمَهُ بِطُلُوعِ فَجْرِهِ فَهَذَا قَدْ نَوَى نِيَّةً صَحِيحَةً يَصِحُّ

182
00:40:20,689 --> 00:40:23,260
بِهَا صَوْمُهُ بِهَذَا الْيَوْمِ،

183
00:40:20,689 --> 00:40:23,260
يَصِحُّ بِهَا صَوْمُهُ بِهَذَا الْيَوْمِ،

184
00:40:20,689 --> 00:40:23,260
وَلَا يَضُرُّهُ

185
00:40:24,491 --> 00:40:26,954
مَا أَتَى بِهِ

186
00:40:39,269 --> 00:40:41,552
بَعْدَ حُصُولِ النِّيَّةِ مِنْهُ،

187
00:40:40,500 --> 00:40:41,552
وَالتَّنْبِيهُ

188
00:40:56,288 --> 00:40:57,340
الثَّانِي:

189
00:40:57,340 --> 00:40:59,890
أَنَّ أَمَارَاتِ النِّيَّةِ تَدُلُّ عَلَيْهَا؛ فَمَنْ عَمَدَ إِلَى سَحُورٍ -وَهُوَ

190
00:40:57,340 --> 00:40:59,890
اسْمٌ لِلْأَكْلَةِ الَّتِي تَقَعُ

191
00:41:14,520 --> 00:41:16,735
مِنَ اللَّيْلِ

192
00:41:20,057 --> 00:41:22,273
فِي وَقْتِ السَّحَرِ- فَمَنْ عَمَدَ إِلَى هَذِهِ الْأَكْلَةِ كَانَ ذَلِكَ

193
00:41:21,165 --> 00:41:22,273
دَالًّا

194
00:42:23,100 --> 00:42:25,100
عَلَى إِرَادَةِ صَوْمِهِ لِلْيَوْمِ

195
00:42:32,100 --> 00:42:34,100
الَّذِي يَسْتَقْبِلُهُ،

196
00:42:33,100 --> 00:42:34,100
فَيَكُونُ أَمَارَةً

197
00:43:27,680 --> 00:43:30,280
عَلَى

198
00:43:30,280 --> 00:43:32,880
حُصُولِ

199
00:43:40,309 --> 00:43:44,023
النِّيَّةِ مِنْهُ،

200
00:43:42,166 --> 00:43:44,023
فَلَا يَنْبَغِي لِلْخَلْقِ أَنْ يُفَتِّشَ

201
00:43:46,380 --> 00:43:46,880
عَنْ نِيَّاتِهِمْ خَوْفًا

202
00:44:05,756 --> 00:44:07,694
مِنْ عَدَمِ حُصُولِهَا ابْتِدَاءً؛ فَإِنَّ هَذَا يُورِثُ لَهُمْ،

203
00:44:06,725 --> 00:44:07,694
وَإِنَّمَا يُكْتَفَى بِمَا يَظْهَرُ

204
00:44:10,601 --> 00:44:12,539
مِنْ أَثَرِ ذَلِكَ أَوْ يَعْلَمُهُ الْمَرْءُ

205
00:44:26,660 --> 00:44:27,860
مِنْ نَفْسِهِ،

206
00:44:27,260 --> 00:44:27,860
وَإِنَّمَا يُكْتَفَى بِمَا يَظْهَرُ

207
00:44:32,060 --> 00:44:33,260
مِنْ أَثَرِ ذَلِكَ أَوْ يَعْلَمُهُ الْمَرْءُ

208
00:44:41,247 --> 00:44:44,443
مِنْ نَفْسِهِ.

209
00:44:42,845 --> 00:44:44,443
وَالْمُتَعَلِّقُ الثَّالثُ:

210
00:45:34,723 --> 00:45:36,791
هُوَ الْمَذْكُورُ بِقَوْلِهِ: الْمُتَعَبَّدُ بِهِ،

211
00:45:35,757 --> 00:45:36,791
وَهُوَ الْمُشَارُ إِلَيْهِ

212
00:45:38,860 --> 00:45:41,096
فِي حَدِّ الصِّيَامِ بِقَوْلِهِ:

213
00:45:45,567 --> 00:45:47,803
مِنْ عَبْدٍ مَعْلُومٍ؛ فَإِنَّ الْعَبْدَ الصَّائِمَ،

214
00:45:46,685 --> 00:45:47,803
فَإِنَّ الْعَبْدَ الصَّائِمَ هُوَ الَّذِي تَعَبَّدَهُ اللَّهُ بِالصِّيَامِ؛

215
00:46:08,350 --> 00:46:09,850
أَيْ أَمَرَهُ بِهِ وُجُوبًا

216
00:46:25,300 --> 00:46:27,345
أَوِ اسْتِحْبَابًا،

217
00:46:26,323 --> 00:46:27,345
وُجُوبًا أَوِ اسْتِحْبَابًا،

218
00:46:26,323 --> 00:46:27,345
فَالتَّعْبِيرُ بِقَوْلِنَا: الْمُتَعَبَّدُ بِهِ أَوْلَى مِمَّا شَاعَ ذِكْرُهُ عِنْدَ الْفُقَهَاءِ

219
00:46:39,590 --> 00:46:41,590
مِنْ قَوْلِهِمُ: الْمُكَلَّفُ،

220
00:46:40,590 --> 00:46:41,590
فَالتَّعْبِيرُ بِقَوْلِنَا: الْمُتَعَبَّدُ بِهِ أَوْلَى مِمَّا شَاعَ ذِكْرُهُ عِنْدَ الْفُقَهَاءِ

221
00:46:42,590 --> 00:46:44,590
مِنْ قَوْلِهِمُ: الْمُكَلَّفُ،

222
00:46:43,590 --> 00:46:44,590
فَالتَّعْبِيرُ بِقَوْلِنَا: الْمُتَعَبَّدُ بِهِ أَوْلَى مِمَّا شَاعَ ذِكْرُهُ عِنْدَ الْفُقَهَاءِ

223
00:47:04,549 --> 00:47:07,034
مِنْ قَوْلِهِمُ: الْمُكَلَّفُ،

224
00:47:05,791 --> 00:47:07,034
فَالتَّعْبِيرُ بِقَوْلِنَا: الْمُتَعَبَّدُ بِهِ أَوْلَى مِمَّا شَاعَ ذِكْرُهُ عِنْدَ الْفُقَهَاءِ

225
00:47:30,090 --> 00:47:32,290
مِنْ

226
00:47:32,290 --> 00:47:34,490
قَوْلِهِمُ: الْمُكَلَّفُ،

227
00:47:32,290 --> 00:47:34,490
فَالتَّعْبِيرُ بِقَوْلِنَا: الْمُتَعَبَّدُ بِهِ أَوْلَى مِمَّا شَاعَ ذِكْرُهُ عِنْدَ الْفُقَهَاءِ

228
00:48:19,944 --> 00:48:23,349
مِنْ قَوْلِهِمُ: الْمُكَلَّفُ؛ فَإِنَّ لَفْظَ التَّكْلِيفِ أَجْنَبِيٌّ عَنِ الشَّرِيعَةِ،

229
00:48:26,755 --> 00:48:30,160
وَهُوَ جَارٍ عَلَى مَذْهَبِ الْمُعْتَزِلَةِ

230
00:48:47,693 --> 00:48:50,360
مِنْ نُفَاةِ الْحِكْمَةِ وَالتَّعْلِيلِ عَنْ أَفْعَالِ اللَّهِ عَزَّ وَجَلَّ،

231
00:48:49,027 --> 00:48:50,360
الْإِلْزَامُ بِمَا فِيهِ مَشَقَّةٌ،

232
00:48:49,027 --> 00:48:50,360
فَيَرَوْنَ

233
00:49:00,586 --> 00:49:03,022
أَنَّ أَحْكَامَ الشَّرِيعَةِ هِيَ كَيْ يَشُقَّ اللَّهُ بِهَا عَلَى الْعَبْدِ

234
00:49:01,804 --> 00:49:03,022
وَيُثَقِّلَ عَلَيْهِ لِيُبْرِزَ مَحَبَّتَهُ لَهُ وَتَعْظِيمَهُ إِيَّاهُ،

235
00:49:01,804 --> 00:49:03,022
تَعَالَى اللَّهُ عَنْ قَوْلِهِمْ،

236
00:49:01,804 --> 00:49:03,022
بَلْ أَحْكَامُ الشَّرْعِ أَحْكَامٌ يَسِيرَةٌ،

237
00:49:01,804 --> 00:49:03,022
هِيَ نُورٌ وَانْشِرَاحٌ وَهُدًى،

238
00:49:01,804 --> 00:49:03,022
وَالْمُكَلَّفُ عِنْدَهُمْ هُوَ الْمُطَالَبُ بِهَذِهِ الْأَحْكَامِ،

239
00:49:01,804 --> 00:49:03,022
