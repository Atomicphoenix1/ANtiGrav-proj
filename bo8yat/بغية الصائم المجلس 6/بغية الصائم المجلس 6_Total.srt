1
00:00:02,800 --> 00:00:04,205
الْحَمْدُ لِلَّهِ رَبِّنَا،

2
00:00:04,674 --> 00:00:07,953
وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ

3
00:00:07,953 --> 00:00:09,358
لَا شَرِيكَ لَهُ،

4
00:00:09,358 --> 00:00:12,169
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

5
00:00:12,637 --> 00:00:13,574
أَمَّا بَعْدُ،

6
00:00:14,043 --> 00:00:15,448
فَهَذَا الْمَجْلِسُ السَّادِسُ،

7
00:00:15,916 --> 00:00:17,322
بِشَرْحِ الْكِتَابِ الْأَوَّلِ،

8
00:00:17,790 --> 00:00:21,069
مِنْ بَرْنَامَجِ [عُدَّةِ رَمَضَانَ] فِي سَنَتِهِ الْأُولَى،

9
00:00:21,538 --> 00:00:24,348
سَنَةَ خَمْسٍ وَأَرْبَعِينَ وَأَرْبَعِ مِئَةٍ وَأَلْفٍ،

10
00:00:24,817 --> 00:00:26,222
وَالْكِتَابُ الْمَقْرُوءُ فِيهِ،

11
00:00:26,690 --> 00:00:27,627
[بُغْيَةُ الصَّائِمِ]،

12
00:00:28,096 --> 00:00:31,375
بِمُصَنِّفِهِ، مُحَمَّدِ بْنِ سَلَامِ بْنِ مُحَمَّدِ

13
00:00:31,375 --> 00:00:32,312
بْنِ هِلَالٍ،

14
00:00:32,800 --> 00:00:35,733
وَقَدِ انْتَهَى بِنَا الْبَيَانُ

15
00:00:35,733 --> 00:00:37,933
إِلَى قَوْلِ الْمُصَنِّفِ،

16
00:00:38,667 --> 00:00:42,333
أَصْلٌ فِي الْقَضَاءِ وَالْفِدْيَةِ وَالْكَفَّارَةِ،

17
00:00:43,067 --> 00:00:44,244
عَمِدَ؛ قَالَ

18
00:01:11,654 --> 00:01:13,362
الْمُصَنِّفُ رَحِمَهُ اللَّهُ: بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ الْحَمْدُ لِلَّهِ رَبِّ

19
00:01:12,508 --> 00:01:13,362
الْعَالَمِينَ وَصَلَّى اللَّهُ وَسَلَّمَ عَلَى نَبِيِّنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ

20
00:01:12,508 --> 00:01:13,362
أَجْمَعِينَ أَمَّا

21
00:01:23,612 --> 00:01:25,321
بَعْدُ اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا وَلِشُيُوخِهِ وَلِوَلِدَيْهِمْ وَلِمُسْلِمِينَ أَجْمَعِينَ أَقُولُ

22
00:01:24,467 --> 00:01:25,321
وَفَّقَكُمُ اللَّهُ فِي مَتْنِ [بُغْيَةِ الصَّائِمِ]،

23
00:01:26,175 --> 00:01:27,883
فَصْلٌ فِي

24
00:02:17,415 --> 00:02:19,465
الْقَضَاءِ وَالْفِدْيَةِ وَالْكَفَّارَةِ،

25
00:02:18,440 --> 00:02:19,465
وَيَجِبُ؛ قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: عَقَدَ الْمُصَنِّفُ فَصْلًا آخَرًا

26
00:02:38,529 --> 00:02:41,124
مِنْ كِتَابِهِ لِبَيَانِ أَحْكَامِ

27
00:02:43,718 --> 00:02:45,015
الْقَضَاءِ

28
00:03:43,850 --> 00:03:48,575
وَالْفِدْيَةِ وَالْكَفَّارَةِ،

29
00:03:46,213 --> 00:03:48,575
وَجَاءَ هَذَا مِنْهُ بَعْدَ فَرَاغِهِ

30
00:04:05,156 --> 00:04:07,561
مِنْ

31
00:04:07,561 --> 00:04:09,967
فَصْلِ الْمُفْطِرَاتِ لِتَعَلُّقِ هَذِهِ الثَّلَاثِ بِالْإِفْطَارِ،

32
00:04:07,561 --> 00:04:09,967
وَقَدْ تَقَدَّمَ الْإِنْبَاهُ إِلَى شَيْءٍ مِنَ الْأَحْكَامِ الْمُفْطِرَاتِ مِنَ الْأَحْكَامِ

33
00:04:07,561 --> 00:04:09,967
الْمُتَعَلِّقَةِ بِهَا غَيْرَ مَرَّةٍ بِالْفُصُولِ الْمُتَقَدِّمَةِ،

34
00:04:07,561 --> 00:04:09,967
إِلَّا أَنَّ الْمُنَاسِبَ تَكْرَارُ مَا يُحْتَاجُ إِلَيْهِ مِنْ هَذِهِ الْأَحْكَامِ

35
00:04:07,561 --> 00:04:09,967
مَعَ إِتْبَاعِهَا بِمَا يُحْتَاجُ إِلَيْهِ مِنْ تَفْصِيلَاتِهَا،

36
00:04:07,561 --> 00:04:09,967
وَلِهَذَا عَقَدَ هَذَا الْفَصْلَ

37
00:04:58,320 --> 00:05:01,573
الْمُصَنِّفُ

38
00:05:59,210 --> 00:06:00,710
الْقَضَاءَ عَلَى الْفِدْيَةِ وَالْكَفَّارَةِ بِأَمْرَيْنِ: أَنَّهُ الْأَصْلُ؛ لِأَنَّ الْأَصْلَ فِي

39
00:06:00,710 --> 00:06:03,910
عَامَّةِ مَنْ

40
00:06:34,900 --> 00:06:36,100
أَفْطَرَ أَنَّهُ يَلْزَمُهُ

41
00:06:41,500 --> 00:06:44,500
الْقَضَاءُ كَمَا سَيَأْتِي،

42
00:07:34,250 --> 00:07:38,282
وَأَمَّا

43
00:07:38,282 --> 00:07:42,314
الْفِدْيَةُ

44
00:07:38,282 --> 00:07:42,314
وَالْكَفَّارَةُ

45
00:07:38,282 --> 00:07:42,314
فَمِنْهَا

46
00:07:38,282 --> 00:07:42,314
مَا

47
00:07:38,282 --> 00:07:42,314
يَلْزَمُ

48
00:07:38,282 --> 00:07:42,314
بَعْضَ

49
00:07:38,282 --> 00:07:42,314
الْخَلْقِ

50
00:07:38,282 --> 00:07:42,314
ضُونَ

51
00:07:38,282 --> 00:07:42,314
بَعْضٍ

52
00:07:38,282 --> 00:07:42,314
وَمِنْهَا

53
00:07:38,282 --> 00:07:42,314
مَا

54
00:08:00,075 --> 00:08:02,740
لَا يَلْزَمُ أَحَدَ الْمُفْطِرِينَ،

55
00:08:01,408 --> 00:08:02,740
وَثَانِي الْقَضَاءِ هُوَ الْأَصْلُ؛ هُوَ الْوَاقِعُ بَدَلًا عَنِ الْأَدَاءِ إِذْ

56
00:08:01,408 --> 00:08:02,740
هُوَ الْوَاقِعُ بَدَلًا عَلَى نَفْسِ صُورَتِهِ،

57
00:08:01,408 --> 00:08:02,740
تَتَبَّعَ ذِكْرَ الْقَضَاءِ بِذِكْرِ الْفِدْيَةِ وَالْكَفَّارَةِ،

58
00:08:01,408 --> 00:08:26,187
وَالْفِدْيَةُ قُدِّمَتْ عَلَى الْكَفَّارَةِ بِكَوْنِهَا أَشَدَّ تَعَلُّقًا بِالْقَضَاءِ،

59
00:08:26,187 --> 00:08:28,310
فَإِنَّ مَنْ

60
00:09:13,450 --> 00:09:14,594
أَخَّرَ

61
00:09:42,398 --> 00:09:45,633
الْقَضَاءَ زَمَنًا مَعْلُومًا وَجَبَتْ عَلَيْهِ

62
00:09:45,633 --> 00:09:46,442
الْفِدْيَةُ كَمَا سَيَأْتِي،

63
00:09:45,633 --> 00:09:46,442
الْمُرَادُ بِالْفِدْيَةِ الْإِطْعَامُ وَهُوَ اللَّفْظُ الْوَارِدُ فِي الْكِتَابِ وَالسُّنَّةِ،

64
00:09:45,633 --> 00:09:46,442
الْمُصَنِّفُ فِي التَّرْجَمَةِ بِاخْتِصَارِهِ فَلَمْ يَقُلْ فِدْيَةُ إِطْعَامِ مِسْكِينٍ فَإِنَّمَا

65
00:09:45,633 --> 00:09:46,442
قَالَ فِدْيَةٌ،

66
00:09:45,633 --> 00:09:46,442
ثُمَّ ثَلَّثَ الْمُصَنِّفُ بِالْكَفَّارَةِ وَأَخَّرَهَا لِكَوْنِهَا مُتَعَلِّقَةً بِحَالٍ خَاصَّةٍ وَهِيَ

67
00:09:45,633 --> 00:09:48,560
حَالُ الْمُجَامِعِ فِي نَهَارِ رَمَضَانَ مِمَّنْ لَا يَجُوزُ

68
00:09:49,060 --> 00:09:50,060
لَهُ الْفِطْرُ كَمَا سَيَأْتِيهِ.

69
00:09:49,560 --> 00:09:50,060
قَالَ الْمُصَنِّفُ رَحِمَهُ

70
00:10:51,275 --> 00:10:53,370
اللَّهُ:

71
00:10:53,370 --> 00:10:55,465
وَيَجِبُ

72
00:11:30,822 --> 00:11:34,380
الْقَضَاءُ

73
00:11:34,380 --> 00:11:35,130
عَلَى

74
00:12:12,180 --> 00:12:13,780
مَنْ أَفْطَرَ

75
00:12:21,380 --> 00:12:21,780
فِي

76
00:12:48,472 --> 00:12:51,990
رَمَضَانَ

77
00:12:51,990 --> 00:12:54,240
وَلَوْ بِلَا عُذْرٍ،

78
00:12:51,990 --> 00:12:54,240
وَيَتَعَلَّقُ بِذِمَّتِهِ الْوُجُوبُ

79
00:13:09,055 --> 00:13:14,212
مِنْ

80
00:13:14,212 --> 00:13:19,370
حِينِ إِمْكَانِهِ،

81
00:13:14,212 --> 00:13:19,370
وَتُسْتَحَبُّ

82
00:13:14,212 --> 00:13:19,370
الْمُبَادَرَةُ

83
00:13:14,212 --> 00:13:19,370
بِهِ

84
00:13:14,212 --> 00:13:19,370
وَتَتَابُعُ أَيَّامِهِ،

85
00:13:14,212 --> 00:13:19,370
فَإِنْ

86
00:13:14,212 --> 00:13:19,370
أَخَّرَهُ

87
00:13:55,800 --> 00:13:58,080
أَوْ

88
00:13:58,080 --> 00:14:00,360
فَرَّقَهُ

89
00:14:00,360 --> 00:14:02,360
جَازَ

90
00:14:02,360 --> 00:14:06,225
مَا

91
00:14:02,360 --> 00:14:06,225
لَمْ

92
00:14:02,360 --> 00:14:06,225
يَبْلُغْ

93
00:14:02,360 --> 00:14:06,225
رَمَضَانَ

94
00:14:02,360 --> 00:14:06,225
فَيَحْرُمُ

95
00:15:05,426 --> 00:16:11,960
إِلَّا لِعُذْرٍ.

96
00:16:11,960 --> 00:16:13,293
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَيَرَى

97
00:16:24,647 --> 00:16:28,085
الْمُصَنِّفُ بِهَذِهِ الْجُمْلَةِ سَبْعَةَ أَحْكَامٍ

98
00:16:36,334 --> 00:16:39,771
مِنَ الْمُصَنَّفَاتِ الَّتِي تَتَعَلَّقُ بِالْقَضَاءِ وَهُوَ الْمَقْصِدُ الْأَوَّلُ مِنْ

99
00:16:39,771 --> 00:16:40,459
مَقَاصِدِ تَرْجَمَتِهِ،

100
00:16:39,771 --> 00:16:40,459
فَأَمَّا الْحُكْمُ الْأَوَّلُ: فَهُوَ

101
00:16:53,520 --> 00:16:54,895
فِي قَوْلِهِ: [وَيَجِبُ الْقَضَاءُ عَلَى

102
00:17:07,167 --> 00:17:08,978
مَنْ أَفْطَرَ

103
00:17:18,030 --> 00:17:18,936
فِي

104
00:17:43,405 --> 00:17:45,199
رَمَضَانَ وَلَوْ بِلَا عُذْرٍ]،

105
00:17:44,302 --> 00:17:45,199
فَفِيهِ وُجُوبُ الْقَضَاءِ عَلَى كُلِّ مُفْطِرٍ

106
00:18:18,153 --> 00:18:18,744
فِي

107
00:18:21,699 --> 00:18:22,291
رَمَضَانَ

108
00:18:58,389 --> 00:18:59,591
كَانَ ذَلِكَ بِعُذْرٍ أَمْ بِغَيْرِ عُذْرٍ،

109
00:18:58,990 --> 00:18:59,591
وَقَضَاءُ

110
00:19:06,203 --> 00:19:07,406
رَمَضَانَ وَاجِبٌ

111
00:19:16,665 --> 00:19:18,072
عَلَى الْمُتَعَمِّدِ لِثُبُوتِ أَصْلِ وُجُوبِ الصِّيَامِ

112
00:19:48,276 --> 00:19:50,800
فِي ذِمَّتِهِ فَلَا يَسْقُطُ عَنْهُ

113
00:19:59,703 --> 00:20:00,917
لَا يَسْقُطُ عَنْهُ وَهُوَ قَوْلُ الْجُمْهُورِ،

114
00:20:00,310 --> 00:20:00,917
وَأَمَّا الْحَدِيثُ الْمَشْهُورُ

115
00:20:26,060 --> 00:20:28,853
فِي

116
00:20:28,853 --> 00:20:31,647
رَمَضَانَ لَمْ يَقْضِ عَنْهُ

117
00:20:42,820 --> 00:20:45,613
صِيَامُ

118
00:20:45,613 --> 00:20:48,407
الدَّهْرِ وَإِنْ صَامَهُ لِأَنَّهُ ضَعِيفٌ

119
00:21:15,862 --> 00:21:16,733
لَا صَحَّ ضَعِيفٌ،

120
00:21:16,298 --> 00:21:19,782
أَنَّهُ يَتَعَلَّقُ بِذِمَّتِهِ الْوُجُودُ مِنْ

121
00:21:19,782 --> 00:21:20,217
حِينِ

122
00:21:30,000 --> 00:21:30,500
إِنْ

123
00:21:50,000 --> 00:21:51,000
كَانَ يُطَالَبُ بِالْقَضَاءِ

124
00:22:18,173 --> 00:22:19,440
مِنْ حِينِ إِنْ كَانَ،

125
00:22:18,807 --> 00:22:19,440
فَلَوْ قُدِّرَ أَنَّهُ لَمْ يُمْكِنْ أَنْ يَقْضِيَ لِمَرَضٍ وَنَحْوِهِ بَقِيَ

126
00:22:18,807 --> 00:22:19,440
مَعَهُ

127
00:22:43,640 --> 00:22:44,307
حَتَّى

128
00:23:19,080 --> 00:23:21,330
أَيِّ شَيْءٍ لِكَوْنِهِ لَمْ يُدْرِكْ وَقْتًا صَالِحًا لِلْقَضَاءِ أُخِّرَ أُخِّرَ

129
00:23:20,205 --> 00:23:21,330
وَهُوَ لَمْ يُدْرِكْهَا فَلَيْسَ مَأْمُورًا بِالْقَضَاءِ

130
00:23:25,830 --> 00:23:28,080
وَلَا بِشَيْءٍ تَتَعَلَّقُ بِهِ،

131
00:23:26,955 --> 00:23:28,080
وَالْحُكْمُ الثَّالِثُ: بِقَوْلِهِ: [وَتُسْتَحَبُّ الْمُبَادَرَةُ بِهِ] أَيْ بِالْقَضَاءِ،

132
00:23:26,955 --> 00:23:28,080
تُسْتَحَبُّ تَعْجِيلُ

133
00:24:11,297 --> 00:24:13,498
الْقَضَاءِ لِمَنْ كَانَ عَلَيْهِ قَضَاءٌ

134
00:24:33,700 --> 00:24:36,700
مِنْ رَمَضَانَ مَتَى أَمْكَنَ لَهُ ذَلِكَ يَجِبُ عَلَيْهِ وَإِنَّمَا يُسْتَحَبُّ

135
00:24:35,700 --> 00:24:36,700
مُجِيبُهُ أَمْرًا عَنْهُ اسْتِبَاقَ الْخَيْرَاتِ،

136
00:24:35,700 --> 00:24:36,700
﴿فَاسْتَبِقُوا الْخَيْرَاتِ﴾ يَدَّعِيهِ الْعَبْدُ بِاسْتِبَاقِ الْخَيْرَاتِ

137
00:24:54,488 --> 00:24:56,064
مَا يَكُونُ دَيْنًا عَلَيْهِ لِرَبِّهِ،

138
00:24:55,276 --> 00:24:56,064
فَـ [دَيْنُ اللَّهِ أَحَقُّ وَنَقْضَى]،

139
00:24:55,276 --> 00:24:56,064
وَالثَّانِي: احْتِمَالُ مَرَضٍ وَالشُّغْلِ يَمْنَعُ

140
00:25:38,720 --> 00:25:40,189
عَنِ الْقَضَاءِ دَائِرَةٌ بَيْنَ الْإِحْرَازِ لِلثَّقِ

141
00:26:01,680 --> 00:26:03,180
أَوِ الدَّرَجِ لِلْخَفْقِ دَائِرَةٌ بَيْنَ الْإِحْرَازِ لِلثَّقِ

142
00:26:05,430 --> 00:26:06,930
أَوِ الدَّرَجِ لِلْخَفْقِ

143
00:27:23,500 --> 00:27:25,840
الصِّيَامُ

144
00:27:25,840 --> 00:27:28,180
لِعَرَضٍ عَرَضَ،

145
00:27:25,840 --> 00:27:28,180
تَابَعَ أَيَّامَهُ: وَمِنْ جِنْسِ الْمُبَادَرَةِ أَنَّ

146
00:27:59,725 --> 00:28:02,040
مَنْ يَجْمَعُ أَيَّامَهُ الْقَضَاءَ يَجْعَلُهَا يَوْمًا تِلْوَ الْآخَرِ فَهُوَ يُبَادِرُ

147
00:28:00,882 --> 00:28:02,040
بِكُلِّ يَوْمٍ مِنْهَا

148
00:28:09,897 --> 00:28:13,040
فِي أَوَّلِ مَحَلٍّ صَالِحٍ لَهُ،

149
00:28:11,469 --> 00:28:13,040
فَالْقَوْلُ فِيهِ فَالْقَوْلُ

150
00:28:40,145 --> 00:28:42,215
فِي الْمُبَادَرَةِ،

151
00:28:47,570 --> 00:28:49,070
فِي الْمَحَلِّ الْخَامِسِ:

152
00:28:58,813 --> 00:29:00,687
فِي

153
00:29:00,687 --> 00:29:03,131
قَوْلِهِ: [فَإِنْ أَخَّرَهُ] الْقَضَاءَ

154
00:29:04,274 --> 00:29:05,417
مِنْ رَمَضَانَ إِلَى رَمَضَانَ الْقَادِمِ شَرْطٌ لِلِانْتِهَاءِ

155
00:29:08,909 --> 00:29:10,474
مِنَ الْقَضَاءِ قَوْلُهُ: [مَا لَمْ يَبْلُغْ رَمَضَانَ]،

156
00:29:09,691 --> 00:29:10,474
الْأَصْلُ فِي هَذَا مَا صَحَّ عَنْ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا

157
00:29:09,691 --> 00:29:10,474
أَنَّهَا كَانَتْ تَقْضِي مَا عَلَيْهَا

158
00:29:20,040 --> 00:29:22,707
مِنْ رَمَضَانَ فِي شَعْبَانَ نَدِيَّةً لِيَ شُغْلِهَا بِرَسُولِ اللَّهِ صَلَّى

159
00:29:21,373 --> 00:29:22,707
اللَّهُ عَلَيْهِ وَسَلَّمَ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

160
00:29:21,373 --> 00:29:22,707
حُكْمُ السَّادِسِ: فِي قَوْلِهِ: [أَوْ فَرَّقَهُ جَازَ] أَوْ فَرَّقَهُ فَإِنَّهُ

161
00:29:21,373 --> 00:29:22,707
كَمَا تَقَدَّمَ تَتَابَعَ تَتَابَعَ لِكَوْنِ تَرْكِهِ جَائِزَةً لِكَوْنِ تَرْكِهِ لِأَنَّ

162
00:29:21,373 --> 00:29:22,707
إِنْسَانًا انْتَرَكَ مُسْتَقِرٌّ يَحْكِيهِ يَحْكِيهِ لِأَنَّ إِنْسَانًا فَلَا يُقَالُ أَنَّهُ

163
00:29:21,373 --> 00:29:22,707
اتَّخَذَ مَكْرُوهًا،

164
00:29:21,373 --> 00:29:22,707
وَلَا يُقَالُ بِالْكَرَاهَةِ،

165
00:29:21,373 --> 00:29:22,707
إِلَّا حَالَ وُرُودِ النَّهْيِ،

166
00:29:21,373 --> 00:29:22,707
تَرْكُ الْفِعْلِ الْمَأْمُورِ بِهِ،

167
00:29:21,373 --> 00:29:22,707
إِنَّمَا يُجِبُ تَرْكَ الْمُسْتَحَبِّ،

168
00:29:21,373 --> 00:29:22,707
وَهَذَا يُنْزِلُ إِلَى مَرْتَبَةِ الْجَائِزِ فِي الْأَفْعَالِ،

169
00:29:21,373 --> 00:29:22,707
أَمَّا يَثْبُتُ بِنَهْيٍ مُسْتَ تَأْخِيرُ الْقَضَاءِ حَتَّى يَدْخُلَ رَمَضَانُ الْقَادِمُ،

170
00:29:21,373 --> 00:29:22,707
وَمَاتَ تَأْخِيرُ الْقَضَاءِ حَتَّى يَدْخُلَ رَمَضَانُ الْقَادِمُ،

171
00:29:21,373 --> 00:29:22,707
لِعُذْرٍ؛ قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَيَجُوزُ تَطَوُّعُ قَلْبِهِ وَلَهُ أَجْرُهُ

172
00:29:21,373 --> 00:29:22,707
سِوَى السِّتِّ

173
00:29:30,829 --> 00:29:33,544
مِنْ شَوَّالٍ.

174
00:29:32,187 --> 00:29:33,544
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: يُجْرِي الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ حُكْمَيْنِ

175
00:29:32,187 --> 00:29:33,544
اثْنَيْنِ: حُكْمُ الْأَوَّلِ: فِيمَا يَتَعَلَّقُ بِالصِّيَامِ التَّطَوُّعِ،

176
00:29:32,187 --> 00:29:33,544
أَرَادَ صِيَامَ شَيْءٍ

177
00:29:39,593 --> 00:29:40,927
مِنَ التَّطَوُّعِ وَعَلَيْهِ قَضَاءٌ

178
00:29:46,165 --> 00:29:48,117
مِنْ رَمَضَانَ،

179
00:29:47,141 --> 00:29:48,117
جَازَ لَهُ ذَلِكَ،

180
00:29:47,141 --> 00:29:48,117
كَمَنْ أَرَادَ صِيَامَ السِّتِّ

181
00:29:54,245 --> 00:29:56,332
مِنْ شَوَّالٍ،

182
00:29:55,289 --> 00:29:56,332
أَوْ أَرَادَ صِيَامَ شَيْءٍ

183
00:30:02,835 --> 00:30:05,043
مِنْ ذِي الْحِجَّةِ فِي مُبْتَدَئِهِ،

184
00:30:03,939 --> 00:30:05,043
أَوْ أَرَادَ صِيَامَ يَوْمِ عَاشُورَاءَ أَوِ اثْنَيْنِ،

185
00:30:03,939 --> 00:30:05,043
أَوْ خَمِيسٍ،

186
00:30:03,939 --> 00:30:05,043
أَوْ أَيِّ ذَلِكَ

187
00:30:10,580 --> 00:30:12,245
مِنَ النَّوَافِلِ،

188
00:30:11,413 --> 00:30:12,245
وَعَلَيْهِ قَضَاءٌ

189
00:30:15,910 --> 00:30:16,910
مِنْ رَمَضَانَ،

190
00:30:16,410 --> 00:30:16,910
جَازَ لَهُ ذَلِكَ،

191
00:31:04,872 --> 00:31:06,748
فِي

192
00:31:06,748 --> 00:31:08,624
أَصَحِّ الْقَوْلَيْنِ،

193
00:31:06,748 --> 00:31:08,624
حُكْمُ الثَّانِي:

194
00:32:32,909 --> 00:32:35,005
أَنَّهُ

195
00:32:35,005 --> 00:32:37,101
يَنَالُ أَجْرَ صِيَامِ النَّافِلَةِ

196
00:32:58,825 --> 00:33:02,138
فِي كُلِّ نَوَافِلِ

197
00:33:50,161 --> 00:33:53,987
الصِّيَامِ سِوَى السِّتِّ مِنْ شَوَّالٍ،

198
00:33:53,031 --> 00:33:53,987
فَمَنْ نَوَى صَوْمَ عَرَفَةَ وَصَامَهُ وَعَلَيْهِ قَضَاءٌ

199
00:34:13,695 --> 00:34:53,050
مِنْ رَمَضَانَ،

200
00:35:29,929 --> 00:35:30,786
لَمْ يَمْنَعْ ذَلِكَ أَنْ يُكْتَبَ لَهُ أَجْرُ صِيَامِ عَرَفَةَ،

201
00:35:30,357 --> 00:35:30,786
فَيُكَفِّرُ اللَّهُ عَنْهُ

202
00:35:52,280 --> 00:35:54,330
مِنْ سَيِّئَاتِهِ سَنَةً مَاضِيَةً وَسَنَةً مُسْتَقْبَلَةً،

203
00:35:53,305 --> 00:35:54,330
أَمَّا مَنْ صَامَ السِّتَّ مِنْ شَوَّالٍ،

204
00:35:53,305 --> 00:36:10,600
وَعَلَيْهِ قَضَاءٌ مِنْ رَمَضَانَ،

205
00:37:00,327 --> 00:37:03,370
لَمْ يَكُنْ لَهُ أَجْرُ السِّتِّ مِنْ شَوَّالٍ،

206
00:37:01,849 --> 00:37:03,370
وَالْمَذْكُورُ

207
00:37:09,456 --> 00:37:12,499
فِي حَدِيثِ أَبِي أَيُّوبَ الْأَنْصَارِيِّ: [مَنْ صَامَ رَمَضَانَ ثُمَّ أَتْبَعَهُ

208
00:37:10,977 --> 00:37:12,499
بِسِتٍّ مِنْ شَوَّالٍ،

209
00:37:10,977 --> 00:37:12,499
فَكَأَنَّهُ صَامَ الدَّهْرَ كُلَّهُ]،

210
00:37:10,977 --> 00:37:12,499
فَهَذَا لَا يُحَقِّقُ الْأَجْرَ الْمَذْكُورَ

211
00:37:24,687 --> 00:37:27,020
فِي هَذَا الْحَدِيثِ،

212
00:37:25,853 --> 00:37:27,020
وَإِنَّمَا غَايَةُ مَا يَتَحَقَّقُ

213
00:37:59,410 --> 00:38:00,410
لَهُ مِنَ الْأَجْرِ كَأَنَّهُ صَامَ سِتَّةَ أَيَّامٍ،

214
00:37:59,910 --> 00:38:00,410
وَيَنَالُ أَجْرًا بِذَلِكَ،

215
00:37:59,910 --> 00:38:00,410
فَهُوَ أَجْرُ تَطَوُّعٍ مُطْلَقٍ،

216
00:37:59,910 --> 00:38:00,410
وَمُوجِبُ فَوَاتِ أَجْرِ السِّتِّ مِنْ شَوَّالٍ،

217
00:37:59,910 --> 00:38:00,410
لِمَنْ كَانَ عَلَيْهِ قَضَاءٌ،

218
00:37:59,910 --> 00:38:00,910
أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ: [مَنْ صَامَ رَمَضَانَ

219
00:38:00,410 --> 00:38:00,910
ثُمَّ أَتْبَعَهُ بِسِتٍّ مِنْ شَوَّالٍ]،

220
00:38:00,410 --> 00:38:00,910
أَطْلَقَ حُصُولَ الْأَجْرِ

221
00:38:09,196 --> 00:38:11,767
فِي الْحَدِيثِ

222
00:38:30,204 --> 00:38:32,463
عَلَى

223
00:38:32,463 --> 00:38:34,721
صِيَامِ رَمَضَانَ ثُمَّ إِتْبَاعِهِ بِسِتٍّ مِنْ شَوَّالٍ،

224
00:38:32,463 --> 00:38:34,721
وَمَنْ عَلَيْهِ قَضَاءٌ فَإِنَّهُ

225
00:39:35,180 --> 00:39:36,380
لَمْ يَصُمْ

226
00:39:50,527 --> 00:39:52,570
رَمَضَانَ بَعْدُ،

227
00:39:51,570 --> 00:39:52,570
فَهُوَ

228
00:40:10,880 --> 00:40:13,272
لَمْ يَسْتَكْمِلْ صَوْمَهُ،

229
00:40:12,076 --> 00:40:13,272
فَيَفُوتُهُ الْأَجْرُ الْمَذْكُورُ

230
00:40:18,656 --> 00:40:22,248
فِي الْحَدِيثِ،

231
00:40:20,452 --> 00:40:22,248
وَبِهَذَا تَعْلَمُ

232
00:41:03,533 --> 00:41:05,321
أَنَّ السِّتَّ

233
00:41:32,092 --> 00:41:35,573
مِنْ شَوَّالٍ لَا يَتَحَقَّقُ أَجْرُهَا إِلَّا بَعْدَ الِانْتِهَاءِ مِنْ

234
00:41:35,573 --> 00:41:36,267
رَمَضَانَ صِيَامِهِ،

235
00:41:35,573 --> 00:41:38,347
فَمَنْ كَانَ عَلَيْهِ قَضَاءٌ لَازَمَهُ الْقَضَاءُ إِنْ أَرَادَ أَجْرَ السِّتِّ

236
00:41:37,653 --> 00:41:38,347
مِنْ شَوَّالٍ،

237
00:41:37,653 --> 00:41:38,347
نَبَّهَ إِلَى هَذِهِ الْمَسْأَلَةِ جَمَاعٌ مِنْهُمْ شَيْخُ شُيُوخِنَا مُحَمَّدُ بْنُ

238
00:41:37,653 --> 00:41:38,347
صَالِحِ بْنِ عُثَيْمِينَ وَكَذَا شَيْخُ شُيُوخِنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ

239
00:41:37,653 --> 00:41:38,347
اللَّهِ بْنِ بَازٍ

240
00:41:54,834 --> 00:41:55,691
فِي آخَرِينَ،

241
00:41:55,263 --> 00:41:55,691
وَهِيَ صَالِحَةٌ لِتَعْمِيمِهَا فِي

242
00:42:05,671 --> 00:42:06,865
صِيَامِ النَّفْلِ الْمُقَيَّتِ يَتَوَقَّفُ حُصُولُ الْأَجْرِ

243
00:42:17,154 --> 00:42:17,763
فِيهِ

244
00:42:32,350 --> 00:42:34,679
عَلَى قَيْدٍ فَيَلْزَمُ تَحْقِيقُ هَذَا الْقَيْدِ كَمَا تَقَدَّمَ الْقَوْلُ

245
00:43:02,621 --> 00:43:04,950
فِي النَّهَارِ النَّفْلِ الْمُقَيَّتِ إِذْ ذَكَرْنَا حِينَئِذٍ أَنَّهُ لَا يَقَعُ

246
00:43:03,786 --> 00:43:04,950
لَهُ أَجْرُ النَّفْلِ الْمُقَيَّتِ إِلَّا بِنِيَّةٍ

247
00:43:57,639 --> 00:43:59,487
مِنَ اللَّيْلِ،

248
00:43:58,563 --> 00:43:59,487
فَكَذَا هُنَا

249
00:44:08,785 --> 00:44:10,309
لَا يَقَعُ لَهُ أَجْرُ صِيَامِ السِّتِّ مِنْ شَوَّالٍ إِلَّا بِنِيَّةٍ

250
00:44:09,928 --> 00:44:10,309
مِنَ اللَّيْلِ أَيْضًا،

251
00:44:09,928 --> 00:44:10,309
وَبِهِ تَعْلَمُ أَنَّ صِيَامَ السِّتِّ مِنْ شَوَّالٍ لَا يَتَحَقَّقُ أَجْرُهُ

252
00:44:09,928 --> 00:44:10,309
لِصَاحِبِهِ إِلَّا بِاجْتِمَاعِ أَمْرَيْنِ: الْأَوَّلُ: أَنْ يَنْوِيَهَا مِنَ اللَّيْلِ لِكُلِّ

253
00:44:09,928 --> 00:44:10,309
لَيْلَةِ يَوْمٍ مِنَ الْأَيَّامِ الَّتِي يَصُومُهَا مِنَ السِّتِّ،

254
00:44:09,928 --> 00:44:10,309
وَالْآخَرُ: أَنْ يَكُونَ ذَلِكَ بَعْدَ انْتِهَاءِ صِيَامِ رَمَضَانَ فَإِنْ يَكُونَ

255
00:44:09,928 --> 00:44:10,309
قَدْ فَرَغَ مِنْهُ صِيَامًا وَإِنْ كَانَ عَلَيْهِ قَضَاءٌ فَيَكُونُ قَدْ

256
00:44:09,928 --> 00:44:13,356
أَتَمَّهُ؛ قَالَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ: وَتَجِبُ الْفِدْيَةُ عَلَى

257
00:44:13,356 --> 00:44:13,737
مُؤَخِّرٍ لِلْقَضَاءِ بِلَا عُذْرٍ حَتَّى بَلَغَ رَمَضَانَ،

258
00:44:13,356 --> 00:44:13,737
وَكَذَا مَرِيضٌ لَا يُرْجَى بُرْؤُهُ،

259
00:44:13,356 --> 00:44:13,737
وَتَحْصِيلُ الْفِدْيَةِ بِطَعَامِ مِسْكِينٍ.

260
00:44:13,356 --> 00:44:16,480
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ:

261
00:44:16,480 --> 00:44:16,880
يَعْنِي كُلَّهُ فَرَغَ الْمُصَنِّفُ وَصَاقَهُ اللَّهُ مِنْ تَحْقِيقِ مَا يَتَعَلَّقُ

