239
00:44:15,120 --> 00:44:17,580
وَالْمُرَادُ بِأَمِنَ تَحَرُّكَ شَهْوَتِهِ أَيْ أَمِنَ زِيَادَتَهَا،

240
00:44:15,120 --> 00:44:17,580
فَيَجُوزُ لَهُ أَنْ يُقَبِّلَ أَوْ يُبَاشِرَ كَمَا

241
00:45:22,400 --> 00:45:24,712
كَانَ

242
00:46:01,759 --> 00:46:04,127
النَّبِيُّ صَلَّى

243
00:46:04,127 --> 00:46:06,496
اللَّهُ عَلَيْهِ

244
00:46:06,496 --> 00:46:08,680
وَسَلَّمَ يَفْعَلُ مَعَ زَوْجَاتِهِ،

245
00:46:07,680 --> 00:46:08,680
فَقَدْ صَحَّ عَنْ عَائِشَةَ أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

246
00:46:07,680 --> 00:46:08,680
كَانَ يُقَبِّلُ وَهُوَ صَائِمٌ،

247
00:46:07,680 --> 00:46:08,680
وَعَلَّلَتْ وُقُوعَ ذَلِكَ مِنْهُ بِقَوْلِهَا: [فَإِنَّهُ كَانَ أَمْلَكَكُمْ لِإِرْبِهِ] أَيْ

248
00:46:07,680 --> 00:46:08,680
يَأْمَنُ عَلَى نَفْسِهِ زِيَادَةَ شَهْوَتِهِ بِذَلِكَ،

249
00:46:07,680 --> 00:46:08,680
أَيْ يَأْمَنُ عَلَى نَفْسِهِ زِيَادَةَ شَهْوَتِهِ زِيَادَةَ شَهْوَتِهِ بِذَلِكَ،

250
00:46:07,680 --> 00:46:08,680
وَالْحُكْمُ الثَّانِي: الْكَرَاهَةُ،

251
00:46:07,680 --> 00:46:08,680
وَمَحَلُّهُ

252
00:47:24,739 --> 00:47:27,342
إِذَا

253
00:47:27,342 --> 00:47:29,945
لَمْ يَأْمَنْ تَحَرُّكَ شَهْوَتِهِ

254
00:47:51,008 --> 00:47:52,349
أَيْ

255
00:48:54,569 --> 00:48:55,296
لَمْ يَأْمَنْ الزِّيَادَةَ فِيهَا

256
00:49:35,660 --> 00:49:37,993
أَيْ

257
00:50:55,040 --> 00:50:56,373
لَمْ يَأْمَنْ الزِّيَادَةَ فِيهَا أَيْ

258
00:52:00,993 --> 00:52:04,374
لَمْ يَأْمَنْ الزِّيَادَةَ فِيهَا،

259
00:52:02,684 --> 00:52:04,374
لِمَا فِيهِ

260
00:52:23,665 --> 00:52:26,382
مِنْ تَعْرِيضِ

261
00:52:45,683 --> 00:52:48,132
نَفْسِهِ

262
00:52:48,132 --> 00:52:50,580
لِمُفْطِرٍ بِمَظِنَّةٍ ضَعِيفَةٍ،

263
00:52:48,132 --> 00:52:50,580
فَيَكُونُ نَظِيرَ

264
00:53:31,088 --> 00:53:32,943
مَا

265
00:53:32,943 --> 00:53:34,798
تَقَدَّمَ

266
00:53:40,362 --> 00:53:42,216
فِي

267
00:53:42,216 --> 00:53:44,071
تَذَوُّقِ الطَّعَامِ لِغَيْرِ حَاجَةٍ وَالْمُبَالَغَةِ فِي الِاسْتِنْشَاقِ،

268
00:53:42,216 --> 00:53:44,071
الْحُكْمُ الثَّالِثُ: التَّحْرِيمُ،

269
00:53:42,216 --> 00:53:44,071
وَمَحَلُّهُ إِذَا لَمْ يَأْمَنْ تَمَادِيَهَا بِهِ

270
00:54:10,157 --> 00:54:11,490
إِلَى الْجِمَاعِ،

271
00:54:10,823 --> 00:54:11,490
لِمَا فِيهِ

272
00:55:00,650 --> 00:55:01,983
مِنْ تَعْرِيضِ نَفْسِهِ لِلْإِفْطَارِ بِمَظِنَّةٍ قَوِيَّةٍ كَاسْتِنْشَاقِ الدُّخَانِ،

273
00:55:01,317 --> 00:55:01,983
وَبِهِ تَعْلَمُ أَنَّ تَعْرِيضَ نَفْسِكَ لِلْإِفْطَارِ قَدْ يَكُونُ مَكْرُوهًا وَقَدْ

274
00:55:01,317 --> 00:55:01,983
يَكُونُ مُحَرَّمًا بِحَسَبِ قُوَّةِ الدَّاعِي فِيهِ إِلَى الْفِطْرِ،

275
00:55:01,317 --> 00:55:01,983
وَطَالِبُ الْعِلْمِ يُمَيِّزُ الْأَحْكَامَ بِقَوَاعِدِهَا

276
00:55:25,577 --> 00:55:29,986
لَا بِأَفْرَادِهَا،

277
00:55:27,781 --> 00:55:29,986
وَطَالِبُ الْعِلْمِ يُمَيِّزُ الْأَحْكَامَ بِقَوَاعِدِهَا لَا بِأَفْرَادِهَا،

278
00:55:27,781 --> 00:55:29,986
وَإِنَّ الْأَفْرَادَ تَنْحَصِرُ فِيمَا يُلْقَى إِلَيْهِ

279
00:56:35,600 --> 00:56:41,622
مِنَ الْعِلْمِ،

280
00:56:38,611 --> 00:56:41,622
أَمَّا الْقَاعِدَةُ فَيُمْكِنُ إِعْمَالُهَا فِيمَا يَتَجَدَّدُ

281
00:57:10,320 --> 00:57:13,863
لَهُ

282
00:57:26,455 --> 00:57:28,290
مِنَ

283
00:57:28,290 --> 00:57:30,125
الْأَحْكَامِ وَالْأَحْوَالِ وَالنَّوَازِلِ،

284
00:57:28,290 --> 00:57:30,125
وَهَذَا هُوَ الْعِلْمُ الْحَقِيقُ بِالتَّعَلُّمِ،

285
00:57:28,290 --> 00:57:30,125
أَمَّا أَنْ يَقْتَصِرَ عِلْمُ طَالِبِ الْعِلْمِ عَلَى مَا يُلْقَى إِلَيْهِ

286
00:57:28,290 --> 00:57:30,125
مِنَ الْأَفْرَادِ فَهَذَا يَجْعَلُ عِلْمَهُ ضَعِيفًا

287
00:57:58,260 --> 00:58:01,403
لَا يُمْكِنُ الِاعْتِمَادُ عَلَيْهِ وَالِاسْتِنَادُ إِلَيْهِ فِي الْأَحْوَالِ الْمُتَجَدِّدَةِ لِلْخَلْقِ

288
00:59:06,825 --> 00:59:09,744
فِي

289
00:59:09,744 --> 00:59:12,662
نَوَازِلِهِمْ وَفَتَاوَاهُمْ،

290
00:59:09,744 --> 00:59:12,662
فَيَحْفَظُ طَالِبُ

291
00:59:39,739 --> 00:59:42,960
الْعِلْمِ نَفْسَهُ عَنْ هَذِهِ الْحَالِ؛ ثُمَّ أَشَارَ الْمُصَنِّفُ إِلَى مَسْأَلَةٍ

292
00:59:41,349 --> 00:59:42,960
وَهِيَ كَوْنُ الشَّيْخِ كَالشَّابِّ فِيمَا تَقَدَّمَ مِنَ الْأَحْكَامِ الْمُتَعَلِّقَةِ بِالشَّهْوَةِ،

293
00:59:41,349 --> 00:59:42,960
فَإِنَّ جَمَاعَةً مِنَ الْعُلَمَاءِ فَرَّقُوا بَيْنَهُمَا،

294
00:59:41,349 --> 00:59:42,960
فَجَعَلُوا لِلشَّابِّ حُكْمَ التَّحْرِيمِ مُطْلَقًا،

295
00:59:41,349 --> 00:59:42,960
وَجَعَلُوا لِلشَّيْخِ حُكْمَ الْجَوَازِ

296
01:00:21,597 --> 01:00:24,569
أَوِ

297
01:00:24,569 --> 01:00:27,542
الْكَرَاهَةِ مُطْلَقًا وَفِيهِ نَظَرٌ،

298
01:00:24,569 --> 01:00:27,542
فَإِنَّ

299
01:01:58,128 --> 01:02:00,845
مِنَ الشَّبَابِ

300
01:03:42,305 --> 01:03:45,767
مَنْ تَكُونُ شَهْوَتُهُ ضَعِيفَةً،

301
01:03:44,036 --> 01:03:45,767
وَمِنَ الشُّيُوخِ الْكِبَارِ

302
01:03:55,020 --> 01:03:57,350
مَنْ

303
01:03:57,350 --> 01:03:59,680
تَكُونُ شَهْوَتُهُ قَوِيَّةً،

304
01:03:57,350 --> 01:03:59,680
وَمِنَ الشَّبَابِ

305
01:04:34,064 --> 01:04:35,829
مَنْ

306
01:04:35,829 --> 01:04:37,593
تَكُونُ شَهْوَتُهُ ضَعِيفَةً؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَالثَّالِثُ مَا يُضْعِفُ،

307
01:04:35,829 --> 01:04:37,593
كَالْقَيْءِ وَالْحِجَامَةِ وَالْفَصْدِ وَالرُّعَافِ وَالتَّبَرُّعِ بِالدَّمِ وَغَسِيلِ الْكِلَى وَنَحْوِهَا.

308
01:04:35,829 --> 01:04:37,593
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ثُمَّ ذَكَرَ الْمُصَنِّفُ

309
01:04:57,002 --> 01:04:58,767
الْمُفَطِّرَ

310
01:04:58,767 --> 01:05:38,080
الثَّالِثَ مِمَّا يَتَعَلَّقُ بِمُفَطِّرَاتِ الصِّيَامِ،

311
01:06:19,570 --> 01:06:22,302
وَهُوَ مَا يُضْعِفُ أَيْ مَا يُنْهِكُ الصَّائِمَ فَيَجْعَلُهُ عُرْضَةً لِعَدَمِ

312
01:06:20,936 --> 01:06:22,302
الْقُدْرَةِ عَلَى اسْتِكْمَالِ صِيَامِهِ،

313
01:06:20,936 --> 01:06:22,302
وَلَمَّا كَانَتِ الْمَظِنَّةُ فِيهِ لِلْفِطْرِ شَدِيدَةً كَانَ مُفَطِّرًا كَانَ مُفَطِّرًا،

314
01:06:20,936 --> 01:06:22,302
وَضَرَبَ لَهُ جُمْلَةً

315
01:06:53,179 --> 01:06:56,202
مِنَ الْأَمْثِلَةِ: أَوَّلُهَا: الْقَيْءُ،

316
01:06:54,690 --> 01:06:56,202
أَوَّلُهَا الْقَيْءُ

317
01:07:53,380 --> 01:07:58,450
وَهُوَ

318
01:07:58,450 --> 01:08:03,520
اسْتِفْرَاغُ

319
01:07:58,450 --> 01:08:03,520
مَا

320
01:09:26,275 --> 01:09:27,525
فِي الْمَعِدَةِ مِنْ بَقَايَا الطَّعَامِ،

321
01:09:26,900 --> 01:09:27,525
وَلَمْ يَثْبُتْ

322
01:09:41,817 --> 01:09:43,150
فِي الْفِطْرِ بِهِ شَيْءٌ مِنَ الْمَرْفُوعِ إِلَى النَّبِيِّ صَلَّى اللَّهُ

323
01:09:42,483 --> 01:09:43,150
عَلَيْهِ وَسَلَّمَ لَكِنْ ثَبَتَ عَنِ ابْنِ عُمَرَ رَضِيَ اللَّهُ عَنْهُمَا؛

324
01:09:42,483 --> 01:09:43,150
وَذَكَرَ مِثَالًا آخَرَ وَهُوَ الدَّمُ الْكَثِيرُ،

325
01:09:42,483 --> 01:09:43,150
فَإِنَّ خُرُوجَ الدَّمِ الْكَثِيرِ مُضْعِفٌ لِلصَّائِمِ بِمَا يَجْعَلُهُ عُرْضَةً لِقَطْعِ

326
01:09:42,483 --> 01:09:43,150
صِيَامِهِ، وَذَكَرَ مِنْهُ أَفْرَادًا مُتَعَدِّدَةً وَعِدَّتُهَا خَمْسَةُ أَفْرَادٍ: فَأَوَّلُهَا: الْحِجَامَةُ،

327
01:09:42,483 --> 01:09:43,150
فَأَوَّلُهَا الْحِجَامَةُ وَهِيَ إِخْرَاجُ الدَّمِ الْفَاسِدِ مِنَ الْبَدَنِ عَلَى صُورَةٍ

328
01:09:42,483 --> 01:09:43,150
مَخْصُوصَةٍ عِنْدَ أَهْلِ الطِّبِّ،

329
01:09:42,483 --> 01:09:43,150
وَالثَّانِي: الْفَصْدُ وَهُوَ مِنَ الْحِجَامَةِ أَيْضًا لَكِنَّهُ يَخْتَصُّ بِالرُّكْبَتَيْنِ وَالْقَدَمَيْنِ،

330
01:09:42,483 --> 01:09:43,150
وَالثَّالِثُ: الرُّعَافُ وَهُوَ خُرُوجُ الدَّمِ مِنَ الْأَنْفِ،

331
01:09:42,483 --> 01:09:43,150
هَذِهِ الثَّلَاثَةُ الْأَصْلُ فِيهَا خُرُوجُ دَمٍ كَثِيرٍ فَيُفْطِرُ بِهَا الصَّائِمُ

332
01:09:42,483 --> 01:09:43,150
لِمَا فِيهَا مِنْ إِضْعَافِهِ؛ ثُمَّ ذَكَرَ الْمُصَنِّفُ مِثَالَيْنِ آخَرَيْنِ مِمَّا

333
01:09:42,483 --> 01:09:43,150
تَجَدَّدَ مِنْ أَحْوَالِ الْخَلْقِ فِي هَذِهِ الْأَيَّامِ: أَوَّلُهُمَا: التَّبَرُّعُ بِالدَّمِ

334
01:09:42,483 --> 01:09:43,150
وَيُقَاسُ عَلَى الْحِجَامَةِ وَيُقَاسُ عَلَى الْحِجَامَةِ فَيُفْطِرُ بِهِ،

335
01:09:42,483 --> 01:09:43,150
وَالثَّانِي: غَسِيلُ الْكِلَى وَفِيهِ يَخْرُجُ دَمٌ كَثِيرٌ فَيَكُونُ مُفْطِرًا أَيْضًا؛

336
01:09:42,483 --> 01:09:43,150
وَالْفِطْرُ بِخُرُوجِ الدَّمِ الْكَثِيرِ مِمَّا اخْتَلَفَ فِيهِ الصَّحَابَةُ رَضِيَ اللَّهُ

337
01:09:42,483 --> 01:09:43,150
عَنْهُمْ فَمَنْ بَعْدَهُمْ،

338
01:09:42,483 --> 01:09:43,150
وَالصَّحِيحُ فِيهِ مَا قَدَّمْنَا مِنْ كَوْنِهِ مُفْطِرًا لِحَدِيثِ النَّبِيِّ صَلَّى

339
01:09:42,483 --> 01:09:43,150
اللَّهُ عَلَيْهِ وَسَلَّمَ: [أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ]،

340
01:09:42,483 --> 01:09:43,150
وَأَمَّا مَا صَحَّ عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ أَنَّهُ

341
01:09:42,483 --> 01:09:43,150
احْتَجَمَ وَهُوَ صَائِمٌ فَلَا يُدْرَى أَوَقَعَ مِنْهُ فِي سَفَرٍ أَمْ

342
01:09:42,483 --> 01:09:43,150
حَضَرٍ وَفِي حَالِ صِحَّةٍ أَمْ مَرَضٍ،

343
01:09:42,483 --> 01:09:43,150
فَلَا يُمْكِنُ الْحُكْمُ بِهِ وَلَا يُنَازَعُ بِهِ حَدِيثُ النَّبِيِّ الْمُتَقَدِّمُ

344
01:09:42,483 --> 01:09:43,150
كَمَا ذَكَرَهُ ابْنُ الْقَيِّمِ رَحِمَهُ اللَّهُ تَعَالَى،

345
01:09:42,483 --> 01:09:43,150
وَالْقَوْلُ بِالْفِطْرِ بِالْحِجَامَةِ هُوَ قَوْلُ قُدَمَاءِ الْفُقَهَاءِ مِنْ أَهْلِ الْحَدِيثِ

346
01:09:42,483 --> 01:09:43,150
كَأَبِي بَكْرِ بْنِ الْمُنْذِرِ وَأَبِي بَكْرِ بْنِ خُزَيْمَةَ وَابْنِ قُدَامَةَ

347
01:09:42,483 --> 01:09:43,150
وَغَيْرِهِمْ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَلَا يَضُرُّ الْيَسِيرُ كَتَحْلِيلِ الدَّمِ

348
01:09:42,483 --> 01:09:43,150
وَنَحْوِهِ مَا لَمْ يَكْثُرْ بِتَكْرَارِهِ.

349
01:09:42,483 --> 01:09:43,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: فَبَيَّنَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ أَنَّ

350
01:09:42,483 --> 01:09:43,150
مَا يَتَعَلَّقُ بِكَثِيرِ الدَّمِ لَيْسَ كَالْمُتَعَلِّقِ بِقَلِيلِهِ،

351
01:09:42,483 --> 01:09:43,150
فَإِنَّ قَلِيلَهُ لَا يُضْعِفُ فَلَا يُفْطِرُ بِهِ صَاحِبُهُ،

352
01:09:42,483 --> 01:09:43,150
وَمِثَالُهُ تَحْلِيلُ الدَّمِ فَإِنَّ الْأَصْلَ فِيهِ أَنَّ الدَّمَ الْخَارِجَ يَكُونُ

353
01:09:42,483 --> 01:09:43,150
يَسِيرًا فَلَا يَضُرُّ أَيْ لَا يُفْطِرُ بِهِ صَاحِبُهُ وَلَا يَحْرُمُ

354
01:09:42,483 --> 01:09:43,150
عَلَيْهِ، إِلَّا إِنِ اسْتَكْثَرَ مِنْهُ فَيُلْحَقُ بِالدَّمِ الْكَثِيرِ حُكْمًا لِوُجُودِ

355
01:09:42,483 --> 01:09:43,150
حَقِيقَتِهِ فِيهِ،

356
01:09:42,483 --> 01:09:43,150
فَإِنَّ الْقَلِيلَ الْمُسْتَمِرَّ كَالْكَثِيرِ،

357
01:09:42,483 --> 01:09:43,150
وَهَذِهِ قَاعِدَةُ الْفُقَهَاءِ لِلْقِلَّةِ وَالْكَثْرَةِ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَيُفْطِرُ

358
01:09:42,483 --> 01:09:43,150
الْحَاجِمُ إِذَا عَرَّضَ نَفْسَهُ لِلْفِطْرِ.

359
01:09:42,483 --> 01:09:43,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ثُمَّ ذَكَرَ الْمُصَنِّفُ مَسْأَلَةً أُخْرَى وَهِيَ

360
01:09:42,483 --> 01:09:43,150
مَسْأَلَةٌ تَتَعَلَّقُ بِفِطْرِ الْحَاجِمِ،

361
01:09:42,483 --> 01:09:43,150
إِذْ أَنَّ خُرُوجَ الدَّمِ مِنَ الْمَحْجُومِ يُضْعِفُ الْمَحْجُومَ نَفْسَهُ وَلَا

362
01:09:42,483 --> 01:09:43,150
يُضْعِفُ الْحَاجِمَ،

363
01:09:42,483 --> 01:09:43,150
فَاحْتِيجَ إِلَى مَعْرِفَةِ مَا يَتَعَلَّقُ بِفِطْرِهِ،

364
01:09:42,483 --> 01:09:43,150
وَرَجَّحَ الْمُصَنِّفُ أَنَّهُ يُفْطِرُ بِشَرْطِ أَنْ يُعَرِّضَ نَفْسَهُ لِلْفِطْرِ،

365
01:09:42,483 --> 01:09:43,150
كَالْمَعْرُوفِ مِنْ أَهْلِ الْحِجَامَةِ قَدِيمًا أَنَّهُمْ يَمْتَصُّونَ الدَّمَ بِآلَةٍ يُعَرِّضُونَ

366
01:09:42,483 --> 01:09:43,150
فِيهَا أَفْوَاهَهُمْ وَأَجْوَافَهُمْ لِهَذَا الدَّمِ،

367
01:09:42,483 --> 01:09:43,150
وَالْمَظِنَّةُ فِيهِ قَوِيَّةٌ شَدِيدَةٌ فَيَكُونُ ذَلِكَ مُفَطِّرًا،

368
01:09:42,483 --> 01:09:43,150
وَفِيهِ حَدِيثُ النَّبِيِّ الَّذِي تَقَدَّمَ فَإِنَّهُ قَالَ: [أَفْطَرَ الْحَاجِمُ وَالْمَحْجُومُ]،

369
01:09:42,483 --> 01:09:43,150
فَإِذَا خَلَا الْحَاجِمُ مِنْ هَذَا الشَّرْطِ كَانَ مَصُّ الدَّمِ بِآلَةٍ

370
01:09:42,483 --> 01:09:43,150
لَا تُعَرِّضُهُ لِلْفِطْرِ كَجُمْلَةٍ مِنَ الْآلَاتِ الْحَدِيثَةِ لَمْ يَكُنْ ذَلِكَ

371
01:09:42,483 --> 01:09:43,150
سَبَبًا لِفِطْرِهِ،

372
01:09:42,483 --> 01:09:43,150
فَيَكُونُ قَوْلُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مُعَلَّقًا فَقَطْ بِمَنْ

373
01:09:42,483 --> 01:09:43,150
يَمُصُّ الدَّمَ بِنَفْسِهِ أَوْ بِآلَةٍ تُعَرِّضُهُ لِلْفِطْرِ دُونَ غَيْرِهِ لِعَدَمِ

374
01:09:42,483 --> 01:09:43,150
الْعِلَّةِ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَالرَّابِعَةُ خُرُوجُ دَمِ الْحَيْضِ أَوِ

375
01:09:42,483 --> 01:09:43,150
النِّفَاسِ. قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ

376
01:09:42,483 --> 01:09:43,150
الْمُفَطِّرَ الرَّابِعَ مِنَ الْمُفَطِّرَاتِ،

377
01:09:42,483 --> 01:09:43,150
وَأَخَّرَ ذِكْرَهُ لِتَعَلُّقِهِ بِالنِّسَاءِ فَقَطْ دُونَ غَيْرِهِنَّ،

378
01:09:42,483 --> 01:09:43,150
وَهُوَ خُرُوجُ دَمِ الْحَيْضِ أَوِ النِّفَاسِ،

379
01:09:42,483 --> 01:09:43,150
فَتُفْطِرُ الْمَرْأَةُ إِجْمَاعًا إِذَا خَرَجَ مِنْهَا دَمُ حَيْضٍ أَوِ نِفَاسٍ،

380
01:09:42,483 --> 01:09:43,150
وَالْحَيْضُ دَمُ جِبِلَّةٍ أَيْ خِلْقَةٍ يَخْرُجُ مِنْ رَحِمِ الْمَرْأَةِ فِي

381
01:09:42,483 --> 01:09:43,150
أَوْقَاتٍ مَعْلُومَةٍ،

382
01:09:42,483 --> 01:09:43,150
وَأَمَّا دَمُ النِّفَاسِ وَهُوَ دَمٌ يَخْرُجُ مِنَ الْمَرْأَةِ فِي الْوِلَادَةِ

383
01:09:42,483 --> 01:09:43,150
وَيَبْقَى بَعْدَهَا مُدَّةً،

384
01:09:42,483 --> 01:09:43,150
فَمَنْ خَرَجَ مِنْهَا هَذَا أَوْ ذَاكَ فَقَدْ أَفْطَرَتْ؛ قَالَ الْمُصَنِّفُ

385
01:09:42,483 --> 01:09:43,150
حَفِظَهُ اللَّهُ: وَلَا تَكُونُ مُفَطِّرَةً سِوَى الرَّابِعِ إِلَّا بِثَلَاثَةِ شُرُوطٍ:

386
01:09:42,483 --> 01:09:43,150
الْأَوَّلُ الْعِلْمُ بِالْفِطْرِ مَعَ ذِكْرِهِ،

387
01:09:42,483 --> 01:09:43,150
فَمَنْ جَهِلَهُ لَمْ يُفْطِرْ بِهَا إِلَّا مَعَ ظُهُورِ الْحُكْمِ أَوْ

388
01:09:42,483 --> 01:09:43,150
تَفْرِيطٍ فِي تَعَلُّمِهِ،

389
01:09:42,483 --> 01:09:43,150
وَمَنْ نَسِيَهُ لَمْ يُؤَاخَذْ بِهِ.

390
01:09:42,483 --> 01:09:43,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: أَشَارَ الْمُصَنِّفُ فِي هَذِهِ الْجُمْلَةِ إِلَى

391
01:09:42,483 --> 01:09:43,150
شُرُوطِ الْمُفَطِّرَاتِ وَهِيَ ثَلَاثَةُ شُرُوطٍ،

392
01:09:42,483 --> 01:09:43,150
وَهَذِهِ الشُّرُوطُ تَتَعَلَّقُ بِالْمُفَطِّرَاتِ الثَّلَاثَةِ الْأُولَى لَا بِالْمُفَطِّرِ الرَّابِعِ،

393
01:09:42,483 --> 01:09:43,150
فَأَوَّلُ هَذِهِ الشُّرُوطِ: الْعِلْمُ بِالْحُكْمِ أَيْ بِكَوْنِهِ مُفَطِّرًا،

394
01:09:42,483 --> 01:09:43,150
وَيُشْتَرَطُ مَعَ الْعِلْمِ الذِّكْرُ أَيْ التَّذَكُّرُ،

395
01:09:42,483 --> 01:09:43,150
فَإِنَّ النِّسْيَانَ جَهْلٌ مُؤَقَّتٌ فَلَا يَتَحَقَّقُ لِلْعَبْدِ كَمَالُ الْعِلْمِ إِلَّا

396
01:09:42,483 --> 01:09:43,150
مَعَ الذِّكْرِ؛ ثُمَّ ذَكَرَ الْمُصَنِّفُ حَالَيْنِ اثْنَيْنِ يُخَالِفَانِ مَا تَقَدَّمَ

397
01:09:42,483 --> 01:09:43,150
مِنْ شَرْطِ الْعِلْمِ وَذِكْرِهِ: الْحَالُ الْأُولَى: الْجَهْلُ أَيْ الْجَهْلُ بِالْحُكْمِ،

398
01:09:42,483 --> 01:09:43,150
فَمَنْ جَهِلَ حُكْمَ مُفَطِّرٍ لَمْ يُفْطِرْ بِهِ إِنْ كَانَ مِنْ

399
01:09:42,483 --> 01:09:43,150
أَهْلِ الْعُذْرِ بِالْجَهْلِ،

400
01:09:42,483 --> 01:09:43,150
وَيَخْرُجُ عَنْ كَوْنِهِ مَعْذُورًا بِالْجَهْلِ فِيمَا ذَكَرَهُ الْمُصَنِّفُ فِي حَالَيْنِ:

401
01:09:42,483 --> 01:09:43,150
الْحَالُ الْأُولَى: ظُهُورُ الْحُكْمِ بِأَنْ يَكُونَ مَشْهُورًا مُسْتَفِيضًا فِي الْمُسْلِمِينَ

402
01:09:42,483 --> 01:09:43,150
كَالْفِطْرِ بِالطَّعَامِ وَالشَّرَابِ،

403
01:09:42,483 --> 01:09:43,150
فَمَنْ ادَّعَى الْجَهْلَ بِهَذَا الْحُكْمِ لَمْ يُعْذَرْ بِجَهْلِهِ بِهِ بَلْ

404
01:09:42,483 --> 01:09:43,150
هُوَ مُتَجَاهِلٌ لَهُ وَمُتَغَافِلٌ عَنْهُ،

405
01:09:42,483 --> 01:09:43,150
وَالْحَالُ الثَّانِيَةُ: مَنْ فَرَّطَ فِي تَعَلُّمِ مَا يَحْتَاجُ إِلَيْهِ مِنَ

406
01:09:42,483 --> 01:09:43,150
الْأَحْكَامِ، وَمَحَلُّهُ فِيمَنْ آنَسَ مِنْ نَفْسِهِ الْحَاجَةَ إِلَى التَّعَلُّمِ فَعَنَّ

407
01:09:42,483 --> 01:09:43,150
لَهُ سُؤَالٌ أَوْ وَجَدَ فِي نَفْسِهِ جَهْلًا أَوْ نَحْوَ ذَلِكَ،

408
01:09:42,483 --> 01:09:43,150
فَهَذَا إِنْ لَمْ يَسْعَ فِي طَلَبِ مَا يَحْتَاجُهُ مِنَ الْعِلْمِ

409
01:09:42,483 --> 01:09:43,150
فَوَقَعَ فِي مُفَطِّرٍ لِذَلِكَ فَقَدْ أَفْطَرَ لِتَفْرِيطِهِ؛ وَمِمَّا يَتَعَلَّقُ بِهَذِهِ

410
01:09:42,483 --> 01:09:43,150
الْمَسْأَلَةِ أَحْوَالُ عُمُومِ النَّاسِ،

411
01:09:42,483 --> 01:09:43,150
وَلَوْ سَأَلَ سَائِلٌ مَاذَا يَتَعَلَّقُ بِعُمُومِ النَّاسِ بِهَذِهِ الْمَسْأَلَةِ؟

412
01:09:42,483 --> 01:09:43,150
فَإِنَّهُمْ يَجْهَلُونَ الْأَحْكَامَ الشَّرْعِيَّةَ الْمُتَعَلِّقَةَ بِالصِّيَامِ خَاصَّةً الْمُفَطِّرَاتِ،

413
01:09:42,483 --> 01:09:43,150
وَيَجْهَلُونَ أَنَّهُمْ يَجْهَلُونَ هَذَا الْعِلْمَ فَلَا يَدْرُونَ أَنَّهُمْ بِحَاجَةٍ إِلَى

414
01:09:42,483 --> 01:09:43,150
تَعَلُّمِهَا فِيمَا يُعْرَفُ عِنْدَ الْمُتَأَخِّرِينَ بِاسْمِ الْجَهْلِ الْمُرَكَّبِ،

415
01:09:42,483 --> 01:09:43,150
وَالْجَوَابُ أَنَّ هَذَا مَعْذُورٌ بِجَهْلِهِ فَإِنَّهُ لَمْ يَتَعَمَّدْ تَرْكَ طَلَبِ

416
01:09:42,483 --> 01:09:43,150
مَا يَحْتَاجُهُ وَإِنَّمَا خَفِيَتْ عَلَيْهِ حَاجَتُهُ لَهُ،

417
01:09:42,483 --> 01:09:43,150
وَالْوَاجِبُ عَلَى طُلَّابِ الْعِلْمِ أَنْ يَنْشُرُوا الْعِلْمَ النَّافِعَ الَّذِي يَحْتَاجُ

418
01:09:42,483 --> 01:09:43,150
النَّاسُ إِلَيْهِ لِأَنْ لَا يَقَعُوا بِمِثْلِ هَذَا الْجَهْلِ،

419
01:09:42,483 --> 01:09:43,150
فَإِنَّ الدَّعْوَةَ أَصْلٌ مِنْ أُصُولِ دِينِنَا؛ ثُمَّ ذَكَرَ الْحَالَةَ الثَّانِيَةَ

420
01:09:42,483 --> 01:09:43,150
وَهِيَ حَالُ النِّسْيَانِ،

421
01:09:42,483 --> 01:09:43,150
فَذَكَرَ أَنَّهُ مَنْ نَسِيَ فَأَفْطَرَ فَإِنَّهُ لَا يُؤَاخَذُ بِذَلِكَ فَإِنَّ

422
01:09:42,483 --> 01:09:43,150
النِّسْيَانَ عُذْرٌ كَمَا تَقَدَّمَ،

423
01:09:42,483 --> 01:09:43,150
وَفِي حَدِيثِ الرَّجُلِ الَّذِي جَعَلَ خَيْطَيْنِ أَحَدُهُمَا أَبْيَضُ وَالْآخَرُ أَسْوَدُ

424
01:09:42,483 --> 01:09:43,150
تَحْتَ وِسَادَتِهِ فَأَكَلَ وَشَرِبَ حَتَّى الصَّبَاحِ مُنْتَظِرًا تَمَيُّزَ الْخَيْطَيْنِ عَنْ

425
01:09:42,483 --> 01:09:43,150
بَعْضِهِمَا وَحَكَى ذَلِكَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ،

426
01:09:42,483 --> 01:09:43,150
فَأَخْبَرَهُ النَّبِيُّ بِتَوْكِيلِهِ مِنْ خُرُوجِ اللَّيْلِ وَطُلُوعِ الْفَجْرِ وَلَمْ يَأْمُرْهُ

427
01:09:42,483 --> 01:09:43,150
بِالْإِعَادَةِ، فَأَمَّا النِّسْيَانُ فَيَدُلُّ لَهُ قَوْلُهُ تَعَالَى: ﴿رَبَّنَا لَا تُؤَاخِذْنَا

428
01:09:42,483 --> 01:09:43,150
إِنْ نَسِينَا أَوْ أَخْطَأْنَا﴾،

429
01:09:42,483 --> 01:09:43,150
قَالَ ابْنُ عَبَّاسٍ رَضِيَ اللَّهُ عَنْهُ: [قَالَ اللَّهُ تَعَالَى: قَدْ

430
01:09:42,483 --> 01:09:43,150
فَعَلْتُ]؛ طَيِّبٌ،

431
01:09:42,483 --> 01:09:43,150
أَلَا يُغْنِي عَنْهُ حَدِيثُ: [رُفِعَ عَنْ أُمَّتِي الْخَطَأُ وَالنِّسْيَانُ وَمَا

432
01:09:42,483 --> 01:09:43,150
اسْتُكْرِهُوا عَلَيْهِ]؟

433
01:09:42,483 --> 01:09:43,150
جَوَابُهُ: لَا،

434
01:09:42,483 --> 01:09:43,150
فَاللَّهُ فِي إِسْنَادِهِ مَقَالٌ وَفِي صِحَّتِهِ نَظَرٌ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ

435
01:09:42,483 --> 01:09:43,150
اللَّهُ: الثَّانِي الْعِلْمُ بِالْوَقْتِ مَعَ ذِكْرِهِ،

436
01:09:42,483 --> 01:09:43,150
الثَّالِثُ التَّعَمُّدُ،

437
01:09:42,483 --> 01:09:43,150
فَمَنْ أَتَى بِمُفَطِّرٍ دُونَ قَصْدٍ مِنْهُ لَمْ يُفْطِرْ بِهِ كَمُكْرَهٍ

438
01:09:42,483 --> 01:09:43,150
وَمُصَابٍ يَنْزِفُ وَغَيْرِهِ.

439
01:09:42,483 --> 01:09:43,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ شَرْطَيْنِ آخَرَيْنِ لِلْفِطْرِ: أَحَدُهُمَا:

440
01:09:42,483 --> 01:09:43,150
الْعِلْمُ بِالْوَقْتِ مَعَ ذِكْرِهِ،

441
01:09:42,483 --> 01:09:43,150
وَيُقَالُ فِيهِ كَالْقَوْلِ فِي الشَّرْطِ الْمُتَقَدِّمِ لِأَنَّ لِلْوَقْتِ فِي الصِّيَامِ

442
01:09:42,483 --> 01:09:43,150
أَحْكَامًا كَمَا تَقَدَّمَ فِي الدُّرُوسِ الْمُتَقَدِّمَةِ،

443
01:09:42,483 --> 01:09:43,150
فَالْعِلْمُ بِالْوَقْتِ مِنْهُ مَا يَكُونُ مِنَ الْعِلْمِ بِالْحُكْمِ،

444
01:09:42,483 --> 01:09:43,150
وَأَمَّا الْعِلْمُ بِالْوَقْتِ الَّذِي لَا مُتَعَلَّقَ لَهُ بِالْعِلْمِ بِالْحُكْمِ كَالْعِلْمِ

445
01:09:42,483 --> 01:09:43,150
بِدُخُولِهِ أَوْ خُرُوجِهِ فَإِنَّهُ أَيْضًا شَرْطٌ لِلْإِفْطَارِ،

446
01:09:42,483 --> 01:09:43,150
فَمَنْ جَهِلَ دُخُولَ وَقْتِ الْفَجْرِ فَأَكَلَ يَظُنُّ أَنَّ الْفَجْرَ لَمْ

447
01:09:42,483 --> 01:09:43,150
يَطْلُعْ أَوْ جَهِلَ نِسْيَانًا أَنَّهُ طَلَعَ فَإِنَّهُ لَا يُفْطِرُ بِذَلِكَ

448
01:09:42,483 --> 01:09:43,150
وَلَا يَلْزَمُهُ الْقَضَاءُ فِي أَصَحِّ الْقَوْلَيْنِ،

449
01:09:42,483 --> 01:09:43,150
فَهُوَ كَمَنْ أَكَلَ أَوْ شَرِبَ نَاسِيًا خِلَالَ يَوْمِهِ،

450
01:09:42,483 --> 01:09:43,150
وَقَدْ تَقَدَّمَ فِيهِ قَوْلُ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: [مَنْ

451
01:09:42,483 --> 01:09:43,150
أَكَلَ أَوْ شَرِبَ وَهُوَ صَائِمٌ فَلْيُتِمَّ صَوْمَهُ،

452
01:09:42,483 --> 01:09:43,150
فَإِنَّمَا أَطْعَمَهُ اللَّهُ وَسَقَاهُ]،

453
01:09:42,483 --> 01:09:43,150
وَالشَّرْطُ الْأَخِيرُ: التَّعَمُّدُ بِأَنْ يَقْصِدَ فِعْلَ الْمُفَطِّرِ وَيَقْصِدَ الْفِطْرَ بِهِ،

454
01:09:42,483 --> 01:09:43,150
فَمَنْ لَمْ يَقْصِدِ الْفِطْرَ أَوْ لَمْ يَقْصِدِ الْمُفَطِّرَ فَلَيْسَ بِمُتَعَمِّدٍ

455
01:09:42,483 --> 01:09:43,150
فَلَا يُفْطِرُ،

456
01:09:42,483 --> 01:09:43,150
مِمَّنْ لَا يَقْصِدُ الْمُفَطِّرَ الْمُكْرَهُ الَّذِي أُكْرِهَ عَلَى اسْتِعْمَالِ مُفَطِّرٍ

457
01:09:42,483 --> 01:09:43,150
مِنَ الْمُفَطِّرَاتِ،

458
01:09:42,483 --> 01:09:43,150
وَالْإِكْرَاهُ هُوَ عُذْرٌ بِالْإِجْمَاعِ،

459
01:09:42,483 --> 01:09:43,150
وَكَذَا مَنْ نَزَفَ أَيْ نَزَلَ مِنْهُ دَمٌ كَثِيرٌ لِكَوْنِهِ أُصِيبَ

460
01:09:42,483 --> 01:09:43,150
فَلَيْسَ بِمُتَعَمِّدٍ لِنُزُولِ الدَّمِ فَلَا يُفْطِرُ بِهِ،

461
01:09:42,483 --> 01:09:43,150
وَمِثَالُ مَنْ لَا يَقْصِدُ الْفِطْرَ كَالنَّاسِي هُوَ رَجُلٌ أَكَلَ أَوْ

462
01:09:42,483 --> 01:09:43,150
شَرِبَ نَاسِيًا فَإِنَّهُ قَصَدَ الْمُفَطِّرَ وَلَمْ يَقْصِدِ الْإِفْطَارَ؛ طَيِّبٌ،

463
01:09:42,483 --> 01:09:43,150
هُنَا مَسْأَلَةٌ: رَجُلٌ قَصَدَ الْإِفْطَارَ وَلَمْ يَقْصِدْ مُفَطِّرًا كَرَجُلٍ نَوَى

464
01:09:42,483 --> 01:09:43,150
أَنْ يُفْطِرَ وَلَمْ يَعْمِدْ إِلَى مُفَطِّرٍ لَا طَعَامٍ وَلَا شَرَابٍ

465
01:09:42,483 --> 01:09:43,150
وَلَا نَحْوِ ذَلِكَ،

466
01:09:42,483 --> 01:09:43,150
فَهَلْ يُفْطِرُ؟

467
01:09:42,483 --> 01:09:43,150
فَهَلْ يُفْطِرُ؟

468
01:09:42,483 --> 01:09:43,150
الْجَوَابُ: نَعَمْ،

469
01:09:42,483 --> 01:09:43,150
فَإِنَّ الصِّيَامَ انْعَقَدَ بِالنِّيَّةِ،

470
01:09:42,483 --> 01:09:43,150
فَإِنْ نَوَى إِبْطَالَهُ بَطَلَ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَلَا يَضُرُّ

471
01:09:42,483 --> 01:09:43,150
اسْتِعْمَالُهُ الْمَاءَ لِلتَّبَرُّدِ أَوْ لِلْغُصَّةِ.

472
01:09:42,483 --> 01:09:43,150
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: ذَكَرَ الْمُصَنِّفُ بِهَذِهِ الْجُمْلَةِ حُكْمَ اسْتِعْمَالِ

473
01:09:42,483 --> 01:09:43,150
الْمَاءِ لِلصَّائِمِ وَهُوَ الْجَوَازُ،

474
01:09:42,483 --> 01:09:43,150
فَقَوْلُهُ: «لَا يَضُرُّ» يُرَادُ بِهِ الْإِبَاحَةُ،

475
01:09:42,483 --> 01:09:43,150
فَيُبَاحُ لِلصَّائِمِ اسْتِعْمَالُ الْمَاءِ لِلتَّبَرُّدِ أَوْ لِلْغُصَّةِ أَوْ نَحْوِ ذَلِكَ،

476
01:09:42,483 --> 01:09:43,150
فَلَيْسَ هَذَا مِمَّا يَتَعَلَّقُ بِشَيْءٍ مِنَ الْمُفَطِّرَاتِ أَوْ مِمَّا نُهِيَ

477
01:09:42,483 --> 01:09:43,150
عَنْهُ، وَفِي حَدِيثٍ مَرْفُوعٍ إِلَى النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

478
01:09:42,483 --> 01:09:43,150
أَنَّهُ اغْتَسَلَ وَتَبَرَّدَ وَهُوَ صَائِمٌ إِلَّا أَنَّهُ مُنْكَرٌ،

479
01:09:42,483 --> 01:09:43,150
فَيُكْتَفَى بِالْأَصْلِ الْعَامِّ فِي ذَلِكَ؛ بَقِيَ الْإِنْبَاهُ إِلَى مَسْأَلَةٍ وَهِيَ:

480
01:09:42,483 --> 01:09:43,150
هَلْ يُفْطِرُ الصَّائِمُ بِشَيْءٍ مِنَ الْمَعَاصِي؟

481
01:09:42,483 --> 01:09:43,150
وَتَخْتَلِفُ فِيهَا الْعُلَمَاءُ عَلَى قَوْلَيْنِ: الْأَوَّلُ: أَنَّهُ لَا يُفْطِرُ بِشَيْءٍ

482
01:09:42,483 --> 01:09:43,150
مِنَ الْمَعَاصِي وَهُوَ قَوْلُ الْجُمْهُورِ،

483
01:09:42,483 --> 01:09:43,150
وَالثَّانِي: أَنَّهُ يُفْطِرُ بِالْكَبَائِرِ وَخَاصَّةً الْكَذِبَ وَالْغِيبَةَ،

484
01:09:42,483 --> 01:09:43,150
وَاخْتِيَارُ ابْنِ تَيْمِيَّةَ الْحَفِيدِ وَابْنِ حَزْمٍ،

485
01:09:42,483 --> 01:09:43,150
وَالرَّاجِحُ الْأَوَّلُ،

486
01:09:42,483 --> 01:09:43,150
فَلَا يُفْطِرُ بِشَيْءٍ مِنَ الْمَعَاصِي دُونَ الْكُفْرِ،

487
01:09:42,483 --> 01:09:43,150
إِلَّا أَنَّ ذَلِكَ يَنْقُصُ مِنْ أَجْرِهِ فَلْيَحْذَرِ الصَّائِمُ مِنْ ذَلِكَ؛

488
01:09:42,483 --> 01:09:43,150
وَهَذَا آخِرُ الْبَيَانِ عَلَى هَذَا الْقَوْلِ مِنَ الْكِتَابِ،

489
01:09:42,483 --> 01:09:43,150
سَنَسْتَكْمِلُ بَقِيَّتَهُ إِنْ شَاءَ اللَّهُ فِي الْمَجْلِسِ الْقَادِمِ،

490
01:09:42,483 --> 01:09:43,150
سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ،

491
01:09:42,483 --> 01:09:43,150
أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ،

492
01:09:42,483 --> 01:09:43,150
أَسْتَغْفِرُكَ وَأَتُوبُ إِلَيْكَ،

493
01:09:42,483 --> 01:09:43,150
وَاللَّهُ أَعْلَمُ،

494
01:09:42,483 --> 01:09:43,150
صَلَّى اللَّهُ عَلَى مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ وَسَلَّمَ،

495
01:09:42,483 --> 01:09:43,150
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.
