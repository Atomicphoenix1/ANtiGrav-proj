1
00:00:00,370 --> 00:00:02,770
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ

2
00:00:05,576 --> 00:00:06,278
اللَّهِ وَبَرَكَاتُهُ،

3
00:00:05,927 --> 00:00:06,278
الْحَمْدُ لِلَّهِ رَبِّنَا،

4
00:00:07,330 --> 00:00:09,346
وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

5
00:00:08,674 --> 00:00:10,690
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

6
00:00:10,690 --> 00:00:13,719
أَمَّا بَعْدُ؛ فَهَذَا الْمَجْلِسُ الْخَامِسُ فِي

7
00:00:13,719 --> 00:00:16,747
شَرْحِ الْكِتَابِ الْأَوَّلِ مِنْ بَرْنَامَجِ [عُدَّةِ

8
00:00:16,747 --> 00:00:19,776
رَمَضَانَ] فِي سَنَتِهِ الْأُولَى سَنَةَ خَمْسٍ

9
00:00:19,776 --> 00:00:21,290
وَأَرْبَعِينَ وَأَرْبَعِمِائَةٍ وَأَلْفٍ،

10
00:00:21,290 --> 00:00:24,221
وَالْكِتَابُ الْمَقْرُوءُ فِيهِ [بُغْيَةُ الصَّائِمِ]

11
00:00:24,221 --> 00:00:27,152
لِمُصَنِّفِهِ مُحَمَّدِ بْنِ سَلَّامِ بْنِ

12
00:00:27,152 --> 00:00:28,910
مُحَمَّدِ بْنِ هِلَالٍ،

13
00:00:28,910 --> 00:00:32,104
وَقَدِ انْتَهَى بِنَا الْبَيَانُ

14
00:00:32,104 --> 00:00:35,298
إِلَى قَوْلِ الْمُصَنِّفِ: «وَلَا

15
00:00:35,298 --> 00:00:39,290
يُفْطِرُ بِابْتِلَاعِ نُخَامَةٍ وَيَحْرُمُ عَلَيْهِ»،

16
00:00:39,290 --> 00:00:42,085
نَعَمْ؛ قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ:

17
00:00:42,085 --> 00:00:42,833
بِسْمِ

18
00:01:02,487 --> 00:01:03,593
اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

19
00:01:03,040 --> 00:01:03,593
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

20
00:01:03,040 --> 00:01:03,593
وَالصَّلَاةُ وَالسَّلَامُ عَلَى النَّبِيِّ مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

21
00:01:03,040 --> 00:01:03,593
أَمَّا بَعْدُ؛ اللَّهُمَّ اغْفِرْ لِشَيْخِنَا وَلِوَالِدَيْهِ وَلِشُيُوخِهِ وَلِشُيُوخِ شُيُوخِهِ وَالْمُسْلِمِينَ

22
00:01:03,040 --> 00:01:06,170
أَجْمَعِينَ، أَقُولُ وَفَّقَكُمُ اللَّهُ فِي [بُغْيَةِ الصَّائِمِ]: وَلَا يُفْطِرُ بِابْتِلَاعِ

23
00:01:06,170 --> 00:01:08,436
نُخَامَةٍ وَيَحْرُمُ عَلَيْهِ،

24
00:01:08,436 --> 00:01:11,100
وَلَا يَضُرُّهُ بِابْتِلَاعِ

25
00:01:11,100 --> 00:01:13,764
رِيقِهِ وَلَوْ جَمَعَهُ،

26
00:01:13,764 --> 00:01:16,428
لَا رِيقِ غَيْرِهِ

27
00:01:16,428 --> 00:01:19,092
كَزَوْجَةٍ وَنَحْوِهِ وَنَحْوِهِ.

28
00:01:19,092 --> 00:01:19,980
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: هَذَا

29
00:01:25,330 --> 00:01:27,858
ذَكَرَ الْمُصَنِّفُ

30
00:01:27,858 --> 00:01:30,385
فِي هَذِهِ

31
00:01:30,385 --> 00:01:32,913
الْجُمْلَةِ حُكْمَ

32
00:01:32,913 --> 00:01:35,441
ابْتِلَاعِ النُّخَامَةِ،

33
00:01:35,441 --> 00:01:37,968
وَهِيَ الَّتِي

34
00:01:37,968 --> 00:01:41,760
يُسَمِّيهَا الْعَوَامُّ الْبَلْغَمَ،

35
00:01:41,760 --> 00:01:44,920
فَأَشَارَ إِلَى حُكْمِهِ مِنْ

36
00:01:44,920 --> 00:01:45,560
جِهَتَيْنِ:

37
00:01:48,960 --> 00:01:51,480
الْأُولَى:

38
00:01:51,480 --> 00:01:54,000
حُكْمُ

39
00:01:54,000 --> 00:01:56,520
ابْتِلَاعِهِ

40
00:01:56,520 --> 00:01:59,870
وَهُوَ الْحُرْمَةُ،

41
00:01:59,870 --> 00:02:03,297
فَيَحْرُمُ ابْتِلَاعُهُ لِمَا فِيهِ

42
00:02:03,297 --> 00:02:05,010
مِنَ الْقَذَرِ،

43
00:02:05,010 --> 00:02:06,710
وَالْمُسْلِمُ مَأْمُورٌ

44
00:02:28,130 --> 00:02:29,730
أَنْ يُنَزِّهَ نَفْسَهُ

45
00:02:38,264 --> 00:02:41,331
عَنْ مِثْلِ ذَلِكَ،

46
00:03:39,560 --> 00:03:42,900
وَالْحُكْمُ الْآخَرُ:

47
00:03:53,080 --> 00:03:54,200
وَهُوَ

48
00:04:11,137 --> 00:04:13,336
مِنْ

49
00:04:13,336 --> 00:04:15,535
جِهَةِ الْفِطْرِ بِهِ،

50
00:04:13,336 --> 00:04:15,535
وَالصَّحِيحُ

51
00:05:09,517 --> 00:05:12,912
أَنَّ ابْتِلَاعَ

52
00:05:12,912 --> 00:05:14,609
النُّخَامَةِ

53
00:06:22,070 --> 00:06:22,979
لَا يُفْطِرُ إِذْ هِيَ لَيْسَتْ بِخَارِجٍ عَنِ الْبَدَنِ،

54
00:06:22,525 --> 00:06:22,979
وَإِنَّمَا هِيَ مِنْهُ،

55
00:06:22,525 --> 00:06:22,979
فَلَيْسَتْ فِي

56
00:07:08,658 --> 00:07:12,142
حُكْمِ الطَّعَامِ وَالشَّرَابِ؛ ثُمَّ جَرَّ الْكَلَامُ عَلَى النُّخَامَةِ الْمُصَنِّفَ

57
00:07:53,430 --> 00:07:55,945
إِلَى الْكَلَامِ عَنِ الرِّيقِ،

58
00:07:54,688 --> 00:07:55,945
فَذَكَرَ فِيهِ أَرْبَعَةَ أَحْكَامٍ: الْأَوَّلُ: حُكْمُ ابْتِلَاعِ رِيقِهِ،

59
00:07:54,688 --> 00:07:55,945
وَذَكَرَ

60
00:08:29,510 --> 00:08:31,360
أَنَّهُ

61
00:08:31,360 --> 00:08:33,210
لَا

62
00:09:21,967 --> 00:09:23,556
يَضُرُّهُ

63
00:09:26,735 --> 00:09:29,914
أَيْ لَا

64
00:09:34,681 --> 00:09:37,860
يُفْطِرُ بِهِ

65
00:09:41,260 --> 00:09:43,078
أَيْ

66
00:11:01,823 --> 00:11:03,812
لَا

67
00:11:09,289 --> 00:11:12,288
يُفْطِرُ بِهِ،

68
00:11:10,789 --> 00:11:12,288
وَالْحُكْمُ الثَّانِي: حُكْمُ ابْتِلَاعِ الرِّيقِ مَجْمُوعًا أَيْ

69
00:11:34,780 --> 00:11:36,466
بَعْدَ جَمْعِهِ أَيْ بَعْدَ جَمْعِهِ،

70
00:11:35,623 --> 00:11:36,466
وَهُوَ أَيْضًا لَا يَضُرُّ فَلَا يُفْطِرُ بِهِ وَأَيْضًا لَا يَضُرُّ

71
00:11:35,623 --> 00:11:36,466
فَلَا يُفْطِرُ بِهِ،

72
00:11:35,623 --> 00:11:36,466
وَذَكَرَ جَمَاعَةٌ مِنَ الْعُلَمَاءِ كَرَاهَةَ ذَلِكَ وَفِيهِ نَظَرٌ،

73
00:11:35,623 --> 00:11:36,466
فَالْأَوْجَهُ الْجَوَازُ،

74
00:11:35,623 --> 00:11:36,466
وَالْحُكْمُ الثَّالِثُ: كَوْنُ ابْتِلَاعِ رِيقِ الْغَيْرِ لَيْسَ كَابْتِلَاعِ رِيقِ نَفْسِهِ،

75
00:11:35,623 --> 00:11:36,466
فَإِذَا ابْتَلَعَ رِيقَ غَيْرِهِ أَفْطَرَ،

76
00:11:35,623 --> 00:11:37,308
وَالرَّابِعُ: أَنَّ ابْتِلَاعَ رِيقِ الزَّوْجَةِ دَاخِلٌ

77
00:11:50,792 --> 00:11:52,478
فِي جُمْلَةِ ابْتِلَاعِ رِيقِ الْغَيْرِ،

78
00:11:51,635 --> 00:11:52,478
فَإِذَا ابْتِلَاعُ رِيقِ الزَّوْجَةِ دَاخِلٌ

79
00:12:14,518 --> 00:12:16,577
فِي

80
00:12:16,577 --> 00:12:18,635
جُمْلَةِ ابْتِلَاعِ رِيقِ الْغَيْرِ،

81
00:12:16,577 --> 00:12:18,635
فَمَنْ قَبَّلَ زَوْجَةً فَمَصَّ لِسَانَهَا أَوِ ابْتَلَعَ رِيقَهَا فَقَدْ أَتَى

82
00:12:16,577 --> 00:12:18,635
بِمُفْطِرٍ، وَيَأْتِي حُكْمُ تَقْبِيلِهِ وَغَيْرِهِ مِمَّا يَتَعَلَّقُ بِالشَّهْوَةِ فِيمَا يُسْتَقْبَلُ؛

83
00:12:16,577 --> 00:12:18,635
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ:

84
00:13:19,644 --> 00:13:21,806
لَا

85
00:13:21,806 --> 00:13:23,968
يُفْطِرُ

86
00:13:23,968 --> 00:13:26,130
بِاسْتِنْشَاقِ دُخَانٍ وَيَحْرُمُ عَلَيْهِ،

87
00:13:23,968 --> 00:13:26,130
وَلَا

88
00:14:40,560 --> 00:14:42,155
يَضُرُّهُ الشَّمُّ الْعَارِضُ.

89
00:14:41,358 --> 00:14:42,155
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: لَمَّا فَرَغَ الْمُصَنِّفُ مِمَّا يَتَعَلَّقُ بِأَحْوَالِ

90
00:14:41,358 --> 00:14:42,155
الْفَمِ وَمَا يَدُورُ فِيهِ بِاعْتِبَارِهِ الْأَصْلَ الْمُتَعَلِّقَ بِالطَّعَامِ وَالشَّرَابِ،

91
00:14:41,358 --> 00:14:43,750
انْتَقَلَ إِلَى

92
00:14:44,548 --> 00:14:46,143
مَا يَتَعَلَّقُ بِالْأَنْفِ بِاعْتِبَارِهِ مَنْفَذًا لِلْجَوْفِ كَالْفَمِ،

93
00:14:45,345 --> 00:14:46,143
فَذَكَرَ ثَلَاثَةَ أَحْكَامٍ: الْحُكْمُ الْأَوَّلُ: وَهُوَ حُكْمُ اسْتِنْشَاقِ الدُّخَانِ،

94
00:14:45,345 --> 00:14:46,143
وَمَحَلُّ هَذَا الْحُكْمِ لِلصَّائِمِ وَهُوَ الْحُرْمَةُ،

95
00:14:45,345 --> 00:14:46,143
فَيَحْرُمُ عَلَيْهِ اسْتِنْشَاقُ الدُّخَانِ كَوْنُهُ مَظِنَّةً لِلْفِطْرِ،

96
00:14:45,345 --> 00:14:46,143
وَوَجْهُ ذَلِكَ

97
00:15:11,965 --> 00:15:13,840
أَنَّ

98
00:15:13,840 --> 00:15:15,715
الدُّخَانَ لَهُ جِرْمٌ وَرُبَّمَا

99
00:16:16,770 --> 00:16:20,220
انْتَقَلَ إِلَى جَوْفِهِ فَأَفْطَرَ بِهِ،

100
00:16:19,070 --> 00:16:20,220
فَيَكُونُ ذَلِكَ

101
00:17:38,337 --> 00:17:40,703
مِنْ تَعْرِيضِ

102
00:17:40,703 --> 00:17:43,070
الصَّائِمِ نَفْسَهُ لِلْفِطْرِ بِمَظِنَّةٍ قَوِيَّةٍ وَهُوَ مُحَرَّمٌ،

103
00:17:41,887 --> 00:17:43,070
الْحُكْمُ الثَّانِي: أَنَّهُ

104
00:17:45,182 --> 00:17:47,294
لَا

105
00:17:47,294 --> 00:17:49,406
يُفْطِرُ بِاسْتِنْشَاقِ الدُّخَانِ إِذْ لَا يُجْزَمُ بِكَوْنِهِ وَصَلَ إِلَى جَوْفِهِ

106
00:17:47,294 --> 00:17:59,966
حَتَّى أَفْطَرَ بِهِ،

107
00:17:59,966 --> 00:18:02,078
فَيُحْكَمُ بِحُرْمَةِ فِعْلِهِ دُونَ الْحُكْمِ بِفِطْرِهِ عَلَى الصَّحِيحِ،

108
00:17:59,966 --> 00:18:02,078
وَالْحُكْمُ الثَّالِثُ: أَنَّهُ لَا يَضُرُّهُ الشَّمُّ الْعَارِضُ أَيْ لَا يَحْرُمُ

109
00:17:59,966 --> 00:18:02,078
عَلَيْهِ وَلَا يُفْطِرُ بِهِ،

110
00:17:59,966 --> 00:18:02,078
فَعُلِمَ أَنَّ مَنَاطَ التَّحْرِيمِ

111
00:18:06,226 --> 00:18:07,244
فِي

112
00:18:16,404 --> 00:18:18,440
هَذَا الْحُكْمِ وَمَظِنَّةَ الْإِفْطَارِ فِيهِ أَمْرَانِ: الْأَوَّلُ: الِاسْتِنْشَاقُ وَهُوَ الْجَذْبُ

113
00:18:17,422 --> 00:18:18,440
إِلَى تَجْوِيفِ الْأَنْفِ بِخِلَافِ الشَّمِّ،

114
00:18:17,422 --> 00:18:18,440
وَالْأَمْرُ الثَّانِي: أَنَّ

115
00:18:37,253 --> 00:18:39,128
هَذَا الِاسْتِنْشَاقَ مُتَعَلِّقٌ بِالدُّخَانِ لِكَوْنِهِ ذَا جِرْمٍ،

116
00:18:38,190 --> 00:18:39,128
فَلَا يَتَعَلَّقُ بِالرَّوَائِحِ الطَّيِّبَةِ وَنَحْوِهَا مِمَّا لَا جِرْمَ

117
00:19:02,388 --> 00:19:03,381
لَهُ؛

118
00:19:05,369 --> 00:19:07,355
قَالَ الْمُصَنِّفُ حَفِظَهُ

119
00:19:15,839 --> 00:19:17,369
اللَّهُ: لَا يُفْطِرُ بِالْمُبَالَغَةِ

120
00:19:25,016 --> 00:19:26,545
فِي الِاسْتِنْشَاقِ

121
00:20:14,942 --> 00:20:17,077
فِي

122
00:20:17,077 --> 00:20:19,212
الْوُضُوءِ وَيُكْرَهُ لَهُ،

123
00:20:17,077 --> 00:20:19,212
وَلَا يَضُرُّهُ نُفُوذُ مَاءٍ إِلَى الْجَوْفِ مَا لَمْ يَتَعَمَّدْهُ.

124
00:20:17,077 --> 00:20:19,212
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: بَعْدَ أَنْ فَرَغَ الْمُصَنِّفُ مِمَّا يَتَعَلَّقُ

125
00:20:17,077 --> 00:20:19,212
بِأَحْوَالِ الْفَمِ وَالْأَنْفِ فِيمَا يَتَعَلَّقُ بِالصَّائِمِ،

126
00:20:17,077 --> 00:20:19,212
أَشَارَ إِلَى حَالٍ خَاصَّةٍ وَهِيَ مِمَّا يَحْصُلُ فِي الْوُضُوءِ،

127
00:20:17,077 --> 00:20:19,212
وَالْأَصْلُ

128
00:21:25,711 --> 00:21:27,280
