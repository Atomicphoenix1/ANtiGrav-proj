{
  "name": "Seif Cloud OS Agent (via Tunnel)",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "1",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.message.from.id}}",
              "operation": "equal",
              "value2": "YOUR_TELEGRAM_USER_ID"
            }
          ]
        }
      },
      "id": "2",
      "name": "Security Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "3",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [450, 300]
    },
    {
      "parameters": {
        "modelName": "gemini-1.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "4",
      "name": "Gemini 1.5 Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [400, 500]
    },
    {
      "parameters": {
        "name": "os_terminal",
        "description": "Run a PowerShell command on Seif's machine via the Local Bridge. Input: command.",
        "method": "POST",
        "url": "https://former-philip-huge-publications.trycloudflare.com/exec?key=SEIF_SECRET_123",
        "authentication": "predefined",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer SEIF_SECRET_123"
            }
          ]
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "command",
              "value": "={{$input}}"
            }
          ]
        }
      },
      "id": "5",
      "name": "HTTP Terminal Tool",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [650, 500]
    },
    {
      "parameters": {
        "name": "file_list_tool",
        "description": "List files in a category. Input must be ONLY the category name: 'math', 'nano', 'teaching', or 'college'.",
        "method": "GET",
        "url": "https://former-philip-huge-publications.trycloudflare.com/list?key=SEIF_SECRET_123",
        "authentication": "predefined",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer SEIF_SECRET_123"
            }
          ]
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "category",
              "value": "={{$input}}"
            }
          ]
        }
      },
      "id": "6",
      "name": "HTTP File Tool",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [800, 500]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{"node": "Security Check", "type": "main", "index": 0}]]
    },
    "Security Check": {
      "main": [[{"node": "AI Agent", "type": "main", "index": 0}]]
    },
    "Gemini 1.5 Flash": {
      "ai_languageModel": [[{"node": "AI Agent", "type": "ai_languageModel", "index": 0}]]
    },
    "HTTP Terminal Tool": {
      "ai_tool": [[{"node": "AI Agent", "type": "ai_tool", "index": 0}]]
    },
    "HTTP File Tool": {
      "ai_tool": [[{"node": "AI Agent", "type": "ai_tool", "index": 0}]]
    }
  }
}
