1
00:00:00,690 --> 00:00:02,690
أَلسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

2
00:00:02,690 --> 00:00:05,690
وَأَلسَّلَامُ عَلَيْكُمْ وَبَرَكَاتُهُ.

3
00:00:05,690 --> 00:00:09,690
الْحَمْدُ لِلَّهِ الَّذِي أَنْزَلَ بِالْعِلْمِ الْوَحْيَ الْمُبِينَ،

4
00:00:09,690 --> 00:00:13,690
وَقَيَّدَ لِتَقْرِيبِهِ إِلَيْنَا عُلَمَاءَ رَبَّانِيِّينَ،

5
00:00:13,690 --> 00:00:16,690
وَأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ

6
00:00:16,690 --> 00:00:18,690
وَحْدَهُ لَا شَرِيكَ لَهُ،

7
00:00:18,690 --> 00:00:21,690
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ،

8
00:00:21,690 --> 00:00:25,190
صَلَّى اللَّهُ عَلَيْهِ وَعَلَى آلِهِ

9
00:00:25,190 --> 00:00:28,690
وَصَحْبِهِ مَا فُتِحَتْ مَدَارِكُ الْفُهُومِ،

10
00:00:28,690 --> 00:00:31,547
وَسَلَّمَ عَلَيْهِ وَعَلَيْهِمْ مَا

11
00:00:31,547 --> 00:00:33,690
قَرَّبَتْ إِلَيْنَا الْعُلُومُ.

12
00:00:33,690 --> 00:00:36,872
فَهَذَا الْمَجْلِسُ الثَّانِي مِنْ شَرْحِ

13
00:00:36,872 --> 00:00:40,690
الْكِتَابِ الْأَوَّلِ فِي بَنَامِجِ تَقْرِيبِ الْعِلْمِ،

14
00:00:40,690 --> 00:00:43,767
وَهُوَ [خُلَاصَةُ تَعْظِيمِ الْعِلْمِ] لِمُصَنِّفِهِ

15
00:00:43,767 --> 00:00:46,844
الشَّيْخِ صَالِحِ بْنِ عَبْدِ اللَّهِ

16
00:00:46,844 --> 00:00:50,023
بْنِ حَمَدٍ الْعُصَيْمِيِّ حَفِظَهُ اللَّهُ،

17
00:00:50,023 --> 00:00:52,690
وَنَفَعَنَا بِعِلْمِهِ فِي الدُّعَاءِ.

18
00:00:52,690 --> 00:00:56,023
وَقَدِ انْتَهَى بِنَا الْمَجْلِسُ الْأَوَّلُ

19
00:00:56,023 --> 00:00:58,690
إِلَى قَوْلِهِ: الْمَعْقِدُ الْأَوَّلُ.

20
00:00:58,690 --> 00:01:02,006
اللَّهُمَّ فَضَّنَا وَرَشَّهُ

21
00:01:02,006 --> 00:01:05,322
صَالِحٌ صَالِحٌ الْوَصَايِدِينَ

22
00:01:05,322 --> 00:01:08,638
بِفِقْهِ اللَّهِ فِي

23
00:01:08,638 --> 00:01:11,954
الْكِتَابِ الَّذِي يُخَلِّصُ

24
00:01:11,954 --> 00:01:15,270
فِيهِ تَعْظِيمَ الْعِلْمِ.

25
00:01:15,270 --> 00:01:18,699
الْمَعْقِدُ الْأَوَّلُ: تَقْرِيرُ وِعَاءِ

26
00:01:18,699 --> 00:01:21,270
الْعِلْمِ وَهُوَ الْقَلْبُ.

27
00:01:21,270 --> 00:01:25,270
وَبِحَجْزِ ظَهْرِهِ لِلْقَلْبِ يُبْقُوهُ مِنَ الْعِلْمِ،

28
00:01:25,270 --> 00:01:29,270
وَإِذَا ازْدَادَ تَهَارُكُهُ بِكَارِهِ قَرْنِيَّةً.

29
00:01:29,270 --> 00:01:32,603
فَمَنْ أَرَادَ حَيَاةَ الْمَجْلِسِ هَلْ

30
00:01:32,603 --> 00:01:36,270
يُزَيِّنُ بَاطِنَهُ وَيُطَهِّرُ قَلْبَهُ تَجْرِسَاتِهِ؟

31
00:01:36,270 --> 00:01:39,395
فَالْعِلْمُ جَوْهَرٌ وَصِيحٌ لَا يَصْفَحُ

32
00:01:39,395 --> 00:01:41,270
إِلَّا لِلْقَلْبِ الْمَظْلُومِ.

33
00:01:41,270 --> 00:01:44,603
وَطَهَارَةُ الْقَلْبِ تَرْجِعُ إِلَى أَصْبَانِ

34
00:01:44,603 --> 00:01:48,270
الْعَظْمِ: أَحَدُهُمَا: طَهَارَتُهُمْ تَاسُدُ الشُّبُهَاتِ،

35
00:01:48,270 --> 00:01:51,270
وَالْآخَرُ: طَهَارَتُهُمْ تَاسُدُ الشَّهَوَاتِ.

36
00:01:51,270 --> 00:01:54,270
وَإِذَا كُنْتَ تَسْتَحِي

37
00:01:54,270 --> 00:01:57,270
مِنْ نَظَرِ مَخْلُوقٍ

38
00:01:57,270 --> 00:02:01,270
تَصْفَحُكَ إِلَى وَصْفِ ثَوَابِكَ،

39
00:02:01,270 --> 00:02:05,270
فَاسْتَحِ مِنْ نَظَرِ اللَّهِ إِلَى قَلْبِكَ.
