فَإِنَّ مَنْ بَعْدَهُمْ لَا يَلْحَقُونَ بِهِمْ لَا بِالْفَضْلِ وَلَا بِالزَّمَانِ،

113
00:19:38,007 --> 00:19:40,507
رَحِمَهُ اللَّهُ تَعَالَى حَدِيثًا عَظِيمًا وَهُوَ حَدِيثُ أَبِي مُوسَى الْأَشْعَرِيِّ

114
00:19:40,507 --> 00:19:40,923
فِي الصَّحِيحِ،

115
00:20:09,052 --> 00:20:10,321
كَمَا شَبَّهَ

116
00:20:17,487 --> 00:20:19,846
سُبْحَانَهُ الْقُلُوبَ بِالْأَوْدِيَةِ

117
00:20:28,693 --> 00:20:30,462
فِي قَوْلِهِ

118
00:20:36,426 --> 00:20:38,873
تَعَالَى: ﴿أَنْزَلَ

119
00:20:52,333 --> 00:20:54,781
مِنَ السَّمَاءِ مَاءً فَسَالَتْ أَوْدِيَةٌ بِقَدَرِهَا﴾.

120
00:20:57,840 --> 00:20:59,675
إِلَى قَبُولِ الْغَيْثِ فَكَذَلِكَ الْقُلُوبُ: - أَوَّلُهَا: أَرْضٌ زَكِيَّةٌ فَهَذِهِ

121
00:20:59,675 --> 00:21:02,123
فَإِذَا أَصَابَهَا الْغَيْثُ اهْتَدَتْ وَرَبَّتْ وَأَنْبَتَتْ مِنْ كُلِّ زَوْجٍ بَهِيجٍ،

122
00:21:09,297 --> 00:21:10,872
كَانَ ذَكَاءٌ دُونَ زَكَاءٍ فَإِنَّهُ لَمْ يُفْلِحْ كَمَا هِيَ حَالُ

123
00:21:13,498 --> 00:21:15,599
فِي أَبْوَابِ الْخَبَرِ خَاصَّةً دُونَ تَقْوَى وَلَا زَكَاءٍ،

124
00:21:32,930 --> 00:22:02,910
اللَّهُ

125
00:22:09,167 --> 00:22:10,949
وَلَا أَبْصَارُهُمْ وَلَا أَفْئِدَتُهُمْ

126
00:22:14,513 --> 00:22:15,849
مِنْ شَيْءٍ

127
00:22:27,432 --> 00:22:29,214
إِذْ كَانُوا يَجْحَدُونَ بِآيَاتِ

128
00:22:30,550 --> 00:22:32,438
اللَّهِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ] انْتَهَى كَلَامُهُ.

129
00:22:51,115 --> 00:22:55,538
مَنْ ضُرِبَ لَهُ مَثَلٌ فِي أَرْضٍ صُلْبَةٍ قَابِلَةٍ لِثُبُوتِ الْمَاءِ

130
00:23:02,930 --> 00:23:04,720
كَمَا سَمِعَهُ

131
00:23:12,327 --> 00:23:16,354
وَلَا تَصَرُّفَ لَهُ فِيهِ وَلَا اسْتِنْبَاطَ،

132
00:23:27,093 --> 00:23:28,883
وَالثَّانِي مَثَلُ الْغَنِيِّ الَّذِي

133
00:23:31,568 --> 00:23:32,910
لَا خِبْرَةَ

134
00:23:37,664 --> 00:23:39,242
لَهُ بِوُجُوهِ الرِّبْحِ وَالْمَكَاسِبِ،

135
00:23:49,498 --> 00:23:50,681
وَهَذَا مَثَلُ الْقَلْبِ الثَّانِي.

136
00:23:50,681 --> 00:23:51,470
لَا تَقْبَلُ النَّبَاتَ وَلَا تُمْسِكُ الْمَاءَ،

137
00:23:51,470 --> 00:23:52,654
فَلَوْ أَصَابَهَا مِنَ الْمَطَرِ مَا أَصَابَهَا لَمْ تَنْتَفِعْ بِشَيْءٍ وَلَنْ

138
00:24:11,799 --> 00:24:14,021
فَهَذَا مَثَلُ الْقَلْبِ الَّذِي لَا يَقْبَلُ الْعِلْمَ وَلَا الْفِقْهَ وَالدِّرَايَةَ

139
00:24:26,587 --> 00:24:28,688
هُوَ بِمَنْزِلَةِ الْأَرْضِ الْبَوَارِي الَّتِي لَا تُنْبِتُ وَلَا تَحْفَظُ الْمَاءَ،

140
00:24:49,195 --> 00:24:50,773
لَهُ وَلَا يُحْسِنُ يُمْسِكُ مَالًا.

141
00:25:11,921 --> 00:25:14,183
إِلَى اللَّهِ وَفِقْهٍ وَبَصِيرَةٍ،

142
00:25:19,840 --> 00:25:21,537
مِنْ وَرَثَةِ الرُّسُلِ.

143
00:25:36,968 --> 00:25:39,699
هَذَا وَلَا هَذَا،

144
00:25:51,992 --> 00:25:54,041
اللَّهِ وَلَا رَفَعَ بِهِ رَأْسًا.

145
00:26:14,607 --> 00:26:16,896
عَلَى الْعَبْدِ

146
00:26:38,613 --> 00:26:42,213
هَذَا الْحَدِيثُ يَنْبَغِي لَهُ أَنْ يُزْعِجَ قَلْبَهُ

147
00:26:42,213 --> 00:26:42,727
وَأَنْ يُحَرِّكَ نَفْسَهُ،

148
00:26:47,356 --> 00:26:49,765
ثُمَّ لَا يُلْقُونَ إِلَيْهَا بَالًا وَلَا يَرْفَعُونَ إِلَيْهَا رَأْسًا وَلَا

149
00:27:09,314 --> 00:27:11,537
فِي الدِّينِ،

150
00:27:15,426 --> 00:27:16,537
اللَّهَ

151
00:27:38,740 --> 00:27:40,827
أَنْ يَكُونَ

152
00:27:41,870 --> 00:27:45,143
مِنْ أَهْلِ الْمَثَلِ الْأَوَّلِ أَوْ يَكُونَ

153
00:28:11,870 --> 00:28:13,759
مِنْ أَهْلِ الْمَثَلِ الثَّانِي أَوِ الثَّالِثِ؟

154
00:28:16,592 --> 00:28:18,481
لَهُ انْزِعَاجًا وَخَوْفًا وَإِقْبَالًا عَلَى

155
00:28:38,817 --> 00:28:41,028
اللَّهِ سُبْحَانَهُ وَتَعَالَى وَدَوَامَ سُؤَالٍ لِلَّهِ عَزَّ وَجَلَّ أَنْ يَرْزُقَهُ

156
00:28:50,745 --> 00:28:52,495
الْعِلْمَ النَّافِعَ وَالْعَمَلَ الصَّالِحَ وَأَنْ يَجْعَلَهُ

157
00:28:54,682 --> 00:28:56,432
مِنْ أَهْلِ الذَّكَاءِ وَالزَّكَاةِ،

158
00:29:05,761 --> 00:29:07,483
مِنْ رَحْمِ خَشْيَةِ اللَّهِ بَاكِيَتَانِ،

159
00:29:30,329 --> 00:29:32,462
بَيْنَ أَصَابِعِ الرَّحْمَنِ].

160
00:29:32,462 --> 00:29:33,528
فَلَوْ شَاءَ اللَّهُ عَزَّ وَجَلَّ لَحَبَسَكَ عَنِ الْجُلُوسِ فِي بَتْرِ

161
00:29:39,392 --> 00:29:40,991
فَلَا يَهْتَدِي بِهُدًى

162
00:30:01,890 --> 00:30:03,535
وَلَا يَمْتَثِلُ بِأَمْرٍ وَلَا يَنْتَهِي بِنَهْيٍ،

163
00:30:06,278 --> 00:30:07,923
قَالَ اللَّهُ عَزَّ وَجَلَّ: ﴿وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ

164
00:30:07,923 --> 00:30:09,020
وَقَلْبِهِ﴾. قَالَ بَعْضُ السَّلَفِ: [يُرِيدُ أَنْ يَهْتَدِيَ فَلَا يَهْتَدِي،

165
00:30:12,860 --> 00:30:16,151
فَإِذَا نَظَرَ الْإِنْسَانُ

166
00:30:25,830 --> 00:30:27,430
إِلَى حَالِ قَلْبِهِ خَشِيَ

167
00:30:39,670 --> 00:30:43,210
أَنْ يَجْعَلَهُ اللَّهُ سُبْحَانَهُ وَتَعَالَى

168
00:30:50,055 --> 00:30:52,555
مِنْ أَهْلِ الْقِسْمِ الثَّالِثِ،

169
00:30:53,805 --> 00:30:55,801
ثُمَّ رَجَعَ بِحُسْنِ الظَّنِّ وَقُوَّةِ الرَّجَاءِ

170
00:31:04,605 --> 00:31:06,690
إِلَى

171
00:31:25,014 --> 00:31:27,123
اللَّهِ سُبْحَانَهُ وَتَعَالَى مُسْتَغِيثًا مُلْتَمِسًا دَاعِيًا خَاشِعًا خَاضِعًا رَاغِبًا رَاهِبًا

172
00:31:46,829 --> 00:31:48,704
إِلَى اللَّهِ

173
00:31:57,610 --> 00:31:59,610
أَنْ يَجْعَلَهُ مِنْ أَهْلِ الْعِلْمِ وَالذَّكَاءِ وَالزَّكَاءِ

174
00:32:13,084 --> 00:32:14,899
الَّذِي يُقَدِّمُهُ إِلَى اللَّهِ وَلَا يُقَدِّمُهُ إِلَى الْمَنَاصِبِ وَالرِّئَاسَاتِ وَالْجَاهَاتِ

175
00:32:18,510 --> 00:32:20,910
فِي الدُّنْيَا،

176
00:32:40,297 --> 00:32:41,985
هُوَ

177
00:33:01,522 --> 00:33:03,742
فِي مَقَامِ أَبِي بَكْرِ بْنِ خُزَيْمَةَ،

178
00:33:06,268 --> 00:33:08,163
اللَّهِ عَزَّ وَجَلَّ

179
00:33:11,321 --> 00:33:13,847
فِي الدَّرَجَاتِ فِي اعْتِبَارِ الْمَقَامَاتِ هُوَ بِحَسَبِ مَا يَنَالُهُ

180
00:33:15,710 --> 00:33:17,510
الْإِنْسَانُ

181
00:33:21,710 --> 00:33:23,510
مِنَ

182
00:33:33,110 --> 00:33:35,110
الْعِلْمِ الصَّحِيحِ النَّافِعِ الْمُقَرِّبِ إِلَى

183
00:33:38,110 --> 00:33:40,584
اللَّهِ سُبْحَانَهُ وَتَعَالَى،

184
00:33:40,584 --> 00:33:41,057
فَنَسْأَلُهُ سُبْحَانَهُ وَتَعَالَى بِأَسْمَائِهِ الْحُسْنَى وَصِفَاتِهِ الْعُلَى أَنْ يُذِيقَنَا عِلْمًا

185
00:33:45,321 --> 00:33:47,215
قَالَ الْمُصَنِّفُ حَفِظَهُ

186
00:34:09,810 --> 00:34:12,010
اللَّهُ: فَصْلٌ: وَأَمَّا النَّوْعُ الثَّانِي

187
00:34:34,396 --> 00:34:36,453
مِنَ الْأَتْبَاعِ السُّعَدَاءِ فَهُمْ أَتْبَاعُ الْمُؤْمِنِينَ

188
00:34:40,053 --> 00:34:42,110
مِنْ ذُرِّيَّاتِهِمُ الَّذِينَ

189
00:34:53,610 --> 00:34:55,746
لَمْ يَثْبُتْ لَهُمْ حُكْمُ التَّكْلِيفِ

190
00:34:58,474 --> 00:35:00,110
فِي دَارِ الدُّنْيَا،

191
00:35:04,474 --> 00:35:06,110
فِي الْجَنَّةِ كَمَا اتَّبَعُوهُمْ إِيَّاهُمْ

192
00:35:10,474 --> 00:35:12,110
فِي الْإِيمَانِ،

193
00:35:36,850 --> 00:35:38,683
قَالَ تَعَالَى: ﴿وَمَا أَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَيْءٍ﴾ وَالضَّمِيرُ عَائِدٌ

194
00:35:47,350 --> 00:35:50,259
إِلَى الَّذِينَ آمَنُوا أَيْ: لَمْ نَنْقُصْهُمْ

195
00:36:06,850 --> 00:36:08,850
فِي عَمَلِهِمْ بَلْ رَفَعْنَا ذُرِّيَّتَهُمْ إِلَى دَرَجَاتِهِمْ مَعَ تَوْفِيَتِهِمْ أُجُورَ

196
00:36:11,718 --> 00:36:13,613
مَنْ لَمْ يَكُنْ لَهُ عَمَلٌ بَلْ وَفَّيْنَاهُمْ أُجُورَهُمْ وَأَلْحَقْنَا بِهِمْ

197
00:36:23,037 --> 00:36:26,787
مِنْ أَعْمَالِهِمْ.

198
00:36:26,787 --> 00:36:30,537
مِنَ اللَّهِ فَرُبَّمَا وَقَعَ بِالْوَهْمِ أَنَّ إِلْحَاقَ الذُّرِّيَّةِ أَيْضًا حَاصِلٌ

199
00:37:01,350 --> 00:37:05,350
لَا يَتَعَلَّقُ بِغَيْرِهِ مِنْهُ شَيْءٌ،

200
00:37:06,805 --> 00:37:08,623
فِي الثَّوَابِ وَالدَّرَجَاتِ

201
00:37:11,600 --> 00:37:12,350
لَا

202
00:37:31,316 --> 00:37:32,660
فِي الْعَدْلِ وَالْعِقَابِ،

203
00:37:40,975 --> 00:37:42,475
أَنْ يَنْظُرَ

204
00:37:54,790 --> 00:37:56,230
مِنْ أَيِّ الْأَقْسَامِ هُوَ وَلَا يَغْتَرَّ بِالْعَادَةِ وَيَخْلُدَ إِلَى الْبَطَالَةِ،

205
00:37:59,830 --> 00:38:01,270
مَا فَوْقَهُ وَبَذَلَ جُهْدَهُ وَاللَّهُ وَلِيُّ التَّوْفِيقِ وَالنَّجَاحِ،

206
00:38:20,128 --> 00:38:21,906
مِنْ قِسْمٍ شَقِيٍّ انْتَقَلَ مِنْهُ إِلَى الْقِسْمِ السَّعِيدِ

207
00:38:33,017 --> 00:38:34,794
فِي زَمَنِ الْإِمْكَانِ قَبْلَ أَنْ يَقُولَ: ﴿يَا لَيْتَنِي اتَّخَذْتُ مَعَ

208
00:38:51,817 --> 00:38:53,683
اللَّهُ: شَرَعَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ

209
00:39:02,550 --> 00:39:03,950
تَعَالَى فِي هَذَا الْفَصْلِ النَّوْعَ الثَّانِيَ مِنَ الْأَتْبَاعِ السُّعَدَاءِ،

210
00:39:21,350 --> 00:39:22,683
أَوْ غَيْرِ ذَلِكَ،

211
00:39:32,017 --> 00:39:32,906
قَالَ

212
00:39:55,950 --> 00:39:57,150
اللَّهُ عَزَّ وَجَلَّ: ﴿وَالَّذِينَ آمَنُوا﴾ فَأَخْبَرَ اللَّهُ عَزَّ وَجَلَّ

213
00:40:08,750 --> 00:40:10,350
أَنَّ الذُّرِّيَّةَ تَبَعٌ لِلْآبَاءِ،

214
00:40:32,550 --> 00:40:33,950
وَهَذَا الْإِلْحَاقُ هُوَ

215
00:40:47,100 --> 00:40:49,350
فِي الْفَضْلِ دُونَ الْعَدْلِ؛ لِأَنَّ كُلَّ نَفْسٍ ﴿بِمَا كَسَبَتْ رَهِينَةٌ﴾.

216
00:40:54,779 --> 00:40:55,636
أَنَّ الْآيَاتِ الْمُتَقَدِّمَةَ تَضَمَّنَتْ أَقْسَامَ الْخَلَائِقِ كُلِّهِمْ سُعَدَائِهِمْ وَأَشْقِيَائِهِمْ: السُّعَدَاءُ

217
00:40:55,636 --> 00:40:56,207
ثُمَّ قَالَ وَاعِظًا وَمُوصِيًا: فَلْيَنْظُرِ الْعَاقِلُ النَّاصِحُ لِنَفْسِهِ مِنْ أَيِّ

218
00:41:13,017 --> 00:41:14,350
هُوَ وَلَا يَغْتَرَّ بِالْعَادَةِ وَيَخْلُدَ

219
00:41:27,658 --> 00:41:29,812
إِلَى الْبَطَالَةِ،

220
00:41:29,812 --> 00:41:31,350
فَإِنْ كَانَ مِنْ قِسْمٍ سَعِيدٍ انْتَقَلَ مِنْهُ إِلَى مَا فَوْقَهُ

221
00:41:43,714 --> 00:41:44,805
مِنْ قِسْمٍ شَقِيٍّ انْتَقَلَ

222
00:41:57,817 --> 00:41:59,017
مِنْهُ إِلَى الْقِسْمِ السَّعِيدِ فِي زَمَنِ الْإِمْكَانِ أَيِ زَمَنِ الْعَمَلِ

223
00:42:08,055 --> 00:42:10,194
مِنَ الْحَضِيضِ إِلَى الْعُلُوِّ قَبْلَ أَنْ يُقَالَ أَنْ يَقُولَ: ﴿يَا

224
00:42:18,038 --> 00:42:20,177
مِنْ بَيْتِهِ وَلْيَقْعُدْ مَعَ الْخَالِفِينَ،

225
00:42:43,239 --> 00:42:44,423
هَذَا التَّأَسِّي يَوْمَ الْحَسْرَةِ

226
00:42:58,634 --> 00:43:00,213
فِي شَيْءٍ،

227
00:43:03,765 --> 00:43:05,992
قَالَ تَعَالَى: ﴿وَلَنْ يَنْفَعَكُمُ الْيَوْمَ إِذْ ظَلَمْتُمْ أَنَّكُمْ فِي الْعَذَابِ

228
00:43:18,820 --> 00:43:21,263
سُبْحَانَهُ انْتِبَاعَهُمْ بِتَأْثِيرِهِمْ بَعْضَهُمْ بِأَمْرٍ فِي الْعَذَابِ،

229
00:43:46,689 --> 00:43:48,605
عَلَى إِخْوَانِهِمْ لَقَتَلَتْنِي نَفْسِي،

230
00:43:52,437 --> 00:43:54,353
مِنَ التَّأَسِّي مَعْدُومٌ بَيْنَ الْمُشْتَرِكِينَ فِي الْعَذَابِ يَوْمَ الْقِيَامَةِ.

231
00:43:54,353 --> 00:43:55,790
وَإِنَّمَا كَمَا قِيلَ: [فَخُذْ غَبَرَاتِ الْمَوْتِ وَاسْمُ إِلَى الْعُلَا لِكَيْ

232
00:44:01,059 --> 00:44:02,496
مِنَ الرَّزَايَا وَلَا هِمَّةٍ تَصْبُو إِلَى لَوْمِ لَائِمِينَ].

233
00:44:09,681 --> 00:44:11,287
أَنْ لَا يَصْبُوَ فِي الْحَقِّ إِلَى لَوْمِ لَائِمِينَ،

234
00:44:18,052 --> 00:44:19,179
اللَّهِ فَيُقَدِّمُهُ حِينَئِذٍ لَا يُخْبِرُكُمْ بِذَلِكَ فَلَنْ يَخَافَ الْأَهْوَالَ،

235
00:44:28,949 --> 00:44:30,453
فِي حَقِّهِ تَحْمِلُهُ بِنَفْسِهَا إِلَى مَطْلُوبِهِ زَمَنًا مَا هُوَ يَخَافُ

236
00:44:37,593 --> 00:44:39,275
مَنْ دَخَلَ بِهِ.

237
00:44:39,275 --> 00:44:42,049
وَأَمَّا مَرْكَبُهُ فَالصِّدْقُ وَاللَّجَاءُ إِلَى اللَّهِ

238
00:44:48,153 --> 00:44:50,373
مِنْ كُلِّ وَجْهٍ وَالضَّرَاعَةُ إِلَيْهِ وَصِدْقُ التَّوَكُّلِ عَلَيْهِ وَالِاسْتِعَانَةُ بِهِ

239
00:45:00,361 --> 00:45:02,581
مِنْ أَيْدِيهِ كَالْأَنِيَّةِ الَّذِي

240
00:45:18,901 --> 00:45:20,375
لَا شَيْءَ بِهِ يَتَطَلَّعُ إِلَى قَيِّمِهِ وَوَلِيِّهِ أَنْ يَجْبُرَهُ وَيَلُمَّ

241
00:45:36,103 --> 00:45:38,069
مِنْ فَضْلِهِ وَيَسْتُرَهُ،

242
00:45:44,821 --> 00:45:45,995
مَا خَفِيَ

243
00:45:47,560 --> 00:45:49,125
عَلَى غَيْرِهِ

244
00:45:51,473 --> 00:45:53,038
مِنْ طَرِيقِ هَذِهِ الْهِجْرَةِ وَمَنَازِلِهَا.

245
00:45:57,192 --> 00:45:59,086
قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: فَصْلٌ: وَرَأْسُ مَالِ الْأَمْرِ وَعَمُودُهُ فِي

246
00:45:59,086 --> 00:46:00,349
فِي أَيْدِيهِ كَالْأَنِيَّةِ وَالَّذِي عَلَى الْفِكْرِ وَيَشْغَلُ مِنْ قَلْبِهِ،

247
00:46:00,349 --> 00:46:02,244
فَإِذَا صَارَتْ مَعَانِي الْقُرْآنِ مَكَانَ الْخَوَاطِرِ مِنْ قَلْبِهِ

248
00:46:27,811 --> 00:46:28,624
وَهِيَ الْغَالِبَةُ عَلَيْهِ بِحَيْثُ يَصِيرُ إِلَيْهَا مَفْزَعُهُ وَمَلْجَؤُهُ تَمَكَّنَ حِينَئِذٍ

249
00:46:41,543 --> 00:46:42,855
مِنْ قَلْبِهِ وَجَلَسَ عَلَى كُرْسِيِّهِ وَصَارَ

250
00:46:48,180 --> 00:46:49,980
لَهُ تَصَرُّفٌ وَصَارَ وَالْأَمْرُ الْمُطَاعُ أَمْرُهُ،

251
00:46:49,980 --> 00:46:51,330
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَرَحِمَهُ اللَّهُ تَعَالَى مِنْ تَغْيِيرِ مَا

252
00:46:51,330 --> 00:46:54,480
سَبَقَ مِنْ مُقْتَصَرِ التَّعَاوُنِ عَلَى الْبِرِّ وَالتَّقْوَى وَبَيَانِ.

253
00:46:56,480 --> 00:46:57,813
أَنَّ الْمَقْصُودَ بِمَا سَلَفَ

254
00:47:02,168 --> 00:47:03,543
أَنَّ

255
00:47:24,147 --> 00:47:25,480
مِنْ أَعْظَمِ التَّعَاوُنِ عَلَى الْبِرِّ وَالتَّقْوَى التَّعَاوُنَ عَلَى سَفَرِ الْهِجْرَةِ

256
00:47:25,480 --> 00:47:27,147
إِلَى اللَّهِ وَإِلَى رَسُولِهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ بِالْيَدِ وَاللِّسَانِ

257
00:47:27,147 --> 00:47:28,480
فَمَنْ أَعْمَلَ نَفْسَهُ فِي هَذَا الْمَقْصَدِ وَحَمَلَ عَلَى خَيْلِهِ وَرَجِلِهِ

258
00:47:28,480 --> 00:47:29,369
طَلَبًا لِإِصْلَاحِ النَّاسِ مُتَعَاوِنًا مَعَهُمْ عَلَى الْبِرِّ وَالتَّقْوَى فِي تَحْرِيكِ

259
00:47:29,369 --> 00:47:30,258
وَسَلَّمَ؛ فَذَلِكَ مِنْ أَعْظَمِ النَّصِيحَةِ لَهُمْ وَالْبِرِّ بِهِمْ،

260
00:47:49,291 --> 00:47:50,669
عَلَى قَدْرِ تَصْفِيَةِ الْأَعْمَالِ،

261
00:47:50,669 --> 00:47:52,048
قَالَهُ [أَبُو الْفَرَجِ ابْنُ الْجَوْزِيِّ] فِي [صَيْدِ الْخَاطِرِ].

262
00:48:08,409 --> 00:48:10,337
فِي صِدْقِ طِلَابِهِ وَصِحَّةِ مَقْصُودِهِ مُتَعَاوِنًا عَلَى الْبِرِّ وَالتَّقْوَى مَعَ

263
00:48:10,337 --> 00:48:12,909
الْخَلْقِ فِي

264
00:48:12,909 --> 00:48:13,551
حَمْلِهِمْ

265
00:48:40,400 --> 00:48:42,480
عَلَى الْهِجْرَةِ إِلَى

266
00:48:50,800 --> 00:48:52,880
اللَّهِ وَرَسُولِهِ صَلَّى

267
00:49:02,061 --> 00:49:04,383
اللَّهُ عَلَيْهِ وَسَلَّمَ حَصَلَ هَذَا الْخَيْرُ،

268
00:49:30,446 --> 00:49:32,090
مَا انْتَهَتْ إِلَيْهِ الْحَالُ،

269
00:49:32,090 --> 00:49:34,832
وَهُوَ قَوْلُهُ: قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: فَقَدْ أَشَرْتَ إِلَى سَفَرٍ

270
00:49:37,030 --> 00:49:39,230
عَظِيمٍ وَأَمْرٍ جَسِيمٍ،

271
00:49:48,030 --> 00:49:50,230
اللَّهُ: ثُمَّ أَجَابَ

272
00:49:52,980 --> 00:49:55,180
عَنْهُ مُبَيِّنًا زَادَهُ وَطَرِيقَهُ وَمَرْكَبَهُ،

273
00:50:13,244 --> 00:50:15,210
فِي الْأَوَّلِ:

274
00:50:21,599 --> 00:50:22,582
قَالَ

275
00:50:37,046 --> 00:50:39,821
الْمُصَنِّفُ حَفِظَهُ اللَّهُ: قُلْتُ: زَادُهُ الْعِلْمُ الْمَوْرُوثُ عَنْ خَاتَمِ الْأَنْبِيَاءِ

276
00:50:49,815 --> 00:50:52,036
اللَّهُ عَلَيْهِ وَسَلَّمَ.

277
00:51:14,444 --> 00:51:17,040
اللَّهُ: فَالزَّادُ الْكَامِلُ النَّافِعُ

278
00:51:35,836 --> 00:51:37,749
فِي الْهِجْرَةِ بِالْقُلُوبِ

279
00:52:00,713 --> 00:52:04,540
إِلَى اللَّهِ وَرَسُولِهِ صَلَّى

280
00:52:11,388 --> 00:52:13,489
اللَّهُ عَلَيْهِ وَسَلَّمَ هُوَ الْعِلْمُ الَّذِي جَاءَ بِهِ النَّبِيُّ صَلَّى

281
00:52:24,659 --> 00:52:26,509
اللَّهُ عَلَيْهِ وَسَلَّمَ،

282
00:52:43,084 --> 00:52:44,911
لَهُ

283
00:52:57,331 --> 00:52:59,104
هَذَا الزَّادَ فَلَا يَخْرُجْ مِنْ بَيْتِهِ وَلْيَقْعُدْ مَعَ الْقَاعِدِينَ،

284
00:53:05,976 --> 00:53:08,712
أَنْ يُحْصَوْا،

285
00:53:32,917 --> 00:53:34,612
مَنْ كَانَ زَادُهُ الْعِلْمَ الْمَوْرُوثَ عَنِ النَّبِيِّ صَلَّى اللَّهُ

286
00:53:39,318 --> 00:53:41,200
عَلَيْهِ وَسَلَّمَ فَإِنَّهُ لَا يَزَالُ يَتَقَلَّبُ

287
00:53:48,200 --> 00:53:50,354
بَيْنَ نَعِيمٍ وَنَعِيمٍ،

288
00:53:55,969 --> 00:53:59,046
عَلَيْهِ وَسَلَّمَ وَجَدَ

289
00:54:26,318 --> 00:54:27,994
فِيهِ شَيْئًا عَظِيمًا،

290
00:54:31,906 --> 00:54:33,582
مَنْ صَدَقَ مَعَ اللَّهِ عَزَّ وَجَلَّ فَتَحَ اللَّهُ عَزَّ وَجَلَّ

291
00:54:38,611 --> 00:54:40,288
أَنَّهُ

292
00:55:01,878 --> 00:55:04,207
هُوَ وَجَمَاعَةٌ

293
00:55:20,520 --> 00:55:24,437
مِنْ أَصْحَابِهِ مِنَ الْمَالِكِيَّةِ تَذَاكَرُوا

294
00:55:29,621 --> 00:55:31,926
فِي بَغْدَادَ آيَةَ الطَّهَارَةِ،

295
00:55:52,669 --> 00:55:54,310
مِنْ خَمْسِينَ وَثَمَانِمِائَةِ حُكْمٍ.

296
00:56:01,971 --> 00:56:06,349
فِي [فَتْحِ الْبَارِي] أَنَّ

297
00:56:06,349 --> 00:56:06,896
[ابْنَ الْمُنْذِرِ] رَحِمَهُ اللَّهُ

298
00:56:19,040 --> 00:56:21,035
تَعَالَى اسْتَخْرَجَ

299
00:56:23,254 --> 00:56:24,918
مِنْ حَدِيثِ صِفَةِ حَجِّ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

300
00:56:35,459 --> 00:56:37,123
مِنْ حَدِيثِ [جَابِرٍ] أَكْثَرَ

301
00:56:47,820 --> 00:56:49,840
مِنْ أَلْفِ فَائِدَةٍ.

302
00:56:52,476 --> 00:56:55,113
فِي الْعِلْمِ الْمَوْرُوثِ عَنِ النَّبِيِّ صَلَّى اللَّهُ

303
00:56:57,749 --> 00:57:00,385
عَلَيْهِ وَسَلَّمَ أَعْظَمُ مِنْ كُلِّ زَادٍ سِوَاهُ،

304
00:57:06,317 --> 00:57:08,954
إِلَى غَيْرِهِ فَإِنَّهُ لَا يُحَصِّلُ شَيْئًا،

305
00:57:17,522 --> 00:57:19,320
فِي حَالِ النَّاسِ

306
00:57:25,695 --> 00:57:28,025
فِي الدُّنْيَا مُسَلَّاةٌ يُخَفِّفُ بِهَا بَعْضُهُمْ عَنْ بَعْضٍ أَثَرَ الْآلَامِ،

307
00:57:48,474 --> 00:57:50,903
فِي الْآخِرَةِ فَلَا مُسَلَّاةَ لِأَهْلِهَا،

308
00:58:00,617 --> 00:58:03,653
[ابْنُ الْقَيِّمِ]: [فَهَذَا الرَّوْحُ الْحَاصِلُ -يَعْنِي الْفَرَجَ بَعْدَ الشِّدَّةِ- الْحَاصِلُ

309
00:58:11,403 --> 00:58:14,860
مِنَ التَّأَسِّي مَعْدُومٌ بَيْنَ الْمُسْتَرِخِينَ فِي الْعَذَابِ يَوْمَ الْقِيَامَةِ؛ لِأَنَّ

310
00:58:18,033 --> 00:58:21,124
فِي الدُّنْيَا،

311
00:58:42,900 --> 00:58:44,820
فِي الْآخِرَةِ فَلَا مَحَلَّ لِذَلِكَ].

312
00:58:55,672 --> 00:58:58,851
ثُمَّ بَيَّنَ طَرِيقَهُ فِي قَوْلِهِ: قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَأَمَّا

313
00:59:01,874 --> 00:59:03,169
مِنَ الرَّدَى ...

314
00:59:14,828 --> 00:59:16,486
وَفِي

315
00:59:37,738 --> 00:59:39,043
ذَلِكَ

316
00:59:41,217 --> 00:59:42,956
قَالَ أَيْضًا بَعْضُ الشُّعَرَاءِ: [لَوْلَا الْمَشَقَّةُ سَادَ النَّاسُ كُلُّهُمْ ...

317
00:59:48,546 --> 00:59:50,736
عَلَى نَفْسِهِ

318
01:00:15,850 --> 01:00:17,619
فِي طَلَبِ الْمَعَالِي؛ فَإِنَّهُ

319
01:00:39,038 --> 01:00:41,371
لَا يُمْكِنُ لَهُ رُكُوبُ

320
01:00:42,149 --> 01:00:44,482
هَذَا الطَّرِيقِ.

321
01:00:44,482 --> 01:00:46,875
ثُمَّ ذَكَرَ الْمُصَنِّفُ أَنَّهُ لَا

322
01:00:50,645 --> 01:01:01,952
الَّذِي هُوَ بِهِ.

323
01:01:11,645 --> 01:01:12,722
عَلَيْهِ

324
01:01:14,865 --> 01:01:15,934
نَفْسُهُ

325
01:01:33,051 --> 01:01:34,655
فِي اللَّهِ عَزَّ وَجَلَّ،

326
01:01:41,201 --> 01:01:42,760
مِنْ أَحَدٍ

327
01:02:04,048 --> 01:02:06,108
مِنَ الْخَلْقِ إِلَيْهَا إِحْسَانًا.

328
01:02:30,920 --> 01:02:33,303
الْأَمْرَيْنِ لَا يَتِمَّانِ إِلَّا بِالصَّبْرِ،

329
01:02:33,303 --> 01:02:36,281
ثُمَّ ذَكَرَ مَرْكَبَهُ بِقَوْلِهِ: قَالَ الْمُصَنِّفُ حَفِظَهُ اللَّهُ: وَأَمَّا مَرْكَبُهُ

330
01:02:36,281 --> 01:02:38,664
قَالَ الشَّارِحُ هَدَاهُ اللَّهُ: وَيَجْمَعُ ذَلِكَ

331
01:02:58,391 --> 01:03:00,839
مَا أَخْبَرَ

332
01:03:12,957 --> 01:03:14,088
اللَّهُ

333
01:03:18,614 --> 01:03:21,442
عَزَّ وَجَلَّ بِهِ

334
01:03:24,836 --> 01:03:26,533
مِنْ حَالِ النَّاسِ إِذْ قَالَ

335
01:03:43,481 --> 01:03:45,146
اللَّهُ عَزَّ وَجَلَّ: ﴿يَا أَيُّهَا النَّاسُ أَنْتُمُ الْفُقَرَاءُ إِلَى

336
01:03:46,812 --> 01:03:48,477
اللَّهِ وَاللَّهُ هُوَ الْغَنِيُّ الْحَمِيدُ﴾،

