1
00:00:00,690 --> 00:00:02,670
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

2
00:00:02,670 --> 00:00:05,670
وَالسَّلَامُ عَلَيْكُمْ وَبَرَكَاتُهُ،

3
00:00:05,670 --> 00:00:08,910
الْحَمْدُ لِلَّهِ الَّذِي أَنْزَلَ بِالْعِلْمِ الْوَحْيَ

4
00:00:08,910 --> 00:00:12,010
الْمُبِينَ، وَقَيَّدَ لِتَقْرِيبِهِ إِلَيْنَا

5
00:00:12,010 --> 00:00:15,190
عُلَمَاءَ رَبَّانِيِّينَ، وَأَشْهَدُ أَنْ لَا

6
00:00:15,190 --> 00:00:18,310
إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

7
00:00:18,310 --> 00:00:21,090
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ

8
00:00:21,090 --> 00:00:24,290
وَرَسُولُهُ، صَلَّى اللَّهُ عَلَيْهِ وَعَلَى

9
00:00:24,290 --> 00:00:27,530
آلِهِ وَصَحْبِهِ مَا فُتِحَتْ

10
00:00:27,530 --> 00:00:30,190
مَدَارِكُ الْفُهُومِ، وَسَلَّمَ عَلَيْهِ

11
00:00:30,190 --> 00:00:33,030
وَعَلَيْهِمْ مَا قُرِّبَتْ إِلَيْنَا الْعُلُومُ؛

12
00:00:33,710 --> 00:00:36,790
فَهَذَا الْمَجْلِسُ الثَّانِي مِنْ

13
00:00:36,790 --> 00:00:40,150
شَرْحِ الْكِتَابِ الْأَوَّلِ فِي بَرْنَامَجِ [تَقْرِيبِ

14
00:00:40,150 --> 00:00:43,150
الْعِلْمِ]، وَهُوَ [خُلَاصَةُ تَعْظِيمِ الْعِلْمِ]

15
00:00:43,150 --> 00:00:46,450
لِمُصَنِّفِهِ الشَّيْخِ صَالِحِ بْنِ عَبْدِ اللَّهِ

16
00:00:46,450 --> 00:00:49,290
بْنِ حَمَدٍ الْعُصَيْمِيِّ حَفِظَهُ اللَّهُ

17
00:00:49,290 --> 00:00:51,730
وَنَفَعَنَا بِعِلْمِهِ فِي الدُّعَاءِ،

18
00:00:52,200 --> 00:00:55,590
وَقَدِ انْتَهَى بِنَا الْمَجْلِسُ الْأَوَّلُ إِلَى قَوْلِهِ:

19
00:00:55,590 --> 00:00:57,590
الْمَعْقِدُ الْأَوَّلُ، نَعَمْ.

20
00:00:57,590 --> 00:00:59,470
اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا

21
00:01:09,110 --> 00:01:11,560
وَلِلْحَاضِرِينَ، قَالَ الْمُصَنِّفُ صَالِحُ بْنُ عَبْدِ اللَّهِ بْنِ حَمَدٍ الْعُصَيْمِيُّ

22
00:01:11,580 --> 00:01:14,430
فِي [الْخُلَاصَةِ لِتَعْظِيمِ الْعِلْمِ]:

23
00:01:15,690 --> 00:01:18,990
الْمَعْقِدُ الْأَوَّلُ: تَقْرِيرُ وِعَاءِ

24
00:01:18,990 --> 00:01:20,290
الْعِلْمِ، وَهُوَ الْقَلْبُ،

25
00:01:20,310 --> 00:01:22,870
وَبِحَسَبِ طَهَارَةِ الْقَلْبِ يَبْقَى فِيهِ

26
00:01:24,250 --> 00:01:27,630
الْعِلْمُ، وَإِذَا ازْدَادَتْ طَهَارَتُهُ

27
00:01:27,630 --> 00:01:30,710
بِالتَّالِي قَبُولًا، فَمَنْ

28
00:01:30,710 --> 00:01:32,070
أَرَادَ حِيَازَةَ الْعِلْمِ فَلْيُزَيِّنْ بَاطِنَهُ،

29
00:01:32,090 --> 00:01:32,390
وَيُطَهِّرْ

30
00:01:35,170 --> 00:01:37,010
قَلْبَهُ مِنَ النَّجَاسَاتِ؛

31
00:01:37,030 --> 00:01:38,310
فَالْعِلْمُ جَوْهَرٌ لَطِيفٌ لَا

32
00:01:38,310 --> 00:01:40,110
يَصْلُحُ إِلَّا لِلْقَلْبِ النَّظِيفِ،

33
00:01:41,170 --> 00:01:44,250
وَطَهَارَةُ الْقَلْبِ تَرْجِعُ إِلَى أَصْلَيْنِ عَظِيمَيْنِ:

34
00:01:44,710 --> 00:01:46,610
أَحَدُهُمَا: طَهَارَتُهُ مِنْ

35
00:01:47,490 --> 00:01:49,110
نَجَاسَةِ الشُّبُهَاتِ، وَالْآخَرُ:

36
00:01:49,110 --> 00:01:51,030
طَهَارَتُهُ مِنْ نَجَاسَةِ الشَّهَوَاتِ،

37
00:01:51,030 --> 00:01:54,390
وَإِذَا كُنْتَ تَسْتَحِي مِنْ نَظَرِ

38
00:01:54,390 --> 00:01:56,650
مَخْلُوقٍ مِثْلِكَ إِلَى وَسَخِ ثَوْبِكَ،

39
00:01:56,670 --> 00:01:56,970
فَاسْتَحِ مِنْ نَظَرِ

40
00:02:01,270 --> 00:02:02,390
اللَّهِ إِلَى قَلْبِكَ،

41
00:02:02,410 --> 00:02:04,510
وَإِذَا كُنْتَ تَسْتَحِي مِنْ نَظَرِ اللَّهِ إِلَى

42
00:02:04,510 --> 00:02:05,070
قَلْبِكَ.
