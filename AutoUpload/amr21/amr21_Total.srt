1
00:00:00,690 --> 00:00:02,670
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

2
00:00:02,670 --> 00:00:05,670
وَالسَّلَامُ عَلَيْكُمْ وَبَرَكَاتُهُ،

3
00:00:05,670 --> 00:00:08,910
الْحَمْدُ لِلَّهِ الَّذِي أَنْزَلَ بِالْعِلْمِ الْوَحْيَ

4
00:00:08,910 --> 00:00:12,010
الْمُبِينَ، وَقَيَّدَ لِتَقْرِيبِهِ إِلَيْنَا

5
00:00:12,010 --> 00:00:15,210
عُلَمَاءَ رَبَّانِيِّينَ، وَأَشْهَدُ أَنْ لَا

6
00:00:15,210 --> 00:00:18,310
إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

7
00:00:18,310 --> 00:00:21,090
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ

8
00:00:21,090 --> 00:00:24,290
وَرَسُولُهُ، صَلَّى اللَّهُ عَلَيْهِ وَعَلَى

9
00:00:24,290 --> 00:00:27,530
آلِهِ وَصَحْبِهِ مَا فُتِحَتْ

10
00:00:27,530 --> 00:00:30,190
مَدَارِكُ الْفُهُومِ، وَسَلَّمَ عَلَيْهِ

11
00:00:30,190 --> 00:00:33,030
وَعَلَيْهِمْ مَا قُرِّبَتْ إِلَيْنَا الْعُلُومُ،

12
00:00:33,710 --> 00:00:36,790
فَهَذَا الْمَجْلِسُ الثَّانِي مِنْ

13
00:00:36,790 --> 00:00:40,150
شَرْحِ الْكِتَابِ الْأَوَّلِ فِي بَرْنَامَجِ تَقْرِيبِ

14
00:00:40,150 --> 00:00:43,150
الْعِلْمِ، وَهُوَ [خُلَاصَةُ تَعْظِيمِ الْعِلْمِ]

15
00:00:43,150 --> 00:00:46,450
لِمُصَنِّفِهِ الشَّيْخِ صَالِحِ بْنِ عَبْدِ اللَّهِ

16
00:00:46,450 --> 00:00:49,290
بْنِ حَمَدٍ الْعُصَيْمِيِّ حَفِظَهُ اللَّهُ

17
00:00:49,290 --> 00:00:51,730
وَنَفَعَنَا بِعِلْمِهِ فِي الدُّعَاءِ،

18
00:00:51,730 --> 00:00:54,870
وَقَدِ انْتَهَى بِنَا الْمَجْلِسُ الْأَوَّلُ إِلَى

19
00:00:54,870 --> 00:00:57,570
قَوْلِهِ: الْمَعْقِدُ الْأَوَّلُ،

20
00:00:57,570 --> 00:00:59,510
نَعَمْ. اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا

21
00:01:08,830 --> 00:01:12,130
وَلِلْحَاضِرِينَ، قَالَ الشَّيْخُ صَالِحُ بْنِ عَبْدِ اللَّهِ بْنِ حَمَدٍ الْعُصَيْمِيُّ

22
00:01:12,130 --> 00:01:14,430
فِي [خُلَاصَةِ تَعْظِيمِ الْعِلْمِ]:

23
00:01:15,690 --> 00:01:18,990
الْمَعْقِدُ الْأَوَّلُ: تَطْهِيرُ وِعَاءِ

24
00:01:18,990 --> 00:01:20,290
الْعِلْمِ، وَهُوَ الْقَلْبُ،

25
00:01:20,310 --> 00:01:20,810
وَبِحَسَبِ طَهَارَةِ الْقَلْبِ يَنَالُهُ

26
00:01:24,130 --> 00:01:27,630
مِنَ الْعِلْمِ، وَإِذَا ازْدَادَتْ طَهَارَتُهُ

27
00:01:27,630 --> 00:01:30,710
بِالتَّأَلُّهِ قُرْبًا، فَمَنْ

28
00:01:30,710 --> 00:01:32,090
أَرَادَ نَيْلَ الْعِلْمِ فَلْيُزَيِّنْ

29
00:01:33,870 --> 00:01:35,670
بَاطِنَهُ، وَيُطَهِّرْ قَلْبَهُ مِنَ النَّجَاسَاتِ،

30
00:01:35,670 --> 00:01:37,550
فَالْعِلْمُ جَوْهَرٌ لَطِيفٌ،

31
00:01:37,950 --> 00:01:40,110
لَا يَصْلُحُ إِلَّا لِلْقَلْبِ النَّظِيفِ،

32
00:01:42,120 --> 00:01:44,250
وَطَهَارَةُ الْقَلْبِ تَرْجِعُ إِلَى أَصْلَيْنِ عَظِيمَيْنِ:

33
00:01:44,690 --> 00:01:46,610
أَحَدُهُمَا: طَهَارَتُهُ مِنْ

34
00:01:47,490 --> 00:01:49,110
كَدَرِ الشُّبُهَاتِ، وَالْآخَرُ:

35
00:01:49,110 --> 00:01:51,110
طَهَارَتُهُ مِنْ كَدَرِ الشَّهَوَاتِ،

36
00:01:51,840 --> 00:01:54,930
وَإِذَا كُنْتَ تَسْتَحِي مِنْ نَظَرِ مَخْلُوقٍ كَأَمْثَالِكَ

37
00:01:55,870 --> 00:01:57,730
إِلَى وَسَخِ ثَوْبِكَ،

38
00:01:57,750 --> 00:01:58,050
فَاسْتَحِ

39
00:02:02,390 --> 00:02:05,050
مِنْ نَظَرِ اللَّهِ إِلَى قَلْبِكَ،

40
00:02:05,150 --> 00:02:06,210
وَبِهِ خَتَمَ.
