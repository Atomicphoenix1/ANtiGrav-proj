1
00:00:00,690 --> 00:00:02,670
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

2
00:00:02,670 --> 00:00:05,670
وَالسَّلَامُ عَلَيْكُمْ وَبَرَكَاتُهُ،

3
00:00:05,670 --> 00:00:08,996
الْحَمْدُ لِلَّهِ الَّذِي أَنْزَلَ بِالْعِلْمِ الْوَحْيَ

4
00:00:08,996 --> 00:00:12,022
الْمُبِينَ، وَقَيَّدَ لِتَقْرِيبِهِ إِلَيْنَا

5
00:00:12,022 --> 00:00:15,062
عُلَمَاءَ رَبَّانِيِّينَ، وَأَشْهَدُ أَنْ لَا

6
00:00:15,062 --> 00:00:18,310
إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ،

7
00:00:18,310 --> 00:00:21,270
وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ

8
00:00:21,270 --> 00:00:24,690
وَرَسُولُهُ، صَلَّى اللَّهُ عَلَيْهِ وَعَلَى

9
00:00:24,690 --> 00:00:28,040
آلِهِ وَصَحْبِهِ مَا فُتِحَتْ مَدَارِكُ

10
00:00:28,040 --> 00:00:31,179
الْفُهُومِ، وَسَلَّمَ عَلَيْهِ وَعَلَيْهِمْ مَا

11
00:00:31,179 --> 00:00:33,030
قُرِّبَتْ إِلَيْنَا الْعُلُومُ؛

12
00:00:33,710 --> 00:00:36,855
فَهَذَا الْمَجْلِسُ الثَّانِي مِنْ شَرْحِ

13
00:00:36,855 --> 00:00:40,001
الْكِتَابِ الْأَوَّلِ فِي بَرْنَامَجِ [تَقْرِيبِ

14
00:00:40,001 --> 00:00:43,492
الْعِلْمِ]، وَهُوَ [خُلَاصَةُ تَعْظِيمِ الْعِلْمِ] لِمُصَنِّفِهِ

15
00:00:43,492 --> 00:00:46,925
الشَّيْخِ صَالِحِ بْنِ عَبْدِ اللَّهِ بْنِ

16
00:00:46,925 --> 00:00:50,120
حَمَدٍ الْعُصَيْمِيِّ حَفِظَهُ اللَّهُ وَنَفَعَنَا

17
00:00:50,120 --> 00:00:51,730
بِعِلْمِهِ فِي الدُّعَاءِ،

18
00:00:51,730 --> 00:00:54,974
وَقَدِ انْتَهَى بِنَا الْمَجْلِسُ الْأَوَّلُ

19
00:00:54,974 --> 00:00:57,570
إِلَى قَوْلِهِ: الْمَعْقِدُ الْأَوَّلُ،

20
00:00:57,570 --> 00:00:59,816
نَعَمْ. اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا

21
00:01:04,947 --> 00:01:08,025
وَلِلْحَاضِرِينَ، قَالَ الْمُصَنِّفُ صَالِحُ بْنُ عَبْدِ

22
00:01:08,025 --> 00:01:11,104
اللَّهِ بْنِ حَمَدٍ الْعُصَيْمِيُّ

23
00:01:12,130 --> 00:01:14,430
فِي [الْخُلَاصَةِ لِتَعْظِيمِ الْعِلْمِ]:

24
00:01:15,690 --> 00:01:18,616
الْمَعْقِدُ الْأَوَّلُ: تَقْرِيرُ وِعَاءِ

25
00:01:18,616 --> 00:01:20,079
الْعِلْمِ، وَهُوَ الْقَلْبُ،

26
00:01:20,099 --> 00:01:20,810
وَبِحَسَبِ طَهَارَةِ الْقَلْبِ

27
00:01:22,840 --> 00:01:24,870
يَبْقَى فِيهِ الْعِلْمُ،

28
00:01:25,950 --> 00:01:28,286
وَإِذَا ازْدَادَتْ طَهَارَتُهُ بِالتَّالِي قَبُولًا،

29
00:01:30,150 --> 00:01:32,014
فَمَنْ أَرَادَ حِيَازَةَ الْعِلْمِ فَلْيُزَيِّنْ

30
00:01:33,878 --> 00:01:36,250
بَاطِنَهُ، وَيُطَهِّرْ قَلْبَهُ مِنَ النَّجَاسَاتِ؛

31
00:01:36,250 --> 00:01:39,550
فَالْعِلْمُ جَوْهَرٌ لَطِيفٌ لَا يَصْلُحُ إِلَّا

32
00:01:39,550 --> 00:01:42,977
لِلْقَلْبِ النَّظِيفِ، وَطَهَارَةُ الْقَلْبِ

33
00:01:42,977 --> 00:01:44,262
تَرْجِعُ إِلَى أَصْلَيْنِ عَظِيمَيْنِ:

34
00:01:44,690 --> 00:01:47,900
أَحَدُهُمَا: طَهَارَتُهُ مِنْ نَجَاسَةِ الشُّبُهَاتِ،

35
00:01:47,900 --> 00:01:51,110
وَالْآخَرُ: طَهَارَتُهُ مِنْ نَجَاسَةِ الشَّهَوَاتِ،

36
00:01:51,840 --> 00:01:54,785
وَإِذَا كُنْتَ تَسْتَحِي مِنْ نَظَرِ

37
00:01:54,785 --> 00:01:57,730
مَخْلُوقٍ مِثْلِكَ إِلَى وَسَخِ ثَوْبِكَ،

38
00:01:57,750 --> 00:01:58,050
فَاسْتَحِ

39
00:02:01,883 --> 00:02:05,050
مِنْ نَظَرِ اللَّهِ إِلَى قَلْبِكَ،

40
00:02:05,150 --> 00:02:07,090
وَإِذَا كُنْتَ تَسْتَحِي مِنْ نَظَرِ اللَّهِ إِلَى قَلْبِكَ.
