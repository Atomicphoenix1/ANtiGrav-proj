    {
      "parameters": {
        "jsCode": "const processedItems = [];\n\nconst firstMatch = $input.all()[0]?.json;\n\n// Only reject if Pinecone literally returned nothing at all\nif (!firstMatch || !firstMatch.document) {\n  processedItems.push({\n    json: {\n      result: \"STATUS_NOT_FOUND: عذراً، لم يتم العثور على فتاوى سابقة مشابهة في قاعدة البيانات.\"\n    }\n  });\n} else {\n  // If ANY match exists, we trust it and mark it as completely FOUND\n  for (const item of $input.all()) {\n    const pageContent = item.json.document?.pageContent || \"\";\n    \n    const titleMatch = pageContent.match(/title:\\s*\"?([^\"\\n]+)\"?/);\n    const questionMatch = pageContent.match(/question:\\s*\"?([^\"\\n]+)\"?/);\n    \n    const parts = pageContent.split('---');\n    const fatwaAnswer = parts.length > 2 ? parts[2].trim() : pageContent.trim();\n    \n    const title = titleMatch ? titleMatch[1] : \"بدون عنوان\";\n    const question = questionMatch ? questionMatch[1] : \"بدون سؤال\";\n\n    processedItems.push({\n      json: {\n        result: `STATUS_FOUND\nالفتوى المعتمدة: ${fatwaAnswer}\n\n\\n\\n**المراجع:** ${title}\\n**السؤال المؤرشف:** ${question}\\n**الفتوى المعتمدة:** ${fatwaAnswer}`\n      }\n    });\n    break; // Trust the top-1 best match\n  }\n}\n\nreturn processedItems;"
      },
