{
  "name": "WhatsApp Scheduler with Time Slots",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst timeSlots = body.timeSlots;\nconst participants = body.participants;\nconst message = body.message;\n\nif (!timeSlots || timeSlots.length === 0) {\n  throw new Error('No time slots provided');\n}\n\nif (!participants || participants.length === 0) {\n  throw new Error('No participants provided');\n}\n\n// Parse first time slot (e.g., \"12:00 AM - 12:30 AM\")\nconst firstSlotText = timeSlots[0];\nconst startTime = firstSlotText.split(' - ')[0].trim();\n\n// Parse time string to today's date\nconst now = new Date();\nconst timeParts = startTime.match(/(\\d+):(\\d+)\\s+(AM|PM)/);\nif (!timeParts) {\n  throw new Error('Invalid time format in slot: ' + firstSlotText);\n}\n\nlet hours = parseInt(timeParts[1]);\nconst minutes = parseInt(timeParts[2]);\nconst period = timeParts[3];\n\nif (period === 'PM' && hours !== 12) hours += 12;\nif (period === 'AM' && hours === 12) hours = 0;\n\nconst firstSlot = new Date(now.getFullYear(), now.getMonth(), now.getDate(), hours, minutes);\n\n// Subtract 15 minutes\nconst scheduleTime = new Date(firstSlot.getTime() - 15 * 60 * 1000);\n\n// Extract phone numbers from participants\nconst phoneNumbers = participants.map(p => p.phone);\n\nreturn [{\n  json: {\n    scheduleTime: scheduleTime.toISOString(),\n    message: message,\n    phoneNumbers: phoneNumbers,\n    timeSlots: timeSlots\n  }\n}];"
      },
