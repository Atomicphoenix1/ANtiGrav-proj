1
00:27:33,121 --> 00:27:34,885
ذَكَرَ حُرُوفَ الْمَدِّ،

2
00:27:34,885 --> 00:27:38,415
قَالَ: [حُرُوفُهُ ثَلَاثَةٌ فَعِيهَا]؛ أَيْ: فَافْهَمْهَا،

3
00:27:38,415 --> 00:27:41,356
[مِنْ لَفْظِ وَايٍ]؛ أَيْ: تَجْمَعُ

4
00:27:41,356 --> 00:27:43,121
فِي كَلِمَةِ (وَايٍ)،

5
00:27:43,121 --> 00:27:45,474
وَهِيَ فِي ﴿نُوحِيهَا﴾،

6
00:27:45,474 --> 00:27:48,415
ذَكَرَ كَلِمَةً جَمَعَتْ حُرُوفَ الْمَدِّ

7
00:27:48,415 --> 00:27:51,356
مَعَ شُرُوطِهَا ﴿نُوحِيهَا﴾؛ الْوَاوُ سَاكِنَةٌ

8
00:27:51,356 --> 00:27:52,532
وَقَبْلَهَا ضَمٌّ،

9
00:27:52,532 --> 00:27:56,650
وَالْيَاءُ سَاكِنَةٌ وَقَبْلَهَا كَسْرُ الْحَاءِ،

10
00:27:56,650 --> 00:27:59,459
وَكَذَلِكَ مَجْمُوعَةٌ فِي كَلِمَةِ

11
00:27:59,459 --> 00:28:00,863
﴿أُوذِينَا﴾ وَ ﴿أُوتِينَا﴾،

12
00:28:00,863 --> 00:28:03,672
ثَلَاثُ كَلِمَاتٍ فِي الْقُرْآنِ

13
00:28:03,672 --> 00:28:06,481
لَا رَابِعَ لَهَا جَمَعَتْ

14
00:28:06,481 --> 00:28:09,290
حُرُوفَ الْمَدِّ مَعَ شُرُوطِهَا:

15
00:28:09,290 --> 00:28:12,099
﴿نُوحِيهَا﴾ وَ ﴿أُوذِينَا﴾ وَ ﴿أُوتِينَا﴾؛ قَالَ:

16
00:28:12,099 --> 00:28:14,908
[وَاللِّينُ مِنْهَا الْيَاءُ وَوَاوٌ

17
00:28:14,908 --> 00:28:17,717
سُكِّنَا * إِنِ

18
00:28:17,717 --> 00:28:20,526
انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا]،

19
00:28:20,526 --> 00:28:23,334
ثُمَّ بَيَّنَ الشَّارِحُ رَحِمَهُ

20
00:28:23,334 --> 00:28:26,143
اللَّهُ أَنَّ حُرُوفَ الْمَدِّ

21
00:28:26,143 --> 00:28:29,321
عَلَى ثَلَاثَةِ أَقْسَامٍ؛ الْقِسْمُ الْأَوَّلُ:

22
00:28:29,321 --> 00:28:32,533
أَنَّ الْأَلِفَ وَالْوَاوَ وَالْيَاءَ تَأْتِي عَلَى

23
00:28:32,533 --> 00:28:35,745
ثَلَاثَةِ أَقْسَامٍ؛ الْقِسْمُ الْأَوَّلُ: أَنْ تَكُونَ

24
00:28:35,745 --> 00:28:36,816
حُرُوفَ مَدٍّ،

25
00:28:36,816 --> 00:28:40,563
وَهِيَ أَنْ تَسْكُنَ وَيُجَانِسَ الْحَرَكَةُ مَا قَبْلَهَا،

26
00:28:40,563 --> 00:28:43,775
أَوْ تَكُونَ الْحَرَكَةُ مُجَانِسَةً لِلْحَرْفِ مِثْلَ

27
00:28:43,775 --> 00:28:46,987
هَذَا؛ أَيْ: أَنْ تَسْكُنَ الْوَاوُ يَكُونُ

28
00:28:46,987 --> 00:28:48,058
قَبْلَهَا ضَمٌّ،

29
00:28:48,058 --> 00:28:50,735
تَسْكُنَ الْيَاءُ يَكُونُ قَبْلَهَا كَسْرٌ،

30
00:28:50,735 --> 00:28:53,412
تَسْكُنَ الْأَلِفُ وَيَكُونُ قَبْلَهَا فَتْحٌ،

31
00:28:53,412 --> 00:28:56,624
وَهِيَ دَائِمًا كَذَلِكَ؛ الْأَلِفُ دَائِمًا كَذَلِكَ

32
00:28:56,624 --> 00:28:58,230
سَاكِنَةٌ وَقَبْلَهَا فَتْحٌ.

33
00:28:58,250 --> 00:29:01,453
الْحَالُ الثَّانِيَةُ: أَنْ تَكُونَ هَذِهِ الْأَحْرُفُ

34
00:29:01,453 --> 00:29:03,588
الثَّلَاثَةُ حَرْفَ لِينٍ؛ مَتَى؟

35
00:29:03,588 --> 00:29:06,257
إِذَا سَكَنَتْ وَانْفَتَحَ مَا قَبْلَهَا،

36
00:29:06,257 --> 00:29:09,460
إِذَا سَكَنَتِ الْوَاوُ وَانْفَتَحَ مَا قَبْلَهَا

37
00:29:09,460 --> 00:29:12,129
فَهِيَ حَرْفُ لِينٍ مِثْلَ: ﴿خَوْفٍ﴾،

38
00:29:12,129 --> 00:29:15,332
إِذَا سَكَنَتِ الْيَاءُ وَانْفَتَحَ مَا قَبْلَهَا

39
00:29:15,332 --> 00:29:18,001
فَهِيَ حَرْفُ لِينٍ مِثْلَ: ﴿بَيْتٍ﴾،

40
00:29:18,001 --> 00:29:21,204
إِذَا سَكَنَتِ الْأَلِفُ وَانْفَتَحَ مَا قَبْلَهَا

41
00:29:21,204 --> 00:29:22,806
فَهِيَ حَرْفُ لِينٍ،

42
00:29:22,806 --> 00:29:26,009
وَهِيَ كَذَلِكَ الْأَلِفُ دَائِمًا تَكُونُ حَرْفَ

43
00:29:26,009 --> 00:29:27,610
لِينٍ وَحَرْفَ مَدٍّ،

44
00:29:27,610 --> 00:29:31,030
لَكِنَّ الْوَاوَ وَالْيَاءَ هِيَ الَّتِي لَهَا حَالَانِ؛

45
00:29:31,030 --> 00:29:34,830
إِمَّا أَنْ تَكُونَ حَرْفَ مَدٍّ إِذَا تَجَانَسَتِ الْحَرَكَةُ مَعَهَا،

46
00:29:34,830 --> 00:29:37,194
أَوْ تَكُونَ حَرْفَ لِينٍ إِذَا سَكَنَتَا وَفُتِحَ

47
00:29:37,982 --> 00:29:38,770
مَا قَبْلَهُمَا.

48
00:29:38,770 --> 00:29:41,526
الْحَالُ الثَّالِثَةُ:

49
00:29:41,526 --> 00:29:44,283
أَنْ تَتَحَرَّكَ

50
00:29:44,283 --> 00:29:45,661
الْوَاوُ وَالْيَاءُ،

51
00:29:48,417 --> 00:29:51,174
وَهُنَا يَكُونُ

52
00:29:51,174 --> 00:29:54,430
حَرْفَ عِلَّةٍ؛ لِمَاذَا

53
00:29:54,430 --> 00:29:55,930
يَكُونُ حَرْفَ عِلَّةٍ؟

54
00:29:55,930 --> 00:29:59,430
لِأَنَّهُ يَكُونُ قَدِ انْقَلَبَ مِنْ حَرْفٍ آخَرَ،

55
00:29:59,430 --> 00:30:01,414
(السَّمَاوِيُّ) الْوَاوُ

56
00:30:02,406 --> 00:30:04,390
مَفْتُوحَةٌ هُنَا،

57
00:30:04,390 --> 00:30:07,366
إِذًا هَذِهِ الْوَاوُ

58
00:30:08,358 --> 00:30:11,936
مُنْقَلِبَةٌ مَثَلًا أَصْلُهَا (السَّمَاوِيُّ)،

59
00:30:11,936 --> 00:30:15,384
فَإِذَا تَحَرَّكَتِ الْأَلِفُ وَالْيَاءُ

60
00:30:15,384 --> 00:30:17,108
فَهُمَا حَرْفَا عِلَّةٍ،

61
00:30:18,970 --> 00:30:22,150
وَالْمُرَادُ عِنْدَنَا هُنَا حَرْفُ الْمَدِّ يُمَدُّ

62
00:30:22,150 --> 00:30:23,890
فِي أَحْوَالٍ كَمَا سَيَتْبَعُونَ،

63
00:30:23,930 --> 00:30:27,343
وَحَرْفُ اللَّينِ يُمَدُّ كَذَلِكَ كَمَا

64
00:30:27,343 --> 00:30:29,390
سَيَأْتِي بَيَانُهُ بِالتَّفْصِيلِ،

65
00:30:29,390 --> 00:30:32,482
أَمَّا حَرْفُ الْعِلَّةِ فَلَا مَبْحَثَ لَهُ عِنْدَنَا

66
00:30:32,482 --> 00:30:34,690
فِي التَّجْوِيدِ مِنْ نَاحِيَةِ الْمَدِّ،

67
00:30:34,690 --> 00:30:37,150
لَا، يَبْقَى كَمَا هُوَ لَا يُمَدُّ،

68
00:30:37,150 --> 00:30:40,110
وَقَوْلُ الْمُصَنِّفِ رَحِمَهُ اللَّهُ

69
00:30:40,110 --> 00:30:42,699
فَعُلِمَ أَنَّ الْيَاءَ وَالْوَاوَ

70
00:30:43,561 --> 00:30:46,693
لَهُمَا ثَلَاثَةُ أَحْوَالٍ: مَدٌّ،

71
00:30:46,693 --> 00:30:49,408
وَهَذَا إِذَا سَكَنَ وَتَجَانَسَتِ الْحَرَكَةُ،

72
00:30:49,408 --> 00:30:53,210
أَوْ لِينٌ إِذَا سَكَنَ وَانْفَتَحَ مَا قَبْلَهُمَا،

73
00:30:58,792 --> 00:31:00,188
وَلَا قَوْلُهُ (وَلَا)؛

74
00:31:02,281 --> 00:31:03,677
أَيْ: لَا

75
00:31:18,716 --> 00:31:19,611
مَدَّ وَلَا لِينَ،

76
00:31:19,164 --> 00:31:22,373
وَإِنَّمَا إِنْ تَحَرَّكَتَا أَيْ يَكُونُ

77
00:31:25,947 --> 00:31:27,032
حَرْفَ عِلَّةٍ،

78
00:31:26,489 --> 00:31:27,574
نَعَمْ. أَحْكَامُ الْمَدِّ لِلْمَدِّ أَحْكَامٌ ثَلَاثَةٌ تَدُومُ ...

79
00:31:27,032 --> 00:31:27,574
وَهِيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّزُومُ فَوَاجِبٌ إِنْ

80
00:31:32,455 --> 00:31:33,540
جَاءَ هَمْزٌ بَعْدَ

81
00:31:37,879 --> 00:31:38,421
مَدٍّ ...

82
00:31:41,133 --> 00:31:42,218
فِي كَلِمَةٍ وَذَا بِمُتَّصِلٍ يُعَدّْ عُلِمَ أَنَّ

83
00:31:48,444 --> 00:31:49,392
الْمَدَّ مَعَ الْهَمْزَةِ مُنْقَسِمٌ عَلَى ثَلَاثَةِ أَقْسَامٍ؛ الْأَوَّلُ: أَنْ يَتَقَدَّمَ

84
00:31:48,918 --> 00:31:51,760
حَرْفُ الْمَدِّ وَاللِّينِ وَتَأْتِيَ الْهَمْزَةُ بَعْدَهُ فِي الْكَلِمَةِ الَّتِي هُوَ

85
00:31:51,286 --> 00:31:51,760
فِيهَا، نَحْوَ: ﴿جَاءَ﴾ وَ ﴿شَاءَ﴾ وَ ﴿السُّوءِ﴾ وَ ﴿سِيئَتْ﴾،

86
00:31:51,286 --> 00:31:51,760
فَهَذَا يَجِبُ شَرْعًا مَدُّهُ،

87
00:31:51,286 --> 00:31:51,760
وَيُقَالُ لَهُ:

88
00:32:14,876 --> 00:32:15,987
مَدٌّ مُتَّصِلٌ؛ لِاتِّصَالِ الْهَمْزَةِ بِحَرْفِ

89
00:32:20,560 --> 00:32:20,973
الْمَدِّ

90
00:32:30,092 --> 00:32:31,217
فِي تِلْكَ الْكَلِمَةِ،

91
00:32:30,655 --> 00:32:31,217
وَلَهُ مَحَلُّ اتِّفَاقٍ،

92
00:32:30,655 --> 00:32:53,644
وَهُوَ اتِّفَاقُ الْقُرَّاءِ عَلَى اعْتِبَارِ أَثَرِ الْهَمْزَةِ مِنْ زِيَادَةِ الْمَدِّ،

93
00:32:53,644 --> 00:32:54,280
وَمَحَلُّ اخْتِلَافٍ،

94
00:32:53,644 --> 00:32:54,280
وَهُوَ تَفَاوُتُهُمْ

95
00:33:00,895 --> 00:33:01,972
فِي الزِّيَادَةِ،

96
00:33:01,434 --> 00:33:01,972
فَالْمَدُّ فِيهِ

97
00:33:26,130 --> 00:33:27,039
عِنْدَ أَبِي عَمْرٍو قَالَهُ،

98
00:33:26,585 --> 00:33:27,039
وَعِنْدَ ابْنِ كَثِيرٍ مِقْدَارُ أَلِفٍ وَنِصْفٍ وَقِيلَ وَرُبُعٍ،

99
00:33:26,585 --> 00:33:27,039
وَعِنْدَ ابْنِ عَامِرٍ وَالْكِسَائِيِّ مِقْدَارُ أَلِفَيْنِ،

100
00:33:26,585 --> 00:33:27,039
وَعِنْدَ عَاصِمٍ مِقْدَارُ أَلِفَيْنِ وَنِصْفٍ،

101
00:33:26,585 --> 00:33:27,039
وَعِنْدَ وَرْشٍ وَحَمْزَةَ مِقْدَارُ ثَلَاثِ أَلِفَاتٍ،

102
00:33:26,585 --> 00:33:27,039
وَ (مُتَّصِلٌ)

103
00:33:30,221 --> 00:33:31,130
فِي النَّظْمِ بِسُكُونِ اللَّامِ لِلضَّرُورَةِ،

104
00:33:30,675 --> 00:33:31,130
وَ (يُعَدُّ) بِالْمُثَنَّاةِ تَحْتُ مَضْمُومَةً.

105
00:33:30,675 --> 00:33:31,130
وَجَائِزٌ مَدٌّ وَقَصْرٌ

106
00:33:36,498 --> 00:33:37,235
إِنْ فُصِلْ ...

107
00:33:49,380 --> 00:33:50,880
كُلٌّ بِكَلِمَةٍ وَهَذَا الْمُنْفَصِلْ الثَّانِيَةُ: يَكُونُ حَرْفُ

108
00:33:53,880 --> 00:33:55,380
الْمَدِّ آخِرَ كَلِمَةٍ وَالْهَمْزَةُ أَوَّلَ كَلِمَةٍ أُخْرَى،

109
00:33:54,630 --> 00:33:55,380
وَهَذَا يَجُوزُ مَدُّهُ وَقَصْرُهُ،

110
00:33:54,630 --> 00:33:55,380
وَيُسَمَّى مَدًّا مُنْفَصِلًا؛ لِانْفِصَالِ كُلٍّ مِنَ

111
00:34:19,130 --> 00:34:22,077
الْمَدِّ وَالْهَمْزَةِ فِي كَلِمَةٍ،

112
00:34:37,686 --> 00:34:39,463
نَحْوَ: ﴿بِمَا أَنْزَلَ﴾ وَ

113
00:34:43,463 --> 00:34:44,130
﴿فِي أُمِّهَا﴾ وَ ﴿قُوا أَنْفُسَكُمْ﴾،

114
00:34:43,797 --> 00:34:44,130
وَفِيهِ خِلَافٌ؛ فَوَرْشٌ وَابْنُ عَامِرٍ وَعَاصِمٌ وَحَمْزَةُ وَالْكِسَائِيُّ يُثْبِتُونَهُ بِلَا

115
00:34:43,797 --> 00:34:44,130
خِلَافٍ، وَابْنُ كَثِيرٍ وَالسُّوسِيُّ يَنْفِيَانِهِ بِلَا خِلَافٍ،

116
00:34:43,797 --> 00:34:44,130
وَقَالُونُ وَالدُّورِيُّ يُثْبِتَانِهِ وَيَنْفِيَانِهِ،

117
00:34:43,797 --> 00:34:44,130
وَتَفَاوُتُ الْمَدَّيْنِ

118
00:35:02,857 --> 00:35:03,766
فِي الزِّيَادَةِ كَتَفَاوُتِهِمْ فِيهَا فِيمَا مَرَّ

119
00:35:27,630 --> 00:35:28,380
فِي

120
00:35:50,418 --> 00:35:51,327
الْمَدِّ الْمُتَّصِلِ.

121
00:35:50,873 --> 00:35:51,327
وَمِثْلُ ذَا

122
00:36:09,908 --> 00:36:10,831
إِنْ عَرَضَ السُّكُونُ ...

123
00:36:10,369 --> 00:36:10,831
وَقْفًا كَتَعْلَمُونَ نَسْتَعِينُ وَمِثْلُ

124
00:36:30,140 --> 00:36:31,300
الْمَدِّ الْمُتَّصِلِ فِي جَوَازِ الْمَدِّ وَالْقَصْرِ

125
00:36:58,350 --> 00:36:59,850
وَالتَّوَسُّطِ عَرَضَ

126
00:37:19,133 --> 00:37:20,171
السُّكُونُ لِأَجْلِ الْوَقْفِ وَالْإِدْغَامِ،

127
00:37:19,600 --> 00:37:20,171
وَصُورَتُهُ هِيَ: يَكُونُ آخِرُ الْكَلِمَةِ مُتَحَرِّكًا وَقَبْلَهَا هُوَ حَرْفُ مَدٍّ

128
00:37:19,600 --> 00:37:20,171
وَلِينٍ، وَذَلِكَ كَـ ﴿تَعْلَمُونَ﴾ وَ ﴿نَسْتَعِينُ﴾ وَ ﴿الْمَآبِ﴾،

129
00:37:19,600 --> 00:37:20,171
وَكَيْ يَقُولَ رَبُّنَا

130
00:37:39,541 --> 00:37:40,600
فِي قِرَاءَةِ أَبِي عَمْرٍو مِنْ رِوَايَةِ السُّوسِيِّ،

131
00:37:40,071 --> 00:37:40,600
وَكَمَا ذَكَرَ

132
00:37:45,933 --> 00:37:47,000
أَنَّ فِيهَا أَوْجُهًا

133
00:37:54,171 --> 00:37:54,600
ثَلَاثَةً

134
00:38:03,440 --> 00:38:04,480
عِنْدَ كُلِّ الْقُرَّاءِ: الطُّولُ وَالتَّوَسُّطُ وَالْقَصْرُ،

135
00:38:03,960 --> 00:38:04,480
وَوَجْهُ كُلٍّ مَذْكُورٌ

136
00:38:18,953 --> 00:38:19,894
فِي الْأَصْلِ.

137
00:38:19,424 --> 00:38:19,894
أَوْ قُدِّمَ

138
00:38:38,662 --> 00:38:40,194
الْهَمْزُ عَلَى الْمَدِّ وَذَا ...

139
00:38:39,428 --> 00:38:40,194
بَدَلْ كَآمَنُوا وَإِيمَانًا خُذَا الثَّالِثُ: أَنْ يَجْتَمِعَ الْمَدُّ مَعَ الْهَمْزِ

140
00:38:49,650 --> 00:38:50,850
فِي كَلِمَةٍ لَكِنْ يَتَقَدَّمُ الْهَمْزُ

141
00:39:19,465 --> 00:39:20,004
عَلَى

142
00:39:24,850 --> 00:39:25,927
الْمَدِّ فِيهَا،

143
00:39:25,388 --> 00:39:25,927
سَوَاءٌ كَانَ

144
00:39:31,850 --> 00:39:32,927
الْمَدُّ ثَابِتًا مُحَقَّقًا أَوْ مُغَيَّرًا لِلْبَدَلِ أَوِ التَّسْهِيلِ أَوِ الْحَذْفِ

145
00:39:32,388 --> 00:39:32,927
بَعْدَ النَّقْلِ،

146
00:39:32,388 --> 00:39:32,927
فَحُكْمُهُ

147
00:39:42,081 --> 00:39:43,158
الْقَصْرُ عِنْدَ كُلِّ الْقُرَّاءِ غَيْرَ وَرْشٍ،

148
00:39:42,619 --> 00:39:43,696
وَلِوَرْشٍ فِيهِ الْمَدُّ وَالتَّوَسُّطُ وَالْقَصْرُ،

149
00:39:43,158 --> 00:39:43,696
فَلْنَعْمَدْ بَدَلًا،

150
00:39:43,158 --> 00:39:43,696
وَذَلِكَ كَـ ﴿آمَنُوا﴾ وَ ﴿إِيمَانًا﴾ وَ ﴿أُوتُوا﴾ وَ ﴿هَؤُلَاءِ آلِهَةً﴾

151
00:39:43,158 --> 00:39:43,696
عَلَى قِرَاءَةِ الْبَدَلِ،

152
00:39:43,158 --> 00:39:43,696
وَلِلْإِيمَانِ بِالنَّقْلِ،

153
00:39:43,158 --> 00:39:43,696
وَ ﴿جَاءَ آلَ لُوطٍ﴾ بِالتَّسْهِيلِ عَلَى وَجْهٍ،

154
00:39:43,158 --> 00:39:43,696
وَ (بَدَلٌ)

155
00:40:02,250 --> 00:40:03,450
فِي النَّظْمِ بِالسُّكُونِ لِأَجْلِ الضَّرُورَةِ.

156
00:40:02,850 --> 00:40:03,450
وَلَازِمٌ

157
00:40:24,279 --> 00:40:25,564
إِنِ السُّكُونُ أُصِّلَا ...

158
00:40:24,921 --> 00:40:25,564
وَصْلًا وَوَقْفًا بَعْدَ مَدٍّ طُوِّلَا

159
00:40:29,564 --> 00:40:30,017
الْمَدُّ

160
00:40:33,183 --> 00:40:34,088
الثَّالِثُ إِذَا كَانَ السُّكُونُ أَصْلِيًّا

161
00:40:47,480 --> 00:40:50,739
فِي الْوَصْلِ وَالْوَقْفِ بَعْدَ حَرْفِ الْمَدِّ،

162
00:40:50,739 --> 00:40:51,554
يُمَدُّ لِكُلِّ الْقُرَّاءِ مَدًّا لَازِمًا بِقَدْرِ أَلِفَيْنِ عَلَى

163
00:41:14,350 --> 00:41:15,400
الْمَدِّ الطَّبِيعِيِّ عِنْدَ كُلِّ الْقُرَّاءِ،

164
00:41:14,850 --> 00:41:15,400
فَهُوَ بِهَا ثَلَاثُ أَلِفَاتٍ بِسِتِّ حَرَكَاتٍ،

165
00:41:14,850 --> 00:41:15,400
وَذَلِكَ نَحْوَ: ﴿الصَّاخَّةُ﴾ وَ ﴿الطَّامَّةُ﴾ وَ ﴿الضَّالِّينَ﴾ وَ ﴿أَتُحَاجُّونِّي﴾،

166
00:41:14,850 --> 00:41:15,400
وَوَجْهُ

167
00:41:19,250 --> 00:41:22,550
مَا ذُكِرَ مَذْكُورٌ

168
00:41:40,850 --> 00:41:42,850
فِي الْأَصْلِ

169
00:42:09,421 --> 00:42:11,136
مَعَ وَجْهِ التَّسْمِيَةِ،

170
00:42:10,279 --> 00:42:11,993
ثُمَّ ذَكَرَ الْمُصَنِّفُ

171
00:42:17,510 --> 00:42:19,840
رَحِمَهُ اللَّهُ أَحْكَامَ

172
00:42:23,840 --> 00:42:24,840
الْمَدِّ مَعَ الْهَمْزِ وَبِدُونِهِ،

173
00:42:24,340 --> 00:42:24,840
فَقَالَ رَحِمَهُ اللَّهُ: [لِلْمَدِّ أَحْكَامٌ ثَلَاثَةٌ تَدُورُ * وَهِيَ الْوُجُوبُ

174
00:42:24,340 --> 00:42:24,840
وَالْجَوَازُ وَاللُّزُومُ * فَوَاجِبٌ

175
00:42:34,295 --> 00:42:35,204
إِنْ جَاءَ هَمْزٌ بَعْدَ

176
00:42:58,310 --> 00:42:58,810
مَدٍّ *

177
00:43:03,167 --> 00:43:04,239
فِي كَلِمَةٍ وَذَا بِمُتَّصِلٍ يُعَدُّ]،

178
00:43:03,881 --> 00:43:04,239
مُمْكِنٌ

179
00:43:29,925 --> 00:43:31,464
أَنْ يُقَسَّمَ الْمَدُّ بِسَبَبِ الْهَمْزِ وَبِسَبَبِ السُّكُونِ،

180
00:43:30,695 --> 00:43:33,772
فَإِذَا كَانَ إِذَا

181
00:43:33,772 --> 00:43:34,541
جَاءَتْ أَحْرُفُ الْمَدِّ (الْأَلِفُ،

182
00:43:33,772 --> 00:43:34,541
الْوَاوُ، الْيَاءُ) بَعْدَ هَمْزَةٍ عِنْدَنَا ثَلَاثَةُ أَنْوَاعٍ

183
00:43:49,977 --> 00:43:51,643
مِنَ الْمُدُودِ؛

184
00:44:20,866 --> 00:44:21,977
الْمَدُّ الْأَوَّلُ: الْمُتَّصِلُ،

185
00:44:21,421 --> 00:44:24,199
وَهُوَ أَنْ يَأْتِيَ

186
00:44:24,754 --> 00:44:26,421
حَرْفُ الْمَدِّ وَالْهَمْزُ

187
00:44:29,199 --> 00:44:30,893
فِي كَلِمَةٍ مِثْلَ: ﴿السَّمَاءُ﴾،

188
00:44:30,310 --> 00:44:30,893
﴿مَاءٌ﴾، ﴿الْمَلَائِكَةُ﴾،

189
00:44:30,310 --> 00:44:30,893
فَهَذَا يَجِبُ مَدُّهُ عِنْدَ كُلِّ الْقُرَّاءِ عَلَى اخْتِلَافٍ بَيْنَهُمْ؛ مِنْهُمْ

190
00:44:33,227 --> 00:44:34,393
مَنْ يَمُدُّهُ ثَلَاثَةً،

191
00:44:33,810 --> 00:44:34,393
وَمِنْهُمْ مَنْ يَمُدُّهُ

192
00:44:39,192 --> 00:44:39,663
أَرْبَعَةً

193
00:44:43,898 --> 00:44:44,839
أَوْ خَمْسَةً أَوْ سِتَّةً.

194
00:44:44,369 --> 00:44:44,839
الْقِسْمُ الثَّانِي: الَّذِي سَبَبُهُ الْهَمْزُ الْمُنْفَصِلُ،

195
00:44:44,369 --> 00:44:44,839
وَهُوَ

196
00:45:01,925 --> 00:45:03,541
أَنْ يَأْتِيَ

197
00:45:06,772 --> 00:45:09,195
حَرْفُ الْمَدِّ فِي كَلِمَةٍ فِي آخِرِ

198
00:45:33,477 --> 00:45:57,736
الْكَلِمَةِ الْأُولَى،

199
00:46:18,030 --> 00:46:19,280
وَهَذَا يَقُومُ مَقَامَ الْمُنْفَصِلِ،

200
00:46:18,655 --> 00:46:21,155
وَالْهَمْزُ فِي آخِرِ الْكَلِمَةِ الثَّانِيَةِ،

201
00:46:20,530 --> 00:46:21,155
وَالْهَمْزُ

202
00:46:27,363 --> 00:46:29,097
فِي آخِرِ الْكَلِمَةِ مِثْلَ:

203
00:46:55,843 --> 00:46:56,968
﴿إِنْ أَنْتُمْ﴾،

204
00:46:56,405 --> 00:46:56,968
﴿قَالُوا﴾ الْوَاوُ فِي آخِرِ الْكَلِمَةِ الْأُولَى،

205
00:46:56,405 --> 00:46:56,968
فَالْهَمْزُ

206
00:47:19,468 --> 00:47:20,517
فِيهِ خِلَافٌ بَيْنَ الْقُرَّاءِ

207
00:47:25,589 --> 00:47:26,418
فِي مَدِّهِ كَمَا سَيَأْتِي،

208
00:47:26,003 --> 00:47:26,418
اللَّهُ يَعْلَمُ عَلَى أَنَّهُ الْقِسْمُ الثَّالِثُ بَعْدَ هَمْزٍ،

209
00:47:26,003 --> 00:47:26,418
فَعِنْدَنَا مُتَّصِلٌ

210
00:47:33,882 --> 00:47:34,711
أَوْ مُنْفَصِلٌ،

211
00:47:34,297 --> 00:47:34,711
هُنَا الْعَكْسُ؛ أَنْ يَأْتِيَ الْهَمْزُ وَبَعْدَهُ حَرْفُ الْمَدِّ: ﴿آمَنُوا﴾،

212
00:47:34,297 --> 00:47:34,711
﴿إِيمَانًا﴾، ﴿أُوتُوا﴾،

213
00:47:51,603 --> 00:47:52,580
فَهَذَا يُسَمَّى مَدَّ الْبَدَلِ،

214
00:47:52,092 --> 00:47:52,580
وَالْمُصَنِّفُ

215
00:47:56,976 --> 00:47:58,441
رَحِمَهُ اللَّهُ قَدَّمَ وَأَخَّرَ وَأَدْخَلَ بَعْضَ الْأَشْيَاءِ،

216
00:47:57,952 --> 00:47:58,441
وَلَوْ جَاءَ بِهَا مُتَوَالِيَةً لَكِنَّ هَذَا أَوْلَى،

217
00:47:57,952 --> 00:47:58,441
مَدُّ الْبَدَلِ عِنْدَ كُلِّ الْقُرَّاءِ يُقْصَرُ إِلَّا عِنْدَ وَرْشٍ يَجُوزُ

218
00:47:57,952 --> 00:47:58,441
فِيهِ ثَلَاثَةُ أَوْجُهٍ،

219
00:47:57,952 --> 00:47:58,441
يَجُوزُ فِيهِ ثَلَاثَةُ أَوْجُهٍ: ﴿آمَنُوا﴾،

220
00:47:57,952 --> 00:47:58,441
﴿آمَنُوا﴾، ﴿آمَنُوا﴾،

221
00:47:57,952 --> 00:47:58,441
يَجُوزُ الْقَصْرُ وَالتَّوَسُّطُ وَالْمَدُّ كَمَا سَيَأْتِي،

222
00:47:57,952 --> 00:47:58,441
هَذَا بِسَبَبِ الْهَمْزِ،

223
00:47:57,952 --> 00:47:59,906
إِذَا جَاءَ الْهَمْزُ يَنْتُجُ عِنْدَنَا ثَلَاثَةُ أَنْوَاعٍ مِنَ الْمُدُودِ: مُتَّصِلٌ،

224
00:47:59,417 --> 00:47:59,906
وَمُنْفَصِلٌ، وَبَدَلٌ.

225
00:47:59,417 --> 00:47:59,906
الْقِسْمُ الثَّانِي أَوِ السَّبَبُ الثَّانِي: إِذَا جَاءَتْ

226
00:48:19,605 --> 00:48:20,724
حُرُوفُ الْمَدِّ (الْأَلِفُ أَوِ الْوَاوُ أَوِ الْيَاءُ) وَبَعْدَهَا السُّكُونُ،

227
00:48:20,164 --> 00:48:20,724
يَنْتُجُ عِنْدَنَا مَدَّانِ فَقَطْ،

228
00:48:20,164 --> 00:48:20,724
وَهُمَا: الْعَارِضُ لِلسُّكُونِ،

229
00:48:20,164 --> 00:48:20,724
وَهَذَا يَجُوزُ فِيهِ الْقَصْرُ وَالتَّوَسُّطُ وَالْمَدُّ،

230
00:48:20,164 --> 00:48:20,724
وَالْمَدُّ اللَّازِمُ،

231
00:48:20,164 --> 00:48:35,835
وَهَذَا يَلْزَمُ مَدُّهُ عِنْدَ جَمِيعِ الْقُرَّاءِ،

232
00:48:35,835 --> 00:48:36,394
هَذَا تَلْخِيصٌ لِبَابِ الْمَدِّ،

233
00:48:35,835 --> 00:48:36,394
وَسَنَأْتِي لِمَا ذَكَرَهُ النَّاظِمُ رَحِمَهُ اللَّهُ لِأَنَّهُ قَدْ أَدْخَلَ بَعْضَ

234
00:48:35,835 --> 00:48:36,394
الْمُدُودِ فِي بَعْضٍ،

235
00:48:35,835 --> 00:48:36,394
قَالَ: [لِلْمَدِّ أَحْكَامٌ ثَلَاثَةٌ تَدُومُ * وَهِيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّزُومُ

236
00:48:35,835 --> 00:48:36,394
* فَوَاجِبٌ إِنْ جَاءَ هَمْزٌ بَعْدَ مَدٍّ * فِي كَلِمَةٍ

237
00:48:35,835 --> 00:48:36,394
وَذَا بِمُتَّصِلٍ يُعَدُّ]،

238
00:48:35,835 --> 00:48:36,394
قَالَ: اعْلَمْ أَنَّ الْمَدَّ مَعَ الْهَمْزِ مُنْقَسِمٌ إِلَى ثَلَاثَةٍ؛ الْأَوَّلُ:

239
00:48:35,835 --> 00:48:36,394
قَالَ أَنْ تَقَدَّمَ حَرْفُ الْمَدِّ وَاللِّينِ وَيُتِيَ بَعْدَهُ هَمْزٌ مِثْلَ:

240
00:48:35,835 --> 00:48:36,394
﴿جَاءَ﴾ إِلَى آخِرِهِ،

241
00:48:35,835 --> 00:48:36,394
هَذَا يَجِبُ مَدُّهُ عِنْدَ الْقُرَّاءِ،

242
00:48:35,835 --> 00:48:36,394
قَالَ: وَلَهُمْ مَحَلُّ اتِّفَاقٍ وَمَحَلُّ اخْتِلَافٍ؛ مَحَلُّ الِاتِّفَاقِ أَنَّ جَمِيعَ

243
00:48:35,835 --> 00:48:36,394
الْقُرَّاءِ يَمُدُّونَهُ،

244
00:48:35,835 --> 00:48:36,394
وَلِذَلِكَ يَقُولُ ابْنُ الْجَزَرِيِّ رَحِمَهُ اللَّهُ: [تَتَبَّعْتُ قَصْرَ الْمُنْفَصِلِ الْمُتَّصِلِ،

245
00:48:35,835 --> 00:48:36,394
تَتَبَّعْتُ قَصْرَ الْمُتَّصِلِ فَلَمْ أَجِدْهُ فِي قِرَاءَةٍ صَحِيحَةٍ

246
00:48:44,809 --> 00:48:45,928
وَلَا شَاذَّةٍ]،

247
00:48:46,488 --> 00:48:47,607
لَا يَجُوزُ قَصْرُ الْمُتَّصِلِ

248
00:49:04,955 --> 00:49:06,634
عِنْدَ جَمِيعِ الْقُرَّاءِ،

249
00:49:06,634 --> 00:49:07,193
لَكِنَّ مِنْهُمْ

250
00:49:17,670 --> 00:49:23,617
مَنْ يَمُدُّهُ ثَلَاثَةً،

251
00:49:23,617 --> 00:49:24,038
وَمِنْهُمْ

252
00:49:31,733 --> 00:49:32,608
مَنْ يَمُدُّهُ أَلِفًا وَنِصْفًا كَابْنِ كَثِيرٍ،

253
00:49:32,170 --> 00:49:32,608
وَمِنْهُمْ

