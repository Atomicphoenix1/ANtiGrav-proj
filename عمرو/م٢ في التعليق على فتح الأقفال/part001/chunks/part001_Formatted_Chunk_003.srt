1
00:55:50,004 --> 00:55:53,139
الْجُمَلِ، وَسَبَقَ تَفْصِيلُهُ؛ وَقَالَ: النَّدُّ

2
00:55:53,139 --> 00:55:55,020
نَبْتٌ طَيِّبُ الرَّائِحَةِ،

3
00:55:55,020 --> 00:55:56,920
وَبَدَا يَظْهَرُ.

4
00:55:56,920 --> 00:56:00,027
وَأَمَّا تَارِيخُهَا وَكَيْفَ

5
00:56:00,027 --> 00:56:02,867
كُتِبَتْ هَذِهِ الْمَنْظُومَةُ

6
00:56:02,867 --> 00:56:05,707
[بُشْرَى لِمَنْ يُتْقِنُهَا

7
00:56:05,707 --> 00:56:08,547
بُشْرَى لِمَنْ يُتْقِنُهَا]،

8
00:56:08,547 --> 00:56:11,387
أَيْ: أَنَّ هَذِهِ

9
00:56:11,387 --> 00:56:14,227
الْمَنْظُومَةَ نُظِّمَتْ فِي

10
00:56:14,227 --> 00:56:17,691
هَذَا التَّارِيخِ الَّذِي ذَكَرَهُ الْمُصَنِّفُ

11
00:56:17,691 --> 00:56:20,310
رَحِمَهُ اللَّهُ فِي حِسَابِ الْجُمَلِ،

12
00:56:20,310 --> 00:56:23,452
وَسَبَقَ بَيَانُهُ وَبَيَانُ هَذِهِ الْأَحْرُفِ فِي

13
00:56:23,452 --> 00:56:26,594
الشَّرْحِ الَّذِي وَهُوَ [الشَّرْحُ الْوَجِيزُ عَلَى

14
00:56:26,594 --> 00:56:29,736
تُحَفِ التَّرَطُّفَاءِ] الَّذِي أَقْرَرْنَاهُ الْعَامَ الْمَاضِي.

15
00:56:29,736 --> 00:56:32,902
قَالَ: [وَهَذَا آخِرُ مَا يَسَّرَهُ اللَّهُ،

16
00:56:32,902 --> 00:56:35,015
وَاللَّهُ أَعْلَمُ مِنَ الصَّوَابِ،

17
00:56:35,015 --> 00:56:36,600
وَإِلَيْهِ الْمَرْجِعُ وَالْمَآبُ].

18
00:56:36,600 --> 00:56:39,241
وَنَكُونُ بِحَمْدِ اللَّهِ قَدْ فَرَغْنَا.

19
00:56:39,241 --> 00:56:41,354
وَتَارِيخُ هَذِهِ الْأَبْيَاتِ [بُشْرَى].

20
00:56:41,354 --> 00:56:44,524
ذَكَرَ أَنَّ الشَّارِحَ قَالَ: وَمَا تَارِيخُ

21
00:56:44,524 --> 00:56:45,581
هَذِهِ الْأَبْيَاتِ؟

22
00:56:45,581 --> 00:56:48,751
عَامُ تَأْرِيفِهِ هُوَ عَامُ أَلْفٍ وَمِئَةٍ

23
00:56:48,751 --> 00:56:49,807
وَثَمَانِيَةٍ وَتِسْعِينَ،

24
00:56:49,807 --> 00:56:52,449
وَثَمَانِيَةٍ وَتِسْعِينَ مِنَ الْهَجْرِ النَّبَوِيِّ،

25
00:56:52,449 --> 00:56:54,562
أَلْفٍ وَمِئَةٍ وَثَمَانِيَةٍ وَتِسْعِينَ.

26
00:56:54,562 --> 00:56:58,260
وَهَذَا يُجْمَعُ بِحِسَابِ الْجُمَلِ بِـ [بُشْرَى لِمَنْ يُتْقِنُهَا].

27
00:56:58,260 --> 00:57:01,396
وَنَكُونُ بِحَمْدِ اللَّهِ قَدْ فَرَغْنَا عَلَى

28
00:57:01,396 --> 00:57:04,533
هَذَا الشَّرْحِ النَّافِعِ عَلَى سَبِيلِ الْإِيجَازِ

29
00:57:04,533 --> 00:57:06,101
وَبِمَا يُنَاسِبُ الْمَقَامَ.

30
00:57:06,101 --> 00:57:09,237
وَنُنَبِّهُ عَلَى أُمُورٍ فِي خِتَامِ هَذَا

31
00:57:09,237 --> 00:57:12,573
الشَّرْحِ: - أَوَّلًا: أُجِيبُ عَلَى مَا وَرَدَ

32
00:57:12,573 --> 00:57:13,698
مِنْ سُؤَالٍ.

33
00:57:13,698 --> 00:57:14,823
وَرَدَ سُؤَالٌ،

34
00:57:14,823 --> 00:57:15,948
أَنَا السُّؤَالُ.

35
00:57:15,385 --> 00:57:18,760
- أَوَّلُ: تَقُولُ السَّائِلَةُ: هَلْ يُقَالُ

36
00:57:18,760 --> 00:57:22,698
الْعَيْنُ الْمُعْجَمَةُ لِلْغَيْنِ أَمْ يُقَالُ الْغَيْنُ الْمُعْجَمَةُ؟

37
00:57:22,698 --> 00:57:26,073
لَا، أَهْلُ الْعِلْمِ يَقُولُونَ: الْعَيْنُ الْمُهْمَلَةُ

38
00:57:26,073 --> 00:57:27,198
وَالْغَيْنُ الْمُعْجَمَةُ،

39
00:57:27,198 --> 00:57:30,313
هَكَذَا. - وَالسُّؤَالُ الثَّانِي: عَنْ كَيْفَ

40
00:57:30,313 --> 00:57:33,505
يُقَدَّرُ الْمَدُّ أَوْ زَمَنُ الْغُنَّةِ؟

41
00:57:33,505 --> 00:57:36,058
الْعُلَمَاءُ قَدِيمًا قَدَّرُوهُ بِالْحَرَكَاتِ،

42
00:57:36,058 --> 00:57:37,334
قَالُوا: حَرَكَةٌ.

43
00:57:37,334 --> 00:57:39,888
وَيَقْصِدُونَ بِالْحَرَكَةِ حَرَكَةَ الْحَرْفِ،

44
00:57:39,888 --> 00:57:43,079
مَثَلًا: الزَّمَنُ الَّذِي تَقُولُ فِيهِ:

45
00:57:43,079 --> 00:57:44,356
بَا بَا،

46
00:57:44,356 --> 00:57:45,632
يَعْنِي حَرَكَتَيْنِ،

47
00:57:45,632 --> 00:57:48,186
هَذَا هُوَ زَمَنُ الْغُنَّةِ.

48
00:57:48,186 --> 00:57:51,377
وَلَيْسَ تُقَدَّرُ الْحَرَكَةُ بِالْأَصَابِعِ؛ لِأَنَّ

49
00:57:51,377 --> 00:57:53,292
الْأَصَابِعَ لَا تَنْضَبِطُ.

50
00:57:53,292 --> 00:57:56,483
الْأَصَابِعُ هَذَا قِيَاسٌ ذَكَرَهُ بَعْضُ

51
00:57:56,483 --> 00:57:59,829
الْعُلَمَاءِ الْمُتَأَخِّرِينَ؛ لِأَنَّ حَرَكَةَ

52
00:57:59,829 --> 00:58:02,932
الْأَصَابِعِ تَخْتَلِفُ مِنْ شَخْصٍ إِلَى شَخْصٍ،

53
00:58:02,932 --> 00:58:03,967
شَخْصٌ بَطِيءٌ،

54
00:58:03,967 --> 00:58:05,001
شَخْصٌ سَرِيعٌ،

55
00:58:05,001 --> 00:58:07,588
شَخْصٌ نَفْسُهُ مُتَأَثِّرَةٌ يَعُدُّ سَرِيعًا،

56
00:58:07,588 --> 00:58:09,657
شَخْصٌ مُرْتَاحٌ يَعُدُّ بِبُطْءٍ.

57
00:58:09,657 --> 00:58:12,760
لَكِنَّ الَّذِي يَضْبِطُ ذَلِكَ هُوَ الْحَرَكَةُ.

58
00:58:12,243 --> 00:58:15,195
- التَّنْبِيهُ الثَّانِيَةُ: أَنَّنَا غَدًا

59
00:58:15,195 --> 00:58:18,238
إِنْ شَاءَ اللَّهُ نَبْدَأُ بِالْكِتَابِ

60
00:58:18,238 --> 00:58:21,890
الثَّالِثِ وَهُوَ كَمَا هُوَ فِي الْإِعْلَانِ.

61
00:58:21,282 --> 00:58:21,890
-

62
00:58:40,760 --> 00:58:41,307
وَالتَّنْبِيهُ

63
00:58:51,703 --> 00:58:52,798
الثَّالِثُ: أَنَّنِي أُجِيزُ مَنْ حَضَرَ هَذِهِ الْمَنْظُومَةَ،

64
00:58:52,251 --> 00:58:53,892
حَضَرَ هَذَا الدَّرْسَ أَوْ شَيْئًا مِنْهُ حُضُورًا مُبَاشِرًا،

65
00:58:53,345 --> 00:58:53,892
وَسَتُرْسَلُ الِاسْتِبَانَةُ بَعْدَ قَلِيلٍ،

66
00:58:53,345 --> 00:58:53,892
فَمَنْ أَرَادَ الْحُصُولَ

67
00:59:15,336 --> 00:59:16,353
عَلَى الْإِجَازَةِ مَكْتُوبَةً فَلْيُسَجِّلْ فِي الِاسْتِبَانَةِ بِدِقَّةٍ.

68
00:59:15,845 --> 00:59:16,353
- وَالتَّنْبِيهُ الْأَخِيرُ: أَنِّي أُوصِي نَفْسِي وَالْإِخْوَةَ وَالْأَخَوَاتِ جَمِيعًا بِالْجِدِّ

69
00:59:15,845 --> 00:59:16,353
وَالِاجْتِهَادِ. نَحْنُ الْآنَ قَدْ وَاللَّهِ الْحَمْدُ فَرَغْنَا

70
00:59:29,574 --> 00:59:30,591
مِنَ الْكِتَابَيْنِ،

71
00:59:30,082 --> 00:59:30,591
وَسَنَدْرُسُ الْكِتَابَ الثَّالِثَ الْمُقَرَّرَ مِنْهُ وَنَفْرُغُ مِنْهُ إِنْ شَاءَ

72
00:59:41,222 --> 00:59:42,145
اللَّهُ فِي الْيَوْمَيْنِ الْقَادِمَيْنِ،

73
00:59:41,683 --> 00:59:42,145
وَهَكَذَا وَسَيَنْتَهِي الْبَرْنَامَجُ سَرِيعًا،

74
00:59:57,960 --> 00:59:58,760
لَكِنْ عَلَيْنَا

75
01:00:03,560 --> 01:00:04,360
أَنْ نَسْتَغِلَّ الْأَوْقَاتِ وَنُذَاكِرَ.

76
01:00:03,960 --> 01:00:04,360
وَطَالِبُ

77
01:00:08,360 --> 01:00:09,227
الْعِلْمِ لَهُ أَحْوَالٌ

78
01:00:26,179 --> 01:00:27,825
فِي حُضُورِ الدُّرُوسِ: - أَكْمَلُ الْأَحْوَالِ: أَنْ يَحْضُرَ لِلدَّرْسِ،

79
01:00:30,566 --> 01:00:31,663
أَنْ يَحْضُرَ لِلدَّرْسِ الْمُتَوَقَّعِ شَرْحُهُ،

80
01:00:31,115 --> 01:00:31,663
مَثَلًا: [تُحْفَةُ الْأَطْفَالِ] مَقْسُومَةٌ

81
01:00:41,837 --> 01:00:42,452
عَلَى مَجْلِسَيْنِ،

82
01:00:42,145 --> 01:00:42,452
وَهِيَ سِتُّونَ بَيْتًا،

83
01:00:42,145 --> 01:00:42,452
الْمُتَوَقَّعُ أَنْ تَكُونَ ثَلَاثِينَ بَيْتًا،

84
01:00:42,145 --> 01:00:42,452
ثُمَّ الْمَجْلِسُ الثَّانِي ثَلَاثِينَ بَيْتًا،

85
01:00:42,145 --> 01:00:42,452
فَتَحْضُرَ الْقَدْرَ تَتَوَقَّعُ ذَلِكَ وَتُحَضِّرَهُ،

86
01:00:42,145 --> 01:00:42,452
ثُمَّ تَحْضُرَ الدَّرْسَ بِإِنْصَاتٍ وَإِقْبَالٍ وَعَدَمِ خُرُوجٍ،

87
01:00:42,145 --> 01:00:42,452
تَخْرُجُ مِنَ الْغُرْفَةِ وَتَعُودُ وَتَخْرُجُ وَتَعُودُ،

88
01:00:42,145 --> 01:00:42,452
قَادِرٌ لِلِاسْتِطَاعَةِ أَنَّكَ مَا تَخْرُجُ إِلَّا إِذَا كَانَ أَمْرٌ خَارِجَ

89
01:00:42,145 --> 01:00:42,452
إِرَادَتِكَ، وَالْقَلَمُ مَعَكَ،

90
01:00:42,145 --> 01:00:42,452
وَتَكُونَ جَلْسَتُكَ جِدًّا،

91
01:00:42,145 --> 01:00:42,452
تَتَّقِي اللَّهَ وَتَتَعَبَّدُ لِلَّهِ سُبْحَانَهُ وَتَعَالَى بِهَذِهِ الْجَلْسَةِ حَتَّى لَوْ

92
01:00:42,145 --> 01:00:42,452
كَانَ أُسْتَاذُكَ مَا يَرَاكَ وَلَا يَرَاكَ أَحَدٌ،

93
01:00:42,145 --> 01:00:42,452
أَنْتَ تَعْبُدُ لِلَّهِ بِأَنْ تَجْلِسَ جَلْسَةً تَلِيقُ بِالْعِلْمِ،

94
01:00:42,145 --> 01:00:42,452
لَا تَنْسَى دَحْفِيَةً وَأَنْتَ تُتَابِعُ الدَّرْسَ إِلَّا إِذَا كُنْتَ مُتْعَبًا

95
01:00:42,145 --> 01:00:42,452
لِسَبَبٍ مِنَ الْأَسْبَابِ،

96
01:00:42,145 --> 01:00:42,452
لَكِنْ أَصْلًا أَنَّكَ تَجْلِسُ جَلْسَةَ طَالِبِ عِلْمٍ،

97
01:00:42,145 --> 01:00:42,452
وَثُمَّ بَعْدَ انْتِهَاءِ الدَّرْسِ تُرَاجِعُ الدَّرْسَ،

98
01:00:42,145 --> 01:00:42,452
وَيَحْسُنُ أَنْ إِذَا كَانَ لَكَ زَمِيلٌ أَنْتَ دَارَسَهُ فِي هَذِهِ

99
01:00:42,145 --> 01:00:42,452
الْمَسْأَلَةِ، هَكَذَا يَثْبُتُ الْعِلْمُ.

100
01:00:42,145 --> 01:00:42,452
- هَذِهِ الْحَالَةُ الْأُولَى الْأَكْمَلُ.

101
01:00:42,145 --> 01:00:42,452
- الْحَالَةُ الثَّانِيَةُ: أَنْ تَحْضُرَ الدَّرْسَ بِدُونِ تَحْضِيرٍ وَتُرَاجِعَ،

102
01:00:42,145 --> 01:00:42,452
تَسْتَفِيدُ فَائِدَةً كَبِيرَةً.

103
01:00:42,145 --> 01:00:42,452
- الْحَالَةُ الثَّالِثَةُ: أَنْ تَكْتَفِيَ بِمُجَرَّدِ الْحُضُورِ وَتَسْجِيلِ الْفَوَائِدِ عَلَى

104
01:00:42,145 --> 01:00:42,452
نُسْخَتِكَ، هَذِهِ لَنْ تَعْدَمَ خَيْرًا تَسْتَفِيدُ،

105
01:00:42,145 --> 01:00:42,452
لَكِنَّ الْفَائِدَةَ الْكَمْلَةَ هِيَ فِي أَنْ تَحْضُرَ وَتُحَضِّرَ وَتُذَاكِرَ،

106
01:00:42,145 --> 01:00:42,452
أَوْ أَقَلَّ شَيْءٍ أَنْ تُذَاكِرَ بَعْدَ الدَّرْسِ.

107
01:00:42,145 --> 01:00:42,452
أَسْأَلُهُ سُبْحَانَهُ وَتَعَالَى لِي وَلَكُمْ فِي خِتَامِ هَذَا الْمَجْلِسِ الْعَوْنَ

108
01:00:42,145 --> 01:00:42,452
وَالتَّوْفِيقَ وَالسَّدَادَ وَالْإِخْلَاصَ فِي الْقَوْلِ وَالْعَمَلِ.

109
01:00:42,145 --> 01:00:42,452
وَاللَّهُ أَعْلَمُ.

110
01:00:42,145 --> 01:00:42,760
صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَلَى نَبِيِّنَا مُحَمَّدٍ.
