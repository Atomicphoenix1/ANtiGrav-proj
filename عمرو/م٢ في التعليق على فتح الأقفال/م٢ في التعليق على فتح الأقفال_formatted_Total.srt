1
00:00:02,860 --> 00:00:04,860
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

2
00:00:04,860 --> 00:00:08,860
وَالصَّلَاةُ وَالسَّلَامُ عَلَى أَشْرَفِ الْأَنْبِيَاءِ وَالْمُرْسَلِينَ،

3
00:00:08,860 --> 00:00:12,042
نَبِيِّنَا مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ وَمَنْ تَبِعَهُمْ

4
00:00:12,042 --> 00:00:13,860
بِإِحْسَانٍ إِلَى يَوْمِ الدِّينِ،

5
00:00:13,860 --> 00:00:16,927
أَمَّا بَعْدُ: فَهَذَا هُوَ

6
00:00:16,927 --> 00:00:20,127
الْمَجْلِسُ الثَّانِي فِي شَرْحِ الْمُقَرَّرِ الثَّانِي

7
00:00:20,127 --> 00:00:23,327
مِنْ مُقَرَّرَاتِ بَرْنَامَجِ [التَّيْسِيرِ لِعُلُومِ الْقُرْآنِ

8
00:00:23,327 --> 00:00:25,460
وَالتَّفْسِيرِ] فِي سَنَتِهِ السَّادِسَةِ،

9
00:00:25,460 --> 00:00:28,660
الْمُوَافِقِ الْيَوْمَ التَّاسِعَ مِنْ شَهْرِ شَوَّالٍ

10
00:00:28,660 --> 00:00:31,860
لِعَامِ أَلْفٍ وَأَرْبَعِمِائَةٍ وَسِتٍّ وَأَرْبَعِينَ هِجْرِيَّةً،

11
00:00:31,860 --> 00:00:35,074
وَالْمُقَرَّرُ الثَّانِي هُوَ [فَتْحُ الْأَقْفَالِ

12
00:00:35,074 --> 00:00:38,289
بِشَرْحِ تُحْفَةِ الْأَطْفَالِ] لِلشَّيْخِ الْعَلَّامَةِ

13
00:00:38,289 --> 00:00:40,860
سُلَيْمَانَ بْنِ حُسَيْنِ الْجَمْزُورِيِّ،

14
00:00:40,860 --> 00:00:43,717
وَقَدِ انْتَهَتْ بِنَا قِرَاءَتُهُ

15
00:00:43,717 --> 00:00:45,860
إِلَى قَوْلِ الشَّارِحِ،

16
00:00:45,860 --> 00:00:49,360
إِلَى قَوْلِ النَّاظِمِ يَرْحَمُهُ اللَّهُ: [أَحْكَامُ لَامِ أَلْ وَلَامِ

17
00:00:50,110 --> 00:00:53,305
الْفِعْلِ]؛ بِسْمِ اللَّهِ

18
00:00:53,305 --> 00:00:55,750
الرَّحْمَنِ الرَّحِيمِ،

19
00:00:55,750 --> 00:00:59,250
وَالصَّلَاةُ وَالسَّلَامُ عَلَى أَشْرَفِ الْأَنْبِيَاءِ وَالْمُرْسَلِينَ نَبِيِّنَا

20
00:00:59,250 --> 00:01:01,750
مُحَمَّدٍ وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

21
00:01:01,750 --> 00:01:04,607
اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا

22
00:01:04,607 --> 00:01:06,750
وَلِلسَّامِعِينَ وَالْمُسْلِمِينَ أَجْمَعِينَ،

23
00:01:06,750 --> 00:01:10,083
قَالَ النَّاظِمُ رَحِمَهُ اللَّهُ تَعَالَى: حُكْمُ

24
00:01:10,083 --> 00:01:13,000
لَامِ أَلْ وَلَامِ الْفِعْلِ لِلَامِ أَلْ حَالَانِ

25
00:01:13,000 --> 00:01:15,500
قَبْلَ الْأَحْرُفِ *** أُولَاهُمَا إِظْهَارُهَا فَلْتَعْرِفِ

26
00:01:16,750 --> 00:01:19,972
قَبْلَ ارْبَعٍ مَعْ عَشْرَةٍ خُذْ عِلْمَهُ *** مِنِ

27
00:01:19,972 --> 00:01:23,062
ابْغِ حَجَّكَ وَخَفْ عَقِيمَهُ أَشَرْتُ إِلَى

28
00:01:23,062 --> 00:01:26,343
أَنَّ اللَّامَ مِنْ [أَلْ] الْمَعْرِفَةِ إِذَا

29
00:01:26,343 --> 00:01:29,624
وَقَعَتْ قَبْلَ حُرُوفِ الْمُعْجَمِ لَهَا

30
00:01:29,624 --> 00:01:33,031
حَالَتَانِ: الْأُولَى: يُظْهِرُهَا

31
00:01:33,031 --> 00:01:35,781
وُجُوبًا قَبْلَ

32
00:01:35,781 --> 00:01:39,907
أَرْبَعَةَ عَشَرَ حَرْفًا،

33
00:01:39,907 --> 00:01:42,658
تُؤْخَذُ مَعْرِفَتُهَا

34
00:01:42,658 --> 00:01:45,408
مِنْ حُرُوفِ

35
00:01:45,408 --> 00:01:46,784
قَوْلِكَ: [ابْغِ

36
00:01:49,534 --> 00:01:53,660
حَجَّكَ وَخَفْ عَقِيمَهُ]،

37
00:01:53,660 --> 00:01:54,764
وَهِيَ: الْأَلِفُ،

38
00:01:54,764 --> 00:01:55,867
وَالْبَاءُ الْمُوَحَّدَةُ،

39
00:01:55,867 --> 00:01:56,971
وَالْغَيْنُ الْمُعْجَمَةُ،

40
00:01:56,971 --> 00:01:58,074
وَالْحَاءُ الْمُهْمَلَةُ،

41
00:01:58,074 --> 00:01:59,178
وَالْجِيمُ، وَالْكَافُ،

42
00:01:59,178 --> 00:02:00,833
وَالْوَاوُ، وَالْخَاءُ الْمُعْجَمَةُ،

43
00:02:00,833 --> 00:02:02,488
وَالْفَاءُ، وَالْعَيْنُ الْمُهْمَلَةُ،

44
00:02:02,488 --> 00:02:05,740
وَالْقَافُ، وَالْيَاءُ الْمُثَنَّاةُ تَحْتُ،

45
00:02:05,740 --> 00:02:09,340
وَالْمِيمُ، وَالْهَاءُ؛ نَحْوُ: ﴿الْآيَاتِ﴾،

46
00:02:09,340 --> 00:02:11,140
[الْبَصِيرُ]، [الْغَفُورُ]،

47
00:02:11,140 --> 00:02:12,940
[الْحَلِيمُ]، [الْجَلِيلُ]،

48
00:02:12,940 --> 00:02:14,740
[الْكَرِيمُ]، [الْوَدُودُ]،

49
00:02:14,740 --> 00:02:16,540
[الْخَبِيرُ]، [الْفَتَّاحُ]،

50
00:02:16,540 --> 00:02:18,340
[الْعَلِيمُ]، [الْقَدِيرُ]،

51
00:02:18,340 --> 00:02:20,140
[الْيَوْمُ]، [الْمَلِكُ]،

52
00:02:20,140 --> 00:02:23,240
[الْهَادِي]، وَمَعْنَى هَذِهِ الْكَلِمَةِ: اطْلُبْ

53
00:02:23,240 --> 00:02:26,540
حَجًّا لَا رَفَثَ فِيهِ وَلَا فُسُوقَ

54
00:02:26,540 --> 00:02:29,840
وَلَا جِدَالَ؛ ثَانِيهِمَا إِدْغَامُهَا فِي أَرْبَعِ ***

55
00:02:29,840 --> 00:02:33,040
وَعَشْرَةٍ أَيْضًا وَرَمْزَهَا فَعِ الثَّانِي مِنْ

56
00:02:33,040 --> 00:02:34,040
أَحْكَامِ لَامِ [أَلْ]: الْإِدْغَامُ،

57
00:02:34,540 --> 00:02:38,040
فَيَجِبُ إِدْغَامُهَا فِي أَرْبَعَةَ عَشَرَ حَرْفًا أَيْضًا،

58
00:02:38,040 --> 00:02:41,098
وَهِيَ مَجْمُوعَةٌ فِي أَوَّلِ كَلِمِ

59
00:02:41,098 --> 00:02:44,157
هَذَا الْبَيْتِ الْمُشَارِ إِلَيْهِ بِقَوْلِهِ:

60
00:02:44,157 --> 00:02:45,380
[وَرَمْزَهَا فَعِ] أَيْ: احْفَظْ،

61
00:02:45,860 --> 00:02:49,220
وَهُوَ: طِبْ ثُمَّ صِلْ رُحْمًا تَفُزْ ضِفْ ذَا

62
00:02:49,220 --> 00:02:52,580
نِعَمْ *** دَعْ سُوءَ ظَنٍّ زُرْ شَرِيفًا لِلْكَرَمْ وَهِيَ:

63
00:02:52,580 --> 00:02:53,540
الطَّاءُ الْمُهْمَلَةُ،

64
00:02:53,540 --> 00:02:54,500
وَالثَّاءُ الْمُثَلَّثَةُ،

65
00:02:54,500 --> 00:02:55,940
وَالصَّادُ، وَالرَّاءُ الْمُهْمَلَتَانِ،

66
00:02:55,940 --> 00:02:57,380
وَالتَّاءُ الْمُثَنَّاةُ فَوْقُ،

67
00:02:57,380 --> 00:02:59,380
وَالضَّادُ، وَالذَّالُ الْمُعْجَمَتَانِ،

68
00:02:59,380 --> 00:03:00,713
وَالنُّونُ، وَالدَّالُ،

69
00:03:00,713 --> 00:03:02,047
وَالسِّينُ الْمُهْمَلَتَانِ،

70
00:03:02,047 --> 00:03:03,380
وَالظَّاءُ الْمُشَالَةُ،

71
00:03:03,380 --> 00:03:05,580
وَالشِّينُ الْمُعْجَمَةُ،

72
00:03:05,580 --> 00:03:08,880
وَاللَّامُ؛ نَحْوُ: [الطَّامَّةُ]،

73
00:03:08,880 --> 00:03:11,080
وَ[الثَّوَابُ]، وَ[الصَّادِقِينَ]،

74
00:03:11,080 --> 00:03:13,280
وَ[الرَّاكِعِينَ]، وَ[التَّابِعِينَ]،

75
00:03:13,280 --> 00:03:15,480
وَ[الضَّالِّينَ]، وَ[الذَّاكِرِينَ]،

76
00:03:15,480 --> 00:03:17,680
وَ[النَّاسُ]، وَ[الدِّينُ]،

77
00:03:17,680 --> 00:03:19,880
وَ[السَّائِحُونَ]، وَ[الظَّالِمُونَ]،

78
00:03:19,880 --> 00:03:22,080
وَ[الزُّجَاجَةُ]، وَ[الشَّيَاطِينُ]،

79
00:03:22,080 --> 00:03:25,380
وَ[اللَّيْلُ]، وَنَحْوُ ذَلِكَ؛

80
00:03:25,380 --> 00:03:28,505
وَاللَّامَ الُاولَى سَمِّهَا قَمْرِيَّهْ *** وَاللَّامَ

81
00:03:28,505 --> 00:03:31,422
الُاخْرَى سَمِّهَا شَمْسِيَّهْ أَشَرْتُ

82
00:03:31,422 --> 00:03:34,547
إِلَى أَنَّ اللَّامَ

83
00:03:34,547 --> 00:03:37,672
الْأُولَى -وَهِيَ الَّتِي

84
00:03:37,672 --> 00:03:40,797
يَجِبُ إِظْهَارُهَا- تُسَمَّى

85
00:03:40,797 --> 00:03:43,922
قَمَرِيَّةً؛ لِأَنَّهَا كَلَامِ

86
00:03:43,922 --> 00:03:47,047
الْقَمَرِ فِي الظُّهُورِ،

87
00:03:47,047 --> 00:03:50,172
وَاللَّامَ الثَّانِيَةَ -وَهِيَ

88
00:03:50,172 --> 00:03:53,297
الَّتِي يَجِبُ إِدْغَامُهَا-

89
00:03:53,297 --> 00:03:56,523
تُسَمَّى شَمْسِيَّةً؛ لِأَنَّهَا كَلَامِ

90
00:03:56,523 --> 00:03:59,380
الشَّمْسِ بِجَامِعِ الْإِدْغَامِ فِي كُلٍّ،

91
00:03:59,380 --> 00:04:03,309
وَقِيلَ: إِنَّ هَذِهِ التَّسْمِيَةَ لِلْحُرُوفِ،

92
00:04:03,309 --> 00:04:05,666
وَعَلَيْهِ شَيْخُ الْإِسْلَامِ،

93
00:04:05,666 --> 00:04:08,809
وَمَنْ أَرَادَ تَوْجِيهَ ذَلِكَ

94
00:04:08,809 --> 00:04:10,380
فَعَلَيْهِ بِالْأَصْلِ،

95
00:04:10,380 --> 00:04:13,842
وَتُقْرَأُ [الْأُولَى] وَ[الْأُخْرَى] بِنَقْلِ حَرَكَةِ

96
00:04:13,842 --> 00:04:16,611
الْهَمْزَةِ إِلَى السَّاكِنِ قَبْلَهَا،

97
00:04:16,611 --> 00:04:19,880
وَ[قَمْرِيَّهْ] بِسُكُونِ الْمِيمِ لِلضَّرُورَةِ؛ وَأَظْهِرَنَّ لَامَ

98
00:04:20,380 --> 00:04:23,880
فِعْلٍ مُطْلَقَا *** فِي نَحْوِ قُلْ نَعَمْ وَقُلْنَا

99
00:04:23,880 --> 00:04:25,851
وَالْتَقَى أَشَرْتُ بِهَذَا الْبَيْتِ إِلَى أَنَّ

100
00:04:42,653 --> 00:04:43,198
لَامَ

101
00:04:59,380 --> 00:05:01,166
الْفِعْلِ يَجِبُ

102
00:05:05,880 --> 00:05:07,451
إِظْهَارُهَا مُطْلَقًا؛ أَيْ سَوَاءٌ كَانَ الْفِعْلُ مَاضِيًا أَوْ مُضَارِعًا أَوْ

103
00:05:06,666 --> 00:05:07,451
أَمْرًا، وَتَلْحَقُ الْمَاضِيَ

104
00:05:35,792 --> 00:05:37,321
فِي آخِرِهِ أَوْ وَسَطِهِ،

105
00:05:36,556 --> 00:05:37,321
وَفِي آخِرِ فِعْلِ الْأَمْرِ كَالْأَمْثِلَةِ الْمَذْكُورَةِ فِي الْبَيْتِ؛ لِأَنَّ النُّونَ

106
00:05:36,556 --> 00:05:37,321
لَمْ يُدْغَمْ فِيهَا شَيْءٌ مِمَّا أُدْغِمَتْ

107
00:05:44,072 --> 00:05:44,995
فِيهِ نَحْوُ الْمِيمِ وَالْوَاوِ وَالْيَاءِ فَيَسْتَوْحِشُ إِدْغَامُهَا،

108
00:05:44,534 --> 00:05:44,995
وَإِنَّمَا أُدْغِمَتْ

109
00:06:09,380 --> 00:06:10,801
فِيهَا لَامُ التَّعْرِيفِ كَـ[النَّارِ] وَ[النَّاسِ] لِكَثْرَتِهَا،

110
00:06:10,380 --> 00:06:10,801
وَمَحَلُّ إِظْهَارِهَا إِذَا لَمْ تَقَعْ قَبْلَ لَامٍ وَلَا رَاءٍ،

111
00:06:10,380 --> 00:06:13,327
فَإِنْ وَقَعَتْ قَبْلَهُمَا أُدْغِمَتْ كَمَا مَرَّ؛ ثُمَّ

112
00:06:22,835 --> 00:06:24,107
ذَكَرَ النَّاظِمُ

113
00:06:45,523 --> 00:06:47,237
رَحِمَهُ اللَّهُ أَحْكَامَ

114
00:06:49,080 --> 00:06:50,480
لَامِ [أَلْ] وَلَامِ الْفِعْلِ،

115
00:06:49,780 --> 00:06:50,480
وَبَيَّنَّا

116
00:06:55,380 --> 00:06:56,780
أَنَّ لِلَّامِ حَالَانِ قَبْلَ

117
00:07:32,130 --> 00:07:34,630
الْأَحْرُفِ: أُولَاهُمَا: إِظْهَارُهَا،

118
00:07:33,380 --> 00:07:34,630
فَلِلتَّعْرِيفِ حَالَانِ،

119
00:07:33,380 --> 00:07:34,630
الْحَالُ الْأُولَى: الْإِظْهَارُ،

120
00:07:33,380 --> 00:07:34,630
وَهَذَا وُجُوبًا قَبْلَ أَرْبَعَةَ عَشَرَ حَرْفًا،

121
00:07:33,380 --> 00:07:35,880
وَسَبَبُ الْإِظْهَارِ هُوَ التَّبَاعُدُ بَيْنَ مَخْرَجِ اللَّامِ

122
00:07:35,880 --> 00:07:37,130
وَمَخْرَجِ أَغْلَبِ

123
00:07:42,854 --> 00:07:44,643
هَذِهِ الْحُرُوفِ،

124
00:07:44,643 --> 00:07:45,538
وَذَكَرَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ الشَّارِحُ الْأَمْثِلَةَ

125
00:07:59,380 --> 00:08:01,094
عَلَى هَذِهِ الْحُرُوفِ

126
00:08:25,125 --> 00:08:26,544
وَهِيَ مَجْمُوعَةٌ

127
00:08:30,093 --> 00:08:31,513
فِي قَوْلِكَ: [ابْغِ حَجَّكَ وَخَفْ عَقِيمَهُ]،

128
00:08:30,803 --> 00:08:31,513
وَالْجُمْلَةُ كَمَا بَيَّنَّا

129
00:08:47,835 --> 00:08:48,810
قَالَ: اطْلُبْ حَجًّا لَا رَفَثَ فِيهِ

130
00:08:59,054 --> 00:09:00,030
وَلَا فُسُوقَ

131
00:09:02,887 --> 00:09:04,030
وَلَا جِدَالَ،

132
00:09:03,459 --> 00:09:04,030
هَذَا الْحُكْمُ الْأَوَّلُ

133
00:09:32,030 --> 00:09:33,030
هُوَ الْإِظْهَارُ قَبْلَ أَرْبَعَةَ عَشَرَ حَرْفًا ذَكَرَهَا النَّاظِمُ وَذَكَرَ الْأَمْثِلَةَ

134
00:09:32,530 --> 00:09:35,030
عَلَيْهَا؛ وَالثَّانِي: هُوَ الْإِدْغَامُ،

135
00:09:35,030 --> 00:09:35,530
وَهَذَا أَيْضًا قَبْلَ أَرْبَعَةَ عَشَرَ حَرْفًا،

136
00:09:35,030 --> 00:09:35,530
وَسَبَبُ

137
00:09:38,530 --> 00:09:40,030
الْإِدْغَامِ هُوَ التَّمَاثُلُ مَعَ اللَّامِ وَالتَّقَارُبُ مَعَ بَقِيَّةِ مَعَ أَكْثَرِ

138
00:09:39,030 --> 00:09:41,744
الْحُرُوفِ، وَحُرُوفُ الْإِدْغَامِ مَجْمُوعَةٌ فِيهَا

139
00:09:51,274 --> 00:09:52,417
فِي أَوَائِلِ كَلِمِ هَذَا الْبَيْتِ: [طِبْ

140
00:10:08,169 --> 00:10:09,299
ثُمَّ صِلْ رُحْمًا تَفُزْ ضِفْ ذَا نِعَمْ دَعْ سُوءَ ظَنٍّ

141
00:10:08,734 --> 00:10:09,299
زُرْ شَرِيفًا لِلْكَرَمْ]،

142
00:10:08,734 --> 00:10:09,299
وَهِيَ الطَّاءُ وَالثَّاءُ وَالصَّادُ إِلَى آخِرِ مَا ذَكَرَ،

143
00:10:08,734 --> 00:10:09,299
وَذَكَرَ الْأَمْثِلَةَ عَلَيْهَا؛ ثُمَّ قَالَ: [وَاللَّامَ الُاولَى سَمِّهَا قَمْرِيَّهْ]،

144
00:10:08,734 --> 00:10:09,299
اللَّامُ الْمُظْهَرَةُ تُسَمَّى اللَّامَ الْقَمَرِيَّةَ،

145
00:10:08,734 --> 00:10:09,299
وَاللَّامُ الْمُدْغَمَةُ تُسَمَّى شَمْسِيَّةً،

146
00:10:08,734 --> 00:10:09,299
لِمَاذَا سُمِّيَتْ قَمَرِيَّةً؟

147
00:10:08,734 --> 00:10:09,299
أَكْثَرُ

148
00:10:21,299 --> 00:10:22,690
مِنْ تَوْجِيهٍ لِلْعُلَمَاءِ،

149
00:10:21,995 --> 00:10:22,690
ذَكَرَ الْمُصَنِّفُ تَوْجِيهَيْنِ،

150
00:10:21,995 --> 00:10:22,690
ذَكَرَ الشَّارِحُ رَحِمَهُ اللَّهُ تَوْجِيهَيْنِ: التَّوْجِيهُ الْأَوَّلُ: لِأَنَّ لَامَ الْقَمَرِ

151
00:10:21,995 --> 00:10:22,690
مُظْهَرَةٌ شُبِّهَتْ بِهَا أَوْ سُمِّيَتْ بِهَا،

152
00:10:33,560 --> 00:10:34,060
كَمَا

153
00:10:56,303 --> 00:10:57,389
أَنَّ لَامَ الْقَمَرِ مُظْهَرَةٌ فَهَذِهِ حُرُوفٌ تَظْهَرُ وَلِذَلِكَ سُمِّيَتْ قَمَرِيَّةً،

154
00:10:56,846 --> 00:10:57,389
وَلِأَنَّ لَامَ الشَّمْسِ مُدْغَمَةٌ وَهَذِهِ وَحُرُوفُ الْإِدْغَامِ مُدْغَمَةٌ فَسُمِّيَتْ بِذَلِكَ،

155
00:10:56,846 --> 00:10:57,389
قَالَ: كَلَامِ الشَّمْسِ بِجَامِعِ الْإِدْغَامِ

156
00:11:18,242 --> 00:11:19,658
فِي كُلٍّ،

157
00:11:18,950 --> 00:11:19,658
هَذَا التَّوْجِيهُ الْأَوَّلُ؛ وَقِيلَ:

158
00:11:22,247 --> 00:11:23,180
إِنَّ هَذِهِ تَسْمِيَةُ الْحُرُوفِ،

159
00:11:22,713 --> 00:11:23,180
شَبَّهَ هَذِهِ الْحُرُوفَ بِالشَّمْسِ وَالْقَمَرِ،

160
00:11:22,713 --> 00:11:23,180
شَبَّهَ فَهَذِهِ الْأَحْرُفَ مَعَ اللَّامِ الْقَمَرِيَّةِ تَظْهَرُ وَمَعَ الشَّمْسِ تَخْتَفِي،

161
00:11:22,713 --> 00:11:23,180
فَقَالُوا:

162
00:11:29,420 --> 00:11:30,060
إِنَّ

163
00:11:57,941 --> 00:11:58,892
هَذِهِ الْحُرُوفَ كَالنُّجُومِ،

164
00:11:58,416 --> 00:11:58,892
فَالنُّجُومُ

165
00:12:05,543 --> 00:12:06,491
فِي اللَّيْلِ تَظْهَرُ لِأَنَّ ضَوْءَ الْقَمَرِ أَقَلُّ

166
00:12:12,320 --> 00:12:13,187
مِنْ ضَوْءِ الشَّمْسِ،

167
00:12:12,753 --> 00:12:13,187
وَأَمَّا إِذَا جَاءَ ضَوْءُ الشَّمْسِ فَإِنَّهُ يُغَطِّي

168
00:12:35,711 --> 00:12:39,563
عَلَى هَذِهِ النُّجُومِ،

169
00:12:38,849 --> 00:12:39,563
مَوْجُودَةٌ لَكِنَّهَا لَا تَظْهَرُ لِأَنَّ ضَوْءَ الشَّمْسِ يُغَطِّي عَلَيْهَا،

170
00:12:38,849 --> 00:12:39,563
فَشَبَّهُوهَا بِالنُّجُومِ،

171
00:12:38,849 --> 00:12:39,563
وَمَعَ النُّجُومِ

172
00:12:47,870 --> 00:12:48,770
مَعَ الْقَمَرِ تَظْهَرُ وَمَعَ الشَّمْسِ تَخْتَفِي؛ ثُمَّ ذَكَرَ حُكْمَ لَامِ

173
00:12:48,320 --> 00:12:48,770
الْفِعْلِ قَالَ: [وَأَظْهِرَنَّ لَامَ فِعْلٍ مُطْلَقَا]،

174
00:12:48,320 --> 00:12:48,770
وَلَامُ الْفِعْلِ لَمْ يُعَرِّفْهَا الشَّارِحُ رَحِمَهُ اللَّهُ،

175
00:12:48,320 --> 00:12:51,920
وَهِيَ اللَّامُ السَّاكِنَةُ،

176
00:12:51,470 --> 00:12:51,920
وَهِيَ اللَّامُ السَّاكِنَةُ الْوَاقِعَةُ

177
00:13:09,420 --> 00:13:10,420
فِي فِعْلٍ سَوَاءٌ كَانَ مَاضِيًا أَوْ مُضَارِعًا أَوْ أَمْرًا،

178
00:13:09,920 --> 00:13:10,420
وَسَوَاءٌ كَانَتْ مُتَوَسِّطَةً أَوْ مُتَطَرِّفَةً،

179
00:13:09,920 --> 00:13:10,420
هَذِهِ حُكْمُهَا الْإِظْهَارُ،

180
00:13:09,920 --> 00:13:10,420
لَكِنِ اسْتَثْنَى الشَّارِحُ

181
00:13:39,194 --> 00:13:41,786
النَّاظِمُ رَحِمَهُ اللَّهُ،

182
00:14:06,050 --> 00:14:06,540
اسْتَثْنَى

183
00:14:12,913 --> 00:14:13,893
فِي شَرْحِهِ،

184
00:14:35,560 --> 00:14:36,810
فِي النَّظْمِ لَمْ يَسْتَثْنِ

185
00:15:03,160 --> 00:15:05,188
قَالَ: [وَأَظْهِرَنَّ لَامَ فِعْلٍ مُطْلَقَا

186
00:15:10,839 --> 00:15:12,095
فِي نَحْوِ قُلْ نَعَمْ وَقُلْنَا وَالْتَقَى]،

187
00:15:11,467 --> 00:15:12,095
لَكِنْ قَيَّدَ هَذَا

188
00:15:15,234 --> 00:15:16,490
الشَّرْحُ قَالَ: وَمَحَلُّ إِظْهَارِهَا إِذَا لَمْ تَقَعْ قَبْلَ لَامٍ وَلَا

189
00:15:15,862 --> 00:15:16,490
رَاءٍ، إِذَا لَمْ تَقَعْ قَبْلَ لَامٍ وَلَا رَاءٍ فَإِنْ وَقَعَتْ

190
00:15:15,862 --> 00:15:16,490
قَبْلَهَا قَبْلَهُمَا أُدْغِمَتْ

191
00:15:36,651 --> 00:15:37,924
كَمَا مَرَّ،

192
00:15:37,287 --> 00:15:37,924
كَمَا مَرَّ

193
00:15:50,651 --> 00:15:51,924
فِي إِدْغَامِ الْمُتَمَاثِلَيْنِ الصَّغِيرِ،

194
00:15:51,287 --> 00:15:51,924
فَهُوَ أَحَالَ

195
00:16:03,893 --> 00:16:05,227
إِلَى بَابٍ سَابِقٍ يَقُولُ: أَظْهِرَنَّ مُطْلَقًا إِلَّا مَا اسْتُثْنِيَ سَابِقًا،

196
00:16:04,560 --> 00:16:05,227
فَإِنَّ

197
00:16:26,868 --> 00:16:28,098
هَذِهِ مَرَّ حُكْمُهَا أَوْ سَيَأْتِي فِي حُكْمِهَا فِي الْمُتَمَاثِلَيْنِ الصَّغِيرِ،

198
00:16:27,483 --> 00:16:30,945
وَنَبَّهَ عَلَى

199
00:16:30,945 --> 00:16:31,329
كُلِّ حَالٍ

200
00:16:35,175 --> 00:16:35,945
هُوَ فِيمَا سَبَقَ إِلَى أَنَّ الْإِدْغَامَ فِيهِ صَغِيرٌ وَكَبِيرٌ،

201
00:16:35,560 --> 00:16:35,945
وَأَنَّ الصَّغِيرَ يَكُونُ فِيهِ الْإِدْغَامُ وَالْكَبِيرُ يَقُولُ فِي الْإِدْغَامِ عِنْدَ

202
00:16:35,560 --> 00:16:35,945
أَبِي عَمْرٍو الْبَصْرِيِّ؛ نَعَمْ،

203
00:16:35,560 --> 00:16:35,945
أَحْسَنَ اللَّهُ إِلَيْكُمْ؛ فِي الْمِثْلَيْنِ وَالْمُتَقَارِبَيْنِ وَالْمُتَجَانِسَيْنِ إِنْ فِي الصِّفَاتِ

204
00:16:35,560 --> 00:16:35,945
وَالْمَخَارِجِ اتَّفَقْ *** حَرْفَانِ فَالْمِثْلَانِ فِيهِمَا أَحَقْ أَيْ إِنِ اتَّفَقَ

205
00:16:35,560 --> 00:16:38,252
حَرْفَانِ فِي الصِّفَاتِ وَفِي الْمَخْرَجِ كَالْبَاءَيْنِ الْمُوَحَّدَتَيْنِ وَاللَّامَيْنِ وَالدَّالَيْنِ الْمُهْمَلَتَيْنِ

206
00:16:37,868 --> 00:16:38,252
أَوِ الْمُعْجَمَتَيْنِ سُمِّيَا مِثْلَيْنِ،

207
00:16:37,868 --> 00:16:38,252
ثُمَّ إِنْ سَكَنَ أَوَّلُهُمَا سُمِّيَا مِثْلَيْنِ وَحُكْمُهُ الْإِدْغَامُ وُجُوبًا؛ نَحْوُ:

208
00:16:37,868 --> 00:16:38,252
﴿اضْرِبْ بِعَصَاكَ﴾،

209
00:16:37,868 --> 00:16:40,175
﴿بَلْ لَا يَخَافُونَ﴾،

210
00:16:39,791 --> 00:16:40,175
﴿وَقَدْ دَخَلُوا﴾،

211
00:16:39,791 --> 00:16:40,175
﴿وَإِذْ ذَهَبَ﴾،

212
00:16:39,791 --> 00:16:40,175
وَاسْتُثْنِيَ مِنْ ذَلِكَ: ﴿وَاللَّائِي يَئِسْنَ﴾ بِسُكُونِ الْيَاءِ فِي قِرَاءَةِ الْبَزِّيِّ

213
00:16:39,791 --> 00:16:40,175
وَأَبِي عَمْرٍو،

214
00:16:39,791 --> 00:16:40,175
وَ﴿مَالِيَهْ هَلَكَ﴾ فِي غَيْرِ قِرَاءَةِ حَمْزَةَ وَيَعْقُوبَ،

215
00:16:39,791 --> 00:16:40,175
فَفِيهِمَا الْإِظْهَارُ وَالْإِدْغَامُ كَمَا بَيَّنَّا فِي [الْأَصْلِ]،

216
00:16:39,791 --> 00:16:40,175
وَإِنْ تَحَرَّكَا سُمِّيَا مِثْلَيْنِ كَبِيرَيْنِ؛ نَحْوُ: ﴿الرَّحِيمِ مَالِكِ﴾ كَمَا سَيَأْتِي؛

217
00:16:39,791 --> 00:16:40,175
وَإِنْ يَكُونَا مَخْرَجًا تَقَارَبَا *** وَفِي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا أَيْ

218
00:16:39,791 --> 00:16:40,175
وَإِنْ تَقَارَبَ الْحَرْفَانِ فِي

219
00:16:44,791 --> 00:16:45,560
الْمَخْرَجِ وَاخْتَلَفَا فِي الصِّفَاتِ كَالدَّالِ وَالسِّينِ الْمُهْمَلَتَيْنِ،

220
00:16:45,175 --> 00:16:45,560
وَالْجِيمِ وَالذَّالِ،

221
00:16:45,175 --> 00:16:45,560
وَالتَّاءِ وَالطَّاءِ وَالظَّاءِ وَالزَّايِ،

222
00:16:45,175 --> 00:16:45,560
يُلَقَّبَانِ بِالْمُتَقَارِبَيْنِ،

223
00:16:45,175 --> 00:16:45,560
ثُمَّ إِنْ سَكَنَ أَوَّلُهُمَا سُمِّيَا مُتَقَارِبَيْنِ صَغِيرًا وَحُكْمُهُ جَوَازُ الْإِدْغَامِ؛

224
00:16:45,175 --> 00:16:45,560
نَحْوُ: ﴿قَدْ سَمِعَ﴾،

225
00:16:45,175 --> 00:16:45,560
وَ﴿لَقَدْ جَاءَكُمْ﴾،

226
00:16:45,175 --> 00:16:45,560
وَ﴿إِذْ تَأْتِيهِمْ﴾،

227
00:16:45,175 --> 00:16:45,560
وَإِنْ تَحَرَّكَا سُمِّيَا مُتَقَارِبَيْنِ كَبِيرًا؛ نَحْوُ: ﴿مِنْ مَاءٍ﴾ غَيْرِهَا بَعْدَ

228
00:16:45,175 --> 00:16:45,560
ذَلِكَ ﴿الصَّالِحَاتِ طُوبَى﴾،

229
00:16:45,175 --> 00:16:45,560
وَ﴿وَإِذَا النُّفُوسُ زُوِّجَتْ﴾؛ مُتَقَارِبَيْنِ أَوْ يَكُونَا اتَّفَقَا *** فِي مَخْرَجٍ

230
00:16:45,175 --> 00:16:45,560
دُونَ الصِّفَاتِ حُقِّقَا بِالْمُتَجَانِسَيْنِ أَيْ وَإِنِ اتَّفَقَ الْحَرْفَانِ فِي

231
00:16:52,483 --> 00:16:53,252
الْمَخْرَجِ وَاخْتَلَفَا

232
00:17:16,635 --> 00:17:17,209
فِي

233
00:17:21,228 --> 00:17:22,376
الصِّفَاتِ سُمِّيَا مُتَجَانِسَيْنِ كَالْبَاءِ وَالْمِيمِ،

234
00:17:21,802 --> 00:17:22,376
وَالْبَاءِ وَالْفَاءِ،

235
00:17:42,840 --> 00:17:43,638
ثُمَّ

236
00:18:06,931 --> 00:18:08,207
إِنْ سَكَنَ أَوَّلُهُمَا سُمِّيَا مُتَجَانِسَيْنِ صَغِيرًا وَحُكْمُهُمَا جَوَازُ الْإِدْغَامِ أَيْضًا؛

237
00:18:07,569 --> 00:18:08,207
نَحْوُ: ﴿ارْكَبْ مَعَنَا﴾،

238
00:18:07,569 --> 00:18:08,207
﴿يَتُبْ فَأُولَئِكَ﴾،

239
00:18:07,569 --> 00:18:08,207
وَإِنْ تَحَرَّكَا سُمِّيَا مُتَجَانِسَيْنِ كَبِيرًا؛ نَحْوُ: ﴿يُعَذِّبُ

240
00:18:32,446 --> 00:18:33,722
مَنْ يَشَاءُ﴾،

241
00:18:33,084 --> 00:18:33,722
وَقَوْلِهِمْ عَلَى مَرْيَمَ بُهْتَانًا عَظِيمًا،

242
00:18:33,084 --> 00:18:33,722
وَهَذَا كُلُّهُ مَعْنَى قَوْلِي بِالْمُتَجَانِسَيْنِ؛

243
00:18:59,590 --> 00:19:00,953
ثُمَّ إِنْ سَكَنَ *** أَوَّلُ

244
00:19:05,843 --> 00:19:08,282
كُلٍّ فَالصَّغِيرَ سَمِّيَنْ أَوْ حُرِّكَ الْحَرْفَانِ فِي كُلٍّ فَقُلْ ***

245
00:19:07,794 --> 00:19:08,282
كُلٌّ كَبِيرٌ وَافْهَمَنْهُ بِالْمُثُلْ أَيْ ثُمَّ بَعْدَ مَعْرِفَةِ هَذِهِ الْأَقْسَامِ

246
00:19:07,794 --> 00:19:08,282
الثَّلَاثَةِ إِذَا سَكَنَ أَوَّلُ كُلٍّ مِنْهُمَا فَسَمِّهِ صَغِيرًا يُقَلُّ الْأَعْمَالُ

247
00:19:07,794 --> 00:19:08,282
فِيهِ، أَوْ حُرِّكَ الْحَرْفَانِ

248
00:19:30,929 --> 00:19:32,085
فِي كُلٍّ فَقُلْ كُلٌّ،

249
00:19:31,507 --> 00:19:44,847
وَإِذَا سَكَنَ أَوَّلُ كُلٍّ مِنْهُمَا فَسَمِّهِ صَغِيرًا يُقَلُّ الْأَعْمَالُ فِيهِ،

250
00:19:44,847 --> 00:19:45,331
وَإِذَا سَكَنَ أَوَّلُ كُلٍّ فَقُلْ كُلٌّ كُلٌّ مِنْهُمَا فَسَمِّهِ صَغِيرًا

251
00:19:44,847 --> 00:19:45,331
يُقَلُّ الْأَعْمَالُ فِيهِ،

252
00:19:44,847 --> 00:19:45,331
وَافْهَمَنْهُ بِالْمُثُلِ؛

253
00:19:59,318 --> 00:20:00,173
أَيْ وَإِنْ حُرِّكَ الْحَرْفَانِ

254
00:20:06,491 --> 00:20:07,307
فِي كُلٍّ

255
00:20:13,428 --> 00:20:26,242
مِنَ الْأَقْسَامِ الثَّلَاثَةِ فَسَمِّهِ كَبِيرًا وَذَلِكَ لِكَثْرَةِ الْأَعْمَالِ فِيهِ،

256
00:20:26,242 --> 00:20:26,800
وَالْمُثُلُ بِضَمِّ الْمِيمِ وَالثَّاءِ جَمْعُ مِثَالٍ،

257
00:20:26,242 --> 00:20:26,800
وَقَدْ مَرَّ بِنَا بَيَانُهَا وَتَوْضِيحُ

258
00:20:37,677 --> 00:20:38,869
ذَلِكَ يُعْلَمُ

259
00:20:40,656 --> 00:20:41,847
مِنَ الْأَصْلِ؛ ثُمَّ ذَكَرَ النَّاظِمُ رَحِمَهُ اللَّهُ أَحْكَامَ الْمِثْلَيْنِ وَالْمُتَقَارِبَيْنِ

260
00:20:41,251 --> 00:20:41,847
وَالْمُتَجَانِسَيْنِ، وَيَحْسُنُ قَبْلَ شَرْحِ هَذَا الْبَابِ

261
00:20:46,447 --> 00:20:47,556
أَوِ التَّعْلِيقِ

262
00:20:53,653 --> 00:20:54,761
عَلَى شَرْحِ

263
00:21:12,606 --> 00:21:13,862
هَذَا الْبَابِ تَعْرِيفُ هَذِهِ الْمُصْطَلَحَاتِ الثَّلَاثَةِ: - فَالْمِثْلَانِ: هُمَا الْحَرْفَانِ

264
00:21:13,444 --> 00:21:13,862
اللَّذَانِ يَتَّحِدَا مَخْرَجًا وَصِفَةً أَوْ اسْمًا وَرَسْمًا كَالْبَاءِ مَعَ الْْبَاءِ،

265
00:21:13,444 --> 00:21:13,862
وَالْمِيمِ مَعَ الْمِيمِ،

266
00:21:13,444 --> 00:21:13,862
وَاللَّامِ مَعَ اللَّامِ،

267
00:21:13,444 --> 00:21:13,862
وَالْفَاءِ مَعَ الْفَاءِ،

268
00:21:13,444 --> 00:21:17,212
وَنَحْوِ ذَلِكَ،

269
00:21:17,212 --> 00:21:17,631
وَالدَّالِ مَعَ الدَّالِ،

270
00:21:17,212 --> 00:21:17,631
هَذَانِ هُمَا الْمِثْلَانِ؛ - الْمُتَقَارِبَانِ: هُمَا الْحَرْفَانِ اللَّذَانِ يَتَقَارَبَا مَخْرَجًا

271
00:21:17,212 --> 00:21:17,631
وَصِفَةً أَوْ مَخْرَجًا أَوْ صِفَةً،

272
00:21:17,212 --> 00:21:17,631
حَصَلَ بَيْنَهُمَا تَقَارُبٌ مُجَرَّدُ تَقَارُبٍ،

273
00:21:42,436 --> 00:21:43,415
وَلَا يُوجَدُ اتِّحَادٌ لَا

274
00:21:47,823 --> 00:21:48,803
فِي الصِّفَاتِ وَلَا

275
00:21:53,701 --> 00:21:54,681
فِي لَا يُوجَدُ اتِّحَادٌ فِي الْمَخْرَجِ وَلَا فِي الصِّفَاتِ؛ -

276
00:21:54,191 --> 00:21:54,681
وَأَمَّا الْمُتَجَانِسَانِ: فَهُمُ الْحَرْفَانِ اللَّذَانِ اتَّحَدَا مَخْرَجًا وَاخْتَلَفَا فِي بَعْضِ

277
00:21:54,191 --> 00:21:54,681
الصِّفَاتِ مِثْلُ الذَّالِ وَالثَّاءِ،

278
00:21:54,191 --> 00:21:54,681
وَمِثْلُ الطَّاءِ وَالتَّاءِ،

279
00:21:54,191 --> 00:21:54,681
تَقُولُ: [أَطْ،

280
00:21:54,191 --> 00:21:54,681
أَتْ، أَدْ]،

281
00:21:54,191 --> 00:21:54,681
وَالذَّالِ وَالثَّاءِ: [أَذْ،

282
00:21:54,191 --> 00:21:54,681
أَثْ]؛ فَقَالَ النَّاظِمُ رَحِمَهُ اللَّهُ:

283
00:21:59,150 --> 00:22:00,350
[إِنْ فِي الصِّفَاتِ وَالْمَخَارِجِ اتَّفَقْ حَرْفَانِ فَالْمِثْلَانِ فِيهِمَا أَحَقْ]،

284
00:21:59,750 --> 00:22:00,350
إِذًا

285
00:22:09,744 --> 00:22:10,306
إِنَّ الْمِثْلَيْنِ هُمَا الْحَرْفَانِ اللَّذَانِ اتَّحَدَا مَخْرَجًا وَصِفَةً،

286
00:22:10,025 --> 00:22:10,306
وَذَكَرَ لِذَلِكَ مِثَالًا مِثْلَ: ﴿اضْرِبْ بِعَصَاكَ﴾،

287
00:22:10,025 --> 00:22:10,306
﴿بَلْ لَا يَخَافُونَ﴾،

288
00:22:10,025 --> 00:22:10,306
﴿وَقَدْ دَخَلُوا﴾،

289
00:22:10,025 --> 00:22:10,306
ثُمَّ اسْتَثْنَى قَالُوا: اسْتُثْنِيَ

290
00:22:13,834 --> 00:22:15,176
مِنْ ذَلِكَ ﴿وَاللَّائِي يَئِسْنَ﴾ عَلَى قِرَاءَةِ

291
00:22:25,911 --> 00:22:27,253
مَنْ يَجْعَلُ الْهَمْزَةَ يَاءً فِي قِرَاءَةِ الْبَزِّيِّ،

292
00:22:26,582 --> 00:22:27,253
وَهَذَا اخْتِلَافٌ بَيْنَ الْقِرَاءَةِ لَا يَحْسُنُ ذِكْرُهُ،

293
00:22:26,582 --> 00:22:27,253
لَكِنَّ الْقَاعِدَةَ الْمُتَّفَقَ عَلَيْهَا وَهِيَ مَوَاضِعُ يَسِيرَةٌ مُسْتَثْنًى لِبَعْضِ الْقِرَاءَةِ،

294
00:22:26,582 --> 00:22:27,253
ذَكَرَ مِنْهَا النَّاظِمُ رَحِمَهُ اللَّهُ قَوْلَهُ تَعَالَى: ﴿وَاللَّائِي يَئِسْنَ﴾ عَلَى

295
00:22:26,582 --> 00:22:27,253
قِرَاءَةِ تَحْوِيلِ الْهَمْزَةِ إِلَى يَاءٍ،

296
00:22:26,582 --> 00:22:27,253
وَذَلِكَ ﴿مَالِيَهْ هَلَكَ عَنِّي﴾ فِي قِرَاءَةِ غَيْرِ حَمْزَةَ وَيَعْقُوبَ،

297
00:22:26,582 --> 00:22:27,253
فَفِيهِمَا الْإِظْهَارُ وَالْإِدْغَامُ،

298
00:22:26,582 --> 00:22:27,253
فِيهِمَا الْإِظْهَارُ وَالْإِدْغَامُ كَمَا بَيَّنَّا فِي الْأَصْلِ؛

299
00:22:31,950 --> 00:22:32,860
أَيْ [فَتْحُ الْمَلِكِ الْمُتَعَالِ بِشَرْحِ تُحْفَةِ الْأَطْفَالِ]،

300
00:22:32,405 --> 00:22:34,681
عَلَى كُلِّ حَالٍ الْقَاعِدَةُ الْعَامَّةُ عِنْدَ الْقُرَّاءِ أَنَّ الْمِثْلَيْنِ يُدْغَمَانِ،

301
00:22:37,412 --> 00:22:38,322
أَنَّ الْمِثْلَيْنِ وَتُسْتَثْنَى مَوَاضِعُ يَسِيرَةٌ مَحَلُّهَا كُتُبُ الْقُرَّاءِ؛

302
00:22:56,270 --> 00:22:58,666
ثُمَّ ذَكَرَ

303
00:22:58,666 --> 00:22:59,864
النَّوْعَ الثَّانِي

304
00:23:18,381 --> 00:23:19,567
قَالَ: [وَإِنْ يَكُونَا مَخْرَجًا تَقَارَبَا وَفِي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا مُقَارِبَيْنِ]،

305
00:23:18,974 --> 00:23:19,567
هَكَذَا

306
00:23:26,683 --> 00:23:27,870
فِي النُّسْخَةِ الْمُعْتَمَدَةِ،

307
00:23:49,640 --> 00:23:50,672
فِي النُّسْخَةِ الْمُعْتَمَدَةِ

308
00:23:52,736 --> 00:23:53,768
مِنَ الشَّرْحِ [مُقَارِبَيْنِ] وَلَيْسَ بِالتَّاءِ [مُتَقَارِبَيْنِ]،

309
00:23:53,252 --> 00:23:53,768
وَإِنَّمَا [مُقَارِبَيْنِ] فِي نُسْخَةِ الشَّرْحِ وَكَذَا فِي نُسْخَةِ الضَّبَّاعِ رَحِمَهُ

310
00:23:53,252 --> 00:23:53,768
اللَّهُ، رَحِمَهُ اللَّهُ الْجَمِيعَ،

311
00:23:53,252 --> 00:23:53,768
مِنْ حَذْفِ الْجَلَالِ فِي شَرْحِ تُحْفَةِ الْأَطْفَالِ مِنْ تَاءِ [مُقَارِبَيْنِ]،

312
00:23:53,252 --> 00:23:53,768
وَحَذْفُ التَّاءِ لِضَرُورَةِ النَّظْمِ،

313
00:23:53,252 --> 00:23:53,768
وَالْمُتَقَارِبَانِ كَمَا سَبَقَ هُمَا الْحَرْفَانِ اللَّذَانِ تَقَارَبَا مَخْرَجًا وَصِفَةً أَوْ

314
00:23:53,252 --> 00:23:53,768
مَخْرَجًا أَوْ صِفَةً،

315
00:23:53,252 --> 00:23:53,768
وَحُكْمُ الْمُتَقَارِبَيْنِ الْمُتَقَارِبِ الصَّغِيرِ عِنْدَ حَفْصٍ الْإِظْهَارُ،

316
00:23:53,252 --> 00:23:53,768
هَذَا الْأَصْلُ إِلَّا فِي بَعْضِ الْمَسَائِلِ،

317
00:23:53,252 --> 00:23:53,768
إِلَّا فِي بَعْضِ الْمَسَائِلِ،

318
00:23:53,252 --> 00:23:53,768
لَكِنْ مِنْ حَيْثُ الْعُمُومُ الْمُتَقَارِبُ عِنْدَ حَفْصٍ حُكْمُهُ الْإِظْهَارُ مِثْلُ

319
00:23:53,252 --> 00:23:53,768
قَوْلِهِ تَعَالَى: ﴿قَدْ سَمِعَ اللَّهُ﴾،

320
00:23:53,252 --> 00:23:54,800
﴿إِذْ تَأْتِيهِمْ﴾ إِلَى غَيْرِ ذَلِكَ مِنَ الْأَمْثِلَةِ الَّتِي ذَكَرَهَا النَّاظِمُ؛

321
00:23:54,284 --> 00:23:54,800
وَمِمَّا يُنَبَّهُ عَلَيْهِ أَنَّ قَوْلَهُ تَعَالَى: ﴿أَلَمْ نَخْلُقْكُمْ مِنْ مَاءٍ

322
00:23:54,284 --> 00:23:54,800
مَهِينٍ﴾ فِي سُورَةِ الْمُرْسَلَاتِ هِيَ مِنَ الْمُتَقَارِبَيْنِ،

323
00:23:54,284 --> 00:23:54,800
الْقَافُ وَالْكَافُ بَيْنَهُمَا تَقَارُبٌ وَهُمَا مِنَ الْمُتَقَارِبَيْنِ الصَّغِيرِ،

324
00:23:54,284 --> 00:23:54,800
وَوَقَعَ فِي هَذَا الْمَوْضِعِ خِلَافٌ بَيْنَ جَمِيعِ الْقُرَّاءِ عَلَى وَجْهَيْنِ

325
00:24:02,727 --> 00:24:02,735
مَا عَدَا السُّوسِيَّ عَنْ أَبِي عَمْرٍو فَلَهُ الْإِدْغَامُ الْكَامِلُ: -

326
00:24:02,731 --> 00:24:02,735
فَالْوَجْهُ الْأَوَّلُ: هُوَ الْإِدْغَامُ الْكَامِلُ بِحَيْثُ تَذْهَبُ يَذْهَبُ الْمَخْرَجُ وَصِفَةً

327
00:24:02,731 --> 00:24:02,735
[أَلَمْ نَخْلُقْكُمْ] نَخْلُكُّـمْ بَعْدَهَا كَافٌ مُشَدَّدَةٌ وَتَذْهَبُ الْقَافُ تَمَامًا؛ -

328
00:24:02,731 --> 00:24:02,735
وَالْوَجْهُ الثَّانِي: هُوَ الْإِدْغَامُ النَّاقِصُ بِحَيْثُ يَذْهَبُ الْمَخْرَجُ وَتَبْقَى صِفَةُ

329
00:24:02,731 --> 00:24:02,735
الْقَافِ [أَلَمْ نَخْلُقْكُمْ]؛ فَهَذَانِ الْوَجْهَانِ لِجَمِيعِ الْقُرَّاءِ مَا عَدَا السُّوسِيَّ

330
00:24:02,731 --> 00:24:02,735
عَنْ أَبِي عَمْرٍو فَلَهُ الْإِدْغَامُ الْكَامِلُ؛ ثُمَّ ذَكَرَ النَّاظِمُ

331
00:24:28,388 --> 00:24:31,035
رَحِمَهُ اللَّهُ الْحُكْمَ الثَّالِثَ وَهُمَا الْمُتَجَانِسَانِ قَالَ:

332
00:24:32,800 --> 00:24:33,726
[أَوْ يَكُونَا اتَّفَقَا

333
00:24:42,985 --> 00:24:43,911
فِي مَخْرَجٍ]

334
00:24:54,388 --> 00:24:55,250
أَيْ حَصَلَ اتِّفَاقٌ

335
00:25:12,400 --> 00:25:13,400
فِي الْمَخْرَجِ [دُونَ الصِّفَاتِ حُقِّقَا بِالْمُتَجَانِسَيْنِ]،

336
00:25:12,900 --> 00:25:13,400
فَالْمُتَجَانِسَانِ هُمَا الْحَرْفَانِ اللَّذَانِ اتَّحَدَا مَخْرَجًا وَاخْتَلَفَا فِي بَعْضِ الصِّفَاتِ،

337
00:25:12,900 --> 00:25:13,400
وَحُكْمُ الْمُتَجَانِسَيْنِ عِنْدَ حَفْصٍ الْإِظْهَارُ إِلَّا فِي بَعْضِ الْمَسَائِلِ،

338
00:25:12,900 --> 00:25:13,400
وَسَبَقَ تَفْصِيلُ

339
00:25:36,110 --> 00:25:37,050
هَذَا فِي شَرْحِ [تُحْفَةِ الْأَطْفَالِ] الَّذِي أُقْرِئَ الْعَامَ الْمَاضِيَ،

340
00:25:36,580 --> 00:25:37,050
ثُمَّ ذَكَرَ وَمِثَالَ الْمُتَجَانِسَيْنِ

341
00:25:58,760 --> 00:25:59,460
قَالَ: [الطَّائِفَةُ]،

342
00:25:59,110 --> 00:25:59,460
وَثُمَّ ذَكَرَ

343
00:26:15,234 --> 00:26:16,497
بَعْدَ ذَلِكَ

344
00:26:26,192 --> 00:26:27,922
قَالَ: [ثُمَّ إِنْ سَكَنَ أَوَّلُ كُلٍّ فَالصَّغِيرَ سَمِّيَنْ أَوْ حُرِّكَ

345
00:26:27,490 --> 00:26:27,922
الْحَرْفَانِ فِي كُلٍّ فَقُلْ كُلٌّ كَبِيرٌ وَافْهَمَنْهُ بِالْمُثُلِ]،

346
00:26:43,055 --> 00:26:44,350
أَنْ بَيَّنَ

347
00:27:17,826 --> 00:27:19,591
فِي هَذَيْنِ الْبَيْتَيْنِ أَنَّ الْإِدْغَامَ يَنْقَسِمُ إِلَى قِسْمَيْنِ: - إِدْغَامٌ

348
00:27:18,709 --> 00:27:19,591
صَغِيرٌ: وَهُوَ أَنْ يَسْكُنَ الْحَرْفُ الْأَوَّلُ وَيَتَحَرَّكُ الثَّانِي،

349
00:27:18,709 --> 00:27:19,591
وَمِثْلُ بَعْضِ هَذِهِ الْأَمْثِلَةِ الَّتِي سَبَقَتْ: ﴿قَالَتْ طَائِفَةٌ﴾ وَنَحْوُ ذَلِكَ؛

350
00:27:18,709 --> 00:27:19,591
- وَالْقِسْمُ الثَّانِي الْإِدْغَامُ الْكَبِيرُ: هُوَ أَنْ يَتَحَرَّكَ الْحَرْفَانِ،

351
00:27:18,709 --> 00:27:19,591
وَهَذَا الْأَصْلُ الْإِدْغَامُ فِيهِ عِنْدَ السُّوسِيِّ عَنْ أَبِي عَمْرٍو

352
00:27:38,415 --> 00:27:39,591
مِنْ رِوَايَةِ السُّوسِيِّ،

353
00:27:39,003 --> 00:27:39,591
مِثَالُ ذَلِكَ قَوْلُهُ تَعَالَى: ﴿نَحْنُ نَقُصُّ عَلَيْكَ﴾،

354
00:27:39,003 --> 00:27:39,591
[نَحْنُ نَقُصُّ] النُّونُ الْأُولَى الْمُتَحَرِّكَةُ وَالثَّانِيَةُ،

355
00:27:39,003 --> 00:27:39,591
لَكِنَّ السُّوسِيَّ قَرَأَهَا: [نَحْنُ نَّقُصُّ عَلَيْكَ] فَيُدْغِمُ النُّونَ الْمُتَحَرِّكَةَ الْمُدْغَمَةَ

356
00:27:39,003 --> 00:27:41,356
بِالنُّونِ الثَّانِيَةِ؛ قَالَ النَّاظِمُ رَحِمَهُ اللَّهُ: [وَافْهَمَنْهُ بِالْمُثُلِ] أَيْ بِالْأَمْثِلَةِ

357
00:27:40,768 --> 00:27:41,356
لِأَنَّ الْأَمْثِلَةَ مِمَّا يُقَرِّبُ،

358
00:27:40,768 --> 00:27:41,356
ثُمَّ قَالُوا: قَدْ مَرَّ بَيَانُهَا وَتَوْضِيحُ ذَلِكَ يُعْلَمُ مِنَ الْأَصْلِ،

359
00:27:40,768 --> 00:27:42,532
كُلُّ مَا جَاءَ فِي قَوْلِ الشَّارِحِ رَحِمَهُ اللَّهُ: [يُعْلَمُ مِنَ

360
00:27:41,944 --> 00:27:42,532
الْأَصْلِ] قَصْدُهُ [فَتْحُ الْمَلِكِ الْمُتَعَالِ بِشَرْحِ تُحْفَةِ الْأَطْفَالِ] لِابْنِ شَيْخِهِ

361
00:27:41,944 --> 00:27:42,532
مُحَمَّدٍ الْمِيهِيِّ؛ نَعَمْ،

362
00:27:41,944 --> 00:27:42,532
السَّلَامُ عَلَيْكُمْ؛ أَقْسَامُ

363
00:27:47,826 --> 00:27:49,003
الْمَدِّ وَالْمَدُّ لُغَةً هُوَ الْمَطُّ وَقِيلَ الزِّيَادَةُ،

364
00:27:48,415 --> 00:27:49,003
وَفِي اصْطِلَاحِ الْقُرَّاءِ: وَشَكْلٌ دَالٌّ عَلَى صُورَةِ غَيْرِهِ مِنَ الْحُرُوفِ

365
00:27:48,415 --> 00:27:49,003
كَالْغُنَّةِ

366
00:27:58,054 --> 00:27:59,459
فِي الْأَغَنِّ،

367
00:27:58,757 --> 00:27:59,459
وَضَعَتْهُ الْقُرَّاءُ لِيَدُلَّ

368
00:28:26,143 --> 00:28:26,846
عَلَى

369
00:28:35,745 --> 00:28:36,816
حُرُوفِ الْمَدِّ وَاللِّينِ،

370
00:28:36,280 --> 00:28:36,816
وَلَيْسَ بِحَرَكَةٍ وَلَا

371
00:29:01,987 --> 00:29:03,054
حَرْفٍ وَلَا سُكُونٍ،

372
00:29:02,521 --> 00:29:03,054
وَهُوَ هُنَا عِبَارَةٌ عَنْ طُولِ زَمَنِ صَوْتِ الْحَرْفِ وَالزِّيَادَةِ عَلَى

373
00:29:05,190 --> 00:29:06,257
مَا فِيهِ عِنْدَ مُلَاقَاةِ هَمْزٍ أَوْ سُكُونٍ،

374
00:29:05,723 --> 00:29:06,257
وَاللِّينُ وَقُلْ وَكَمَا سَيَأْتِي فِي النَّظْمِ: وَالْمَدُّ أَصْلِيٌّ وَفَرْعِيٌّ لَهُ

375
00:29:05,723 --> 00:29:08,926
*** وَسَمِّ أَوَّلًا طَبِيعِيًّا وَهُوَ مَا

376
00:29:08,926 --> 00:29:09,460
لَا تَوَقُّفٌ لَهُ عَلَى سَبَبْ *** وَلَا بِدُونِهِ الْحُرُوفُ تُجْتَلَبْ

377
00:29:08,926 --> 00:29:11,062
بَلْ أَيُّ حَرْفٍ غَيْرِ هَمْزٍ

378
00:29:34,830 --> 00:29:35,618
أَوْ سُكُونْ *** جَاءَ بَعْدَ مَدٍّ فَالطَّبِيعِيَّ

379
00:29:49,795 --> 00:29:52,552
يَكُونْ يُعْلَمُ أَنَّ

380
00:30:21,090 --> 00:30:23,210
الْمَدَّ قِسْمَانِ: أَصْلِيٌّ: فِي الْقِرَاءَةِ وَأَكْثَرُ مَا يَكُونُ الِاخْتِلَافُ فِيهِ،

381
00:30:22,680 --> 00:30:23,210
وَفَرْعِيٌّ: وَسَيَأْتِي تَعْرِيفُهُ،

382
00:30:22,680 --> 00:30:23,210
فَالْأَصْلِيُّ

383
00:30:35,920 --> 00:30:37,150
هُوَ الَّذِي لَا يَتَوَقَّفُ عَلَى سَبَبٍ مِنْ هَمْزٍ

384
00:30:49,408 --> 00:30:50,495
أَوْ سُكُونٍ،

385
00:30:58,792 --> 00:31:00,188
وَلَا تَقُومُ ذَاتُ الْحَرْفِ

386
00:31:04,374 --> 00:31:05,770
إِلَّا بِهِ،

387
00:31:05,072 --> 00:31:05,770
وَتَى مَوْجُودٌ ذَلِكَ نَحْوُ الَّذِينَ،

388
00:31:05,072 --> 00:31:05,770
قَوْلُ الْمُصَنِّفِ

389
00:31:08,447 --> 00:31:10,456
رَحِمَهُ اللَّهُ: [أَصْلِيٌّ

390
00:31:19,164 --> 00:31:20,058
فِي الْقِرَاءَةِ وَأَكْثَرُ مَا يَكُونُ الِاخْتِلَافُ فِيهِ]،

391
00:31:19,611 --> 00:31:20,058
بَلْ

392
00:31:23,347 --> 00:31:23,996
عَلَى الصَّوَابِ صَوَابُ الْعِبَارَةِ: وَأَقَلُّ مَا يَكُونُ الْخِلَافُ فِيهِ كَمَا

393
00:31:23,671 --> 00:31:23,996
سَيَأْتِي بَيَانُهُ؛ نَعَمْ،

394
00:31:23,671 --> 00:31:23,996
أَحْسَنَ اللَّهُ إِلَيْكُمْ؛ ذَلِكَ

395
00:31:31,913 --> 00:31:32,998
نَحْوُ الَّذِينَ وَآمَنُوا وَعَفَا،

396
00:31:47,497 --> 00:31:48,444
مِنْ كُلِّ مَا مُدَّ قَدْرَ الْأَلِفِ،

397
00:31:47,971 --> 00:31:48,444
وَلَوْ يَلِيهِ سُكُونٌ عَارِضٌ أَوْ هَمْزٌ مُنْفَصِلٌ،

398
00:31:47,971 --> 00:31:48,444
وَتَجِيءُ كُلُّ الْحُرُوفِ بَعْدَهُ إِلَّا الْهَمْزَةَ وَالسُّكُونَ بِخِلَافِ الْفَرْعِيِّ لِتَوَقُّفِهِ

399
00:31:47,971 --> 00:31:48,444
عَلَى وُجُودِ وَاحِدٍ مِنْهُمَا،

400
00:31:47,971 --> 00:31:48,444
وَلِذَا قُلْتُ: وَالْآخَرُ الْفَرْعِيُّ مَوْقُوفٌ عَلَى *** سَبَبْ كَهَمْزٍ أَوْ

401
00:31:47,971 --> 00:31:50,813
سُكُونٍ مُسْجَلَا أَيْ وَالْمَدُّ الْآخَرُ وَهُوَ الْفَرْعِيُّ،

402
00:31:50,339 --> 00:31:50,813
وَحُكْمُهُ أَنَّهُ مُتَوَقِّفٌ عَلَى سَبَبٍ كَهَمْزٍ أَوْ سُكُونٍ مُطْلَقَةً أَوْ

403
00:31:50,339 --> 00:31:51,760
هُمَا؛ لِأَنَّ ذَلِكَ مُوجِبٌ لِلزِّيَادَةِ وَهُوَ الْمَقْصُودُ فِي هَذَا الْبَابِ،

404
00:31:51,286 --> 00:31:51,760
فَمَا سُكِتَ عَنْهُ فَأَجْرِهِ عَلَى الْأَصْلِ،

405
00:31:51,286 --> 00:31:51,760
وَسَيَأْتِي تَفْصِيلُ ذَلِكَ

406
00:32:07,956 --> 00:32:09,229
فِي النَّظْمِ،

407
00:32:09,229 --> 00:32:09,865
وَ[سَبَبْ]

408
00:32:30,092 --> 00:32:31,217
فِي النَّظْمِ بِسُكُونِ الْبَاءِ الثَّانِيَةِ لِلضَّرُورَةِ؛ حُرُوفُهُ ثَلَاثَةٌ فَعِيهَا ***

409
00:32:30,655 --> 00:32:31,217
مِنْ لَفْظِ وَايٍ وَهِيَ

410
00:32:48,553 --> 00:32:49,825
فِي نُوحِيهَا وَالْكَسْرُ قَبْلَ الْيَا وَقَبْلَ الْوَاوِ ضَمْ *** شَرْطٌ

411
00:32:49,189 --> 00:32:49,825
وَفَتْحٌ قَبْلَ أَلْفٍ يُلْتَزَمْ أَيْ حُرُوفُ

412
00:32:53,007 --> 00:32:54,280
الْمَدِّ الْفَرْعِيِّ ثَلَاثَةٌ يَجْمَعُهَا لَفْظُ [وَايٍ]،

413
00:32:53,644 --> 00:32:54,280
وَهِيَ: الْوَاوُ الْمَضْمُومُ مَا قَبْلَهَا،

414
00:32:53,644 --> 00:32:54,280
وَالْيَاءُ الْمَكْسُورَةُ مَا قَبْلَهَا؛ نَحْوُ: ﴿الَّذِينَ﴾ وَ﴿آمَنُوا﴾،

415
00:32:53,644 --> 00:32:54,280
وَالْأَلِفُ وَلَا

416
00:33:07,189 --> 00:33:08,098
يَكُونُ مَا قَبْلَهَا إِلَّا مَفْتُوحًا؛ نَحْوُ: ﴿عَفَا﴾،

417
00:33:07,644 --> 00:33:08,098
وَهِيَ مَجْمُوعَةٌ بِشُرُوطِهَا

418
00:33:18,623 --> 00:33:20,459
فِي قَوْلِهِ تَعَالَى: ﴿نُوحِيهَا﴾،

419
00:33:19,541 --> 00:33:20,459
وَسُمِّيَتْ حُرُوفَ مَدٍّ لِامْتِدَادِ الصَّوْتِ

420
00:33:26,130 --> 00:33:27,039
عِنْدَ النُّطْقِ بِهَا،

421
00:33:26,585 --> 00:33:27,039
وَ[أَلْفٍ]

422
00:33:30,221 --> 00:33:31,130
فِي النَّظْمِ بِسُكُونِ اللَّامِ لِلضَّرُورَةِ؛ وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ سُكِّنَا

423
00:33:30,675 --> 00:33:31,130
***

424
00:33:36,498 --> 00:33:37,235
إِنِ انْفِتَاحٌ قَبْلَ

425
00:33:49,380 --> 00:33:50,880
كُلٍّ أُعْلِنَا وَاللَّيْنُ بِفَتْحِ اللَّامِ

426
00:34:14,863 --> 00:34:15,930
إِنْ لَمْ يُضَفْ،

427
00:34:15,397 --> 00:34:15,930
وَبِكَسْرِهَا إِنْ أُضِيفَ،

428
00:34:15,397 --> 00:34:15,930
أَيْ حُرُوفُ اللَّيْنِ اثْنَانِ مِنَ الثَّلَاثَةِ الْمُتَقَدِّمَةِ،

429
00:34:15,397 --> 00:34:15,930
وَهُمَا: الْيَاءُ وَالْوَاوُ بِشَرْطِ سُكُونِهِمَا وَانْفِتَاحِ

430
00:34:42,463 --> 00:34:43,130
مَا قَبْلَهُمَا؛ نَحْوُ: [بَيْتٍ] وَ[خَوْفٍ]،

431
00:34:42,797 --> 00:34:43,130
سُمِّيَا بِذَلِكَ لِأَنَّهُمَا يَخْرُجَانِ مِنْ لِينٍ وَعَدَمِ كُلْفَةٍ،

432
00:34:42,797 --> 00:34:43,130
فَإِنْ تَحَرَّكَتَا فَلَيْسَتَا بِحَرْفَيْ لِينٍ أَيْ وَلَا

433
00:35:02,403 --> 00:35:03,312
مَدٍّ؛ فَعُلِمَ

434
00:35:06,130 --> 00:35:08,130
أَنَّ الْيَاءَ وَالْوَاوَ لَهُمَا

435
00:35:19,130 --> 00:35:20,130
ثَلَاثَةُ أَحْوَالٍ: - مَدٌّ وَلِينٌ:

436
00:35:23,880 --> 00:35:25,380
إِنْ سَكَنَ وَانْضَمَّ مَا قَبْلَ الْوَاوِ وَانْكَسَرَ مَا قَبْلَ الْيَاءِ؛

437
00:35:24,630 --> 00:35:25,380
- وَلِينٌ فَقَطْ:

438
00:35:49,055 --> 00:35:49,964
إِنْ سَكَنَ وَانْفَتَحَ مَا قَبْلَهُمَا؛ - وَلَا وَلَا:

439
00:36:09,908 --> 00:36:10,831
إِنْ تَحَرَّكَتَا؛ وَأَمَّا الْأَلِفُ فَلَا تَكُونُ إِلَّا

440
00:36:29,560 --> 00:36:30,140
حَرْفَ

441
00:36:33,620 --> 00:36:34,780
مَدٍّ وَلِينٍ؛ لِأَنَّهَا لَا تَتَغَيَّرُ عَنْ سُكُونِهَا وَلَا تَتَغَيَّرُ مَا

442
00:36:34,200 --> 00:36:37,100
قَبْلَهَا عَنِ الْحَرَكَةِ الْمُجَانِسَةِ لَهَا؛ ثُمَّ ذَكَرَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ

443
00:36:37,100 --> 00:36:37,680
أَحْكَامَ الْمَدِّ،

444
00:36:37,100 --> 00:36:37,680
وَيَنْبَغِي لِطَالِبِ الْعِلْمِ قَبْلَ دِرَاسَةِ

445
00:36:42,900 --> 00:36:44,060
هَذَا الْبَابِ أَنْ يَتَصَوَّرَ بَعْضَ الْمَسَائِلِ: الْمَسْأَلَةُ الْأُولَى: مَا هُوَ

446
00:36:43,480 --> 00:36:44,060
تَعْرِيفُ الْمَدِّ؟

447
00:36:43,480 --> 00:36:44,060
النَّاظِمُ عَرَّفَهُ بِتَعْرِيفٍ قَالَ: هُوَ شَكْلٌ دَالٌّ عَلَى صُورَةِ غَيْرِهِ

448
00:36:43,480 --> 00:36:44,060
إِلَى آخِرِهِ،

449
00:36:43,480 --> 00:36:44,060
لَعَلَّ الْأَوْلَى أَنْ يُقَالَ اخْتِصَارًا فِي تَعْرِيفِ الْمَدِّ: هُوَ إِطَالَةُ

450
00:36:43,480 --> 00:36:44,060
الصَّوْتِ بِحَرْفِ الْمَدِّ زِيَادَةً عَلَى الْمَدِّ الطَّبِيعِيِّ الَّذِي لَا تَقُومُ

451
00:36:43,480 --> 00:36:44,060
ذَاتُ الْحَرْفِ

452
00:36:47,540 --> 00:36:48,700
إِلَّا بِهِ؛ الْمَسْأَلَةُ الثَّانِيَةُ: لَمَّا نَتَكَلَّمُ عَنِ

453
00:37:16,333 --> 00:37:16,800
الْمَدِّ

454
00:37:39,541 --> 00:37:40,071
فِي

455
00:38:01,880 --> 00:38:02,920
هَذَا الْبَابِ وَمَا بَعْدَهُ

456
00:38:25,359 --> 00:38:26,117
مِنْ أَبْوَابٍ

457
00:38:50,850 --> 00:38:52,050
إِلَى خَاتِمَةِ النَّظْمِ،

458
00:38:51,450 --> 00:38:52,050
نَحْنُ نَتَكَلَّمُ عَنْ مَدِّ ثَلَاثَةِ حُرُوفٍ فَقَطْ،

459
00:38:51,450 --> 00:38:52,050
وَهِيَ: الْأَلِفُ،

460
00:38:51,450 --> 00:38:52,050
وَالْوَاوُ، وَالْيَاءُ،

461
00:38:51,450 --> 00:38:52,050
لَا يُوجَدُ مَدٌّ فِي أَيِّ حَرْفٍ آخَرَ إِلَّا فِي هَذِهِ

462
00:38:51,450 --> 00:38:52,050
الْأَحْرُفِ الثَّلَاثَةِ،

463
00:38:51,450 --> 00:38:52,050
لَا يُمَدُّ الْكَافُ وَلَا يُمَدُّ النُّونُ،

464
00:38:51,450 --> 00:38:52,050
نَحْنُ نَمُدُّ أَلِفًا وَوَاوًا وَيَاءً كَمَا قَالَ النَّاظِمُ رَحِمَهُ اللَّهُ:

465
00:38:51,450 --> 00:38:52,050
[حُرُوفُهُ ثَلَاثَةٌ فَعِيهَا]؛ إِذَا جَاءَتِ الْأَلِفُ وَالْوَاوُ وَالْيَاءُ وَجَاءَ بَعْدَهَا

466
00:38:51,450 --> 00:38:54,450
هَمْزٌ أَوْ سُكُونٌ هَذَا

467
00:38:54,450 --> 00:38:55,050
يَكُونُ مَدًّا فَرْعِيًّا،

468
00:38:54,450 --> 00:38:55,050
وَهَذَا سَيَأْتِي بَيَانُ مِقْدَارِهِ،

469
00:38:54,450 --> 00:38:55,050
مِنْهُمَا مَا يُمَدُّ حَرَكَتَيْنِ وَأَرْبَعًا،

470
00:38:54,450 --> 00:38:55,050
وَمِنْهُمَا مَا يُمَدُّ سِتًّا،

471
00:38:54,450 --> 00:38:55,650
وَمِنْهُمَا فِيهِ

472
00:39:15,450 --> 00:39:16,650
خِلَافٌ كَمَا سَيَأْتِي تَفْصِيلُهُ،

473
00:39:16,050 --> 00:39:16,650
إِذَا جَاءَتِ الْأَلِفُ وَالْوَاوُ وَالْيَاءُ وَلَمْ يَأْتِ بَعْدَهَا هَمْزٌ وَلَا

474
00:39:16,050 --> 00:39:16,650
سُكُونٌ وَإِنَّمَا جَاءَ بَعْدَهَا

475
00:39:40,465 --> 00:39:41,004
أَيُّ

476
00:39:49,050 --> 00:39:50,250
حَرْفٍ مِنْ حُرُوفِ الْهِجَاءِ مُتَحَرِّكٌ لَيْسَ بِسَاكِنٍ،

477
00:39:49,650 --> 00:39:50,250
فَهُنَا تُمَدُّ مَدًّا طَبِيعِيًّا؛ مِثْلُ: [قَالَ]،

478
00:39:49,650 --> 00:39:50,250
[يَقُولُ]، [قِيلَ]،

479
00:39:49,650 --> 00:39:50,250
فَالْيَاءُ وَالْأَلِفُ وَالْوَاوُ جَاءَ بَعْدَهَا لَامٌ مُتَحَرِّكَةٌ فَهُنَا تُمَدُّ مَدًّا

480
00:39:49,650 --> 00:39:50,250
طَبِيعِيًّا؛ بَعْدَ ذَلِكَ نَنْظُرُ

481
00:40:02,250 --> 00:40:03,450
فِي الْأَبْيَاتِ،

482
00:40:02,850 --> 00:40:03,450
يَقُولُ النَّاظِمُ: [وَالْمَدُّ أَصْلِيٌّ وَفَرْعِيٌّ لَهُ وَسَمِّ أَوَّلًا طَبِيعِيًّا]،

483
00:40:02,850 --> 00:40:03,450
وَهُوَ الْأَصْلِيُّ هُوَ الطَّبِيعِيُّ،

484
00:40:02,850 --> 00:40:03,450
[وَهُوَ مَا لَا تَوَقُّفٌ لَهُ

485
00:40:29,112 --> 00:40:30,017
عَلَى سَبَبْ وَلَا بِدُونِهِ الْحُرُوفُ تُجْتَلَبْ]،

486
00:40:35,898 --> 00:40:37,255
وَهُوَ أَنْ تَأْتِيَ وَلَا يَأْتِيَ بَعْدَهَا لَا هَمْزٌ وَلَا سُكُونٌ،

487
00:40:44,493 --> 00:40:45,398
هَذَا هُوَ

488
00:40:49,924 --> 00:40:51,554
الْمَدُّ الْأَصْلِيُّ أَوِ

489
00:41:14,350 --> 00:41:15,400
الْمَدُّ الطَّبِيعِيُّ،

490
00:41:14,850 --> 00:41:15,400
وَلَا يُمْكِنُ

491
00:41:25,300 --> 00:41:34,650
أَنْ نَنْطِقَ الْأَلِفَ وَالْوَاوَ وَالْيَاءَ إِلَّا بِهَذَا الْمَدِّ،

492
00:41:56,431 --> 00:41:57,527
لَا يُمْكِنُ أَنْ تَقُولَ: [مَالِكِ] إِلَّا بِأَنْ تَأْتِيَ،

493
00:41:56,979 --> 00:41:57,527
لَوْ أَذْهَبْتَ الْحَرْفَ تَقُولُ: [الْمَلِكِ]،

494
00:41:56,979 --> 00:41:57,527
بَعْدَ ذَلِكَ لَوْ أَذْهَبْتَ الْحَرْفَ هَذَا

495
00:42:23,840 --> 00:42:24,840
الْمَدُّ الطَّبِيعِيُّ يَذْهَبُ الْحَرْفُ كَامِلًا؛ قَالَ: [وَهُوَ

496
00:42:44,769 --> 00:42:46,463
مَا لَا تَوَقُّفٌ لَهُ عَلَى سَبَبْ وَلَا بِدُونِهِ

497
00:43:12,310 --> 00:43:13,643
الْحُرُوفُ تُجْتَلَبْ]،

498
00:43:12,977 --> 00:43:13,643
لَا يُمْكِنُ

499
00:43:29,925 --> 00:43:31,464
أَنْ تُجْتَلَبَ الْحَرْفُ بِدُونِ هَذَا الْمَدِّ،

500
00:43:30,695 --> 00:43:31,464
[بَلْ أَيُّ حَرْفٍ غَيْرِ هَمْزٍ أَوْ سُكُونْ جَاءَ بَعْدَ مَدٍّ

501
00:43:30,695 --> 00:43:31,464
فَالطَّبِيعِيَّ يَكُونْ]،

502
00:43:30,695 --> 00:43:31,464
وَسُمِّيَ هَذَا الْمَدُّ طَبِيعِيًّا لِأَنَّ صَاحِبَ الطَّبِيعَةِ السَّلِيمَةِ

503
00:43:51,643 --> 00:43:53,310
لَا يَنْقُصُهُ وَلَا يَزِيدُهُ

504
00:44:05,185 --> 00:44:05,935
عَلَى حَرَكَتَيْنِ؛

505
00:44:15,310 --> 00:44:15,866
ثُمَّ

506
00:44:19,199 --> 00:44:20,310
قَالَ: اعْلَمْ

507
00:44:23,088 --> 00:44:26,421
أَنَّ الْمَدَّ -يَشْرَحُ هَذِهِ الْأَبْيَاتَ- اسْمَانِ:

508
00:44:27,532 --> 00:44:28,643
أَصْلِيٌّ: وَهُوَ الطَّبِيعِيُّ،

509
00:44:37,310 --> 00:44:38,251
قَالَ: [وَأَكْثَرُ مَا يَكُونُ الْخِلَافُ فِيهِ]،

510
00:44:37,781 --> 00:44:38,251
وَهَذَا سَبَقَ تَصْوِيبُ الْعِبَارَةِ،

511
00:44:37,781 --> 00:44:38,251
صَوَابُ الْعِبَارَةِ: وَأَقَلُّ مَا يَكُونُ الْخِلَافُ فِيهِ،

512
00:45:07,579 --> 00:45:09,195
الْمَدُّ الطَّبِيعِيُّ لَا خِلَافَ فِيهِ بَيْنَ الْقُرَّاءِ،

513
00:45:08,387 --> 00:45:09,195
لَا يُمْكِنُ

514
00:45:22,741 --> 00:45:24,173
أَنْ يَنْطِقَهُ تَنْطِقَ

515
00:45:33,477 --> 00:45:34,909
الْكَلِمَةَ بِدُونِ

516
00:46:01,265 --> 00:46:03,618
أَنْ تَأْتِيَ بِهَذَا الْمَدِّ،

517
00:46:03,618 --> 00:46:04,206
فَأَيُّ شَخْصٍ يُحْسِنُ الْعَرَبِيَّةَ سَيَنْطِقُ بِهَذَا الْمَدِّ؛ وَالْآخَرُ الْفَرْعِيُّ: الْفَرْعِيُّ

518
00:46:03,618 --> 00:46:04,206
مَا هُوَ؟

519
00:46:03,618 --> 00:46:04,795
أَنْ تَأْتِيَ الْأَلِفُ وَالْوَاوُ وَالْيَاءُ وَيَأْتِيَ بَعْدَهَا إِمَّا هَمْزًا

520
00:46:06,559 --> 00:46:07,736
أَوْ سُكُونًا،

521
00:46:07,148 --> 00:46:07,736
قَالَ: [وَالْآخَرُ الْفَرْعِيُّ مَوْقُوفٌ

522
00:46:10,677 --> 00:46:11,854
عَلَى سَبَبْ كَهَمْزٍ أَوْ سُكُونٍ مُسْجَلَا]،

523
00:46:11,265 --> 00:46:11,854
وَسَيَأْتِي تَفْصِيلٌ

524
00:46:19,905 --> 00:46:21,155
فِي الْبَابِ الَّذِي يَلِيهِ،

525
00:46:20,530 --> 00:46:21,155
إِذَا جَاءَ

526
00:46:43,830 --> 00:46:44,697
حُرُوفُ

527
00:46:49,030 --> 00:46:50,030
الْمَدِّ وَبَعْدَهُ لَازِمٌ عِنْدَنَا

528
00:47:08,218 --> 00:47:09,343
مَدٌّ عَارِضٌ لِلسُّكُونِ.

529
00:47:08,780 --> 00:47:09,343
ذَكَرَ حُرُوفَ الْمَدِّ،

530
00:47:08,780 --> 00:47:12,155
قَالَ: [حُرُوفُهُ ثَلَاثَةٌ

531
00:47:12,155 --> 00:47:12,718
فَعِيهَا]؛ أَيْ: فَافْهَمْهَا،

532
00:47:15,530 --> 00:47:16,655
[مِنْ لَفْظِ وَايٍ]؛ أَيْ: تَجْمَعُ

533
00:47:25,589 --> 00:47:26,418
فِي كَلِمَةِ (وَايٍ)،

534
00:47:26,003 --> 00:47:28,906
وَهِيَ فِي ﴿نُوحِيهَا﴾،

535
00:47:28,491 --> 00:47:28,906
ذَكَرَ كَلِمَةً جَمَعَتْ حُرُوفَ الْمَدِّ مَعَ شُرُوطِهَا ﴿نُوحِيهَا﴾؛ الْوَاوُ سَاكِنَةٌ

536
00:47:28,491 --> 00:47:28,906
وَقَبْلَهَا ضَمٌّ،

537
00:47:28,491 --> 00:47:28,906
وَالْيَاءُ سَاكِنَةٌ وَقَبْلَهَا كَسْرُ الْحَاءِ،

538
00:47:28,491 --> 00:47:28,906
وَكَذَلِكَ مَجْمُوعَةٌ

539
00:47:31,809 --> 00:47:32,638
فِي كَلِمَةِ ﴿أُوذِينَا﴾

540
00:47:35,126 --> 00:47:35,955
وَ ﴿أُوتِينَا﴾،

541
00:47:35,541 --> 00:47:35,955
ثَلَاثُ كَلِمَاتٍ

542
00:47:39,495 --> 00:47:41,057
فِي الْقُرْآنِ لَا رَابِعَ لَهَا جَمَعَتْ حُرُوفَ الْمَدِّ مَعَ شُرُوطِهَا:

543
00:47:40,276 --> 00:47:41,057
﴿نُوحِيهَا﴾

544
00:47:55,022 --> 00:47:55,999
وَ ﴿أُوذِينَا﴾ وَ ﴿أُوتِينَا﴾؛

545
00:48:12,329 --> 00:48:13,448
قَالَ: [وَاللِّينُ مِنْهَا الْيَاءُ وَوَاوٌ سُكِّنَا * إِنِ انْفِتَاحٌ قَبْلَ

546
00:48:12,889 --> 00:48:13,448
كُلٍّ أُعْلِنَا]،

547
00:48:12,889 --> 00:48:14,568
ثُمَّ بَيَّنَ الشَّارِحُ رَحِمَهُ اللَّهُ أَنَّ

548
00:48:19,605 --> 00:48:20,724
حُرُوفَ الْمَدِّ عَلَى ثَلَاثَةِ أَقْسَامٍ؛ الْقِسْمُ الْأَوَّلُ: أَنَّ الْأَلِفَ وَالْوَاوَ

549
00:48:20,164 --> 00:48:20,724
وَالْيَاءَ تَأْتِي عَلَى ثَلَاثَةِ أَقْسَامٍ؛ الْقِسْمُ الْأَوَّلُ: أَنْ تَكُونَ

550
00:48:30,798 --> 00:48:31,917
حُرُوفَ مَدٍّ،

551
00:48:31,357 --> 00:48:31,917
وَهِيَ أَنْ تَسْكُنَ وَيُجَانِسَ الْحَرَكَةُ مَا قَبْلَهَا،

552
00:48:31,357 --> 00:48:31,917
أَوْ تَكُونَ الْحَرَكَةُ مُجَانِسَةً لِلْحَرْفِ مِثْلَ هَذَا؛ أَيْ: أَنْ تَسْكُنَ

553
00:48:31,357 --> 00:48:31,917
الْوَاوُ يَكُونُ قَبْلَهَا ضَمٌّ،

554
00:48:31,357 --> 00:48:31,917
تَسْكُنَ الْيَاءُ يَكُونُ قَبْلَهَا كَسْرٌ،

555
00:48:31,357 --> 00:48:31,917
تَسْكُنَ الْأَلِفُ وَيَكُونُ قَبْلَهَا فَتْحٌ،

556
00:48:31,357 --> 00:48:31,917
وَهِيَ دَائِمًا كَذَلِكَ؛ الْأَلِفُ دَائِمًا كَذَلِكَ سَاكِنَةٌ وَقَبْلَهَا فَتْحٌ.

557
00:48:31,357 --> 00:48:31,917
الْحَالُ الثَّانِيَةُ: أَنْ تَكُونَ هَذِهِ الْأَحْرُفُ الثَّلَاثَةُ حَرْفَ لِينٍ؛ مَتَى؟

558
00:48:31,357 --> 00:48:31,917
إِذَا سَكَنَتْ وَانْفَتَحَ مَا قَبْلَهَا،

559
00:48:31,357 --> 00:48:31,917
إِذَا سَكَنَتِ الْوَاوُ وَانْفَتَحَ مَا قَبْلَهَا فَهِيَ حَرْفُ لِينٍ مِثْلَ:

560
00:48:31,357 --> 00:48:31,917
﴿خَوْفٍ﴾، إِذَا سَكَنَتِ الْيَاءُ وَانْفَتَحَ مَا قَبْلَهَا فَهِيَ حَرْفُ لِينٍ

561
00:48:31,357 --> 00:48:31,917
مِثْلَ: ﴿بَيْتٍ﴾،

562
00:48:31,357 --> 00:48:31,917
إِذَا سَكَنَتِ الْأَلِفُ وَانْفَتَحَ مَا قَبْلَهَا فَهِيَ حَرْفُ لِينٍ،

563
00:48:31,357 --> 00:48:31,917
وَهِيَ كَذَلِكَ الْأَلِفُ دَائِمًا تَكُونُ حَرْفَ لِينٍ وَحَرْفَ مَدٍّ،

564
00:48:31,357 --> 00:48:31,917
لَكِنَّ الْوَاوَ وَالْيَاءَ هِيَ الَّتِي لَهَا حَالَانِ؛ إِمَّا أَنْ تَكُونَ

565
00:48:31,357 --> 00:48:31,917
حَرْفَ مَدٍّ إِذَا تَجَانَسَتِ الْحَرَكَةُ مَعَهَا،

566
00:48:31,357 --> 00:48:31,917
أَوْ تَكُونَ حَرْفَ لِينٍ إِذَا سَكَنَتَا وَفُتِحَ مَا قَبْلَهُمَا.

567
00:48:31,357 --> 00:48:31,917
الْحَالُ الثَّالِثَةُ: أَنْ تَتَحَرَّكَ الْوَاوُ وَالْيَاءُ،

568
00:48:31,357 --> 00:48:31,917
وَهُنَا يَكُونُ حَرْفَ عِلَّةٍ؛ لِمَاذَا يَكُونُ حَرْفَ عِلَّةٍ؟

569
00:48:31,357 --> 00:48:31,917
لِأَنَّهُ يَكُونُ قَدِ انْقَلَبَ

570
00:48:38,073 --> 00:48:39,193
مِنْ حَرْفٍ آخَرَ،

571
00:48:38,633 --> 00:48:39,193
(السَّمَاوِيُّ) الْوَاوُ مَفْتُوحَةٌ هُنَا،

572
00:48:38,633 --> 00:48:39,193
إِذًا هَذِهِ الْوَاوُ مُنْقَلِبَةٌ مَثَلًا أَصْلُهَا (السَّمَاوِيُّ)،

573
00:48:38,633 --> 00:48:39,193
فَإِذَا تَحَرَّكَتِ الْأَلِفُ وَالْيَاءُ فَهُمَا حَرْفَا عِلَّةٍ،

574
00:48:38,633 --> 00:48:39,193
وَالْمُرَادُ عِنْدَنَا هُنَا حَرْفُ الْمَدِّ يُمَدُّ فِي أَحْوَالٍ كَمَا سَيَتْبَعُونَ،

575
00:48:38,633 --> 00:48:39,193
وَحَرْفُ اللَّينِ يُمَدُّ كَذَلِكَ كَمَا سَيَأْتِي بَيَانُهُ بِالتَّفْصِيلِ،

576
00:48:38,633 --> 00:48:41,991
أَمَّا حَرْفُ الْعِلَّةِ فَلَا مَبْحَثَ لَهُ عِنْدَنَا فِي التَّجْوِيدِ مِنْ

577
00:48:41,991 --> 00:49:07,753
نَاحِيَةِ الْمَدِّ،

578
00:49:07,753 --> 00:49:26,565
لَا، يَبْقَى كَمَا هُوَ لَا يُمَدُّ،

579
00:49:26,565 --> 00:49:26,986
وَقَوْلُ الْمُصَنِّفِ رَحِمَهُ اللَّهُ فَعُلِمَ أَنَّ الْيَاءَ وَالْوَاوَ لَهُمَا ثَلَاثَةُ

580
00:49:26,565 --> 00:49:33,920
أَحْوَالٍ: مَدٌّ،

581
00:49:33,920 --> 00:49:34,358
وَهَذَا إِذَا سَكَنَ وَتَجَانَسَتِ الْحَرَكَةُ،

582
00:49:33,920 --> 00:49:34,358
أَوْ لِينٌ إِذَا سَكَنَ وَانْفَتَحَ مَا قَبْلَهُمَا،

583
00:49:54,470 --> 00:49:55,870
وَلَا قَوْلُهُ (وَلَا)؛ أَيْ:

584
00:50:12,397 --> 00:50:13,306
لَا مَدَّ وَلَا لِينَ،

585
00:50:12,852 --> 00:50:13,306
وَإِنَّمَا إِنْ تَحَرَّكَتَا أَيْ يَكُونُ حَرْفَ عِلَّةٍ،

586
00:50:12,852 --> 00:50:13,306
نَعَمْ. أَحْكَامُ

587
00:50:38,170 --> 00:50:39,170
الْمَدِّ لِلْمَدِّ أَحْكَامٌ ثَلَاثَةٌ تَدُومُ ...

588
00:50:38,670 --> 00:50:39,170
وَهِيَ الْوُجُوبُ وَالْجَوَازُ وَاللُّزُومُ فَوَاجِبٌ إِنْ جَاءَ هَمْزٌ بَعْدَ مَدٍّ

589
00:50:38,670 --> 00:50:39,170
...

590
00:50:47,614 --> 00:50:48,748
فِي كَلِمَةٍ وَذَا بِمُتَّصِلٍ يُعَدّْ عُلِمَ أَنَّ الْمَدَّ مَعَ الْهَمْزَةِ

591
00:50:48,181 --> 00:50:48,748
مُنْقَسِمٌ عَلَى

592
00:51:12,108 --> 00:51:14,650
ثَلَاثَةِ أَقْسَامٍ؛ الْأَوَّلُ: أَنْ يَتَقَدَّمَ حَرْفُ الْمَدِّ وَاللِّينِ وَتَأْتِيَ الْهَمْزَةُ

593
00:51:14,142 --> 00:51:14,650
بَعْدَهُ فِي الْكَلِمَةِ الَّتِي هُوَ فِيهَا،

594
00:51:14,142 --> 00:51:14,650
نَحْوَ:

595
00:51:33,972 --> 00:51:34,989
﴿جَاءَ﴾ وَ ﴿شَاءَ﴾ وَ ﴿السُّوءِ﴾ وَ ﴿سِيئَتْ﴾،

596
00:51:52,485 --> 00:51:53,555
فَهَذَا يَجِبُ شَرْعًا مَدُّهُ،

597
00:51:53,020 --> 00:51:53,555
وَيُقَالُ لَهُ:

598
00:52:08,806 --> 00:52:09,838
مَدٌّ مُتَّصِلٌ؛ لِاتِّصَالِ الْهَمْزَةِ بِحَرْفِ الْمَدِّ

599
00:52:19,012 --> 00:52:19,967
فِي تِلْكَ الْكَلِمَةِ،

600
00:52:19,489 --> 00:52:19,967
وَلَهُ مَحَلُّ اتِّفَاقٍ،

601
00:52:42,990 --> 00:52:43,990
وَهُوَ اتِّفَاقُ الْقُرَّاءِ عَلَى اعْتِبَارِ أَثَرِ الْهَمْزَةِ

602
00:52:51,990 --> 00:52:58,814
مِنْ زِيَادَةِ الْمَدِّ،

603
00:52:58,814 --> 00:52:59,343
وَمَحَلُّ اخْتِلَافٍ،

604
00:53:18,723 --> 00:53:19,790
وَهُوَ تَفَاوُتُهُمْ

605
00:53:29,390 --> 00:53:30,457
فِي الزِّيَادَةِ،

606
00:53:29,923 --> 00:53:30,457
فَالْمَدُّ

607
00:53:34,133 --> 00:53:34,990
فِيهِ عِنْدَ أَبِي عَمْرٍو قَالَهُ،

608
00:53:34,561 --> 00:53:34,990
وَعِنْدَ ابْنِ كَثِيرٍ مِقْدَارُ أَلِفٍ وَنِصْفٍ وَقِيلَ وَرُبُعٍ،

609
00:53:34,561 --> 00:53:34,990
وَعِنْدَ ابْنِ عَامِرٍ وَالْكِسَائِيِّ مِقْدَارُ أَلِفَيْنِ،

610
00:53:34,561 --> 00:53:34,990
وَعِنْدَ عَاصِمٍ مِقْدَارُ أَلِفَيْنِ وَنِصْفٍ،

611
00:53:34,561 --> 00:53:34,990
وَعِنْدَ وَرْشٍ وَحَمْزَةَ مِقْدَارُ ثَلَاثِ أَلِفَاتٍ،

612
00:53:34,561 --> 00:53:34,990
وَ (مُتَّصِلٌ)

613
00:53:50,298 --> 00:53:50,913
فِي

614
00:54:16,720 --> 00:54:17,903
النَّظْمِ بِسُكُونِ اللَّامِ لِلضَّرُورَةِ،

615
00:54:17,312 --> 00:54:17,903
وَ (يُعَدُّ) بِالْمُثَنَّاةِ تَحْتُ مَضْمُومَةً.

616
00:54:17,312 --> 00:54:17,903
وَجَائِزٌ مَدٌّ وَقَصْرٌ إِنْ فُصِلْ ...

617
00:54:17,312 --> 00:54:17,903
كُلٌّ بِكَلِمَةٍ وَهَذَا الْمُنْفَصِلْ الثَّانِيَةُ: يَكُونُ حَرْفُ الْمَدِّ آخِرَ كَلِمَةٍ

618
00:54:17,312 --> 00:54:17,903
وَالْهَمْزَةُ أَوَّلَ كَلِمَةٍ أُخْرَى،

619
00:54:17,312 --> 00:54:17,903
وَهَذَا يَجُوزُ مَدُّهُ وَقَصْرُهُ،

620
00:54:17,312 --> 00:54:17,903
وَيُسَمَّى مَدًّا مُنْفَصِلًا؛ لِانْفِصَالِ كُلٍّ

621
00:54:40,094 --> 00:54:40,997
مِنَ الْمَدِّ وَالْهَمْزَةِ

622
00:55:00,653 --> 00:55:01,320
فِي كَلِمَةٍ،

623
00:55:00,987 --> 00:55:01,320
نَحْوَ: ﴿بِمَا أَنْزَلَ﴾ وَ ﴿فِي أُمِّهَا﴾ وَ ﴿قُوا أَنْفُسَكُمْ﴾،

624
00:55:00,987 --> 00:55:01,320
وَفِيهِ خِلَافٌ؛ فَوَرْشٌ وَابْنُ عَامِرٍ وَعَاصِمٌ وَحَمْزَةُ وَالْكِسَائِيُّ يُثْبِتُونَهُ

625
00:55:19,138 --> 00:55:20,360
بِلَا خِلَافٍ،

626
00:55:19,749 --> 00:55:20,360
وَابْنُ كَثِيرٍ وَالسُّوسِيُّ يَنْفِيَانِهِ بِلَا خِلَافٍ،

627
00:55:19,749 --> 00:55:20,360
وَقَالُونُ وَالدُّورِيُّ يُثْبِتَانِهِ وَيَنْفِيَانِهِ،

628
00:55:19,749 --> 00:55:20,360
وَتَفَاوُتُ الْمَدَّيْنِ

629
00:55:33,112 --> 00:55:34,264
فِي الزِّيَادَةِ كَتَفَاوُتِهِمْ فِيهَا فِيمَا مَرَّ فِي الْمَدِّ الْمُتَّصِلِ.

630
00:55:33,688 --> 00:55:34,264
وَمِثْلُ ذَا

631
00:55:41,854 --> 00:55:43,108
إِنْ عَرَضَ السُّكُونُ ...

632
00:55:42,481 --> 00:55:43,108
وَقْفًا كَتَعْلَمُونَ نَسْتَعِينُ وَمِثْلُ الْمَدِّ الْمُتَّصِلِ

633
00:56:13,280 --> 00:56:15,173
فِي جَوَازِ الْمَدِّ وَالْقَصْرِ وَالتَّوَسُّطِ عَرَضَ السُّكُونُ لِأَجْلِ الْوَقْفِ وَالْإِدْغَامِ،

634
00:56:14,227 --> 00:56:15,173
وَصُورَتُهُ هِيَ: يَكُونُ

635
00:56:30,788 --> 00:56:31,845
آخِرُ الْكَلِمَةِ مُتَحَرِّكًا وَقَبْلَهَا

636
00:56:46,637 --> 00:56:47,694
هُوَ حَرْفُ مَدٍّ وَلِينٍ،

637
00:56:47,166 --> 00:56:47,694
وَذَلِكَ كَـ ﴿تَعْلَمُونَ﴾ وَ ﴿نَسْتَعِينُ﴾ وَ ﴿الْمَآبِ﴾،

638
00:56:47,166 --> 00:56:47,694
وَكَيْ يَقُولَ رَبُّنَا

639
00:57:07,669 --> 00:57:08,715
فِي قِرَاءَةِ أَبِي عَمْرٍو

640
00:57:12,573 --> 00:57:13,698
مِنْ رِوَايَةِ السُّوسِيِّ،

641
00:57:13,135 --> 00:57:13,698
وَكَمَا ذَكَرَ أَنَّ فِيهَا أَوْجُهًا ثَلَاثَةً عِنْدَ كُلِّ الْقُرَّاءِ: الطُّولُ

642
00:57:13,135 --> 00:57:13,698
وَالتَّوَسُّطُ وَالْقَصْرُ،

643
00:57:13,135 --> 00:57:13,698
وَوَجْهُ كُلٍّ مَذْكُورٌ فِي الْأَصْلِ.

644
00:57:31,590 --> 00:57:32,866
أَوْ قُدِّمَ الْهَمْزُ عَلَى الْمَدِّ وَذَا ...

645
00:57:32,228 --> 00:57:32,866
بَدَلْ كَآمَنُوا وَإِيمَانًا خُذَا الثَّالِثُ: أَنْ يَجْتَمِعَ الْمَدُّ مَعَ الْهَمْزِ

646
00:57:32,228 --> 00:57:32,866
فِي كَلِمَةٍ لَكِنْ يَتَقَدَّمُ الْهَمْزُ عَلَى الْمَدِّ فِيهَا،

647
00:57:32,228 --> 00:57:32,866
سَوَاءٌ كَانَ الْمَدُّ ثَابِتًا مُحَقَّقًا أَوْ مُغَيَّرًا لِلْبَدَلِ أَوِ التَّسْهِيلِ

648
00:57:32,228 --> 00:57:32,866
أَوِ الْحَذْفِ بَعْدَ النَّقْلِ،

649
00:57:32,228 --> 00:57:32,866
فَحُكْمُهُ الْقَصْرُ عِنْدَ كُلِّ الْقُرَّاءِ غَيْرَ وَرْشٍ،

650
00:57:32,228 --> 00:57:32,866
وَلِوَرْشٍ

651
00:57:42,441 --> 00:57:43,717
فِيهِ الْمَدُّ وَالتَّوَسُّطُ وَالْقَصْرُ،

652
00:57:43,079 --> 00:57:43,717
فَلْنَعْمَدْ بَدَلًا،

653
00:57:43,079 --> 00:57:43,717
وَذَلِكَ كَـ ﴿آمَنُوا﴾ وَ ﴿إِيمَانًا﴾ وَ ﴿أُوتُوا﴾ وَ ﴿هَؤُلَاءِ آلِهَةً﴾

654
00:57:43,079 --> 00:57:43,717
عَلَى قِرَاءَةِ الْبَدَلِ،

655
00:57:43,079 --> 00:57:43,717
وَلِلْإِيمَانِ بِالنَّقْلِ،

656
00:57:43,079 --> 00:57:43,717
وَ ﴿جَاءَ آلَ لُوطٍ﴾ بِالتَّسْهِيلِ عَلَى وَجْهٍ،

657
00:57:43,079 --> 00:57:43,717
وَ (بَدَلٌ) فِي النَّظْمِ بِالسُّكُونِ لِأَجْلِ الضَّرُورَةِ.

658
00:57:43,079 --> 00:57:43,717
وَلَازِمٌ إِنِ السُّكُونُ أُصِّلَا ...

659
00:57:43,079 --> 00:57:43,717
وَصْلًا وَوَقْفًا بَعْدَ مَدٍّ طُوِّلَا الْمَدُّ الثَّالِثُ إِذَا كَانَ السُّكُونُ

660
00:57:43,079 --> 00:57:43,717
أَصْلِيًّا فِي الْوَصْلِ وَالْوَقْفِ بَعْدَ حَرْفِ الْمَدِّ،

661
00:57:43,079 --> 00:57:43,717
يُمَدُّ لِكُلِّ الْقُرَّاءِ مَدًّا لَازِمًا بِقَدْرِ أَلِفَيْنِ عَلَى الْمَدِّ الطَّبِيعِيِّ

662
00:57:43,079 --> 00:57:43,717
عِنْدَ كُلِّ الْقُرَّاءِ،

663
00:57:43,079 --> 00:57:43,717
فَهُوَ بِهَا ثَلَاثُ أَلِفَاتٍ بِسِتِّ حَرَكَاتٍ،

664
00:57:43,079 --> 00:57:43,717
وَذَلِكَ نَحْوَ: ﴿الصَّاخَّةُ﴾ وَ ﴿الطَّامَّةُ﴾ وَ ﴿الضَّالِّينَ﴾ وَ ﴿أَتُحَاجُّونِّي﴾،

665
00:57:43,079 --> 00:57:43,717
وَوَجْهُ مَا ذُكِرَ مَذْكُورٌ فِي الْأَصْلِ مَعَ وَجْهِ التَّسْمِيَةِ،

666
00:57:43,079 --> 00:57:43,717
ثُمَّ ذَكَرَ الْمُصَنِّفُ رَحِمَهُ اللَّهُ أَحْكَامَ الْمَدِّ مَعَ الْهَمْزِ وَبِدُونِهِ،

667
00:57:43,079 --> 00:57:43,717
فَقَالَ رَحِمَهُ اللَّهُ: [لِلْمَدِّ أَحْكَامٌ ثَلَاثَةٌ تَدُورُ * وَهِيَ الْوُجُوبُ

668
00:57:43,079 --> 00:57:43,717
وَالْجَوَازُ وَاللُّزُومُ * فَوَاجِبٌ إِنْ جَاءَ هَمْزٌ بَعْدَ مَدٍّ *

669
00:57:43,079 --> 00:58:07,070
فِي كَلِمَةٍ وَذَا بِمُتَّصِلٍ يُعَدُّ]،

670
00:58:07,070 --> 00:58:07,588
مُمْكِنٌ

671
00:58:15,195 --> 00:58:16,412
أَنْ يُقَسَّمَ الْمَدُّ بِسَبَبِ الْهَمْزِ وَبِسَبَبِ السُّكُونِ،

672
00:58:15,803 --> 00:58:16,412
فَإِذَا كَانَ إِذَا جَاءَتْ أَحْرُفُ الْمَدِّ (الْأَلِفُ،

673
00:58:15,803 --> 00:58:16,412
الْوَاوُ، الْيَاءُ)

674
00:58:33,456 --> 00:58:34,673
بَعْدَ هَمْزَةٍ عِنْدَنَا ثَلَاثَةُ أَنْوَاعٍ

675
00:58:49,515 --> 00:58:50,609
مِنَ الْمُدُودِ؛ الْمَدُّ الْأَوَّلُ: الْمُتَّصِلُ،

676
00:58:50,062 --> 00:58:50,609
وَهُوَ

677
00:58:54,439 --> 00:58:57,175
أَنْ يَأْتِيَ حَرْفُ الْمَدِّ وَالْهَمْزُ فِي كَلِمَةٍ مِثْلَ: ﴿السَّمَاءُ﴾،

678
00:58:56,628 --> 00:58:57,175
﴿مَاءٌ﴾، ﴿الْمَلَائِكَةُ﴾،

679
00:58:56,628 --> 00:58:57,175
