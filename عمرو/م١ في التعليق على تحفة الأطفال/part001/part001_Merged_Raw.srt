وَفَى أَنْ تَغْتَفِي لِقُرْبِهَا وَلِاتْتِحَادِ

192
00:10:05,605 --> 00:10:08,730
فَعْرِفِي حُكْمُ لَامِعَ الْوَلَامِ الْفِعْلِ لِلَامِعَ الْحَلَامِ

193
00:10:08,730 --> 00:10:12,230
قَبْلَ الْأَحْرُفِي وَلَا وَمَا يَظْهَرُهَا فَلْتَعْرِفِي قَبْلَ أَرْبَعِمَا

194
00:10:12,230 --> 00:10:15,730
عَشْرَةٍ خُذْ عِلْمَهُ مِنْ إبْغِي حَجَّكَ وَخَفْعَ

195
00:10:15,730 --> 00:10:19,230
قِيمَهُ ثَانِيهِمَا إِضْغَامُهَا فِي أَرْبَعِي وَعَشْرَةٍ أَيْضًا

196
00:10:19,230 --> 00:10:22,452
وَرَمْزَهَا فَعِيطِبْ ثُمَّ صِرُّحْمًا تَفُزِّفْ ذَانِي عَمْدَعْ

197
00:10:22,452 --> 00:10:25,730
سُوَاظًا نِزُورَ شَرِيفًا لِلْكَرَمِ وَاللَّامَ الْأُولَى سَمْيَاهَا

198
00:10:25,730 --> 00:10:29,119
قَمْرِيَّهُ وَاللَّامَ الْأُخْرَى سَمْيَاهَا شَمْسِيَّهُ وَأَظْهِرَ النَّرَامَ

199
00:10:29,119 --> 00:10:32,230
فِعْرٍ مُطْلَقَى فِي نَحْوِقُ النَّامَ وَقُلْنَا وَالْتَقَى

200
00:10:32,230 --> 00:10:35,230
فِي الْمِثْلَيْنِ وَالْمُتَقَارِبَيْنِ وَالْمُتَجَانِسَيْنِ

201
00:10:35,230 --> 00:10:38,480
والمخارج اتفق حرفان فالمثلان فيهما احق

202
00:10:38,480 --> 00:10:41,730
وان يكون مخرجا تقاربا وفي الصفات

203
00:10:41,730 --> 00:10:44,980
اختلفا يلقب مقارب متقاربين او يكون

204
00:10:44,980 --> 00:10:48,230
اتفقا في مخرج دون الصفات حققا

205
00:10:48,230 --> 00:10:51,430
بالمتجان سينيثو مقاربين او

206
00:10:51,430 --> 00:10:54,430
يكون متقاربين في نسخه النظم

207
00:10:54,430 --> 00:10:57,430
وشيخ الضبع مقاربين ولا لا

208
00:10:57,430 --> 00:11:00,430
هي او لا مقاربين او

209
00:11:00,430 --> 00:11:03,633
يكون اتفقا نعم حسن الله اليكم

210
00:11:03,633 --> 00:11:06,907
قال مقاربين او يكون اتفقا في مخرج

211
00:11:06,907 --> 00:11:10,182
دون الصفات حققا بالمتجان سينيثو ثم انسكن

212
00:11:10,182 --> 00:11:13,456
اول كل فالصغير سميا او حرك الحرفان

213
00:11:13,456 --> 00:11:16,730
في كل فقل كل كبير وفهمنه بالمثل

214
00:11:16,730 --> 00:11:20,004
اقسام المد المد اصلي وفرعي له وسمي

215
00:11:20,004 --> 00:11:23,278
اولا طبيعيا وهما لا توقف له على

216
00:11:23,278 --> 00:11:26,553
سبب ولا بدونه الحروف تجتلب بل اي

217
00:11:26,553 --> 00:11:29,827
حرف غير همز او سكون جاء بعد

218
00:11:29,827 --> 00:11:33,149
مد فالطبيعية يكون والاخر الفرعي موقوف

219
00:11:33,149 --> 00:11:36,365
على سبب كمز او سكون مسجلة حروفه

220
00:11:36,365 --> 00:11:39,581
ثلاثة فعيها من لفظ واي وهي في

221
00:11:39,581 --> 00:11:42,798
نوحيها والكسر قبل اليا وقبل الواضي طمشرط

222
00:11:42,798 --> 00:11:46,014
وفتح قبل الف يلتزم والليل من اليا

223
00:11:46,014 --> 00:11:49,230
وواو سكنا ان انفتاح قبل كل اعلنا

224
00:11:49,230 --> 00:11:52,430
يجوز سكنا و سكنا

225
00:11:52,430 --> 00:11:55,630
لكن التخفيف دائم عندنا

226
00:11:55,630 --> 00:11:58,830
في اللغه العربيه التخفيف

227
00:11:58,830 --> 00:12:01,980
اولى من التثقيل هذه

228
00:12:01,980 --> 00:12:04,980
قواعد في اللغه العربيه

229
00:12:04,980 --> 00:12:07,980
ولا هذا الموضع يجوز

230
00:12:07,980 --> 00:12:11,326
سكنا وسكنا نعم حسن الله

231
00:12:11,326 --> 00:12:14,614
اليكم قال النظم رحمه الله احكام

232
00:12:14,614 --> 00:12:17,901
المد للمد احكام ثلاثه تدوم وهي

233
00:12:17,901 --> 00:12:21,189
الوجوب والجواز واللزوم فواجب ان جاء

234
00:12:21,189 --> 00:12:24,477
همز بعد مد في كلمه وذا

235
00:12:24,477 --> 00:12:27,764
بمتصل يعد والجائز مد وقصر انفصل

236
00:12:27,764 --> 00:12:31,052
كل بكلمه وهذا المنفصل ومثل ذاء

237
00:12:31,052 --> 00:12:34,471
عرضه وذا إن عرضت السكون وقفا

238
00:12:34,471 --> 00:12:37,600
كتعلمون نستعين أو قدم الهمز على المد

239
00:12:37,600 --> 00:12:41,027
وذا بدلك آمن وإيمان خذا ولازم إن السكون

240
00:12:41,027 --> 00:12:44,520
أصلى وصلا ووقفا بعد مد طولا أقسام

241
00:12:44,520 --> 00:12:47,850
المد اللازم أقسام لازم لديهم أربعة

242
00:12:47,850 --> 00:12:51,187
وتلك كلمي وحرفي معا كلاهما مخفف

243
00:12:51,187 --> 00:12:54,492
مثقل فهذه أربعة تفصل فإن بكلمة

244
00:12:54,492 --> 00:12:57,614
سكون يجتمع مع حرف مد فهو كلمي

245
00:12:57,614 --> 00:13:00,793
وقع أو في ثلاثي الحروف وجدا

246
00:13:00,793 --> 00:13:04,202
والمد وسطه فحرفي بدا كلاهما مثقل

247
00:13:04,202 --> 00:13:07,258
إن أدغما مخفف كل إذا

248
00:13:07,258 --> 00:13:10,258
لم يدغما واللازم الحرفي أول

249
00:13:10,258 --> 00:13:13,670
السور وجوده وفي ثمانين حصر يجمعها

250
00:13:13,670 --> 00:13:16,820
حروف كم عسل نقص وعين ذو وجعين

251
00:13:16,820 --> 00:13:19,950
والطول أخص وما سوى الحرف الثلاث لا

252
00:13:19,950 --> 00:13:23,336
ألف فمده مدا طبيعيا ألف وذلك أيضا في

253
00:13:23,336 --> 00:13:26,420
فواتح السور في لفت حي طاهر قد انحصر

254
00:13:26,420 --> 00:13:29,573
ويجمع الفواتح ويجمع الفواتح الأولف أربع عشر صله

255
00:13:29,573 --> 00:13:32,640
سحيرا من قطع كذا اشتهر الخاتمة

256
00:13:32,640 --> 00:13:35,874
وتم ذا النظم بحمد الله على تمامه

257
00:13:35,874 --> 00:13:39,066
بلا تناهي أبياته وند بدال ذنها تاريخها

258
00:13:39,066 --> 00:13:42,085
بشرى لمن يتقنها ثم الصلاة والسلام

259
00:13:42,085 --> 00:13:45,415
أبدا على ختام الأنبياء أحمد والآل

260
00:13:45,415 --> 00:13:48,745
والصحبي وكل تابعي وكل قارئ وكل

261
00:13:48,745 --> 00:13:51,264
سامعي أنبه على

262
00:13:51,264 --> 00:13:54,211
أمرين الأمر الأول

263
00:13:54,211 --> 00:13:57,158
أن المصنف رحمه

264
00:13:57,158 --> 00:14:00,504
الله لم يأت يسرد هذه

265
00:14:00,504 --> 00:14:03,916
الأبيات ثم يشرحها وإنما ابتدى

266
00:14:03,916 --> 00:14:07,247
بالشرح مباشرة لكن إراد هذه

267
00:14:07,247 --> 00:14:10,525
الأبيات حسن لعدة حكم أو

268
00:14:10,525 --> 00:14:13,803
فوائد الفائدة الأولى تصحيح المتن

269
00:14:13,803 --> 00:14:17,082
فإذا أراد الطالب أن يحفظ

270
00:14:17,082 --> 00:14:20,360
الطالب المبتدئ في هذا المتن

271
00:14:20,360 --> 00:14:23,760
فيكون قد سمع هذا المتن كاملا مصححا

272
00:14:23,760 --> 00:14:27,010
والفائدة الثانية هي المرور على

273
00:14:27,010 --> 00:14:30,220
المتن مرورا سريعا في وقت

274
00:14:30,220 --> 00:14:33,370
وجيز حتى يكون الذهن في

275
00:14:33,370 --> 00:14:36,520
تصور لمسائل تصور وجيز لمسائل

276
00:14:36,520 --> 00:14:39,775
هذا المتن والتنبيه الثاني أن

277
00:14:39,775 --> 00:14:43,100
الكتب الأربعة التي تدرس بعد

278
00:14:43,100 --> 00:14:46,425
التي سبق ذكرها في المقدمة

279
00:14:46,425 --> 00:14:49,750
الثالثة بعد تحفة الأطفال والجزرية

280
00:14:49,750 --> 00:14:53,075
هي على هذا الترثيب الكتاب

281
00:14:53,075 --> 00:14:56,400
الأول الرعاية لمكي بنبي طالب

282
00:14:56,400 --> 00:14:59,677
والثاني هو الإتقان والتحديد

283
00:14:59,677 --> 00:15:02,545
في الإتقان والتجويد لأبي

284
00:15:02,545 --> 00:15:05,413
عمر الداني والثالث هو

285
00:15:05,413 --> 00:15:08,281
الموضح لعبد الوهاب القرطبي

286
00:15:08,281 --> 00:15:11,150
والرابع هو القول المفيد

287
00:15:11,150 --> 00:15:14,018
لمكي نصر أو لمحمد

288
00:15:14,018 --> 00:15:16,886
مكي نصر رحم الله

289
00:15:16,886 --> 00:15:20,138
الجميع نعم أحسن الله إليكم

290
00:15:20,138 --> 00:15:23,168
قال المؤلف رحمه الله تعالى

291
00:15:23,168 --> 00:15:26,198
بسم الله الرحمن الرحيم الحمد

292
00:15:26,198 --> 00:15:29,228
لله الذي أنزل القرآن على

293
00:15:29,228 --> 00:15:32,544
عبده تنزيلا وقال له رفعوا فيه

294
00:15:32,544 --> 00:15:35,531
ورتل القرآن ترتيلا والصلاة والسلام

295
00:15:35,531 --> 00:15:38,858
على سيدنا محمد المنزل عليه

296
00:15:38,858 --> 00:15:42,155
النوم والقلم وما يصدرون الذي

297
00:15:42,155 --> 00:15:45,330
نونت له الغزالة بصوت رخيم

298
00:15:45,330 --> 00:15:48,357
سمعه الحاضرون وعلى آله وأصحابه

299
00:15:48,357 --> 00:15:51,298
المهتدين منه بتحفة الإمداد وعلى

300
00:15:51,298 --> 00:15:54,288
أتباعه الذين قصروهما هم على

301
00:15:54,288 --> 00:15:57,329
اتباعه ففازوا بكل المراد صلاة

302
00:15:57,329 --> 00:16:00,571
وسلاما دائمين متلازمين إلى يوم

303
00:16:00,571 --> 00:16:03,918
التنادم وبعد فقد طلب مني بعض الأحباب

304
00:16:03,918 --> 00:16:07,066
أن أعمل له شرحا لطيفا مختصرا على

305
00:16:07,066 --> 00:16:10,214
نظمي المسمى بتحفة الأطفال فأجبته في ذلك

306
00:16:10,214 --> 00:16:13,362
بأحسن جواب راجع من الله أن يوفقني

307
00:16:13,362 --> 00:16:16,509
له أحسن التوفيق وأن يهديني به لأكوام

308
00:16:16,509 --> 00:16:19,657
طريق ودعلت أصله شرحا ولدي شيخنا محمد

309
00:16:19,657 --> 00:16:22,805
الميهي نظار الله إلينا وإليه وإعتمدت فيما

310
00:16:22,805 --> 00:16:25,953
تركته من هذا الشرح عليه لأن اقتصرت

311
00:16:25,953 --> 00:16:29,101
فيه على مجرد سرد الأحكام مريدا بذلك

312
00:16:29,101 --> 00:16:32,557
بلوغ المرام وأن ينتفع به الخاص والعام

313
00:16:32,557 --> 00:16:35,625
وسميته فتح الأقفال بشرح تحفة الأطفال

314
00:16:35,625 --> 00:16:38,693
وقلت مسعينا بالقدير السميع العين بسم

315
00:16:38,693 --> 00:16:41,761
الله الرحمن الرحيم أي أنظم الأشياء

316
00:16:41,761 --> 00:16:44,829
التي أتمت بركم بسم الله الرحمن

317
00:16:44,829 --> 00:16:48,171
الرحيم وابتدأت بالبسملات والحمدلات كما يأتي اقتداء

318
00:16:48,171 --> 00:16:51,334
بالكتاب العزيز وعملا بالأحاديث الواردة ولا يقفى

319
00:16:51,334 --> 00:16:54,497
ما في البسملات والحمدلات مما لا نطيل

320
00:16:54,497 --> 00:16:57,660
بذكر اقتصارا على ما ذكره في الأصل

321
00:16:57,660 --> 00:17:00,940
يقول راجي رحمة الله دوما سليمان

322
00:17:00,940 --> 00:17:04,300
هو الجمزوري الحمد لله مصليا على محمد

323
00:17:04,300 --> 00:17:07,793
وآله ومن تلا أي يقول مؤمر إحسان

324
00:17:07,793 --> 00:17:10,965
ربه الغفوري أي كثير المغفرة أي

325
00:17:10,965 --> 00:17:13,990
الستر على الخطايا فلم يآخذ

326
00:17:13,990 --> 00:17:17,463
عليها دائما سليمان بن حسيني بن محمد

327
00:17:17,463 --> 00:17:20,630
الجمزوري بالميمي بعد الجيم كما ذكره الشعراني

328
00:17:20,630 --> 00:17:24,115
وفي طبقاته الشيرب الأفندي الحمد لله أي التناول

329
00:17:24,115 --> 00:17:27,466
حسن ثابت بالاقتصاص الله تعالى لا يشرك فيه

330
00:17:27,466 --> 00:17:30,682
غيره إلا على طريق المتجاز مصليا أي طالبا

331
00:17:30,682 --> 00:17:34,047
من الله أن يزيد رحمته والمقرنة بالتعويم على سيدنا

332
00:17:34,047 --> 00:17:37,412
محمد الذي يحمده أهل السماوات وأهل الأرض وعلى آله

333
00:17:37,412 --> 00:17:40,717
الأولين والعيلين والمراد بهم هنا الذين آمنوا به

334
00:17:40,717 --> 00:17:44,188
فيعموا الصحبة ومن تلا يتبع النبي وأصحابه وبعد

335
00:17:44,188 --> 00:17:47,600
هذا النظم للمريدي في النون والتنوين والمدود

336
00:17:47,600 --> 00:17:51,074
وبعد ما تقدم الحمد لله الأتم والصلاة على نبيه

337
00:17:51,074 --> 00:17:54,378
الأعضم فهذا النظم أي المنظوم وهو باق على

338
00:17:54,378 --> 00:17:57,713
ماناه مبالغة جمعته للمريدي أي الطالب وهو في

339
00:17:57,713 --> 00:18:00,943
أحكام النون الساكنة والتنوين وفي أحكام المدود وغير

340
00:18:00,943 --> 00:18:04,069
ذلك من أحكام الميم الساكنة والعام التعريف والعام

341
00:18:04,069 --> 00:18:07,520
الأفعال سميته بتحفة الأطفال عن شيخنا الميهي

342
00:18:07,520 --> 00:18:10,940
ذي الكمال أي سميت هذا النظم بتحفة

343
00:18:10,940 --> 00:18:14,085
الأطفال التحفة الشيو الحسن والمراد هنا الأحكام

344
00:18:14,085 --> 00:18:17,352
الآتيه والأطفال دمع طفل والمراد بهما لم يبلغ

345
00:18:17,352 --> 00:18:20,783
الحلم أو المراد الأطفال ومتري في هذا الفن ناقلا

346
00:18:20,783 --> 00:18:24,184
له عن شيخنا الإمام العالم العلامة الحبل البحر الفهامة

347
00:18:24,184 --> 00:18:27,466
سيدي وأستاذي الشيخ نور الدين علي بن عمر بن أحمد

348
00:18:27,466 --> 00:18:30,710
بن عمر بن ناجي بن فوني ميهي أدام الله

349
00:18:30,710 --> 00:18:33,860
النفع بعلومه ذي الكمال أي التمام في

350
00:18:33,860 --> 00:18:37,010
الذات والصفات وسائل الأحوال الظاهرة والباطنة فيما

351
00:18:37,010 --> 00:18:40,090
يرجع للخالق والمخلوق أرجو به أن ينفع

352
00:18:40,090 --> 00:18:43,549
الطلاب والأجر والقبول والثواب يؤمر من الله تعالى

353
00:18:43,549 --> 00:18:47,009
أن ينفع بهذا النظم الطلاب بضم الطاعي جمع

354
00:18:47,009 --> 00:18:50,468
طالب أو جمع طلاب بفتح الطاعي مبالغة في

355
00:18:50,468 --> 00:18:53,928
طالب والطالب ويشمل المنتدي والمنتهي والمتوسط وهو المريض

356
00:18:53,928 --> 00:18:57,060
المتقدم وأرجو به من الله تعالى الأجر

357
00:18:57,060 --> 00:19:00,210
وسيأتي معناه والقبول وهو ترتيب الغرض المطلوب

358
00:19:00,210 --> 00:19:03,360
يدعي على دعائك ترتيب الثواب على الطاعة

359
00:19:03,360 --> 00:19:06,510
والإسعاف بالمطلوب والثواب بأليف الإطلاق وهو مقدار

360
00:19:06,510 --> 00:19:09,660
