1
00:27:37,772 --> 00:27:40,790
الْجَمْزُورِيُّ بَيَّنَهُ فِي شَرْحِهِ،

2
00:27:41,147 --> 00:27:44,361
وَمَحَلُّ هَذَا الْإِظْهَارِ إِذَا لَمْ يَأْتِ قَبْلَهَا لَامٌ أَوْ

3
00:28:06,862 --> 00:28:07,970
رَاءٌ فَبَيَّنَهُ،

4
00:28:07,416 --> 00:28:07,970
فَتَبَيَّنَ مِمَّا سَبَقَ

5
00:28:18,830 --> 00:28:19,670
أَنَّ قَوْلَ

6
00:28:22,610 --> 00:28:23,382
أَنَّ لَامَ الْفِعْلِ لَهَا حَالَانِ: أَوَّلُهُمَا: الْإِظْهَارُ،

7
00:28:22,996 --> 00:28:23,382
وَهَذَا قَبْلَ السِّتَّةِ وَعِشْرُونَ حَرْفًا،

8
00:28:22,996 --> 00:28:23,382
وَثَانِيهِمَا: إِدْغَامٌ،

9
00:28:22,996 --> 00:28:23,382
وَهَذَا عِنْدَ حَرْفَيِ اللَّامِ وَالرَّاءِ،

10
00:28:22,996 --> 00:28:23,382
فَتَبَيَّنَ مِمَّا سَبَقَ أَنَّ قَوْلَ النَّاظِمِ [مُطْلَقًا] فِيهِ تَقْيِيدٌ،

11
00:28:22,996 --> 00:28:23,382
فَلَا يُقَالُ مُطْلَقًا،

12
00:28:22,996 --> 00:28:23,382
وَإِنَّمَا يُقَيَّدُ بِأَنْ لَا يَأْتِيَ بَعْدَهَا لَامٌ أَوْ رَاءٌ،

13
00:28:22,996 --> 00:28:23,382
نَعَمْ، أَحْسَنَ اللَّهُ إِلَيْكُمْ،

14
00:28:22,996 --> 00:28:23,768
قَالَ رَحِمَهُ اللَّهُ فِي الْمِثْلَيْنِ وَالْمُتَقَارِبَيْنِ وَالْمُتَجَانِسَيْنِ،

15
00:28:23,382 --> 00:28:26,472
أَيْ هَذَا بَابٌ فِي بَيَانِ الْحُرُوفِ الَّتِي تُسَمَّى بِذَلِكَ؛ إِنْ

16
00:28:26,858 --> 00:28:27,244
فِي

17
00:28:44,572 --> 00:28:45,477
الصِّفَاتِ وَالْمَخَارِجِ اتَّفَقْ ...

18
00:28:45,025 --> 00:28:45,477
حَرْفَانِ فَالْمِثْلَانِ فِيهِمَا أَحَقُّ إِنْ

19
00:28:49,499 --> 00:28:51,721
فِي الصِّفَاتِ وَالْمَخَارِجِ اتَّفَقْ،

20
00:28:51,277 --> 00:28:51,721
عَيْنُ [اتَّفَقَ] حَرْفَانِ

21
00:28:54,388 --> 00:28:56,166
فِي الصِّفَاتِ،

22
00:28:56,166 --> 00:28:58,077
وَعَيْنُ فِي الْمَخَارِجِ،

23
00:28:57,343 --> 00:28:58,077
كُلٌّ بَايَنَ،

24
00:28:57,343 --> 00:28:58,077
نَحْوُ ﴿اذْهَب بِّكِتَابِي﴾،

25
00:28:57,343 --> 00:28:58,077
﴿يَذْهَبُ بِالْأَبْصَارِ﴾،

26
00:28:57,343 --> 00:28:58,077
وَالتَّعْيِينُ نَحْوُ ﴿رَبِحَت تِّجَارَتُهُمْ﴾،

27
00:28:57,343 --> 00:28:58,077
﴿الْمَوْتُ تَحْبِسُونَهُمَا﴾،

28
00:28:57,343 --> 00:28:58,077
وَاللَّامَيْنِ نَحْوُ ﴿بَل لَّا يَخَافُونَ﴾،

29
00:28:57,343 --> 00:28:58,077
﴿لَن تَرَانِي﴾،

30
00:28:57,343 --> 00:28:58,077
فَالْمِثْلَانِ فِيهِمَا يَفِي الْحَرْفَيْنِ،

31
00:28:57,343 --> 00:28:58,077
فَتَسْمِيَتُهُمَا بِالْمِثْلَيْنِ أَحَقُّ وَمُسْتَحَقُّ؛ وَإِنْ يَكُونَا مَخْرَجًا تَقَارَبَا ...

32
00:28:59,543 --> 00:29:00,277
وَفِي

33
00:29:13,827 --> 00:29:16,653
الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا مُقَارِبَيْنِ أَوْ يَكُونَا اتَّفَقَا ...

34
00:29:16,088 --> 00:29:16,653
فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا وَإِنْ يَكُونَا الْحَرْفَانِ مَخْرَجًا تَقَارَبَا،

35
00:29:24,250 --> 00:29:28,410
مَنْ تَقَارَبَا فِي الْمَخْرَجِ وَفِي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَانِ الْحَرْفَانِ مُتَقَارِبَيْنِ،

36
00:29:28,410 --> 00:29:28,930
أَوْ يَكُونَا اتَّفَقَا

37
00:29:54,490 --> 00:29:54,970
فِي

38
00:29:58,330 --> 00:30:01,690
مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا،

39
00:30:01,690 --> 00:30:02,650
فِي النُّسْخَةِ الْمُعْتَمَدَةِ [مُقَارِبَيْنِ]،

40
00:30:03,610 --> 00:30:04,081
وَفِي بَعْضِ النُّسَخِ [التُّحْفَةِ] [مُتَقَارِبَيْنِ]،

41
00:30:03,845 --> 00:30:04,081
لَكِنِ الَّتِي اعْتَمَدَهَا الضَّبَّاعُ [مُقَارِبَيْنِ]،

42
00:30:03,845 --> 00:30:04,081
نَعَمْ، أَسْأَلُ اللَّهَ إِلَيْكُمْ،

43
00:30:03,845 --> 00:30:04,081
قَالَ [مُقَارِبَيْنِ]،

44
00:30:06,434 --> 00:30:07,375
أَوْ يَكُونَا اتَّفَقَا فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا،

45
00:30:07,139 --> 00:30:07,375
مُقَا مُقَارِبَيْنِ أَيْ سَمِّهِ مُتَقَارِبَيْنِ،

46
00:30:07,139 --> 00:30:07,375
وَحَذَفَ التَّاءَ لِلنَّظْمِ لِضَرُورَتِهِ،

47
00:30:07,139 --> 00:30:07,375
يَعْنِي هَذَا هَذَا حَذَفَ التَّاءَ لِلنَّظْمِ،

48
00:30:07,139 --> 00:30:07,375
فَكَيْفَ يَأْتِي مَنْ يُحَقِّقُ هَذِهِ الْكُتُبَ ثُمَّ يَضَعُ الْبَيْتَ [مُتَقَارِبَيْنِ]؟

49
00:30:22,975 --> 00:30:23,673
هُوَ النَّاظِمُ رَحِمَهُ اللَّهُ يَقُولُ [مُقَارِبَيْنِ] بِحَذْفِ التَّاءِ لِضَرُورَةِ النَّظْمِ،

50
00:30:23,324 --> 00:30:23,673
هَذَا يُبَيِّنُ لَنَا أَيُّهَا الْإِخْوَةُ

51
00:30:33,949 --> 00:30:35,002
أَنَّ الْكُتُبَ يَنْبَغِي أَنْ يَعْتَنِيَ بِهَا طُلَّابُ الْعِلْمِ،

52
00:30:34,475 --> 00:30:35,002
وَلَوْ قُرِئَ أَدْنَى قِرَاءَةٍ

53
00:30:51,935 --> 00:30:52,841
تَبَيَّنَ لَهُ أَنَّهَا تُضْبَطُ بِهَذِهِ الطَّرِيقَةِ لَا بِمُتَقَارِبَيْنِ

54
00:30:55,664 --> 00:30:56,135
عَلَى

55
00:31:13,130 --> 00:31:16,210
مَا هُوَ الْمَشْهُورُ مِنْ نُسْخَةِ [التُّحْفَةِ]،

56
00:31:15,770 --> 00:31:16,210
نَعَمْ، أَسْأَلُ اللَّهَ إِلَيْكُمْ،

57
00:31:15,770 --> 00:31:16,210
قَالَ وَحَذَفَ التَّاءَ

58
00:31:24,025 --> 00:31:24,808
فِي النَّظْمِ لِضَرُورَتِهِ،

59
00:31:24,416 --> 00:31:24,808
يَعْنِي وَإِنْ تَقَارَبَ

60
00:31:27,548 --> 00:31:29,114
الْحَرْفَانِ فِي مَخْرَجٍ كُلِّيٍّ وَاخْتَلَفَا فِي بَعْضِ الصِّفَاتِ أَوْ فِي

61
00:31:28,723 --> 00:31:29,114
أَكْثَرِهَا سُمِّيَا مُتَقَارِبَيْنِ،

62
00:31:28,723 --> 00:31:29,114
وَفِي عِبَارَةِ الْأَكْثَرِ أَنَّ التَّقَارُبَ هُوَ أَنْ يَتَقَارَبَ الْحَرْفَانِ فِي

63
00:31:28,723 --> 00:31:29,114
الْمَخْرَجِ فَقَطْ،

64
00:31:28,723 --> 00:31:29,114
أَوْ فِي الصِّفَاتِ فَقَطْ،

65
00:31:28,723 --> 00:31:29,114
أَوْ فِيهِمَا،

66
00:31:28,723 --> 00:31:29,114
وَالدَّالِ وَالسِّينِ الْمُهْمَلَتَيْنِ ضَابِطًا خَاصًّا نَحْوُ ﴿قَدْ سَمِعَ﴾ وَ﴿عَدَدَ السِّنينَ﴾،

67
00:31:28,723 --> 00:31:29,114
فَإِنَّهُمَا مُتَقَارِبَانِ فِي الْمَخْرَجِ،

68
00:31:28,723 --> 00:31:29,114
وَكَالتَّاءِ الْمُثَلَّثَةِ الْفَوْقِيَّةِ وَهِيَ التَّاءُ وَالثَّاءُ الْمُثَلَّثَةُ،

69
00:31:28,723 --> 00:31:29,114
مُسْتَفِلَتَانِ مُصْمَتَتَانِ مُشْتَرِكَتَانِ فِي التَّرْقِيقِ وَانْتِفَاءِ الِاسْتِطَالَةِ وَالصَّفِيرِ وَالتَّكْرِيرِ وَالتَّفَشِّي،

70
00:31:28,723 --> 00:31:29,114
إِلَّا أَنَّ التَّاءَ شَدِيدَةٌ وَالثَّاءَ رِخْوَةٌ،

71
00:31:28,723 --> 00:31:29,114
فَالتَّقَارُبُ فِي الصِّفَاتِ أَنْ يَتَّفِقَا فِي أَكْثَرِهَا،

72
00:31:28,723 --> 00:31:29,114
وَكَاللَّامِ وَالرَّاءِ نَحْوُ ﴿قُل رَّبِّ﴾،

73
00:31:28,723 --> 00:31:29,114
أَمَّا ﴿قَالَ رَبِّ فَأَنظِرْنِي﴾ فَإِنَّهُمَا مُتَقَارِبَتَانِ فِيهِمَا،

74
00:31:28,723 --> 00:31:29,506
أَوْ يَكُونَا أَيِ الْحَرْفَانِ اتَّفَقَا فِي مَخْرَجٍ،

75
00:31:29,114 --> 00:31:29,506
أَيْ فِي الْمَخْرَجِ فَقَطْ دُونَ الصِّفَاتِ،

76
00:31:29,114 --> 00:31:29,506
كَالطَّاءِ وَالتَّاءِ نَحْوُ ﴿أَحَطتُ﴾،

77
00:31:29,114 --> 00:31:29,506
﴿وَالصَّالِحَاتِ طُوبَىٰ﴾،

78
00:31:29,114 --> 00:31:29,506
وَكَالدَّالِ وَالتَّاءِ نَحْوُ ﴿قَد تَّبَيَّنَ﴾،

79
00:31:29,114 --> 00:31:29,506
﴿وَالْمَسَاجِدِ تِلْكَ﴾،

80
00:31:29,114 --> 00:31:29,506
[حُقِّقَا] تَصِحُّ قِرَاءَتُهُ بِفَتْحِ الْحَاءِ عَلَى

81
00:31:33,029 --> 00:31:33,812
أَنَّهُ فِعْلٌ،

82
00:31:33,421 --> 00:31:35,378
وَأَلِفُهُ مُبْدَلَةٌ مِنْ نُونِ التَّوْكِيدِ لِنِيَّةِ الْوَقْفِ،

83
00:31:34,987 --> 00:31:35,378
وَبِضَمِّهَا عَلَى أَنَّهُ مَاضٍ لِلْمَجْهُولِ،

84
00:31:34,987 --> 00:31:35,378
وَأَلِفُهُ لِلتَّثْنِيَةِ تَعُودُ عَلَى الْحَرْفَيْنِ الْمُلْتَقِيَيْنِ،

85
00:31:34,987 --> 00:31:35,378
أَيْ سُمِّيَا بِالْمُتَجَانِسَيْنِ؛ بِالْمُتَجَانِسَيْنِ ثُمَّ إِنْ سَكَنْ ...

86
00:31:34,987 --> 00:31:35,378
أَوَّلُ

87
00:31:46,803 --> 00:31:47,518
كُلٍّ فَالصَّغِيرَ سَمِّيَنْ بِالْمُتَجَانِسَيْنِ أَيْ سُمِّيَا بِالْحَرْفَيْنِ الْمُتَجَانِسَيْنِ،

88
00:31:47,160 --> 00:31:47,518
ثُمَّ بَعْدَ مَعْرِفَةِ مَا تَقَدَّمَ إِنْ سَكَنَ أَوَّلُ كُلٍّ

89
00:31:56,193 --> 00:31:56,954
مِنْ هَذِهِ الْأَقْسَامِ الثَّلَاثَةِ فَالصَّغِيرَ بِالْغَيْنِ الْمُعْجَمَةِ وَنَصْبِ الرَّاءِ سَمِّيَنْ

90
00:31:56,573 --> 00:31:56,954
بِنُونِ التَّوْكِيدِ الْخَفِيفَةِ أَيْ سَمِّهِ الصَّغِيرَ؛

91
00:32:03,424 --> 00:32:05,708
أَوْ حُرِّكَ الْحَرْفَانِ فِي كُلٍّ فَقُلْ ...

92
00:32:05,327 --> 00:32:05,708
كُلٌّ كَبِيرٌ وَافْهَمَنْهُ بِالْمُثُلْ

93
00:32:09,235 --> 00:32:10,428
أَوْ حُرِّكَ الْحَرْفَانِ مَعًا

94
00:32:21,983 --> 00:32:23,932
فِي أَيٍّ

95
00:32:30,135 --> 00:32:31,287
مِنْ كُلٍّ مِنَ الثَّلَاثَةِ فَقُلْ أَنْتَ كُلٌّ مِنْهُمَا كَبِيرٌ،

96
00:32:30,711 --> 00:32:31,287
فَيُعْتَمَدُ أَنَّهُ كَبِيرٌ،

97
00:32:30,711 --> 00:32:31,287
وَافْهَمَنْهُ بِنُونِ التَّوْكِيدِ الْخَفِيفَةِ لِلْوَزْنِ،

98
00:32:30,711 --> 00:32:31,287
بِالْمُثُلِ بِضَمِّ الْمِيمِ وَالثَّاءِ جَمْعُ مِثَالٍ،

99
00:32:30,711 --> 00:32:31,287
وَهُوَ جُزْئِيٌّ يُذْكَرُ لِإِيضَاحِ الْقَاعِدَةِ الَّتِي هِيَ قَضِيَّةٌ كُلِّيَّةٌ يَتَعَرَّفُ

100
00:32:30,711 --> 00:32:31,287
مِنْهَا أَحْكَامُ جُزْئِيَّاتِ مَوْضُوعِهَا،

101
00:32:30,711 --> 00:32:31,287
وَقَدْ مَرَّ مَعَ كُلِّ قِسْمٍ أَمْثِلَتُهُ،

102
00:32:30,711 --> 00:32:31,287
وَحُكْمُ الْكَبِيرِ مِنْهَا الْإِظْهَارُ

103
00:32:34,169 --> 00:32:35,321
عِنْدَ الْجُمْهُورِ،

104
00:32:34,745 --> 00:32:35,321
وَالْإِدْغَامُ

105
00:32:38,779 --> 00:32:40,508
فِي أَحَدِ الْوَجْهَيْنِ عَنْ أَبِي عَمْرٍو وَيَعْقُوبَ بِشُرُوطِهِ الْمَذْكُورَةِ فِي

106
00:32:40,508 --> 00:32:41,084
كُتُبِ الْقِرَاءَةِ،

107
00:32:40,508 --> 00:32:41,084
وَأَمَّا الصَّغِيرُ فَإِنْ كَانَ مِنَ الْمِثْلَيْنِ فَحُكْمُهُ وُجُوبُ الْإِدْغَامِ إِلَّا

108
00:32:40,508 --> 00:32:41,084
إِذَا كَانَ

109
00:32:44,890 --> 00:32:45,813
الْأَوَّلُ حَرْفَ مَدٍّ نَحْوُ ﴿قَالُوا وَهُمْ﴾،

110
00:33:04,241 --> 00:33:05,571
﴿فِي يَوْمَيْنِ﴾،

111
00:33:04,906 --> 00:33:05,571
وَإِلَّا وَجَبَ إِظْهَارٌ،

112
00:33:04,906 --> 00:33:05,571
أَوْ هَاءَ السَّكْتِ وَذَلِكَ

113
00:33:26,824 --> 00:33:27,786
فِي ﴿مَالِيَهْ ۜ هَلَكَ﴾ وَإِلَّا جَازَ،

114
00:33:27,305 --> 00:33:27,786
وَإِنْ كَانَ

115
00:33:43,801 --> 00:33:45,061
مِنَ الْمُتَقَارِبَيْنِ أَوِ الْمُتَجَانِسَيْنِ فَحُكْمُهُ جَوَازُ الْوَجْهَيْنِ غَالِبًا

116
00:33:53,884 --> 00:33:55,144
عَلَى تَفْصِيلٍ يُطْلَبُ مِنْ كُتُبِ الْخِلَافِ،

117
00:33:54,514 --> 00:33:55,144
ثُمَّ ذَكَرَ النَّاظِمُ رَحِمَهُ اللَّهُ فَصْلًا فِي الْمُتَقَارِبَيْنِ بِالْمِثْلَيْنِ وَالْمُتَقَارِبَيْنِ

118
00:33:54,514 --> 00:33:55,144
وَالْمُتَجَانِسَيْنِ،

119
00:34:02,706 --> 00:34:03,967
قَالَ رَحِمَهُ اللَّهُ وَهَذَا شُرُوعٌ مِنَ النَّاظِمِ فِي بَيَانِ الْعَلَاقَةِ

120
00:34:03,337 --> 00:34:03,967
بَيْنَ

121
00:34:30,098 --> 00:34:33,097
الْحُرُوفِ عِنْدَ الْتِقَائِهِمَا خَطًّا أَوْ

122
00:34:33,097 --> 00:34:33,920
عِنْدَ الْتِقَائِهَا خَطًّا؛

123
00:35:06,054 --> 00:35:06,714
إِنْ

124
00:35:09,353 --> 00:35:10,673
فِي الصِّفَاتِ وَالْمَخَارِجِ اتَّفَقْ ...

125
00:35:10,013 --> 00:35:10,673
حَرْفَانِ فَالْمِثْلَانِ فِيهِمَا أَحَقُّ أَحَقُّ،

126
00:35:10,013 --> 00:35:10,673
الْأَوَّلُ هُمَا الْمِثْلَانِ،

127
00:35:10,013 --> 00:35:10,673
مَا هُمَا الْمِثْلَانِ؟

128
00:35:10,013 --> 00:35:10,673
هُوَ أَنْ يَتَكَرَّرَ،

129
00:35:10,013 --> 00:35:11,992
هُوَ أَنْ يَتَّفِقَ الْمَخْرَجُ وَالصِّفَةُ كَمَا

130
00:35:17,930 --> 00:35:19,250
قَالَ النَّاظِمُ،

131
00:35:18,590 --> 00:35:19,250
أَوْ يَتَكَرَّرَ الْحَرْفُ،

132
00:35:18,590 --> 00:35:19,250
نَقُولُ يَتَكَرَّرَ الْحَرْفُ مِثْلُ الْبَاءِ مَعَ الْبَاءِ ﴿اذْهَب بِّكِتَابِي﴾،

133
00:35:18,590 --> 00:35:19,250
﴿فَلَا يُسْرِف

134
00:35:36,897 --> 00:35:38,074
فِّي الْقَتْلِ﴾،

135
00:35:37,485 --> 00:35:38,074
﴿اضْرِب بِّعَصَاكَ﴾،

136
00:35:37,485 --> 00:35:40,848
وَالْمِثَالُ الثَّانِي اللَّي ذَكَرَهُ الشَّارِحُ قَالَ ﴿يَذْهَبُ بِالْأَبْصَارِ﴾ هَذَا

137
00:35:40,848 --> 00:35:41,381
عَلَى قِرَاءَةِ السُّوسِيِّ عَلَى رِوَايَةِ السُّوسِيِّ عَنْ أَبِي عَمْرٍو ﴿يَذْهَبُ

138
00:35:40,848 --> 00:35:41,381
بِالْأَبْصَارِ﴾ عَلَى إِسْكَانِ الْبَاءِ [يَذْهَبْ بِالْأَبْصَارِ]،

139
00:35:40,848 --> 00:35:41,381
وَكَانَ لَوْلَا

140
00:35:55,232 --> 00:35:56,297
أَنْ يُنَبِّهَ

141
00:36:13,550 --> 00:36:40,330
عَلَى هَذَا،

142
00:36:40,330 --> 00:36:41,830
وَإِنْ كَانَ الشَّارِحُ رَحِمَهُ اللَّهُ عَالِمٌ كَبِيرٌ فِي الْقِرَاءَاتِ فَقَدْ

143
00:36:41,330 --> 00:36:41,830
يَكُونُ رَأَى

144
00:36:45,355 --> 00:36:46,117
أَنَّ

145
00:36:59,842 --> 00:37:01,367
هَذَا لَا يَحْتَاجُ إِلَى تَنْبِيهٍ،

146
00:37:00,605 --> 00:37:02,130
وَطُلَّابُ التَّجْوِيدِ يَنْبَغِي أَنْ يَكُونُوا عَلَى عِلْمٍ بِهَذَا،

147
00:37:01,367 --> 00:37:04,418
لَكِنَّ غَالِبَ الشَّرْحِ غَالِبَ الشَّرْحِ يَشْرَحُونَ عَلَى رِوَايَةِ حَفْصٍ عَنْ

148
00:37:04,418 --> 00:37:05,180
عَاصِمٍ، فَإِذَا ذُكِرَ غَيْرُ ذَلِكَ

149
00:37:27,255 --> 00:37:29,243
مِنَ الْقِرَاءَاتِ يَحْسُنُ التَّنْبِيهُ عَلَيْهِ،

150
00:37:34,214 --> 00:37:36,202
قَالَ وَالتَّاءَيْنِ ﴿رَبِحَت تِّجَارَتُهُمْ﴾ التَّاءُ مَعَ التَّاءِ،

151
00:37:35,208 --> 00:37:36,202
﴿الْمَوْتُ تَحْبِسُونَهُمَا﴾

152
00:37:50,173 --> 00:37:51,429
هَذَا أَيْضًا عَلَى رِوَايَةِ

153
00:38:12,817 --> 00:38:15,650
السُّوسِيِّ عَنْ أَبِي عَمْرٍو [الْمَوْتُ تَحْبِسُونَهُمَا]،

154
00:38:14,150 --> 00:38:15,650
وَ﴿بَل لَّا يَخَافُونَ﴾ اللَّامُ مَعَ اللَّامِ،

155
00:38:14,150 --> 00:38:15,650
قَالَ ﴿لَن تَرَانِي﴾

156
00:38:27,021 --> 00:38:28,182
هَذَا أَيْضًا عَلَى رِوَايَةِ السُّوسِيِّ عَنْ أَبِي عَمْرٍو،

157
00:38:27,602 --> 00:38:28,182
قَالَ لَنْ

158
00:38:41,887 --> 00:38:43,817
هَذَا النَّوْعُ الْأَوَّلُ وَهُمَا الْمِثْلَانِ،

159
00:38:43,650 --> 00:38:43,817
هُوَ لَهُمَا مُمْكِنٌ أَنْ نُعَرِّفَهُمَا بِتَعْرِيفَيْنِ: هُوَ أَنْ يَتَّفِقَ الْحَرْفُ

160
00:38:43,650 --> 00:38:43,817
الْمَخْرَجَ وَالصِّفَةَ،

161
00:38:43,650 --> 00:38:43,817
أَوْ أَنْ نَقُولَ هُوَ أَنْ يَتَكَرَّرَ الْحَرْفُ فَ مَعَ فَ،

162
00:38:43,650 --> 00:38:43,817
ب مَعَ ب،

163
00:38:43,650 --> 00:38:43,817
تَا مَعَ تَا،

164
00:38:43,650 --> 00:38:51,721
وَهَكَذَا بَقِيَّةُ الْحُرُوفِ،

165
00:38:51,721 --> 00:38:52,614
النَّوْعُ الثَّانِي أَوِ الْقِسْمُ الثَّانِي هُمَا الْمُتَقَارِبَانِ،

166
00:38:51,721 --> 00:38:52,614
هُمَا الْمُتَجَانِسَانِ أَوِ الْمُتَقَارِبَانِ؛ وَإِنْ يَكُونَا

167
00:39:10,471 --> 00:39:12,257
مَخْرَجًا تَقَارَبَا ...

168
00:39:11,364 --> 00:39:12,257
وَفِي

169
00:39:16,721 --> 00:39:18,150
الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا مُقَارِبَيْنِ مَا هُمَا الْمُتَقَارِبَيْنِ؟

170
00:39:17,436 --> 00:39:18,150
هُمَا الْحَرْفَانِ اللَّذَانِ يَتَقَارَبَا مَخْرَجًا وَصِفَةً،

171
00:39:46,587 --> 00:39:47,420
أَوْ مَخْرَجًا

172
00:39:52,670 --> 00:39:53,420
أَوْ صِفَةً،

173
00:39:53,045 --> 00:39:54,309
قَالَ وَإِنْ يَكُونَا مَخْرَجًا تَقَارَبَا وَفِي الصِّفَاتِ اخْتَلَفَا يُلَقَّبَا مُقَارِبَيْنِ،

174
00:39:53,864 --> 00:39:54,309
فَذَكَرَ نَوْعًا وَاحِدًا،

175
00:39:53,864 --> 00:39:54,309
وَأَهْلُ الْعِلْمِ يَذْكُرُونَ أَنَّ الْمُتَقَارِبَانِ هُمَا أَنْ يَتَقَارَبَا فِي الْمَخْرَجِ

176
00:39:53,864 --> 00:39:54,309
وَالصِّفَةِ، أَوْ فِي الصِّفَةِ،

177
00:39:53,864 --> 00:39:54,309
أَوْ فِي الْمَخْرَجِ،

178
00:39:53,864 --> 00:39:54,309
الْمُصَنِّفُ رَحِمَهُ اللَّهُ الشَّارِحُ قَالَ [مُقَارِبَيْنِ] وَحَذَفَ التَّاءَ ضَرُورَةَ النَّظْمِ،

179
00:39:53,864 --> 00:39:54,309
وَهَذَا يُبَيِّنُ لَنَا رُجْحَانَ هَذَا الْوَجْهِ عَلَى الْوَجْهِ الْآخَرِ،

180
00:39:59,920 --> 00:40:01,788
أَوَّلًا لِأَنَّهُ تَرْجِيحُ عَالِمٍ كَبِيرٍ وَهُوَ الضَّبَّاعُ وَجَمَاعَةٌ مِنَ الْعُلَمَاءِ

181
00:40:01,420 --> 00:40:01,788
الشُّرَّاحِ وَالْمُحَقِّقِينَ رَجَّحُوا هَذَا الْوَجْهَ،

182
00:40:11,976 --> 00:40:13,087
وَهُوَ مَوْجُودٌ فِي بَعْضِ مَخْطُوطَاتِ [التُّحْفَةِ]،

183
00:40:12,420 --> 00:40:13,087
وَالْآخَرُ لِأَنَّ هَذَا هُوَ أَرْجَحُ لِأَنَّهُ تَحْذِفُهُ لِضَرُورَةِ النَّظْمِ لِكَيْ

184
00:40:12,420 --> 00:40:13,087
يَسْتَقِيمَ الْبَيْتُ،

185
00:40:12,420 --> 00:40:13,087
فَيَكُونُ تَرْجِيحُ اخْتِيَارِ هَذَا الْوَجْهِ أَوَّلًا فَيُقَالُ [مُقَارِبَيْنِ]،

186
00:40:12,420 --> 00:40:13,087
ثُمَّ عَرَّفَ الشَّارِحُ رَحِمَهُ اللَّهُ الْمُتَقَارِبَيْنِ قَالُوا وَفِي عِبَارَةِ الْأَكْثَرِينَ

187
00:40:12,420 --> 00:40:13,087
أَنَّ التَّقَارُبَ هُوَ أَنْ يَتَقَارَبَ الْحَرْفَانِ فِي الْمَخْرَجِ فَقَطْ،

188
00:40:12,420 --> 00:40:13,087
أَوْ فِي الصِّفَاتِ فَقَطْ،

189
00:40:12,420 --> 00:40:13,087
أَوْ فِيهِمَا أَيْ فِي الْمَخْرَجِ أَوْ فِي الصِّفَاتِ أَوْ فِي

190
00:40:12,420 --> 00:40:13,087
الْمَخْرَجِ وَالصِّفَاتِ،

191
00:40:12,420 --> 00:40:13,087
وَإِنْ كَانَ النَّظْمُ لَمْ يَذْكُرْ إِلَّا نَوْعًا أَيْضًا لَكِنَّ الْعُلَمَاءَ

192
00:40:12,420 --> 00:40:13,087
يَنُصُّونَ عَلَى بَقِيَّةِ الْأَنْوَاعِ،

193
00:40:12,420 --> 00:40:13,087
الْعَلَاقَةُ الثَّالِثَةُ الَّتِي بَيْنَ الْحُرُوفِ

194
00:40:22,329 --> 00:40:23,056
هِيَ التَّجَانُسُ؛ أَوْ يَكُونَا اتَّفَقَا ...

195
00:40:34,358 --> 00:40:34,983
فِي مَخْرَجٍ دُونَ الصِّفَاتِ حُقِّقَا أَنْ يَتَّحِدَ الْمَخْرَجُ،

196
00:40:34,670 --> 00:40:34,983
إِذَا الْمُتَجَانِسَانِ هُمَا أَنْ يَتَّحِدَ الْمَخْرَجُ وَتَخْتَلِفَ الصِّفَاتُ مِثْلُ الطَّاءِ

197
00:40:34,670 --> 00:40:34,983
وَالتَّاءِ وَالدَّالِ،

198
00:40:34,670 --> 00:40:37,483
وَهَذَا مَحْصُورٌ فِي أَحْرُفٍ،

199
00:40:37,170 --> 00:40:38,420
هَذَا مَحْصُورٌ فِي أَحْرُفٍ أَوَّلُهَا الطَّاءُ وَالدَّالُ وَالتَّاءُ،

200
00:40:38,108 --> 00:40:38,420
قَالَ الطَّائِفَةُ أَنْ تَقُولَ أَطْ،

201
00:40:38,108 --> 00:40:38,420
أَدْ، أَتْ مِنْ نَفْسِ الْمَخْرَجِ،

202
00:40:38,108 --> 00:40:38,420
إِذَا أُدْغِمَتْ بَعْضُهَا بِبَعْضٍ فَهَذَا تَجَانُسٌ،

203
00:40:38,108 --> 00:40:38,420
قَالَ ﴿الطَّائِفَةُ﴾،

204
00:40:38,108 --> 00:40:38,420
﴿أَحَطتُ﴾، ﴿الصَّالِحَاتِ طُوبَىٰ﴾ هَذَا

205
00:40:50,602 --> 00:40:52,420
عَلَى قِرَاءَةِ رِوَايَةِ السُّوسِيِّ عَنْ أَبِي عَمْرٍو [الصَّالِحَاتِ طُوبَى]،

206
00:40:51,511 --> 00:40:52,420
الثَّانِي الظَّاءُ وَالذَّالُ وَالثَّاءُ،

207
00:40:51,511 --> 00:40:52,420
تَقُولُ أَظْ،

208
00:40:51,511 --> 00:40:52,420
أَذْ، أَثْ كَذَلِكَ إِذَا جَاءَتْ فَالْإِدْغَامُ بَيْنَهَا مُتَجَانِسٌ،

209
00:40:51,511 --> 00:40:52,420
النَّوْعُ الثَّالِثُ الْوَاوُ وَالْمِيمُ وَالْبَاءُ،

210
00:40:51,511 --> 00:40:52,420
إِذَا حَصَلَ شَيْءٌ مِنْ إِدْغَامِ هَذِهِ الْأَحْرُفِ فَهُوَ تَجَانُسٌ،

211
00:40:51,511 --> 00:40:52,420
ثُمَّ قَالَ النَّاظِمُ رَحِمَهُ

212
00:40:58,784 --> 00:41:00,602
اللَّهُ؛ بِالْمُتَجَانِسَيْنِ ثُمَّ إِنْ

213
00:41:19,693 --> 00:41:20,602
سَكَنْ ...

214
00:41:20,602 --> 00:41:21,511
أَوَّلُ كُلٍّ فَالصَّغِيرَ سَمِّيَنْ

215
00:41:26,965 --> 00:41:28,784
أَيْ إِذَا

216
00:41:40,602 --> 00:41:42,420
سَكَنَ الْحَرْفُ الْأَوَّلُ وَإِذَا تَحَرَّكَ الثَّانِي هَذَا إِدْغَامٌ صَغِيرٌ،

217
00:41:41,511 --> 00:41:44,563
وَقَدْ ذَكَرَهُ قَبْلَ قَلِيلٍ فِي أَحْكَامِ الْمِيمِ السَّاكِنَةِ؛ أَوْ

218
00:41:44,563 --> 00:41:45,099
حُرِّكَ الْحَرْفَانِ فِي كُلٍّ فَقُلْ ...

219
00:41:44,563 --> 00:41:45,099
كُلٌّ كَبِيرٌ وَافْهَمَنْهُ بِالْمُثُلْ إِذَا تَحَرَّكَ الْحَرْفَانِ فَهُمَا يُسَمَّى إِدْغَامٌ

220
00:41:44,563 --> 00:41:45,099
كَبِيرٌ، وَافْهَمَنْهُ بِالْمُثُلِ،

221
00:41:44,563 --> 00:41:45,099
حُكْمُ الْكَبِيرِ عِنْدَ جُمْهُورِ الْقُرَّاءِ هُوَ الْإِظْهَارُ،

222
00:41:44,563 --> 00:41:45,099
وَإِنَّمَا يُدْغِمُ السُّوسِيُّ

223
00:41:52,599 --> 00:41:53,670
عَنْ أَبِي عَمْرٍو وَيَعْقُوبُ بِشُرُوطِهِ،

224
00:41:53,134 --> 00:41:53,670
وَأَمَّا الصَّغِيرُ فَإِذَا فَحُكْمُهُ وُجُوبُ الْإِدْغَامِ،

225
00:41:53,134 --> 00:41:53,670
وَهَذَا مِنْ حَيْثُ الْإِجْمَالِ،

226
00:41:53,134 --> 00:41:53,670
الْمُتَقَارِبَةُ الْمُتَجَانِسَةُ فِيهِمَا تَفَاصِيلُ،

227
00:41:53,134 --> 00:41:53,670
فِيهِمَا تَفَاصِيلُ،

228
00:41:53,134 --> 00:41:53,670
لَكِنَّ هَذَا كِتَابُ تَجْوِيدٍ وَلَيْسَ كِتَابَ قِرَاءَةٍ حَتَّى يَذْكُرَ فِيهِ

229
00:41:53,134 --> 00:41:53,670
النَّاظِمُ رَحِمَهُ اللَّهُ كُلَّ شَيْءٍ،

230
00:41:53,134 --> 00:41:53,670
وَإِنَّمَا ذَكَرَ هَذِهِ قَاعِدَةً عَامَّةً أَنَّهُ

231
00:42:15,147 --> 00:42:16,056
فِي حَالَةِ الْإِدْغَامِ

232
00:42:19,238 --> 00:42:20,602
إِذَا كَانَ الْحَرْفُ الْأَوَّلُ السَّاكِنُ وَالثَّانِي مُتَحَرِّكٌ هَذَا يُسَمَّى الصَّغِيرَ،

233
00:42:20,147 --> 00:42:20,602
وَإِذَا كَانَ الْأَوَّلُ طُرِقَهُ يُسَمَّى الصَّغِيرَ،

234
00:42:20,147 --> 00:42:20,602
إِذَا كَانَ الْحَرْفُ الثَّانِي مُتَحَرِّكٌ وَالثَّانِي مُتَحَرِّكٌ يُسَمَّى الْإِدْغَامُ كَبِيرٌ،

235
00:42:20,147 --> 00:42:20,602
فَهَذِهِ الْعَلَاقَةُ بَيْنَ الْحُرُوفِ،

236
00:42:20,147 --> 00:42:20,602
وَيُزَادُ نَوْعٌ رَابِعٌ يُقَالُ الْمُتَبَاعِدَانِ،

237
00:42:20,147 --> 00:42:20,602
هَذِهِ الْعَلَاقَاتُ بَيْنَ الْحُرُوفِ نَظَمَهَا السَّمَنُّودِيُّ رَحِمَهُ اللَّهُ وَذَكَرَ الرَّابِعَ

238
00:42:20,147 --> 00:42:20,602
قَالَ: [وَالْمُتَبَاعِدَانِ هُمُ الْحَرْفَانِ اللَّذَيْنِ مُتَبَاعِدَانِ مَخْرَجًا وَاخْتَلَفَا صِفَةً حَيْثُ

239
00:42:20,147 --> 00:42:20,602
مَخْرَجًا تَبَاعَدَا وَالْخُلْفُ

240
00:42:26,965 --> 00:42:27,875
فِي الصِّفَاتِ جَاءَ]،

241
00:42:27,420 --> 00:42:27,875
وَلَا أَثَرَ لِهَذِهِ الصِّفَةِ

242
00:42:34,693 --> 00:42:35,602
مِنْ جِهَةِ التَّطْبِيقِ فِي التَّجْوِيدِ،

243
00:42:35,147 --> 00:42:35,602
وَهَذَا الْبَابُ عَلَى كُلِّ حَالٍ هَذَا الْبَابُ فِي جُلِّهِ نَظَرِيٌّ،

244
00:42:35,147 --> 00:42:35,602
إِنَّمَا قَدْ يُحْتَاجُ إِلَيَّ فِي بَابِ الْمُتَجَانِسَيْنِ،

245
00:42:35,147 --> 00:42:35,602
وَإِلَّا فَأَحْكَامٌ قَدْ تَكُونُ سَابِقَةً فِي أَبْوَابٍ أُخْرَى،

246
00:42:51,627 --> 00:42:53,822
نَعَمْ، أَحْسَنَ اللَّهُ إِلَيْكُمْ،

247
00:42:53,822 --> 00:43:14,622
قَالَ رَحِمَهُ اللَّهُ أَقْسَامُ الْمَدِّ،

248
00:43:14,622 --> 00:43:17,260
الْمَدُّ مَعْنَاهُ فِي اللُّغَةِ الْمَطُّ أَوِ الزِّيَادَةُ،

249
00:43:16,733 --> 00:43:17,260
وَفِي اصْطِلَاحِ الْقُرَّاءِ عِبَارَةٌ عَنْ إِطَالَةِ الصَّوْتِ بِحُرُوفِهِ،

250
00:43:16,733 --> 00:43:17,260
وَيُقَابِلُهُ الْقَصْرُ،

251
00:43:16,733 --> 00:43:17,260
وَمَعْنَاهُ

252
00:43:19,898 --> 00:43:20,952
فِي اللُّغَةِ الْحَبْسُ أَوِ الْمَنْعُ،

253
00:43:20,425 --> 00:43:20,952
وَفِي الِاصْطِلَاحِ إِثْبَاتُ حَرْفِ الْمَدِّ

254
00:43:51,480 --> 00:43:53,851
مِنْ غَيْرِ زِيَادَةٍ عَلَيْهِ،

255
00:43:52,666 --> 00:43:53,851
وَالْمَدُّ أَصْلِيٌّ وَفَرْعِيٌّ لَهُ؛ وَالْمَدُّ أَصْلِيٌّ وَفَرْعِيٌّ لَهُ ...

256
00:43:52,666 --> 00:43:53,851
وَسَمِّ أَوَّلًا طَبِيعِيًّا وَهُوَ وَالْمَدُّ قِسْمَانِ: أَصْلِيٌّ وَفَرْعِيٌّ لَهُ أَيْ

257
00:43:52,666 --> 00:43:53,851
لِلْأَصْلِيِّ، وَسَيَأْتِي تَعْرِيفُ

258
00:44:10,293 --> 00:44:18,231
كُلٍّ مِنْهُمَا،

259
00:44:18,231 --> 00:44:18,647
وَسَمِّ أَنْتَ أَوَّلًا إِلَى أَوَّلٍ مِنْهُمَا مَدًّا طَبِيعِيًّا لِأَنَّ صَاحِبَ

260
00:44:18,231 --> 00:44:18,647
الطَّبِيعَةِ السَّلِيمَةِ

261
00:44:23,219 --> 00:44:24,050
لَا يَنْقُصُهُ

262
00:44:44,007 --> 00:44:45,908
عَنْ حَدِّهِ

263
00:45:22,560 --> 00:45:23,160
وَهُوَ

264
00:45:40,140 --> 00:45:41,180
لَا يَزِيدُ عَلَيْهِ،

265
00:45:40,660 --> 00:45:41,180
وَحَدُّهُ مِقْدَارُ أَلِفٍ وَصْلًا وَوَقْفًا بِأَنْ تَمُدَّ صَوْتَكَ بِقَدْرِ النُّطْقِ

266
00:45:40,660 --> 00:45:41,180
بِحَرَكَتَيْنِ إِحْدَاهُمَا حَرَكَةُ الْحَرْفِ الَّذِي قَبْلَ

267
00:46:01,437 --> 00:46:02,205
حَرْفِ الْمَدِّ وَالْأُخْرَى هِيَ

268
00:46:12,996 --> 00:46:13,832
حَرْفُ الْمَدِّ،

269
00:46:13,414 --> 00:46:13,832
مِثَالُهُ بَا بَا،

270
00:46:13,414 --> 00:46:13,832
فَحَرَكَةُ

271
00:46:27,960 --> 00:46:28,607
الْبَاءِ الْأُولَى هِيَ حَرَكَةُ

272
00:46:33,329 --> 00:46:34,186
الْحَرْفِ

273
00:46:39,329 --> 00:46:41,043
الَّذِي قَبْلَ حَرْفِ

274
00:47:00,471 --> 00:47:01,614
الْمَدِّ وَثَانِيَةٌ هِيَ مِقْدَارُ

275
00:47:27,320 --> 00:47:28,463
حَرْفِ الْمَدِّ،

276
00:47:27,891 --> 00:47:28,463
نَحْوُ ﴿قَالَ﴾ وَ﴿يَقُولُ﴾ وَ﴿قِيلَ﴾،

277
00:47:27,891 --> 00:47:28,463
فَحَرَكَةُ الْقَافِ فِي الْأَمْثِلَةِ الثَّلَاثَةِ

278
00:47:32,588 --> 00:47:33,983
هِيَ إِحْدَى الْحَرَكَتَيْنِ الْمَذْكُورَتَيْنِ،

279
00:47:33,285 --> 00:47:33,983
وَالْأَلِفُ فِي ﴿قَالَ﴾ وَالْوَاوُ فِي ﴿يَقُولُ﴾ وَالْيَاءُ فِي ﴿قِيلَ﴾ هِيَ

280
00:47:33,285 --> 00:47:33,983
الْحَرَكَةُ الثَّانِيَةُ،

281
00:47:33,285 --> 00:47:33,983
وَهُوَ بِضَمِّهَا وَسُكُونِ الْوَاوِ،

282
00:47:33,285 --> 00:47:33,983
أَيِ الْمَدُّ الطَّبِيعِيُّ؛ مَا لَا تَوَقُّفٌ لَهُ عَلَى سَبَبْ ...

283
00:47:33,285 --> 00:47:33,983
وَلَا بِدُونِهِ الْحُرُوفُ تُجْتَلَبْ مَا لَا تَوَقُّفٌ لَهُ بِفَتْحِ التَّاءِ

284
00:47:33,285 --> 00:47:33,983
الْمُثَنَّاةِ فَوْقُ وَالْوَاوِ وَتَشْدِيدِ الْقَافِ وَضَمِّهَا وَضَمِّ الْفَاءِ مُنَوَّنًا،

285
00:47:33,285 --> 00:47:33,983
أَيْ مَا لَا يَتِمُّ لَكَ بِقَوْلِهِ،

286
00:47:33,285 --> 00:47:33,983
بَلْ أَيُّ

287
00:47:38,169 --> 00:47:39,564
حَرْفٍ غَيْرِ هَمْزٍ أَوْ سُكُونٍ جَاءَ

288
00:47:41,657 --> 00:47:45,146
بَعْدَ مَدٍّ فَالطَّبِيعِيَّ يَكُونُ،

289
00:47:44,448 --> 00:47:45,146
بَلْ لِلِانْتِقَالِ أَيُّ حَرْفٍ وَأَيُّ حَرْفٍ غَيْرِيِّ بِالْجَرِّ نَعْتٌ لِحَرْفٍ،

290
00:47:44,448 --> 00:47:45,146
وَبِالنَّصْبِ نَعْتٌ لِأَيٍّ،

291
00:47:44,448 --> 00:47:45,146
أَيْ سِوَى هَمْزٍ أَوْ سُكُونٍ جَاءَ،

292
00:47:44,448 --> 00:47:45,146
وَذَلِكَ السَّبَبُ كَهَمْزٍ أَوْ سُكُونٍ أَوْ هُمَا،

293
00:47:44,448 --> 00:47:45,146
وَقَوْلُهُ [مُسْجَلًا] أَيْ مُطْلَقًا رَادِعٌ لِلْهَمْزِ وَالسُّكُونِ مَعْنَيْهِ،

294
00:47:44,448 --> 00:47:45,146
سَوَاءٌ كَانَ الْهَمْزُ سَابِقًا عَنْ حَرْفِ الْمَدِّ أَوْ لَاحِقًا لَهُ

295
00:47:44,448 --> 00:47:45,146
وَهُوَ أَقْوَى،

296
00:47:44,448 --> 00:47:45,146
وَسَوَاءٌ كَانَ السُّكُونُ وَصْلِيًّا وَهُوَ الَّذِي لَا يَتَغَيَّرُ

297
00:48:17,835 --> 00:48:19,164
وَصْلًا وَلَا وَقْفًا أَوْ عَارِضًا وَهُوَ

298
00:48:24,698 --> 00:48:25,731
الَّذِي يَعْرِضُ لِلْوَقْفِ

299
00:48:46,454 --> 00:48:47,672
أَوْ لِلْإِدْغَامِ،

300
00:48:47,063 --> 00:48:47,672
وَلِلْمَدِّ سَبَبٌ آخَرُ مَعْنَوِيٌّ وَيَنْقَسِمُ إِلَى قِسْمَيْنِ: أَحَدُهُمَا: مَدُّ تَعْظِيمٍ،

301
00:48:47,063 --> 00:48:47,672
وَثَانِيهُمَا: مَدُّ

302
00:48:51,933 --> 00:48:53,150
لَا التَّبْرِئَةِ،

303
00:48:52,541 --> 00:48:53,150
وَرُوِيَ

304
00:49:10,015 --> 00:49:11,312
عَنْ حَمْزَةَ فِي نَحْوِ ﴿لَا رَيْبَ﴾ فِي وَجْهٍ بِحَدِّ وَسَطٍ

305
00:49:10,664 --> 00:49:11,312
وَيُشْبِعُهُ إِذَا كَانَ تَالِيًا لَا حَمْزَةَ ﴿كَلَّا إِكْرَاهَ﴾ عَمَلًا بِأَقْوَى

306
00:49:10,664 --> 00:49:11,312
السَّبَبَيْنِ؛ حُرُوفُهُ ثَلَاثَةٌ فَعِيهَا ...

307
00:49:10,664 --> 00:49:11,312
مِنْ لَفْظِ وَايٍ وَهِيَ فِي نُوحِيهَا حُرُوفُ وَايٍ

308
00:49:29,970 --> 00:49:31,370
الْمَدُّ ثَلَاثَةٌ فَعِيهَا بِالْفَعِي وَالْعَيْنِ الْمُهْمَلَةِ وَإِثْبَاتِ

309
00:49:36,270 --> 00:49:39,070
الْيَاءِ بَعْدَهَا لِلْوَزْنِ،

310
00:50:09,712 --> 00:50:10,900
أَيِ احْفَظْهَا مِنْ حُرُوفِ لَفْظِ [وَايٍ] بِالتَّنْوِينِ مَعَ

311
00:50:32,790 --> 00:50:34,314
الْمَدِّ وَهُوَ مَصْدَرُ [وَأْيٍ] كَرَمْيٍ بِمَعْنَى وَعْدٍ أُبْدِلَتْ هَمْزَتُهُ أَلِيفًا

312
00:50:33,552 --> 00:50:34,314
لِسُكُونِهَا وَانْفِتَاحِ مَا قَبْلَهَا،

313
00:50:33,552 --> 00:50:34,314
وَهِيَ الْأَوَّلُ أَلِفٌ وَالْيَاءُ الْمُجَانِسُ لِكُلٍّ مِنْهَا حَرَكَةٌ وَاقِفَةٌ،

314
00:50:33,552 --> 00:50:34,314
وَمَصْدَرُ يَأْبُو الْمُنْذِرِ وَآ كَرَمَى،

315
00:50:33,552 --> 00:50:34,314
نَعَمْ، أَحْسَنَ

316
00:50:47,669 --> 00:50:48,745
اللَّهُ إِلَيْكُمْ،

317
00:50:48,207 --> 00:50:48,745
قَالَ وَهُوَ مَصْدَرُ وَآ كَرَمَى بِمَعْنَى وَعْدٍ أُبْدِلَتْ هَمْزَتُهُ أَلِيفًا

318
00:50:48,207 --> 00:50:48,745
لِسُكُونِهَا وَانْفِتَاحِ مَا قَبْلَهَا،

319
00:50:48,207 --> 00:50:48,745
وَهِيَ الْأَوَّلُ أَلِفٌ وَالْيَاءُ الْمُجَانِسُ لِكُلٍّ مِنْهَا حَرَكَةٌ وَمَا قَبْلَهَا،

320
00:50:48,207 --> 00:50:48,745
وَإِنَّمَا سُمِّيَتْ حُرُوفَ

321
00:51:01,652 --> 00:51:02,727
مَدٍّ لِامْتِدَادِ الصَّوْتِ بِهَا وَلِضَعْفِهَا لِاتِّسَاعِ مَخْرَجِهَا،

322
00:51:02,189 --> 00:51:02,727
وَتُسَمَّى أَيْضًا خَفِيَّةً لِخَفَاءِ النُّطْقِ بِهَا خُصُوصًا الْأَلِفَ،

323
00:51:02,189 --> 00:51:02,727
وَهِيَ أَيْ حُرُوفُ

324
00:51:20,470 --> 00:51:20,990
الْمَدِّ

325
00:51:23,590 --> 00:51:24,630
ثَلَاثَةٌ مَجْمُوعَةٌ بِشُرُوطِهَا

326
00:51:43,098 --> 00:51:44,065
فِي قَوْلِهِ تَعَالَى ﴿نُوحِيهَا﴾،

327
00:51:44,065 --> 00:51:44,549
وَجُمِعَتْ أَيْضًا

328
00:52:03,423 --> 00:52:04,391
كَذَلِكَ فِي

329
00:52:21,418 --> 00:52:22,570
كَلِمَةِ ﴿أُوتِينَا﴾،

330
00:52:22,570 --> 00:52:23,377
ثُمَّ أَشَارَ إِلَى

331
00:52:29,829 --> 00:52:31,450
شَرْطِ كَوْنِهَا حُرُوفَ

332
00:52:35,888 --> 00:52:36,943
مَدٍّ بِقَوْلِهِ؛ وَالْكَسْرُ

333
00:52:52,900 --> 00:52:53,440
قَبْلَ

334
00:53:17,230 --> 00:53:18,105
الْيَا وَقَبْلَ

335
00:53:31,715 --> 00:53:32,767
الْوَاوِ ضَمْ ...

336
00:53:32,241 --> 00:53:32,767
شَرْطٌ وَفَتْحٌ قَبْلَ أَلْفٍ يُلْتَزَمْ الْكَسْرُ قَبْلَ الْيَا وَقَبْلَ الْوَاوِ

337
00:53:32,241 --> 00:53:32,767
ضَمْ شَرْطٌ وَفَتْحٌ قَبْلَ أَلْفٍ يُلْتَزَمُ،

338
00:53:32,241 --> 00:53:32,767
الْبِنَاءُ لِلْمَجْهُولِ مِنْ حَيْثُ مَنْظُومُهُ يَجُوزُ سَكْنُهُ وَسَكَّنَهُ الشَّارِحُ رَحِمَهُ

339
00:53:32,241 --> 00:53:32,767
اللَّهُ فَبِالتَّشْدِيدِ سَكَّنَهُ،

340
00:53:32,241 --> 00:53:32,767
نَعَمْ، حَسَّنَ اللَّهُ صَوْتَكُمْ،

341
00:53:32,241 --> 00:53:32,767
قَالَ؛ وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ سُكِّنَا ...

342
00:53:32,241 --> 00:53:32,767
إِنِ انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ سُكِّنَا

343
00:53:32,241 --> 00:53:32,767
إِنِ انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا،

344
00:53:32,241 --> 00:53:32,767
وَحَرْفَا اللِّينِ مِنْهَا

345
00:53:36,450 --> 00:53:36,976
أَيْ مِنَ الثَّلَاثَةِ بِالْمَذْكُورَةِ إِلَّا بِالْقَصْرِ بِالْوَزْنِ،

346
00:53:36,450 --> 00:53:36,976
وَالسِّينُ شَارِحٌ دَانِيَال كُونِي بُو نُوَار أَيْ أُظْهِرَ وَأَلِفُهُ وَالْإِطْلَاقُ

347
00:53:36,450 --> 00:53:36,976
نَحْوُ بَيْتٍ،

348
00:53:36,450 --> 00:53:36,976
كُلٌّ مِنْهُمَا أُعْلِنَ بِضَمِّ الْهَمْزَةِ أَيْ أُظْهِرَ وَأَلِفٌ لِلْإِطْلَاقِ نَحْوُ

349
00:53:36,450 --> 00:53:36,976
بَيْتٍ وَخَوْفٍ،

350
00:53:36,450 --> 00:53:36,976
فَإِنْ تَحَرَّكَا لَا يُسَمَّيَانِ حَرْفَيْ لِينٍ وَلَا مَدٍّ،

351
00:53:36,450 --> 00:53:36,976
وَأَمَّا الْأَلِفُ فَلَا تَكُونُ حَرْفَ مَدٍّ لِلُزُومِ سُكُونِهَا وَدَوَامِ انْفِتَاحِ

352
00:53:36,450 --> 00:53:36,976
مَا قَبْلَهَا،

353
00:53:36,450 --> 00:53:36,976
ثُمَّ ذَكَرَ النَّاظِمُ رَحِمَهُ اللَّهُ أَقْسَامَ الْمَدِّ،

354
00:53:36,450 --> 00:53:36,976
وَالْمَدُّ عَرَّفَهُ الشَّارِحُ رَحِمَهُ اللَّهُ بِقَوْلِهِ: عِبَارَةٌ عَنْ إِطَالَةِ الصَّوْتِ

355
00:53:36,450 --> 00:53:36,976
بِحُرُوفِهِ أَيْ بِحُرُوفِ الْمَدِّ،

356
00:53:36,450 --> 00:53:36,976
وَأَبْيَنُ مِنْ هَذَا أَنْ يُقَالَ: هُوَ إِطَالَةُ الصَّوْتِ بِحَرْفِ الْمَدِّ

357
00:53:36,450 --> 00:53:36,976
زِيَادَةً عَلَى الْمَدِّ الطَّبِيعِيِّ الَّذِي لَا تَقُومُ ذَاتُ الْحَرْفِ إِلَّا

358
00:53:36,450 --> 00:53:36,976
بِهِ، وَالْمَدُّ كَمَا قَالَ النَّاظِمُ: [وَالْمَدُّ أَصْلِيٌّ وَفَرْعِيٌّ لَهُ وَسَمِّ

359
00:53:36,450 --> 00:53:36,976
أَوَّلًا طَبِيعِيًّا]،

360
00:53:36,450 --> 00:53:36,976
وَهُوَ يَنْقَسِمُ لِقِسْمَيْنِ: أَصْلِيٌّ وَفَرْعِيٌّ،

361
00:53:36,450 --> 00:53:36,976
الْأَصْلِيُّ أَوَّلًا عِنْدَنَا إِذَا قُلْنَا مَدٌّ نَحْنُ نَتَكَلَّمُ عَنْ ثَلَاثَةِ

362
00:53:36,450 --> 00:53:36,976
أَحْرُفٍ فَقَطْ: الْأَلِفُ،

363
00:53:36,450 --> 00:53:36,976
الْوَاوُ، وَالْيَاءُ،

364
00:53:36,450 --> 00:53:36,976
لَا يَأْتِي الْمَدُّ إِلَّا فِي هَذِهِ الْأَحْرُفِ الثَّلَاثَةِ،

365
00:53:36,450 --> 00:53:36,976
لَا نَتَكَلَّمُ عَنِ الْكَافِ وَلَا النُّونِ،

366
00:53:36,450 --> 00:53:36,976
وَلَا نَتَكَلَّمُ عَنْ وَاوٍ وَأَلِفٍ وَيَاءٍ،

367
00:53:36,450 --> 00:53:36,976
الْمَدُّ الطَّبِيعِيُّ الْأَصْلِيُّ هُوَ أَنْ تَأْتِيَ الْوَاوُ الْمَدِّيَّةُ وَالْيَاءُ الْمَدِّيَّةُ

368
00:53:36,450 --> 00:53:36,976
وَالْأَلِفُ الْمَدِّيَّةُ وَلَا يَأْتِي بَعْدَهَا هَمْزٌ وَلَا سُكُونٌ،

369
00:53:36,450 --> 00:53:36,976
بَلْ يَكُونُ بَعْدَهَا أَيُّ حَرْفٍ مِنْ حُرُوفِ الْهِجَاءِ وَلَا يَكُونُ

370
00:53:36,450 --> 00:53:36,976
هَمْزٌ وَلَا يَكُونُ هَذَا الْحَرْفُ سَاكِنًا بَلْ يَكُونُ مُتَحَرِّكًا،

371
00:53:36,450 --> 00:53:36,976
إِذَا جَاءَتِ الْوَاوُ وَالْأَلِفُ وَالْيَاءُ،

372
00:53:36,450 --> 00:53:36,976
الْوَاوُ وَالْأَلِفُ وَالْيَاءُ وَبَعْدَهَا أَيُّ حَرْفٍ وَيَكُونُ هَذَا الْحَرْفُ مُتَحَرِّكًا

373
00:53:36,450 --> 00:53:36,976
وَلَا يَكُونُ هَمْزٌ فَإِنَّ هَذَا يُمَدُّ مَدًّا طَبِيعِيًّا،

374
00:53:36,450 --> 00:53:36,976
نَحْوُ ﴿قَالَ﴾،

375
00:53:36,450 --> 00:53:36,976
﴿يَقُولُ﴾، ﴿قِيلَ﴾،

376
00:53:36,450 --> 00:53:36,976
﴿الَّذِينَ﴾، ﴿غَيْرِ الْمَغْضُوبِ﴾،

377
00:53:36,450 --> 00:53:36,976
﴿الْمَغْضُوبِ﴾ الْوَاوُ سَاكِنَةٌ بَعْدَهَا الْبَاءُ مَضْمُومٌ عَلَى هَذَا مَدٌّ طَبِيعِيٌّ،

378
00:53:36,450 --> 00:53:36,976
وَهَذَا لَا تَقُومُ ذَاتُ الْحَرْفِ إِلَّا بِهِ،

379
00:53:36,450 --> 00:53:36,976
وَبِهَذَا يَتَبَيَّنُ لَنَا خَطَأُ عَامَّةِ النَّاسِ الَّذِي يَقْرَأُ وَلَا يَأْتِي

380
00:53:36,450 --> 00:53:36,976
بِالْمَدِّ الطَّبِيعِيِّ،

381
00:53:36,450 --> 00:53:36,976
يَقُولُ: [غَيْرِ الْمَغْضُبِ عَلَيْهِمْ]،

382
00:53:36,450 --> 00:53:36,976
[مَغْضُبِ عَلَيْهِ] هَذَا جَاءَ بِضَمَّةٍ،

383
00:53:36,450 --> 00:53:36,976
أَوْ [صِرَاطَ الَّذِنَ أَنْعَمْتَ] هَذَا جَاءَ بِكَسْرَةٍ،

384
00:53:36,450 --> 00:53:36,976
أَوَّلُ الْمَدِّ الْأَصْلِيِّ أَوِ الْمَدِّ الطَّبِيعِيِّ هُوَ أَنْ تَأْتِيَ الْأَلِفُ

385
00:53:36,450 --> 00:53:36,976
أَوِ الْوَاوُ أَوِ الْيَاءُ وَيَأْتِي بَعْدَهَا أَحَدُ حُرُوفِ الْهِجَاءِ مُحَرَّكًا،

386
00:53:36,450 --> 00:53:36,976
أَوْ نَقُولُ وَلَا يَأْتِي بَعْدَهَا سُكُونٌ وَلَا هَمْزٌ،

387
00:53:36,450 --> 00:53:36,976
قَالَ النَّاظِمُ رَحِمَهُ اللَّهُ وَأَمْثِلَتُهُ فِي سُورَةِ الْفَاتِحَةِ كَثِيرَةٌ،

388
00:53:36,450 --> 00:53:36,976
فَنَقْرَأُ سُورَةَ الْفَاتِحَةِ وَنَقُولُ: ﴿بِسْمِ اللَّهِ﴾،

389
00:53:36,450 --> 00:53:36,976
﴿بِسْمِ اللَّهِ﴾ اللَّامُ هَذِهِ حَرْفُ مَدٍّ،

390
00:53:36,450 --> 00:53:36,976
اللَّامُ وَالْأَلِفُ حَرْفُ مَدٍّ ﴿بِسْمِ اللَّهِ﴾ اللَّامُ هِيَ الْأَلِفُ جَاءَ

391
00:53:36,450 --> 00:53:36,976
بَعْدَهَا هَاءٌ الْمَكْسُورَةُ،

392
00:53:36,450 --> 00:53:36,976
﴿الرَّحْمَٰنِ﴾ الْأَلِفُ حَرْفُ مَدٍّ،

393
00:53:36,450 --> 00:53:36,976
﴿الرَّحْمَٰنِ﴾ الْأَلِفُ اللَّامُ بَعْدَ الرَّحْمَنِ لَكِنْ مَدٌّ طَبِيعِيٌّ،

394
00:53:36,450 --> 00:53:36,976
﴿الرَّحِيمِ﴾ الْيَاءُ مَدٌّ طَبِيعِيٌّ،

395
00:53:36,450 --> 00:53:36,976
﴿مَالِكِ﴾ الْأَلِفُ،

396
00:53:36,450 --> 00:53:36,976
﴿الدِّينِ﴾، ﴿الْمَغْضُوبِ﴾ إِلَى آخِرِ الْأَمْثِلَةِ الْكَثِيرَةِ،

397
00:53:36,450 --> 00:53:36,976
وَبِهَذَا يَتَبَيَّنُ لَنَا أَهَمِّيَّةُ هَذَا الْحُكْمِ،

398
00:53:36,450 --> 00:53:36,976
فَلَابُدَّ أَنْ يَمُدَّ الْقَارِئُ مَدًّا طَبِيعِيًّا،

399
00:53:36,450 --> 00:53:36,976
هُنَا قَاعِدَةٌ لَمَّا نَقُولُ مَدٌّ بِمِقْدَارِ حَرَكَةٍ حَرَكَتَيْنِ إِلَى آخِرِهِ

400
00:53:36,450 --> 00:53:36,976
مَاذَا نَقْصِدُ؟

401
00:53:36,450 --> 00:53:36,976
لِلْعُلَمَاءِ فِي تَحْدِيدِ هَذَا الْقَدْرِ الْمَذْهَبُ الْأَوَّلُ بِالْحَرَكَاتِ،

402
00:53:36,450 --> 00:53:36,976
قَالَ وَحَدُّهُ مِقْدَارُ أَلِفٍ وَصْلًا وَوَقْفًا بِأَنْ تَمُدَّ صَوْتَكَ بِقَدْرِ

403
00:53:36,450 --> 00:53:36,976
النُّطْقِ بِحَرَكَتَيْنِ أَحَدُهُمَا حَرَكَةُ الْحَرْفِ الَّذِي قَبْلَ حَرْفِ الْمَدِّ وَالْأُخْرَى

404
00:53:36,450 --> 00:53:36,976
حَرْفُ الْمَدِّ،

405
00:53:36,450 --> 00:53:36,976
فَتَقُولُ: بَا بَا،

406
00:53:36,450 --> 00:53:36,976
فَبَعْضُهُمْ يُقَدِّرُهُ بِالْحَرَكَاتِ،

407
00:53:36,450 --> 00:53:36,976
هَذَا مَنْهَجُ الْعُلَمَاءِ الْمُتَقَدِّمِينَ،

408
00:53:36,450 --> 00:53:36,976
يَقُولُ: بَا بَا بِقَدْرِ هَذَا الزَّمَنِ،

409
00:53:36,450 --> 00:53:36,976
فَتَقُولُ: ﴿الَّذِينَ﴾ بِقَدْرِ بَا بَا،

410
00:53:36,450 --> 00:53:36,976
بَعْضُ الْعُلَمَاءِ الْمُتَأَخِّرِينَ يَقُولُ بِحَرَكَةِ الْأُصْبُعِ،

411
00:53:36,450 --> 00:53:36,976
فَتَقْبِضُ الْأُصْبُعَ هَذِهِ حَرَكَةٌ،

412
00:53:36,450 --> 00:53:36,976
تَقْبِضُ الثَّانِيَ أَوْ تَقْبِضُهُ وَتَفْتَحُهُ هَذِهِ عِبَارَةٌ عَنْ حَرَكَتَيْنِ،

413
00:53:36,450 --> 00:53:36,976
لَكِنَّ هَذَا لَا يَنْضَبِطُ لِأَنَّ هُنَاكَ بُطْءٌ فِي الْحَرَكَةِ،

414
00:53:36,450 --> 00:53:36,976
هُنَاكَ إِنْسَانٌ مِزَاجُهُ مُعْتَدِلٌ يَعُدُّ بِبُطْءٍ،

415
00:53:36,450 --> 00:53:36,976
هُنَاكَ إِنْسَانٌ مُغْضَبٌ يَعُدُّ بِسُرْعَةٍ،

416
00:53:36,450 --> 00:53:36,976
فَيَخْتَلِفُ هَذَا،

417
00:53:36,450 --> 00:53:36,976
الْأَدَقُّ هُوَ مَنْهَجُ الْمُتَقَدِّمِينَ أَنْ يَقُولُونَ عِبَارَةٌ عَنْ حَرَكَتَيْنِ،

418
00:53:36,450 --> 00:53:36,976
يُعَبَّرُ عَنْهُ بِحَرَكَتَيْنِ: بَا بَا،

419
00:53:36,450 --> 00:53:36,976
تَا تَا،

420
00:53:36,450 --> 00:53:36,976
وَنَحْوُ ذَلِكَ،

421
00:53:36,450 --> 00:53:36,976
قَالَ بَلْ أَيُّ حَرْفٍ غَيْرِ غَيْرِ هَمْزٍ أَوْ سُكُونٍ جَاءَ

422
00:53:36,450 --> 00:53:36,976
بَعْدَ مَدٍّ الطَّبِيعِيُّ يَكُونُ،

423
00:53:36,450 --> 00:53:36,976
هَذَا النَّوْعُ الْأَوَّلُ،

424
00:53:36,450 --> 00:53:36,976
النَّوْعُ الثَّانِي الْمَدُّ الْفَرْعِيُّ هُوَ أَنْ تَأْتِيَ الْأَلِفُ أَوِ الْوَاوُ

425
00:53:36,450 --> 00:53:36,976
أَوِ الْيَاءُ وَيَأْتِي بَعْدَهَا هَمْزٌ أَوْ سُكُونٌ،

426
00:53:36,450 --> 00:53:36,976
هَمْزٌ مِثْلُ ﴿جَاءَ﴾،

427
00:53:36,450 --> 00:53:36,976
﴿مَاءَ﴾، ﴿مَلَائِكَةُ﴾،

428
00:53:36,450 --> 00:53:36,976
﴿قَالُوا إِنْ أَنْتُمْ﴾،

429
00:53:36,450 --> 00:53:36,976
أَوْ سُكُونٌ مِثْلُ ﴿الطَّامَّةُ﴾،

430
00:53:36,450 --> 00:53:36,976
﴿آلْآنَ﴾، أَوْ ﴿نَسْتَعِينُ﴾ إِذَا وَقَفْنَا عَلَيْهَا،

431
00:53:36,450 --> 00:53:36,976
هَذَا الَّذِي سَبَبُهُ الْهَمْزُ وَسَبَبُهُ السُّكُونُ أَنْوَاعٌ سَيَأْتِي بَيَانُهَا بَعْدَ

432
00:53:36,450 --> 00:53:36,976
قَلِيلٍ، لَكِنَّ هَذَا مِنْ حَيْثُ الْعُمُومُ؛ وَالْآخَرُ الْفَرْعِيُّ مَوْقُوفٌ عَلَى

433
00:53:36,450 --> 00:53:36,976
... سَبَبْ كَهَمْزٍ أَوْ سُكُونٍ مُسْجَلَا أَوْ هُمَا أَيْ يَجْتَمِعُ

434
00:53:36,450 --> 00:53:36,976
الْهَمْزُ وَالسُّكُونُ مِثْلُ ذَلِكَ ﴿السَّمَاءُ﴾ حَالَ وَقْفٍ عَلَيْهَا،

435
00:53:36,450 --> 00:53:36,976
عِنْدَنَا بَعْدَهَا الْأَلِفُ هَمْزَةٌ وَهَذِهِ الْهَمْزَةُ سَاكِنَةٌ فَقَدْ يَجْتَمِعَانِ،

436
00:53:36,450 --> 00:53:36,976
قَالَ أَوْ هُمَا أَيْ بِأَنْ يَجْتَمِعَ الْهَمْزَةُ نَحْبُ قَوْلِهِ تَعَالَى

437
00:53:36,450 --> 00:53:36,976
﴿السَّمَاءُ﴾، قَالَ وَلِلْمَدِّ سَبَبٌ آخَرُ مَعْنَوِيٌّ،

438
00:53:36,450 --> 00:53:36,976
إِذَا عِنْدَنَا الْمَدُّ سَبَبَانِ: الْهَمْزَةُ أَوِ السُّكُونُ،

439
00:53:36,450 --> 00:53:36,976
الْمَدُّ الْفَرْعِيُّ هُنَاكَ سَبَبٌ آخَرُ مَعْنَوِيٌّ وَيَنْقَسِمُ إِلَى قِسْمَيْنِ: مَدُّ

440
00:53:36,450 --> 00:53:36,976
تَعْظِيمٍ وَهَذَا فِي [لَا إِلَهَ إِلَّا اللَّهُ]،

441
00:53:36,450 --> 00:53:36,976
[لَا إِلَهَ إِلَّا اللَّهُ] كَمَا يَمُدُّ بِهِ أَصْحَابُ الْقَصْرِ،

442
00:53:36,450 --> 00:53:36,976
لَكِنَّ أَصْحَابَ الْقَصْرِ إِذَا جَاءُوا إِلَى هَذَا الْمَوْضِعِ قَالُوا: [لَا

443
00:53:36,450 --> 00:53:36,976
إِلَهَ] تَعْظِيمًا لِلَّهِ سُبْحَانَهُ وَتَعَالَى،

444
00:53:36,450 --> 00:53:36,976
أَوْ مَدُّ التَّبْرِئَةِ وَهَذَا رُوِيَ عَنْ حَمْزَةَ ﴿لَا رَيْبَ فِيهِ﴾

445
00:53:36,450 --> 00:53:36,976
فَيَقُولُ: [لَا رَيْبَ فِيهِ] بِحَدِّ وَسَطٍ وَيُشْبِعُهُ إِذَا كَانَ بَعْدَهُ

446
00:53:36,450 --> 00:53:36,976
حَمْزَةُ، وَيُشْبِعُهُ إِذَا كَانَ بَعْدَهُ حَمْزَةُ يَقُولُ: ﴿لَا إِكْرَاهَ﴾ عَامِلًا

447
00:53:36,450 --> 00:53:36,976
بِأَقْوَى السَّبَبَيْنِ،

448
00:53:36,450 --> 00:53:36,976
إِذَا الْمَدُّ الْفَرْعِيُّ نَسْتَطِيعُ أَنْ نَقُولَ لَهُ ثَلَاثَةُ أَسْبَابٍ: هَمْزٌ،

449
00:53:36,450 --> 00:53:36,976
سُكُونٌ، مَعْنَوِيٌّ،

450
00:53:36,450 --> 00:53:36,976
الْمَعْنَوِيُّ عَلَى قِسْمَيْنِ: تَعْظِيمٌ وَتَبْرِئَةٌ،

451
00:53:36,450 --> 00:53:36,976
لَكِنَّ هَذَا قَلِيلٌ هَذَا عِنْدَ بَعْضِ الْقُرَّاءِ،

452
00:53:36,450 --> 00:53:36,976
وَلِذَلِكَ جُلُّ مَنْ يَشْرَحُ [التُّحْفَةَ] يَذْكُرُ فَقَطِ السُّؤَالَ الَّذِي ذَكَرَهُ

453
00:53:36,450 --> 00:53:36,976
النَّاظِمُ: هَمْزٌ أَوْ سُكُونٌ؛ حُرُوفُهُ ثَلَاثَةٌ فَعِيهَا ...

454
00:53:36,450 --> 00:53:36,976
مِنْ لَفْظِ وَايٍ وَهِيَ فِي نُوحِيهَا حُرُوفُ الْمَدِّ لَمَّا نَتَكَلَّمُ

455
00:53:36,450 --> 00:53:36,976
عَلَى الْمَدِّ كَمَا سَبَقَ نَحْنُ نَتَكَلَّمُ عَنْ ثَلَاثِ أَحْرُفٍ فَقَطْ:

456
00:53:36,450 --> 00:53:36,976
الْأَلِفُ وَالْوَاوُ وَالْيَاءُ،

457
00:53:36,450 --> 00:53:36,976
لَكِنْ بِشُرُوطِهَا،

458
00:53:36,450 --> 00:53:36,976
وَهُوَ أَنْ تَأْتِيَ الْحَرَكَةُ مُجَانِسَةً لِلْحَرْفِ،

459
00:53:36,450 --> 00:53:36,976
فَتَأْتِي الْوَاوُ سَاكِنَةً قَبْلَهَا ضَمٌّ،

460
00:53:36,450 --> 00:53:36,976
وَالْيَاءُ سَاكِنَةً قَبْلَهَا كَسْرٌ،

461
00:53:36,450 --> 00:53:36,976
وَالْأَلِفُ سَاكِنَةً قَبْلَهَا فَتْحٌ،

462
00:53:36,450 --> 00:53:36,976
وَهِيَ دَائِمًا كَذَلِكَ سَاكِنَةٌ قَبْلَهَا فَتْحٌ،

463
00:53:36,450 --> 00:53:36,976
فَهِيَ دَائِمٌ حَرْفُ مَدٍّ وَحَرْفُ لِينٍ،

464
00:53:36,450 --> 00:53:36,976
قَالَ ﴿نُوحِيهَا﴾ أَيْ مِثَالٌ جَمَعَ الْأَحْرُفَ بِشُرُوطِهَا ﴿نُوحِيهَا﴾،

465
00:53:36,450 --> 00:53:36,976
الْوَاوُ سَاكِنَةٌ قَبْلَهَا ضَمُّ النُّونِ،

466
00:53:36,450 --> 00:53:36,976
وَالْيَاءُ سَاكِنَةٌ قَبْلَهَا كَسْرُ الْحَاءِ،

467
00:53:36,450 --> 00:53:36,976
وَالْأَلِفُ سَاكِنَةٌ قَبْلَهَا فَتْحُ الْهَاءِ،

468
00:53:36,450 --> 00:53:36,976
وَكَذَلِكَ قَالَ الشَّارِحُ كَلِمَةُ ﴿أُوتِينَا﴾،

469
00:53:36,450 --> 00:53:36,976
وَكَذَلِكَ كَلِمَةُ ﴿أُوذِينَا﴾؛ وَالْكَسْرُ قَبْلَ الْيَا وَقَبْلَ الْوَاوِ ضَمْ ...

470
00:53:36,450 --> 00:53:36,976
شَرْطٌ وَفَتْحٌ قَبْلَ أَلْفٍ يُلْتَزَمْ لَابُدَّ إِنْ كَانَتْ حَرْفَ مَدٍّ

471
00:53:36,450 --> 00:53:36,976
أَنْ تَكُونَ الْأَلِفُ يُلْتَزَمُ،

472
00:53:36,450 --> 00:53:36,976
الْأَلِفُ دَائِمٌ هَكَذَا سَاكِنَةٌ قَبْلَهَا مَفْتُوحٌ،

473
00:53:36,450 --> 00:53:36,976
وَهِيَ دَائِمٌ حَرْفُ مَدٍّ وَحَرْفُ لِينٍ؛ وَاللِّينُ مِنْهَا الْيَا وَوَاوٌ

474
00:53:36,450 --> 00:53:36,976
سُكِّنَا ...

475
00:53:36,450 --> 00:53:36,976
إِنِ انْفِتَاحٌ قَبْلَ كُلٍّ أُعْلِنَا إِذَا جَاءَتِ الْيَاءُ سَاكِنَةً قَبْلَهَا

476
00:53:36,450 --> 00:53:36,976
فَتْحٌ، وَالْوَاوُ سَاكِنَةً قَبْلَهَا فَتْحٌ،

477
00:53:36,450 --> 00:53:36,976
تُسَمَّيَانِ حَرْفَ لِينٍ،

478
00:53:36,450 --> 00:53:36,976
وَالْأَلِفُ دَائِمٌ هَكَذَا أَيْضًا هِيَ حَرْفُ لِينٍ أَنَّهَا سَاكِنَةٌ قَبْلَهَا

479
00:53:36,450 --> 00:53:36,976
فَتْحٌ، إِذَا عِنْدَنَا الْوَاوُ وَالْيَاءُ لَهُمَا ثَلَاثَةُ أَحْوَالٍ: الْحَالُ الْأُولَى:

480
00:53:36,450 --> 00:53:36,976
أَنْ يَكُونَ حَرْفَ مَدٍّ،

481
00:53:36,450 --> 00:53:36,976
وَذَلِكَ بِأَنْ تَسْكُنَ الْوَاوُ وَيَكُونَ قَبْلَهَا ضَمٌّ،

482
00:53:36,450 --> 00:53:36,976
تَسْكُنَ الْيَاءُ وَيَكُونَ قَبْلَهَا كَسْرٌ،

483
00:53:36,450 --> 00:53:36,976
وَالْحَالُ الثَّانِيَةُ: أَنْ يَكُونَ حَرْفَ لِينٍ،

484
00:53:36,450 --> 00:53:36,976
وَذَلِكَ بِأَنْ تَسْكُنَهَا وَيَكُونَ قَبْلَهُمَا فَتْحٌ مِثْلُ [بَيْتٍ]،

485
00:53:36,450 --> 00:53:36,976
[خَوْفٍ]، وَالْحَالَةُ الثَّالِثَةُ: أَنْ تَكُونَا حَرْفَ عِلَّةٍ،

486
00:53:36,450 --> 00:53:36,976
وَهَذَا إِذَا تَحَرَّكَ الْوَاوُ وَالْيَاءُ،

487
00:53:36,450 --> 00:53:36,976
فَإِذَا رَأَيْتَ وَاوًا مُتَحَرِّكَةً فَاعْلَمْ أَنَّهَا مُعْتَلَّةٌ.
