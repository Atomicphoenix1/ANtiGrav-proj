1
00:00:07,790 --> 00:00:11,637
السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ،

2
00:00:11,637 --> 00:00:14,714
الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ،

3
00:00:14,714 --> 00:00:17,791
وَالصَّلَاةُ وَالسَّلَامُ عَلَى أَشْرَفِ

4
00:00:17,791 --> 00:00:21,239
الْأَنْبِيَاءِ وَالْمُرْسَلِينَ نَبِيِّنَا مُحَمَّدٍ وَعَلَى

5
00:00:21,239 --> 00:00:24,421
آلِهِ وَصَحْبِهِ وَمَنْ تَبِعَهُمْ بِإِحْسَانٍ

6
00:00:24,421 --> 00:00:26,330
إِلَى يَوْمِ الدِّينِ،

7
00:00:26,330 --> 00:00:29,582
أَمَّا بَعْدُ؛ فَهَذَا هُوَ الْمَجْلِسُ

8
00:00:29,582 --> 00:00:32,833
الثَّانِي فِي شَرْحِ الْمُقَرَّرِ الثَّالِثِ

9
00:00:32,833 --> 00:00:36,085
مِنْ مُقَرَّرَاتِ بَرْنَامَجِ التَّيْسِيرِ لِعُلُومِ

10
00:00:36,085 --> 00:00:39,336
الْقُرْآنِ وَالتَّفْسِيرِ فِي سَنَتِهِ السَّابِعَةِ،

11
00:00:39,336 --> 00:00:42,588
الْمُوَافِقِ لِلْيَوْمِ السَّابِعِ وَالْعِشْرِينَ مِنْ

12
00:00:42,588 --> 00:00:45,839
شَهْرِ شَوَّالٍ لِعَامِ أَلْفٍ وَأَرْبَعِمِائَةٍ

13
00:00:45,839 --> 00:00:47,790
وَسَبْعٍ وَأَرْبَعِينَ هِجْرِيَّةً،

14
00:00:47,790 --> 00:00:50,950
وَالْمُقَرَّرُ الثَّالِثُ هُوَ [مِنْحَةُ

15
00:00:50,950 --> 00:00:54,110
ذِي الْجَلَالِ فِي شَرْحِ

16
00:00:54,110 --> 00:00:57,567
تُحْفَةِ الْأَطْفَالِ] لِلْعَلَّامَةِ الْمُقَرِّرِ عَلِيِّ

17
00:00:57,567 --> 00:01:00,661
بْنِ مُحَمَّدٍ الضَّبَّاعِ الْمُتَوَفَّى فِي

18
00:01:00,661 --> 00:01:03,755
سَنَةِ أَلْفٍ وَثَلَاثِمِائَةٍ وَثَمَانِينَ هِجْرِيَّةً،

19
00:01:03,755 --> 00:01:06,848
وَقَدِ انْتَهَتْ بِنَا قِرَاءَتُهُ إِلَى

20
00:01:06,848 --> 00:01:09,942
قَوْلِ النَّاظِمِ رَحِمَهُ اللَّهُ: [وَغُنَّ مِيمًا

21
00:01:09,942 --> 00:01:13,035
ثُمَّ نُونًا شُدِّدَا * وَسَمِّ كُلًّا

22
00:01:13,035 --> 00:01:14,891
حَرْفَ غُنَّةٍ بَدَا]،

23
00:01:14,891 --> 00:01:19,047
نَعَمْ؛ بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ،

24
00:01:19,047 --> 00:01:22,505
الصَّلَاةُ وَالسَّلَامُ عَلَى أَشْرَفِ

25
00:01:22,505 --> 00:01:25,963
الْأَنْبِيَاءِ وَالْمُرْسَلِينَ نَبِيِّنَا مُحَمَّدٍ

26
00:01:25,963 --> 00:01:29,420
وَعَلَى آلِهِ وَصَحْبِهِ أَجْمَعِينَ،

27
00:01:29,420 --> 00:01:30,983
اللَّهُمَّ اغْفِرْ لَنَا وَلِشَيْخِنَا وَلِلْحَاضِرِينَ وَالْبَادِيَةِ،

28
00:01:30,980 --> 00:01:34,120
وَلِشَيْخِنَا وَالسَّامِعِينَ وَالْمُسْلِمِينَ أَجْمَعِينَ،

29
00:01:34,120 --> 00:01:37,298
قَالَ النَّاظِمُ رَحِمَهُ اللَّهُ تَعَالَى:

30
00:01:37,298 --> 00:01:40,772
[حُكْمُ النُّونِ وَالْمِيمِ الْمُشَدَّدَتَيْنِ] وَغُنَّ مِيمًا

31
00:01:40,772 --> 00:01:42,170
ثُمَّ نُونًا شُدِّدَا ...

32
00:01:42,170 --> 00:01:45,477
وَسَمِّ كُلًّا حَرْفَ غُنَّةٍ بَدَا الشَّرْحُ: [وَغُنَّ]

33
00:01:45,477 --> 00:01:48,895
بِضَمِّ الْغَيْنِ الْمُعْجَمَةِ وَتَشْدِيدِ النُّونِ وَفَتْحِهَا فِعْلُ

34
00:01:48,895 --> 00:01:50,360
أَمْرٍ أَيْ أَظْهِرِ الْغُنَّةَ،

35
00:01:50,360 --> 00:01:52,360
[وَمِيمًا] بِالنَّصْبِ مَفْعُولٌ لِـ [غُنَّ]،

36
00:01:52,360 --> 00:01:55,860
[ثُمَّ] غُنَّ [نُونًا] وَلَوْ تَنْوِينًا لِتَسْمِيَتِهِ نُونًا،

37
00:01:55,860 --> 00:01:58,936
[شُدِّدَا] بِالْبِنَاءِ لِلْمَجْهُولِ وَالْأَلِفُ لِلتَّثْنِيَةِ عَائِدٌ

38
00:01:58,936 --> 00:02:00,513
عَلَى الْمِيمِ وَالنُّونِ،

39
00:02:00,513 --> 00:02:03,597
فَالْغُنَّةُ صِفَةٌ لَازِمَةٌ لَهُمَا مُطْلَقًا إِلَّا

40
00:02:03,597 --> 00:02:06,800
أَنَّهُمَا إِذَا شُدِّدَتَا كَانَ إِظْهَارُ غُنَّتِهِمَا أَكَدَ،

41
00:02:06,800 --> 00:02:09,650
نَحْوُ: ﴿مِنَ الْجِنَّةِ﴾،

42
00:02:09,650 --> 00:02:11,550
﴿إِنِّي﴾، ﴿وَذَا النُّونِ﴾،

43
00:02:11,550 --> 00:02:12,500
﴿وَالنَّاسِ﴾،

44
00:02:29,289 --> 00:02:30,574
﴿مِنْ نَذِيرٍ﴾،

45
00:02:29,931 --> 00:02:30,574
وَنَحْوُ: ﴿ثُمَّ﴾،

46
00:02:29,931 --> 00:02:30,574
﴿الْمُزَّمِّلُ﴾، ﴿فَأُمُّهُ﴾،

47
00:02:29,931 --> 00:02:30,574
وَهِيَ

48
00:02:41,720 --> 00:02:42,613
فِي السَّاكِنِ أَكْمَلُ

49
00:02:47,845 --> 00:02:48,444
مِنْهَا

50
00:02:57,506 --> 00:02:58,363
فِي الْمُتَحَرِّكِ،

51
00:02:57,934 --> 00:02:58,363
وَفِي الْمُتَحَرِّكِ أَكْمَلُ مِنْهَا

52
00:03:20,970 --> 00:03:22,470
فِي الْمُظْهَرِ،

53
00:03:21,720 --> 00:03:22,470
وَفِي الْمُدْغَمِ

54
00:03:55,255 --> 00:03:57,360
أَكْمَلُ مِنْهَا فِي الْمُخْفَى،

55
00:03:56,834 --> 00:03:57,360
[وَسَمِّ] أَنْتَ [كُلًّا]

56
00:04:20,693 --> 00:04:22,249
مِنَ الْمِيمِ وَالنُّونِ الْمُشَدَّدَتَيْنِ [حَرْفَ غُنَّةٍ] مُشَدَّدًا

57
00:04:35,198 --> 00:04:36,765
أَوْ حَرْفًا أَغَنَّ مُشَدَّدًا،

58
00:04:35,982 --> 00:04:36,765
وَقَوْلُهُ: [بَدَا] أَيْ ظَهَرَ تَكْمِلَةٌ لِلْبَيْتِ،

59
00:04:35,982 --> 00:04:39,117
وَلْيَحْتَرِزِ الْقَارِئُ عَنِ الْمَدِّ عِنْدَ الْإِتْيَانِ

60
00:04:39,117 --> 00:04:42,252
بِالْغُنَّةِ فِي النُّونِ وَالْمِيمِ

61
00:04:42,252 --> 00:04:45,387
بِنَحْوِ: ﴿إِنَّ

62
00:04:45,387 --> 00:04:46,955
الَّذِينَ﴾ وَ ﴿أَمَّا﴾ بَدَلًا لِأَنْ

63
00:04:59,868 --> 00:05:01,038
لَا يَتَوَلَّدَ مِنْهَا حَرْفُ مَدٍّ فَيَصِيرُ اللَّفْظُ: [إِينَّ الَّذِينَ] وَ

64
00:05:19,349 --> 00:05:20,888
[آَمَّا] بَدَلًا كَمَا يَفْعَلُهُ بَعْضُ الْقُرَّاءِ الْمُتَعَسِّفِينَ،

65
00:05:20,118 --> 00:05:20,888
وَهُوَ خَطَأٌ صَرِيحٌ وَزِيَادَةٌ

66
00:05:25,503 --> 00:05:28,580
فِي كَلَامِ اللَّهِ تَعَالَى؛ ثُمَّ ذَكَرَ النَّاظِمُ

67
00:05:33,541 --> 00:05:34,924
رَحِمَهُ اللَّهُ أَحْكَامَ النُّونِ

68
00:05:38,151 --> 00:05:39,073
وَالْمِيمِ الْمُشَدَّدَتَيْنِ أَوْ أَحْكَامَ،

69
00:05:38,612 --> 00:05:39,073
قَالَ: [وَغُنَّ مِيمًا ثُمَّ نُونًا شُدِّدَا]،

70
00:05:38,612 --> 00:05:39,073
وَالْغُنَّةُ كَمَا سَبَقَتْ مَعَنَا اصْطِلَاحًا هِيَ صَوْتٌ مَزِيدٌ مُرَكَّبٌ فِي

71
00:05:38,612 --> 00:05:39,073
جِسْمِ النُّونِ

72
00:05:46,450 --> 00:05:47,372
وَالْمِيمِ يَخْرُجُ مِنَ الْخَيْشُومِ لَا عَمَلَ لِلِسَانِ أَوِ الشَّفَتَيْنِ فِيهِ،

73
00:05:46,911 --> 00:05:47,372
وَذَكَرَ الشَّارِحُ رَحِمَهُ اللَّهُ بَعْضَ الْأَمْثِلَةِ قَالَ نَحْوُ قَوْلِهِ: ﴿مِنَ

74
00:05:46,911 --> 00:05:47,372
الْجِنَّةِ﴾، ﴿إِنِّي﴾،

75
00:05:46,911 --> 00:05:47,372
﴿وَذَا النُّونِ﴾،

76
00:05:46,911 --> 00:05:47,372
﴿النَّاسِ﴾، ﴿ثُمَّ﴾،

77
00:05:46,911 --> 00:05:47,372
﴿الْمُزَّمِّلُ﴾ إِلَى آخِرِ هَذِهِ الْأَمْثِلَةِ،

78
00:05:46,911 --> 00:05:47,372
ثُمَّ نَبَّهَ الشَّارِحُ رَحِمَهُ اللَّهُ عَلَى

79
00:05:51,548 --> 00:05:52,954
أَنَّ الْغُنَّةَ تَكُونُ عَلَى مَرَاتِبَ قَالَ: وَهِيَ فِي السَّاكِنِ أَكْمَلُ

80
00:05:52,485 --> 00:05:52,954
مِنْهَا فِي الْمُتَحَرِّكِ،

81
00:05:52,485 --> 00:05:52,954
وَلَوْلَا يُقَالُ هِيَ فِي السَّاكِنِ الْمُظْهَرِ أَوْلَى مِنْهَا فِي الْمُتَحَرِّكِ،

82
00:05:52,485 --> 00:05:52,954
وَفِي الْمُتَحَرِّكِ أَكْمَلُ مِنْهَا فِي الْمُظْهَرِ،

83
00:05:52,485 --> 00:05:52,954
وَفِي الْمُدْغَمِ أَكْمَلُ مِنَ الْمُظْهَرِ،

84
00:05:52,485 --> 00:05:52,954
وَهَذِهِ ثَلَاثُ مَرَاتِبَ لِلْغُنَّةِ،

85
00:05:52,485 --> 00:05:52,954
ثُمَّ نَبَّهَ الشَّارِحُ رَحِمَهُ اللَّهُ عَزَّ وَجَلَّ بِسْمِ اللَّهِ عَلَى

86
00:05:52,485 --> 00:05:52,954
تَنْبِيهٍ نَفِيسٍ قَالَ: وَلْيَحْتَرِزِ الْقَارِئُ عَنِ الْمَدِّ أَوْ عَنِ الْمَدِّ

87
00:05:52,485 --> 00:05:53,422
عِنْدَ الْإِتْيَانِ بِالْغُنَّةِ فِي النُّونِ وَالْمِيمِ نَحْوُ قَوْلِهِ تَعَالَى: ﴿إِنَّ

88
00:05:53,422 --> 00:05:56,701
الَّذِينَ﴾ هَكَذَا تَقْرَؤُهَا: ﴿إِنَّ الَّذِينَ﴾،

89
00:05:56,233 --> 00:05:56,701
بَعْضُ النَّاسِ يَتَكَلَّفُ لِلْغُنَّةِ فَيَأْتِي بِمَدَّةٍ

90
00:05:59,980 --> 00:06:00,917
قَبْلَ النُّونِ الْمُشَدَّدَةِ يَقُولُ: [إِينَّ الَّذِينَ] وَ [آَمَّا] بَدَلًا،

91
00:06:00,449 --> 00:06:00,917
وَهَذَا

92
00:06:10,286 --> 00:06:11,223
لَا يَجُوزُ

93
00:06:25,640 --> 00:06:26,579
كَمَا قَالَ الشَّارِحُ كَمَا يَفْعَلُهُ بَعْضُ الْقُرَّاءِ الْمُتَعَسِّفِينَ وَهُوَ خَطَأٌ

94
00:06:26,109 --> 00:06:27,048
صَرِيحٌ وَزِيَادَةٌ فِي كَلَامِ اللَّهِ،

95
00:06:26,579 --> 00:06:27,048
إِنَّمَا تَأْتِي بِالْغُنَّةِ دُونَ هَذِهِ الزِّيَادَاتِ تَقُولُ: [إِنَّ] الْمُبَاشَرَةَ،

96
00:06:26,579 --> 00:06:27,048
هَمْزَةٌ مَكْسُورَةٌ بَعْدَهَا النُّونُ الْمُشَدَّدَةُ: [إِنَّ]،

97
00:06:26,579 --> 00:06:27,048
[أَمَّا]، وَلَا تَقُلْ: [إِينَّ]،

98
00:06:26,579 --> 00:06:27,048
[آَمَّا]، فَإِنَّ هَذَا زِيَادَةٌ فِي كَلَامِ اللَّهِ،

99
00:06:26,579 --> 00:06:29,394
نَعَمْ؛ أَحْكَامُ الْمِيمِ السَّاكِنَةِ وَالْمِيمُ إِنْ تَسْكُنْ تَجِي قَبْلَ الْهِجَا

100
00:06:28,925 --> 00:06:29,394
... لَا أَلِفٍ لَيِّنَةٍ لِذِي الْحِجَا

101
00:06:51,060 --> 00:06:52,108
الشَّرْحُ: [الْمِيمُ] مُبْتَدَأٌ وَجُمْلَةُ

102
00:06:54,727 --> 00:06:58,917
[إِنْ تَسْكُنْ] حَالٌ أَيْ وَالْمِيمُ حَالَ سُكُونِهَا،

103
00:06:58,917 --> 00:06:59,441
وَقَوْلُهُ: [تَجِي] بِالْهَمْزِ السَّاكِنِ وَتَرْكِهِ خَبَرُ الْمُبْتَدَأِ،

104
00:06:58,917 --> 00:06:59,441
وَيَصِحُّ

105
00:07:17,393 --> 00:07:18,060
أَنْ تَكُونَ جُمْلَةُ [إِنْ تَسْكُنْ تَجِي] خَبَرُ الْمُبْتَدَأِ،

106
00:07:17,727 --> 00:07:18,060
وَقَوْلُهُ: [قَبْلَ الْهِجَا] ظَرْفٌ لِـ [تَجِي]،

107
00:07:17,727 --> 00:07:18,060
وَالْهِجَا بِالْقَصْرِ لِنِيَّةِ الْوَقْفِ وَهُوَ تَعْدِيدُ الْحُرُوفِ بِأَسْمَائِهَا كَأَنْ تَقُولَ:

108
00:07:17,727 --> 00:07:18,060
[بَكْرٌ] حُرُوفُهُ الْبَاءُ وَالْكَافُ وَالرَّاءُ،

109
00:07:17,727 --> 00:07:18,060
وَقَوْلُهُ: [لَا أَلِفٍ لَيِّنَةٍ] لَا نَافِيَةٌ بِمَعْنَى غَيْرِ

110
00:07:30,127 --> 00:07:31,193
أَيْ غَيْرِ

111
00:08:00,092 --> 00:08:01,383
الْأَلِفِ السَّاكِنَةِ إِذْ

112
00:08:29,660 --> 00:08:30,860
لَا تَأْتِي قَبْلَهَا لِأَنَّ مَا قَبْلَهَا يَكُونُ مَفْتُوحًا دَائِمًا،

113
00:08:30,260 --> 00:08:30,860
وَقَوْلُهُ: [لِذِي] أَيْ لِصَاحِبِ [الْحِجَا] بِكَسْرِ الْحَاءِ وَبِالْجِيمِ أَيْ كَمَالِ

114
00:08:30,260 --> 00:08:30,860
الْعَقْلِ وَالْفِطْنَةِ وَالْمِقْدَارِ كَمَا

115
00:08:48,860 --> 00:08:50,060
فِي [الْقَامُوسِ]،

116
00:08:49,460 --> 00:08:50,060
ثُمَّ ذَكَرَ أَحْكَامَ

117
00:08:52,483 --> 00:08:54,098
الْمِيمِ الثَّلَاثَةَ بِقَوْلِهِ: أَحْكَامُهَا ثَلَاثَةٌ لِمَنْ ضَبَطْ ...

118
00:08:53,291 --> 00:08:54,098
إِخْفَاءٌ ادْغَامٌ وَإِظْهَارٌ فَقَطْ [أَحْكَامُهَا ثَلَاثَةٌ لِمَنْ ضَبَطْ] أَيْ حَفِظَ

119
00:08:53,291 --> 00:08:54,098
وَهِيَ: إِخْفَاءٌ،

120
00:08:53,291 --> 00:08:54,098
ادْغَامٌ بِنَقْلِ حَرَكَةِ الْهَمْزَةِ لِلسَّاكِنِ قَبْلَهَا مَعْطُوفٌ بِحَرْفِ عَطْفٍ مَحْذُوفٍ،

121
00:08:53,291 --> 00:08:54,098
وَإِظْهَارٌ، وَتَقَدَّمَ مَعْنَى كُلٍّ مِنَ الثَّلَاثَةِ،

122
00:08:53,291 --> 00:08:56,522
وَقَوْلُهُ: [فَقَطْ] تَكْمِلَةٌ لِلْبَيْتِ؛ فَالْأَوَّلُ الْإِخْفَاءُ عِنْدَ الْبَاءِ ...

123
00:08:55,714 --> 00:08:56,522
وَسَمِّهِ الشَّفْوِيَّ لِلْقُرَّاءِ الشَّرْحُ: فَالْأَوَّلُ مِنْهَا الْإِخْفَاءُ لَهَا مَعَ الْغُنَّةِ

124
00:09:01,368 --> 00:09:02,983
إِنْ وَقَعَتْ قَبْلَ الْبَاءِ الْمُوَحَّدَةِ سَوَاءٌ كَانَ سُكُونُهَا مُتَأَصِّلًا نَحْوُ:

125
00:09:10,252 --> 00:09:14,291
﴿يَعْتَصِمْ بِاللَّهِ﴾ وَ ﴿يَوْمَهُمْ بَارِزُونَ﴾،

126
00:09:14,291 --> 00:09:16,714
أَوْ عَارِضًا نَحْوُ: ﴿بِأَعْلَمَ بِالشَّاكِرِينَ﴾ وَ

127
00:09:22,500 --> 00:09:25,260
﴿أَعْلَمَ بِالظَّالِمِينَ﴾

128
00:09:45,613 --> 00:09:46,871
فِي قِرَاءَةِ أَبِي عَمْرٍو وَيَعْقُوبَ،

129
00:09:55,643 --> 00:09:57,000
وَهَذَا هُوَ الْمُخْتَارُ

130
00:10:02,429 --> 00:10:03,786
الَّذِي عَلَيْهِ جُمْهُورُ أَهْلِ الْأَدَاءِ،

131
00:10:03,107 --> 00:10:03,786
وَذَهَبَ جَمَاعَةٌ

132
00:10:23,389 --> 00:10:24,796
إِلَى إِظْهَارِهَا عِنْدَهَا إِظْهَارًا تَامًّا

133
00:10:36,150 --> 00:10:36,950
مِنْ غَيْرِ غُنَّةٍ وَالْعَمَلُ عَلَى الْأَوَّلِ،

134
00:10:36,550 --> 00:10:38,821
وَوَجْهُهُ أَنَّ الْمِيمَ وَالْبَاءَ لَمَّا اشْتَرَكَا فِي الْمَخْرَجِ وَتَجَانَسَا

135
00:10:39,893 --> 00:10:40,607
فِي الِانْفِتَاحِ وَالِاسْتِفَالِ فَثَقُلَ الْإِظْهَارُ وَالْإِدْغَامُ الْمَحْضُ فَعُدِلَ إِلَى الْإِخْفَاءِ،

136
00:10:40,250 --> 00:10:40,607
[وَسَمِّهِ]

137
00:10:55,188 --> 00:10:56,062
أَنْتَ الْإِخْفَاءَ [الشَّفْوِيَّ] بِسُكُونِ الْفَاءِ لِضَرُورَةِ

138
00:11:12,345 --> 00:11:13,440
النَّظْمِ [لِلْقُرَّاءِ] أَيْ عِنْدَهُمْ وَذَلِكَ لِأَنَّهُ يَخْرُجُ مِنَ الشَّفَتَيْنِ؛ ثُمَّ

139
00:11:12,893 --> 00:11:14,536
ذَكَرَ النَّاظِمُ رَحِمَهُ اللَّهُ أَحْكَامَ

140
00:11:18,369 --> 00:11:21,655
الْمِيمِ السَّاكِنَةِ وَهِيَ ثَلَاثَةُ أَحْكَامٍ قَالَ: [وَالْمِيمُ

141
00:11:23,845 --> 00:11:24,940
إِنْ تَسْكُنْ تَجِي قَبْلَ الْهِجَا * لَا أَلِفٍ لَيِّنَةٍ لِذِي

142
00:11:24,393 --> 00:11:26,583
الْحِجَا]، وَهَذِهِ الْمِيمُ الَّتِي مَعَنَا هِيَ

143
00:11:52,868 --> 00:11:53,963
الْمِيمُ السَّاكِنَةُ وَتَجِي قَبْلَ الْهِجَا قَبْلَ حُرُوفِ الْهِجَاءِ،

144
00:11:53,416 --> 00:11:53,963
وَاسْتَثْنَى الْأَلِفَ اللَّيِّنَةَ الَّتِي هِيَ لَامُ التَّعْرِيفِ لِمَاذَا؟

145
00:11:53,416 --> 00:11:53,963
لِأَنَّ الْمِيمَ

146
00:12:19,090 --> 00:12:20,037
قَالَ الشَّارِحُ: لِأَنَّ مَا قَبْلَهَا يَكُونُ مَفْتُوحًا دَائِمًا،

147
00:12:19,564 --> 00:12:22,879
فَهَذَا مِنْ

148
00:12:22,879 --> 00:12:23,353
حَيْثُ الْغَالِبِ لَكِنَّهُ قَدْ يَتَحَرَّكُ بِالْكَسْرِ وَقَدْ يَتَحَرَّكُ بِالضَّمِّ لَكِنَّ

149
00:12:22,879 --> 00:12:25,722
الْغَالِبَ أَنَّهُ مَفْتُوحٌ هَذَا مِنْ حَيْثُ الْأَكْثَرِ،

150
00:12:25,248 --> 00:12:27,616
فَإِذَا حُرِّكَتِ الْمِيمُ بِفَتْحَةٍ أَوْ بِضَمَّةٍ أَوْ بِكَسْرَةٍ هَذِهِ لَا

151
00:12:27,616 --> 00:12:28,090
تَدْخُلُ مَعَنَا،

152
00:12:27,616 --> 00:12:28,090
نَحْنُ نَتَكَلَّمُ عَنْ مِيمٍ سَاكِنَةٍ

153
00:12:40,495 --> 00:12:41,252
بَعْدَهَا أَحَدُ حُرُوفِ الْهِجَاءِ،

154
00:12:40,874 --> 00:12:41,252
فَإِذَا جَاءَتِ

155
00:12:48,063 --> 00:12:48,820
الْمِيمُ السَّاكِنَةُ فَلَهَا ثَلَاثَةٌ وَبَعْدَهَا أَحَدُ حُرُوفِ الْهِجَاءِ فَلَهَا ثَلَاثَةُ

156
00:12:48,441 --> 00:12:48,820
أَحْكَامٍ: - الْأَوَّلُ: الْإِخْفَاءُ،

157
00:12:48,441 --> 00:12:48,820
سَبَقَ تَعْرِيفُ الْإِخْفَاءِ وَالْإِظْهَارِ وَالْإِدْغَامِ فِي الْمِيمِ،

158
00:12:48,441 --> 00:12:48,820
فَإِذَا جَاءَ بَعْدَ الْمِيمِ

159
00:13:04,712 --> 00:13:07,642
الْبَاءُ فَحُكْمُهُ الْإِخْفَاءُ مِثْلُ قَوْلِهِ تَعَالَى: ﴿يَعْتَصِمْ بِاللَّهِ﴾،

160
00:13:07,090 --> 00:13:07,642
وَنُخْفِي بِدُونِ أَنْ نَجْعَلَ فَتْحَةً وَبِدُونِ أَنْ نَكُزَّ الشِّفَاهَ الشَّفَةَ

161
00:13:07,090 --> 00:13:07,642
وَإِنَّمَا نَقْرَؤُهَا كَذَا: ﴿يَعْتَصِمْ بِاللَّهِ﴾،

162
00:13:07,090 --> 00:13:07,642
﴿يَوْمَهُمْ بَارِزُونَ﴾،

163
00:13:07,090 --> 00:13:07,642
﴿بِأَعْلَمَ بِالشَّاكِرِينَ﴾،

164
00:13:07,090 --> 00:13:07,642
[بِأَعْلَمَ] هَذِهِ عَلَى قِرَاءَةِ أَبِي عَمْرٍو بِاسْتِكَانَةٍ لِلْمِيمِ،

165
00:13:07,090 --> 00:13:07,642
﴿أَعْلَمَ بِالظَّالِمِينَ﴾،

166
00:13:07,090 --> 00:13:07,642
[أَعْلَمَ] هَذِهِ هِيَ الْأَمْثِلَةُ الْأَرْبَعَةُ،

167
00:13:07,090 --> 00:13:07,642
وَالْمِثَالَانِ الْأَخِيرَانِ عِنْدَ أَبِي عَمْرٍو،

168
00:13:27,435 --> 00:13:28,400
قَالَ: وَهَذَا هُوَ الْمُخْتَارُ الَّذِي عَلَيْهِ جُمْهُورُ أَهْلِ الْأَدَاءِ،

169
00:13:27,918 --> 00:13:28,400
وَذَهَبَ جَمَاعَةٌ إِلَى إِظْهَارِهَا عِنْدَهَا إِظْهَارًا تَامًّا مِنْ غَيْرِ غُنَّةٍ،

170
00:13:27,918 --> 00:13:28,400
لَكِنَّ الْعَمَلَ عَلَى الْأَوَّلِ أَنَّهُ إِذَا جَاءَ بَعْدَ

171
00:13:47,007 --> 00:13:48,173
الْمِيمِ الْبَاءُ فَإِنَّهَا تُخْفَى،

172
00:13:47,590 --> 00:13:48,173
وَهَذَا الْإِخْفَاءُ يُسَمَّى شَفَوِيًّا تَفْرِيقًا بَيْنَهُ وَبَيْنَ الْإِظْهَارِ الْإِخْفَاءِ الْحَقِيقِيِّ

173
00:13:47,590 --> 00:13:51,090
الَّذِي سَبَقَ فِي النُّونِ السَّاكِنَةِ وَالتَّنْوِينِ،

174
00:13:51,090 --> 00:13:51,673
وَكُلُّ

175
00:14:05,213 --> 00:14:06,308
هَذِهِ الْأَحْكَامِ الْإِخْفَاءُ

176
00:14:21,027 --> 00:14:22,116
الْإِظْهَارُ تُسَمَّى شَفَوِيَّةً لِأَنَّهُ

177
00:14:43,997 --> 00:14:47,566
مَخْرَجٌ مِنَ الشِّفَاهِ،

178
00:14:46,852 --> 00:14:47,566
وَمَا سَبَقَ فِي أَحْكَامِ النُّونِ السَّاكِنَةِ وَالتَّنْوِينِ يُسَمَّى الْحَقِيقِيَّ الْإِظْهَارَ

179
00:14:46,852 --> 00:14:47,566
الْحَقِيقِيَّ الْإِظْهَارَ الْحَقِيقِيَّ إِلَى آخِرِهِ،

180
00:14:46,852 --> 00:14:47,566
نَعَمْ؛ وَالثَّانِي إِدْغَامٌ بِمِثْلِهَا أَتَى ...

181
00:14:46,852 --> 00:14:47,566
وَسَمِّ إِدْغَامًا صَغِيرًا يَا فَتَى الشَّرْحُ: [وَالثَّانِي] بِحَذْفِ الْيَاءِ لِلْوَزْنِيَّةِ،

182
00:14:46,852 --> 00:14:47,566
وَالثَّانِي

183
00:14:53,276 --> 00:14:54,704
مِنْ أَحْكَامِ

184
00:15:04,697 --> 00:15:05,411
الْمِيمِ

185
00:15:31,738 --> 00:15:34,422
السَّاكِنَةِ يُسْتَوْعَبُ فِي إِدْغَامٍ لَهَا بِمِثْلِهَا أَتَى أَيْ وَرَدَ فِي

186
00:15:33,080 --> 00:15:34,422
الْقُرْآنِ الْعَزِيزِ نَحْوُ: ﴿أَمْ

187
00:15:41,133 --> 00:15:43,818
مَنْ أَسَّسَ﴾،

188
00:15:42,476 --> 00:15:43,818
﴿خَلَقَ لَكُمْ مَا فِي الْأَرْضِ﴾،

189
00:15:42,476 --> 00:15:43,818
فَإِنْ كَانَتِ

190
00:16:17,729 --> 00:16:19,048
الْمِيمُ أَصْلِيَّةً كَمَا فِي هَذَيْنِ الْمِثَالَيْنِ أَمْ مَقْلُوبَةً

191
00:16:26,303 --> 00:16:27,622
مِنَ النُّونِ السَّاكِنَةِ وَالتَّنْوِينِ نَحْوُ:

192
00:17:01,741 --> 00:17:03,702
﴿مِنْ مَاءٍ مَهِينٍ﴾،

193
00:17:02,721 --> 00:17:03,702
[وَسَمِّ] أَنْتَ

194
00:17:10,566 --> 00:17:12,527
هَذَا الْإِدْغَامَ [إِدْغَامًا صَغِيرًا]،

195
00:17:11,546 --> 00:17:12,527
وَالْإِدْغَامُ الصَّغِيرُ

196
00:17:46,455 --> 00:17:47,132
هُوَ

197
00:17:53,229 --> 00:17:54,584
أَنْ يَتَّفِقَ الْحَرْفَانِ صِفَةً وَمَخْرَجًا وَيَسْكُنَ أَوَّلُهُمَا،

198
00:17:53,906 --> 00:17:54,584
وَقَوْلُهُ: [يَا فَتَى] تَكْمِلَةٌ أَيْ يَا مَنْ يَتَأَتَّى مِنْكَ الْعِلْمُ،

199
00:17:53,906 --> 00:17:54,584
وَالْفَتَى فِي الْأَصْلِ الشَّابُّ لُغَةً خَمْسَةَ عَشَرَ سَنَةً إِلَى أَنْ

200
00:17:53,906 --> 00:17:55,261
يَبْلُغَ ثَلَاثِينَ سَنَةً؛ ثُمَّ ذَكَرَ النَّاظِمُ

201
00:18:21,461 --> 00:18:22,872
رَحِمَهُ اللَّهُ الْحُكْمَ الثَّانِيَ وَهُوَ الْإِدْغَامُ وَهُوَ أَنْ يَأْتِيَ بَعْدَ

202
00:18:22,402 --> 00:18:22,872
الْمِيمِ السَّاكِنَةِ مِيمٌ أُخْرَى قَالَ: [وَالثَّانِي إِدْغَامٌ بِمِثْلِهَا أَتَى] أَنْ

203
00:18:22,402 --> 00:18:22,872
يَأْتِيَ بَعْدَ الْمِيمِ مِيمٌ،

204
00:18:22,402 --> 00:18:22,872
[وَسَمِّ إِدْغَامًا صَغِيرًا

205
00:18:43,740 --> 00:18:45,240
يَا فَتَى] لِمَاذَا سُمِّيَ صَغِيرًا؟

206
00:18:44,490 --> 00:18:45,240
لِأَنَّ الْحَرْفَ الْأَوَّلَ سَاكِنٌ وَالثَّانِي مُتَحَرِّكٌ،

207
00:18:44,490 --> 00:18:45,240
أَمَّا

208
00:18:54,928 --> 00:18:56,053
إِذَا تَحَرَّكَ الْحَرْفَانِ فَهَذَا يُسَمَّى إِدْغَامًا كَبِيرًا وَسَيَأْتِي سَيَذْكُرُهُ الْمُصَنِّفُ

209
00:18:55,490 --> 00:18:56,053
رَحِمَهُ اللَّهُ فِي قَوْلِهِ: [كُلٌّ كَبِيرٌ وَافْهَمَنْهُ بِالْمُثُلِ]،

210
00:18:55,490 --> 00:18:56,053
لَكِنَّ الْإِدْغَامَ الصَّغِيرَ الْمُرَادُ بِالْإِدْغَامِ الصَّغِيرِ أَنْ يَسْكُنَ الْحَرْفُ الْأَوَّلُ

211
00:18:55,490 --> 00:18:56,053
وَيَتَحَرَّكَ الثَّانِي،

212
00:18:55,490 --> 00:18:56,053
فَإِذَا جَاءَ بَعْدَ الْمِيمِ مِيمٌ فَإِنَّ الْحُكْمَ هُوَ الْإِدْغَامُ،

