420
00:27:34,754 --> 00:27:35,508
قَالَ أَحْكَامُهَا وَهِيَ هَذِهِ اللَّامُ يَعْرِفُهَا جُلُّ النَّاسِ بِطَبِيعَتِهِمْ هِيَ

421
00:27:34,754 --> 00:27:35,508
أَحْكَامُ الَّتِي تُسَمَّى اللَّامَ الْقَمَرِيَّةَ وَشَمْسِيَّةَ،

422
00:27:34,754 --> 00:27:35,508
فَلَا تَقُولُ لِشَخْصٍ: قُلِ الْقَمَرَ،

423
00:27:34,754 --> 00:27:35,508
يَقُولُ: الْقَمَرَ،

424
00:27:34,754 --> 00:27:35,508
لَا يَحْتَاجُ إِلَى تَكَلُّفٍ وَمَعْرِفَةٍ فِي هَذَا الْأَمْرِ،

425
00:27:34,754 --> 00:27:35,508
[الشَّمْسُ] هَكَذَا تُنْطَقُ،

426
00:27:34,754 --> 00:27:35,508
لَكِنَّ بَعْضَ النَّاسِ وَهُمْ نَدْرَةٌ يَقُولُ: [الْشَّمْسُ]،

427
00:27:34,754 --> 00:27:35,508
وَإِلَّا فِي الْأَصْلِ لَا يَأْتِي بِهَا الْمَرْءُ عَلَى السَّلِيقَةِ،

428
00:27:34,754 --> 00:27:35,508
لَكِنْ ذَكَرَهَا الْمُصَنِّفُ رَحِمَهُ اللَّهُ بَيَانًا لَهَا،

429
00:27:34,754 --> 00:27:35,508
قَالَ: [قَبْلَ أَرْبَعٍ مِنْ عَشْرَةٍ خُذْ عِلْمَهُ * مِنْ ابْغِ

430
00:27:34,754 --> 00:27:35,508
حَجَّكَ وَخَفْ عَقِيمَهُ]،

431
00:27:34,754 --> 00:27:35,508
فَقَبْلَ أَرْبَعَةَ عَشَرَ حَرْفًا تَظْهَرُ وَهِيَ الْهَمْزَةُ وَالْبَاءُ إِلَى آخِرِ

432
00:27:34,754 --> 00:27:35,508
الَّتِي ذَكَرَهَا إِلَى آخِرِ هَذِهِ الْحُرُوفِ الَّتِي نَصَّ عَلَيْهَا الْمُصَنِّفُ

433
00:27:34,754 --> 00:27:35,508
مِثْلُ: [الْأَوَّلُ]،

434
00:27:34,754 --> 00:27:35,508
[الْبَرُّ]، [الْغَنِيُّ] إِلَى آخِرِ هَذِهِ الْأَمْثِلَةِ،

435
00:27:34,754 --> 00:27:35,508
الْقِسْمُ الثَّانِي إِدْغَامُهَا فِي أَرْبَعٍ وَعَشْرَةٍ أَيْضًا وَرَمْزَهَا فَعِ،

436
00:27:34,754 --> 00:27:35,508
وَهِيَ بَقِيَّةُ حُرُوفِ الْهِجَا،

437
00:27:34,754 --> 00:27:35,508
حُرُوفُ الْهِجَا ثَمَانِيَةٌ وَعِشْرُونَ حَرْفًا،

438
00:27:34,754 --> 00:27:35,508
أَرْبَعَةَ عَشَرَ حَرْفَ إِظْهَارٍ وَهِيَ إِدْغَامٌ،

439
00:27:34,754 --> 00:27:35,508
قَالَ: [طِبْ ثُمَّ صِلْ رُحْمًا تَفُزْ] إِلَى آخِرِ الْبَيْتِ،

440
00:27:34,754 --> 00:27:35,508
أَوَائِلُ الْحَرْفِ الْأَوَّلِ مِنْ هَذِهِ الْكَلِمَاتِ: [طِبْ] الطَّاءُ [الطَّامَّةُ]،

441
00:27:34,754 --> 00:27:35,508
[ثُمَّ] الثَّاءُ [الثَّوَابُ]،

442
00:27:34,754 --> 00:27:35,508
[صِلْ] الصَّادُ [الصَّاخَّةُ] وَهَكَذَا إِلَى بَقِيَّةِ الْأَمْثِلَةِ،

443
00:27:34,754 --> 00:27:35,508
ثُمَّ ذَكَرَ لِمَاذَا سُمِّيَتْ قَالَ: [وَاللَّامَ الْأُولَى سَمِّهَا قَمْرِيَّهْ *

444
00:27:34,754 --> 00:27:35,508
وَاللَّامَ الْأُخْرَى سَمِّهَا شَمْسِيَّهْ]،

445
00:27:34,754 --> 00:27:35,508
لِمَاذَا سُمِّيَتِ الْأُولَى قَمْرِيَّةً؟

446
00:27:34,754 --> 00:27:35,508
ذَكَرَ الْأَصْلَ عُلَمَاءُ أَكْثَرَ مِنْ سَبَبٍ،

447
00:27:34,754 --> 00:27:35,508
لَكِنْ مِنْ هَذِهِ الَّتِي ذَكَرَهَا الْمُصَنِّفُ رَحِمَهُ اللَّهُ وَحُكْمُهُ قِيلَ

448
00:27:34,754 --> 00:27:35,508
سُمِّيَتْ قَمْرِيَّةً تَشْبِيهًا لَهَا بِلَامِ الْقَمَرِ بِجَامِعِ الظُّهُورِ،

449
00:27:34,754 --> 00:27:35,508
فَالْقَمَرُ لَامٌ فِيهِ مُظْهَرٌ،

450
00:27:34,754 --> 00:27:35,508
وَقِيلَ بِنِسْبَةٍ إِلَى النُّجُومِ فَإِنَّ النُّجُومَ تَظْهَرُ مَعَ الْقَمَرِ وَتَخْفَى

451
00:27:34,754 --> 00:27:35,508
مَعَ الشَّمْسِ،

452
00:27:34,754 --> 00:27:35,508
فَمَعَ الْقَمَرِ تَظْهَرُ سُمِّيَتْ قَمْرِيَّةً وَمَعَ الشَّمْسِ تَخْفَى سُمِّيَتْ شَمْسِيَّةً،

453
00:27:34,754 --> 00:27:35,508
ثُمَّ سَيَذْكُرُ النَّاظِمُ لَامَ الْفِعْلِ،

454
00:27:34,754 --> 00:27:35,508
نَعَمْ؛ وَأَظْهِرَنَّ لَامَ فِعْلٍ مُطْلَقَا ...

455
00:27:34,754 --> 00:27:35,508
فِي نَحْوِ قُلْ نَعَمْ وَقُلْنَا وَالْتَقَى فِي آخِرِهِ: [فَدَعَلْنَا] وَ

456
00:27:34,754 --> 00:27:35,508
[أَنْزَلْنَا]، وَفِي نَحْوِهِ [الْتَقَى] مِنْ كُلِّ فِعْلٍ مَاضٍ وَقَعَتِ اللَّامُ

457
00:27:34,754 --> 00:27:35,508
فِي وَسَطِهِ،

458
00:27:34,754 --> 00:27:35,508
فَالْتَقَمَهُ الْحُوتُ وَأَلْحَقْنَا بِهِمْ،

459
00:27:34,754 --> 00:27:35,508
وَمَحَلُّ هَذَا الْإِظْهَارِ إِذَا لَمْ تَقَعْ قَبْلَ لَامٍ أَوْ رَاءٍ،

460
00:27:34,754 --> 00:27:35,508
فَإِنْ وَقَعَتْ قَبْلَهُمَا أُدْغِمَتْ فِيهِمَا وُجُوبًا نَحْوُ: ﴿وَقُلْ لَهُمْ﴾ وَ

461
00:27:34,754 --> 00:27:35,508
﴿وَقُلْ رَبِّ﴾؛ ثُمَّ ذَكَرَ النَّاظِمُ رَحِمَهُ اللَّهُ لَامَ الْفِعْلِ قَالَ:

462
00:27:34,754 --> 00:27:35,508
[وَأَظْهِرَنَّ لَامَ فِعْلٍ مُطْلَقَا * فِي نَحْوِ قُلْ نَعَمْ وَقُلْنَا

463
00:27:34,754 --> 00:27:35,508
وَالْتَقَى]، قَوْلُ النَّاظِمِ رَحِمَهُ اللَّهُ: [مُطْلَقَا] هَذَا فِيهِ تَقْيِيدٌ،

464
00:27:34,754 --> 00:27:35,508
لَامُ فِعْلٍ مُطْلَقًا،

465
00:27:34,754 --> 00:27:35,508
أَوَّلًا لَامُ الْفِعْلِ هِيَ اللَّامُ السَّاكِنَةُ الْوَاقِعَةُ فِي فِعْلٍ سَوَاءٌ

466
00:27:34,754 --> 00:27:35,508
كَانَ مَاضِيًا أَوْ مُضَارِعًا أَوْ أَمْرًا،

467
00:27:34,754 --> 00:27:35,508
مُتَوَسِّطَةً أَوْ مُتَطَرِّفَةً،

468
00:27:34,754 --> 00:27:35,508
اللَّامُ فِي الِاسْمِ تَأْتِي أَوَّلَ الِاسْمِ فَقَطْ،

469
00:27:34,754 --> 00:27:35,508
لَامُ أَلْ تَأْتِي أَوَّلَ الِاسْمِ: [الشَّمْسُ]،

470
00:27:34,754 --> 00:27:35,508
[الْقَمَرُ]، [الْبَابُ] إِلَى آخِرِهِ،

471
00:27:34,754 --> 00:27:35,508
لَامُ الْفِعْلِ لَا تَأْتِي أَوَّلَ الْفِعْلِ،

472
00:27:34,754 --> 00:27:35,508
تَأْتِي إِمَّا وَسَطَ الْفِعْلِ أَوْ آخِرَ الْفِعْلِ مِثْلُ: [اجْعَلْنِي]،

473
00:27:34,754 --> 00:27:35,508
[الْتَقَى]، [أَلْحَامَهُ]،

474
00:27:34,754 --> 00:27:35,508
[أَلْحَقْنَا]، [قُلْ]،

475
00:27:34,754 --> 00:27:35,508
وَقَوْلُ النَّاظِمِ رَحِمَهُ اللَّهُ: [مُطْلَقَا] هَذَا فِيهِ تَقْيِيدٌ،

476
00:27:34,754 --> 00:27:35,508
بَلْ هِيَ قَبْلَ اللَّامِ وَالرَّاءِ تُدْغَمُ،

477
00:27:34,754 --> 00:27:37,772
وَهَذَا قَدْ بَيَّنَهُ الشَّارِحُ رَحِمَهُ اللَّهُ صَاحِبُ الْمَنْظُومَةِ بِدِقَّةٍ مُتَنَاهِيَةٍ؛
